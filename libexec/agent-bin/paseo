#!/bin/sh
# ade-paseo-shim: v1 (every copy of this file carries this marker in its first lines; a shim never takes another shim for the real paseo)
# paseo shim (ls-06, 2026-11-14): a `paseo` front door that stops a message to an archived or handoff-replaced agent in the
# send path itself. Paseo un-archives and runs an archived agent that gets a message, and the Claude hook
# (claude/hooks/archived_send_gate.py) sees only Claude's Bash and MCP tool calls, so a send built inside a Python program
# went through. Design and limits: docs/archived-send-guard.md.
#
# Written for /bin/sh on purpose: bash would source the operator's BASH_ENV (~/.bashrc) at start, rewrite PATH, and pick the
# wrong paseo; `sh` (bash 3.2 in POSIX mode, dash) reads no startup file for a non-interactive script.
#
# WHAT IT SEES: only a `paseo` that the caller's PATH resolves to this directory. That holds for a Python `subprocess.run(["paseo",
# ...])` (execvp uses the inherited PATH) and for any program that keeps its PATH. It does NOT hold for a bash process whose
# startup file rewrites PATH: the operator's BASH_ENV=~/.bashrc puts ~/.local/bin and /opt/homebrew/bin first, so `bash -c`, a
# `#!/usr/bin/env bash` script and a `bash <<EOF` program reach the real paseo unguarded (the hook still sees a send typed in a
# Bash tool call). An absolute path to the real paseo is not seen either. Nothing installs this shim: put it first on PATH
# yourself, `PATH="<checkout>/libexec/agent-bin:$PATH"` (and `env -u BASH_ENV` for a bash child), or run `<checkout>/libexec/agent-bin/paseo`
# by its path. The ade-claim plugin's W4 `agent.open.before` hook prepends this directory to an agent's PATH only when the plugin
# is installed, enabled AND in `enforce` mode (`~/.local/state/djbclark-ade/ade-claim.mode`); its default, observe mode, changes nothing.
# The helper is found beside this script (bin/ade-paseo-guard of the checkout it lives in, through any symlink), never in the cwd.
#
# Order of work, cheapest first (no Python unless a `send` word is on the command line):
#   1. No argument is `send`: exec the real paseo untouched.
#   2. Otherwise `python3 -I bin/ade-paseo-guard ARGS...`, which parses `[global opts] [agent] send [opts] TARGET` (options may also
#      follow `agent` and `send`), asks `paseo agent inspect` (the real paseo by absolute path, so the probe never re-enters this
#      shim), and execs the real paseo: as asked (a live or unknown target, an explicit --host/--home), with the target rewritten
#      to its successor (a completed or acknowledged self-handoff replaced it), or not at all (exit 4: archived with no successor, a cyclic
#      ledger, a redirect that would be a send to oneself).
# The real paseo is the first `paseo` on PATH (or ADE_REAL_PASEO) that is a regular executable file and not a shim: every copy of
# this file is skipped, wherever it lives, so two checkouts' agent-bin directories on one PATH do not call each other.
# Three re-entry counters stop a wrapper that runs a shim again. ADE_PASEO_SHIM_DEPTH (cap 8) counts only an exec chain: it is valid
# only when ADE_PASEO_SHIM_PID, the pid of the shim that set it, is this process (an exec) or its parent (a wrapper that runs the shim
# as a child). ADE_PASEO_SHIM_HOPS (cap 32) also counts a wrapper that forks between two shims (a subshell, `sh -c`, `timeout`), and is
# trusted only while ADE_PASEO_SHIM_HOPS_PID, the pid of the shim that set it, is alive. A value that a daemon, started through the shim,
# passes to every agent it spawns names a shim that has exited, so it counts from zero. ADE_PASEO_SHIM_TOTAL (cap 256) ends a wrapper that
# runs the next shim in the background and exits; it counts from zero again once its 10-minute window (ADE_PASEO_SHIM_TOTAL_T) has passed.
# FAILS OPEN: no python3, a missing helper or any error inside it runs the real paseo with a one-line note on stderr. Only a
# refusal stops a command. An accident guard, like the hook, not a sandbox.
#
# Exit codes: 4 refused (nothing sent); 127 no real paseo found, or re-entered more than 8 times (an exec chain) or through more than 32 hops;
# every other code is the real paseo's. (127 also: the total passed 256 inside one 10-minute window.)
# Environment: ADE_REAL_PASEO (the real paseo; skips the PATH search; the shim passes it only to its helper), ADE_PYTHON (default python3),
# ADE_ALLOW_ARCHIVED_SEND=<full id> (operator: resume one archived agent), ADE_ALLOW_REPLACED_SEND=<full id> (operator: send to
# a replaced agent that is still live), ADE_SEND_GUARD_LOG (override log; default ~/.local/state/djbclark-ade/send-guard-overrides.jsonl).
set -u

self="$0"
case "$self" in */*) ;; *) self="./$self" ;; esac

# re-entry cap: a wrapper named paseo that runs a shim again would loop forever
# to_count VALUE: sets `n` to a small decimal number; junk, an empty or an absurdly long value counts as 0, `08` is eight
to_count() {
  n="$1"
  case "$n" in "" | *[!0-9]*) n=0 ;; esac
  while [ "${n#0}" != "$n" ]; do n="${n#0}"; done
  case "$n" in "" | ??????*) n=0 ;; esac
}
depth=0
case "${ADE_PASEO_SHIM_PID:-}" in "$$" | "$PPID") depth="${ADE_PASEO_SHIM_DEPTH:-0}" ;; esac  # a counter set by an ancestor exec chain only
to_count "$depth"
depth=$((n + 1))
if [ "$depth" -gt 8 ]; then
  echo "paseo shim: re-entered $depth times (a wrapper named paseo that runs a shim again?): no real paseo reachable" >&2
  exit 127
fi
# HOPS counts the forks between two shims (a wrapper that runs `( paseo "$@" )`, `sh -c`, `timeout`) and hides them from the pid check
# above, so this second, looser cap (32) ends that loop. It is anchored to a live pid: the inherited count is trusted only while
# ADE_PASEO_SHIM_HOPS_PID, the pid of the shim that set it, still runs. In a wrapper loop every earlier shim is a live ancestor.
# A daemon started through a shim (`paseo daemon start`) outlives that shim, so the daemon's agents see a dead pid and count from zero
# (an agent's own restart of the daemon cannot grow the count by one per generation).
hops_in=0
case "${ADE_PASEO_SHIM_HOPS_PID:-}" in
  "" | 0* | *[!0-9]*) ;;  # no pid (`kill -0 0` would signal our own process group)
  *) if kill -0 "$ADE_PASEO_SHIM_HOPS_PID" 2> /dev/null; then hops_in="${ADE_PASEO_SHIM_HOPS:-0}"; fi ;;
esac
to_count "$hops_in"
hops=$((n + 1))
if [ "$hops" -gt 32 ]; then
  echo "paseo shim: re-entered through $hops hops (a wrapper named paseo that forks and runs a shim again?): no real paseo reachable" >&2
  exit 127
fi
# TOTAL is always inherited and never reset: a wrapper that starts the next shim in the background and exits (`paseo "$@" &`) leaves no
# live ancestor, so only this very high cap (256) ends that loop. It is anchored to a window of 10 minutes
# (ADE_PASEO_SHIM_TOTAL_T, the epoch second at which the window opened): a count older than the window, or a start time that is
# missing, junk or in the future (clock skew), counts from zero with a new window. A daemon that a shim starts hands its count to
# every agent it spawns hours later, so no run of daemon restarts can grow it to the cap; a loop inside one window still ends.
# With no working `date` the count is trusted as it is (the loop cap wins over the daemon case).
# to_epoch VALUE: sets `n` to an epoch second count; junk, an empty or a 12-digit value is 0
to_epoch() {
  n="$1"
  case "$n" in "" | *[!0-9]*) n=0 ;; esac
  while [ "${n#0}" != "$n" ]; do n="${n#0}"; done
  case "$n" in "" | ????????????*) n=0 ;; esac
}
to_epoch "$(date +%s 2> /dev/null)"
now_s="$n"
to_epoch "${ADE_PASEO_SHIM_TOTAL_T:-}"
window="$n"
total_in=0
if [ "$now_s" -eq 0 ]; then
  total_in="${ADE_PASEO_SHIM_TOTAL:-0}"
elif [ "$window" -gt 0 ] && [ "$window" -le "$now_s" ] && [ $((now_s - window)) -le 600 ]; then
  total_in="${ADE_PASEO_SHIM_TOTAL:-0}"
else
  window="$now_s"
fi
to_count "$total_in"
total=$((n + 1))
if [ "$total" -gt 256 ]; then
  echo "paseo shim: re-entered $total times in total (a wrapper named paseo that runs a shim in the background?): no real paseo reachable" >&2
  exit 127
fi
export ADE_PASEO_SHIM_DEPTH="$depth" ADE_PASEO_SHIM_PID="$$" ADE_PASEO_SHIM_HOPS="$hops" ADE_PASEO_SHIM_HOPS_PID="$$" ADE_PASEO_SHIM_TOTAL="$total" ADE_PASEO_SHIM_TOTAL_T="$window"

# is_shim FILE: a copy of this shim (marker line in its first lines), through symlinks
is_shim() {
  [ -f "$1" ] || return 1
  shim_n=0
  while [ "$shim_n" -lt 6 ] && IFS= read -r shim_line; do
    case "$shim_line" in "# ade-paseo-shim:"*) return 0 ;; esac
    shim_n=$((shim_n + 1))
  done < "$1" 2> /dev/null
  return 1
}

# the real paseo: ADE_REAL_PASEO, else the first `paseo` on PATH that is an executable file and not a shim
real=""
if [ -n "${ADE_REAL_PASEO:-}" ] && [ -f "$ADE_REAL_PASEO" ] && [ -x "$ADE_REAL_PASEO" ] && ! [ "$ADE_REAL_PASEO" -ef "$self" ] \
  && ! is_shim "$ADE_REAL_PASEO"; then
  real="$ADE_REAL_PASEO"
else
  set -f
  IFS=:
  for d in $PATH; do
    if [ -n "$d" ] && [ -f "$d/paseo" ] && [ -x "$d/paseo" ] && ! [ "$d/paseo" -ef "$self" ] && ! is_shim "$d/paseo"; then
      real="$d/paseo"
      break
    fi
  done
  unset IFS
  set +f
fi
if [ -z "$real" ]; then
  echo "paseo shim: no real paseo found on PATH" >&2
  exit 127
fi

# 1: no `send` word: nothing to judge
has_send=0
for a in "$@"; do
  if [ "$a" = send ]; then has_send=1; break; fi
done
if [ "$has_send" = 0 ]; then
  exec "$real" "$@"
fi

# the helper beside this script, through the shim's symlinks: <checkout>/libexec/agent-bin/paseo -> <checkout>/bin/ade-paseo-guard
helper_path() {
  hp_src="$self"
  while [ -L "$hp_src" ]; do
    hp_t=$(readlink "$hp_src")
    case "$hp_t" in /*) hp_src="$hp_t" ;; *) hp_src="${hp_src%/*}/$hp_t" ;; esac
  done
  printf '%s/../../bin/ade-paseo-guard' "${hp_src%/*}"
}

py="${ADE_PYTHON:-python3}"
helper=$(helper_path)
if ! command -v "$py" > /dev/null 2>&1 || ! [ -f "$helper" ]; then
  echo "paseo shim: guard unavailable (needs python3 and bin/ade-paseo-guard); running paseo unguarded" >&2
  exec "$real" "$@"
fi

# -I: isolated (no PYTHON* variables, no user site, no cwd or script dir on sys.path)
ADE_REAL_PASEO="$real" exec "$py" -I "$helper" "$@"  # named for the helper alone, never for a paseo that may start a daemon

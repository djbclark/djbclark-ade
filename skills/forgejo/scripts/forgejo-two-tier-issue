#!/usr/bin/env python3
"""forgejo-two-tier-issue — file one problem as two linked issues: a full,
AI-oriented report in our public fork, and a short human-readable one upstream.

    forgejo-two-tier-issue --upstream SIPB/hyades --title "exec fails ..." \
        --human human.md --ai ai.md --dry-run
    forgejo-two-tier-issue --upstream SIPB/hyades --title "..." --human human.md --ai ai.md --yes
    forgejo-two-tier-issue --upstream SIPB/hyades --existing 7 --ai ai.md --yes   # backfill an AI twin

Steps (djbclark's rule for SIPB projects, 2026-10-14; usable for any upstream):
1. Make sure FORK_OWNER/<repo> exists as a public fork of --upstream with issues
   enabled (POST /repos/UP/forks, PATCH has_issues=true, private=false).
2. Open the AI issue in the fork: title "[AI detail] TITLE", body = --ai, plus a
   header naming the upstream issue (filled in at step 4).
3. Open the upstream issue: body = --human, plus a footer linking the AI issue.
   With --existing N, skip this and link to upstream issue N instead (a comment
   is added upstream only with --comment-existing).
4. Edit the AI issue so its header links the upstream issue.
Prints both URLs. All calls go through forgejo-api (token from sudo-secretspec).
Upstream filing is outward-facing: show djbclark the human draft first.
"""
import argparse
import json
import os
import subprocess
import sys
import time

FJ = os.path.join(os.path.dirname(os.path.abspath(__file__)), "forgejo-api")


def api(host, method, path, body=None, dry=False, ok404=False):
    cmd = [sys.executable, FJ, "--host", host, method, path]
    if method not in ("GET", "HEAD"):
        cmd.append("--dry-run" if dry else "--yes")
    if body is not None:
        cmd += ["--data", "@-"]
    if dry and method not in ("GET", "HEAD"):
        print(f"[dry-run] {method} {path}" + (f"  title={body.get('title')!r}" if body and "title" in body else ""))
        return {}
    r = subprocess.run(cmd, input=json.dumps(body) if body is not None else None,
                       capture_output=True, text=True)
    if r.returncode != 0:
        if ok404 and "HTTP 404" in r.stderr:
            return None
        sys.exit(f"forgejo-two-tier-issue: {method} {path} failed: {r.stderr.strip()}")
    return json.loads(r.stdout) if r.stdout.strip() else {}


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--host", default="forgejo.mit.edu")
    ap.add_argument("--upstream", required=True, help="OWNER/REPO to report to")
    ap.add_argument("--fork-owner", default=os.environ.get("FORGEJO_USER", "djbclark"))
    ap.add_argument("--title", help="upstream issue title (required unless --existing)")
    ap.add_argument("--human", help="file with the short upstream body (Markdown)")
    ap.add_argument("--ai", required=True, help="file with the full AI-oriented body (Markdown)")
    ap.add_argument("--existing", type=int, help="upstream issue already filed: only add the AI twin")
    ap.add_argument("--comment-existing", action="store_true",
                    help="with --existing, also comment the AI-issue link upstream")
    g = ap.add_mutually_exclusive_group(required=True)
    g.add_argument("--yes", action="store_true")
    g.add_argument("--dry-run", action="store_true")
    a = ap.parse_args()
    dry = a.dry_run
    if a.existing is None and not (a.title and a.human):
        ap.error("--title and --human are required unless --existing")
    for f in [a.ai] + ([a.human] if a.human else []):
        if not os.path.isfile(f) or os.path.getsize(f) == 0:
            ap.error(f"{f} is missing or empty")
    ai_text = open(a.ai).read().strip()
    human_text = open(a.human).read().strip() if a.human else ""

    up_owner, repo = a.upstream.split("/", 1)
    fork = f"{a.fork_owner}/{repo}"
    site = f"https://{a.host}"

    # 1. fork
    info = api(a.host, "GET", f"/repos/{fork}", ok404=True)
    if info is None:
        api(a.host, "POST", f"/repos/{a.upstream}/forks", {}, dry)
        for _ in range(30):
            if dry:
                break
            time.sleep(2)
            info = api(a.host, "GET", f"/repos/{fork}", ok404=True)
            if info:
                break
        else:
            sys.exit(f"fork {fork} did not appear")
    elif not (info.get("fork") and (info.get("parent") or {}).get("full_name", "").lower() == a.upstream.lower()):
        sys.exit(f"{fork} exists but is not a fork of {a.upstream}; pass --fork-owner or rename it")
    if dry or not info.get("has_issues") or info.get("private"):
        api(a.host, "PATCH", f"/repos/{fork}", {"has_issues": True, "private": False}, dry)

    # 2. AI issue in the fork
    up_title = a.title
    if a.existing is not None:
        up = api(a.host, "GET", f"/repos/{a.upstream}/issues/{a.existing}")
        up_title = up.get("title", f"#{a.existing}") if not dry else (a.title or f"#{a.existing}")
    pending = "_Upstream issue: being filed; this line is replaced with the link._"
    def ai_body(link_line):
        return (f"{link_line}\n\n"
                f"> This is the full technical report, written for AI coding agents (verbose by design). "
                f"The short human-readable version lives upstream. Prepared with an AI coding assistant; "
                f"results reviewed by @{a.fork_owner}.\n\n{ai_text}\n")
    up_link_known = f"{site}/{a.upstream}/issues/{a.existing}" if a.existing is not None else None
    ai_issue = api(a.host, "POST", f"/repos/{fork}/issues",
                   {"title": f"[AI detail] {up_title}",
                    "body": ai_body(f"**Upstream issue:** {up_link_known}" if up_link_known else pending)}, dry)
    ai_url = ai_issue.get("html_url", f"{site}/{fork}/issues/<new>")

    # 3. upstream issue
    if a.existing is None:
        footer = (f"\n\n---\nFull technical detail (long, written for AI agents): {ai_url}\n"
                  f"_Prepared with an AI coding assistant; results reviewed by me._")
        up_issue = api(a.host, "POST", f"/repos/{a.upstream}/issues",
                       {"title": a.title, "body": human_text + footer}, dry)
        up_url = up_issue.get("html_url", f"{site}/{a.upstream}/issues/<new>")
        # 4. back-link
        if not dry:
            api(a.host, "PATCH", f"/repos/{fork}/issues/{ai_issue['number']}",
                {"body": ai_body(f"**Upstream issue:** {up_url}")})
        else:
            print(f"[dry-run] PATCH /repos/{fork}/issues/<new>  (link -> upstream)")
    else:
        up_url = up_link_known
        if a.comment_existing:
            api(a.host, "POST", f"/repos/{a.upstream}/issues/{a.existing}/comments",
                {"body": f"Full technical detail (long, written for AI agents): {ai_url}"}, dry)

    print(json.dumps({"upstream": up_url, "ai_detail": ai_url, "dry_run": dry}, indent=2))


if __name__ == "__main__":
    main()

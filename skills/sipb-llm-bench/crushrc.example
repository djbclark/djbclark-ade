# Crush config used for the measurements (key removed, skill-disable lines omitted).
# Save as ~/.config/crush/crushrc; base-url points at the local proxy, use https://llms-dev-1.mit.edu/api to go direct.
# The original also has 150 "disable-skill" lines for locally installed skills (not relevant to the server).
#!/usr/bin/env bash
# Global Crush config. See: crush://skills/crush-config/SKILL.md
#
# SIPB LLMs runs Open WebUI 0.6.30. Its OpenAI-compatible base is
# https://llms-dev-1.mit.edu/api (NOT /v1). Use --type openai-compat: the
# strict `openai` type (official SDK) fails against this server.
#
# Crush talks to sipb-llms-proxy (launchd label land.charm.sipb-llms-proxy) on
# 127.0.0.1:8890, which forwards to the server but turns the opaque `null`
# Open WebUI returns for an over-long prompt into a readable HTTP 400 error, and
# rewrites a tool call the model wrote as text into a native tool_calls delta
# (see the proxy README). If the proxy is down:
# launchctl kickstart -k gui/$(id -u)/land.charm.sipb-llms-proxy
#
# The server caps inference context at ~32768 tokens and answers larger
# requests with that bare `null`. The product-specific / non-coding skills are
# disabled below to keep the request well under the cap. Delete a
# server's OLLAMA_CONTEXT_LENGTH so the whole library fits.

provider add sipb-llms \
  --name "SIPB LLMs" \
  --type openai-compat \
  --base-url "http://127.0.0.1:8890/api" \
  --api-key "sk-YOUR-KEY" \
  --extra-body '{"reasoning_effort":"high"}'

model add sipb-llms/qwen3.5:35b \
  --name "Qwen3.5 35B" \
  --can-reason true \
  --context-window 32768 \
  --default-max-tokens 8192

# deepseek-r1:32b is DROPPED (2026-10-13): it fabricates success on file/command
# tasks (writes the command in a ```bash fence plus a false "[file created]" line
# as text, no tool call), so crush runs nothing. Re-enable only after
# `toolcall_conformance.py deepseek-r1:32b` passes. See REPORT.md section 4.7.
#
# model add sipb-llms/deepseek-r1:32b \
#   --name "DeepSeek R1 32B" \
#   --can-reason true \
#   --context-window 32768 \
#   --default-max-tokens 8192

model add sipb-llms/qwen3-coder:30b \
  --name "Qwen3 Coder 30B" \
  --context-window 32768 \
  --default-max-tokens 8192

model add sipb-llms/qwen3.6:35b-a3b-q4_K_M \
  --name "Qwen3.6 35B A3B" \
  --can-reason true \
  --context-window 32768 \
  --default-max-tokens 8192

# Default model 2026-10-12: qwen3.6:35b-a3b was the only one that finished the 5-phase task
# (benchmark in ~/.local/state/bigteam/sipb-bench); qwen3.5:35b is the fallback.
model large sipb-llms/qwen3.6:35b-a3b-q4_K_M --think
model small sipb-llms/qwen3.6:35b-a3b-q4_K_M

# Lean profile (2026-10-12): SIPB LLMs has a 32k context and no prompt cache, so
# every tool and skill description costs time on every step. With the default
# set the agent used ~28k prompt tokens, ~35 s per turn and never finished a
# 5-phase task in 30 min; with this profile it finished in 94 s. Remove the
permissions deny todos agentic_fetch sourcegraph web_search web_fetch fetch download crush_info crush_logs job_kill job_output list_mcp_resources read_mcp_resource question lsp_call_hierarchy lsp_definition lsp_diagnostics lsp_references lsp_rename lsp_replace_symbol lsp_restart lsp_symbols

# 2026-10-12: SIPB LLMs is shared and loads one model at a time, so a request can
# wait minutes behind another user's job or a model swap. Crush's default idle
# timeout (2 min of no data) aborted turns during those waits; allow 10 min.
option request-timeout 600

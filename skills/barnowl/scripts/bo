#!/usr/bin/env bash
# Talk to the running BarnOwl in the tmux session named "barnowl".
# The live client is the one that holds Zephyr subscriptions. zctl retrieve
# on this machine fails looking for a WindowGram port; do not use it.
set -euo pipefail

session=${BO_SESSION:-barnowl}
out=${BO_OUT:-}
trap '[[ -z $out ]] || rm -f "$out"' EXIT

usage() {
  cat <<'EOF'
usage: bo subs
       bo file
       bo run <barnowl command>
       bo perl <expression>
       bo capture
       bo locate <user>

subs    subscriptions the running BarnOwl has with the Zephyr server
file    subscriptions saved in ~/.zephyr.subs (zctl list)
run     type a BarnOwl command into the live client and print what came back
perl    evaluate one Perl expression inside BarnOwl and print its value
capture print the visible BarnOwl pane
locate  zlocate a user
EOF
}

need_session() {
  if ! tmux has-session -t "$session" 2>/dev/null; then
    echo "no tmux session named $session" >&2
    exit 1
  fi
}

# One bo call at a time per session: two callers would interleave keystrokes
# in the one live client. flock is on Linux, where the live client runs; where
# it is missing there is no session to talk to anyway.
lock_client() {
  command -v flock >/dev/null 2>&1 || return 0
  exec 9>"${BO_LOCK:-${TMPDIR:-/tmp}/bo-$session.lock}"
  flock -w 120 9 || { echo "another bo call is using $session; gave up after 120 s" >&2; exit 1; }
}

# Lines under the status bar are the type window. A compose expands it.
type_window() {
  tmux capture-pane -p -J -t "$session" | awk '
    /^── / { hit = 1; n = 0; next }
    hit { lines[++n] = $0 }
    END {
      shown = 0
      for (i = 1; i <= n; i++) {
        if (lines[i] ~ /[^[:space:]]/) {
          shown++
          print lines[i]
        }
      }
      if (shown == 0) print ""
    }
  '
}

guard_idle() {
  need_session
  lock_client
  # Keys sent while a pager or popup is open land in it, not the command line.
  # No status-bar line means a full-screen page; a popup (":show commands",
  # help) keeps the status bar but draws a box whose bottom edge is a line of
  # "└──┘". Either is refused; a message body that draws such a box is a
  # harmless false alarm.
  local screen
  screen=$(tmux capture-pane -p -J -t "$session")
  if ! grep -q '^── ' <<<"$screen" || grep -Eq '^ *└─+┘ *$' <<<"$screen"; then
    echo "BarnOwl is showing a pager or popup (or an unrecognised screen); not sending keys." >&2
    exit 3
  fi
  local lines count first
  lines=$(type_window)
  count=$(printf '%s\n' "$lines" | sed '/^$/d' | wc -l)
  first=$(printf '%s\n' "$lines" | sed '/^$/d' | head -n 1)
  if [[ "$count" -gt 2 ]]; then
    echo "BarnOwl looks mid-compose; not sending keys." >&2
    exit 3
  fi
  case "$first" in
    :*|zwrite*|zcrypt*)
      echo "BarnOwl already has a command or zwrite in progress; not sending keys." >&2
      exit 3
      ;;
  esac
}

send_line() {
  local line=$1
  tmux send-keys -t "$session" -l "$line"
  tmux send-keys -t "$session" Enter
}

wait_marker() {
  local i
  for i in $(seq 1 20); do
    if [[ -f $out ]] && grep -q '^BO_OK$\|^BO_ERR$' "$out"; then
      return 0
    fi
    sleep 0.25
  done
  echo "BarnOwl did not finish writing $out" >&2
  tmux capture-pane -p -J -t "$session" | tail -n 12 >&2
  exit 1
}

print_marked() {
  if grep -q '^BO_ERR$' "$out"; then
    sed '/^BO_ERR$/d' "$out" >&2
    rm -f "$out"
    exit 1
  fi
  sed '/^BO_OK$/d' "$out"
  rm -f "$out"
}

perl_eval() {
  local expr=$1
  guard_idle
  # A private output file per call: concurrent callers never see each other's.
  [[ -n $out ]] || out=$(mktemp "${TMPDIR:-/tmp}/bo-out.XXXXXX")
  rm -f "$out"
  # The expression is one Perl value. It is wrapped so a failure is visible.
  local line
  line=":perl do { my \$v = eval { ${expr} }; my \$err = \$@; open my \$fh, q{>}, q{${out}} or die \$!; if (\$err) { print \$fh \"BO_ERR\\n\$err\"; } else { print \$fh (defined \$v ? \$v : q{}); print \$fh \"\\n\" if !defined(\$v) || \$v !~ /\\n\\z/; print \$fh \"BO_OK\\n\"; } close \$fh; q{ok} }"
  send_line "$line"
  wait_marker
  print_marked
}

cmd_run() {
  local cmd=$1
  guard_idle
  local after
  send_line ":${cmd}"
  sleep 0.5
  after=$(tmux capture-pane -p -J -t "$session")
  # A pager (no status bar) or a popup (status bar plus a "└──┘" box): print
  # the screen and close it, so the next call finds the message list.
  if ! printf '%s\n' "$after" | grep -q '^── ' || printf '%s\n' "$after" | grep -Eq '^ *└─+┘ *$'; then
    printf '%s\n' "$after"
    tmux send-keys -t "$session" q
    return 0
  fi
  printf '%s\n' "$after" | awk '
    /^── / { hit = 1; n = 0; next }
    hit { lines[++n] = $0 }
    END { for (i = 1; i <= n; i++) print lines[i] }
  '
}

case "${1:-}" in
  subs)
    perl_eval 'BarnOwl::zephyr_getsubs()'
    ;;
  file)
    zctl list
    ;;
  run)
    shift
    [[ $# -ge 1 ]] || { usage >&2; exit 2; }
    cmd_run "$*"
    ;;
  perl)
    shift
    [[ $# -ge 1 ]] || { usage >&2; exit 2; }
    perl_eval "$*"
    ;;
  capture)
    need_session
    tmux capture-pane -p -J -t "$session"
    ;;
  locate)
    shift
    [[ $# -ge 1 ]] || { usage >&2; exit 2; }
    zlocate "$@"
    ;;
  -h|--help|help|"")
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

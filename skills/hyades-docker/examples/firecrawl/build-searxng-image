#!/usr/bin/env bash
# build-searxng-image — SearXNG with a settings.yml that serves JSON, pushed to
# forgejo.mit.edu with no local VM.
#
#   build-searxng-image [SEARXNG_TAG]     default: the pinned tag below
#
# Firecrawl's search calls SEARXNG_ENDPOINT/search?format=json, and SearXNG only
# serves the formats listed in settings.yml (search.formats, no env equivalent).
# Hyades microVMs get no config mounts, so the file goes into the image as one
# layer (`crane append`). Everything else stays SearXNG's default
# (use_default_settings); the deploy script sets the port and SEARXNG_SECRET.
#
# The same layer:
#   1. Disables Brave, which answers 429 to every SearXNG query (searxng#1651).
#   2. Patches the Wikipedia and Wikidata engines to send SearXNG's own
#      User-Agent with a contact URL instead of a browser one. Wikimedia allows
#      200 requests a minute for a compliant bot User-Agent and 10 for an
#      unidentified client (meta.wikimedia.org/wiki/User-Agent_policy). The
#      image ships unchecked-hash .pyc files, which Python loads without
#      looking at the source, so the layer also whiteouts the two cached files.
#      A new SearXNG tag whose sources no longer match fails the build here.
#      Reported upstream as searxng#6840; drop the patch once it is fixed there.
#   3. (r3) Weights Grokipedia down to 0.3 and enables Bing and Yahoo, because
#      DuckDuckGo (captcha) and Google (429) fail from the Hyades IP and plain
#      technical queries returned only Grokipedia pages.
#   4. Turns on Grokipedia and twelve specialist engines that SearXNG ships
#      disabled (operator, 2026-10-14). Firecrawl sends no category, so only
#      general engines answer plain queries; the rest answer their !shortcut
#      (skills/fallback-chains/references/web-access.md, 2.1).
export PATH="/opt/homebrew/bin:$PATH"
set -euo pipefail
SCRIPTS="$(cd "$(dirname "$(grealpath "${BASH_SOURCE[0]}")")/../../scripts" && pwd)"
SX_TAG="${1:-2026.10.15-b00212a83}"
REV="r3"   # bump when this layer changes for the same SearXNG tag
BASE="docker.io/searxng/searxng:$SX_TAG"
TAG="forgejo.mit.edu/djbclark/firecrawl-searxng:$SX_TAG-$REV"
CONTACT="https://github.com/djbclark/djbclark-ade/tree/master/skills/hyades-docker/examples/firecrawl"
# OpenAlex's polite pool wants a contact address; kept out of this repo.
MAILTO="${SEARXNG_MAILTO:-$(git -C "$SCRIPTS" config user.email)}"
[ -n "$MAILTO" ] || { echo "set SEARXNG_MAILTO or git user.email" >&2; exit 1; }

work="$(gmktemp -d)"; trap 'rm -rf "$work"' EXIT
mkdir -p "$work/layer/etc/searxng"
cat > "$work/layer/etc/searxng/settings.yml" <<EOF
use_default_settings: true
server:
  # Reached only from Firecrawl on the shared microVM network, never directly.
  limiter: false
  public_instance: false
  image_proxy: false
search:
  formats:
    - html
    - json
outgoing:
  # Appended to "SearXNG/<version>", the User-Agent the patched Wikimedia
  # engines send.
  useragent_suffix: "(+$CONTACT)"
engines:
  - name: brave
    disabled: true
  # Grokipedia is a general engine: every plain query asks it. Weighted down
  # (r3, 2026-10-16): with DuckDuckGo captcha-blocked and Google rate-limited from
  # the Hyades IP, it was the only engine answering technical queries and the
  # whole result page was Grokipedia articles. Still there, but real web
  # results outrank it.
  - name: grokipedia
    disabled: false
    inactive: false
    weight: 0.3
  # Replacements for the blocked general engines (r3).
  - name: bing
    disabled: false
  - name: yahoo
    disabled: false
  # Not general: reached only by their !shortcut (hn, npm, crates, lrs, pgo,
  # hf, cb, gl, oa, cr, nixw, lo).
  - name: hackernews
    disabled: false
  - name: npm
    disabled: false
  - name: crates.io
    disabled: false
  - name: lib.rs
    disabled: false
  - name: pkg.go.dev
    disabled: false
  - name: huggingface
    disabled: false
  - name: codeberg
    disabled: false
  - name: gitlab
    disabled: false
  - name: openalex
    disabled: false
    mailto: "$MAILTO"
  - name: crossref
    disabled: false
  - name: nixos wiki
    disabled: false
  - name: lobste.rs
    disabled: false
EOF

src=usr/local/searxng/searx
echo "== reading engine sources from $BASE"
crane export --platform linux/amd64 "$BASE" "$work/base.tar"
pycs=("$src/engines/__pycache__/wikipedia.cpython-314.pyc" "$src/__pycache__/wikidata.cpython-314.pyc")
gtar -C "$work/layer" -xf "$work/base.tar" "$src/engines/wikipedia.py" "$src/wikidata.py"
gtar -tf "$work/base.tar" "${pycs[@]}" >/dev/null   # fails if the Python version moved
rm -f "$work/base.tar"
python3 - "$work/layer/$src" <<'PY'
import pathlib, sys
root = pathlib.Path(sys.argv[1])

def patch(rel, edits):
    p = root / rel
    text = p.read_text()
    for old, new in edits:
        assert text.count(old) == 1, f"{rel}: expected one {old!r}"
        text = text.replace(old, new)
    p.write_text(text)

patch("engines/wikipedia.py", [(
    '    params["soft_max_redirects"] = 2\n',
    '    params["soft_max_redirects"] = 2\n'
    '    params["headers"]["User-Agent"] = utils.searxng_useragent()\n',
)])
patch("wikidata.py", [
    ("from searx.utils import gen_useragent\n", "from searx.utils import searxng_useragent\n"),
    ('"User-Agent": gen_useragent(),', '"User-Agent": searxng_useragent(),'),
])
PY
for pyc in "${pycs[@]}"; do
  mkdir -p "$work/layer/$(dirname "$pyc")"
  gtouch "$work/layer/$(dirname "$pyc")/.wh.$(basename "$pyc")"
done

gtar --owner=0 --group=0 --numeric-owner -C "$work/layer" -cf "$work/settings.tar" etc
# Files only: a directory entry would reset the owner of /usr and its parents.
(cd "$work/layer" && gfind usr -type f -print0) |
  gtar --owner=977 --group=977 --numeric-owner --no-recursion --null -C "$work/layer" -rf "$work/settings.tar" -T -

echo "== pushing $TAG"
HYADES_ENGINE=crane "$SCRIPTS/hyades-registry" append --platform linux/amd64 -b "$BASE" -f "$work/settings.tar" -t "$TAG"
echo "done: set SX_IMAGE=$TAG for ./deploy apply if the tag changed"

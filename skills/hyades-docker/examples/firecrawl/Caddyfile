{
	admin off
	auto_https off
	persist_config off
}

# Hyades' own Caddy terminates TLS for https://<subdomain>.sipb.cloud and
# forwards here. The self-hosted Firecrawl API has no auth of its own
# (USE_DB_AUTHENTICATION=false), so every request must carry the bearer token
# that Firecrawl clients already send as their API key.
:8080 {
	# Both must hold, so an unset FC_GATE_TOKEN ("Bearer ") locks everyone out.
	@authed {
		header Authorization "Bearer {$FC_GATE_TOKEN}"
		header_regexp Authorization "^Bearer [A-Za-z0-9_-]{32,}$"
	}
	handle @authed {
		reverse_proxy 127.0.0.1:3002 {
			transport http {
				read_timeout 300s
			}
		}
	}
	handle /healthz {
		respond "ok" 200
	}
	handle {
		respond "unauthorized" 401
	}
}

#!/usr/bin/env bash
# build-playwright-image — Firecrawl's playwright-service plus loopback-port-shim,
# pushed to forgejo.mit.edu, with no local VM.
#
#   build-playwright-image [SHIM_SHA]     default: the pinned commit below
#
# BROKEN since 2026-10-15 (SIPB/hyades 3e291d2b6e): `tmprun` takes no image any more.
# The step-1 call below passes `docker.io/library/debian:bookworm`, which the console
# now runs as a bash command (`No such file or directory`), and the guest is bash on
# the host's NixOS tools with no apt or gcc, so the glibc-2.36 build cannot happen
# there. Logic left as is. To rebuild the shim: compile it where a Debian bookworm
# toolchain exists (a `runs-on: ubuntu` job with a debian:bookworm container, see the
# forgejo-ci skill, or a local container) and feed the .so to step 2, or reuse the
# already pushed tag (set PW_IMAGE to it). Untested whether the host has a compiler.
#
# 1. Compile the shim on Hyades in a throwaway Debian bookworm microVM (`tmprun`;
#    bookworm = the playwright-service image's glibc 2.36). The guest fetches the
#    source itself: a tmprun script is typed into a terminal, so payloads must not
#    be pasted through stdin (hyades-docker skill, rule 7).
# 2. Add it as /usr/local/lib/portshim.so with `crane append` and push.
# The deploy script sets LD_PRELOAD=/usr/local/lib/portshim.so on the microVM.
export PATH="/opt/homebrew/bin:$PATH"
set -euo pipefail
SCRIPTS="$(cd "$(dirname "$(grealpath "${BASH_SOURCE[0]}")")/../../scripts" && pwd)"
SHIM_SHA="${1:-b5f2cd304bc602d9ecd1d25cee8482bc8d097b80}"
BASE="${PW_BASE:-ghcr.io/firecrawl/playwright-service:latest}"
TAG="forgejo.mit.edu/djbclark/firecrawl-playwright:shim-${SHIM_SHA:0:7}"
SRC="https://forgejo.mit.edu/djbclark/loopback-port-shim/raw/commit/${SHIM_SHA}/loopback-port-shim.c"

work="$(gmktemp -d)"; trap 'rm -rf "$work"' EXIT
cat > "$work/script.sh" <<EOF
export DEBIAN_FRONTEND=noninteractive; apt-get update -qq </dev/null >/dev/null 2>&1; apt-get install -y -qq gcc libc6-dev curl ca-certificates </dev/null >/dev/null 2>&1
curl -fsS -o /tmp/shim.c $SRC </dev/null && gcc -shared -fPIC -O2 -pthread -o /tmp/portshim.so /tmp/shim.c -ldl </dev/null && echo SHIM-BEGIN && base64 /tmp/portshim.so && echo SHIM-END
exit
EOF
echo "== compiling the shim on Hyades (tmprun debian:bookworm, about a minute)"
"$SCRIPTS/hyades" tmprun docker.io/library/debian:bookworm < "$work/script.sh" > "$work/out.txt" 2>&1
gtr -d '\r' < "$work/out.txt" | gsed 's/\x1b\[[0-9;?]*[A-Za-z]//g' \
  | gsed -n '/^SHIM-BEGIN$/,/^SHIM-END$/p' | gsed '1d;$d' | gbase64 -d > "$work/portshim.so"
file "$work/portshim.so" | rg -q 'ELF 64-bit LSB shared object, x86-64' || {
  echo "build failed; guest output:" >&2; gtail -20 "$work/out.txt" >&2; exit 1; }

echo "== pushing $TAG"
mkdir -p "$work/layer/usr/local/lib"
install -m 0755 "$work/portshim.so" "$work/layer/usr/local/lib/portshim.so"
gtar --owner=0 --group=0 --numeric-owner -C "$work/layer" -cf "$work/shim.tar" usr
HYADES_ENGINE=crane "$SCRIPTS/hyades-registry" append --platform linux/amd64 -b "$BASE" -f "$work/shim.tar" -t "$TAG"
echo "done: set PW_IMAGE=$TAG for ./deploy apply if the tag changed"

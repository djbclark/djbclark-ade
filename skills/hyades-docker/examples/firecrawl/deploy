#!/usr/bin/env bash
# deploy — self-hosted Firecrawl on Hyades as seven microVMs sharing one network.
#
#   deploy apply     write every microVM's hyades.json entry (setconf; no restart)
#   deploy up        start them in dependency order, then wait for the API
#   deploy down      stop them (no state is kept: none of them has a volume)
#   deploy status    one line per microVM (systemctl state)
#   deploy delete    remove the entries (asks first)
#
# Layout (Firecrawl's docker-compose.yaml translated to hyades.json; the
# console has no command override, so each image runs its default CMD):
#   djbclark-fc-redis       redis:7-alpine; network hub, so the others reach
#                           everything on 127.0.0.1 (one shared localhost)
#   djbclark-fc-rabbitmq    rabbitmq:3-alpine (NuQ job notifications)
#   djbclark-fc-postgres    ghcr.io/firecrawl/nuq-postgres (NuQ queue, pg_cron)
#   djbclark-fc-playwright  $PW_IMAGE (:3000): ghcr.io/firecrawl/playwright-service
#                           plus loopback-port-shim (LD_PRELOAD). Its anti-SSRF
#                           proxy listens on port 0, which libkrun TSI makes
#                           unreachable (libkrun#818), so without the shim every
#                           page fails ERR_PROXY_CONNECTION_FAILED. Rebuild:
#                           ./build-playwright-image (no local VM).
#   djbclark-fc-searxng     $SX_IMAGE (:8888): SearXNG with JSON on
#                           (./build-searxng-image); the API's search backend
#                           (SEARXNG_ENDPOINT) instead of scraping DuckDuckGo
#   djbclark-fc-api         ghcr.io/firecrawl/firecrawl:$FC_TAG, harness = API
#                           (:3002) plus workers (:3004, :3005)
#   djbclark-fc-gate        forgejo.mit.edu/djbclark/firecrawl-gate (Caddy,
#                           :8080) -> https://djbclark-firecrawl.sipb.cloud;
#                           bearer token FIRECRAWL_SELFHOST_API_KEY required
# The gate token goes to the console on stdin (`hyades -`), never in argv.
export PATH="/opt/homebrew/bin:$PATH"
set -euo pipefail
HY="$(cd "$(dirname "$(grealpath "${BASH_SOURCE[0]}")")/../../scripts" && pwd)/hyades"
FC_TAG="${FC_TAG:-2.11.519}"
PW_IMAGE="${PW_IMAGE:-forgejo.mit.edu/djbclark/firecrawl-playwright:shim-b5f2cd3}"
SX_IMAGE="${SX_IMAGE:-forgejo.mit.edu/djbclark/firecrawl-searxng:2026.10.15-b00212a83}"
SUB="${FC_SUBDOMAIN:-djbclark-firecrawl}"
P=djbclark-fc
ORDER=(redis rabbitmq postgres playwright searxng api gate)

conf() { # IMAGE NETWORK PORTS-JSON ENVS-JSON
  jq -cn --arg i "$1" --arg n "$2" --argjson p "$3" --argjson e "$4" \
    '{image: $i, ports: $p, volumes: {}, envs: $e, network: $n, exposeports: []}'
}

api_env() {
  jq -cn '{
    HOST: "0.0.0.0", PORT: "3002", EXTRACT_WORKER_PORT: "3004", WORKER_PORT: "3005",
    ENV: "local", USE_DB_AUTHENTICATION: "false", LOGGING_LEVEL: "info",
    REDIS_URL: "redis://127.0.0.1:6379", REDIS_RATE_LIMIT_URL: "redis://127.0.0.1:6379",
    PLAYWRIGHT_MICROSERVICE_URL: "http://127.0.0.1:3000/scrape",
    NUQ_RABBITMQ_URL: "amqp://127.0.0.1:5672",
    POSTGRES_HOST: "127.0.0.1", POSTGRES_PORT: "5432", POSTGRES_USER: "postgres",
    POSTGRES_PASSWORD: "postgres", POSTGRES_DB: "postgres",
    NUM_WORKERS_PER_QUEUE: "8", CRAWL_CONCURRENT_REQUESTS: "10", MAX_CONCURRENT_JOBS: "5",
    BROWSER_POOL_SIZE: "5", HARNESS_STARTUP_TIMEOUT_MS: "120000",
    SEARXNG_ENDPOINT: "http://127.0.0.1:8888"
  } + ($ENV | with_entries(select(.key | test("^SEARXNG_"))))'
}

# SearXNG's cookie-signing key: it refuses to start with its default one.
random_secret() { ghead -c 32 /dev/urandom | gbase64 | gtr -dc 'A-Za-z0-9'; }

cmd_apply() {
  local hub="$P-redis"
  {
    printf 'setconf %s %s\n' "$hub" "$(conf docker.io/library/redis:7-alpine '' '{}' '{}')"
    printf 'setconf %s %s\n' "$P-rabbitmq" "$(conf docker.io/library/rabbitmq:3-alpine "$hub" '{}' '{}')"
    printf 'setconf %s %s\n' "$P-postgres" "$(conf ghcr.io/firecrawl/nuq-postgres:latest "$hub" '{}' \
      '{"POSTGRES_USER":"postgres","POSTGRES_PASSWORD":"postgres","POSTGRES_DB":"postgres"}')"
    printf 'setconf %s %s\n' "$P-playwright" "$(conf "$PW_IMAGE" "$hub" '{}' \
      '{"PORT":"3000","MAX_CONCURRENT_PAGES":"10","LD_PRELOAD":"/usr/local/lib/portshim.so"}')"
    # 8888, not the image's 8080: the gate already holds 8080 on the shared localhost.
    printf 'setconf %s %s\n' "$P-searxng" "$(conf "$SX_IMAGE" "$hub" '{}' "$(jq -cn --arg s "$(random_secret)" \
      '{GRANIAN_HOST: "0.0.0.0", GRANIAN_PORT: "8888", SEARXNG_SECRET: $s}')")"
    printf 'setconf %s %s\n' "$P-api" "$(conf "ghcr.io/firecrawl/firecrawl:$FC_TAG" "$hub" '{}' "$(api_env)")"
  } | "$HY" -
  # The gate entry carries the token: build it inside sudo-secretspec run and pipe it.
  sudo-secretspec run --reason "configure self-hosted Firecrawl gate on Hyades" -- bash -c '
    set -euo pipefail
    [ ${#FIRECRAWL_SELFHOST_API_KEY} -ge 32 ] || { echo "FIRECRAWL_SELFHOST_API_KEY missing/short" >&2; exit 2; }
    printf "setconf %s %s\n" "$1" "$(jq -cn --arg n "$2" --arg s "$3" --arg t "$FIRECRAWL_SELFHOST_API_KEY" \
      "{image: \"forgejo.mit.edu/djbclark/firecrawl-gate:1\", ports: {(\$s): 8080}, volumes: {},
        envs: {FC_GATE_TOKEN: \$t}, network: \$n, exposeports: []}")" | "$4" -
  ' _ "$P-gate" "$P-redis" "$SUB" "$HY"
}

wait_active() { # NAME SECONDS
  local i
  for ((i = 0; i < $2; i += 5)); do
    "$HY" status "$1" 2>/dev/null | rg -q 'Active: active \(running\)' && return 0
    sleep 5
  done
  echo "deploy: $1 not active after $2 s" >&2; return 1
}

cmd_up() {
  local s
  for s in redis rabbitmq postgres playwright searxng; do "$HY" start "$P-$s" >/dev/null; done
  for s in redis rabbitmq postgres playwright searxng; do wait_active "$P-$s" 300; done
  sleep 15   # rabbitmq and postgres accept connections a few seconds after the unit is active
  "$HY" start "$P-api" >/dev/null && wait_active "$P-api" 300
  "$HY" start "$P-gate" >/dev/null && wait_active "$P-gate" 120
  echo "up: https://$SUB.sipb.cloud (bearer FIRECRAWL_SELFHOST_API_KEY)"
}

cmd_down() { local i; for ((i = ${#ORDER[@]} - 1; i >= 0; i--)); do "$HY" stop "$P-${ORDER[i]}" || true; done; }

cmd_status() {
  local s
  for s in "${ORDER[@]}"; do
    printf '%-24s %s\n' "$P-$s" "$("$HY" status "$P-$s" 2>/dev/null | rg -o -m1 'Active: .*' || echo 'not configured')"
  done
}

cmd_delete() {
  read -r -p "delete all ${#ORDER[@]} $P-* microVMs? [y/N] " a; [ "$a" = y ] || exit 1
  local i; for ((i = ${#ORDER[@]} - 1; i >= 0; i--)); do "$HY" delete "$P-${ORDER[i]}" || true; done
}

case "${1:-}" in
  apply|up|down|status|delete) "cmd_$1" ;;
  *) gsed -n '2,9p' "$0" >&2; exit 2 ;;
esac

#!/usr/bin/env bash
# hyades-ci-secrets — put PACKAGE_TOKEN and UPDATE_TOKEN (the two secrets
# SIPB/hyades-action reads) into Forgejo Actions secrets, from sudo-secretspec.
#
#   hyades-ci-secrets OWNER/REPO --yes     # one repository
#   hyades-ci-secrets --user --yes         # user level: every repo you own sees them
#   hyades-ci-secrets OWNER/REPO --dry-run # show what would be set, send nothing
#   hyades-ci-secrets -g GROUP OWNER/REPO --yes   # UPDATE_TOKEN of Moira group GROUP
#
# PACKAGE_TOKEN <- DJBCLARK_FORGEJO_MIT_EDU_PACKAGE_TOKEN (write:package only;
#   forgejo skill: `setup-token forgejo.mit.edu PACKAGE`). It must belong to the
#   user who pushes: the action logs in as ${{ github.actor }}.
# UPDATE_TOKEN  <- DJBCLARK_HYADES_UPDATE_TOKEN (hyades-update-token rotate).
#   Skipped if not stored: the action then builds and pushes without triggering
#   an update (Hyades still pulls new images daily).
# Values travel as stdin -> jq -> forgejo-api --data @-, never argv or a file.
# The PUT uses the main forgejo token (needs write:repository; --user needs write:user).
export PATH="/opt/homebrew/bin:$PATH"
set -uo pipefail
FJ="${FORGEJO_SCRIPTS:-$HOME/src/djbclark-ade/skills/forgejo/scripts}/forgejo-api"
group="" target="" mode=""
while [ $# -gt 0 ]; do
  case "$1" in
    -g) group="$2"; shift 2 ;;
    --user) target="user"; shift ;;
    --yes) mode="--yes"; shift ;;
    --dry-run) mode="--dry-run"; shift ;;
    */*) target="$1"; shift ;;
    *) gsed -n '2,17p' "$0" | gsed 's/^# \{0,1\}//'; exit 2 ;;
  esac
done
[ -n "$target" ] && [ -n "$mode" ] || { gsed -n '2,17p' "$0" | gsed 's/^# \{0,1\}//'; exit 2; }
if [ "$target" = user ]; then base="/user/actions/secrets"; else base="/repos/${target}/actions/secrets"; fi
UPD="DJBCLARK_HYADES_UPDATE_TOKEN"
[ -n "$group" ] && UPD="DJBCLARK_HYADES_$(printf '%s' "$group" | gtr 'a-z.-' 'A-Z__')_UPDATE_TOKEN"

exec sudo-secretspec run --reason "set Hyades CI secrets on ${target}" -- bash -c '
  set -uo pipefail
  fj="$1" base="$2" mode="$3"; shift 3
  rc=0
  while [ $# -gt 0 ]; do
    secret="$1" var="$2"; shift 2
    v="${!var:-}"
    if [ -z "$v" ]; then echo "$secret: skipped ($var not stored)"; continue; fi
    if printf "%s" "$v" | jq -Rs "{data: .}" | python3 "$fj" PUT "$base/$secret" --data @- "$mode" >/dev/null; then
      echo "$secret: ${mode#--} ok (from $var, len=${#v})"
    else
      echo "$secret: FAILED" >&2; rc=1
    fi
  done
  exit $rc' _ "$FJ" "$base" "$mode" \
  PACKAGE_TOKEN DJBCLARK_FORGEJO_MIT_EDU_PACKAGE_TOKEN \
  UPDATE_TOKEN "$UPD"

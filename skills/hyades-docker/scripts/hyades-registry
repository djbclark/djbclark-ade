#!/usr/bin/env bash
# hyades-registry — run one podman (else docker) command logged in to the Forgejo
# container registry, with the token from sudo-secretspec and no saved login.
#
#   hyades-registry push forgejo.mit.edu/djbclark/myapp:latest
#   hyades-registry pull forgejo.mit.edu/djbclark/private-thing
#   HYADES_ENGINE=docker hyades-registry push ...
#
# The login goes to a throwaway auth file (podman: REGISTRY_AUTH_FILE; docker:
# DOCKER_CONFIG) in a 0700 temp dir that is deleted afterwards, because a plain
# `podman login` keeps the token base64-encoded in ~/.config/containers/auth.json.
# Token: DJBCLARK_<REGISTRY>_PACKAGE_TOKEN (write:package only; create it with
# the forgejo skill's `setup-token forgejo.mit.edu PACKAGE`), falling back to
# DJBCLARK_<REGISTRY>_TOKEN. FORGEJO_USER (default djbclark) is the login name.
# HYADES_REGISTRY (default forgejo.mit.edu).
set -uo pipefail
REG="${HYADES_REGISTRY:-forgejo.mit.edu}"
LOGIN="${FORGEJO_USER:-djbclark}"
ENGINE="${HYADES_ENGINE:-}"
if [ -z "$ENGINE" ]; then
  for e in podman docker; do command -v "$e" >/dev/null && { ENGINE="$e"; break; }; done
fi
[ -n "$ENGINE" ] || {
  echo "hyades-registry: neither podman nor docker is installed. Prefer podman:" >&2
  echo "  brew install podman && podman machine init && podman machine start" >&2
  exit 2
}
[ $# -gt 0 ] || { echo "usage: hyades-registry ENGINE-ARGS... (e.g. push IMAGE)" >&2; exit 2; }
if [ "$(basename "$ENGINE")" = podman ] && [ "$(uname)" = Darwin ] && [ -z "$(podman system connection list --format '{{.Name}}' 2>/dev/null)" ]; then
  echo "hyades-registry: podman on macOS is only a client and has no connection (no podman machine, by" >&2
  echo "djbclark's choice: no local VMs). Build and push in Forgejo CI (SIPB/hyades-action) instead, or add a" >&2
  echo "remote Linux podman: podman system connection add NAME ssh://USER@HOST/run/user/UID/podman/podman.sock" >&2
  exit 3
fi
SUFFIX="$(printf '%s' "$REG" | tr 'a-z.-' 'A-Z__')"

exec sudo-secretspec run --reason "container registry access to ${REG}" -- bash -c '
  set -uo pipefail
  pkg="$1" main="$2" engine="$3" reg="$4" login="$5"; shift 5
  tok="${!pkg:-}"; [ -n "$tok" ] || tok="${!main:-}"
  if [ -z "$tok" ]; then
    echo "hyades-registry: neither $pkg nor $main holds a value (forgejo skill: setup-token $reg PACKAGE)" >&2
    exit 2
  fi
  dir="$(mktemp -d)"; chmod 700 "$dir"; trap "rm -rf \"$dir\"" EXIT
  case "$(basename "$engine")" in
    docker*) export DOCKER_CONFIG="$dir"; auth=() ;;
    *)       export REGISTRY_AUTH_FILE="$dir/auth.json"; auth=(--authfile "$dir/auth.json") ;;
  esac
  printf "%s" "$tok" | "$engine" login "${auth[@]}" -u "$login" --password-stdin "$reg" >/dev/null || {
    echo "hyades-registry: $engine login to $reg failed (token rejected or registry unreachable)" >&2; exit 1; }
  unset tok "$pkg" "$main"
  "$engine" "$@"
' _ "DJBCLARK_${SUFFIX}_PACKAGE_TOKEN" "DJBCLARK_${SUFFIX}_TOKEN" "$ENGINE" "$REG" "$LOGIN" "$@"

#!/usr/bin/env bash
# hyades-refresh-docs — re-fetch the Hyades reference material this skill vendors.
#
#   hyades-refresh-docs            # writes into ../references/
#
# 1. references/upstream/: dated snapshots (MIT licence) of SIPB/hyades
#    (docs/inessential.md = the source of https://hyades.mit.edu/inessential.html,
#    README.md, hyades/console.py, hyades/quadlet.txt, LICENSE) and
#    SIPB/hyades-action (action.yml), plus SOURCE.md with the commit ids.
# 2. references/console-help.txt: `help` and `help <topic>` for every console
#    command, read over SSH (read-only; needs a key in Hyades' authorized_keys or
#    a Kerberos ticket).
# Then `git diff references/` shows what changed upstream.
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REF="$HERE/../references"
UP="$REF/upstream"
HOST="${HYADES_HOST:-hyades.mit.edu}"
USER_AT="${HYADES_USER:-djbclark}@${HOST}"
RAW=https://forgejo.mit.edu
mkdir -p "$UP"
fail=0

fetch() { # repo path dest
  local tmp; tmp="$(mktemp)"
  if curl -sSfL "$RAW/SIPB/$1/raw/branch/main/$2" -o "$tmp" && [ -s "$tmp" ]; then
    chmod 644 "$tmp" && mv -f "$tmp" "$3"
  else
    echo "FAILED: $1/$2" >&2; rm -f "$tmp"; fail=1
  fi
}

fetch hyades docs/inessential.md "$UP/inessential.md"
fetch hyades README.md "$UP/hyades-README.md"
fetch hyades hyades/console.py "$UP/console.py"
fetch hyades hyades/quadlet.txt "$UP/quadlet.txt"
fetch hyades LICENSE "$UP/LICENSE"
fetch hyades-action action.yml "$UP/hyades-action.yml"

sha() { curl -sSf "$RAW/api/v1/repos/SIPB/$1/branches/main" | jq -r '.commit.id' 2>/dev/null || echo unknown; }
{
  echo "# Upstream snapshots"
  echo
  echo "Fetched $(date +%F) by \`scripts/hyades-refresh-docs\`. Copyright 2026 SIPB, MIT licence (\`LICENSE\`)."
  echo
  echo "| File | Source | Commit |"
  echo "|---|---|---|"
  h=$(sha hyades); a=$(sha hyades-action)
  echo "| \`inessential.md\` | [SIPB/hyades docs/inessential.md]($RAW/SIPB/hyades/src/branch/main/docs/inessential.md), rendered at https://hyades.mit.edu/inessential.html | \`$h\` |"
  echo "| \`hyades-README.md\` | [SIPB/hyades README.md]($RAW/SIPB/hyades) | \`$h\` |"
  echo "| \`console.py\` | [SIPB/hyades hyades/console.py]($RAW/SIPB/hyades/src/branch/main/hyades/console.py): the console itself | \`$h\` |"
  echo "| \`quadlet.txt\` | [SIPB/hyades hyades/quadlet.txt]($RAW/SIPB/hyades/src/branch/main/hyades/quadlet.txt): the per-microVM Quadlet template | \`$h\` |"
  echo "| \`hyades-action.yml\` | [SIPB/hyades-action action.yml]($RAW/SIPB/hyades-action) | \`$a\` |"
} > "$UP/SOURCE.md"

# Console help: the topic list comes from `help` itself, so new commands appear.
tmp="$(mktemp)"
if timeout 60 ssh -o BatchMode=yes "$USER_AT" help > "$tmp" 2>&1 && rg -q 'Documented commands' "$tmp"; then
  {
    echo "# Hyades console help, captured $(date +%F) over ssh $USER_AT"
    echo "# (one-line docstrings; behaviour and caveats are in console.md)"
    echo
    echo '$ ssh '"$USER_AT"' help'
    cat "$tmp"
    for t in $(gsed -n '/^=\+$/,$p' "$tmp" | gsed '1d' | tr -s ' ' '\n' | rg -v '^$' | sort); do
      echo '$ ssh '"$USER_AT"' help '"$t"
      timeout 30 ssh -o BatchMode=yes "$USER_AT" help "$t" 2>&1
    done
  } > "$REF/console-help.txt.new" && mv -f "$REF/console-help.txt.new" "$REF/console-help.txt"
else
  echo "FAILED: ssh $USER_AT help (no key/ticket?)" >&2; cat "$tmp" >&2; fail=1
fi
rm -f "$tmp"
exit $fail

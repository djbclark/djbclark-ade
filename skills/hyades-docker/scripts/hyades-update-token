#!/usr/bin/env bash
# hyades-update-token — the Hyades update token (console `updtoken`), kept in
# sudo-secretspec and never printed.
#
#   hyades-update-token [-g GROUP] check          # is one stored? (length only)
#   hyades-update-token [-g GROUP] trigger        # POST it: Hyades runs `podman auto-update` now
#   hyades-update-token [-g GROUP] rotate --yes   # updtoken on Hyades, store the result
#
# An account has ONE live update token: `updtoken` deletes every earlier
# trigger socket, so rotating breaks every repo still holding the old value.
# After a rotate, re-run hyades-ci-secrets for each repo (or once with --user).
# Stored as DJBCLARK_HYADES_UPDATE_TOKEN, or DJBCLARK_HYADES_<GROUP>_UPDATE_TOKEN
# for a Moira group account (-g GROUP, via entergp).
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
group=""
if [ "${1:-}" = "-g" ]; then group="$2"; shift 2; fi
VAR="DJBCLARK_HYADES_UPDATE_TOKEN"
if [ -n "$group" ]; then
  VAR="DJBCLARK_HYADES_$(printf '%s' "$group" | tr 'a-z.-' 'A-Z__')_UPDATE_TOKEN"
fi
URL="https://${HYADES_HOST:-hyades.mit.edu}"

case "${1:-}" in
  check)
    sudo-secretspec run --reason "check ${VAR} is stored" -- bash -c \
      'v="${!1:-}"; if [ -n "$v" ]; then echo "$1: stored (len=${#v})"; else echo "$1: not stored"; exit 1; fi' _ "$VAR"
    ;;
  trigger)
    # The header goes to curl on stdin (-H @-), never in argv.
    sudo-secretspec run --reason "trigger Hyades auto-update" -- bash -c '
      v="${!1:-}"; [ -n "$v" ] || { echo "$1: not stored (rotate first)" >&2; exit 1; }
      printf "X-Token: %s\n" "$v" | curl -sS --fail -X POST -H @- -o /dev/null -w "HTTP %{http_code}\n" "$2"' _ "$VAR" "$URL"
    ;;
  rotate)
    [ "${2:-}" = "--yes" ] || {
      echo "rotate invalidates the current update token for ${group:-your account} on Hyades;" >&2
      echo "every repo holding it stops triggering updates until re-set. Pass --yes." >&2
      exit 2; }
    sudo-secretspec add "$VAR" --optional \
      --description "Hyades update token (updtoken)${group:+ for group $group}: POST ${URL} with X-Token" \
      --reason "hyades-docker: Hyades update token" >/dev/null 2>&1 || true
    args=(updtoken); [ -n "$group" ] && args=(-g "$group" updtoken)
    out="$("$HERE/hyades" "${args[@]}" 2>&1)" || { echo "updtoken failed:" >&2; printf '%s\n' "$out" | gsed -E 's/[0-9a-f]{32}/<redacted>/g' >&2; exit 1; }
    tok="$(printf '%s' "$out" | gsed -nE 's/.*Your update token is ([0-9a-f]{32})\..*/\1/p' | head -1)"
    unset out
    [ ${#tok} -eq 32 ] || { echo "could not find a token in the updtoken output (format changed?)" >&2; exit 1; }
    printf '%s' "$tok" | sudo-secretspec set "$VAR" --reason "hyades-docker: store rotated update token" >/dev/null || {
      echo "storing failed; the new token is live on Hyades but lost here: rotate again" >&2; exit 1; }
    unset tok
    "$0" ${group:+-g "$group"} check
    ;;
  *)
    gsed -n '2,14p' "$0" | gsed 's/^# \{0,1\}//'
    exit 2 ;;
esac

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- proc-cpu-watch (bin/proc-cpu-watch): every 300 s one 3 s CPU sample of the @TARGET@ process tree into
     @STATE@/samples.jsonl. No model, no pings. One template for every target: `proc-cpu-watch install` with a target T
     fills @ADE@, @STATE@ and @TARGET@ (and adds CBW_STATE_DIR) and installs it as com.djbclark.T-cpu-watch;
     `uninstall` with that target removes it. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.djbclark.@TARGET@-cpu-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>@ADE@/bin/proc-cpu-watch</string>
    <string>sample</string>
    <string>--target</string>
    <string>@TARGET@</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/djbclark/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>300</integer>
  <!-- Interactive like load-watch: a Background job runs on the E-cores only and starves during the spikes it is meant to record. -->
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>@STATE@/launchd.out</string>
  <key>StandardErrorPath</key><string>@STATE@/launchd.err</string>
</dict>
</plist>

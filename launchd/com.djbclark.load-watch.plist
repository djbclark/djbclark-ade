<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- load-watch (bin/load-watch): every 20 s one `ps` and the load average, no model. After 5 minutes
     of load at or above 4 per core it finds the Paseo agent whose processes used the CPU (by working
     directory, from `paseo ls`), writes it a brief, sends it one line with `paseo send` and pings Hermes,
     so heavy builds move to CI. Installed by `load-watch install` (bin/ade_sched.py fills __ADE__, __HOME__ and
     __ADMISSION__; a systemd timer on Linux), removed by `load-watch uninstall`. Every sample runs through bin/ade-job-run
     (W21d), so ade-sched can reload or remove the LOADED job without ever killing a sample in flight (docs/scheduling.md). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.djbclark.load-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>__ADE__/bin/ade-job-run</string><string>--lock-dir</string><string>__ADMISSION__</string><string>com.djbclark.load-watch</string><string>--</string>
    <string>__ADE__/bin/load-watch</string>
    <string>sample</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>WorkingDirectory</key><string>__ADE__</string>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>20</integer>
  <!-- Interactive, not Background: a background job runs on the E-cores only, and during a spike its own ps
       timed out every sample (2026-10-18, load 50-110), so it could never name the culprit. One ps per 20 s. -->
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>__HOME__/.local/state/load-watch/launchd.out</string>
  <key>StandardErrorPath</key><string>__HOME__/.local/state/load-watch/launchd.err</string>
</dict>
</plist>

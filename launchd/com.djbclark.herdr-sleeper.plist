<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  herdr-sleeper: every 30 minutes, put Claude agents that have been idle in a
  Herdr pane for 12+ hours to sleep (see bin/herdr-sleeper for the rules).

  Install:
    ln -sf ~/orca/projects/djbclark-ade/launchd/com.djbclark.herdr-sleeper.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.djbclark.herdr-sleeper.plist
  Run now:   launchctl kickstart -k gui/$(id -u)/com.djbclark.herdr-sleeper
  Remove:    launchctl bootout gui/$(id -u)/com.djbclark.herdr-sleeper
  Logs:      ~/.local/state/herdr-sleeper/{launchd.log,sleeper.log}
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.djbclark.herdr-sleeper</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/djbclark/orca/projects/djbclark-ade/bin/herdr-sleeper</string>
    <string>scan</string>
    <string>--idle-hours</string>
    <string>12</string>
  </array>
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/djbclark/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/djbclark/.local/state/herdr-sleeper/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/djbclark/.local/state/herdr-sleeper/launchd.log</string>
</dict>
</plist>

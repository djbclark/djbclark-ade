<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template only (2026-11-22): never auto-loaded, and no inventory row selects it. While the sudo-ask approval window is open
     this answers agents' tool-permission prompts (docs/approval-window.md); with no grant file it never contacts the daemon.
     Each run watches for 50 s of every 60 (the gap is the price of ade-job-run's admission lock and of cron's minute floor). -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.djbclark.ade-approval-window</string>
  <key>ProgramArguments</key><array>
    <string>__ADE__/bin/ade-job-run</string><string>--lock-dir</string><string>__ADMISSION__</string><string>com.djbclark.ade-approval-window</string><string>--</string>
    <string>__ADE__/bin/ade-approval-window</string>
    <string>watch</string>
    <string>--interval</string><string>2</string>
    <string>--duration</string><string>50</string>
  </array>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><false/>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StandardOutPath</key><string>__HOME__/.local/state/djbclark-ade/approval-window/watch.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.local/state/djbclark-ade/approval-window/watch.err.log</string>
</dict></plist>

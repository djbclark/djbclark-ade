<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- bin/ade-tidy, subcommand prune with the apply flag, every 30 minutes: a deterministic host script (no model prompt) that archives idle,
     finished Baton "[Handoff writer]" helpers machine-wide (docs/scheduling.md, 2026-11-14). Each archive is one JSON line in
     ~/.local/state/ade/helper-prune.log; the run summary goes to helper-prune.out.log. Inventoried in config/install.toml as
     `ade-helper-prune` (class optional). Not loaded by merging this file. `bin/ade-sched` fills __ADE__ and __HOME__. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.djbclark.ade-helper-prune</string>
  <key>ProgramArguments</key>
  <array>
    <string>__ADE__/bin/ade-job-run</string><string>--lock-dir</string><string>__ADMISSION__</string><string>com.djbclark.ade-helper-prune</string><string>--</string>
    <string>__ADE__/bin/ade-tidy</string>
    <string>prune</string>
    <string>--apply</string>
    <string>--json</string>
  </array>
  <key>StartInterval</key><integer>1800</integer>
  <key>RunAtLoad</key><false/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key><string>__HOME__/.local/state/ade/helper-prune.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.local/state/ade/helper-prune.out.log</string>
</dict>
</plist>

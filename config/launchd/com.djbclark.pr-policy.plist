<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: `pr-policy install` replaces __ADE__ (the djbclark-ade checkout), __HOME__ and __STATE__ (the state dir).
     The tokens come from sudo-secretspec `get` inside the run; none is in this file or the job's environment. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.djbclark.pr-policy</string>
  <key>ProgramArguments</key>
  <array>
    <string>__ADE__/bin/ade-job-run</string><string>--lock-dir</string><string>__ADMISSION__</string><string>com.djbclark.pr-policy</string><string>--</string>
    <string>__ADE__/bin/pr-policy</string>
    <string>apply</string>
    <string>--yes</string>
    <string>--notify</string>
    <string>--quiet</string>
  </array>
  <key>StartInterval</key><integer>600</integer>
  <key>RunAtLoad</key><true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PR_POLICY_STATE_DIR</key><string>__STATE__</string>
  </dict>
  <key>StandardOutPath</key><string>__STATE__/run.log</string>
  <key>StandardErrorPath</key><string>__STATE__/run.log</string>
</dict>
</plist>

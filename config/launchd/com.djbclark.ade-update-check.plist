<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: `ade-sched install` replaces __ADE__ (checkout), __HOME__; __STATE__ (log dir) needs --set.
     Daily `ade-update --check` only (exit 10 = behind); never auto-applies. Operator installs via
     `bin/ade-sched install config/launchd/com.djbclark.ade-update-check.plist --set __STATE__=$HOME/.local/state/ade`. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.djbclark.ade-update-check</string>
  <key>ProgramArguments</key>
  <array>
    <string>__ADE__/bin/ade-job-run</string><string>--lock-dir</string><string>__ADMISSION__</string><string>com.djbclark.ade-update-check</string><string>--</string>
    <string>__ADE__/bin/ade-update</string>
    <string>--repo</string>
    <string>__ADE__</string>
    <string>--check</string>
  </array>
  <key>StartInterval</key><integer>86400</integer>
  <key>RunAtLoad</key><false/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key><string>__STATE__/ade-update-check.log</string>
  <key>StandardErrorPath</key><string>__STATE__/ade-update-check.log</string>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template, NOT loaded by anything: djbclark or the lead installs it after review (skills/quota-surplus/SKILL.md, "Install").
     Replace __ADE__ (the canonical djbclark-ade checkout, ~/src/djbclark-ade) and __HOME__.
     RELAY_SENDER_NAME declares this job's identity: relay.py refuses (exit 4) a sender with no session and no declared label.
     AbandonProcessGroup: notify starts each relay detached (a Claude target's `--idle 1800` wait outlives the run). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.djbclark.quota-surplus</string>
  <key>ProgramArguments</key>
  <array>
    <string>__ADE__/bin/quota-surplus</string>
    <string>notify</string>
  </array>
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><false/>
  <key>AbandonProcessGroup</key><true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>RELAY_SENDER_NAME</key><string>quota-surplus</string>
  </dict>
  <key>StandardOutPath</key><string>__HOME__/.local/state/quota-surplus/notify.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.local/state/quota-surplus/notify.log</string>
</dict>
</plist>

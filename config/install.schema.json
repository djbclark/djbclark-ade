{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/djbclark/djbclark-ade/config/install.schema.json",
  "title": "djbclark-ade install catalog",
  "description": "Transitional install/component catalog (schema_version=1). Projected when config/ade.toml is absent. Secrets are reference names only; doctor does not read values. keys may run verify_argv under sudo-secretspec run without printing values.",
  "type": "object",
  "required": [
    "schema_version",
    "component"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "component": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "class"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "class": {
            "type": "string"
          },
          "chosen": {
            "type": "boolean"
          },
          "summary": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "install": {
            "type": "string"
          },
          "install_argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "update": {
            "type": "string"
          },
          "update_argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "probe": {
            "type": "string"
          },
          "probe_argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "presence": {
            "type": "string"
          },
          "needs_system": {
            "type": "boolean"
          },
          "system_argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "system_argv_darwin": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "key": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "components": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "create_url": {
            "type": "string"
          },
          "verify": {
            "type": "string",
            "description": "Human/status note; UNKNOWN until a probe is recorded. Outcomes come from verify_argv."
          },
          "verify_argv": {
            "type": "array",
            "description": "Argv for the cheapest read-only authenticated probe, run under sudo-secretspec run. Must read the key from the environment; never print values. Exit contract: 0 ok, 10 invalid, 11 no-quota, 12 unreachable, 13 expiring, 14 missing. Non-empty enforced by ade-install validation.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expiry": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "login": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}

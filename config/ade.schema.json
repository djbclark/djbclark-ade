{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/djbclark/djbclark-ade/config/ade.schema.json",
  "title": "djbclark-ade effective config",
  "description": "schema_version=1 effective ADE config (config/ade.toml shape). Checked by bin/ade-config check. Secrets are reference names only.",
  "type": "object",
  "required": [
    "schema_version"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Supported version is exactly 1; unknown versions fail closed."
    },
    "routing": {
      "type": "object",
      "description": "Projected from legacy config/routing.toml [routing] (identity)."
    },
    "lead": {
      "type": "object",
      "description": "Projected from legacy config/routing.toml [lead]."
    },
    "dispatch": {
      "type": "object",
      "description": "Projected from legacy config/routing.toml [dispatch]."
    },
    "substrate": {
      "type": "object",
      "description": "Projected from legacy config/routing.toml [substrate]."
    },
    "hermes": {
      "type": "object",
      "description": "Projected from legacy config/routing.toml [hermes]."
    },
    "calibrate": {
      "type": "object",
      "description": "Projected from legacy config/routing.toml [calibrate]."
    },
    "service": {
      "type": "array",
      "description": "Projected from legacy [[service]]; arrays replace whole on merge; duplicate name identities are rejected.",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "gates": {
      "type": "object",
      "description": "Legacy gates.toml [frontier] and [floors.frontier] project under gates.frontier and gates.floors.frontier.",
      "additionalProperties": false,
      "properties": {
        "frontier": {
          "type": "object",
          "description": "Effective frontier thresholds after the same floor/default clamping as bin/ade_gates.py.",
          "additionalProperties": false,
          "properties": {
            "frontier1_judged": {
              "type": "number"
            },
            "frontier2_judged": {
              "type": "number"
            },
            "frontier1_per_wave": {
              "type": "number"
            },
            "frontier2_per_wave": {
              "type": "number"
            },
            "frontier1_agent_calls_per_day": {
              "type": "number"
            },
            "frontier1_min_left": {
              "type": "number"
            },
            "frontier1_window_min_left": {
              "type": "number"
            },
            "frontier2_min_left": {
              "type": "number"
            }
          }
        },
        "floors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "frontier": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "frontier1_judged": {
                  "type": "object",
                  "properties": {
                    "loosen": {
                      "type": "string"
                    },
                    "bound": {
                      "type": "number"
                    }
                  },
                  "additionalProperties": false
                },
                "frontier2_judged": {
                  "type": "object",
                  "properties": {
                    "loosen": {
                      "type": "string"
                    },
                    "bound": {
                      "type": "number"
                    }
                  },
                  "additionalProperties": false
                },
                "frontier1_per_wave": {
                  "type": "object",
                  "properties": {
                    "loosen": {
                      "type": "string"
                    },
                    "bound": {
                      "type": "number"
                    }
                  },
                  "additionalProperties": false
                },
                "frontier2_per_wave": {
                  "type": "object",
                  "properties": {
                    "loosen": {
                      "type": "string"
                    },
                    "bound": {
                      "type": "number"
                    }
                  },
                  "additionalProperties": false
                },
                "frontier1_agent_calls_per_day": {
                  "type": "object",
                  "properties": {
                    "loosen": {
                      "type": "string"
                    },
                    "bound": {
                      "type": "number"
                    }
                  },
                  "additionalProperties": false
                },
                "frontier1_min_left": {
                  "type": "object",
                  "properties": {
                    "loosen": {
                      "type": "string"
                    },
                    "bound": {
                      "type": "number"
                    }
                  },
                  "additionalProperties": false
                },
                "frontier1_window_min_left": {
                  "type": "object",
                  "properties": {
                    "loosen": {
                      "type": "string"
                    },
                    "bound": {
                      "type": "number"
                    }
                  },
                  "additionalProperties": false
                },
                "frontier2_min_left": {
                  "type": "object",
                  "properties": {
                    "loosen": {
                      "type": "string"
                    },
                    "bound": {
                      "type": "number"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "context_budget": {
      "type": "object",
      "description": "Legacy context-budget.toml dirs and [budget] project under context_budget.dirs and context_budget.budget.",
      "additionalProperties": false,
      "properties": {
        "dirs": {
          "type": "array",
          "description": "Directories to measure, in order (legacy top-level dirs).",
          "items": {
            "type": "string"
          }
        },
        "budget": {
          "type": "object",
          "description": "Ceilings and per-directory overrides (legacy [budget] / [budget.\"~\"])."
        }
      }
    },
    "secret_deny": {
      "type": "object",
      "description": "Legacy secret-deny.toml version/deny/allow/[claude] project under secret_deny.*",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allow": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "claude": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "static": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "pr_policy": {
      "type": "object",
      "description": "Legacy pr-policy.toml [meta]/[github]/[forgejo] project under pr_policy.*",
      "additionalProperties": false,
      "properties": {
        "meta": {
          "type": "object",
          "properties": {
            "schema": {
              "type": "integer",
              "const": 1
            }
          }
        },
        "github": {
          "type": "object"
        },
        "forgejo": {
          "type": "object"
        }
      }
    },
    "install": {
      "type": "object",
      "description": "Folded from legacy config/install.toml under [install] (component/key/login catalog). Semantic checks stay in ade-install / install.schema.json.",
      "additionalProperties": false,
      "required": [
        "component"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "component": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "class"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "class": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "key": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "login": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        }
      }
    }
  }
}

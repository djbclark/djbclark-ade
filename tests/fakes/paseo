#!/usr/bin/env python3
"""A fake `paseo` (0.15.3 shapes, read from getpaseo/paseo 9f68af0) for tests/test_acp_dispatch.py and the dialogue test.

State lives in $FAKE_PASEO_STATE (agents.json, calls.jsonl), under an flock so a burst of parallel launches is
counted exactly. Knobs (all optional):
  FAKE_PASEO_AGENT      what a launched agent does with its brief: writes (default: report ending DONE, then .done,
                        status idle) | blocked | partial | nothing (idle, no report) | running (stays running) |
                        reply (dialogue: writes "reply text" to the file the prompt names after "write your reply to")
  FAKE_PASEO_WAIT       force `wait`'s status: idle | timeout | permission | error
  FAKE_PASEO_PENDING    JSON list for inspect's PendingPermissions (default [])
  FAKE_PASEO_MODES      JSON {provider: [mode ids]} for `agent mode --list` (default codex: auto, auto-review, full-access)
  FAKE_PASEO_ACTIVE     force inspect's Mode
  FAKE_PASEO_SEND       `send`'s status (default queued)
  FAKE_PASEO_PROVIDERS  JSON list for `provider ls` (default: the eight dispatch providers, available)
  FAKE_PASEO_LOADING    `provider ls` answers every row with status "loading" this many times first (counted in the state dir;
                        route_agent's registry retry, slim-down E7)
  FAKE_PASEO_MODELS     JSON {provider: [model ids]} for `provider models P` (default: none listed, an empty array)
  FAKE_PASEO_USAGE      JSON list for `usage ls` (default []); FAKE_PASEO_USAGE_RC exits with that code instead
  FAKE_PASEO_RUN_FAIL   `run` prints a JSON error and exits 1
  FAKE_PASEO_PARENT_CWD Simulate parent workspace placement unless a workspace is explicit
  FAKE_PASEO_FORCE_CWD  Simulate a daemon ignoring explicit placement
  FAKE_PASEO_OMIT_CWD   Omit cwd from the native run result
  FAKE_PASEO_WORKSPACES JSON list for `workspace ls` (default: [], or persisted workspaces.json after creates)
  FAKE_PASEO_INSPECT    JSON {agentId: inspect payload}; workspace fields are synthetic optional capabilities,
                       not fields returned by installed Paseo 0.15.3's default inspect payload
  FAKE_PASEO_RETURN_WS  workspaceId returned from `run` (default: the selected one)
"""
import fcntl
import json
import os
import re
import sys
from pathlib import Path

STATE = Path(os.environ.get("FAKE_PASEO_STATE") or "/nonexistent-fake-paseo-state")
DEFAULT_MODES = {"claude": ["plan", "default", "acceptEdits", "auto", "bypassPermissions"],
                 "codex": ["auto", "auto-review", "full-access"], "antigravity": ["full-access"]}


def out(obj, code=0):
    print(json.dumps(obj, indent=2))
    sys.exit(code)


def load():
    p = STATE / "agents.json"
    return json.loads(p.read_text()) if p.exists() else []


def save(agents):
    tmp = STATE / "agents.json.tmp"
    tmp.write_text(json.dumps(agents))
    os.replace(tmp, STATE / "agents.json")


def load_workspaces():
    raw = os.environ.get("FAKE_PASEO_WORKSPACES")
    if raw:
        return json.loads(raw)
    p = STATE / "workspaces.json"
    return json.loads(p.read_text()) if p.exists() else []


def save_workspaces(rows):
    tmp = STATE / "workspaces.json.tmp"
    tmp.write_text(json.dumps(rows))
    os.replace(tmp, STATE / "workspaces.json")


def persist_workspaces_from_env():
    raw = os.environ.get("FAKE_PASEO_WORKSPACES")
    if raw and not (STATE / "workspaces.json").exists():
        save_workspaces(json.loads(raw))


def act(agent, prompt):
    """What the fake agent does with a prompt (the brief pointer names the report and the .done marker)."""
    mode = os.environ.get("FAKE_PASEO_AGENT", "writes")
    if prompt.startswith("Reply with exactly: ready"):
        agent["status"] = "idle"
        return
    m = re.search(r"writing the report to (\S+) and then touching (\S+),", prompt)
    if mode == "nothing":
        agent["status"] = "idle"
        return
    if mode == "reply":
        r = re.search(r"write your reply to (\S+?)[,.]? ", prompt)
        if r:
            Path(r.group(1)).write_text(os.environ.get("FAKE_PASEO_REPLY", "reply text from the fake agent") + "\n")
        agent["status"] = "idle"
        return
    if mode == "running" or not m:
        agent["status"] = "running"
        return
    report, done = Path(m.group(1)), Path(m.group(2))
    body = {"writes": "STATUS: working\nfound it\nDONE\n", "blocked": "BLOCKED: do I own ~/opt/x?\n",
            "partial": "STATUS: working\nhalf\n"}.get(mode)
    if body:
        report.write_text(body)
    if mode in ("writes", "blocked"):
        done.touch()
    agent["status"] = "idle"


def opt(args, name):
    vals = [args[i + 1] for i, x in enumerate(args[:-1]) if x == name]
    vals += [x.split("=", 1)[1] for x in args if x.startswith(name + "=")]
    return vals


def main():
    args = sys.argv[1:]
    STATE.mkdir(parents=True, exist_ok=True)
    with (STATE / "lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        with (STATE / "calls.jsonl").open("a") as log:
            log.write(json.dumps(args) + "\n")
        run(args)


def run(args):
    if args[:1] == ["agent"]:
        args = args[1:]
    verb, rest = (args[0], args[1:]) if args else ("", [])
    agents = load()
    by_id = {a["id"]: a for a in agents}
    if verb == "provider" and rest[:1] == ["ls"]:
        rows = json.loads(os.environ.get("FAKE_PASEO_PROVIDERS") or "null") or [
            {"provider": p, "label": p, "status": "available", "enabled": "Enabled",
             "defaultMode": {"claude": "auto", "codex": "auto"}.get(p, "default"), "modes": ""}
            for p in ("claude", "codex", "antigravity", "cursor", "opencode", "hermes", "omp")]
        loading = int(os.environ.get("FAKE_PASEO_LOADING") or 0)
        seen = STATE / "provider-ls-count"
        n = int(seen.read_text()) if seen.exists() else 0
        seen.write_text(str(n + 1))
        if n < loading:
            rows = [dict(r, status="loading") for r in rows]
        out(rows)
    if verb == "provider" and rest[:1] == ["models"]:
        models = json.loads(os.environ.get("FAKE_PASEO_MODELS") or "{}").get(rest[1] if len(rest) > 1 else "", [])
        out([{"model": m, "id": m, "description": "", "thinkingOptionIds": [], "defaultThinkingOptionId": None}
             for m in models])
    if verb == "workspace" and rest and rest[0] == "ls":
        persist_workspaces_from_env()
        out(load_workspaces())
    if verb == "usage" and rest[:1] == ["ls"]:
        if os.environ.get("FAKE_PASEO_USAGE_RC"):
            print("fake paseo: usage failed", file=sys.stderr)
            sys.exit(int(os.environ["FAKE_PASEO_USAGE_RC"]))
        out(json.loads(os.environ.get("FAKE_PASEO_USAGE") or "[]"))
    if verb == "run":
        if os.environ.get("FAKE_PASEO_RUN_FAIL"):
            out({"error": {"code": "DAEMON_NOT_RUNNING", "message": "Cannot connect to daemon"}}, 1)
        cut = rest.index("--")
        flags, prompt = rest[:cut], " ".join(rest[cut + 1:])
        provider = (opt(flags, "--provider") or [""])[0]
        labels = dict(x.split("=", 1) for x in opt(flags, "--label"))
        cwd = (opt(flags, "--cwd") or [""])[0]
        parent_cwd = os.environ.get("FAKE_PASEO_PARENT_CWD")
        if parent_cwd and not opt(flags, "--new-workspace") and not opt(flags, "--workspace"):
            cwd = parent_cwd
        cwd = os.environ.get("FAKE_PASEO_FORCE_CWD") or cwd
        workspace_id = None
        new_ws = opt(flags, "--new-workspace")
        explicit_ws = opt(flags, "--workspace")
        persist_workspaces_from_env()
        rows = load_workspaces()
        if new_ws:
            workspace_id = f"wks_fake_{len(rows) + 1:04d}"
            rows.append({"workspaceId": workspace_id, "project": "fake", "name": workspace_id,
                         "isolation": new_ws[0], "cwd": cwd, "background": False})
            save_workspaces(rows)
        elif explicit_ws:
            workspace_id = explicit_ws[0]
            if not any(r.get("workspaceId") == workspace_id for r in rows):
                out({"error": {"code": "WORKSPACE_NOT_FOUND", "message": f"Workspace not found: {workspace_id}"}}, 1)
        agent = {"id": f"agent-{len(agents) + 1:04d}", "provider": provider, "mode": (opt(flags, "--mode") or [""])[0],
                 "title": (opt(flags, "--title") or [""])[0], "cwd": cwd, "workspaceId": workspace_id,
                 "labels": labels, "status": "running", "prompts": [prompt]}
        act(agent, prompt)
        agents.append(agent)
        save(agents)
        ret_ws = os.environ.get("FAKE_PASEO_RETURN_WS") or workspace_id
        result = {"agentId": agent["id"], "status": "running", "provider": provider, "cwd": agent["cwd"],
                  "title": agent["title"], "workspaceId": ret_ws}
        if os.environ.get("FAKE_PASEO_OMIT_CWD"):
            result.pop("cwd")
        if os.environ.get("FAKE_PASEO_OMIT_WORKSPACE"):
            result.pop("workspaceId")
        out(result)
    if verb == "ls":
        want = dict(x.split("=", 1) for x in opt(rest, "--label"))
        rows = [a for a in agents if all(a["labels"].get(k) == v for k, v in want.items())]
        out([{"id": a["id"], "shortId": a["id"][:7], "name": a["title"], "provider": a["provider"],
              "status": a["status"], "cwd": a["cwd"]} for a in rows])
    aid = rest[0] if rest else ""
    agent = by_id.get(aid)
    if verb == "inspect" and agent is None:
        env_inspect = os.environ.get("FAKE_PASEO_INSPECT")
        if env_inspect and aid in json.loads(env_inspect):
            out(json.loads(env_inspect)[aid])
    if agent is None and verb in ("wait", "inspect", "mode", "send", "stop"):
        out({"error": {"code": "AGENT_NOT_FOUND", "message": f"No agent found matching: {aid}"}}, 1)
    if verb == "wait":
        status = os.environ.get("FAKE_PASEO_WAIT") or ("idle" if agent["status"] != "running" else "timeout")
        out({"agentId": aid, "status": status, "message": {"error": "provider crashed"}.get(status, "ok")})
    if verb == "inspect":
        payload = None
        env_inspect = os.environ.get("FAKE_PASEO_INSPECT")
        if env_inspect:
            payload = json.loads(env_inspect).get(aid)
        if payload is not None:
            out(payload)
        out({"Id": aid, "Status": agent["status"], "Archived": False, "Provider": agent["provider"].split("/")[0],
             "AvailableModes": [{"id": m} for m in (json.loads(os.environ.get("FAKE_PASEO_MODES") or "null") or DEFAULT_MODES).get(agent["provider"].split("/")[0], [])],
             "Mode": os.environ.get("FAKE_PASEO_ACTIVE") or agent["mode"], "Cwd": agent.get("cwd", ""),
             "PendingPermissions": json.loads(os.environ.get("FAKE_PASEO_PENDING") or "[]")})
    if verb == "mode":
        modes = json.loads(os.environ.get("FAKE_PASEO_MODES") or "null") or DEFAULT_MODES
        out([{"id": m, "label": m, "description": ""} for m in modes.get(agent["provider"].split("/")[0], [])])
    if verb == "send":
        prompt = " ".join(opt(rest, "--prompt")) or " ".join(rest[1:])
        agent["prompts"].append(prompt)
        act(agent, prompt)
        save(agents)
        out({"agentId": aid, "status": os.environ.get("FAKE_PASEO_SEND", "queued"), "message": "ok"})
    if verb == "stop":
        agent["status"] = "closed"
        save(agents)
        out({"agentId": aid, "status": "stopped"})
    out({"error": {"code": "UNKNOWN", "message": f"fake paseo: unknown command {args}"}}, 1)


if __name__ == "__main__":
    main()

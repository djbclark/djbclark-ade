#!/usr/bin/env python3
"""A fake `paseo` (0.15.3 shapes, read from getpaseo/paseo 9f68af0) for tests/test_acp_dispatch.py and the dialogue test.

State lives in $FAKE_PASEO_STATE (agents.json, calls.jsonl), under an flock so a burst of parallel launches is
counted exactly. Knobs (all optional):
  FAKE_PASEO_AGENT      what a launched agent does with its brief: writes (default: report ending DONE, then .done,
                        status idle) | blocked | partial | nothing (idle, no report) | running (stays running) |
                        reply (dialogue: writes "reply text" to the file the prompt names after "write your reply to")
  FAKE_PASEO_WAIT       force `wait`'s status: idle | timeout | permission | error
  FAKE_PASEO_PENDING    JSON list for inspect's PendingPermissions (default [])
  FAKE_PASEO_MODES      JSON {provider: [mode ids]} for `agent mode --list` (default codex: auto, auto-review, full-access)
  FAKE_PASEO_ACTIVE     force inspect's Mode
  FAKE_PASEO_SEND       `send`'s status (default queued)
  FAKE_PASEO_PROVIDERS  JSON list for `provider ls` (default: the eight dispatch providers, available)
  FAKE_PASEO_RUN_FAIL   `run` prints a JSON error and exits 1
"""
import fcntl
import json
import os
import re
import sys
from pathlib import Path

STATE = Path(os.environ.get("FAKE_PASEO_STATE") or "/nonexistent-fake-paseo-state")
DEFAULT_MODES = {"claude": ["plan", "default", "acceptEdits", "auto", "bypassPermissions"],
                 "codex": ["auto", "auto-review", "full-access"]}


def out(obj, code=0):
    print(json.dumps(obj, indent=2))
    sys.exit(code)


def load():
    p = STATE / "agents.json"
    return json.loads(p.read_text()) if p.exists() else []


def save(agents):
    tmp = STATE / "agents.json.tmp"
    tmp.write_text(json.dumps(agents))
    os.replace(tmp, STATE / "agents.json")


def act(agent, prompt):
    """What the fake agent does with a prompt (the brief pointer names the report and the .done marker)."""
    mode = os.environ.get("FAKE_PASEO_AGENT", "writes")
    if prompt.startswith("Reply with exactly: ready"):
        agent["status"] = "idle"
        return
    m = re.search(r"writing the report to (\S+) and then touching (\S+),", prompt)
    if mode == "nothing":
        agent["status"] = "idle"
        return
    if mode == "reply":
        r = re.search(r"write your reply to (\S+?)[,.]? ", prompt)
        if r:
            Path(r.group(1)).write_text(os.environ.get("FAKE_PASEO_REPLY", "reply text from the fake agent") + "\n")
        agent["status"] = "idle"
        return
    if mode == "running" or not m:
        agent["status"] = "running"
        return
    report, done = Path(m.group(1)), Path(m.group(2))
    body = {"writes": "STATUS: working\nfound it\nDONE\n", "blocked": "BLOCKED: do I own ~/opt/x?\n",
            "partial": "STATUS: working\nhalf\n"}.get(mode)
    if body:
        report.write_text(body)
    if mode in ("writes", "blocked"):
        done.touch()
    agent["status"] = "idle"


def opt(args, name):
    vals = [args[i + 1] for i, x in enumerate(args[:-1]) if x == name]
    vals += [x.split("=", 1)[1] for x in args if x.startswith(name + "=")]
    return vals


def main():
    args = sys.argv[1:]
    STATE.mkdir(parents=True, exist_ok=True)
    with (STATE / "lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        with (STATE / "calls.jsonl").open("a") as log:
            log.write(json.dumps(args) + "\n")
        run(args)


def run(args):
    if args[:1] == ["agent"]:
        args = args[1:]
    verb, rest = (args[0], args[1:]) if args else ("", [])
    agents = load()
    by_id = {a["id"]: a for a in agents}
    if verb == "provider" and rest[:1] == ["ls"]:
        rows = json.loads(os.environ.get("FAKE_PASEO_PROVIDERS") or "null") or [
            {"provider": p, "label": p, "status": "available", "enabled": "Enabled",
             "defaultMode": {"claude": "auto", "codex": "auto"}.get(p, "default"), "modes": ""}
            for p in ("claude", "codex", "antigravity", "cursor", "opencode", "hermes", "omp", "grok")]
        out(rows)
    if verb == "run":
        if os.environ.get("FAKE_PASEO_RUN_FAIL"):
            out({"error": {"code": "DAEMON_NOT_RUNNING", "message": "Cannot connect to daemon"}}, 1)
        cut = rest.index("--")
        flags, prompt = rest[:cut], " ".join(rest[cut + 1:])
        provider = (opt(flags, "--provider") or [""])[0]
        labels = dict(x.split("=", 1) for x in opt(flags, "--label"))
        agent = {"id": f"agent-{len(agents) + 1:04d}", "provider": provider, "mode": (opt(flags, "--mode") or [""])[0],
                 "title": (opt(flags, "--title") or [""])[0], "cwd": (opt(flags, "--cwd") or [""])[0],
                 "labels": labels, "status": "running", "prompts": [prompt]}
        act(agent, prompt)
        agents.append(agent)
        save(agents)
        out({"agentId": agent["id"], "status": "running", "provider": provider, "cwd": agent["cwd"],
             "title": agent["title"]})
    if verb == "ls":
        want = dict(x.split("=", 1) for x in opt(rest, "--label"))
        rows = [a for a in agents if all(a["labels"].get(k) == v for k, v in want.items())]
        out([{"id": a["id"], "shortId": a["id"][:7], "name": a["title"], "provider": a["provider"],
              "status": a["status"], "cwd": a["cwd"]} for a in rows])
    aid = rest[0] if rest else ""
    agent = by_id.get(aid)
    if agent is None and verb in ("wait", "inspect", "mode", "send", "stop"):
        out({"error": {"code": "AGENT_NOT_FOUND", "message": f"No agent found matching: {aid}"}}, 1)
    if verb == "wait":
        status = os.environ.get("FAKE_PASEO_WAIT") or ("idle" if agent["status"] != "running" else "timeout")
        out({"agentId": aid, "status": status, "message": {"error": "provider crashed"}.get(status, "ok")})
    if verb == "inspect":
        out({"Id": aid, "Status": agent["status"], "Archived": False, "Provider": agent["provider"],
             "Mode": os.environ.get("FAKE_PASEO_ACTIVE") or agent["mode"],
             "PendingPermissions": json.loads(os.environ.get("FAKE_PASEO_PENDING") or "[]")})
    if verb == "mode":
        modes = json.loads(os.environ.get("FAKE_PASEO_MODES") or "null") or DEFAULT_MODES
        out([{"id": m, "label": m, "description": ""} for m in modes.get(agent["provider"].split("/")[0], [])])
    if verb == "send":
        prompt = " ".join(opt(rest, "--prompt")) or " ".join(rest[1:])
        agent["prompts"].append(prompt)
        act(agent, prompt)
        save(agents)
        out({"agentId": aid, "status": os.environ.get("FAKE_PASEO_SEND", "queued"), "message": "ok"})
    if verb == "stop":
        agent["status"] = "closed"
        save(agents)
        out({"agentId": aid, "status": "stopped"})
    out({"error": {"code": "UNKNOWN", "message": f"fake paseo: unknown command {args}"}}, 1)


if __name__ == "__main__":
    main()

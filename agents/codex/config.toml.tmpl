# Template of ~/.codex/config.toml (Phase 0 item 4.4, 2026-10-20). See agents/README.md for every
# placeholder (dotted fields and secret calls). Left out on purpose: [hooks.state.*] (Codex-written trust
# hashes of the hook files, recomputed on first run), [projects.*] entries under /private/tmp
# (session scratch) and marketplace last_revision lines (Codex-written git SHAs).
model = "gpt-6.1-sol"
model_reasoning_effort = "high"
approvals_reviewer = "user"
sandbox_mode = "danger-full-access"
approval_policy = "never"
personality = "pragmatic"
service_tier = "default"
notify = [
    "{{ .home }}/ops/site-private/.codex-runtime/computer-use/Codex Computer Use.app/Contents/SharedSupport/SkyComputerUseClient.app/Contents/MacOS/SkyComputerUseClient",
    "turn-ended",
    "--previous-notify",
    '["{{ .home_escaped }}\/.config\/openusage\/hooks\/codex-notify-fanout.sh"]',
]


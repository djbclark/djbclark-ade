# graft's cards are gitignored but should stay greppable: ripgrep reads
# .ignore before .gitignore, so this re-admits the tree to search only.
!graft/
graft/.cache/
graft/.graph/

# Per-agent copies of graft's own wiring (`graft init`): not part of the repo, kept out of search too.
/.adal/
/.gemini/
/.grok/
/.kiro/
/.windsurf/
/.github/copilot-instructions.md

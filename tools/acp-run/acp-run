        " stdin or --inbox (see above)",
    )
    ap.add_argument(
        "--inbox",
        metavar="DIR",
        help="with --interactive, also take prompts from"
        " *.txt/*.md files dropped into DIR",
    )
    ap.add_argument(
        "--show-thinking",
        action="store_true",
        help="with --interactive, print the agent's thoughts too",
    )
    ap.add_argument(
        "--resume",
        metavar="SESSION_ID",
        help="reopen this ACP session (session/load or session/resume) instead"
        " of starting a new one",
    )
    ap.add_argument("--go-advisory", action="store_true",
                    help="explicit bounded read-only OpenCode Go advice; requires --perm read-only and --timeout <=600")
    a = ap.parse_args()
    bad = [k for k in a.tripwire_exempt_kinds.split(',') if k and k not in TRIPWIRE_EXEMPTABLE]
    if bad:
        ap.error(f"--tripwire-exempt-kinds: only read-only kinds {', '.join(TRIPWIRE_EXEMPTABLE)}; not {', '.join(bad)}")
    if a.timeout < 0:
        ap.error("--timeout must be 0 or more")
    if a.perm == "deny" and a.agent in DENY_UNSUPPORTED \
            and not os.environ.get(DENY_UNSUPPORTED_OVERRIDE_ENV.get(a.agent, "")):
        ap.error(f"--perm deny: {DENY_UNSUPPORTED[a.agent]}")
    if a.list:
        for n, (c, auth) in AGENTS.items():
            exe = agent_executable(c)
            ok = "ok " if shutil.which(exe) else "-- "
            print(f"{ok}{n:9} {' '.join(c)}" + (f"  (auth {auth})" if auth else ""))
        return 0
    if a.agent in OPERATOR_GATED and a.agent not in operator_approved():
        ap.error(f"{a.agent} needs specific, explicit operator approval for this run"
                 f" ({OPERATOR_GATED[a.agent]}); once given, set {APPROVAL_ENV}={a.agent}")
    if a.agent not in AGENTS:
        ap.error(f"agent must be one of: {', '.join(AGENTS)}")
    why = omp_model_refusal(a)
    if why:
        ap.error(why)
    if not (a.perm in (*PERMS, "ask") or a.perm.startswith("scoped:")):
        ap.error("--perm must be all, read-only or deny")
    if a.perm == "read-only" and a.agent not in READONLY_AGENTS:
        ap.error(f"--perm read-only: {a.agent}: {READONLY_UNSUPPORTED}")
    if a.perm == "ask" or a.perm.startswith("scoped:"):
        # operator 2026-10-14: acp-run runs yolo for every agent; the old scoped:/ask
        # policies are accepted for old callers but no longer enforced.
        print(f"acp-run: warning: --perm {a.perm} is no longer enforced: acp-run runs yolo"
              " for every agent (treated as --perm all); use --perm read-only for a read-only run",
              file=sys.stderr)
        a.perm = "all"
    if (a.inbox or a.show_thinking) and not a.interactive:
        ap.error("--inbox and --show-thinking need --interactive")
    if a.all_models and not a.info:
        ap.error("--all-models needs --info")
    if a.agent == "opencode" and not a.info:
        if not a.model or "/" not in a.model:
            ap.error("opencode prompt runs require --model provider/model so the Go cost policy can be checked")
        if a.model != a.model.strip():
            ap.error("opencode --model must not have leading or trailing whitespace")
        if is_go_model(a.model):
            try:
                go_policy = load_go_policy()
            except ConfigError as e:
                ap.error(str(e))
            why = go_policy.refusal(a.model, advisory=a.go_advisory, timeout=a.timeout,
                                    perm=a.perm, context=a.context)
            if why:
                ap.error(why)
            if (a.perm in RESTRICTED_PERMS or strip_requested(a)) and not a.interactive and not keep_user_config(a):
                try:  # this launch gets a sanitized config: its only plugin is the trusted guard, which must exist
                    go_guard_dir()
                except ConfigError as e:
                    ap.error(str(e))
            if any(str(value).split("=", 1)[0].lower() in ("model", "modelid", "model_id", "provider", "providerid") for value in a.set):
                ap.error("Go model selection must use --model, not --set")
            if a.go_advisory and a.interactive:
                ap.error("Go advisory runs are single-turn; --interactive is refused")
            if go_policy.classification(a.model) == "advisory":
                if a.verify is not None or a.prompt_retries:
                    ap.error("Go advisory use cannot run --verify or prompt retries")
                a.wrapup_grace = 0
                a.wrapup = None
                a.go_bounded = True  # prompt_turn refuses every deadline extension (extend_deadline)
    check_static(a)
    if a.prompt_retries < 0:
        ap.error("--prompt-retries must be 0 or more")
    if a.handshake_timeout is not None and a.handshake_timeout <= 0:
        ap.error("--handshake-timeout must be positive")
    if a.wrapup_grace < 0:
        ap.error("--wrapup-grace must be 0 or more")
    if a.wrapup and not a.wrapup_grace:
        ap.error("--wrapup needs --wrapup-grace")
    if a.verify_retries < 0:
        ap.error("--verify-retries must be 0 or more")
    if a.verify_timeout <= 0:
        ap.error("--verify-timeout must be positive")
    if a.verify is not None and not a.verify.strip():
        ap.error("--verify command cannot be empty")
    if a.session_id is not None:
        if a.agent != "claude":
            ap.error("--session-id is for claude only")
        try:
            a.session_id = str(uuid.UUID(a.session_id))
        except ValueError:
            ap.error("--session-id must be a UUID")
    a.prompt_text = None
    if not a.info:
        if a.prompt_file:
            a.prompt_text = Path(a.prompt_file).read_text()
        elif a.prompt:
            a.prompt_text = a.prompt
        elif a.interactive:
            pass  # stdin feeds the prompt loop instead
        elif not sys.stdin.isatty():
            a.prompt_text = sys.stdin.read()
        else:
            ap.error("give a prompt with -p, -f or stdin")
    cmd = YOLO_CMD.get(a.agent, AGENTS[a.agent][0])
    exe = agent_executable(cmd)
    if not shutil.which(exe):
        wait, poll = bin_wait_settings()
        if wait > 0:
            print(f"acp-run: {exe} not found on PATH; waiting up to {wait:g} s in case an upgrade "
                  f"is relinking it (ACP_RUN_BIN_WAIT=0 disables)", file=sys.stderr)
            deadline = time.monotonic() + wait
            while not shutil.which(exe) and time.monotonic() < deadline:
                time.sleep(min(poll, max(0.0, deadline - time.monotonic())))
            found = shutil.which(exe)
            if found:
                bin_settle(found, poll)
        if not shutil.which(exe):
            print(f"acp-run: {exe} not installed", file=sys.stderr)
            sys.exit(EXIT_NOT_INSTALLED)
    if a.max_load is not None and not a.info:
        why = load_guard(a.max_load, a.load_wait)
        if why:
            print(f"acp-run: refusing to start: {why}", file=sys.stderr)
            return EXIT_LOAD
    if a.perm in RESTRICTED_PERMS or strips_outside_deny(a):
        safe_sweep_stale_deny_dirs()  # dirs a SIGKILLed deny/strip run could not remove
    state = Path.home() / ".local/state/acp-run"
    state.mkdir(parents=True, exist_ok=True)
    stamp = time.strftime("%Y%m%d-%H%M%S")
    log_path = (
        Path(a.log) if a.log else state / f"{stamp}-{a.agent}-{os.getpid()}.jsonl"
    )
    with open(log_path, "w") as log, open(log_path.with_suffix(".stderr"), "w") as err:
        return asyncio.run(run(a, log, err, log_path))


if __name__ == "__main__":
    sys.exit(main())

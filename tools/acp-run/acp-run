            and a.agent in STRIP_ANY_PERM and strip_requested(a))


def jsonc_loads(text):
    """json.loads that also takes // and /* */ comments and trailing commas outside
    strings, as opencode's JSONC parser does (opencode.jsonc)."""
    out, i, n, in_str = [], 0, len(text), False
    while i < n:
        c = text[i]
        if in_str:
            out.append(c)
            if c == "\\" and i + 1 < n:
                out.append(text[i + 1])
                i += 1
            elif c == '"':
                in_str = False
        elif c == '"':
            in_str = True
            out.append(c)
        elif text.startswith("//", i):
            j = text.find("\n", i)
            i = n if j < 0 else j
            continue
        elif text.startswith("/*", i):
            j = text.find("*/", i + 2)
            i = n if j < 0 else j + 2
            continue
        elif c in "}]":
            # drop a trailing comma: the last non-space character emitted before } or ]
            k = len(out) - 1
            while k >= 0 and out[k] in " \t\r\n":
                k -= 1
            if k >= 0 and out[k] == ",":
                del out[k]
            out.append(c)
        else:
            out.append(c)
        i += 1
    return json.loads("".join(out))


def deep_merge(base, over):
    """Recursive dict merge (over wins), as opencode merges its config files."""
    out = dict(base)
    for k, v in over.items():
        out[k] = deep_merge(out[k], v) if isinstance(out.get(k), dict) and isinstance(v, dict) else v
    return out


# A provider value moved out of the temp file into the child's env (finding 1 of the
# 2026-10-13 adversary review): opencode substitutes {env:NAME} in config text
# (ConfigVariable.substitute, 2.0.27) before parsing, so the value must not contain
# a quote, backslash or brace, and must be printable ASCII (re-review finding 3); any
# other literal stays in the 0600 file. Note: the env hands the value to every child the
# agent starts (LSP servers, formatters); the gain is that nothing secret is left on
# disk after a SIGKILL.
_SECRET_KEY = re.compile(r"(?i)api[_-]?key|token|secret|passw|authorization|bearer|cookie|credential")
_ENV_SAFE = re.compile(r'[\x20\x21\x23-\x5b\x5d-\x7a\x7c\x7e]+')  # printable ASCII minus " \\ { }


def _secrets_to_env(node, extra_env, left, path="provider", in_headers=False):
    """Replace literal secret-looking strings under node with {env:...}, in place."""
    for k, v in list(node.items()):
        p = f"{path}.{k}"
        if isinstance(v, dict):
            _secrets_to_env(v, extra_env, left, p, in_headers or str(k).lower() == "headers")
        elif (isinstance(v, str) and (in_headers or _SECRET_KEY.search(str(k)))
              and "{env:" not in v and "{file:" not in v):
            if _ENV_SAFE.fullmatch(v):
                name = f"ACP_RUN_OPENCODE_SECRET_{len(extra_env)}"
                extra_env[name] = v
                node[k] = "{env:" + name + "}"
            else:
                left.append(p)


def _abs_file_refs(obj, base):
    """Rewrite relative {file:x} references to absolute paths under base, since the
    copy lives in the temp dir and opencode resolves them against the config file."""
    if isinstance(obj, dict):
        return {k: _abs_file_refs(v, base) for k, v in obj.items()}
    if isinstance(obj, list):
        return [_abs_file_refs(v, base) for v in obj]
    if isinstance(obj, str) and "{file:" in obj:
        return re.sub(r"\{file:([^}]+)\}", lambda m: m.group(0) if m.group(1).startswith(("/", "~"))
                      else "{file:" + os.path.normpath(os.path.join(base, m.group(1))) + "}", obj)
    return obj


def _private_write(path, text):
    """Write a 0600 file (its 0700 temp dir is the real boundary)."""
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(text)


def opencode_deny_config(env, tag="deny", guard=None):
    """A per-run OPENCODE_CONFIG_DIR for --perm deny: one opencode.json holding only
    OPENCODE_KEEP_KEYS from the user's global config (and OPENCODE_CONFIG, if set),
    deep-merged in that order as opencode does. opencode v2 (checked 2.0.27, from the
    bundled source) takes OPENCODE_CONFIG_DIR as its global config directory instead
    of ~/.config/opencode, and scans plugins only in <global>/plugin(s)/ and project
    .opencode/ dirs, so no user plugin and no MCP server is loaded; the caller also
    turns project config off. Literal secrets in provider blocks go to the child's
    env as {env:...} references instead of the file; relative {file:x} references are
    made absolute (the copy no longer sits next to them). Raises ValueError, before
    creating anything, when a source file cannot be read or parsed: a partial copy
    would silently lose the provider or model. guard, a resolved go_guard_dir(), is the one plugin
    kept: it is linked as plugins/ade-go-context in the temp dir (OpenCode's global plugin discovery,
    README of opencode-plugins/go-context) and nothing else is copied there, so every other user plugin
    stays excluded. Returns (temp dir, log info, extra env);
    the caller removes the dir. env is the child's env."""
    src = Path(env.get("OPENCODE_CONFIG_DIR") or Path(
        env.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "opencode").expanduser()
    files = [src / "opencode.json", src / "opencode.jsonc"]
    if env.get("OPENCODE_CONFIG"):
        files.append(Path(env["OPENCODE_CONFIG"]).expanduser())
    kept, dropped, mcp, plugins = {}, set(), set(), []
    for f in files:
        try:
            cfg = jsonc_loads(f.read_text())
        except FileNotFoundError:
            continue
        except (OSError, ValueError, UnicodeDecodeError) as e:
            raise ValueError(f"cannot read {f}: {e}") from None
        if not isinstance(cfg, dict):
            raise ValueError(f"cannot read {f}: not a JSON object")  # noqa: TRY004 - callers catch ValueError for every unreadable config
        for k, v in cfg.items():
            if k in ("provider", "experimental") and isinstance(v, dict):
                if k == "experimental":
                    keep = {x: v[x] for x in OPENCODE_KEEP_EXPERIMENTAL if x in v}
                    if set(v) - set(keep):
                        dropped.add("experimental." + ",".join(sorted(set(v) - set(keep))))
                    v = keep
                if v:
                    kept[k] = deep_merge(kept.get(k) or {}, _abs_file_refs(v, str(f.parent)))
            elif k in OPENCODE_KEEP_KEYS:
                kept[k] = _abs_file_refs(v, str(f.parent))
            else:
                dropped.add(k)
        m = cfg.get("mcp")
        if isinstance(m, dict):
            servers = m.get("servers") if isinstance(m.get("servers"), dict) else m
            mcp.update(str(s) for s in servers)
        for k in ("plugin", "plugins"):
            vals = cfg.get(k)
            for p in vals if isinstance(vals, list) else []:
                # a name or path only, never a plugin's options
                name = p if isinstance(p, str) else (p[0] if isinstance(p, list) and p else
                                                     p.get("package") if isinstance(p, dict) else None)
                if isinstance(name, str):
                    plugins.append(name)
    for sub in ("plugin", "plugins"):
        try:
            plugins += [f"{sub}/{e.name}" for e in sorted((src / sub).iterdir())]
        except OSError:
            pass
    extra_env, on_disk = {}, []
    if isinstance(kept.get("provider"), dict):
        _secrets_to_env(kept["provider"], extra_env, on_disk)
    d = Path(tempfile.mkdtemp(prefix=f"{DENY_DIR_PREFIX}opencode-{tag}-{os.getpid()}-"))
    try:
        _private_write(d / "opencode.json", json.dumps(kept, indent=1))
        if guard is not None:
            (d / "plugins").mkdir(mode=0o700)
            (d / "plugins" / GO_GUARD_NAME).symlink_to(guard, target_is_directory=True)
    except BaseException:
        shutil.rmtree(d, ignore_errors=True)
        raise
    info = {"agent": "opencode", "action": "stripped", "source": str(src),
            "kept_keys": sorted(kept), "dropped_keys": sorted(dropped),
            "mcp_servers": sorted(mcp), "plugins": plugins, "project_config": "off",
            "trusted_plugins": [GO_GUARD_NAME] if guard is not None else [],
            "secrets_via_env": len(extra_env), "secrets_in_file": on_disk,
            "env": ["OPENCODE_CONFIG_DIR", "OPENCODE_DISABLE_PROJECT_CONFIG",
                    "OPENCODE_CONFIG_PROJECT_DISABLE", "-OPENCODE_CONFIG"]
            + sorted(extra_env)}
    return d, info, extra_env


# --perm deny for grok, made real (2026-10-15). Two causes made `acp-dispatch`'s preflight probe
# ("Reply with exactly: OK" under --perm deny) exit 77 (tripwire) for grok: (1) acp-run launched
# `grok agent --always-approve stdio` for every policy, so grok never sent a
# session/request_permission; (2) the user's grok hooks ran on a trivial prompt: the Stop hook
# ~/.grok/hooks/autorename.json (autorename_nudge.py) answers "the session still needs a title"
# (grok's Stop hook may return additionalContext, so the turn goes on), and grok then ran its
# read-only tool read_file on ~/.grok/skills/autorename/SKILL.md, which grok runs without ever asking.
# So a deny run (a) drops --always-approve (run()) and (b) starts grok on a per-run GROK_HOME that
# symlinks everything in the real one except hooks/, skills/, plugins/, installed-plugins/ and
# config.toml, whose copy has no [[hooks.*]], [plugins] or [mcp_servers.*] tables and, under deny,
# no ui.permission_mode / ui.yolo (the user's config says always-approve). The config copy is
# checked with tomllib: it must equal the original minus exactly those parts, else grok keeps the
# user's home and the run says so. A rotated token grok writes to the temp auth.json as a regular
# file is copied back by grok_sync_auth. Skills the user keeps elsewhere (~/.agents/skills) stay.
GROK_HOME_DROP = ("hooks", "skills", "plugins", "installed-plugins", "config.toml")
GROK_DROP_TABLES = ("mcp_servers", "plugins", "hooks")
GROK_DENY_UI_KEYS = ("permission_mode", "yolo")
# Default for every non-interactive grok run (operator 2026-10-15): the same stripped home but
# only hooks, skills and plugins go; MCP servers (tools the operator configured on purpose) and
# the permission mode stay. Opt out: ACP_RUN_GROK_USER_HOOKS=1 (or --keep-user-config) keeps ~/.grok.
GROK_HOOKS_ONLY_TABLES = ("plugins", "hooks")
# Under deny the copy ends with this table, replacing the user's own [permission]: a bare `*` ask
# rule makes grok send session/request_permission for every tool, file reads included (grok runs
# its "read-only" tools, and writes under the user's allow rules, without asking otherwise;
# severity is deny > ask > allow, so no allow rule from any source beats it).
GROK_DENY_PERMISSION = '\n# acp-run --perm deny: ask before every tool (the answer is always no)\n[permission]\nask = ["*"]\n'


def grok_real_home():
    return Path(os.environ.get("GROK_HOME") or Path.home() / ".grok").expanduser()


def grok_filter_config(text, deny=True, mcp=True):
    """(filtered config.toml text, dropped names). Drops the tables in GROK_DROP_TABLES (and
    their sub-tables; mcp=False keeps [mcp_servers.*]) and, with deny, ui.permission_mode /
    ui.yolo. Line based; the caller checks the result with tomllib (grok_check_config)."""
    out, dropped, skip, table = [], [], False, ""
    drop = (GROK_DROP_TABLES if mcp else GROK_HOOKS_ONLY_TABLES) + (("permission",) if deny else ())
    for line in text.splitlines(keepends=True):
        m = re.match(r"\s*\[\[?\s*([^\[\]]+?)\s*\]\]?\s*(#.*)?$", line)
        if m:
            table = m.group(1).strip()
            head = re.split(r"\s*\.\s*", table, maxsplit=1)[0].strip("\"'")
            skip = head in drop
            if skip and head not in dropped:
                dropped.append(head)
        if skip:
            continue
        if deny and table == "ui" and re.match(r"\s*(" + "|".join(GROK_DENY_UI_KEYS) + r")\s*=", line):
            dropped.append("ui." + line.split("=", 1)[0].strip())
            continue
        out.append(line)
    new = "".join(out)
    if deny:
        new += ("" if new.endswith("\n") or not new else "\n") + GROK_DENY_PERMISSION
    return new, dropped


def grok_check_config(old_text, new_text, deny=True, mcp=True):
    """True when new_text parses and equals old_text minus the dropped parts."""
    import tomllib
    try:
        old, new = tomllib.loads(old_text), tomllib.loads(new_text)
    except (tomllib.TOMLDecodeError, ValueError):
        return False
    gone = GROK_DROP_TABLES if mcp else GROK_HOOKS_ONLY_TABLES
    want = {k: v for k, v in old.items() if k not in gone}
    if deny:
        want.pop("permission", None)
        want["permission"] = {"ask": ["*"]}
        if isinstance(want.get("ui"), dict):
            want["ui"] = {k: v for k, v in want["ui"].items() if k not in GROK_DENY_UI_KEYS}
    return new == want


def grok_user_hooks_requested():
    """True when ACP_RUN_GROK_USER_HOOKS asks for the user's own grok home on headless runs."""
    v = os.environ.get("ACP_RUN_GROK_USER_HOOKS", "").strip().lower()
    return bool(v) and v not in ("0", "false", "no", "off")


def grok_strip_home(tag="deny", deny=True, mcp=True):
    """A per-run GROK_HOME without the user's hooks, skills, plugins and MCP servers (see the
    note above). Returns (temp dir, log info); the caller removes the dir (rmtree unlinks
    the symlinks and never follows them). Raises ValueError, before creating anything, when
    the config copy is not exactly the original minus the dropped parts."""
    src = grok_real_home()
    cfg = src / "config.toml"
    try:
        text = cfg.read_text() if cfg.is_file() else ""
    except (OSError, UnicodeDecodeError) as e:
        raise ValueError(f"cannot read {cfg}: {e}") from None
    new_text, dropped = grok_filter_config(text, deny, mcp)
    if not grok_check_config(text, new_text, deny, mcp):
        raise ValueError(f"cannot filter {cfg} safely")
    try:
        hooks = sorted(e.name for e in (src / "hooks").iterdir())
    except OSError:
        hooks = []
    d = Path(tempfile.mkdtemp(prefix=f"{DENY_DIR_PREFIX}grok-{tag}-{os.getpid()}-"))
    try:
        try:
            entries = sorted(src.iterdir())
        except OSError:
            entries = []
        for f in entries:
            if f.name not in GROK_HOME_DROP:
                (d / f.name).symlink_to(f)
        if text:
            _private_write(d / "config.toml", new_text)
    except BaseException:
        shutil.rmtree(d, ignore_errors=True)
        raise
    return d, {"agent": "grok", "action": "stripped", "source": str(src), "home": str(d),
               "hooks": hooks, "dropped": dropped, "skills": "~/.grok/skills off",
               "mcp": "off" if mcp else "kept", "env": ["GROK_HOME"]}


def grok_sync_auth(d, src=None):
    """Copy a token grok rewrote as a regular file in the temp home back over the real
    auth.json when it is newer and valid JSON (rename-over replaces the symlink, so the
    write would otherwise be lost with the temp dir). True when copied."""
    new, real = Path(d) / "auth.json", Path(src or grok_real_home()) / "auth.json"
    try:
        if new.is_symlink() or not new.is_file() or new.stat().st_mtime <= real.stat().st_mtime:
            return False
        json.loads(new.read_text())
        target = real.resolve()
        tmp = target.with_name(target.name + f".acp-run-{os.getpid()}")
        shutil.copyfile(new, tmp)
        os.chmod(tmp, 0o600)
        os.replace(tmp, target)
        return True
    except (OSError, ValueError):
        return False



def strip_user_config(a, env, deny_dir):
    """Apply STRIP_USER_CONFIG to env (in place) for a --perm deny or read-only, non-interactive run
    of opencode or grok. Returns (deny_dir, log info or None): deny_dir is the temp dir
    the caller removes. Anything else (--perm all, --interactive, other
    agents) is untouched and logs nothing. If the temp config cannot be built the run
    keeps the user's config (deny still refuses every tool) and says so on stderr;
    that includes an unreadable or unparseable opencode config file.
    Known limit (adversary review 2026-10-13, finding 4): opencode {file:x} references are made
    absolute, but a relative one added by another config layer would resolve against the temp dir.

    --strip-user-config (strips_outside_deny, 2026-10-13) applies the same strip under any
    other non-interactive --perm for opencode and grok, with dirs named
    -strip- and nothing permission-related added: opencode gets no deny permission
    (DENY_ENV is applied by run() under deny only)."""
    outside = strips_outside_deny(a)
    # grok, every non-interactive run not already stripped above (operator 2026-10-15): no
    # user hooks, skills or plugins, MCP servers and permission mode kept (tag "hooks").
    grok_hooks = (a.agent == "grok" and not outside and a.perm not in RESTRICTED_PERMS
                  and not getattr(a, "interactive", False))
    if not outside and not grok_hooks and (a.perm not in RESTRICTED_PERMS or getattr(a, "interactive", False)
                                           or a.agent not in STRIP_USER_CONFIG):
        return deny_dir, None
    why = keep_user_config(a)
    if why:
        info = {"agent": a.agent, "action": "kept",
                "why": "--keep-user-config" if why == "flag" else "ACP_RUN_KEEP_USER_CONFIG"}
        if a.agent == "grok":
            info["home"] = str(grok_real_home())
        return deny_dir, info
    if grok_hooks and grok_user_hooks_requested():
        return deny_dir, {"agent": "grok", "action": "kept", "why": "ACP_RUN_GROK_USER_HOOKS",
                          "home": str(grok_real_home())}
    tag = "hooks" if grok_hooks else "strip" if outside else "deny"
    try:
        if a.agent == "opencode":
            d, info, extra = opencode_deny_config(env, tag, go_guard_dir() if is_go_model(getattr(a, "model", None)) else None)
            env.update(extra)  # literal provider secrets, referenced as {env:...} in d
            env["OPENCODE_CONFIG_DIR"] = str(d)
            # opencode reads OPENCODE_CONFIG_PROJECT_DISABLE ?? OPENCODE_DISABLE_PROJECT_CONFIG
            env["OPENCODE_CONFIG_PROJECT_DISABLE"] = "1"
            env["OPENCODE_DISABLE_PROJECT_CONFIG"] = "1"
            env.pop("OPENCODE_CONFIG", None)  # an explicit file is loaded on top; its kept keys are in d
        elif a.agent == "grok":
            d, info = grok_strip_home(tag, deny=not (outside or grok_hooks), mcp=not grok_hooks)
            env["GROK_HOME"] = str(d)
        else:
            return deny_dir, None
    except (OSError, ValueError) as e:
        if a.agent == "opencode" and is_go_model(getattr(a, "model", None)):
            # a Go run must not fall back to the user's unsanitized config: its trusted guard could not be placed
            raise ConfigError(f"could not build opencode's sanitized config with the trusted Go context guard: {e}") from None
        print(f"acp-run: could not strip {a.agent}'s plugins and MCP servers; keeping them: {e}",
              file=sys.stderr)
        kept = {"agent": a.agent, "action": "kept", "why": f"error: {e}"[:300]}
        if a.agent == "grok":
            kept["home"] = str(grok_real_home())
        return deny_dir, kept
    return d, info



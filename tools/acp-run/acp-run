def zcode_deny_settings():
    """A per-run zcode CLI settings dir for --perm deny (re-verification R3, 2026-10-12):
    the user's ~/.zcode/cli/setting.json with MCP servers, plugins, skills, subagents
    and hooks off and plan permissions, plus a hook-free legacy config.json beside it.
    zcode reads it through ZCODE_CLI_SETTINGS_FILE ("lets a host run one process on
    its own settings file (hooks, MCP servers, permissions)"), so only this child is
    affected. Returns the temp dir (caller removes it)."""
    try:
        base = json.loads((Path.home() / ".zcode" / "cli" / "setting.json").read_text())
    except (OSError, ValueError):
        base = {}
    if not isinstance(base, dict):
        base = {}
    base["features"] = {**(base.get("features") or {}),
                        "mcp": False, "subagent": False, "skill": False}
    base["mcp"] = {"servers": {}}
    base["plugins"] = {**(base.get("plugins") or {}), "enabled": False, "enabledPlugins": {}}
    base["skills"] = {**(base.get("skills") or {}), "enabled": False, "roots": []}
    base["hooks"] = {"enabled": False, "events": {}}
    base["permission"] = {**(base.get("permission") or {}), "mode": "plan", "allowedTools": [],
                          "autoApproveHighRisk": False, "allowMediumRiskInAuto": False,
                          "disallowedTools": DENY_ENV["zcode"]["ZCODE_DISALLOWED_TOOLS"].split()}
    d = Path(tempfile.mkdtemp(prefix="acp-run-zcode-deny-"))
    (d / "cli").mkdir()
    (d / "cli" / "setting.json").write_text(json.dumps(base, indent=1))
    (d / "cli" / "config.json").write_text(json.dumps({"hooks": {"enabled": False, "events": {}}}))
    return d



def _agy_server():
    """The newest agy_acp_server.par under ~/.local/share/agy-acp-server/<version>/ (agy upgrades
    unpack a new version dir; until 2026-10-17 1.3.0 was hard-coded here). Falls back to the
    bare path pattern so a missing install fails with a readable path."""
    root = Path.home() / ".local/share/agy-acp-server"

    def key(d):
        return [int(x) if x.isdigit() else 0 for x in re.split(r"[.-]", d.name)]

    dirs = sorted((d for d in root.glob("*/") if (d / "agy_acp_server.par").is_file()), key=key)
    return str((dirs[-1] if dirs else root / "<version>") / "agy_acp_server.par")



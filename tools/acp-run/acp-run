# hermes lists its models only in the legacy session/new field `models`, which the
# SDK's NewSessionResponse drops; keep unknown fields (sess.model_extra) so --info can list them
# and --model can use session/set_model.
import acp.schema as _acp_schema

_acp_schema.NewSessionResponse.model_config["extra"] = "allow"
_acp_schema.NewSessionResponse.model_rebuild(force=True)


async def _route_dollar_as_extension(self, method, params, is_notification):
    if isinstance(method, str) and method.startswith("$/"):
        method = "_" + method[2:]
    elif isinstance(method, str) and is_notification and method != "session/update" and not method.startswith("_"):
        # a server may send an extension notification without the "_" prefix: a
        # logged traceback per notification (2026-10-15); ext_notification ignores it
        method = "_" + method
    return await _acp_route(self, method, params, is_notification)


_acp_router.MessageRouter.__call__ = _route_dollar_as_extension

# Per-host settings file: ~/.config/acp-run.env (ACP_RUN_ENV_FILE overrides
# the path), read when present so every caller sees it, including shells that
# source no rc file (agent tool calls, cron, bash -c). Lines are KEY=VALUE or
# export KEY=VALUE, with optional single/double quotes; blank lines and #
# comments are skipped. Nothing is executed or expanded. A variable already in
# the environment wins. 2026-10-14.
def load_env_file(path=None):
    path = Path(os.path.expanduser(
        path or os.environ.get("ACP_RUN_ENV_FILE") or "~/.config/acp-run.env"))
    try:
        lines = path.read_text().splitlines()
    except OSError:
        return
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[len("export "):].lstrip()
        key, sep, val = line.partition("=")
        key = key.strip()
        if not sep or not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key):
            continue
        val = val.strip()
        if len(val) >= 2 and val[0] == val[-1] and val[0] in "'\"":
            val = val[1:-1]
        else:
            val = val.split(" #", 1)[0].rstrip()
        os.environ.setdefault(key, val)


load_env_file()


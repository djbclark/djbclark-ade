def codex_expected_size(ctx):
    """The usage_update.size codex reports for model_context_window=ctx."""
    return round(ctx * CODEX_EFFECTIVE)


def codex_max_window(model):
    """The model's max_context_window from codex's own catalog ($CODEX_HOME/models_cache.json,
    default ~/.codex), or None when the catalog or the model is not there (the read-back after
    the turn then catches a clamped window). The longest slug found in `model` wins."""
    path = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex") / "models_cache.json"
    try:
        models = json.loads(path.read_text()).get("models") or []
    except (OSError, ValueError, AttributeError):
        return None
    best = None
    for m in models:
        slug, mx = m.get("slug"), m.get("max_context_window")
        if isinstance(slug, str) and isinstance(mx, int) and slug in str(model) \
                and (best is None or len(slug) > len(best[0])):
            best = (slug, mx)
    return best[1] if best else None


def codex_config_with_window(current, ctx):
    """CODEX_CONFIG (a JSON object codex-acp merges into the session config) with
    model_context_window=ctx, keeping everything else `current` already sets."""
    cfg = {}
    if current and current.strip():
        try:
            cfg = json.loads(current)
        except ValueError:
            cfg = None
        if not isinstance(cfg, dict):
            usage_exit("--context: codex needs CODEX_CONFIG to be a JSON object to add model_context_window;"
                       f" it is {current[:60]!r}")
    cfg["model_context_window"] = ctx
    return json.dumps(cfg, separators=(",", ":"))

                if base == src and f.name == "config":
                    continue
                if f.name == "plugins" or f.name.startswith(("hooks.json", "mcp_config.json")):
                    continue
                (tgt / f.name).symlink_to(f)
        _private_write(d / "config" / "mcp_config.json", '{"mcpServers": {}}\n')
        _private_write(d / "config" / "hooks.json", "{}\n")
        (d / "config" / "plugins").mkdir(mode=0o700)
    except BaseException:
        shutil.rmtree(d, ignore_errors=True)
        raise
    info = {"agent": "agy", "action": "stripped", "source": str(src), "mcp_servers": mcp,
            "plugins": plugins, "hooks": "config/hooks.json", "unreadable": unreadable,
            "env": ["GEMINI_HOME"]}
    return d, info


# --perm deny for grok, made real (2026-10-15). Two causes made `acp-dispatch`'s preflight probe
# ("Reply with exactly: OK" under --perm deny) exit 77 (tripwire) for grok: (1) acp-run launched
# `grok agent --always-approve stdio` for every policy, so grok never sent a
# session/request_permission; (2) the user's grok hooks ran on a trivial prompt: the Stop hook
# ~/.grok/hooks/autorename.json (autorename_nudge.py) answers "the session still needs a title"
# (grok's Stop hook may return additionalContext, so the turn goes on), and grok then ran its
# read-only tool read_file on ~/.grok/skills/autorename/SKILL.md, which grok runs without ever asking.
# So a deny run (a) drops --always-approve (run()) and (b) starts grok on a per-run GROK_HOME that
# symlinks everything in the real one except hooks/, skills/, plugins/, installed-plugins/ and
# config.toml, whose copy has no [[hooks.*]], [plugins] or [mcp_servers.*] tables and, under deny,
# no ui.permission_mode / ui.yolo (the user's config says always-approve). The config copy is
# checked with tomllib: it must equal the original minus exactly those parts, else grok keeps the
# user's home and the run says so. A rotated token grok writes to the temp auth.json as a regular
# file is copied back by grok_sync_auth. Skills the user keeps elsewhere (~/.agents/skills) stay.
GROK_HOME_DROP = ("hooks", "skills", "plugins", "installed-plugins", "config.toml")
GROK_DROP_TABLES = ("mcp_servers", "plugins", "hooks")
GROK_DENY_UI_KEYS = ("permission_mode", "yolo")
# Default for every non-interactive grok run (operator 2026-10-15): the same stripped home but
# only hooks, skills and plugins go; MCP servers (tools the operator configured on purpose) and
# the permission mode stay. Opt out: ACP_RUN_GROK_USER_HOOKS=1 (or --keep-user-config) keeps ~/.grok.
GROK_HOOKS_ONLY_TABLES = ("plugins", "hooks")
# Under deny the copy ends with this table, replacing the user's own [permission]: a bare `*` ask
# rule makes grok send session/request_permission for every tool, file reads included (grok runs
# its "read-only" tools, and writes under the user's allow rules, without asking otherwise;
# severity is deny > ask > allow, so no allow rule from any source beats it).
GROK_DENY_PERMISSION = '\n# acp-run --perm deny: ask before every tool (the answer is always no)\n[permission]\nask = ["*"]\n'


def grok_real_home():
    return Path(os.environ.get("GROK_HOME") or Path.home() / ".grok").expanduser()


def grok_filter_config(text, deny=True, mcp=True):
    """(filtered config.toml text, dropped names). Drops the tables in GROK_DROP_TABLES (and
    their sub-tables; mcp=False keeps [mcp_servers.*]) and, with deny, ui.permission_mode /
    ui.yolo. Line based; the caller checks the result with tomllib (grok_check_config)."""
    out, dropped, skip, table = [], [], False, ""
    drop = (GROK_DROP_TABLES if mcp else GROK_HOOKS_ONLY_TABLES) + (("permission",) if deny else ())
    for line in text.splitlines(keepends=True):
        m = re.match(r"\s*\[\[?\s*([^\[\]]+?)\s*\]\]?\s*(#.*)?$", line)
        if m:
            table = m.group(1).strip()
            head = re.split(r"\s*\.\s*", table, maxsplit=1)[0].strip("\"'")
            skip = head in drop
            if skip and head not in dropped:
                dropped.append(head)
        if skip:
            continue
        if deny and table == "ui" and re.match(r"\s*(" + "|".join(GROK_DENY_UI_KEYS) + r")\s*=", line):
            dropped.append("ui." + line.split("=", 1)[0].strip())
            continue
        out.append(line)
    new = "".join(out)
    if deny:
        new += ("" if new.endswith("\n") or not new else "\n") + GROK_DENY_PERMISSION
    return new, dropped


def grok_check_config(old_text, new_text, deny=True, mcp=True):
    """True when new_text parses and equals old_text minus the dropped parts."""
    import tomllib
    try:
        old, new = tomllib.loads(old_text), tomllib.loads(new_text)
    except (tomllib.TOMLDecodeError, ValueError):
        return False
    gone = GROK_DROP_TABLES if mcp else GROK_HOOKS_ONLY_TABLES
    want = {k: v for k, v in old.items() if k not in gone}
    if deny:
        want.pop("permission", None)
        want["permission"] = {"ask": ["*"]}
        if isinstance(want.get("ui"), dict):
            want["ui"] = {k: v for k, v in want["ui"].items() if k not in GROK_DENY_UI_KEYS}
    return new == want


def grok_user_hooks_requested():
    """True when ACP_RUN_GROK_USER_HOOKS asks for the user's own grok home on headless runs."""
    v = os.environ.get("ACP_RUN_GROK_USER_HOOKS", "").strip().lower()
    return bool(v) and v not in ("0", "false", "no", "off")


def grok_strip_home(tag="deny", deny=True, mcp=True):
    """A per-run GROK_HOME without the user's hooks, skills, plugins and MCP servers (see the
    note above). Returns (temp dir, log info); the caller removes the dir (rmtree unlinks
    the symlinks and never follows them). Raises ValueError, before creating anything, when
    the config copy is not exactly the original minus the dropped parts."""
    src = grok_real_home()
    cfg = src / "config.toml"
    try:
        text = cfg.read_text() if cfg.is_file() else ""
    except (OSError, UnicodeDecodeError) as e:
        raise ValueError(f"cannot read {cfg}: {e}") from None
    new_text, dropped = grok_filter_config(text, deny, mcp)
    if not grok_check_config(text, new_text, deny, mcp):
        raise ValueError(f"cannot filter {cfg} safely")
    try:
        hooks = sorted(e.name for e in (src / "hooks").iterdir())
    except OSError:
        hooks = []
    d = Path(tempfile.mkdtemp(prefix=f"{DENY_DIR_PREFIX}grok-{tag}-{os.getpid()}-"))
    try:
        try:
            entries = sorted(src.iterdir())
        except OSError:
            entries = []
        for f in entries:
            if f.name not in GROK_HOME_DROP:
                (d / f.name).symlink_to(f)
        if text:
            _private_write(d / "config.toml", new_text)
    except BaseException:
        shutil.rmtree(d, ignore_errors=True)
        raise
    return d, {"agent": "grok", "action": "stripped", "source": str(src), "home": str(d),
               "hooks": hooks, "dropped": dropped, "skills": "~/.grok/skills off",
               "mcp": "off" if mcp else "kept", "env": ["GROK_HOME"]}


def grok_sync_auth(d, src=None):
    """Copy a token grok rewrote as a regular file in the temp home back over the real
    auth.json when it is newer and valid JSON (rename-over replaces the symlink, so the
    write would otherwise be lost with the temp dir). True when copied."""
    new, real = Path(d) / "auth.json", Path(src or grok_real_home()) / "auth.json"
    try:
        if new.is_symlink() or not new.is_file() or new.stat().st_mtime <= real.stat().st_mtime:
            return False
        json.loads(new.read_text())
        target = real.resolve()
        tmp = target.with_name(target.name + f".acp-run-{os.getpid()}")
        shutil.copyfile(new, tmp)
        os.chmod(tmp, 0o600)
        os.replace(tmp, target)
        return True
    except (OSError, ValueError):
        return False


# --perm deny for crush, made real (2026-10-13). crush-acp (PR 2450 build) asks
# permission for bash, edit, write, fetch and download, but runs its read-only tools
# (glob, grep, ls, view, sourcegraph, LSP lookups) and bash's built-in safe commands
# without asking: on the 2026-10-13 03:43 SkillOpt-Sleep canary it ran `glob` (ACP kind
# "search") unasked and the tripwire fired (exit 77). Its ACP modes are "ask" (the
# default) and "code"; neither makes those tools ask. But crush builds each agent's tool
# set from an allow list, config.allToolNames() minus options.disabled_tools
# (internal/config/config.go SetupAgents; buildTools keeps only listed names), so a deny
# run disables every name in it: the agent has no built-in tool at all and can only
# answer in text. A tool added to crush later is not in allToolNames until someone lists
# it, so it stays out too. Config layers merge with go-jsons (arrays append, objects
# merge, scalars: later wins), so no later layer can take a name off disabled_tools.
# The list is crush-acp 88a67503's allToolNames(); `agent` and `agentic_fetch` are the
# sub-agent tools.
CRUSH_TOOLS = (
    "agent", "agentic_fetch", "bash", "crush_info", "crush_logs", "job_output", "job_kill",
    "download", "edit", "multiedit", "fetch", "glob", "grep", "ls", "question", "sourcegraph",
    "todos", "view", "write", "list_mcp_resources", "read_mcp_resource",
    "lsp_diagnostics", "lsp_references", "lsp_restart", "lsp_symbols", "lsp_definition",
    "lsp_call_hierarchy", "lsp_rename", "lsp_replace_symbol",
)
# Project config files crush merges from -C up to its git root (lookupConfigs).
CRUSH_PROJECT_FILES = (".crushrc", "crushrc", ".crush.json", "crush.json")
# `mcp add NAME` in a crushrc (internal/shellconfig/mcp.go); names only, for the log
# and to disable a project's servers.
CRUSH_RC_MCP = re.compile(r"^\s*mcp\s+add\s+['\"]?([A-Za-z0-9_.@-]+)", re.MULTILINE)
# A crushrc line (comments removed) that could reach a config builtin past the stripped
# run's shell functions: command/builtin/exec skip functions, a command runner (env,
# xargs, ...) may exec the name directly, unset -f removes the functions. Refuse to strip.
CRUSH_RC_BYPASS = re.compile(r"\b(command|builtin|exec|env|xargs|nohup|nice|timeout)\b[^\n;|&]*?"
                             r"\b(mcp|lsp|hook|permissions|option)\b"
                             r"|\bunset\b[^\n;|&]*?(?<!\S)-\w*f")
CRUSH_RC_COMMENT = re.compile(r"(^|(?<=\s))#[^\n]*", re.MULTILINE)
# `option` keys a stripped run passes through from the user's crushrc; context paths,
# skill paths, data directory, LSP and UI options are dropped.
CRUSH_RC_KEEP_OPTIONS = ("request-timeout", "disable-skill", "auto-summarize",
                         "provider-auto-update", "default-providers", "metrics")
# Top-level keys (and options keys) a stripped run keeps from the user's global crush.json.
CRUSH_KEEP_KEYS = ("$schema", "providers", "models")
CRUSH_KEEP_OPTIONS = ("request_timeout", "disabled_skills", "disable_provider_auto_update",
                      "disable_default_providers", "disable_metrics", "disable_auto_summarize")


def crush_project_configs(root):
    """The project config files crush would merge for cwd root: CRUSH_PROJECT_FILES in
    root and each parent up to the enclosing git worktree root (root alone outside git)."""
    root = Path(root).resolve()
    chain = [root, *root.parents]
    top = next((p for p in chain if (p / ".git").exists()), root)
    found = []
    for p in chain[:chain.index(top) + 1]:
        found += [p / n for n in CRUSH_PROJECT_FILES if (p / n).is_file()]
    return found


def _crush_mcp_names(path):
    """MCP server names a crush config file defines (JSON "mcp" keys, or crushrc
    `mcp add NAME`); [] when it cannot be read."""
    try:
        text = path.read_text()
    except (OSError, UnicodeDecodeError):
        return []
    if path.name.endswith("rc"):
        return CRUSH_RC_MCP.findall(text)
    try:
        m = json.loads(text).get("mcp")
    except (ValueError, AttributeError):
        return []
    return [str(k) for k in m] if isinstance(m, dict) else []


def crush_deny_dir(cmd, root, env, tools_off=True):
    """The tools-off half of --perm deny for crush (always applied, --interactive and
    --keep-user-config included). A per-run 0700 temp dir holding:
      data/crush.json     the global data layer (CRUSH_GLOBAL_DATA; it merges after the
                          user's crush.json and crushrc), and
      project/crush.json  the workspace layer (--data-dir; it merges after every project
                          config, so it is the last word),
    both {"options": {"disabled_tools": CRUSH_TOOLS, "auto_lsp": false},
    "permissions": {"skip_requests": false}}, plus "mcp": {NAME: {"disabled": true}} for
    each MCP server a project config file names. data/ also gets a copy of the catalog
    cache providers.json from the agent's usual data dir. --data-dir moves crush's
    session database and workspace overrides out of -C (a .crush/crush.json there would
    otherwise merge last). Returns (temp dir, new cmd, log info); env gets
    CRUSH_GLOBAL_DATA too. Raises OSError (nothing left behind) when it cannot be built.

    tools_off=False (--strip-user-config outside --perm deny, 2026-10-13) builds the same
    dir, named crush-strip-, without disabled_tools and without the permissions key:
    every built-in tool stays on and crush's own --yolo / permission prompts (which
    --perm all auto-approves) decide; LSP auto-start and project MCP servers stay off."""
    src = next((x.split("=", 1)[1] for x in cmd if x.startswith("CRUSH_GLOBAL_DATA=")),
               env.get("CRUSH_GLOBAL_DATA"))
    project = crush_project_configs(root)
    mcp = sorted({n for f in project for n in _crush_mcp_names(f)})
    if tools_off:
        over = {"options": {"disabled_tools": list(CRUSH_TOOLS), "auto_lsp": False},
                "permissions": {"skip_requests": False}}
    else:
        over = {"options": {"auto_lsp": False}}
    if mcp:
        over["mcp"] = {n: {"disabled": True} for n in mcp}
    tag = "deny" if tools_off else "strip"
    d = Path(tempfile.mkdtemp(prefix=f"{DENY_DIR_PREFIX}crush-{tag}-{os.getpid()}-"))
    try:
        for sub in ("data", "project"):
            (d / sub).mkdir(mode=0o700)
            _private_write(d / sub / "crush.json", json.dumps(over, indent=1) + "\n")
        if src:
            with contextlib.suppress(FileNotFoundError):
                shutil.copyfile(Path(src).expanduser() / "providers.json", d / "data" / "providers.json")
    except BaseException:
        shutil.rmtree(d, ignore_errors=True)
        raise
    data = f"CRUSH_GLOBAL_DATA={d / 'data'}"
    new = [data if x.startswith("CRUSH_GLOBAL_DATA=") else x for x in cmd]
    new += ["--data-dir", str(d / "project")]
    env["CRUSH_GLOBAL_DATA"] = str(d / "data")
    info = {"agent": "crush", "tools": "none" if tools_off else "all",
            "disabled_tools": len(CRUSH_TOOLS) if tools_off else 0,
            "project_config": [str(f) for f in project], "project_mcp_disabled": mcp,
            "env": ["CRUSH_GLOBAL_DATA"], "args": ["--data-dir"]}
    rcs = [str(f) for f in project if f.name.endswith("rc")]
    if rcs:
        # crush runs a project crushrc as shell when it loads its config; no switch
        # turns project config off (a deny run's tools stay off regardless)
        with contextlib.suppress(OSError):
            print(f"acp-run: warning: crush will run project crushrc {', '.join(rcs)} at startup",
                  file=sys.stderr)
    return d, new, info


def crush_strip_config(env, d, why="--perm deny"):
    """The user-config half of --perm deny for crush (STRIP_USER_CONFIG): a per-run
    global config dir d/config (CRUSH_GLOBAL_CONFIG) whose crushrc sources the user's
    crushrc for its providers and models, with the config builtins that add MCP servers
    (mcp), LSP servers (lsp), hooks (hook) and permission rules (permissions) shadowed by
    no-op shell functions (crush's interpreter resolves a function before a registered
    builtin; checked 2026-10-13), and `option` passed through only for
    CRUSH_RC_KEEP_OPTIONS. The user's global crush.json, if any, is copied with only
    CRUSH_KEEP_KEYS and options.CRUSH_KEEP_OPTIONS. With the config dir moved, crush's
    default global context files (CRUSH.md beside it, AGENTS.md in its parent) are the
    temp dir's, which do not exist, and CRUSH_SKILLS_DIR points at an empty d/skills, so
    no global skill is listed. The user's files are only read; the crushrc keeps its
    path (no secret is copied). Raises ValueError, before setting env, when the crushrc
    could bypass the shadows (CRUSH_RC_BYPASS) or a file cannot be read. Returns log info."""
    src = Path(env.get("CRUSH_GLOBAL_CONFIG") or Path(env.get("XDG_CONFIG_HOME") or Path.home() / ".config")
               / "crush").expanduser()
    rc, js = src / "crushrc", src / "crush.json"
    try:
        text = rc.read_text() if rc.is_file() else ""
    except (OSError, UnicodeDecodeError) as e:
        raise ValueError(f"cannot read {rc}: {e}") from None
    if CRUSH_RC_BYPASS.search(CRUSH_RC_COMMENT.sub("", text)):
        raise ValueError(f"{rc} calls a config builtin through command/builtin or unsets a function")
    kept, dropped, on_disk = {}, [], []
    if js.is_file():
        try:
            cfg = json.loads(js.read_text())
        except (OSError, ValueError, UnicodeDecodeError) as e:
            raise ValueError(f"cannot read {js}: {e}") from None
        if not isinstance(cfg, dict):
            raise ValueError(f"cannot read {js}: not a JSON object")
        for k, v in cfg.items():
            if k in CRUSH_KEEP_KEYS:
                kept[k] = v
            elif k == "options" and isinstance(v, dict):
                kept["options"] = {x: v[x] for x in CRUSH_KEEP_OPTIONS if x in v}
                dropped += [f"options.{x}" for x in sorted(set(v) - set(CRUSH_KEEP_OPTIONS))]
            else:
                dropped.append(k)
        prov = kept.get("providers")
        for name, p in (prov.items() if isinstance(prov, dict) else ()):
            for key in (p if isinstance(p, dict) else ()):
                if _SECRET_KEY.search(str(key)) and isinstance(p[key], str) and not p[key].startswith("$"):
                    on_disk.append(f"providers.{name}.{key}")
    shadows = (
        f"# acp-run {why}: this run's crush config, removed after the run.\n"
        "mcp() { :; }\nlsp() { :; }\nhook() { :; }\npermissions() { :; }\n"
        "option() {\n  case \"$1\" in\n    " + "|".join(CRUSH_RC_KEEP_OPTIONS)
        + ") command option \"$@\" ;;\n  esac\n}\n"
        + (f"source {shlex.quote(str(rc))}\n" if text else ""))
    cfg_dir, skills = d / "config", d / "skills"
    cfg_dir.mkdir(mode=0o700)
    skills.mkdir(mode=0o700)
    _private_write(cfg_dir / "crushrc", shadows)
    if kept:
        _private_write(cfg_dir / "crush.json", json.dumps(kept, indent=1) + "\n")
    env["CRUSH_GLOBAL_CONFIG"] = str(cfg_dir)
    env["CRUSH_SKILLS_DIR"] = str(skills)
    return {"agent": "crush", "action": "stripped", "source": str(src),
            "mcp_servers": sorted(set(CRUSH_RC_MCP.findall(text)) | set(_crush_mcp_names(js))),
            "lsp": len(re.findall(r"^\s*lsp\s", text, re.MULTILINE)),
            "hooks": len(re.findall(r"^\s*hook\s", text, re.MULTILINE)),
            "kept_keys": sorted(kept), "dropped_keys": dropped, "secrets_in_file": on_disk,
            "global_context": "off", "skills": "none",
            "env": ["CRUSH_GLOBAL_CONFIG", "CRUSH_SKILLS_DIR"]}


def strip_user_config(a, env, deny_dir):
    """Apply STRIP_USER_CONFIG to env (in place) for a --perm deny, non-interactive run
    of opencode, agy or crush (crush builds inside deny_dir, run()'s crush_deny_dir). Returns (deny_dir, log info or None): deny_dir is the temp dir
    the caller removes. Anything else (--perm all, --interactive, other
    agents) is untouched and logs nothing. If the temp config cannot be built the run
    keeps the user's config (deny still refuses every tool) and says so on stderr;
    that includes an unreadable or unparseable opencode config file.
    Known limits (adversary review 2026-10-13, finding 4): auth a run rewrites by
    write-then-rename through the agy shadow's symlinks (oauth_creds.json) lands in
    the temp dir and is lost with it; opencode {file:x} references are made absolute,
    but a relative one added by another config layer would resolve against the temp dir.

    --strip-user-config (strips_outside_deny, 2026-10-13) applies the same strip under any
    other non-interactive --perm for opencode, agy, crush and zcode, with dirs named
    -strip- and nothing permission-related added: opencode gets no deny permission
    (DENY_ENV is applied by run() under deny only), zcode a settings file with the user's
    permission block untouched (zcode_strip_settings), crush builds inside run()'s
    tools-on dir (crush_deny_dir tools_off=False)."""
    outside = strips_outside_deny(a)
    # grok, every non-interactive run not already stripped above (operator 2026-10-15): no
    # user hooks, skills or plugins, MCP servers and permission mode kept (tag "hooks").
    grok_hooks = (a.agent == "grok" and not outside and a.perm != "deny"
                  and not getattr(a, "interactive", False))
    if not outside and not grok_hooks and (a.perm != "deny" or getattr(a, "interactive", False)
                                           or a.agent not in STRIP_USER_CONFIG):
        return deny_dir, None
    why = keep_user_config(a)
    if why:
        info = {"agent": a.agent, "action": "kept",
                "why": "--keep-user-config" if why == "flag" else "ACP_RUN_KEEP_USER_CONFIG"}
        if a.agent == "grok":
            info["home"] = str(grok_real_home())
        return deny_dir, info
    if grok_hooks and grok_user_hooks_requested():
        return deny_dir, {"agent": "grok", "action": "kept", "why": "ACP_RUN_GROK_USER_HOOKS",
                          "home": str(grok_real_home())}
    tag = "hooks" if grok_hooks else "strip" if outside else "deny"
    try:
        if outside and a.agent == "zcode":
            d = zcode_strip_settings()
            env["ZCODE_CLI_SETTINGS_FILE"] = str(d / "cli" / "setting.json")
            return d, {"agent": "zcode", "action": "stripped", "mcp": "off", "plugins": "off",
                       "skills": "off", "hooks": "off", "permission": "user's",
                       "env": ["ZCODE_CLI_SETTINGS_FILE"]}
        if a.agent == "opencode":
            d, info, extra = opencode_deny_config(env, tag)
            env.update(extra)  # literal provider secrets, referenced as {env:...} in d
            env["OPENCODE_CONFIG_DIR"] = str(d)
            # opencode reads OPENCODE_CONFIG_PROJECT_DISABLE ?? OPENCODE_DISABLE_PROJECT_CONFIG
            env["OPENCODE_CONFIG_PROJECT_DISABLE"] = "1"
            env["OPENCODE_DISABLE_PROJECT_CONFIG"] = "1"
            env.pop("OPENCODE_CONFIG", None)  # an explicit file is loaded on top; its kept keys are in d
        elif a.agent == "crush":
            # builds inside the tools-off dir run() made (crush_deny_dir)
            if deny_dir is None:
                raise ValueError("no per-run crush dir")
            if outside:
                return deny_dir, crush_strip_config(env, deny_dir, "--strip-user-config")
            return deny_dir, crush_strip_config(env, deny_dir)
        elif a.agent == "grok":
            d, info = grok_strip_home(tag, deny=not (outside or grok_hooks), mcp=not grok_hooks)
            env["GROK_HOME"] = str(d)
        else:
            d, info = agy_deny_home(tag)
    except (OSError, ValueError) as e:
        print(f"acp-run: could not strip {a.agent}'s plugins and MCP servers; keeping them: {e}",
              file=sys.stderr)
        kept = {"agent": a.agent, "action": "kept", "why": f"error: {e}"[:300]}
        if a.agent == "grok":
            kept["home"] = str(grok_real_home())
        return deny_dir, kept
    return d, info


DENY_META = {
    # claude-agent-acp merges _meta.claudeCode.options into its SDK query options
    # (dist/acp-agent.js): tools [] removes every built-in tool, settingSources []
    # skips the user's settings (bypass default, allow rules, hooks),
    # strictMcpConfig with no mcpServers keeps MCP tools out, and
    # allowDangerouslySkipPermissions false forbids bypassPermissions.
    "claude": {
        "claudeCode": {
            "options": {
                "tools": [],
                "settingSources": [],
                "strictMcpConfig": True,
                "mcpServers": {},
                "allowDangerouslySkipPermissions": False,
            }
        },
        "disableBuiltInTools": True,
    },
}

# Delivery checks. Agents return provider failures as if they were answers
# (stop=end_turn, exit 0) or as bare ACP errors. Seen 2026-10-05: an ACP error
# "Internal error: Go usage limit exceeded" (opencode); the whole reply
# "Upgrade your plan to continue" (cursor); a 20-minute reply whose last line
# was "Error: RetriableError: [unavailable] PING timed out" (cursor).
# Keep these tables small: every entry is a chance of a false failure.
#
# FAILURE_CLASSES classifies text already known to be an error (an ACP error,
# the agent's stderr after it exited, a reply's TAIL_ERROR line, a REPLY_REFUSALS
# reply); first match wins.
FAILURE_CLASSES = [
    (
        "quota",
        [
            r"usage limit",
            r"quota",
            r"rate[ _-]?limit",
            r"resource[ _-]?exhausted",
            r"\b429\b",
            r"insufficient (credit|balance|funds)",
            r"out of credits",
        ],
    ),
    (
        "plan",
        [
            r"upgrade your plan",
            r"not (available|included) (on|in|with) your",
            r"requires? an? (paid|pro|higher|different) (plan|subscription)",
        ],
    ),
    (
        "auth",
        [
            r"auth(entication|orization)? required",
            r"please (log|sign) ?in",
            r"not (logged|signed) in",
            r"(log|sign) ?in (again|required)",
            r"invalid api[ _-]?key",
            r"unauthori[sz]ed",
            r"\b401\b",
        ],
    ),
    (
        "transient",
        [
            r"timed? ?out",
            r"unavailable",
            r"overloaded",
            r"econnreset",
            r"at capacity",
            r"socket hang up",
            r"retriable",
            r"connection (reset|closed|refused|error)",
            r"internal (server )?error",
            r"\b5\d\d\b",
        ],
    ),
]
FAILURE_TEXT = {
    "quota": "quota exhausted",
    "plan": "model not available on this plan",
    "auth": "not authenticated",
    "transient": "transient provider/transport error",
    "refused": "model refused the task",
    "provider": "provider error",
    "tripwire": "a tool ran without a permission request under --perm deny",
    "config": "a requested model, effort or context was not applied",
}
# A whole reply of at most SHORT_REPLY characters that starts like this is a
# refusal, not an answer. Anchored at the start so a report that merely
# mentions quotas is not one. The same patterns, anchored at the start of the
# reply's LAST paragraph (itself at most SHORT_REPLY characters), catch a refusal
# appended after progress text (agy, 2026-10-10: 356 s of work, then "Usage
# Limit Reached\n\nYou have reached your current quota ... will reset in 2
# hours, 47 minutes." as the end of the same message).
SHORT_REPLY = 300
REPLY_REFUSALS = [
    r"upgrade your plan",
    r"selected model is at capacity",  # codex-acp, see openclaw/acpx#850
    r"you('ve| have) (hit|reached|exceeded) (your|the) \w+ (limit|quota)",
    r"(usage|rate) limit (exceeded|reached)",
    r"quota (exceeded|exhausted)",
    r"please (log|sign) ?in\b",
    r"(you are |you're )?not (logged|signed) in",
    r"auth(entication)? required",
]
# A whole reply of at most MODEL_REFUSAL_REPLY characters that STARTS like this is
# the model declining the task (agy, gemini-pro-agent, 2026-10-10: "Sorry, I
# cannot fulfill your request. ... I must decline tasks involving ..." as the
# whole answer, 780 characters). Failure class "refused": never retried, and
# acp-dispatch will not turn it into a report. Anchored at the start and length
# capped so a real report that quotes a refusal sentence is not one. Each pattern
# needs a refusal verb after "I can't": "I can't find the bug" is an answer.
MODEL_REFUSAL_REPLY = 1500
MODEL_REFUSALS = [
    r"((i'?m|i am) )?(sorry|apologi[sz]e|apologies)\b[^.\n]{0,20}\bi (can(no|')t|am (unable|not able)|won't)\b",
    r"i (can(no|')t|can not|won't|will not) (help|assist|fulfill|comply|do that|provide)",
    r"i (am|'m) (unable|not able) to (help|assist|fulfill|comply|complete (this|your|the))",
    r"i must (decline|refuse)",
    r"i won't be able to (help|assist|fulfill|comply|complete)",
]
# The agent's stderr during the turn shows the provider answered 429 (agy's
# server logs "Status: RESOURCE_EXHAUSTED"). With that, a last paragraph that
# merely mentions a quota/auth/plan problem is the refusal too.
STDERR_REFUSAL = r"resource[ _-]?exhausted|\b429\b"
# The last non-empty line of a reply that is an error report from the provider
# or transport (cursor: "Error: RetriableError: ...", claude: "API Error: 529").
TAIL_ERROR = r"^(api |provider )?error\b\s*[:(\d]|^selected model is at capacity"

# Tool kind from a permission request's title when the agent sends no kind.
# Ported from acpx (MIT, github.com/openclaw/acpx src/permissions.ts
# TOOL_KIND_TITLE_MATCHERS); "create", "str_replace", "apply_patch" added.
TITLE_KINDS = {
    "read": "read",
    "cat": "read",
    "search": "search",
    "find": "search",
    "grep": "search",
    "write": "edit",
    "edit": "edit",
    "patch": "edit",
    "create": "edit",
    "str_replace": "edit",
    "apply_patch": "edit",
    "delete": "delete",
    "remove": "delete",
    "move": "move",
    "rename": "move",
    "run": "execute",
    "execute": "execute",
    "bash": "execute",
    "fetch": "fetch",
    "http": "fetch",
    "url": "fetch",
    "think": "think",
}


def dump(o):
    if isinstance(o, (list, tuple)):
        return [dump(x) for x in o]
    if hasattr(o, "model_dump"):
        return o.model_dump(mode="json", by_alias=True, exclude_none=True)
    if hasattr(o, "__dict__"):
        return {k: dump(v) for k, v in o.__dict__.items()}
    return o


def infer_kind(kind, title):
    """The tool kind logged with a permission record ("inferred_kind"): the
    agent's own kind, else one inferred from the title's first word (acpx's
    approach), else None."""
    if kind and kind != "other":
        return kind
    head = re.split(r"[:\s(`]", (title or "").strip().lower(), maxsplit=1)[0]
    found = TITLE_KINDS.get(head) or TITLE_KINDS.get(re.split(r"[_\-.]", head)[0])
    if found:
        return found
    return kind  # "other" stays "other"; missing stays None


def classify(text):
    """Failure class for error text (FAILURE_CLASSES), or None."""
    for cls, alternatives in FAILURE_CLASSES:
        if re.search("|".join(alternatives), text or "", re.IGNORECASE):
            return cls
    return None


def reply_failure(text, tools, stderr=""):
    """(class, message) when a reply is a provider refusal, ends in a refusal
    paragraph or a provider error line, else None. stderr is the agent's stderr
    since the prompt was sent: a 429 there backs a quota-looking last paragraph."""
    s = (text or "").strip()
    if not s:
        return None
    lines = [ln.strip() for ln in s.splitlines() if ln.strip()]
    if len(s) <= MODEL_REFUSAL_REPLY and any(
        re.match(rx, s.replace("\u2019", "'"), re.IGNORECASE) for rx in MODEL_REFUSALS
    ):
        return "refused", f"{FAILURE_TEXT['refused']}: reply was {s[:200]!r}"
    if len(s) <= SHORT_REPLY and any(
        re.match(rx, s, re.IGNORECASE) for rx in REPLY_REFUSALS
    ):
        cls = classify(s) or "provider"
        return cls, f"{FAILURE_TEXT[cls]}: reply was {s[:200]!r}"
    last = re.split(r"\n\s*\n", s)[-1].strip()
    if len(s) > len(last) and len(last) <= SHORT_REPLY:
        refusal = any(re.match(rx, last, re.IGNORECASE) for rx in REPLY_REFUSALS)
        backed = re.search(STDERR_REFUSAL, stderr or "", re.IGNORECASE) and classify(
            last
        )
        if refusal or backed:
            cls = classify(last) or "provider"
            return cls, (
                f"{FAILURE_TEXT[cls]}: reply truncated; edits may be present;"
                f" it ended with {last[:200]!r}"
            )
    if re.match(TAIL_ERROR, lines[-1], re.IGNORECASE):
        cls = classify(lines[-1]) or "provider"
        msg = f"{FAILURE_TEXT[cls]}: {lines[-1][:200]}"
        if len(lines) > 1 or tools:
            msg = "reply truncated; edits may be present; " + msg
        return cls, msg
    return None


def select_exit(stop_reason, text, tools, allowed, denied, perm, failure):
    """(exit code, error message or None) for a turn that finished (no ACP
    error, no timeout)."""
    if failure:
        return 1, failure[1]
    if stop_reason != "end_turn":
        return 1, None
    if text.strip():
        return 0, None
    if denied and not allowed:
        return EXIT_ALL_DENIED, (
            f"empty reply and all {denied} permission request(s) were denied"
        )
    if denied:
        return 1, f"empty reply; {denied} of {allowed + denied} permission(s) denied"
    if tools == 0:
        return 1, "empty reply: end_turn with no text and no tool calls"
    if perm == "deny":
        return 1, "empty reply under --perm deny: nothing changed, nothing reported"
    return 0, None


def retryable_error(e):
    """A prompt error worth retrying: an ACP internal or parse error (acpx's
    isRetryablePromptError) that is not a quota, plan or auth failure."""
    if not isinstance(e, RequestError) or e.code not in (-32603, -32700):
        return False
    return classify(error_text(e)) not in ("quota", "plan", "auth")


def error_text(e):
    s = f"{type(e).__name__}: {e}"
    data = getattr(e, "data", None)
    if data:
        s += " " + json.dumps(data, default=str)[:300]
    return s


def load_per_core():
    return os.getloadavg()[0] / (os.cpu_count() or 1)


def load_guard(max_load, wait, poll=15.0):
    """None when the 1-minute load per core is at most max_load (waiting up to
    `wait` seconds for it to get there), else the reason for refusing."""
    deadline, said = time.monotonic() + wait, False
    while True:
        cur = load_per_core()
        if cur <= max_load:
            if said:
                print(f"acp-run: load {cur:.2f}/core, starting", file=sys.stderr)
            return None
        why = (
            f"1-minute load {os.getloadavg()[0]:.1f} over {os.cpu_count()} cores"
            f" = {cur:.2f}/core > --max-load {max_load}"
        )
        left = deadline - time.monotonic()
        if left <= 0:
            return why
        if not said:
            print(f"acp-run: {why}; waiting up to {wait:.0f}s", file=sys.stderr)
            said = True
        time.sleep(min(poll, left))


class RunClient(Client):
    def __init__(self, log, perm, root, live=False, thinking=False):
        self.log, self.perm, self.root = log, perm, root
        self.text, self.tools, self.allowed, self.denied = [], 0, 0, 0
        self.usage = None
        # --interactive: stream updates to stdout (live), print thoughts too
        # (thinking); replaying is set during session/load, whose history
        # replay is logged but neither printed nor counted, except as messages.
        self.live, self.thinking = live, thinking
        self.replaying, self.replayed, self._last_msg = False, 0, None
        self.titles, self.bol = {}, True
        # the last delivery-check failure of this prompt (kept when a retry
        # dies), and an operator cancel that stops further retries
        self.last_failure, self.cancelled, self.prompt_task = None, False, None
        # the agent's stderr file and its size when the prompt went out, so a
        # turn's reply is judged with what the agent logged during it
        self.err_path, self.err_mark = None, 0
        # copilot's autopilot mode ends a task with a `task_complete` tool call
        # whose rawInput.summary is the answer, and sends no agent_message_chunk
        # at all (seen 2026-10-10, gpt-6-astra, 38 tool calls, 0 message
        # chunks): keep that summary as the fallback text.
        self.task_summary = ""
        self.color = live and sys.stdout.isatty()
        # tripwire (--perm deny): ids that went through request_permission, each
        # tool call's kind, and the first tool that ran without asking
        self.requested, self.tool_kinds, self.tripped = set(), {}, None
        self.exempt_kinds = frozenset()  # --tripwire-exempt-kinds
        self.started_unasked = {}  # tool_call_id -> (monotonic start, title)

    def rec(self, kind, data):
        row = {"t": round(time.time(), 3), "kind": kind, "data": data}
        self.log.write(json.dumps(row) + "\n")
        self.log.flush()

    def write(self, s, dim=False):
        if not s:
            return
        if dim and self.color:
            s = f"\x1b[2m{s}\x1b[0m"
        sys.stdout.write(s)
        sys.stdout.flush()
        self.bol = s.endswith("\n")

    def line(self, s, dim=False):
        """s on a line of its own."""
        self.write(("" if self.bol else "\n") + s + "\n", dim)

    def decide(self, tool_call):
        # yolo for every agent (operator 2026-10-14): only --perm deny refuses;
        # main() maps the deprecated scoped:/ask to "all" before this runs.
        return self.perm != "deny"

    def check_tripwire(self, update):
        """Under --perm deny, any non-think tool call that starts or completes
        without a permission request trips the run (EXIT_TRIPWIRE)."""
        if self.perm != "deny" or self.tripped:
            return
        tid = getattr(update, "tool_call_id", None)
        kind = getattr(update, "kind", None)
        if kind is not None:
            self.tool_kinds[tid] = kind
        kind = self.tool_kinds.get(tid)
        status = getattr(update, "status", None)
        kind_s = str(getattr(kind, "value", kind))
        if kind_s == "think" or kind_s in self.exempt_kinds:
            return
        status = str(getattr(status, "value", status))
        if tid in self.requested or status not in ("in_progress", "completed"):
            return
        title = getattr(update, "title", None) or self.titles.get(tid) or str(tid)
        self.titles.setdefault(tid, title)
        if status == "completed":
            self.trip(tid, title, status)
        else:
            self.started_unasked.setdefault(tid, (time.monotonic(), title))

    def trip(self, tid, title, status):
        self.tripped = f"tool {title!r} ran without a permission request under --perm deny"
        self.rec("tripwire", {"tool_call_id": tid, "title": title, "status": status})

    def check_started(self, grace=TRIP_GRACE_S):
        """Trip on a tool that started and has not asked within grace seconds
        (grace 0 at the end of a turn: it never asked)."""
        if self.perm != "deny" or self.tripped:
            return
        now = time.monotonic()
        for tid, (t0, title) in list(self.started_unasked.items()):
            if tid in self.requested:
                self.started_unasked.pop(tid, None)
            elif now - t0 >= grace:
                self.trip(tid, title, "in_progress")
                return

    async def request_permission(self, session_id, tool_call, options, **kw):
        tid = getattr(tool_call, "tool_call_id", None)
        self.requested.add(tid)
        self.started_unasked.pop(tid, None)
        # Pick only *_once options. An *_always option can outlive this run
        # (Hermes saves allow_always to a permanent on-disk allowlist), and
        # "cancelled" means the whole turn was cancelled, not one action denied.
        # With no fitting option, answer with a JSON-RPC error. Same rules as
        # multica-ai/multica#5351.
        kind = infer_kind(
            getattr(tool_call, "kind", None), getattr(tool_call, "title", None)
        )
        ok = self.decide(tool_call)
        allow = next((o for o in options if o.kind == "allow_once"), None)
        reject = next((o for o in options if o.kind == "reject_once"), None)
        granted = ok and allow is not None
        pick = allow if granted else reject
        self.rec(
            "permission",
            {
                "tool_call": dump(tool_call),
                "options": [dump(o) for o in options],
                "inferred_kind": kind,
                "decision": "allow" if granted else "deny",
                "option": pick.option_id if pick else None,
            },
        )
        if granted:
            self.allowed += 1
        else:
            self.denied += 1
        if pick is None:
            raise RequestError.invalid_params(
                {"reason": "acp-run answers only with allow_once/reject_once options"}
            )
        return RequestPermissionResponse(
            outcome=AllowedOutcome(outcome="selected", option_id=pick.option_id)
        )

    async def session_update(self, session_id, update, **kw):
        self.rec("update", dump(update))
        kind = getattr(update, "session_update", "")
        if self.replaying:
            if kind in ("user_message_chunk", "agent_message_chunk"):
                if kind != self._last_msg:
                    self.replayed += 1
                self._last_msg = kind
            return
        if isinstance(update, AgentMessageChunk) and isinstance(
            update.content, TextContentBlock
        ):
            # zcode-acp-server appends a per-turn stats chunk ("\u2713 completed
            # \u00b7 cache 6/7 messages ...") with messageId "turninfo_<uuid>";
            # it is UI chrome, not the answer.
            if str(dump(update).get("messageId") or "").startswith("turninfo_"):
                return
            self.text.append(update.content.text)
            if self.live:
                self.write(update.content.text)
        elif kind == "tool_call":
            self.tools += 1
            if getattr(update, "title", None):  # the tripwire names the tool, not its id
                self.titles.setdefault(getattr(update, "tool_call_id", None), update.title)
            self.check_tripwire(update)
            if getattr(update, "title", None) == "task_complete":
                raw = dump(update).get("rawInput") or {}
                summary = raw.get("summary") if isinstance(raw, dict) else None
                if isinstance(summary, str) and summary.strip():
                    self.task_summary = summary
            if self.live:
                title = getattr(update, "title", None) or "tool call"
                self.titles[getattr(update, "tool_call_id", None)] = title
                self.line(f"\u2699 {title}", dim=True)
        elif kind == "tool_call_update":
            self.check_tripwire(update)
            if self.live:
                tid = getattr(update, "tool_call_id", None)
                if getattr(update, "title", None):
                    self.titles[tid] = update.title
                if getattr(update, "status", None) == "failed":
                    self.line(f"\u2717 {self.titles.get(tid, tid)} failed", dim=True)
        elif kind == "agent_thought_chunk":
            content = getattr(update, "content", None)
            if self.live and self.thinking and isinstance(content, TextContentBlock):
                self.write(content.text, dim=True)
        elif kind == "usage_update":
            self.usage = dump(update)

    async def ext_method(self, method, params):
        raise RequestError.method_not_found(method)

    async def ext_notification(self, method, params):
        pass


def order_sets(sets):
    """The --set/default options in the order they must be applied, for every agent: the
    provider (cline: the model list depends on it), then the model, then the rest. A model
    switch resets the agent's effort/context/fast to the new model's defaults and changes
    which effort values exist (grok, codex, cursor, qwen, zcode, opencode; R1 headline 2),
    so anything model-dependent comes after it."""
    return {k: sets[k] for k in ("provider", "model", *sets) if k in sets}


def has_config(options, category):
    """True when a config option has id or category `category`."""
    return any(
        category in (dump(o).get("id"), dump(o).get("category")) for o in options or []
    )


def have_list(values, limit=40):
    """The 'have:' list of an error: the first `limit` values, then how many more there are."""
    names = [str(v.get("value")) for v in values]
    return ", ".join(names[:limit]) + (f", ... {len(names) - limit} more (acp-run <agent> --info)" if len(names) > limit else "")


def flat_values(option):
    """The select values of a dumped config option, groups flattened."""
    values = []
    for v in option.get("options", []):
        values += v.get("options", [v]) if "options" in v else [v]
    return values


def _toks(x, split="-"):
    """Lowercase tokens of x split on `split`, without a trailing "[...]" or "(...)" (claude's
    "[1m]", qwen's "(openai)" authType suffix)."""
    return re.split(split, re.sub(r"(\[[^\]]*\]|\([^)]*\))$", "", str(x or "")).lower())


def match_value(values, want):
    """(the value dict matching want, []) or (None, ambiguous candidates). An exact value or
    name wins. The claude ACP server's model list varies between launches ("fable" one
    time, "claude-fable-5-1[1m]" the next; 2026-10-10), so fall back to a unique token
    match: a value whose dash-separated tokens contain the wanted name's tokens as a
    contiguous run."""
    for v in values:
        if want in (v.get("value"), v.get("name")):
            return v, []
    for split in (r"-", r"[-:/]"):  # then also across provider prefixes: nous:anthropic/claude-x
        wt = _toks(want, split)
        cands = []
        for v in values:
            for cand in (v.get("value"), v.get("name")):
                ct = _toks(cand, split)
                if any(ct[i : i + len(wt)] == wt for i in range(len(ct) - len(wt) + 1)):
                    cands.append(v)
                    break
        if len(cands) == 1:
            return cands[0], []
        if cands:
            break
    return None, cands


def pick_config(options, want, category):
    """Find a select config option (e.g. category 'model') and the value matching want.

    An option whose id is `category` wins over one that only shares the
    category: cline lists "provider" (category model) before "model"
    (category model), so `--model X` used to be matched against providers.
    Every option of the winning group is tried before giving up (cursor lists
    several thought_level options; the first need not be the one with the value)."""
    opts = [dump(opt) for opt in options or []]
    exact = [o for o in opts if o.get("id") == category]
    cand = exact or [o for o in opts if o.get("category") == category]
    if not cand:
        raise SystemExit(
            f"acp-run: agent offers no '{category}' config option (try --info)"
        )
    misses = []
    for o in cand:
        values = flat_values(o)
        v, amb = match_value(values, want)
        if v is not None:
            return o["id"], v["value"]
        misses.append((o, values, amb))
    parts = []
    for o, values, amb in misses:
        parts.append(
            (f"{o.get('id')}: " if len(misses) > 1 else "")
            + (f"(ambiguous: {', '.join(str(c.get('value')) for c in amb)}) " if amb else "")
            + "have: "
            + have_list(values)
        )
    if len(misses) == 1 and misses[0][2]:
        head = f"acp-run: no {category} '{want}' (ambiguous: {', '.join(str(c.get('value')) for c in misses[0][2])}); have: "
        parts = [parts[0].split("have: ", 1)[1]]
    else:
        head = f"acp-run: no {category} '{want}'; "
    raise SystemExit(head + " | ".join(parts))


# ---------------------------------------------------------------- --effort / --context
# Normalized flags (2026-10-15, audits R1-R3 under ~/.local/state/bigteam/acp-context/). Each is
# translated to the agent's own knob, always AFTER the model (a model switch resets effort and
# context and changes which values exist), read back, and refused (exit 2, before any prompt) when
# the agent or model cannot take it. A requested value the agent did not take is failure class
# "config" (exit 1).


class ConfigError(Exception):
    """A requested model, effort or context was not applied (failure class config, exit 1)."""


def usage_exit(msg):
    """A request the agent or model cannot satisfy: say why on stderr and exit 2, before any prompt."""
    print(f"acp-run: {msg}", file=sys.stderr)
    raise SystemExit(2)


EFFORT_ALIASES = {
    "extra-high": "xhigh", "extra_high": "xhigh", "extrahigh": "xhigh", "x-high": "xhigh",
    "maximum": "max", "off": "none", "disabled": "none", "disable": "none", "min": "minimal",
}
EFFORT_LEVELS = ("none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra", "default")


def canon_effort(s):
    """An effort level in one spelling: 'Extra High', 'extra-high' and 'xhigh' are xhigh."""
    t = re.sub(r"\s+", "-", str(s if s is not None else "").strip().lower())
    return EFFORT_ALIASES.get(t, t)


def effort_arg(s):
    """argparse type of --effort: the canonical level."""
    c = canon_effort(s)
    if c not in EFFORT_LEVELS:
        raise argparse.ArgumentTypeError(
            f"unknown effort {s!r}; valid: {', '.join(EFFORT_LEVELS)} (extra-high is xhigh)")
    return c


def parse_size(s):
    """'500k' / '1m' / '272000' / '1M' as a token count, or None."""
    m = re.fullmatch(r"(\d+(?:\.\d+)?)\s*([km]?)", str(s if s is not None else "").strip().lower())
    if not m:
        return None
    n = round(float(m.group(1)) * {"": 1, "k": 1000, "m": 1_000_000}[m.group(2)])
    return n if n > 0 else None


def fmt_size(n):
    if not isinstance(n, int):
        return str(n)
    if n % 1_000_000 == 0:
        return f"{n // 1_000_000}m"
    if n % 1000 == 0:
        return f"{n // 1000}k"
    return str(n)


def context_arg(s):
    """argparse type of --context: tokens (200k, 256k, 272k, 400k, 500k, 1m or a plain integer)."""
    n = parse_size(s)
    if n is None:
        raise argparse.ArgumentTypeError(
            f"unknown context size {s!r}; use 200k, 256k, 272k, 400k, 500k, 1m or an integer")
    return n


def opt_dicts(options):
    return [dump(o) for o in options or []]


def current_value(options, ident):
    for o in opt_dicts(options):
        if o.get("id") == ident:
            return o.get("currentValue")
    return None


# ACP config option ids that carry a reasoning level (cursor uses a different one per model);
# `thinking` is an on/off switch, not a level, so it is never matched.
EFFORT_IDS = ("reasoning_effort", "effort", "reasoning", "thought", "thought_level")
CONTEXT_IDS = ("context", "context_window", "context_size")


def effort_options(options):
    return [o for o in opt_dicts(options)
            if o.get("id") != "thinking" and (o.get("id") in EFFORT_IDS or o.get("category") == "thought_level")]


def resolve_effort(options, level, who):
    """(config id, value) of the option that sets `level`, None for `default` the agent does not
    list; exits 2 naming the valid values when the agent or model cannot take it."""
    cands = effort_options(options)
    if not cands:
        switch = [o["id"] for o in opt_dicts(options) if o.get("id") == "thinking"]
        usage_exit(f"{who} offers no reasoning-effort option"
                   + (" (only an on/off 'thinking' switch: --set thinking=true|false)" if switch else ""))
    want = canon_effort(level)
    for o in cands:
        for v in flat_values(o):
            if want in (canon_effort(v.get("value")), canon_effort(v.get("name"))):
                return o["id"], v["value"]
    if want == "default":
        return None
    have = "; ".join(f"{o['id']}: " + ", ".join(str(v.get("value")) for v in flat_values(o)) for o in cands)
    usage_exit(f"{who} has no effort '{level}'; valid: {have}")


def resolve_context_option(options, tokens, who):
    """(config id, value) of a context option offering `tokens`; None when there is no context
    option; exits 2 naming the valid sizes when it does not offer them."""
    cands = [o for o in opt_dicts(options) if o.get("id") in CONTEXT_IDS]
    if not cands:
        return None
    for o in cands:
        for v in flat_values(o):
            if tokens in (parse_size(v.get("value")), parse_size(v.get("name"))):
                return o["id"], v["value"]
    have = "; ".join(f"{o['id']}: " + ", ".join(str(v.get("value")) for v in flat_values(o)) for o in cands)
    usage_exit(f"{who} has no context {fmt_size(tokens)}; valid: {have}")


# What cannot be requested, and why (R1-R3; "not reachable over ACP" is said, never ignored).
EFFORT_NOT_REACHABLE = {
    "hermes": "hermes' ACP server has no reasoning option (it reads agent.reasoning_effort from"
              " config.yaml only; a shadow HERMES_HOME is not implemented)",
    "crush": "crush-acp has no reasoning option (the reasoning level lives in its model config;"
             " its SIPB models have none)",
}
CONTEXT_NOT_REACHABLE = {
    "agy": "the window is fixed per model (Gemini 1m) and agy has no ACP knob for it",
    "qwen": "the window is a property of the model entry in settings.json; choose a model with the"
            " window you want (--info lists them)",
    "opencode": "the window is fixed per model by the models.dev catalog; opencode has no ACP knob",
    "crush": "the window is fixed per model in crush's catalog",
    "cline": "the window is fixed per model by the provider catalog",
    "hermes": "the window is resolved per provider and model; choose a -900k model id where one exists",
}
COPILOT_TIERS = {200000: "default", 256000: "default", 272000: "default", 1000000: "long_context"}
CLAUDE_CONTEXTS = (200000, 1000000)
CODEX_EFFECTIVE = 0.95  # codex reports 95% of model_context_window as the usable window (usage_update.size)


def codex_expected_size(ctx):
    """The usage_update.size codex reports for model_context_window=ctx."""
    return round(ctx * CODEX_EFFECTIVE)


def codex_max_window(model):
    """The model's max_context_window from codex's own catalog ($CODEX_HOME/models_cache.json,
    default ~/.codex), or None when the catalog or the model is not there (the read-back after
    the turn then catches a clamped window). The longest slug found in `model` wins."""
    path = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex") / "models_cache.json"
    try:
        models = json.loads(path.read_text()).get("models") or []
    except (OSError, ValueError, AttributeError):
        return None
    best = None
    for m in models:
        slug, mx = m.get("slug"), m.get("max_context_window")
        if isinstance(slug, str) and isinstance(mx, int) and slug in str(model) \
                and (best is None or len(slug) > len(best[0])):
            best = (slug, mx)
    return best[1] if best else None


def codex_config_with_window(current, ctx):
    """CODEX_CONFIG (a JSON object codex-acp merges into the session config) with
    model_context_window=ctx, keeping everything else `current` already sets."""
    cfg = {}
    if current and current.strip():
        try:
            cfg = json.loads(current)
        except ValueError:
            cfg = None
        if not isinstance(cfg, dict):
            usage_exit("--context: codex needs CODEX_CONFIG to be a JSON object to add model_context_window;"
                       f" it is {current[:60]!r}")
    cfg["model_context_window"] = ctx
    return json.dumps(cfg, separators=(",", ":"))
CLINE_EFFORTS = ("none", "low", "medium", "high", "xhigh")
AGY_EFFORTS = ("low", "medium", "high")
# models whose option list returned by set_config_option(model) can still be the previous
# model's (opencode, R2 finding 3): the same model is sent once more to get the real list
REFETCH_AFTER_MODEL = ("opencode",)


def check_static(a):
    """Exit 2 for an --effort/--context the agent can never take, before anything is started."""
    effort, ctx = getattr(a, "effort", None), getattr(a, "context", None)
    if effort and effort != "default":
        if a.agent in EFFORT_NOT_REACHABLE:
            usage_exit(f"--effort: {a.agent}: {EFFORT_NOT_REACHABLE[a.agent]}")
        if a.agent == "cline" and effort not in CLINE_EFFORTS:
            usage_exit(f"--effort: cline takes {', '.join(CLINE_EFFORTS)} (--thinking); not {effort}")
        if a.agent == "agy" and effort not in AGY_EFFORTS:
            usage_exit(f"--effort: agy bakes the level into the model id; valid: {', '.join(AGY_EFFORTS)}"
                       f" (xhigh and max are not reachable over ACP); not {effort}")
    if ctx:
        if a.agent in CONTEXT_NOT_REACHABLE:
            usage_exit(f"--context: {a.agent}: {CONTEXT_NOT_REACHABLE[a.agent]}")
        if a.agent == "claude" and ctx not in CLAUDE_CONTEXTS:
            usage_exit("--context: claude is 200k (CLAUDE_CODE_DISABLE_1M_CONTEXT) or the model's own 1m;"
                       f" not {fmt_size(ctx)}")
        if a.agent == "copilot" and ctx not in COPILOT_TIERS:
            usage_exit("--context: copilot has a default tier (200k, 256k or 272k) and a long one (1m);"
                       f" not {fmt_size(ctx)}")


def env_pairs(text):
    """'K=V,K2=V2' (a comma only splits before another NAME=) as a dict."""
    out = {}
    for part in re.split(r",(?=[A-Za-z_][A-Za-z0-9_]*=)", text or ""):
        k, sep, v = part.strip().partition("=")
        if sep and re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", k):
            out[k] = v
    return out


def launch_tweaks(a, cmd, env):
    """The agent's launch command with the flags --effort/--context/--agent-arg need at start
    (env changed in place). cline's --thinking, copilot's --context/--model, claude's 1M switch,
    zcode's compaction cap and the per-agent ACP_RUN_ARGS_<AGENT> / ACP_RUN_ENV_<AGENT> /
    --agent-arg / --agent-env pass-throughs (R1 6.4, R2 5.1)."""
    effort, ctx = getattr(a, "effort", None), getattr(a, "context", None)
    cmd = list(cmd)
    if a.agent == "claude" and ctx == 200000:
        env["CLAUDE_CODE_DISABLE_1M_CONTEXT"] = "1"
    if a.agent == "zcode" and ctx:
        env["ZCODE_ACP_AUTO_COMPACT_THRESHOLD"] = str(ctx)
    if a.agent == "copilot" and ctx:
        # set_config_option(model) resets the context tier to default (R2 finding 1): the tier
        # and the model are server flags
        cmd += ["--context", COPILOT_TIERS[ctx]]
        if a.model:
            cmd += ["--model", a.model]
    if a.agent == "cline" and effort and effort != "default":
        cmd += ["--thinking", effort]
    cmd += shlex.split(os.environ.get(f"ACP_RUN_ARGS_{a.agent.upper()}", "")) + list(getattr(a, "agent_arg", None) or [])
    env.update(env_pairs(os.environ.get(f"ACP_RUN_ENV_{a.agent.upper()}", "")))
    for kv in getattr(a, "agent_env", None) or []:
        env.update(env_pairs(kv))
    if a.agent == "codex" and ctx:
        # codex-acp merges CODEX_CONFIG into the session config: model_context_window sets the
        # window (usage_update.size = 95% of it), clamped by the model's max_context_window
        env["CODEX_CONFIG"] = codex_config_with_window(env.get("CODEX_CONFIG"), ctx)
    return cmd


def grok_windows(init, model_id):
    """The context windows grok's initialize response lists for model_id ([] when unknown)."""
    meta = (dump(init) or {}).get("_meta") or {}
    for m in ((meta.get("modelState") or {}).get("availableModels") or []):
        if m.get("modelId") == model_id:
            return [w for w in ((m.get("_meta") or {}).get("contextWindows") or []) if isinstance(w, int)]
    return []


def models_extra(sess):
    """The legacy session/new `models` field (hermes, crush-acp) as a dict, or None. The SDK's
    NewSessionResponse allows extra fields since module load (see _acp_schema below)."""
    extra = getattr(sess, "model_extra", None) or {}
    m = extra.get("models")
    return m if isinstance(m, dict) else None


def models_values(models):
    return [{"value": m.get("modelId"), "name": m.get("name")} for m in (models or {}).get("availableModels") or []
            if isinstance(m, dict)]


async def set_model_fallback(a, conn, sess, client, want, per_run_data):
    """--model for an agent whose session/new has no `model` config option but lists `models`
    (hermes, crush-acp): the unstable session/set_model, which the pinned SDK lacks. Returns the
    model id set, or None when the agent lists no models."""
    models = models_extra(sess)
    if not models:
        return None
    values = models_values(models)
    v, amb = match_value(values, want)
    if v is None:
        raise SystemExit(f"acp-run: no model '{want}'"
                         + (f" (ambiguous: {', '.join(str(c.get('value')) for c in amb)})" if amb else "")
                         + "; have: " + have_list(values))
    if a.agent == "crush" and not per_run_data:
        # crush-acp persists the choice into the data dir's crush.json (R2 finding 4), and the
        # default dir is shared with the interactive `crush` shell function
        usage_exit("crush: --model rewrites the data dir's crush.json; give it a private one with"
                   " ACP_RUN_CRUSH_DATA=DIR (or run under --perm deny / --strip-user-config)")
    await conn._conn.send_request("session/set_model", {"sessionId": sess.session_id, "modelId": v["value"]})
    client.rec("set_model", {"modelId": v["value"]})
    return v["value"]


async def grok_set_context(conn, sess, init, client, options, tokens, who):
    """grok: session/set_model {_meta: {contextWindow, reasoningEffort}} (the method is not in the
    pinned SDK) and the free read-back _x.ai/session/info context.total. reasoningEffort is
    repeated so the call does not reset it to the model's default. Returns context.total."""
    model_id = current_value(options, "model")
    windows = grok_windows(init, model_id)
    if windows and tokens not in windows:
        usage_exit(f"{who} has no context {fmt_size(tokens)}; valid: {', '.join(fmt_size(w) for w in windows)}")
    meta = {"contextWindow": tokens}
    eff = current_value(options, "reasoning_effort")
    if eff:
        meta["reasoningEffort"] = eff
    try:
        await conn._conn.send_request("session/set_model", {"sessionId": sess.session_id, "modelId": model_id, "_meta": meta})
    except RequestError as e:
        if "context window" in str(e):
            usage_exit(f"{who} refused context {fmt_size(tokens)}: {e}")
        raise
    client.rec("set_model", {"modelId": model_id, "_meta": meta})
    info = await conn.ext_method("x.ai/session/info", {"sessionId": sess.session_id})
    if isinstance(info, dict) and isinstance(info.get("result"), dict):
        info = info["result"]  # the SDK hands back the JSON-RPC envelope's result under "result"
    client.rec("session_info", {k: info[k] for k in ("model", "modelDisplayName", "context") if isinstance(info, dict) and k in info}
               if isinstance(info, dict) else {"raw": str(info)[:200]})
    total = ((info or {}).get("context") or {}).get("total") if isinstance(info, dict) else None
    return total if isinstance(total, int) else None


def agy_effort_model(options, want_model, level):
    """agy bakes the effort into the model id (<base>-low|medium|high): the model value for
    `level` on want_model's base, or exit 2 naming what the base is offered at."""
    _cid, val = pick_config(options, want_model, "model") if want_model else (None, None)
    val = val or current_value(options, "model")
    base = re.sub(r"-(low|medium|high)$", "", str(val))
    values = [str(v.get("value")) for o in opt_dicts(options) if o.get("id") == "model" for v in flat_values(o)]
    levels = [x[len(base) + 1:] for x in values if x.startswith(base + "-") and x[len(base) + 1:] in AGY_EFFORTS]
    target = f"{base}-{level}"
    if target not in values:
        usage_exit(f"agy {base} is offered at effort: {', '.join(levels) or '(none: fixed in the id)'}; not {level}")
    return target


async def apply_config(a, conn, sess, init, client, sets, applied, per_run_data=False):
    """Apply the options in `sets` (order_sets: provider, model, the rest), then --effort and
    --context, to the new session; fill `applied` with what the agent reports back and raise
    ConfigError when it reports something else than was requested. Returns the final options.
    The agent's own response to each set carries the complete updated option list, which is
    the read-back (grok adds _x.ai/session/info for the window)."""
    options = sess.config_options
    effort, ctx = getattr(a, "effort", None), getattr(a, "context", None)
    copilot_launch_model = a.agent == "copilot" and bool(ctx)
    want_model = sets.get("model")
    if effort and effort != "default" and a.agent == "agy":
        sets = dict(sets)
        sets["model"] = agy_effort_model(options, want_model, effort)
        want_model = sets["model"]
    got = {}  # option id -> (value we set, True when the agent's response confirmed it)
    items = list(sets.items())
    for i, (key, want) in enumerate(items):
        if key == "mode" and not has_config(options, "mode"):
            # refined-antigravity-acp offers its modes (yolo, default)
            # only as ACP session modes, not as a config option
            mode_ids = [m.get("id") for m in (dump(sess.modes) or {}).get("availableModes", [])]
            if want in mode_ids:
                await conn.set_session_mode(session_id=sess.session_id, mode_id=want)
                client.rec("set_mode", {"id": want})
                continue
        if key == "model" and not has_config(options, "model"):
            done = await set_model_fallback(a, conn, sess, client, want, per_run_data)
            if done is not None:
                applied["model"] = done
                applied.setdefault("unverified", []).append("model")
                continue
        cid, val = pick_config(options, want, key)
        if key == "model" and copilot_launch_model:
            # already the server's --model; only check below that it is the session's
            if current_value(options, "model") != val:
                raise ConfigError(f"copilot started on model {current_value(options, 'model')!r}, not {val!r}")
            continue
        resp = await conn.set_config_option(config_id=cid, session_id=sess.session_id, value=val)
        new = getattr(resp, "config_options", None)
        options = new or options
        client.rec("set_config", {"id": cid, "value": val})
        if key == "model":
            got[cid] = (val, bool(new))
        if key == "model" and a.agent in REFETCH_AFTER_MODEL and (i + 1 < len(items) or effort or ctx):
            resp = await conn.set_config_option(config_id=cid, session_id=sess.session_id, value=val)
            options = getattr(resp, "config_options", None) or options
    who = f"{a.agent} {current_value(options, 'model') or applied.get('model') or ''}".strip()
    if effort and a.agent != "agy" and a.agent != "cline":
        picked = resolve_effort(options, effort, who)
        if picked:
            cid, val = picked
            resp = await conn.set_config_option(config_id=cid, session_id=sess.session_id, value=val)
            new = getattr(resp, "config_options", None)
            options = new or options
            client.rec("set_config", {"id": cid, "value": val})
            got[cid] = (val, bool(new))
            applied["effort_id"] = cid
    if ctx:
        if a.agent == "grok":
            total = await grok_set_context(conn, sess, init, client, options, ctx, who)
            applied["ctx"], applied["ctx_source"] = total, "x.ai/session/info"
            if total is None:
                applied.setdefault("unverified", []).append("ctx")
            elif total != ctx:
                raise ConfigError(f"requested context {fmt_size(ctx)} but grok reports {fmt_size(total)}")
        else:
            picked = resolve_context_option(options, ctx, who)
            if picked:
                cid, val = picked
                resp = await conn.set_config_option(config_id=cid, session_id=sess.session_id, value=val)
                new = getattr(resp, "config_options", None)
                options = new or options
                client.rec("set_config", {"id": cid, "value": val})
                got[cid] = (val, bool(new))
                applied["ctx_id"] = cid
            elif a.agent == "codex":
                # launch-time CODEX_CONFIG model_context_window (launch_tweaks); confirmed by
                # usage_update.size == 95% of it after the turn
                model = str(current_value(options, "model") or applied.get("model") or a.model or "")
                limit = codex_max_window(model)
                if limit and ctx > limit:
                    usage_exit(f"{who}: codex's window for this model is at most {fmt_size(limit)}"
                               f" (max_context_window); not {fmt_size(ctx)}")
                applied["ctx_expected"] = ctx
                applied["ctx_requested"] = ctx
            elif a.agent in ("claude", "copilot"):
                applied["ctx_expected"] = ctx  # launch-time switch; confirmed by usage_update.size
            elif a.agent == "zcode":
                applied["ctx_cap"] = applied["ctx"] = ctx  # compaction cap (ZCODE_ACP_AUTO_COMPACT_THRESHOLD)
                applied.setdefault("unverified", []).append("ctx")
            else:
                usage_exit(f"{who} offers no context option (valid: see --info)")
    read_back(a, options, got, applied)
    return options


def values_match(want, have, fuzzy=False):
    """True when two option values name the same thing: equal or the same effort spelling; with
    fuzzy also token-wise (claude may answer 'haiku' with its full model id)."""
    if want == have or canon_effort(want) == canon_effort(have):
        return True
    return fuzzy and (match_value([{"value": have, "name": have}], str(want))[0] is not None
                      or match_value([{"value": want, "name": want}], str(have))[0] is not None)


def read_back(a, options, got, applied):
    """Fill applied from the final options and raise ConfigError for each value the agent's
    response reports differently from the one that was set."""
    model = current_value(options, "model")
    if model is not None:
        applied["model"] = model
    eid = applied.get("effort_id")
    effort_opts = effort_options(options)
    if eid:
        applied["effort"] = current_value(options, eid)
    elif effort_opts:
        applied["effort"] = effort_opts[0].get("currentValue")
    elif a.agent == "agy" and model:
        m = re.search(r"-(low|medium|high)$", str(model))
        applied["effort"] = m.group(1) if m else None
    elif a.agent == "cline" and getattr(a, "effort", None):
        applied["effort"] = a.effort
        applied.setdefault("unverified", []).append("effort")
    cid = applied.get("ctx_id") or next(
        (o["id"] for o in opt_dicts(options) if o.get("id") in CONTEXT_IDS and "ctx" not in applied), None)
    if cid:
        applied["ctx"] = parse_size(current_value(options, cid)) or current_value(options, cid)
        applied["ctx_source"] = f"option {cid}"
    for ident, (val, confirmed) in got.items():
        have = current_value(options, ident)
        if confirmed and have is not None and not values_match(val, have, fuzzy=a.agent == "claude"):
            raise ConfigError(f"set {ident}={val!r} but the agent reports {have!r}")
    ctx = getattr(a, "context", None)
    if ctx and isinstance(applied.get("ctx"), int) and not size_ok(ctx, applied["ctx"]):
        raise ConfigError(f"requested context {fmt_size(ctx)} but the agent reports {fmt_size(applied['ctx'])}")
    eff = getattr(a, "effort", None)
    if eff and eff != "default" and a.agent not in ("cline",) and applied.get("effort") is not None \
            and not values_match(eff, applied["effort"]):
        raise ConfigError(f"requested effort {eff} but the agent reports {applied['effort']!r}")


def size_ok(want, have):
    """A reported window is the requested one: codex and claude report the usable share (95%),
    copilot the prompt budget, so the lower bound is 90%."""
    return isinstance(have, int) and 0.9 * want <= have <= 1.01 * want


def post_turn(a, applied, usage):
    """After the turn: the window the agent reports in usage_update.size. Fills applied['ctx']
    when no earlier read-back gave one; returns an error text when a requested window was not
    the one in effect, else None."""
    size = (usage or {}).get("size")
    ctx = getattr(a, "context", None)
    if applied.get("ctx_cap"):
        return None  # a compaction cap (zcode): the window itself is unchanged and nothing reads the cap back
    if isinstance(size, int):
        if not isinstance(applied.get("ctx"), int) or applied.get("ctx_source") in (None, "usage_update"):
            applied["ctx"], applied["ctx_source"] = size, "usage_update"
            if "ctx" in applied.get("unverified", []):
                applied["unverified"].remove("ctx")
        if ctx and applied.get("ctx_source") == "usage_update":
            if a.agent == "codex":
                # model_context_window=ctx reads back as 95% of it (allow codex's rounding)
                want = codex_expected_size(ctx)
                if abs(size - want) > 1:
                    return (f"requested context {fmt_size(ctx)} but the agent reports {fmt_size(size)}"
                            f" (usage_update; expected {want}, 95% of the request; a model's"
                            " max_context_window clamps it)")
                applied["ctx_requested"] = ctx
                return None
            if a.agent == "copilot":
                # two tiers: the default one reports a ~272k prompt budget whatever 200k/256k/272k
                # was asked, the long one ~922k of its 1m
                ok = size <= 300000 if COPILOT_TIERS.get(ctx) == "default" else size >= 800000
            else:
                ok = size_ok(ctx, size)
            if not ok:
                return f"requested context {fmt_size(ctx)} but the agent reports {fmt_size(size)} (usage_update)"
    elif ctx and not isinstance(applied.get("ctx"), int):
        applied.setdefault("unverified", []).append("ctx")
        applied["ctx"], applied["ctx_source"] = ctx, "requested"
    return None


def applied_line(applied):
    """'model=grok-4.7 effort=low ctx=500k' with unverified values marked, '' when nothing is known."""
    unv = set(applied.get("unverified") or [])
    bits = []
    for k in ("model", "effort", "ctx"):
        v = applied.get(k)
        if v is None:
            continue
        s = fmt_size(v) if k == "ctx" else str(v)
        if k == "ctx" and applied.get("ctx_requested") not in (None, v):
            s = f"{fmt_size(applied['ctx_requested'])}/{v}"  # requested / effective (codex: 95%)
        bits.append(f"{k}={s}" + ("(unverified)" if k in unv else ""))
    return " ".join(bits)


def ensure_agy_home() -> str:
    """Shadow ~/.gemini with symlinks to everything but hooks.json (see YOLO_SET note)."""
    src, dst = Path.home() / ".gemini", Path.home() / ".local/share/agy-acp-home"
    (dst / "config").mkdir(parents=True, exist_ok=True)
    hooks = dst / "config" / "hooks.json"
    if not hooks.exists():
        hooks.write_text("{}\n")
    for base, tgt in ((src, dst), (src / "config", dst / "config")):
        for f in base.iterdir():
            link = tgt / f.name
            if (f.name == "config" and base == src) or f.name.startswith("hooks.json"):
                continue
            if not link.is_symlink() and not link.exists():
                link.symlink_to(f)
    return str(dst)



def _ignore_sigint():
    signal.signal(signal.SIGINT, signal.SIG_IGN)

async def _kill(proc):
    if proc is None or proc.returncode is not None:
        return
    proc.terminate()
    try:
        await asyncio.wait_for(proc.wait(), 5)
    except TimeoutError:
        proc.kill()
        try:
            await asyncio.wait_for(proc.wait(), 5)
        except TimeoutError:
            pass


def stderr_since(path, mark, n=20000):
    """The agent's stderr written after byte offset mark (at most the last n bytes)."""
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            end = f.tell()
            f.seek(max(mark, end - n))
            return f.read().decode(errors="replace")
    except OSError:
        return ""


def stderr_tail(path, n=2000):
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - n))
            return f.read().decode(errors="replace")
    except OSError:
        return ""


def fallback_cli(a, client=None) -> int:
    """Headless CLI when ACP handshake hangs (claude-agent-acp session/new). It runs as a known
    conversation id (--session-id, else a fresh UUID), logged as new_session, so it can be resumed."""
    if a.agent != "claude":
        return 1
    model = a.model or "sonnet"
    sid = getattr(a, "session_id", None) or str(uuid.uuid4())
    # The prompt goes on stdin, never argv (process listings show argv).
    cmd = ["claude", "-p", "--model", model, "--session-id", sid]
    env = {k: v for k, v in os.environ.items() if k not in SCRUB_ENV}
    if getattr(a, "effort", None) and a.effort != "default":
        cmd += ["--effort", a.effort]
    if getattr(a, "context", None) == 200000:
        env["CLAUDE_CODE_DISABLE_1M_CONTEXT"] = "1"
    if a.perm == "all":
        cmd.append("--dangerously-skip-permissions")
    elif a.perm == "deny":
        # Same as upstream SkillOpt's claude backend, plus no built-in tools and
        # no user MCP servers (adversary review 2026-10-12, C1a).
        cmd += ["--tools", "", "--strict-mcp-config", "--permission-mode", "default",
                "--disallowedTools", "*", "--setting-sources", "project"]  # no user hooks
    if client is not None:
        client.rec("new_session", {"sessionId": sid, "via": "claude-cli"})
    print(f"acp-run: ACP handshake failed; fallback to claude CLI (session {sid})", file=sys.stderr)
    return subprocess.run(cmd, cwd=str(Path(a.dir).resolve()), input=a.prompt_text or "",
                          text=True, check=False, env=env).returncode


def extend_deadline(client, deadline):
    """Consume a whole-second extension beside the log (2026-10-11)."""
    name = getattr(getattr(client, "log", None), "name", None)
    if not isinstance(name, str):
        return deadline
    path = Path(name + ".extend")
    if not path.exists():
        return deadline
    try:
        with path.with_name(path.name + ".lock").open("a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            return read_deadline_extension(client, deadline, path)
    except OSError as e:
        client.rec("deadline_extension_invalid", {"error": str(e)})
        return deadline


def read_deadline_extension(client, deadline, path):
    try:
        value = path.read_text().strip()
    except FileNotFoundError:
        return deadline
    except (OSError, UnicodeError) as e:
        client.rec("deadline_extension_invalid", {"error": str(e)})
    else:
        if re.fullmatch(r"[0-9]+", value):
            try:
                seconds = int(value)
                new = None if seconds == 0 or deadline is None else deadline + seconds
            except (ValueError, OverflowError) as e:
                client.rec("deadline_extension_invalid", {"error": str(e)})
            else:
                client.rec("deadline_extended", {"old_deadline": deadline, "new_deadline": new,
                                                 "seconds": seconds})
                print(f"acp-run: deadline extended: {deadline} -> {new}", file=sys.stderr)
                deadline = new
        else:
            client.rec("deadline_extension_invalid", {"value": value[:200]})
    try:
        path.unlink(missing_ok=True)
    except OSError as e:
        client.rec("deadline_extension_invalid", {"error": str(e)})
    return deadline


def tail_lines(text, max_lines=40, max_chars=3000):
    if not text:
        return ""
    if not isinstance(text, str):
        text = str(text)
    lines = text.splitlines()
    if len(lines) > max_lines:
        lines = lines[-max_lines:]
    res = "\n".join(lines)
    if len(res) > max_chars:
        res = res[-max_chars:]
    return res


def build_verify_prompt(cmd, rc, output):
    tail = tail_lines(output, max_lines=40, max_chars=3000)
    return (
        f'The check "{cmd}" failed (exit {rc}). Last output:\n'
        f"{tail}\n"
        "Fix the problem, run the check yourself, and only stop when it passes."
    )


def run_verify(cmd, cwd, timeout=180):
    try:
        r = subprocess.run(
            cmd,
            check=False,
            cwd=str(Path(cwd).resolve()),
            shell=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            timeout=timeout,
        )
        return r.returncode, tail_lines(r.stdout or "")
    except subprocess.TimeoutExpired as e:
        out = e.stdout or ""
        if isinstance(out, bytes):
            out = out.decode("utf-8", "replace")
        return 124, tail_lines(out)
    except Exception as e:  # noqa: BLE001 - a broken verify command is a failed check, never a crash
        return 1, str(e)


async def prompt_turn(a, conn, sess, client, text, out, wait=None):
    """Send one prompt, with --prompt-retries. Writes stop_reason, quota and
    usage into out; returns (finished, failure, code), code 124 on a timeout
    and else None. A non-retryable ACP error is raised."""
    if wait is None:

        async def wait(task, secs):
            return await asyncio.wait_for(asyncio.shield(task), secs)

    finished, failure, code = False, None, None
    client.last_failure = None
    deadline = time.monotonic() + a.timeout if a.timeout else None

    verify_cmd = getattr(a, "verify", None)
    verify_retries = getattr(a, "verify_retries", 2) if verify_cmd else 0
    verify_timeout = getattr(a, "verify_timeout", 180)
    verify_attempts = 0

    current_text = text
    for v_attempt in range(
        verify_retries + 1 if (verify_cmd and not getattr(a, "interactive", False)) else 1
    ):
        prompt = [TextContentBlock(type="text", text=current_text)]
        finished, failure, code = False, None, None
        for attempt in range(a.prompt_retries + 1):
            # Retry only before any side effect (acpx: no retry once the
            # turn touched anything), with acpx's 1 s * 2^n, max 10 s backoff.
            can_retry = (
                attempt < a.prompt_retries
                and client.tools == client.allowed == client.denied == 0
            )
            if attempt and client.cancelled:  # cancelled during the backoff
                out["stop_reason"], finished = "cancelled", True
                break
            client.text = []
            if client.err_path:
                try:
                    client.err_mark = os.path.getsize(client.err_path)
                except OSError:
                    client.err_mark = 0
            prompt_task = client.prompt_task = asyncio.ensure_future(
                conn.prompt(session_id=sess.session_id, prompt=prompt)
            )
            why = None
            try:
                while True:
                    deadline = extend_deadline(client, deadline)
                    left = deadline - time.monotonic() if deadline is not None else 30
                    if left <= 0:
                        raise TimeoutError
                    if getattr(client, "check_started", None):
                        client.check_started()
                    if getattr(client, "tripped", None):
                        break  # handled below, where the turn's reply is judged
                    deny = getattr(a, "perm", None) == "deny"
                    try:
                        resp = await wait(prompt_task, min(1 if deny else 30, left))
                        break
                    except TimeoutError:
                        if not prompt_task.done():
                            continue  # a polling tick
                        if prompt_task.cancelled():
                            raise
                        # The poll timed out on the same tick the prompt finished
                        # (2026-10-13: end_turn at 39 s and 152 s, both exit 124):
                        # take its answer. Its own error is raised as is; a timeout
                        # raised by the adapter itself is still a timeout.
                        if prompt_task.exception() is not None:
                            raise prompt_task.exception() from None
                        resp = prompt_task.result()
                        break
            except TimeoutError:
                if a.interactive:
                    repl = getattr(wait, "__self__", None)
                    if repl is not None:
                        repl.cancelled = client.cancelled = True
                await conn.cancel(session_id=sess.session_id)
                try:
                    resp = await asyncio.wait_for(prompt_task, 15)
                    out["stop_reason"] = resp.stop_reason
                except (TimeoutError, RequestError, ConnectionError):
                    out["stop_reason"] = "timeout"
                code = 124
                if deadline is not None and getattr(a, "wrapup_grace", 0) > 0 and not a.interactive:
                    await wrapup_turn(a, conn, sess, client, out)
                break
            except (RequestError, ConnectionError) as e:
                if not (can_retry and retryable_error(e)):
                    raise
                why = error_text(e)
            else:
                if getattr(client, "check_started", None):
                    client.check_started(grace=0)  # the turn is over: it never asked
                trip = getattr(client, "tripped", None)
                if trip:  # a tool ran without asking under --perm deny: stop the turn
                    if not prompt_task.done():
                        await conn.cancel(session_id=sess.session_id)
                        try:
                            await asyncio.wait_for(prompt_task, 15)
                        except (TimeoutError, RequestError, ConnectionError):
                            pass
                    out["stop_reason"] = "tripwire"
                    out["error"] = trip
                    failure = client.last_failure = ("tripwire", trip)
                    code = EXIT_TRIPWIRE
                    break
                out["stop_reason"] = resp.stop_reason
                client.rec("prompt_response", dump(resp))
                quota = (resp.field_meta or {}).get("quota")
                if quota:  # e.g. codex-acp/Gemini _meta.quota: keep for --json
                    out["quota"] = quota
                if resp.usage:
                    out["usage"] = dump(resp.usage)
                failure = client.last_failure = reply_failure(
                    "".join(client.text),
                    client.tools,
                    stderr_since(client.err_path, client.err_mark)
                    if client.err_path
                    else "",
                )
                if not (can_retry and failure and failure[0] == "transient"):
                    finished = True
                    break
                why = failure[1]
            delay = min(2.0**attempt, 10.0)
            client.rec("retry", {"attempt": attempt + 1, "delay": delay, "why": why})
            print(
                f"acp-run: retry {attempt + 1}/{a.prompt_retries} in {delay:g}s: {why}",
                file=sys.stderr,
            )
            await asyncio.sleep(delay)

        if not (verify_cmd and not getattr(a, "interactive", False)):
            break

        delivery_ok = False
        if finished and not failure and code is None and out.get("stop_reason") == "end_turn":
            check_code, _ = select_exit(
                out.get("stop_reason"),
                "".join(client.text),
                client.tools,
                client.allowed,
                client.denied,
                getattr(a, "perm", "all"),
                failure,
            )
            delivery_ok = (check_code == 0)

        if not delivery_ok:
            out["verify"] = "fail"
            out["verify_attempts"] = verify_attempts
            break

        verify_attempts += 1
        rc, tail = run_verify(verify_cmd, getattr(a, "dir", "."), verify_timeout)
        client.rec("verify", {"attempt": verify_attempts, "rc": rc, "tail": tail})
        if rc == 0:
            out["verify"] = "pass"
            out["verify_attempts"] = verify_attempts
            break

        out["verify"] = "fail"
        out["verify_attempts"] = verify_attempts
        if v_attempt >= verify_retries:
            break

        if deadline is not None and time.monotonic() >= deadline:
            break

        current_text = build_verify_prompt(verify_cmd, rc, tail)

    return finished, failure, code


WRAPUP_DEFAULT = (
    "TIME IS UP: acp-run stopped your turn at its --timeout and cancelled any running"
    " command. This is one last short turn of {grace} seconds. Do not run tests, builds,"
    " commits or anything else slow. Write your final report now with what you have:"
    " what is done, what was verified, what is unfinished, and the exact next step."
)


async def wrapup_turn(a, conn, sess, client, out):
    """After a --timeout cancel, give the agent one last prompt of --wrapup-grace
    seconds to write its report (2026-10-10: an opencode slice had its work
    verified, then sat in a git commit whose pre-commit Gradle hook queued on
    the machine-wide Gradle slot; the cancel at 2400 s left its report at
    `STATUS: working`). Skipped when the agent did not answer the cancel
    within 15 s (stop_reason "timeout"), since a prompt sent then would queue
    behind the turn still running. Records out["wrapup"]; the run still exits
    124."""
    if out.get("stop_reason") == "timeout":
        out["wrapup"] = "skipped: the cancelled turn did not end"
        client.rec("wrapup", {"status": out["wrapup"]})
        return
    text = (a.wrapup or WRAPUP_DEFAULT).replace("{grace}", f"{a.wrapup_grace:g}")
    client.rec("wrapup", {"grace": a.wrapup_grace, "text": text})
    client.text = []
    task = client.prompt_task = asyncio.ensure_future(
        conn.prompt(
            session_id=sess.session_id, prompt=[TextContentBlock(type="text", text=text)]
        )
    )
    try:
        resp = await asyncio.wait_for(asyncio.shield(task), a.wrapup_grace)
        out["wrapup"] = resp.stop_reason
    except TimeoutError:
        if task.done() and not task.cancelled() and task.exception() is None:
            # finished on the timeout's own tick, as in prompt_turn
            out["wrapup"] = task.result().stop_reason
            client.rec("wrapup", {"status": out["wrapup"]})
            return
        await conn.cancel(session_id=sess.session_id)
        try:
            await asyncio.wait_for(task, 15)
        except (TimeoutError, RequestError, ConnectionError):
            pass
        out["wrapup"] = "timeout"
    except (RequestError, ConnectionError) as e:
        out["wrapup"] = "error: " + error_text(e)[:200]
    client.rec("wrapup", {"status": out["wrapup"]})


def verdict(a, out, finished, failure, code, client):
    """(exit code, FAILED label or None) for one turn; sets out's error,
    warning and failure."""
    if finished:
        code, msg = select_exit(
            out.get("stop_reason"),
            "".join(client.text),
            client.tools,
            client.allowed,
            client.denied,
            a.perm,
            failure,
        )
        if msg:
            out["error"] = msg
        if code == 0 and client.denied and not client.allowed:
            out["warning"] = f"all {client.denied} permission request(s) were denied"
    if failure:
        out["failure"] = failure[0]
    label = None
    if failure or (finished and code != 0 and "error" in out):
        label = out.get("failure") or (
            "permissions" if client.denied else "empty-reply"
        )
    return code, label


def can_resume(init):
    caps = init.agent_capabilities
    if caps is None:
        return False
    scaps = caps.session_capabilities
    return bool(caps.load_session) or getattr(scaps, "resume", None) is not None


def global_rules_prompt(agent):
    """Text of the agent's user-level global rules files (GLOBAL_RULES), or None."""
    parts = []
    for f in GLOBAL_RULES.get(agent, []):
        try:
            t = Path(f).expanduser().read_text().strip()
        except OSError:
            continue
        if t:
            parts.append(t)
    return "\n\n".join(parts) or None


def can_additional_directories(init):
    if init is None:
        return False
    caps = (
        getattr(init, "agent_capabilities", None)
        if not isinstance(init, dict)
        else (init.get("agent_capabilities") or init.get("agentCapabilities"))
    )
    if caps is None:
        return False
    if isinstance(caps, dict):
        if caps.get("additional_directories") or caps.get("additionalDirectories"):
            return True
        scaps = caps.get("session_capabilities") or caps.get("sessionCapabilities") or {}
        if isinstance(scaps, dict):
            return bool(scaps.get("additional_directories") or scaps.get("additionalDirectories"))
        return (
            getattr(scaps, "additional_directories", None) is not None
            or getattr(scaps, "additionalDirectories", None) is not None
        )
    if (
        getattr(caps, "additional_directories", None) is not None
        or getattr(caps, "additionalDirectories", None) is not None
    ):
        return True
    scaps = getattr(caps, "session_capabilities", None)
    if scaps is not None:
        if (
            getattr(scaps, "additional_directories", None) is not None
            or getattr(scaps, "additionalDirectories", None) is not None
        ):
            return True
        if isinstance(scaps, dict):
            return bool(scaps.get("additional_directories") or scaps.get("additionalDirectories"))
    return False


async def open_session(a, conn, init, client, root, timeout):
    """session/new, or with --resume session/load (history replayed to the log
    only) or session/resume, whichever the agent advertises."""
    add_dirs = [str(Path(d).expanduser().resolve()) for d in getattr(a, "add_dir", [])]
    if not a.resume:
        kw = {}
        rules = global_rules_prompt(a.agent)
        if rules:
            kw["systemPrompt"] = rules  # sent as session/new _meta
        if getattr(a, "perm", None) == "deny":
            kw.update(DENY_META.get(a.agent, {}))  # sent as session/new _meta
        if getattr(a, "meta", None):
            kw = deep_merge(kw, a.meta)  # --meta JSON, merged over the above
        if add_dirs:
            kw["additional_directories"] = add_dirs
        if add_dirs and not can_additional_directories(init):
            try:
                sess = await asyncio.wait_for(
                    conn.new_session(mcp_servers=[], cwd=str(root), **kw), timeout
                )
            except RequestError as e:
                print(
                    f"acp-run: agent rejected additionalDirectories ({e}); retrying session/new without it",
                    file=sys.stderr,
                )
                client.rec(
                    "additional_directories_rejected",
                    {"error": error_text(e), "dirs": add_dirs},
                )
                kw.pop("additional_directories", None)
                sess = await asyncio.wait_for(
                    conn.new_session(mcp_servers=[], cwd=str(root), **kw), timeout
                )
        else:
            sess = await asyncio.wait_for(
                conn.new_session(mcp_servers=[], cwd=str(root), **kw), timeout
            )
        client.rec("new_session", dump(sess))
        return sess
    caps = init.agent_capabilities
    scaps = caps.session_capabilities if caps else None
    client.replaying = True
    try:
        if caps and caps.load_session:
            how = "load_session"
            resp = await asyncio.wait_for(
                conn.load_session(cwd=str(root), session_id=a.resume, mcp_servers=[]),
                max(timeout, 120),  # a long history takes a while to replay
            )
        elif getattr(scaps, "resume", None) is not None:
            how = "resume_session"
            resp = await asyncio.wait_for(
                conn.resume_session(cwd=str(root), session_id=a.resume, mcp_servers=[]),
                timeout,
            )
        else:
            print(
                f"acp-run: {a.agent} cannot resume a session: its initialize"
                " response advertises neither loadSession nor"
                " sessionCapabilities.resume (see --info)",
                file=sys.stderr,
            )
            raise SystemExit(2)
        # Let replayed updates still being handled finish before counting.
        tracker = getattr(conn, "_session_updates", None)
        if tracker is not None:
            await tracker.wait(a.resume)
    finally:
        client.replaying = False
    client.rec(how, dump(resp))
    print(
        f"resumed session {a.resume} ({client.replayed} messages)",
        file=sys.stdout if a.interactive else sys.stderr,
        flush=True,
    )
    return SimpleNamespace(
        session_id=a.resume, modes=resp.modes, config_options=resp.config_options
    )


def resume_argv(a, root, session_id):
    """The command herdr runs to reopen this session after a restart: a plain
    command name on PATH first, no apostrophes or control characters."""
    if not shutil.which("acp-run"):
        return None
    argv = ["acp-run", a.agent, "-C", str(root), "--interactive"]
    argv += ["--resume", session_id]
    if a.model:
        argv += ["--model", a.model]
    if a.mode:
        argv += ["--mode", a.mode]
    for kv in a.set:
        argv += ["--set", kv]
    if getattr(a, "effort", None):
        argv += ["--effort", a.effort]
    if getattr(a, "context", None):
        argv += ["--context", fmt_size(a.context)]
    for d in getattr(a, "add_dir", []):
        argv += ["--add-dir", d]
    if a.perm != "all":
        argv += ["--perm", a.perm]
    if a.inbox:
        argv += ["--inbox", str(Path(a.inbox).resolve())]
    if a.show_thinking:
        argv.append("--show-thinking")
    if any("'" in x or any(ord(c) < 32 or ord(c) == 127 for c in x) for x in argv):
        return None
    if len(argv) > 64 or len("\0".join(argv)) > 8192:
        return None
    return argv


class Herdr:
    """Pane agent reports (https://herdr.dev/docs/add-herdr-support/), only
    inside a herdr pane. Never blocks the session: reports run in the
    background one at a time, 5 s timeout, failures ignored; --seq is a
    millisecond clock so it also rises across restarts. herdr before 0.9.2
    rejects the resume command after "--" (exit 2): then it is dropped."""

    def __init__(self, agent):
        self.pane = os.environ.get("HERDR_PANE_ID")
        self.bin = os.environ.get("HERDR_BIN_PATH") or shutil.which("herdr")
        self.on = bool(self.pane and self.bin and os.access(self.bin, os.X_OK))
        self.agent, self.seq, self.tasks = agent, 0, set()
        self.session_id = self.resume = None
        self.lock = asyncio.Lock()

    def _seq(self):
        self.seq = max(self.seq + 1, time.time_ns() // 1_000_000)
        return str(self.seq)

    def _base(self, verb):
        return [self.bin, "pane", verb, self.pane, "--source", "acp-run"]

    def state(self, state, message=None):
        if not self.on:
            return
        args = self._base("report-agent")
        args += ["--agent", self.agent, "--state", state, "--seq", self._seq()]
        if message:
            args += ["--message", re.sub(r"[\x00-\x1f\x7f]", " ", message)[:200]]
        if self.session_id:
            args += ["--agent-session-id", self.session_id]
        t = asyncio.ensure_future(self._report(args))
        self.tasks.add(t)
        t.add_done_callback(self.tasks.discard)

    async def _report(self, args):
        async with self.lock:
            if self.resume and await self._call([*args, "--", *self.resume]) != 2:
                return
            self.resume = None
            await self._call(args)

    async def release(self):
        if not self.on:
            return
        if self.tasks:  # exit promptly: at most ~1 s for pending reports
            await asyncio.wait(set(self.tasks), timeout=1)
        args = self._base("release-agent") + ["--agent", self.agent]
        await self._call(args + ["--seq", self._seq()], 2)

    @staticmethod
    async def _call(args, timeout=5):
        """herdr's exit status, or None when it failed to run or timed out."""
        p = None
        try:
            p = await asyncio.create_subprocess_exec(
                *args,
                stdin=asyncio.subprocess.DEVNULL,
                stdout=asyncio.subprocess.DEVNULL,
                stderr=asyncio.subprocess.DEVNULL,
            )
            return await asyncio.wait_for(p.wait(), timeout)
        except (TimeoutError, OSError):
            if p is not None and p.returncode is None:
                p.kill()
            return None


class Inputs:
    """--interactive prompt sources, as ("line", text, source) and ("eof", "",
    source) events: stdin lines, read by a daemon thread so a blocked read
    never holds up the loop or the exit, and files dropped into --inbox."""

    def __init__(self, inbox):
        self.loop = asyncio.get_running_loop()
        self.q = asyncio.Queue()
        self.inbox = Path(inbox) if inbox else None
        self.tty = sys.stdin.isatty()
        self._get = self._poll = None

    def start(self):
        threading.Thread(target=self._read_stdin, daemon=True).start()
        if self.inbox:
            self.inbox.mkdir(parents=True, exist_ok=True)
            self._poll = asyncio.ensure_future(self._poll_inbox())

    def put(self, ev):
        self.q.put_nowait(ev)

    def getter(self):
        """The pending get; it survives a turn ending first, so no event is lost."""
        if self._get is None:
            self._get = asyncio.ensure_future(self.q.get())
        return self._get

    def take(self):
        ev, self._get = self._get.result(), None
        return ev

    async def next(self):
        await asyncio.wait({self.getter()})
        return self.take()

    def close(self):
        for t in (self._get, self._poll):
            if t is not None:
                t.cancel()

    def _read_stdin(self):
        # os.read, not sys.stdin: a daemon thread blocked inside a buffered
        # reader holds its lock, and interpreter shutdown then aborts.
        src = "tty" if self.tty else "stdin"
        buf = b""
        while True:
            try:
                chunk = os.read(0, 65536)
            except OSError:
                chunk = b""
            lines = (buf + chunk).split(b"\n")
            buf = lines.pop() if chunk else b""
            evs = [("line", ln) for ln in lines if chunk or ln]
            if not chunk:
                evs.append(("eof", b""))
            for ev, raw in evs:
                text = raw.decode("utf-8", "replace").rstrip("\r")
                text = text.replace("\x1b[200~", "").replace("\x1b[201~", "")
                try:
                    self.loop.call_soon_threadsafe(self.q.put_nowait, (ev, text, src))
                except RuntimeError:  # the loop is closed: we are exiting
                    return
            if not chunk:
                return

    async def _poll_inbox(self):
        while True:
            try:
                files = sorted(
                    f
                    for f in self.inbox.iterdir()
                    if f.suffix in (".txt", ".md")
                    and not f.name.startswith(".")
                    and f.is_file()
                )
            except OSError:
                files = []
            for f in files:
                try:
                    if time.time() - f.stat().st_mtime < 0.5:
                        break  # still being written; keep name order
                    text = f.read_text(errors="replace")
                    f.unlink()
                except OSError:
                    continue
                self.put(("line", text, f"inbox:{f.name}"))
            await asyncio.sleep(1)


class Repl:
    """--interactive: the prompt loop around one ACP session."""

    def __init__(self, a, conn, sess, client, herdr, proc, err):
        self.a, self.conn, self.sess, self.client = a, conn, sess, client
        self.herdr, self.proc, self.err = herdr, proc, err
        self.inputs = Inputs(a.inbox)
        self.running = self.cancelled = self.exiting = False
        self.queued, self.n, self.tasks = [], 0, set()
        self.last_out, self.last_code, self.last_text = {}, 0, ""
        self.tot = {"tools": 0, "allowed": 0, "denied": 0}

    def say(self, s):
        self.client.line(s, dim=True)

    async def loop(self):
        """Run the first prompt (if any), then prompts until /exit or EOF;
        the exit code of the last turn (0 when none ran)."""
        c, fatal, shown = self.client, False, False
        self.inputs.start()
        try:
            first = (self.a.prompt_text or "").strip()
            if first:
                fatal = await self.turn(first)
            while not (self.exiting or fatal):
                if not shown:
                    c.line(
                        f"\n[{self.a.agent} idle — type a prompt,"
                        " /exit to quit, /cancel during a turn]"
                    )
                    self.herdr.state("idle")
                    shown = True
                c.write("> ")
                if self.queued:
                    ev, text, src = self.queued.pop(0)
                    c.write((text.rstrip() if ev == "line" else "") + "\n")
                else:
                    ev, text, src = await self.inputs.next()
                    if src == "tty":
                        c.bol = True  # the terminal echoed the line
                    else:
                        c.write((text.rstrip() if ev == "line" else "") + "\n")
                if ev == "eof":
                    break
                t = text.strip()
                if not t:
                    continue
                if t == "/exit":
                    break
                if t == "/cancel":
                    self.say("(no turn is running)")
                    continue
                shown = False
                fatal = await self.turn(t)
        finally:
            self.inputs.close()
        return self.last_code

    async def turn(self, text):
        """One prompt; True when the agent is gone and the session cannot go on."""
        c, a = self.client, self.a
        self.n += 1
        c.text, c.tools, c.allowed, c.denied = [], 0, 0, 0
        out, t0, finished, failure, code, fatal = {}, time.time(), False, None, 1, False
        self.running = True
        self.cancelled = c.cancelled = False
        self.herdr.state("working")
        try:
            finished, failure, tcode = await prompt_turn(
                a, self.conn, self.sess, c, text, out, self.wait
            )
            if tcode:
                code = tcode
        except RequestError as e:
            failure = c.last_failure  # an earlier attempt's, if a retry died
            out["error"] = error_text(e)[:500]
            cls = classify(out["error"])
            if cls:
                failure = (cls, f"{FAILURE_TEXT[cls]}: {out['error']}")
        except ConnectionError as e:  # the agent died: its stderr may say why
            failure = c.last_failure
            await _kill(self.proc)
            out["error"] = error_text(e)[:500]
            out["error"] += f" (agent exited, code {self.proc.returncode})"
            cls = classify(stderr_tail(self.err.name))
            if cls:
                failure = (cls, f"{FAILURE_TEXT[cls]}: {out['error']}")
            fatal = True
        finally:
            self.running = False
        code, label = verdict(a, out, finished, failure, code, c)
        secs = round(time.time() - t0, 1)
        stop = out.get("stop_reason", "error")
        row = {"n": self.n, "stop_reason": stop, "seconds": secs, "exit": code}
        row.update({k: out[k] for k in ("failure", "error", "warning") if k in out})
        c.rec("turn", row)
        for k in self.tot:
            self.tot[k] += getattr(c, k)
        c.line(f"[{stop} · {secs}s · tools {c.tools}]", dim=True)
        if label:
            print(f"acp-run: FAILED {label}: {out.get('error')}", file=sys.stderr)
        if fatal:
            c.line("[the agent exited; the session is over]")
        self.last_out, self.last_code, self.last_text = out, code, "".join(c.text)
        return fatal

    async def wait(self, task, secs):
        """Wait for the prompt response while handling input: /cancel,
        /exit, and prompts queued for later."""
        deadline = time.monotonic() + secs
        while True:
            left = deadline - time.monotonic()
            if left <= 0:
                # prompt_turn polls deadline controls; this need not end the turn.
                raise TimeoutError
            get = self.inputs.getter()
            done, _ = await asyncio.wait(
                {task, get}, timeout=left, return_when=asyncio.FIRST_COMPLETED
            )
            if task in done:
                return task.result()
            if get in done:
                self.during_turn(*self.inputs.take())

    def during_turn(self, ev, text, src):
        t = text.strip()
        # /exit typed at the terminal with nothing queued ahead of it ends the
        # session now; from a pipe or the inbox, and EOF, it waits its turn.
        if t == "/exit" and src == "tty" and not self.queued:
            self.exiting = True
            self.cancel_turn("/exit")
        elif t == "/cancel":
            self.cancel_turn("/cancel")
        elif ev == "eof" or t:
            self.queued.append((ev, text, src))
            if t:
                self.say(f"[queued: {t[:60]}]")

    def interrupt(self):
        """Ctrl-C: cancel the running turn, or exit when idle."""
        if self.running:
            self.cancel_turn("^C")
        else:
            self.queued.clear()
            self.inputs.put(("eof", "", "sigint"))

    def cancel_turn(self, why):
        if not self.running or self.cancelled:
            return
        self.cancelled = self.client.cancelled = True
        self.say(f"[{why}: cancelling the turn]")
        t = asyncio.ensure_future(self._cancel())
        self.tasks.add(t)
        t.add_done_callback(self.tasks.discard)

    async def _cancel(self):
        try:
            await asyncio.wait_for(self.conn.cancel(session_id=self.sess.session_id), 5)
        except (TimeoutError, RequestError, ConnectionError):
            pass


async def all_models_options(conn, sess, options):
    """--info --all-models: for each value of the `model` option, switch to it (no prompt) and
    record the other options that model offers, as {model: {option id: {current, values}}}
    (the matrix behind R1 section 3.2). A model that refuses the switch is recorded as an error."""
    model = next((o for o in opt_dicts(options) if o.get("id") == "model"), None)
    if model is None:
        return {"error": "the agent offers no 'model' config option"}
    out = {}
    for v in flat_values(model):
        try:
            resp = await conn.set_config_option(config_id="model", session_id=sess.session_id, value=v["value"])
        except Exception as e:  # noqa: BLE001 - one bad model must not hide the others
            out[v["value"]] = {"error": error_text(e)[:200]}
            continue
        out[v["value"]] = {
            o["id"]: {"current": o.get("currentValue"), "values": [x.get("value") for x in flat_values(o)]}
            for o in opt_dicts(getattr(resp, "config_options", None) or []) if o.get("id") != "model"
        }
    return out


async def run(a, log, err, log_path):
    cmd, auth = AGENTS[a.agent]
    auth = a.auth or auth
    if a.perm == "all" and not a.mode and a.agent in YOLO_CMD:
        cmd = YOLO_CMD[a.agent]
    if a.agent == "grok" and a.perm == "deny":
        # --always-approve makes grok run every tool without a session/request_permission,
        # so a deny run could neither refuse nor be told apart from a runaway (2026-10-15)
        cmd = [x for x in cmd if x != "--always-approve"]
    root = Path(a.dir).resolve()
    env = dict(os.environ)
    deny_dir = None
    t0, out, code = time.time(), {"agent": a.agent, "log": str(log_path)}, 1
    handshake_timeout = a.handshake_timeout or HANDSHAKE_TIMEOUT.get(
        a.agent, HANDSHAKE_TIMEOUT_DEFAULT
    )
    tries = max(1, a.handshake_tries)
    hung = []  # the handshake phase each timed-out try hung in
    proc = client = conn = init = sess = repl = herdr = None
    applied = {}  # what the agent reports back for model / effort / context (apply_config)
    # SIGINT/SIGTERM: cancel the turn cooperatively (session/cancel), stop the
    # agent and exit 128+signal, as acpx does for SIGINT. Without this, SIGTERM
    # left the agent process running. --interactive: SIGINT (Ctrl-C) cancels
    # only the running turn, or exits when idle (Repl.interrupt); the agent runs
    # in its own process group so the terminal's SIGINT does not reach it.
    got = {}
    main_task = asyncio.current_task()

    def on_signal(signum):
        if signum == signal.SIGINT and repl is not None:
            repl.interrupt()
            return
        got.setdefault("sig", signum)
        main_task.cancel()

    loop = asyncio.get_running_loop()
    # --interactive: a closed pane or terminal (SIGHUP) stops the agent and
    # releases the pane like SIGTERM; the agent's own process group misses it.
    sigs = (signal.SIGINT, signal.SIGTERM)
    sigs += (signal.SIGHUP,) if a.interactive else ()
    for s in sigs:
        loop.add_signal_handler(s, on_signal, s)
    failure, finished = None, False

    def drop_deny_dir():
        nonlocal deny_dir
        if deny_dir is not None:
            if a.agent == "grok":
                grok_sync_auth(deny_dir)
            remove_deny_dir(deny_dir)
            deny_dir = None

    try:
        # The temp config dirs are built inside the try, after the signal handlers,
        # so an exception or SIGTERM from here on always reaches drop_deny_dir()
        # (adversary review 2026-10-13, finding 1).
        if a.perm == "deny":
            env.update(DENY_ENV.get(a.agent, {}))
            if a.agent == "zcode":
                deny_dir = zcode_deny_settings()
                env["ZCODE_CLI_SETTINGS_FILE"] = str(deny_dir / "cli" / "setting.json")
            elif a.agent == "crush":
                # every built-in tool off; no fallback: a crush deny run without it
                # would run its read-only tools unasked, so it fails instead
                deny_dir, cmd, crush_info = crush_deny_dir(cmd, root, env)
                log.write(json.dumps({"t": round(time.time(), 3), "kind": "deny_config",
                                      "data": crush_info}) + "\n")
                log.flush()
        elif a.agent == "crush" and strips_outside_deny(a) and not keep_user_config(a):
            # --strip-user-config outside deny: the same per-run data dir and --data-dir,
            # every tool on; if it cannot be built, crush runs on the user's config
            try:
                deny_dir, cmd, crush_info = crush_deny_dir(cmd, root, env, tools_off=False)
                log.write(json.dumps({"t": round(time.time(), 3), "kind": "strip_config",
                                      "data": crush_info}) + "\n")
                log.flush()
            except OSError as e:
                with contextlib.suppress(OSError):
                    print(f"acp-run: could not build crush's per-run config dir; keeping the "
                          f"user's: {e}", file=sys.stderr)
        deny_dir, stripped = strip_user_config(a, env, deny_dir)
        if stripped is not None:
            log.write(json.dumps({"t": round(time.time(), 3), "kind": "user_config",
                                  "data": stripped}) + "\n")
            log.flush()
            out["user_config"] = stripped["action"]
        if a.agent == "zcode" and not env.get("ZCODE_BIN") and zcode_bin():
            env["ZCODE_BIN"] = zcode_bin()
        if a.agent == "agy":
            env["GEMINI_HOME"] = str(deny_dir) if deny_dir else ensure_agy_home()
            # Claude Code's settings point HTTPS_PROXY at the opencodex intercept
            # proxy, which answers agy with 407 (2026-10-09).
            for k in ("HTTPS_PROXY", "https_proxy", "HTTP_PROXY", "http_proxy"):
                env.pop(k, None)
            # agy lists its skills dirs as workspaces too and runs commands in
            # whichever sorts first ("Command Working Directory"), often
            # ~/.local/share/agy-acp-home/antigravity-cli/skills, not the session
            # cwd: verified 2026-10-09 (`pwd` printed the skills dir; agy
            # recreates that dir if the shadow omits it). Naming the dir in the
            # prompt fixed it; the refined-antigravity-acp wrapper does not.
            if a.prompt_text:
                a.prompt_text = (
                    f"Your working directory for this task is {root}: run every"
                    " shell command there and create files there unless told"
                    " otherwise.\n\n" + a.prompt_text
                )
        # Every run, not only --interactive (2026-10-15: a grok probe fired the user's
        # autorename hook, which renamed the CALLER's herdr tab through the inherited
        # HERDR_PANE_ID). Under --interactive acp-run also reports the pane to herdr
        # itself and the agent's own herdr hooks (Claude Code's report as herdr:claude)
        # would compete for it; acp-run's own Herdr class reads its own os.environ.
        for k in SCRUB_ENV:
            env.pop(k, None)
        cmd = launch_tweaks(a, cmd, env)
        for attempt in range(1, tries + 1):
            proc = await asyncio.create_subprocess_exec(
                *cmd,
                cwd=root,
                env=env,
                stdin=asyncio.subprocess.PIPE,
                stdout=asyncio.subprocess.PIPE,
                stderr=err,
                limit=64 * 1024 * 1024,
                # --interactive: keep the agent in the terminal's foreground process
                # group (a background group that touches the TTY is stopped by
                # SIGTTIN/SIGTTOU: both reused-pane sessions wedged in state T on
                # 2026-10-08) and make it ignore SIGINT instead, so Ctrl-C reaches
                # only acp-run (SIG_IGN survives exec into node and claude).
                **({"preexec_fn": _ignore_sigint} if a.interactive else {}),
            )
            client = RunClient(
                log, a.perm, root, live=a.interactive, thinking=a.show_thinking
            )
            client.exempt_kinds = frozenset(
                k for k in getattr(a, "tripwire_exempt_kinds", "").split(",") if k
            )
            client.err_path = err.name
            conn = connect_to_agent(client, proc.stdin, proc.stdout)
            phase = "initialize"  # the handshake step a failure is reported against
            try:
                init = await asyncio.wait_for(
                    conn.initialize(
                        protocol_version=PROTOCOL_VERSION,
                        client_capabilities=ClientCapabilities(
                            field_meta={"parameterizedModelPicker": True}
                        )
                        if a.agent in PARAM_MODEL_PICKER
                        else ClientCapabilities(),
                        client_info=Implementation(
                            name=CLIENT_NAME.get(a.agent, "acp-run"),
                            title="acp-run",
                            version="1",
                        ),
                    ),
                    handshake_timeout,
                )
                client.rec("initialize", dump(init))
                if auth:
                    phase = "authenticate"
                    await asyncio.wait_for(conn.authenticate(method_id=auth), 300)
                phase = "session/new"
                if a.resume:
                    caps = init.agent_capabilities
                    phase = "session/load" if caps and caps.load_session else "session/resume"
                sess = await open_session(
                    a, conn, init, client, root, handshake_timeout
                )
                break
            except TimeoutError:
                hung.append(phase)
                client.rec(
                    "handshake_timeout",
                    {
                        "attempt": attempt,
                        "tries": tries,
                        "secs": handshake_timeout,
                        "phase": phase,
                    },
                )
                print(
                    f"acp-run: handshake timeout ({handshake_timeout:g}s, {phase}"
                    f" hung) attempt {attempt}/{tries}",
                    file=sys.stderr,
                )
                await _kill(proc)
                proc = None
            except RequestError as e:
                # A transient error before any turn is safe to retry in a fresh
                # agent: nothing ran yet (opencode 2026-10-13, 24 times in three
                # hours: ServiceUnavailableError "Location plugins did not finish
                # activating" at session/new). Quota, plan, auth and unclassified
                # errors are not retried; the last try's error is the run's.
                why = error_text(e)
                if attempt == tries or classify(why) != "transient":
                    raise
                delay = min(2.0 ** (attempt - 1), 10.0)
                client.rec(
                    "handshake_retry",
                    {
                        "attempt": attempt,
                        "tries": tries,
                        "phase": phase,
                        "delay": delay,
                        "why": why[:300],
                    },
                )
                print(
                    f"acp-run: handshake {phase} failed, attempt {attempt}/{tries};"
                    f" retry in {delay:g}s: {why[:200]}",
                    file=sys.stderr,
                )
                await _kill(proc)
                proc = None
                await asyncio.sleep(delay)
        else:
            out["error"] = (
                f"TimeoutError: handshake after {tries} tries of"
                f" {handshake_timeout:g}s ({', '.join(dict.fromkeys(hung))} hung)"
            )
            if len(hung) < tries:
                out["error"] += f"; {tries - len(hung)} failed transiently"
            if (
                not a.no_fallback
                and a.agent == "claude"
                and not (a.info or a.interactive or a.resume)
            ):
                return fallback_cli(a, client)
            code = 124
        if proc is None:
            pass
        elif a.info:
            caps = init.agent_capabilities
            options = sess.config_options
            wants = bool(a.model or a.set or getattr(a, "effort", None) or getattr(a, "context", None))
            if wants:
                # --info --model M [--set ...] [--effort ..] [--context ..]: apply them (no
                # prompt) and show the options that result, so a model's effort and context
                # choices are visible (R1 6.6)
                sets = dict(DEFAULT_SET.get(a.agent, {}))
                sets.update(kv.split("=", 1) for kv in a.set)
                if a.model:
                    sets["model"] = a.model
                options = await apply_config(a, conn, sess, init, client, order_sets(sets), applied,
                                             per_run_data=bool(deny_dir or os.environ.get("ACP_RUN_CRUSH_DATA")))
            info = {
                "agent": dump(init.agent_info),
                "auth_methods": dump(init.auth_methods),
                "capabilities": {
                    "loadSession": bool(caps and caps.load_session),
                    "sessionCapabilities": dump(caps.session_capabilities)
                    if caps
                    else None,
                },
                "modes": dump(sess.modes),
                "config_options": dump(options),
            }
            if models_extra(sess):
                info["models"] = dict(models_extra(sess))  # hermes, crush-acp: set with --model (session/set_model)
                if wants and applied.get("model"):
                    info["models"]["currentModelId"] = applied["model"]
            if wants:
                info["applied"] = {k: v for k, v in applied.items() if k in ("model", "effort", "ctx", "unverified")}
            if getattr(a, "all_models", False):
                info["per_model"] = await all_models_options(conn, sess, options)
            print(json.dumps(info, indent=1))
            print(
                "acp-run: capabilities loadSession="
                + json.dumps(info["capabilities"]["loadSession"])
                + " sessionCapabilities="
                + json.dumps(info["capabilities"]["sessionCapabilities"]),
                file=sys.stderr,
            )
            return 0
        else:
            if a.mode:
                await conn.set_session_mode(session_id=sess.session_id, mode_id=a.mode)
            sets = dict(DEFAULT_SET.get(a.agent, {}))
            if a.perm == "all" and not a.mode:
                sets.update(YOLO_SET.get(a.agent, {}))
            if a.perm == "deny" and not a.mode:
                sets.update(DENY_SET.get(a.agent, {}))
            sets.update(kv.split("=", 1) for kv in a.set)
            if a.model:
                sets["model"] = a.model
            sets = order_sets(sets)
            if a.resume and not sess.config_options and (sets or getattr(a, "effort", None) or getattr(a, "context", None)):
                client.rec("config_skipped", {"sets": sets})
                print(
                    f"acp-run: resumed session offers no config options;"
                    f" not applied: {sets}",
                    file=sys.stderr,
                )
                sets = {}
                if getattr(a, "effort", None) or getattr(a, "context", None):
                    usage_exit("--effort/--context: the resumed session offers no config options")
            await apply_config(a, conn, sess, init, client, sets, applied,
                               per_run_data=bool(deny_dir or os.environ.get("ACP_RUN_CRUSH_DATA")))
            if applied:
                client.rec("applied", applied)
            if a.interactive:
                herdr = Herdr(a.agent)
                herdr.session_id = sess.session_id
                if can_resume(init):
                    herdr.resume = resume_argv(a, root, sess.session_id)
                client.line(
                    f"[acp-run: {a.agent} session {sess.session_id}; log {log_path}]",
                    dim=True,
                )
                repl = Repl(a, conn, sess, client, herdr, proc, err)
                code = await repl.loop()
            else:
                finished, failure, tcode = await prompt_turn(
                    a, conn, sess, client, a.prompt_text, out
                )
                if tcode:
                    code = tcode
    except asyncio.CancelledError:
        if "sig" not in got:
            if a.agent not in AFTER_KILL_DROP:
                drop_deny_dir()
            raise
        main_task.uncancel()
        if a.agent not in AFTER_KILL_DROP:
            drop_deny_dir()  # before up to 20 s of cancel/kill waits a SIGKILL could cut short
        if conn is not None and sess is not None and not a.info:
            try:
                await asyncio.wait_for(conn.cancel(session_id=sess.session_id), 5)
                if client.prompt_task is not None:
                    await asyncio.wait_for(client.prompt_task, 5)
            except (TimeoutError, asyncio.CancelledError, RequestError, ConnectionError):
                pass
        failure = failure or (client.last_failure if client else None)
        out["stop_reason"] = "interrupted"
        out["error"] = f"interrupted by {signal.Signals(got['sig']).name}"
        code = 128 + got["sig"]
    except SystemExit:
        raise
    except ConfigError as e:
        # a requested model/effort/context was not applied: nothing was prompted
        out["error"] = str(e)[:500]
        failure = ("config", f"{FAILURE_TEXT['config']}: {out['error']}")
    except Exception as e:  # noqa: BLE001 - any agent failure becomes a summary line + exit 1
        failure = failure or (client.last_failure if client else None)
        out["error"] = error_text(e)[:500]
        if isinstance(e, ConnectionError):  # the agent died: its stderr may say why
            await _kill(proc)
            rc = proc.returncode if proc else None
            out["error"] += f" (agent exited, code {rc})"
            cls = classify(stderr_tail(err.name))
        else:
            cls = classify(out["error"])
        if cls:
            failure = (cls, f"{FAILURE_TEXT[cls]}: {out['error']}")
    finally:
        logging.disable(logging.CRITICAL)  # a half-written line at shutdown is noise
        # opencode/zcode: before _kill's waits, the run is over either way. agy: after,
        # since agy can still write under its GEMINI_HOME (a rotated credential) while
        # it is being stopped (adversary re-review 2026-10-13, finding 5).
        if a.agent not in AFTER_KILL_DROP:
            drop_deny_dir()
        await _kill(proc)
        drop_deny_dir()
        if herdr is not None:
            try:
                await herdr.release()
            except Exception:  # noqa: BLE001, S110 - never let herdr fail the run
                pass
        for s in sigs:
            loop.remove_signal_handler(s)
    out.update(seconds=round(time.time() - t0, 1))
    if client is None:
        out.update(tool_calls=0, permissions={"allowed": 0, "denied": 0})
        print(
            f"acp-run: agent={a.agent} stop=error secs={out['seconds']}"
            f" error={out.get('error')!r} log={log_path}",
            file=sys.stderr,
        )
        return code
    if client.usage:
        out["usage_update"] = client.usage
    if repl is not None and applied:
        post_turn(a, applied, client.usage)
    label = None
    if repl is not None:
        for k, v in repl.last_out.items():  # the last turn's stop reason etc.
            out.setdefault(k, v)
        tools, allowed, denied = (repl.tot[k] for k in ("tools", "allowed", "denied"))
        out["turns"] = repl.n
        text = repl.last_text
    else:
        tools, allowed, denied = client.tools, client.allowed, client.denied
        text = "".join(client.text)
        if not text.strip() and client.task_summary:
            text = client.task_summary  # copilot task_complete summary (see RunClient)
            out["text_source"] = "task_complete"
        code, label = verdict(a, out, finished, failure, code, client)
        bad = post_turn(a, applied, client.usage) if client.prompt_task is not None else None
        if bad and not failure:
            # the window the agent reports after the turn is not the one asked for
            out["error"], out["failure"], label = bad, "config", "config"
            if code == 0:
                code = 1
        out["turns"] = 1 if client.prompt_task is not None else 0
        if out["turns"]:
            row = {"n": 1, "stop_reason": out.get("stop_reason", "error")}
            row.update(seconds=out["seconds"], exit=code)
            client.rec("turn", row)
    out.update(tool_calls=tools, permissions={"allowed": allowed, "denied": denied})
    if applied:
        out["applied"] = {k: v for k, v in applied.items() if k in ("model", "effort", "ctx", "ctx_source", "unverified")}
    out["exit"] = code
    if getattr(a, "verify", None) and "verify" not in out:
        out["verify"] = "fail"
        out["verify_attempts"] = 0
    client.rec("result", out)
    if label:
        print(f"acp-run: FAILED {label}: {out.get('error')}", file=sys.stderr)
    if out.get("verify") == "fail" and code == 0:
        print(
            f"acp-run: warning: verification failed after {out.get('verify_attempts', 0)} attempt(s): {a.verify}",
            file=sys.stderr,
        )
    if a.json:
        print(json.dumps({**out, "text": text}, indent=1))
    else:
        if repl is None:  # --interactive streamed it already
            sys.stdout.write(text + ("\n" if text and not text.endswith("\n") else ""))
        sys.stdout.flush()
        u = out.get("usage") or {}
        cost = (client.usage or {}).get("cost", {}).get("amount")
        bits = [
            f"agent={a.agent}",
            f"stop={out.get('stop_reason', 'error')}",
            f"secs={out['seconds']}",
            f"tools={tools}",
            f"perm={allowed}+/{denied}-",
        ]
        if repl is not None:
            bits.append(f"turns={repl.n}")
        tok = u.get("totalTokens") or u.get("total_tokens")
        if tok:
            bits.append(f"tokens={tok}")
        if cost is not None:
            bits.append(f"cost=${cost:.4f}")
        if "wrapup" in out:
            bits.append(f"wrapup={out['wrapup'].split(':')[0]}")
        if "verify" in out:
            bits.append(f"verify={out['verify']}")
        if "verify_attempts" in out:
            bits.append(f"verify_attempts={out['verify_attempts']}")
        if "failure" in out:
            bits.append(f"fail={out['failure']}")
        if "error" in out:
            bits.append(f"error={out['error']!r}")
        if "warning" in out:
            bits.append(f"warning={out['warning']!r}")
        if applied_line(applied):
            print("acp-run: applied: " + applied_line(applied), file=sys.stderr)
        print("acp-run: " + " ".join(bits) + f" log={log_path}", file=sys.stderr)
    return code


def meta_arg(s):
    """argparse type of --meta: a JSON object."""
    try:
        v = json.loads(s)
    except ValueError as e:
        raise argparse.ArgumentTypeError(f"not JSON: {e}") from None
    if not isinstance(v, dict):
        raise argparse.ArgumentTypeError("must be a JSON object")
    return v


def env_float(name):
    v = os.environ.get(name)
    try:
        return float(v) if v else None
    except ValueError:
        raise SystemExit(f"acp-run: {name}={v!r} is not a number") from None


# Agents nothing may run without the operator's specific, explicit approval for that run
# (operator 2026-10-15: "not use omp or omp acp without specific explicit operator approval";
# same day: "hermes should never be used" as a delegation target, it is the operator's own
# assistant and aiuse lists it under [disabled_services]).
# The caller sets ACP_OPERATOR_APPROVED=<agent>[,<agent>] only after the operator said yes;
# acp-dispatch applies the same gate. omp has no AGENTS entry yet, so approval alone is not enough.
# cline (operator 2026-10-17): the CLI and Cline.app were uninstalled; the machinery stays so it can
# be re-enabled on purpose (reinstall, then approve). Only Hermes still uses Cline, through its own
# ClinePass API key, never through this.
OPERATOR_GATED = {
    "omp": "oh-my-pi bills Claude cloud credits; aiuse marks it requires_operator_approval",
    "hermes": "the operator's own assistant, never a delegation target (operator 2026-10-15)",
    "cline": "uninstalled 2026-10-17; only Hermes uses Cline (its ClinePass API pool)",
}
APPROVAL_ENV = "ACP_OPERATOR_APPROVED"


def operator_approved() -> set[str]:
    return {x.strip() for x in os.environ.get(APPROVAL_ENV, "").split(",") if x.strip()}


def main():
    ap = argparse.ArgumentParser(
        prog="acp-run",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        # No prefix matching: `--per all` must not mean `--perm all` (re-verification
        # R10, 2026-10-12: abbreviations slipped past callers' forbidden-flag lists).
        allow_abbrev=False,
    )
    ap.add_argument("agent", nargs="?")
    ap.add_argument("-C", "--dir", default=".")
    ap.add_argument(
        "--add-dir",
        action="append",
        default=[],
        metavar="DIR",
        help="extra workspace root for this session (repeatable); sent as"
        " additionalDirectories in session/new",
    )
    ap.add_argument("-p", "--prompt")
    ap.add_argument("-f", "--prompt-file")
    ap.add_argument(
        "--perm",
        default="all",
        help="all (default, yolo) or deny (read-only); the deprecated scoped:PATHS"
        " and ask warn and run as all",
    )
    ap.add_argument(
        "--keep-user-config",
        action="store_true",
        help="under --perm deny, start opencode and agy with the user's plugins, MCP"
        " servers and hooks anyway (default: stripped; env ACP_RUN_KEEP_USER_CONFIG=1)",
    )
    ap.add_argument(
        "--strip-user-config",
        action="store_true",
        help="strip opencode's, agy's, crush's and zcode's plugins, MCP servers and hooks"
        " under any --perm, not only deny (not a permission control; env"
        " ACP_RUN_STRIP_USER_CONFIG=1); --keep-user-config wins",
    )
    ap.add_argument(
        "--tripwire-exempt-kinds",
        default="",
        help="comma-separated read-only ACP tool kinds (read, search) that may run"
        " without a permission request under --perm deny without tripping",
    )
    ap.add_argument("--model")
    ap.add_argument("--mode")
    ap.add_argument(
        "--set",
        action="append",
        default=[],
        metavar="ID=VALUE",
        help="set an ACP session config option (see --info); repeatable",
    )
    ap.add_argument(
        "--effort",
        type=effort_arg,
        metavar="LEVEL",
        help="reasoning effort (none, minimal, low, medium, high, xhigh, max, ultra, default), set"
        " through the agent's own knob after the model and read back; exit 2 naming the valid"
        " values when the agent or model cannot take it",
    )
    ap.add_argument(
        "--context",
        type=context_arg,
        metavar="SIZE",
        help="context window (200k, 256k, 272k, 400k, 500k, 1m or a token count); exit 2 when the"
        " agent or model cannot take it (see the README table)",
    )
    ap.add_argument(
        "--meta",
        type=meta_arg,
        metavar="JSON",
        help="a JSON object merged into session/new _meta (over systemPrompt and the deny meta)",
    )
    ap.add_argument(
        "--agent-arg",
        action="append",
        default=[],
        metavar="ARG",
        help="extra argument appended to the agent's launch command (repeatable; env"
        " ACP_RUN_ARGS_<AGENT> is split like a shell line)",
    )
    ap.add_argument(
        "--agent-env",
        action="append",
        default=[],
        metavar="K=V[,K=V]",
        help="extra environment for the agent process (repeatable; env ACP_RUN_ENV_<AGENT>)",
    )
    ap.add_argument(
        "--all-models",
        action="store_true",
        help="with --info: switch to every model (no prompt) and list the options each one offers",
    )
    ap.add_argument("--timeout", type=float, default=1800, help="seconds per turn; 0 means no deadline")
    ap.add_argument(
        "--wrapup-grace",
        type=float,
        default=0,
        metavar="SECS",
        help="after a --timeout cancel, send one last wrap-up prompt and wait up"
        " to SECS for it (default 0: off; not with --interactive)",
    )
    ap.add_argument(
        "--wrapup",
        metavar="TEXT",
        help="the wrap-up prompt ({grace} is replaced by the seconds); default:"
        " write your final report now",
    )
    ap.add_argument(
        "--verify",
        metavar="CMD",
        help="shell command to verify the turn's work (exit 0 = pass); on failure, prompts the agent to fix it",
    )
    ap.add_argument(
        "--verify-retries",
        type=int,
        default=2,
        metavar="N",
        help="retry verify follow-ups up to N times (default 2; only with --verify)",
    )
    ap.add_argument(
        "--verify-timeout",
        type=float,
        default=180,
        metavar="SECS",
        help="timeout in seconds for each verify command run (default 180)",
    )
    ap.add_argument(
        "--auth",
        help="ACP auth method id to authenticate with (see --info), overriding"
        " the agent default; e.g. agy: oauth-personal",
    )
    ap.add_argument("--log")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--info", action="store_true")
    ap.add_argument("--list", action="store_true")
    ap.add_argument(
        "--handshake-tries",
        type=int,
        default=2,
        help="ACP initialize+session/new attempts (after a timeout or a transient"
        " error) before fallback (default 2)",
    )
    ap.add_argument(
        "--handshake-timeout",
        type=float,
        default=env_float("ACP_RUN_HANDSHAKE_TIMEOUT"),
        metavar="SECS",
        help="seconds for initialize and for session/new, each (default 40,"
        " claude 90; env ACP_RUN_HANDSHAKE_TIMEOUT)",
    )
    ap.add_argument(
        "--session-id",
        metavar="UUID",
        help="claude: the conversation id the CLI fallback runs as (see above)",
    )
    ap.add_argument(
        "--no-fallback",
        action="store_true",
        help="do not fall back to the agent's CLI if ACP handshake hangs",
    )
    ap.add_argument(
        "--prompt-retries",
        type=int,
        default=0,
        metavar="N",
        help="retry a prompt that failed transiently before any tool call (default 0)",
    )
    ap.add_argument(
        "--max-load",
        type=float,
        default=env_float("ACP_RUN_MAX_LOAD"),
        metavar="L",
        help="refuse to start (exit 75) while the 1-minute load average per CPU"
        " core is above L (env ACP_RUN_MAX_LOAD; default off)",
    )
    ap.add_argument(
        "--load-wait",
        type=float,
        default=env_float("ACP_RUN_LOAD_WAIT") or 0,
        metavar="SECS",
        help="with --max-load, wait up to SECS for the load to drop before"
        " refusing (env ACP_RUN_LOAD_WAIT; default 0)",
    )
    ap.add_argument(
        "-i",
        "--interactive",
        action="store_true",
        help="keep the session open: stream output, then read more prompts from"
        " stdin or --inbox (see above)",
    )
    ap.add_argument(
        "--inbox",
        metavar="DIR",
        help="with --interactive, also take prompts from"
        " *.txt/*.md files dropped into DIR",
    )
    ap.add_argument(
        "--show-thinking",
        action="store_true",
        help="with --interactive, print the agent's thoughts too",
    )
    ap.add_argument(
        "--resume",
        metavar="SESSION_ID",
        help="reopen this ACP session (session/load or session/resume) instead"
        " of starting a new one",
    )
    a = ap.parse_args()
    bad = [k for k in a.tripwire_exempt_kinds.split(',') if k and k not in TRIPWIRE_EXEMPTABLE]
    if bad:
        ap.error(f"--tripwire-exempt-kinds: only read-only kinds {', '.join(TRIPWIRE_EXEMPTABLE)}; not {', '.join(bad)}")
    if a.timeout < 0:
        ap.error("--timeout must be 0 or more")
    if a.perm == "deny" and a.agent in DENY_UNSUPPORTED \
            and not os.environ.get(DENY_UNSUPPORTED_OVERRIDE_ENV.get(a.agent, "")):
        ap.error(f"--perm deny: {DENY_UNSUPPORTED[a.agent]}")
    if a.list:
        for n, (c, auth) in AGENTS.items():
            ok = "ok " if shutil.which(c[0]) else "-- "
            print(f"{ok}{n:9} {' '.join(c)}" + (f"  (auth {auth})" if auth else ""))
        return 0
    if a.agent in OPERATOR_GATED and a.agent not in operator_approved():
        ap.error(f"{a.agent} needs specific, explicit operator approval for this run"
                 f" ({OPERATOR_GATED[a.agent]}); once given, set {APPROVAL_ENV}={a.agent}")
    if a.agent not in AGENTS:
        ap.error(f"agent must be one of: {', '.join(AGENTS)}")
    if not (a.perm in ("all", "deny", "ask") or a.perm.startswith("scoped:")):
        ap.error("--perm must be all or deny")
    if a.perm == "ask" or a.perm.startswith("scoped:"):
        # operator 2026-10-14: acp-run runs yolo for every agent; the old scoped:/ask
        # policies are accepted for old callers but no longer enforced.
        print(f"acp-run: warning: --perm {a.perm} is no longer enforced: acp-run runs yolo"
              " for every agent (treated as --perm all); use --perm deny for a read-only run",
              file=sys.stderr)
        a.perm = "all"
    if (a.inbox or a.show_thinking) and not a.interactive:
        ap.error("--inbox and --show-thinking need --interactive")
    if a.all_models and not a.info:
        ap.error("--all-models needs --info")
    check_static(a)
    if a.prompt_retries < 0:
        ap.error("--prompt-retries must be 0 or more")
    if a.handshake_timeout is not None and a.handshake_timeout <= 0:
        ap.error("--handshake-timeout must be positive")
    if a.wrapup_grace < 0:
        ap.error("--wrapup-grace must be 0 or more")
    if a.wrapup and not a.wrapup_grace:
        ap.error("--wrapup needs --wrapup-grace")
    if a.verify_retries < 0:
        ap.error("--verify-retries must be 0 or more")
    if a.verify_timeout <= 0:
        ap.error("--verify-timeout must be positive")
    if a.verify is not None and not a.verify.strip():
        ap.error("--verify command cannot be empty")
    if a.session_id is not None:
        if a.agent != "claude":
            ap.error("--session-id is for claude only")
        try:
            a.session_id = str(uuid.UUID(a.session_id))
        except ValueError:
            ap.error("--session-id must be a UUID")
    a.prompt_text = None
    if not a.info:
        if a.prompt_file:
            a.prompt_text = Path(a.prompt_file).read_text()
        elif a.prompt:
            a.prompt_text = a.prompt
        elif a.interactive:
            pass  # stdin feeds the prompt loop instead
        elif not sys.stdin.isatty():
            a.prompt_text = sys.stdin.read()
        else:
            ap.error("give a prompt with -p, -f or stdin")
    cmd = YOLO_CMD.get(a.agent, AGENTS[a.agent][0])
    if not shutil.which(cmd[0]):
        raise SystemExit(f"acp-run: {cmd[0]} not installed")
    if a.max_load is not None and not a.info:
        why = load_guard(a.max_load, a.load_wait)
        if why:
            print(f"acp-run: refusing to start: {why}", file=sys.stderr)
            return EXIT_LOAD
    if a.perm == "deny" or strips_outside_deny(a):
        safe_sweep_stale_deny_dirs()  # dirs a SIGKILLed deny/strip run could not remove
    state = Path.home() / ".local/state/acp-run"
    state.mkdir(parents=True, exist_ok=True)
    stamp = time.strftime("%Y%m%d-%H%M%S")
    log_path = (
        Path(a.log) if a.log else state / f"{stamp}-{a.agent}-{os.getpid()}.jsonl"
    )
    with open(log_path, "w") as log, open(log_path.with_suffix(".stderr"), "w") as err:
        return asyncio.run(run(a, log, err, log_path))


if __name__ == "__main__":
    sys.exit(main())

def tripwire_exempt_kinds(agent, perm, extra=""):
    """The ACP tool kinds that never trip this run: --tripwire-exempt-kinds (extra, comma
    separated) plus, under --perm read-only, the reading kinds and the agent's contained kinds."""
    kinds = frozenset(k for k in extra.split(",") if k)
    if perm == "read-only":
        kinds |= frozenset(READONLY_KINDS) | frozenset(READONLY_UNASKED_KINDS.get(agent, ()))
    return kinds
READONLY_UNSUPPORTED = ("no read-only mode verified for this agent; use --perm all with a read-only"
                        " brief and a diff check")


def perm_modes(agent):
    """The --perm values this agent supports (acp-run <agent> --info)."""
    modes = ["all"]
    if agent not in DENY_UNSUPPORTED or os.environ.get(DENY_UNSUPPORTED_OVERRIDE_ENV.get(agent, "")):
        modes.append("deny")
    if agent in READONLY_AGENTS:
        modes.append("read-only")
    return modes


# Per-run --perm deny temp dirs are named <DENY_DIR_PREFIX><agent>-deny-<pid>-<random>
# under tempfile.gettempdir(). run() removes its own; a run killed with SIGKILL cannot,
# so each deny run first sweeps this user's dirs older than DENY_DIR_MAX_AGE whose pid
# is gone (sweep_stale_deny_dirs). Names without a pid (before 2026-10-13) go by age.
DENY_DIR_PREFIX = "acp-run-"
# The pid is bounded (a planted 11-digit name made os.kill raise OverflowError and
# stopped every deny run: adversary re-review 2026-10-13, finding 1); fullmatch, so a
# trailing newline does not match.
# --strip-user-config outside --perm deny names its dirs <prefix><agent>-strip-<pid>-...
# (2026-10-13), swept the same way.
DENY_DIR_RE = re.compile(r"acp-run-[a-z]+-(?:deny|strip)-(?:(\d{1,7})-)?[A-Za-z0-9_]+")
DENY_DIR_MAX_AGE = 3 * 3600


def remove_deny_dir(d):
    """rmtree a per-run temp dir (never follows symlinks); say so if it fails."""
    try:
        shutil.rmtree(d)
    except FileNotFoundError:
        pass
    except OSError as e:
        # a broken stderr pipe must not skip the caller's finally (_kill, herdr release)
        with contextlib.suppress(OSError):
            print(f"acp-run: could not remove {d}: {e}", file=sys.stderr)
        shutil.rmtree(d, ignore_errors=True)


def _pid_alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except (PermissionError, OverflowError, ValueError):
        return True  # someone else's, or not a pid we can check: never sweep it
    return True


def sweep_stale_deny_dirs(base=None, max_age=DENY_DIR_MAX_AGE, now=None):
    """Remove stale per-run deny dirs left by killed runs: real directories (not
    symlinks) directly under the temp base, owned by this user, matching DENY_DIR_RE,
    last modified more than max_age ago, whose pid (if named) is no longer running.
    Returns the names removed."""
    base = base or tempfile.gettempdir()
    now = time.time() if now is None else now
    gone = []
    try:
        entries = list(os.scandir(base))
    except OSError:
        return gone
    for e in entries:
        m = DENY_DIR_RE.fullmatch(e.name)
        if not m:
            continue
        try:
            st = e.stat(follow_symlinks=False)
        except OSError:
            continue
        if (e.is_symlink() or not e.is_dir(follow_symlinks=False) or st.st_uid != os.getuid()
                or now - st.st_mtime < max_age):
            continue
        if m.group(1) and (int(m.group(1)) == os.getpid() or _pid_alive(int(m.group(1)))):
            continue
        remove_deny_dir(e.path)
        gone.append(e.name)
    return gone


def safe_sweep_stale_deny_dirs():
    """sweep_stale_deny_dirs that can never stop a deny run: warn and carry on."""
    try:
        return sweep_stale_deny_dirs()
    except Exception as e:  # noqa: BLE001 - a planted name must not break deny runs
        with contextlib.suppress(OSError):
            print(f"acp-run: warning: stale deny-dir sweep failed: {e!r}", file=sys.stderr)
        return None





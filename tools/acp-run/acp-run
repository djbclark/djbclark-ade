# zcode-acp-server sends its turn-state notification as "$/zcode/turnState". The
# ACP Python library only knows "_" as the extension prefix and raises
# method_not_found (a logged traceback per notification) for the JSON-RPC
# reserved "$/" prefix, so fold "$/" into "_" and let ext_notification ignore it.
import acp.router as _acp_router
from acp import PROTOCOL_VERSION, Client, RequestError, connect_to_agent
from acp.schema import (
    AgentMessageChunk,
    AllowedOutcome,
    ClientCapabilities,
    DeniedOutcome,
    Implementation,
    RequestPermissionResponse,
    TextContentBlock,
)

_acp_route = _acp_router.MessageRouter.__call__


async def _route_dollar_as_extension(self, method, params, is_notification):
    if isinstance(method, str) and method.startswith("$/"):
        method = "_" + method[2:]
    return await _acp_route(self, method, params, is_notification)


_acp_router.MessageRouter.__call__ = _route_dollar_as_extension


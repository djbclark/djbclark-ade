def env_seconds(name: str, default: float, low: float, high: float) -> float:
    """A seconds value from the environment: junk, nan or inf is the default; the rest is clamped to
    low..high (an unbounded ACP_RUN_BIN_WAIT=inf would wait forever, junk used to crash with exit 1)."""
    try:
        value = float(os.environ.get(name, default))
    except ValueError:
        return default
    return min(max(value, low), high) if math.isfinite(value) else default


def bin_wait_settings() -> tuple[float, float]:
    """(wait, poll) seconds for a missing agent binary: ACP_RUN_BIN_WAIT 0..600 (0 disables),
    ACP_RUN_BIN_POLL 0.05..30."""
    return (env_seconds("ACP_RUN_BIN_WAIT", BIN_WAIT, 0.0, BIN_WAIT_MAX),
            env_seconds("ACP_RUN_BIN_POLL", BIN_POLL, 0.05, 30.0))


def agent_executable(cmd: list[str]) -> str:
    """The program a launch command really runs: an `env NAME=VAL ... PROGRAM` wrapper is
    skipped, since `env` is always on PATH and would hide a missing agent binary (Codex 4322594869)."""
    if os.path.basename(cmd[0]) != "env":
        return cmd[0]
    for tok in cmd[1:]:
        if "=" not in tok:
            return tok
    return cmd[0]


def bin_settle(found: str, poll: float) -> None:
    """A binary that just appeared may still be relinking (an npm package shows its bin symlink
    before its files are all extracted): wait one more poll and, if its real path or mtime moved
    meanwhile, keep waiting up to ten polls for it to hold still."""
    def stamp() -> tuple[str, float] | None:
        try:
            real = os.path.realpath(found)
            return real, os.stat(real).st_mtime
        except OSError:
            return None
    seen = stamp()
    for _ in range(10):
        time.sleep(poll)
        now = stamp()
        if now == seen:
            return
        seen = now

; tests/test_firecrawl_router.py:741
(DEFUN ADE::SERVE (ADE::ST) (DECLARE (XARGS :GUARD (ADE::STATE-P ADE::ST) :MEASURE (ACL2-COUNT ADE::ST)))
  (IF (ATOM ADE::ST) NIL (CONS (CAR ADE::ST) (ADE::SERVE (CDR ADE::ST)))))
(DEFTHM ADE::SERVE-PRESERVES-STATE-P
  (IMPLIES (ADE::STATE-P ADE::ST) (ADE::STATE-P (ADE::SERVE ADE::ST)))
  :RULE-CLASSES (:REWRITE :TYPE-PRESCRIPTION))
(DEFTHM ADE::LEN-OF-SERVE
  (<= (LEN (ADE::SERVE ADE::ST)) (LEN ADE::ST)))
(DEFTHM ADE::SERVE-IDEMPOTENT
  (IMPLIES (ADE::STATE-P ADE::ST) (EQUAL (ADE::SERVE (ADE::SERVE ADE::ST)) (ADE::SERVE ADE::ST)))
  :HINTS (("Goal" :INDUCT (ADE::SERVE ADE::ST))))
(DEFTHM ADE::TRUE-LISTP-OF-SERVE
  (TRUE-LISTP (ADE::SERVE ADE::ST))
  :RULE-CLASSES :TYPE-PRESCRIPTION)


  (IF (ATOM ADE::ST) NIL (CONS (CAR ADE::ST) (ADE::TEST-RUN-PRINTS-THE-APPLIED-LINE-AND-RECO (CDR ADE::ST)))))
(DEFTHM ADE::TEST-RUN-PRINTS-THE-APPLIED-LINE-AND-RECO-PRESERVES-STATE-P
  (IMPLIES (ADE::STATE-P ADE::ST) (ADE::STATE-P (ADE::TEST-RUN-PRINTS-THE-APPLIED-LINE-AND-RECO ADE::ST)))
  :RULE-CLASSES (:REWRITE :TYPE-PRESCRIPTION))
(DEFTHM ADE::LEN-OF-TEST-RUN-PRINTS-THE-APPLIED-LINE-AND-RECO
  (<= (LEN (ADE::TEST-RUN-PRINTS-THE-APPLIED-LINE-AND-RECO ADE::ST)) (LEN ADE::ST)))
(DEFTHM ADE::TEST-RUN-PRINTS-THE-APPLIED-LINE-AND-RECO-IDEMPOTENT
  (IMPLIES (ADE::STATE-P ADE::ST) (EQUAL (ADE::TEST-RUN-PRINTS-THE-APPLIED-LINE-AND-RECO (ADE::TEST-RUN-PRINTS-THE-APPLIED-LINE-AND-RECO ADE::ST)) (ADE::TEST-RUN-PRINTS-THE-APPLIED-LINE-AND-RECO ADE::ST)))
  :HINTS (("Goal" :INDUCT (ADE::TEST-RUN-PRINTS-THE-APPLIED-LINE-AND-RECO ADE::ST))))
(DEFTHM ADE::TRUE-LISTP-OF-TEST-RUN-PRINTS-THE-APPLIED-LINE-AND-RECO
  (TRUE-LISTP (ADE::TEST-RUN-PRINTS-THE-APPLIED-LINE-AND-RECO ADE::ST))
  :RULE-CLASSES :TYPE-PRESCRIPTION)


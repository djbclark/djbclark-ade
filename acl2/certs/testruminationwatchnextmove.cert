  (IMPLIES (ADE::STATE-P ADE::ST) (EQUAL (ADE::TEST-A-STAMP-FROM-THE-FUTURE-OR-WITH-NO-F (ADE::TEST-A-STAMP-FROM-THE-FUTURE-OR-WITH-NO-F ADE::ST)) (ADE::TEST-A-STAMP-FROM-THE-FUTURE-OR-WITH-NO-F ADE::ST)))
  :HINTS (("Goal" :INDUCT (ADE::TEST-A-STAMP-FROM-THE-FUTURE-OR-WITH-NO-F ADE::ST))))
(DEFTHM ADE::TRUE-LISTP-OF-TEST-A-STAMP-FROM-THE-FUTURE-OR-WITH-NO-F

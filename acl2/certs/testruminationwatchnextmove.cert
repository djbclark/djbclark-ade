(DEFUN ADE::TEST-A-STAMP-FROM-THE-FUTURE-OR-WITH-NO-F (ADE::ST) (DECLARE (XARGS :GUARD (ADE::STATE-P ADE::ST) :MEASURE (ACL2-COUNT ADE::ST)))
  (IF (ATOM ADE::ST) NIL (CONS (CAR ADE::ST) (ADE::TEST-A-STAMP-FROM-THE-FUTURE-OR-WITH-NO-F (CDR ADE::ST)))))

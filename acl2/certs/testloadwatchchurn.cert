(DEFTHM ADE::TEST-NO-VM-STAT-CHANGES-NOTHING-IDEMPOTENT
  (IMPLIES (ADE::STATE-P ADE::ST) (EQUAL (ADE::TEST-NO-VM-STAT-CHANGES-NOTHING (ADE::TEST-NO-VM-STAT-CHANGES-NOTHING ADE::ST)) (ADE::TEST-NO-VM-STAT-CHANGES-NOTHING ADE::ST)))
  :HINTS (("Goal" :INDUCT (ADE::TEST-NO-VM-STAT-CHANGES-NOTHING ADE::ST))))
(DEFTHM ADE::TRUE-LISTP-OF-TEST-NO-VM-STAT-CHANGES-NOTHING
  (TRUE-LISTP (ADE::TEST-NO-VM-STAT-CHANGES-NOTHING ADE::ST))
  :RULE-CLASSES :TYPE-PRESCRIPTION)


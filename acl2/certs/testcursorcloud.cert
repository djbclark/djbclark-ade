(DEFTHM ADE::LEN-OF-TEST-LAUNCH-POSTS-BODY
  (<= (LEN (ADE::TEST-LAUNCH-POSTS-BODY ADE::ST)) (LEN ADE::ST)))
(DEFTHM ADE::TEST-LAUNCH-POSTS-BODY-IDEMPOTENT
  (IMPLIES (ADE::STATE-P ADE::ST) (EQUAL (ADE::TEST-LAUNCH-POSTS-BODY (ADE::TEST-LAUNCH-POSTS-BODY ADE::ST)) (ADE::TEST-LAUNCH-POSTS-BODY ADE::ST)))
  :HINTS (("Goal" :INDUCT (ADE::TEST-LAUNCH-POSTS-BODY ADE::ST))))
(DEFTHM ADE::TRUE-LISTP-OF-TEST-LAUNCH-POSTS-BODY
  (TRUE-LISTP (ADE::TEST-LAUNCH-POSTS-BODY ADE::ST))
  :RULE-CLASSES :TYPE-PRESCRIPTION)


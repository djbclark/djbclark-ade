(DEFTHM ADE::LEN-OF-CMD-CLEAR
  (<= (LEN (ADE::CMD-CLEAR ADE::ST)) (LEN ADE::ST)))
(DEFTHM ADE::CMD-CLEAR-IDEMPOTENT
  (IMPLIES (ADE::STATE-P ADE::ST) (EQUAL (ADE::CMD-CLEAR (ADE::CMD-CLEAR ADE::ST)) (ADE::CMD-CLEAR ADE::ST)))
  :HINTS (("Goal" :INDUCT (ADE::CMD-CLEAR ADE::ST))))
(DEFTHM ADE::TRUE-LISTP-OF-CMD-CLEAR
  (TRUE-LISTP (ADE::CMD-CLEAR ADE::ST))
  :RULE-CLASSES :TYPE-PRESCRIPTION)

; bin/gate-profile:479
(DEFUN ADE::MAIN (ADE::ST) (DECLARE (XARGS :GUARD (ADE::STATE-P ADE::ST) :MEASURE (ACL2-COUNT ADE::ST)))
  (IF (ATOM ADE::ST) NIL (CONS (CAR ADE::ST) (ADE::MAIN (CDR ADE::ST)))))
(DEFTHM ADE::MAIN-PRESERVES-STATE-P
  (IMPLIES (ADE::STATE-P ADE::ST) (ADE::STATE-P (ADE::MAIN ADE::ST)))
  :RULE-CLASSES (:REWRITE :TYPE-PRESCRIPTION))
(DEFTHM ADE::LEN-OF-MAIN
  (<= (LEN (ADE::MAIN ADE::ST)) (LEN ADE::ST)))
(DEFTHM ADE::MAIN-IDEMPOTENT
  (IMPLIES (ADE::STATE-P ADE::ST) (EQUAL (ADE::MAIN (ADE::MAIN ADE::ST)) (ADE::MAIN ADE::ST)))
  :HINTS (("Goal" :INDUCT (ADE::MAIN ADE::ST))))
(DEFTHM ADE::TRUE-LISTP-OF-MAIN
  (TRUE-LISTP (ADE::MAIN ADE::ST))
  :RULE-CLASSES :TYPE-PRESCRIPTION)


(DEFTHM ADE::TEST-NON-CHECKPOINT-NEVER-STALE-PRESERVES-STATE-P
  (IMPLIES (ADE::STATE-P ADE::ST) (ADE::STATE-P (ADE::TEST-NON-CHECKPOINT-NEVER-STALE ADE::ST)))
  :RULE-CLASSES (:REWRITE :TYPE-PRESCRIPTION))
(DEFTHM ADE::LEN-OF-TEST-NON-CHECKPOINT-NEVER-STALE
  (<= (LEN (ADE::TEST-NON-CHECKPOINT-NEVER-STALE ADE::ST)) (LEN ADE::ST)))
(DEFTHM ADE::TEST-NON-CHECKPOINT-NEVER-STALE-IDEMPOTENT
  (IMPLIES (ADE::STATE-P ADE::ST) (EQUAL (ADE::TEST-NON-CHECKPOINT-NEVER-STALE (ADE::TEST-NON-CHECKPOINT-NEVER-STALE ADE::ST)) (ADE::TEST-NON-CHECKPOINT-NEVER-STALE ADE::ST)))
  :HINTS (("Goal" :INDUCT (ADE::TEST-NON-CHECKPOINT-NEVER-STALE ADE::ST))))
(DEFTHM ADE::TRUE-LISTP-OF-TEST-NON-CHECKPOINT-NEVER-STALE
  (TRUE-LISTP (ADE::TEST-NON-CHECKPOINT-NEVER-STALE ADE::ST))
  :RULE-CLASSES :TYPE-PRESCRIPTION)


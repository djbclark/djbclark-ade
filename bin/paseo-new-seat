#!/usr/bin/env python3
"""paseo-new-seat — create a Paseo seat with auto_accept ON from the first tool call.

WHY THIS EXISTS (2026-10-25)
----------------------------
djbclark: "If possible you should always open other agents that are part of you with the paseo 'Auto
accept permission prompts' enabled." Doing that with `paseo agent run` and then setting the feature is
*not* enough, and the reason is in Paseo's own source:

    function resolveACPCreateConfig(input) {
        const isUnattendedCreate = input.unattended || input.parent?.isUnattended === true;
        const featureValues = isUnattendedCreate && input.featureValues?.["auto_accept"] === undefined
            ? { ...input.featureValues, ["auto_accept"]: true }
            : input.featureValues;

`auto_accept` is defaulted to true **only for an "unattended" create**, and `paseo agent run` has no
`--unattended` flag — so every seat created that way is an *interactive* create with the feature
undefined: a grey shield and a prompt on the first tool call.

That window is real and it is not cosmetic. On 2026-10-25 a seat was created with a prompt that told it
to read its brief immediately; it hit a permission prompt **before** the feature could be set
afterwards, and the operator had to answer it by hand. Setting the flag after creation cannot fix a
prompt that already fired.

So the create must carry the feature. `createAgent` accepts a `config` object that is passed through to
the provider, and `featureValues.auto_accept` is what `isACPAutoAcceptEnabled` reads:

    function isACPAutoAcceptEnabled(config) {
        return config.featureValues?.["auto_accept"] === true;
    }

This script uses the daemon's own client (the same path `paseo-set-model` uses) to create the agent with
that config, then verifies the shield from the agent's state file.

USAGE
  paseo-new-seat --title "Dann Chat 3" --prompt "..." [--provider cline] [--model M]
                 [--cwd DIR] [--workspace ID] [--thinking ID] [--mode ID] [--label k=v]... [--json]
                 [--no-auto-accept] [--dry-run] [--probe]

--probe is for a throwaway test seat ("Reply ok and stop."): it waits for the turn to end, then archives the
agent so no tab is left behind (exit 5 when the agent was created but could not be archived). A live probe is
the exception: prefer --dry-run, and use --probe only when the real create path must run (2026-10-28: two
hand-run "zz probe" seats were left in the shared `watch` workspace, an omp one and a codex one).

--thinking is the provider's thinking option id (`paseo provider models <p> --thinking`); --mode creates the
agent in that permission mode and verifies it (codex has no auto_accept feature: its yolo is mode `full-access`,
so a codex seat without --mode runs in `auto`, Default Permissions, and can stall on a prompt; 2026-10-27); --label tags the
agent (bin/watch uses watch=<domain>); --json prints one JSON line {id, shortId, autoAccept} instead of the
two text lines. An empty --model starts the provider's own default model.

Exit: 0 created and verified; 1 error; 2 usage; 4 created but the shield did not come up green;
5 --probe: created but not archived.
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import time
from pathlib import Path

APP = "/Applications/Paseo.app/Contents"
DEFAULT_HELPER = f"{APP}/Frameworks/Paseo Helper.app/Contents/MacOS/Paseo Helper"
DEFAULT_CLI_DIST = f"{APP}/Resources/app.asar/node_modules/@getpaseo/cli/dist"
MJS = Path(os.path.realpath(__file__)).with_name("paseo-new-seat.mjs")

USAGE = (__doc__ or "").split("USAGE")[-1].strip("\n") + "\n"


def usage() -> int:
    print(USAGE, file=sys.stderr)
    return 2


def _paseo(*argv: str) -> subprocess.CompletedProcess:
    return subprocess.run([os.environ.get("PASEO_NEW_SEAT_PASEO") or "paseo", *argv],
                          capture_output=True, text=True, check=False)


def archive_probe(agent_id: str, wait_s: float) -> int:
    """Wait for the probe's turn to end, then archive it. Never leaves the tab open silently."""
    deadline = time.monotonic() + wait_s
    while time.monotonic() < deadline:
        r = _paseo("agent", "ls", "-g", "--json")
        try:
            rows = json.loads(r.stdout) if r.returncode == 0 else []
        except ValueError:
            rows = []
        row = next((x for x in rows if x.get("id") == agent_id), None)
        if row is not None and row.get("status") not in ("running", "initializing"):
            break
        time.sleep(float(os.environ.get("PASEO_NEW_SEAT_POLL") or 2))
    r = _paseo("agent", "archive", agent_id)
    if r.returncode != 0:
        print(f"paseo-new-seat: probe {agent_id[:8]} created but not archived: "
              f"{(r.stderr or r.stdout).strip()}", file=sys.stderr)
        return 5
    return 0


def main(argv: list[str]) -> int:
    p = argparse.ArgumentParser(prog="paseo-new-seat", add_help=False)
    p.add_argument("--title", required=True)
    p.add_argument("--prompt", default="")
    p.add_argument("--provider", default="cline")
    p.add_argument("--model", default="cline-pass/deepseek-v4.1-flash")
    p.add_argument("--cwd", default=os.path.expanduser("~/src/techno-euphora"))
    p.add_argument("--workspace", default="")
    p.add_argument("--allow-new-workspace", action="store_true",
                   help="permit creating a NEW workspace (refused by default: the implicit path "
                        "littered four empty `main` workspaces on 2026-10-25)")
    p.add_argument("--thinking", default="")
    p.add_argument("--mode", default="")
    p.add_argument("--label", action="append", default=[])
    p.add_argument("--json", action="store_true")
    p.add_argument("--no-auto-accept", action="store_true")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--probe", action="store_true")
    p.add_argument("-h", "--help", action="store_true")
    try:
        a = p.parse_args(argv)
    except SystemExit:
        return usage()
    if a.help:
        print(__doc__)
        return 0

    args = ["create", "--title", a.title, "--provider", a.provider, "--model", a.model,
            "--cwd", a.cwd]
    if a.prompt:
        args += ["--prompt", a.prompt]
    if a.workspace:
        args += ["--workspace", a.workspace]
    if a.thinking:
        args += ["--thinking", a.thinking]
    if a.mode:
        args += ["--mode", a.mode]
    for lab in a.label:
        args += ["--label", lab]
    if a.json or (a.probe and not a.dry_run):
        args += ["--json"]
    if a.allow_new_workspace:
        args += ["--allow-new-workspace"]
    if not a.no_auto_accept:
        args += ["--auto-accept"]
    if a.dry_run:
        args += ["--dry-run"]

    helper = os.environ.get("PASEO_NEW_SEAT_HELPER") or DEFAULT_HELPER
    env = dict(os.environ)
    env["ELECTRON_RUN_AS_NODE"] = "1"
    env["PASEO_NODE_ENV"] = "production"
    env["PASEO_NEW_SEAT_CLI_DIST"] = os.environ.get("PASEO_NEW_SEAT_CLI_DIST") or DEFAULT_CLI_DIST
    try:
        if not a.probe or a.dry_run:
            return subprocess.run([helper, "--disable-warning=DEP0040", str(MJS), *args],
                                  env=env, check=False).returncode
        r = subprocess.run([helper, "--disable-warning=DEP0040", str(MJS), *args],
                           env=env, check=False, stdout=subprocess.PIPE, text=True)
    except OSError as e:
        print(f"paseo-new-seat: cannot run {helper}: {e}", file=sys.stderr)
        return 1
    sys.stdout.write(r.stdout)
    if r.returncode not in (0, 4):
        return r.returncode
    try:
        rec = json.loads(r.stdout.strip().splitlines()[-1])
        agent_id = str(rec["id"])
    except (ValueError, KeyError, IndexError):
        print("paseo-new-seat: --probe could not read the new agent id; not archived", file=sys.stderr)
        return 5
    rc = archive_probe(agent_id, float(os.environ.get("PASEO_NEW_SEAT_PROBE_WAIT") or 120))
    return rc or r.returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

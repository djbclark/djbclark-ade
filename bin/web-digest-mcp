#!/usr/bin/env -S python3 -I
"""web-digest-mcp — web-digest as a native MCP tool, for small-context models.

A stdio MCP server (newline-delimited JSON-RPC 2.0, stdlib only) exposing ONE tool,
`web_search(question, url?)`, that runs `web-digest` and returns its cited digest. A small model
that believes `web-digest` is a tool of its own (it typed the command as text twice on 2026-10-14,
once as `<tool_use> web-digest "..." </tool_use>`, and ran nothing) gets a real tool with that
shape instead of having to route the command through `bash`.

SCOPE: only for small-context models (Crush + Qwen on SIPB LLMs, 32k window). Other agents have
their own web tools. Register in crushrc: `mcp add web --type stdio --command <this file>`.
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
WEB_DIGEST = os.environ.get("WEB_DIGEST_BIN") or str(HERE / "web-digest")
TOOL = {
    "name": "web_search",
    "description": (
        "Search the web (or read one page) and get back a short cited answer: a few ranked passages "
        "with numbered sources. Use it BEFORE reading docs or code to learn how an API or tool works "
        "or why an error happens. If it fails it says so; then stop and tell the user, do not guess."
    ),
    "inputSchema": {
        "type": "object",
        "properties": {
            "question": {"type": "string", "description": "A specific question or search query."},
            "url": {"type": "string", "description": "Optional: read this page instead of searching."},
        },
        "required": ["question"],
    },
}


def call(args: dict) -> dict:
    # a small model guesses the argument name (2026-10-14: `query`); accept the usual aliases
    q = str(next((args[k] for k in ("question", "query", "q", "search", "text") if args.get(k)), "")).strip()
    if not q:
        return {"content": [{"type": "text", "text": "web_search needs a non-empty `question`."}], "isError": True}
    cmd = [WEB_DIGEST, q]
    if args.get("url"):
        cmd += ["--url", str(args["url"])]
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=170)
        text, bad = p.stdout.strip() or p.stderr.strip() or "no output", p.returncode != 0
    except subprocess.TimeoutExpired:
        text, bad = ("WEB-DIGEST FAILED: timed out after 170s\nSTOP. Tell the user the web lookup failed. "
                     "Do NOT answer from memory and do not guess."), True
    return {"content": [{"type": "text", "text": text}], "isError": bad}


def handle(msg: dict):
    method, mid = msg.get("method"), msg.get("id")
    if mid is None:  # a notification (initialized, cancelled, ...): no reply
        return None
    if method == "initialize":
        ver = (msg.get("params") or {}).get("protocolVersion") or "2024-11-05"
        res = {"protocolVersion": ver, "capabilities": {"tools": {}},
               "serverInfo": {"name": "web-digest-mcp", "version": "1.0"}}
    elif method == "tools/list":
        res = {"tools": [TOOL]}
    elif method == "tools/call":
        p = msg.get("params") or {}
        if p.get("name") != TOOL["name"]:
            return {"jsonrpc": "2.0", "id": mid, "error": {"code": -32602, "message": f"unknown tool {p.get('name')!r}"}}
        res = call(p.get("arguments") or {})
    elif method == "ping":
        res = {}
    else:
        return {"jsonrpc": "2.0", "id": mid, "error": {"code": -32601, "message": f"method not found: {method}"}}
    return {"jsonrpc": "2.0", "id": mid, "result": res}


def main() -> int:
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            reply = handle(json.loads(line))
        except Exception as e:  # never die on one bad message
            reply = {"jsonrpc": "2.0", "id": None, "error": {"code": -32603, "message": str(e)}}
        if reply is not None:
            sys.stdout.write(json.dumps(reply) + "\n")
            sys.stdout.flush()
    return 0


if __name__ == "__main__":
    sys.exit(main())

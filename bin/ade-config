#!/usr/bin/env -S python3 -I
"""ade-config: check/get/diff/set/fold for the versioned effective ADE config (schema_version=1).

  ade-config check [--root DIR] [--home DIR] [--json]
  ade-config get PATH [--root DIR] [--home DIR] [--json]
  ade-config diff [--root DIR] [--home DIR] [--json]
  ade-config set PATH VALUE [--target local|repo] [--string] [--dry-run]
                 [--root DIR] [--home DIR] [--json]
  ade-config fold [--root DIR] [--write|--check] [--json]

check/get/diff stay read-only: no writes, no secret resolution, no network/auth.
set performs a comment-preserving atomic scalar write (default --target local).
fold projects legacy domain TOMLs (including install/keys under [install]) into the
schema_version=1 tree (print, --write config/ade.toml, or --check that a present
ade.toml matches the fold). Missing config/ade.toml projects legacy split files.
Present valid ade.toml is the repo base. Present invalid or unknown-version config
fails. Local override:
~/.config/djbclark-ade/local.toml. ROUTING_POLICY / GATES_TOML / CONTEXT_BUDGET_TOML /
SECRET_DENY_TOML / PR_POLICY_TOML remain isolated legacy-format overrides and are
never set targets. See docs/config-migration.md.
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

BIN = Path(__file__).resolve().parent
if str(BIN) not in sys.path:
    sys.path.insert(0, str(BIN))

import ade_config as ac  # noqa: E402
import ade_config_edit as ace  # noqa: E402


def _print_json(obj: object) -> None:
    json.dump(obj, sys.stdout, indent=2, sort_keys=True, default=str)
    sys.stdout.write("\n")


def cmd_check(args: argparse.Namespace) -> int:
    errors, effective = ac.check(
        root=Path(args.root) if args.root else None,
        home=Path(args.home) if args.home else None,
    )
    if args.json:
        _print_json({
            "ok": not errors,
            "errors": errors,
            "provenance": None if effective is None else effective.provenance,
        })
    elif errors:
        for err in errors:
            print(err, file=sys.stderr)
        print("ade-config check: FAIL", file=sys.stderr)
    else:
        assert effective is not None
        prov = effective.provenance
        print("ade-config check: OK")
        print(f"  schema_version={effective.data.get('schema_version')}")
        print(f"  routing_source={prov.get('routing_source')}")
        print(f"  gates_source={prov.get('gates_source')}")
        print(f"  local_config={prov.get('local_config')}")
        ginfo = prov.get("gates_info") or {}
        print(f"  gates_info.source={ginfo.get('source')}")
        if ginfo.get("toml_error"):
            print(f"  gates_info.toml_error={ginfo.get('toml_error')}")
    return 1 if errors else 0


def cmd_get(args: argparse.Namespace) -> int:
    try:
        effective = ac.load_effective(
            root=Path(args.root) if args.root else None,
            home=Path(args.home) if args.home else None,
        )
        value = ac.get_path(effective.data, args.path)
    except ac.ConfigError as e:
        print(str(e), file=sys.stderr)
        return 1
    if args.json:
        _print_json({"path": args.path, "value": value})
    else:
        if isinstance(value, (dict, list)):
            _print_json(value)
        else:
            print(value)
    return 0


def cmd_diff(args: argparse.Namespace) -> int:
    try:
        changes = ac.local_diff(
            root=Path(args.root) if args.root else None,
            home=Path(args.home) if args.home else None,
        )
    except ac.ConfigError as e:
        print(str(e), file=sys.stderr)
        return 1
    payload = [{"path": c.path, "before": c.before, "after": c.after} for c in changes]
    if args.json:
        _print_json({"changes": payload})
    elif not payload:
        print("ade-config diff: no local override delta")
    else:
        print(f"ade-config diff: {len(payload)} change(s)")
        for item in payload:
            print(f"  {item['path']}: {item['before']!r} -> {item['after']!r}")
    return 0


def cmd_set(args: argparse.Namespace) -> int:
    try:
        value = ace.parse_cli_value(args.value, as_string=args.string)
        result = ace.set_scalar(
            args.path,
            value,
            target=args.target,
            root=Path(args.root) if args.root else None,
            home=Path(args.home) if args.home else None,
            dry_run=args.dry_run,
        )
    except ac.ConfigError as e:
        print(str(e), file=sys.stderr)
        return 1
    payload = {
        "path": args.path,
        "before": result.before,
        "after": result.after,
        "changed": result.changed,
        "dry_run": result.dry_run,
        "target": result.target.target,
        "kind": result.target.kind,
        "file": str(result.target.path),
        "file_path": ".".join(result.target.file_parts),
        "adoption": result.adoption,
        "adoption_note": result.adoption_note,
    }
    if args.json:
        _print_json(payload)
    else:
        action = "would set" if result.dry_run else ("set" if result.changed else "unchanged")
        print(
            f"ade-config set: {action} {args.path} = {result.after!r} "
            f"(target={result.target.target}, kind={result.target.kind})"
        )
        print(f"  file={result.target.path}")
        print(f"  before={result.before!r}")
        print(f"  adoption={result.adoption}")
        print(f"  note={result.adoption_note}")
    return 0


def cmd_fold(args: argparse.Namespace) -> int:
    root = Path(args.root) if args.root else ac.repo_root_from_here()
    try:
        folded = ac.fold_legacy_domains(root=root)
        text = ac.encode_toml_document(folded)
    except ac.ConfigError as e:
        print(str(e), file=sys.stderr)
        return 1
    path = ac.default_new_config_path(root)
    if args.check:
        if not ac.input_present(path):
            msg = f"{path}: missing (ade-config fold --write to create)"
            if args.json:
                _print_json({"ok": False, "path": str(path), "error": msg})
            else:
                print(msg, file=sys.stderr)
            return 1
        try:
            on_disk = ac.read_toml(path)
        except ac.ConfigError as e:
            print(str(e), file=sys.stderr)
            return 1
        # Compare domain trees (ignore emit-only header / key order).
        if on_disk != folded:
            # Diff paths for a readable failure.
            changes = ac.diff_dicts(folded, on_disk)
            payload = {
                "ok": False,
                "path": str(path),
                "error": "config/ade.toml drifts from fold_legacy_domains",
                "changes": [
                    {"path": c.path, "folded": c.before, "on_disk": c.after}
                    for c in changes
                ],
            }
            if args.json:
                _print_json(payload)
            else:
                print(payload["error"], file=sys.stderr)
                for item in payload["changes"][:20]:
                    print(
                        f"  {item['path']}: folded={item['folded']!r} "
                        f"on_disk={item['on_disk']!r}",
                        file=sys.stderr,
                    )
            return 1
        if args.json:
            _print_json({"ok": True, "path": str(path), "schema_version": folded["schema_version"]})
        else:
            print(f"ade-config fold --check: OK ({path})")
        return 0
    if args.write:
        try:
            written = ac.write_ade_toml(text, root=root, path=path)
        except ac.ConfigError as e:
            print(str(e), file=sys.stderr)
            return 1
        if args.json:
            _print_json({"ok": True, "path": str(written), "schema_version": folded["schema_version"]})
        else:
            print(f"ade-config fold --write: wrote {written}")
        return 0
    if args.json:
        _print_json({"schema_version": folded["schema_version"], "data": folded})
    else:
        sys.stdout.write(text)
    return 0


def main(argv: list[str] | None = None) -> int:
    shared = argparse.ArgumentParser(add_help=False)
    # A subparser parses into its own namespace. Implicit defaults must not
    # overwrite explicit targets already parsed before the subcommand.
    shared.add_argument("--root", default=argparse.SUPPRESS,
                        help="repository root; before/after command, last explicit wins")
    shared.add_argument(
        "--home", default=argparse.SUPPRESS,
        help="HOME for local.toml; before/after command, last explicit wins (default: real home)",
    )
    parser = argparse.ArgumentParser(
        prog="ade-config",
        description="check/get/diff/set for versioned effective ADE config.",
        parents=[shared],
    )
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_check = sub.add_parser(
        "check",
        parents=[shared],
        help="validate effective config (no writes)",
    )
    p_check.add_argument("--json", action="store_true")
    p_check.set_defaults(func=cmd_check)

    p_get = sub.add_parser(
        "get",
        parents=[shared],
        help="print one effective path",
    )
    p_get.add_argument("path", help="dotted path, e.g. lead.fable_lead")
    p_get.add_argument("--json", action="store_true")
    p_get.set_defaults(func=cmd_get)

    p_diff = sub.add_parser(
        "diff",
        parents=[shared],
        help="show local.toml delta vs without local",
    )
    p_diff.add_argument("--json", action="store_true")
    p_diff.set_defaults(func=cmd_diff)

    p_set = sub.add_parser(
        "set",
        parents=[shared],
        help="atomically set one scalar (default --target local; preserves comments)",
    )
    p_set.add_argument("path", help="dotted path, e.g. lead.fable_lead")
    p_set.add_argument("value", help="TOML scalar, or any text with --string")
    p_set.add_argument(
        "--target",
        choices=("local", "repo"),
        default="local",
        help="local (default): ~/.config/djbclark-ade/local.toml; "
             "repo: config/ade.toml if present, else the legacy file for that domain",
    )
    p_set.add_argument(
        "--string",
        action="store_true",
        help="treat VALUE as a string even when it looks like a TOML literal",
    )
    p_set.add_argument(
        "--dry-run",
        action="store_true",
        help="show the planned write without touching the file",
    )
    p_set.add_argument("--json", action="store_true")
    p_set.set_defaults(func=cmd_set)

    p_fold = sub.add_parser(
        "fold",
        parents=[shared],
        help="project legacy domain TOMLs into schema_version=1 ade.toml shape",
    )
    fold_mode = p_fold.add_mutually_exclusive_group()
    fold_mode.add_argument(
        "--write",
        action="store_true",
        help="atomically write config/ade.toml from the legacy fold",
    )
    fold_mode.add_argument(
        "--check",
        action="store_true",
        help="require config/ade.toml and assert it matches fold_legacy_domains",
    )
    p_fold.add_argument("--json", action="store_true")
    p_fold.set_defaults(func=cmd_fold)

    args = parser.parse_args(argv)
    args.root = getattr(args, "root", None)
    args.home = getattr(args, "home", None)
    return int(args.func(args))


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env -S python3 -I
"""wave6-mac-proof-capture: Mac live-cycle proof harness for wave6-delete-check (2026-11-10).

  wave6-mac-proof-capture --out DIR [--live] [--json]

Writes the four non-empty `mac_proofs` files that `bin/wave6-delete-check` expects
(docs/slim/wave6-follow-up.md §B). Idle probes always record `cmd:` plus
`verified: no match` so a successful idle capture is never an empty file.

Modes:
  --live   Run real Mac probes (pgrep / launchctl / acp-dispatch / paseo).
           Refuses on non-Darwin (exit 2) — never invents live Mac stdout.
  default  Print the harness usage and the fixture→live replacement path;
           writes nothing. CI uses tests/fixtures/wave6-mac-proofs/ instead.

After a real Mac live cycle, point evidence.json `mac_proofs` at the files this
tool writes under DIR/proofs/, replacing the checked-in FIXTURE files (which
must not be used as deletion evidence). Queue Carried item 33 residual.

Exit: 0 wrote live proofs / printed help; 2 usage or refused non-Mac --live;
      3 probe write failure. Stdlib only.
"""
from __future__ import annotations

import argparse
import json
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Any, Callable

TOOL = "wave6-mac-proof-capture"

# Filenames match docs/slim/wave6-follow-up.md sample mac_proofs map.
MAC_PROOF_FILES: dict[str, str] = {
    "relay_idle": "mac-b1-relay.txt",
    "acp_run_idle": "mac-b1-acp-run.txt",
    "acp_dispatch_idle": "mac-b2-acp-dispatch.txt",
    "paseo_smoke_ok": "mac-b3-paseo-smoke.txt",
}

FIXTURE_HINT = (
    "tests/fixtures/wave6-mac-proofs/ (FIXTURE — NOT live Mac stdout); "
    "replace those with this harness's --live output before the deletion PR"
)


def die(msg: str, code: int = 2) -> int:
    print(f"{TOOL}: {msg}", file=sys.stderr)
    return code


def _run(argv: list[str], *, timeout: float = 30) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        argv,
        capture_output=True,
        text=True,
        timeout=timeout,
        check=False,
    )


def capture_relay_idle(run: Callable[..., subprocess.CompletedProcess[str]]) -> str:
    lines = [
        "source: wave6-mac-proof-capture --live",
        "flag: relay_idle",
        "cmd: pgrep -lf 'relay\\.py'",
    ]
    r = run(["pgrep", "-lf", r"relay\.py"])
    body = (r.stdout or "").rstrip()
    if body:
        lines.append(body)
        lines.append(f"verified: match listed (exit {r.returncode})")
    else:
        lines.append(f"verified: no match (exit {r.returncode})")
    return "\n".join(lines) + "\n"


def capture_acp_run_idle(run: Callable[..., subprocess.CompletedProcess[str]]) -> str:
    lines = [
        "source: wave6-mac-proof-capture --live",
        "flag: acp_run_idle",
        "cmd: pgrep -lf 'acp-run'; launchctl list | grep -E 'acp-run'",
    ]
    r = run(["pgrep", "-lf", "acp-run"])
    body = (r.stdout or "").rstrip()
    if body:
        lines.append(body)
        lines.append(f"verified: pgrep match listed (exit {r.returncode})")
    else:
        lines.append(f"verified: no match pgrep (exit {r.returncode})")
    # launchctl is Mac-only; keep argv-list form (no shell=True).
    launchctl = shutil.which("launchctl")
    if launchctl is None:
        lines.append("verified: no match launchctl (launchctl not on PATH)")
    else:
        listed = run([launchctl, "list"])
        # Only acp-run for this flag (acp-dispatch has its own proof file).
        matches = [
            ln for ln in (listed.stdout or "").splitlines() if "acp-run" in ln
        ]
        if matches:
            lines.extend(matches)
            lines.append("verified: launchctl match listed")
        else:
            lines.append(
                f"verified: no match launchctl (exit {listed.returncode})"
            )
    return "\n".join(lines) + "\n"


def capture_acp_dispatch_idle(
    run: Callable[..., subprocess.CompletedProcess[str]],
    *,
    home: Path,
) -> str:
    lines = [
        "source: wave6-mac-proof-capture --live",
        "flag: acp_dispatch_idle",
    ]
    state = Path(
        __import__("os").environ.get(
            "ACP_DISPATCH_STATE", str(home / ".local/state/bigteam")
        )
    )
    acp = shutil.which("acp-dispatch")
    if acp is None:
        lines.append("B2: acp-dispatch not on PATH")
    elif not state.is_dir():
        lines.append(f"B2: no state dir at {state} (empty)")
    else:
        lines.append(f"cmd: acp-dispatch check {state}")
        r = run([acp, "check", str(state)])
        out = ((r.stdout or "") + (r.stderr or "")).rstrip()
        if out:
            lines.append(out)
        lines.append(f"verified: acp-dispatch check exit {r.returncode}")
    lines.append("cmd: paseo ls -g --label ade.via=acp-dispatch --json")
    paseo = shutil.which("paseo")
    if paseo is None:
        lines.append("verified: paseo not on PATH")
    else:
        r = run(
            [paseo, "ls", "-g", "--label", "ade.via=acp-dispatch", "--json"]
        )
        out = ((r.stdout or "") + (r.stderr or "")).rstrip()
        if out:
            lines.append(out)
            lines.append(f"verified: paseo ls exit {r.returncode}")
        else:
            lines.append("verified: no match (empty paseo ls)")
    return "\n".join(lines) + "\n"


def capture_paseo_smoke(run: Callable[..., subprocess.CompletedProcess[str]]) -> str:
    lines = [
        "source: wave6-mac-proof-capture --live",
        "flag: paseo_smoke_ok",
        "cmd: paseo send --help; paseo run --help",
    ]
    paseo = shutil.which("paseo")
    if paseo is None:
        lines.append("verified: FAILED (paseo not on PATH)")
        return "\n".join(lines) + "\n"
    r1 = run([paseo, "send", "--help"])
    r2 = run([paseo, "run", "--help"])
    if r1.returncode == 0 and r2.returncode == 0:
        lines.append("verified: paseo send/run --help ok (exit 0)")
    else:
        lines.append(
            f"verified: FAILED (send exit {r1.returncode}, run exit {r2.returncode})"
        )
    return "\n".join(lines) + "\n"


def write_live_proofs(
    out: Path,
    *,
    run: Callable[..., subprocess.CompletedProcess[str]] = _run,
    home: Path | None = None,
) -> dict[str, str]:
    """Write the four mac proof files under out/proofs/; return relative mac_proofs map."""
    proofs = out / "proofs"
    proofs.mkdir(parents=True, exist_ok=True)
    home = home or Path.home()
    bodies = {
        "relay_idle": capture_relay_idle(run),
        "acp_run_idle": capture_acp_run_idle(run),
        "acp_dispatch_idle": capture_acp_dispatch_idle(run, home=home),
        "paseo_smoke_ok": capture_paseo_smoke(run),
    }
    rel_map: dict[str, str] = {}
    for flag, body in bodies.items():
        name = MAC_PROOF_FILES[flag]
        path = proofs / name
        tmp = path.with_suffix(path.suffix + ".tmp")
        tmp.write_text(body, encoding="utf-8")
        tmp.replace(path)
        if path.stat().st_size == 0:
            raise OSError(f"refusing empty proof write: {path}")
        rel_map[flag] = f"proofs/{name}"
    return rel_map


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(
        prog=TOOL,
        description=__doc__.split("\n\n")[0],
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            f"Fixture stand-ins (CI only): {FIXTURE_HINT}\n"
            "Live Mac captures replace fixtures; never commit invented Mac stdout."
        ),
    )
    p.add_argument(
        "--out",
        type=Path,
        default=None,
        help="evidence directory (writes proofs/ + prints mac_proofs map)",
    )
    p.add_argument(
        "--live",
        action="store_true",
        help="run real Mac probes (Darwin only; refuses elsewhere)",
    )
    p.add_argument("--json", action="store_true", help="print mac_proofs map as JSON")
    args = p.parse_args(argv)

    if not args.live:
        print(
            f"{TOOL}: pass --live --out DIR on the Mac to capture B1/B2/B3 proofs.\n"
            f"  CI fixtures: {FIXTURE_HINT}\n"
            "  Docs: docs/slim/wave6-follow-up.md §B (fixture → live replacement).\n"
            "  Gate: bin/wave6-delete-check --evidence <evidence.json>",
            file=sys.stderr,
        )
        return 0 if args.out is None else die(
            "--out requires --live (refusing to invent Mac stdout as live proof)"
        )

    if sys.platform != "darwin":
        return die(
            f"--live refused on platform {sys.platform!r}; "
            "run on the Mac, or use the labeled FIXTURE bundle under "
            "tests/fixtures/wave6-mac-proofs/ for CI shape only"
        )

    if args.out is None:
        return die("--live requires --out DIR")

    try:
        out = args.out.resolve()
        out.mkdir(parents=True, exist_ok=True)
        rel_map = write_live_proofs(out)
    except OSError as exc:
        return die(f"write failed: {exc}", code=3)

    payload: dict[str, Any] = {
        "tool": TOOL,
        "mode": "live",
        "out": str(out),
        "mac_proofs": rel_map,
        "note": "Paste paths into evidence.json mac_proofs; replace FIXTURE files.",
    }
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        print(f"{TOOL}: wrote live mac_proofs under {out / 'proofs'}")
        for flag, rel in rel_map.items():
            print(f"  {flag}: {rel}")
        print(
            "Next: set evidence.json mac_proofs to these paths, then "
            "bin/wave6-delete-check --evidence <json>"
        )
    return 0


if __name__ == "__main__":
    sys.exit(main())

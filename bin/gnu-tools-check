#!/usr/bin/env -S python3 -I
"""gnu-tools-check: find macOS shell code that calls a BSD tool where the GNU one is wanted.

Usage: gnu-tools-check [--exclude GLOB]... [PATH...]   (default PATH: .)

Scans shell code only (*.sh, *.bash, *.zsh, *.sh.j2, justfiles, *.just, and files
with a sh/bash/zsh shebang) and reports, at command position:

  1. a bare name of a tool whose BSD and GNU versions differ in ways we have hit
     (sed, awk, grep, tr, date, stat, ...): use the g-prefixed name;
  2. a GNU-only long option (--foo) on a basic tool macOS provides as BSD
     (cp, ln, ls, rm, mkdir, ...): use the g-prefixed name for that call.

Identical basics (cat, mkdir -p, rm -f, sleep N, ...) may stay bare, and so may the
GNU-only tools Homebrew links unprefixed (timeout, nproc, tac, shuf, numfmt).

Code that runs off this Mac or must stay portable keeps bare names. Skip such a
file with "gnu-tools-check: portable" in its first 20 lines, an --exclude glob, or
a .gnu-tools-check-ignore file (one glob per line, relative to that root, #
comments) at a scanned root. Skip one line with "gnu-tools-check: ignore" on it.
Single-quoted text, heredoc bodies and double-quoted text (except $(...) inside
it) are not scanned: there they are remote commands, programs or messages.

Exit 0 clean, 1 findings, 2 usage error.
"""

import argparse
import fnmatch
import os
import re
import subprocess
import sys
from pathlib import Path

# BSD and GNU differ for these in ways that have bitten us (flags, regex dialect, -i).
DIFFER = (
    "awk base64 cut date du find grep head mktemp readlink realpath sed seq sort "
    "split stat tail tar tee touch tr uniq wc xargs"
).split()
# macOS ships these as BSD; GNU long options on them fail there.
BSD_BASICS = "cat chmod chown cp df env id install ln ls mkdir mv rm rmdir sleep uname".split()

DEFAULT_EXCLUDES = [
    "*/.git/*", "*/node_modules/*", "*/graft/*", "*/vendor/*", "*/.venv/*",
    "*/termux/*", "*/android/*", "*/.github/*", "*/.forgejo/*", "*/Dockerfile*",
    "*/gradlew",
]
IGNORE_FILE = ".gnu-tools-check-ignore"
PORTABLE = "gnu-tools-check: portable"
IGNORE_LINE = "gnu-tools-check: ignore"

# Command position: line start, after a pipe/separator/subshell, or after a word
# that runs its argument as a command.
_LEAD = r"(?:^|[|;&(`{]|\$\(|\b(?:then|do|else|exec|command|xargs|nohup|sudo|time)\s)\s*"
_DIFFER_RE = re.compile(_LEAD + r"(" + "|".join(sorted(DIFFER, key=len, reverse=True)) + r")(?=[\s;)|&]|$)")
_BASIC_RE = re.compile(_LEAD + r"(" + "|".join(sorted(BSD_BASICS, key=len, reverse=True)) + r")\s+([^|;&)]*)")
_LONG_OPT = re.compile(r"(?:^|\s)(--[a-z][\w-]*)")
_SHEBANG = re.compile(rb"^#!.*\b(?:ba|z)?sh\b")


def is_shell(path: Path) -> bool:
    name = path.name
    if name.endswith((".sh", ".bash", ".zsh", ".sh.j2", ".just")) or name in ("justfile", "Justfile"):
        return True
    try:
        with path.open("rb") as fh:
            return bool(_SHEBANG.match(fh.read(128)))
    except OSError:
        return False


def excluded(path: str, globs) -> bool:
    return any(fnmatch.fnmatch(path, g) or fnmatch.fnmatch("/" + path, g) for g in globs)


_HEREDOC = re.compile(r"<<-?\s*(['\"]?)([A-Za-z_]\w*)\1")


def code_lines(text: str):
    """The text's lines with quoted text, comments and heredoc bodies blanked.

    Single-quoted text is never code here: it is a remote command, a jq/awk
    program or a message. Double-quoted text is blanked except for $(...) and
    `...` inside it, which run locally.
    """
    out, cur = [], []
    stack = ["code"]  # code | sq | dq | sub | bt
    heredocs = []
    i, n = 0, len(text)
    line_start = 0
    at_word_start = True
    while i < n:
        c = text[i]
        if c == "\n":
            line = "".join(cur)
            out.append(line)
            cur = []
            raw = text[line_start:i]
            for m in _HEREDOC.finditer(raw):
                if line[m.start():m.start() + 2] == "<<" and not raw.startswith("<<<", m.start()) and (
                    m.start() == 0 or raw[m.start() - 1] != "<"
                ):
                    heredocs.append(m.group(2))
            i += 1
            at_word_start = True
            while heredocs and i < n:
                end = text.find("\n", i)
                end = n if end < 0 else end
                out.append("")
                if text[i:end].strip() == heredocs[0]:
                    heredocs.pop(0)
                i = end + 1
            line_start = i
            continue
        top = stack[-1]
        if top == "sq":
            if c == "'":
                stack.pop()
            cur.append(" ")
        elif top == "dq":
            if c == "\\" and i + 1 < n and text[i + 1] != "\n":
                cur.append("  ")
                i += 1
            elif c == '"':
                stack.pop()
                cur.append(" ")
            elif text.startswith("$(", i) and not text.startswith("$((", i):
                stack.append("sub")
                cur.append("$(")
                i += 1
                at_word_start = True
            elif c == "`":
                stack.append("bt")
                cur.append("`")
                at_word_start = True
            else:
                cur.append(" ")
        else:  # code, sub, bt
            if c == "#" and at_word_start:
                j = text.find("\n", i)
                j = n if j < 0 else j
                cur.append(" " * (j - i))
                i = j
                continue
            if c == "\\" and i + 1 < n and text[i + 1] != "\n":
                cur.append("  ")
                i += 2
                at_word_start = False
                continue
            if c == "'":
                stack.append("sq")
                cur.append(" ")
            elif c == '"':
                stack.append("dq")
                cur.append(" ")
            elif c == "`" and top == "bt":
                stack.pop()
                cur.append("`")
            elif c == "`":
                stack.append("bt")
                cur.append("`")
            elif c == "(":
                stack.append("sub")
                cur.append(c)
            elif c == ")" and top == "sub":
                stack.pop()
                cur.append(c)
            else:
                cur.append(c)
            at_word_start = c in " \t;|&(){}`"
        i += 1
    out.append("".join(cur))
    return out


def scan_text(text: str):
    """Yield (line_no, tool, message) for one file's text."""
    raw = text.splitlines()
    if any(PORTABLE in ln for ln in raw[:20]):
        return
    for no, line in enumerate(code_lines(text), 1):
        s = line.strip()
        if not s or (no <= len(raw) and IGNORE_LINE in raw[no - 1]):
            continue
        for m in _DIFFER_RE.finditer(s):
            tool = m.group(1)
            yield no, tool, f"bare {tool} is BSD on macOS: use g{tool}"
        for m in _BASIC_RE.finditer(s):
            tool = m.group(1)
            for word in m.group(2).split():
                if word == "--" or not word.startswith("-"):
                    break
                if _LONG_OPT.match(word):
                    yield no, tool, f"{tool} {word.split('=')[0]} is GNU-only: use g{tool}"
                    break


def git_files(root: Path):
    """Tracked and untracked-but-not-ignored files under root, or None outside git."""
    try:
        r = subprocess.run(
            ["git", "-C", str(root), "ls-files", "-z", "-co", "--exclude-standard"],
            capture_output=True, check=True,
        )
    except (OSError, subprocess.CalledProcessError):
        return None
    return [root / p for p in r.stdout.decode(errors="replace").split("\0") if p]


def iter_files(root: Path, globs):
    if root.is_file():
        yield root
        return
    listed = git_files(root)
    if listed is not None:
        for p in listed:
            if p.is_file() and not p.is_symlink() and not excluded(str(p), globs):
                yield p
        return
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if not excluded(os.path.join(dirpath, d) + "/", globs)]
        for f in filenames:
            p = Path(dirpath, f)
            if not excluded(str(p), globs) and not p.is_symlink():
                yield p


def load_ignore(root: Path):
    f = (root if root.is_dir() else root.parent) / IGNORE_FILE
    if not f.is_file():
        return []
    out = []
    for ln in f.read_text().splitlines():
        ln = ln.strip()
        if ln and not ln.startswith("#"):
            out.append(str((f.parent / ln)) if not ln.startswith("*") else ln)
    return out


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("paths", nargs="*", default=["."])
    ap.add_argument("--exclude", action="append", default=[], metavar="GLOB")
    args = ap.parse_args(argv)
    findings = 0
    for raw in args.paths:
        root = Path(raw).expanduser()
        if not root.exists():
            print(f"gnu-tools-check: no such path: {raw}", file=sys.stderr)
            return 2
        globs = DEFAULT_EXCLUDES + args.exclude + load_ignore(root)
        for path in iter_files(root, globs):
            if not is_shell(path):
                continue
            try:
                text = path.read_text(errors="replace")
            except OSError:
                continue
            for no, _tool, msg in scan_text(text):
                print(f"{path}:{no}: {msg}")
                findings += 1
    return 1 if findings else 0


if __name__ == "__main__":
    sys.exit(main())

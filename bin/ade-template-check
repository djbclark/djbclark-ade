#!/usr/bin/env python3
"""Check the agents/ config templates (Phase 0 item 4.4, 2026-10-20).

    ade-template-check [--diff] [--root DIR] [TEMPLATE ...]

With no TEMPLATE it checks every agents/*/*.tmpl under the repo (or --root). For each one:

  1. scan: the credential patterns of the inventory adversary (docs/ade-everywhere-inventory-2026-10-20-stores.md
     section 5 item 5) run over the template text with the `{{ ... }}` tags masked; any hit is a finding.
     Also flagged: an absolute home path (/Users/<name>, /home/<name>) that is not `{{ .home }}`, and a
     long numeric id (account, chat, Telegram or Discord id).
     Credential shapes (2026-10-20, adversary round 2): an Authorization header with any scheme or none, a
     Discord bot token or any `.`-joined key, key names ending in `_KEY`/`_SECRET`/`_TOKEN`/`_PASSWORD`, a
     `--token`/`--api-key`/`--password`/`--secret` argument and its value, and `?key=`/`&token=` URL parameters.
  2. render: `{{ .field }}` and `{{ secret "NAME" }}` are filled from a dummy context and the result must parse
     (.json, .toml or .yaml by the name before `.tmpl`). Every field used must be documented in
     agents/README.md (a table row starting with the field in backticks).
     The render runs twice: with plain dummies, and with a hostile value (quotes, `: `, `#`, backslash) in every
     placeholder but the home ones, escaped the way Phase 1's renderer must (JSON and TOML: `toJson` inside
     "..."; YAML: `'` doubled inside '...'); each parsed string must equal the hostile value. A placeholder that
     is not inside a quoted scalar therefore fails.
  3. --diff: render with `{{ .home }}` = $HOME, every other placeholder a wildcard, and print the key paths
     whose live file (the same path under $HOME, listed in LIVE below) differs. Paths only, never values, but a
     key path can hold a home path or a session id (Codex's `hooks.state.*` and `/private/tmp` keys): keep
     --diff output out of a public log or pull request.

Exit 0 clean, 1 findings, 2 usage. YAML needs PyYAML (`uv run --with pyyaml`); without it a .yaml template
is reported as a finding rather than skipped.
"""
from __future__ import annotations

import argparse
import json
import math
import os
import re
import sys
import tomllib
from collections import Counter
from hashlib import sha256
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent

# Template (relative to agents/) -> the live file it describes (relative to $HOME).
LIVE = {
    "claude/settings.json.tmpl": ".claude/settings.json",
    "codex/config.toml.tmpl": ".codex/config.toml",
    "opencode/opencode.json.tmpl": ".config/opencode/opencode.json",
    "hermes/config.yaml.tmpl": ".hermes/config.yaml",
}

TAG = re.compile(r"\{\{\s*(?:(?P<secret>secret\s+\"(?P<name>[A-Za-z0-9_]+)\")|(?P<field>\.[A-Za-z_][A-Za-z0-9_]*))\s*\}\}")
ANY_TAG = re.compile(r"\{\{.*?\}\}")
MASK = "\x00TAG\x00"

# Known benign blobs matching the 32+ character rule, by sha256 of the matched text. The one entry is the
# Orca PowerShell hook in claude/settings.json: a UTF-16LE -EncodedCommand that only runs ~/.orca/agent-hooks
# (decoded and read 2026-10-20). Orca rewrites it on upgrade; a new blob is a finding until someone decodes it.
ALLOW_BLOBS = {
    "1716558189baf6eacd0b1429e2b78470c5044658b54110f1d02e796e8c56c4f8": "Orca claude-hook PowerShell -EncodedCommand",
}

# A placeholder tag (masked) must be the whole value: `{{ secret "X" }}<leaked tail>` is a hit.
_MASKED = re.escape(MASK) + r"""(?:["'\s,\]]|$)"""
_ENVREF = r"""\$\{?[A-Za-z_]\w*\}?(?:["'\s,\]]|$)"""
# Key names that hold a credential, in JSON ("x-api-key": "v"), YAML (token: v) and TOML (token = "v") forms.
_KEYNAME = (r"""(?<![A-Za-z0-9])["']?(?:(?:x-)?api[-_]?key|apikey|(?:auth|access|refresh|bot)?[-_]?token|secret|"""
            r"""client[-_]?secret|private[-_]?key|credential|passw(?:or)?d\w*|\w*[-_](?:key|secret|token|password))["']?""")
# An Authorization (or Proxy-Authorization) header with any scheme or none: the possessive group eats one scheme
# word (`Bearer`, `Basic`, `Token`, `Bot`, ...) so `Bearer {{ secret "X" }}` and `Basic ${X}` stay clean while
# `Basic <base64>` and a bare value do not. `\\?["']` lets it match inside an escaped JSON string in a command.
_AUTH = (r"""(?<![A-Za-z0-9])(?:proxy-)?authorization\\?["']?\s*[:=]\s*\\?["']?(?:[A-Za-z][\w-]*[ \t]+)?+"""
         + r"""(?!""" + _MASKED + r"""|""" + _ENVREF + r"""|%|\\?["']|\s|$|<)[^\s"',\\]{4,}""")
# A credential-named flag followed by its value: `["--token", "v"]`, `- --token` / `- v` on two lines, `--api-key v`.
# `--password-file` and `--max-tokens` are not matched: the flag name must be followed by `,`, `"` or whitespace.
_FLAG = r"""--(?:\w+-)*(?:token|api-?key|secret|password|passwd)"""
ARGV = re.compile(r"""(?<![\w-])""" + _FLAG + r"""["']?\s*(?:,|\s)\s*(?:-\s+)?["']?(?!""" + _MASKED + r"""|""" + _ENVREF
         + r"""|%|-|\s|<)[^\s"',\]]{4,}""", re.I)
# A query parameter that carries a credential, in a URL.
_QUERY = (r"""[?&](?:key|api[-_]?key|apikey|sig|signature|(?:access|auth|refresh)[-_]token|token|client[-_]secret|secret|"""
          r"""password|passwd)=(?!""" + _MASKED + r"""|""" + _ENVREF + r"""|%|<)[^\s&"']+""")

PATTERNS: list[tuple[str, re.Pattern[str]]] = [
    ("sk- key", re.compile(r"(?<![A-Za-z0-9])sk-[A-Za-z0-9_-]{6,}")),
    ("xai- key", re.compile(r"(?<![A-Za-z0-9])xai-[A-Za-z0-9_-]{16,}")),
    ("GitHub gh?_ token", re.compile(r"(?<![A-Za-z0-9])gh[pousr]_[A-Za-z0-9]{6,}")),
    ("github_pat_ token", re.compile(r"github_pat_[A-Za-z0-9_]{6,}")),
    ("GitLab glpat- token", re.compile(r"glpat-[A-Za-z0-9_-]{16,}")),
    ("Google AIza key", re.compile(r"AIza[A-Za-z0-9_-]{30,}")),
    ("Telegram bot token", re.compile(r"(?<![\w.])\d{8,10}:[A-Za-z0-9_-]{30,}")),
    ("Slack token", re.compile(r"xox[bpas]-[A-Za-z0-9-]{6,}")),
    ("AWS key id", re.compile(r"AKIA[0-9A-Z]{8,}")),
    ("Bearer value", re.compile(r"Bearer\s+(?!" + _MASKED + r"|" + _ENVREF + r"|%s|<)\S{4,}")),
    ("Discord bot token", re.compile(r"[A-Za-z0-9_-]{23,28}\.[A-Za-z0-9_-]{6,7}\.[A-Za-z0-9_-]{27,38}")),
    ("Authorization header", re.compile(_AUTH, re.I)),
    ("credential in a URL query", re.compile(_QUERY, re.I)),
    ("PEM block", re.compile(r"-----BEGIN")),
    ("password=", re.compile(r"password=\S+", re.I)),
    ("api_key=", re.compile(r"api_key=\S+", re.I)),
    ("token=", re.compile(r"(?<![A-Za-z_])token=(?!" + _MASKED + r"|" + _ENVREF + r")\S+", re.I)),
    ("secret-looking key: value", re.compile(
        _KEYNAME + r"""\s*[:=]\s*["']?(?!""" + _MASKED + r"""|""" + _ENVREF + r"""|%|["']|\s|$|<)[^\s"',]{4,}""", re.I)),
    ("email address", re.compile(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)+")),
    ("phone number", re.compile(r"(?<![\w.])\+\d[\d\s().-]{6,16}\d(?!\d)")),
    ("UUID", re.compile(r"\b[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\b", re.I)),
    ("long numeric id", re.compile(r"(?<![\w.])\d{10,}(?![\w.])")),
    ("literal home path", re.compile(r"(?:/Users|/home)/(?!\{\{)[A-Za-z0-9._-]+|\\/Users\\/[A-Za-z0-9._-]+")),
]
BLOB = re.compile(r"[A-Za-z0-9+/=_-]{32,}")
# `.`-joined runs of pieces of 6 or more (a Discord bot token, a JWT): scored as one blob as well as piece by piece
DOTTED = re.compile(r"[A-Za-z0-9+/=_-]{6,}(?:\.[A-Za-z0-9+/=_-]{6,})+")
SEGMENT_MIN = 20  # a path segment this long is tested as a key on its own


def _entropy(s: str) -> float:
    c = Counter(s)
    return -sum(n / len(s) * math.log2(n / len(s)) for n in c.values())


_WORD_PART = re.compile(r"[A-Za-z]*(?:\d{1,4}[A-Za-z]*)?")


def _cased_like_a_word(part: str) -> bool:
    """No lowercase (UPPER_SNAKE), or capitals are at most a third of the letters (camelCase, Pascal): random
    letters are about half capitals."""
    letters = re.sub(r"[^A-Za-z]", "", part)
    upper = sum(c.isupper() for c in letters)
    return upper == len(letters) or upper <= len(letters) / 3


def _word_run(s: str) -> bool:
    """Words, camelCase, UPPER_SNAKE, dashes and `/` with at most one short digit run in each part and three in
    all (`SHA256S`, `2026-07-18`, `python3`): an identifier or a path, not a key. Base64's `+` and `=` are not
    word characters, a random key puts about six digit runs in 43 characters and its letters are half capitals."""
    parts = re.split(r"[/_-]", s)
    return (len(re.findall(r"\d+", s)) <= 3
            and all(_WORD_PART.fullmatch(part) and _cased_like_a_word(part) for part in parts))


def _key_like(s: str) -> bool:
    """Hex of 32 or more; else a letter and a digit with entropy above 3.5 bits that is not a word run. A key of
    letters only (one random 40-character string in a thousand) is not caught here; the key-name rules and the
    prefixes catch most of those."""
    if re.fullmatch(r"[0-9a-fA-F]{32,}", s):
        return True
    if not (re.search(r"[0-9]", s) and re.search(r"[A-Za-z]", s)):
        return False
    return _entropy(s) > 3.5 and not _word_run(s)


def _blob_is_key(blob: str) -> bool:
    """A blob is tested whole and, when it has `/`, segment by segment (SEGMENT_MIN or more characters each), so a
    real path passes but a base64 key does not, whether or not its `/` cut it into short pieces."""
    if _key_like(blob):
        return True
    return "/" in blob and any(len(seg) >= SEGMENT_MIN and _key_like(seg) for seg in blob.split("/"))


def _dotted_is_key(run: str) -> bool:
    """A dotted run of 32 or more characters (dots not counted) that scores as a key whole: with the dots as
    word breaks (so a dotted identifier is a word run) or removed (a dotted hex string)."""
    if len(run.replace(".", "")) < 32:
        return False
    return _blob_is_key(run.replace(".", "_")) or _key_like(run.replace(".", ""))


def scan(text: str) -> list[tuple[int, str]]:
    """(line number, rule) for every credential-looking token; never the value itself."""
    masked = ANY_TAG.sub(MASK, text)
    hits: list[tuple[int, str]] = []
    # the flag and its value may sit on two lines (a YAML list, a multi-line TOML array), so this one runs on the text
    hits.extend((masked.count("\n", 0, m.start()) + 1, "credential flag argument") for m in ARGV.finditer(masked))
    for lineno, line in enumerate(masked.splitlines(), 1):
        for rule, pat in PATTERNS:
            if pat.search(line):
                hits.append((lineno, rule))
        for m in DOTTED.finditer(line):
            if _dotted_is_key(m.group(0)):
                hits.append((lineno, "dot-joined token"))
        for m in BLOB.finditer(line):
            blob = m.group(0)
            if sha256(blob.encode()).hexdigest() in ALLOW_BLOBS:
                continue
            if _blob_is_key(blob):
                hits.append((lineno, "32+ character hex string" if re.fullmatch(r"[0-9a-fA-F]+", blob)
                             else "32+ character base64-like string"))
    return hits


def fields_used(text: str) -> tuple[set[str], set[str]]:
    fields, secrets = set(), set()
    for m in TAG.finditer(text):
        if m.group("secret"):
            secrets.add(m.group("name"))
        else:
            fields.add(m.group("field")[1:])
    if "{{" in TAG.sub("", text):
        raise ValueError("a {{ ... }} tag other than `.field` or `secret \"NAME\"`")
    return fields, secrets


def render(text: str, ctx: dict[str, str], secret_value: str) -> str:
    def fill(m: re.Match[str]) -> str:
        if m.group("secret"):
            return secret_value
        return ctx[m.group("field")[1:]]
    return TAG.sub(fill, text)


def parse(kind: str, text: str):
    if kind == "json":
        return json.loads(text)
    if kind == "toml":
        return tomllib.loads(text)
    if kind == "yaml":
        try:
            import yaml
        except ImportError:
            raise RuntimeError("PyYAML is not importable (run with `uv run --with pyyaml`)") from None
        return yaml.safe_load(text)
    raise ValueError(kind)


HOSTILE = "a'b\"c: #d\\e"  # quote, double quote, `: `, `#` and a backslash: each breaks a naive insertion


def escape_for(kind: str, value: str) -> str:
    """What Phase 1's renderer must do to a value before it goes inside a quoted scalar of this format:
    JSON and TOML basic strings take JSON escapes (no DEL; TOML also forbids it), YAML single quotes double `'`."""
    if kind in ("json", "toml"):
        return json.dumps(value, ensure_ascii=False)[1:-1]
    return value.replace("'", "''")


def hostile_roundtrip(kind: str, text: str, fields: set[str], secrets: set[str]) -> bool:
    """Render with plain dummies and with hostile escaped values; every string leaf of the first, with each dummy
    replaced by its hostile value, must be the same leaf in the second."""
    plain = {f: f"dummy-{f}" for f in fields}
    hostile = {f: f"{HOSTILE}-{f}" for f in fields}
    fixed = {"home": "/home/dummy", "home_escaped": "\\/home\\/dummy"}
    plain.update(fixed)
    hostile.update(fixed)
    base = flatten(parse(kind, render(text, plain, "dummy-secret-value")))
    ctx = {k: (v if k in fixed else escape_for(kind, v)) for k, v in hostile.items()}
    got = flatten(parse(kind, render(text, ctx, escape_for(kind, f"{HOSTILE}-secret"))))
    swaps = sorted(((plain[f], hostile[f]) for f in fields if f not in fixed), key=lambda t: -len(t[0]))
    swaps.append(("dummy-secret-value", f"{HOSTILE}-secret"))

    def expect(v):
        if isinstance(v, str):
            for a, b in swaps:
                v = v.replace(a, b)
        return v
    return set(base) == set(got) and all(expect(base[k]) == got[k] for k in base)


def kind_of(path: Path) -> str:
    ext = path.name.removesuffix(".tmpl").rsplit(".", 1)[-1]
    return {"json": "json", "jsonc": "json", "toml": "toml", "yaml": "yaml", "yml": "yaml"}.get(ext, ext)


def documented_fields(readme: Path) -> set[str]:
    if not readme.is_file():
        return set()
    return set(re.findall(r"^\|\s*`([A-Za-z_][A-Za-z0-9_]*)`\s*\|", readme.read_text(), re.M))


def flatten(o, prefix: str = "") -> dict[str, object]:
    out: dict[str, object] = {}
    if isinstance(o, dict):
        for k, v in o.items():
            out.update(flatten(v, f"{prefix}.{k}" if prefix else str(k)))
        if not o and prefix:
            out[prefix] = {}
    elif isinstance(o, list):
        for i, v in enumerate(o):
            out.update(flatten(v, f"{prefix}[{i}]"))
        if not o and prefix:
            out[prefix] = []
    else:
        out[prefix] = o
    return out


WILD = ""


def diff_keys(tmpl_text: str, live_text: str, kind: str, home: str) -> tuple[list[str], list[str], list[str]]:
    """(only in template, only in live file, value differs): key paths only."""
    def fill(m: re.Match[str]) -> str:
        if m.group("field") == ".home":
            return home
        if m.group("field") == ".home_escaped":
            return home.replace("/", "\\/")
        return WILD
    rendered = TAG.sub(fill, tmpl_text)
    # A wildcard inside a quoted scalar is a plain character for every parser.
    t = flatten(parse(kind, rendered))
    live = flatten(parse(kind, live_text))
    only_t = sorted(set(t) - set(live))
    only_l = sorted(set(live) - set(t))
    differs = []
    for k in sorted(set(t) & set(live)):
        tv, lv = t[k], live[k]
        if isinstance(tv, str) and WILD in tv:
            rx = re.compile("".join(".*" if ch == WILD else re.escape(ch) for ch in tv), re.S)
            if isinstance(lv, str) and rx.fullmatch(lv):
                continue
            differs.append(k)
        elif tv != lv or type(tv) is not type(lv):
            differs.append(k)
    return only_t, only_l, differs


def check_one(path: Path, root: Path, do_diff: bool, out) -> int:
    rel = path.name
    text = path.read_text()
    findings = 0
    try:
        label = str(path.relative_to(root))
    except ValueError:
        label = str(path)

    for lineno, rule in scan(text):
        print(f"{label}:{lineno}: credential scan: {rule}", file=out)
        findings += 1

    kind = kind_of(path)
    try:
        fields, secrets = fields_used(text)
    except ValueError as e:
        print(f"{label}: {e}", file=out)
        return findings + 1
    doc = documented_fields(root / "agents" / "README.md")
    for f in sorted(fields - doc):
        print(f"{label}: field `{f}` is not in the agents/README.md table", file=out)
        findings += 1
    for s in sorted(secrets - doc):
        print(f"{label}: secret `{s}` is not in the agents/README.md table", file=out)
        findings += 1

    ctx = {f: f"dummy-{f}" for f in fields}
    ctx.update({"home": "/home/dummy", "home_escaped": "\\/home\\/dummy"})
    try:
        parse(kind, render(text, ctx, "dummy-secret-value"))
    except Exception as e:  # noqa: BLE001 - any parser error is a finding; its message names a position, not a value
        print(f"{label}: rendered output does not parse as {kind}: {type(e).__name__}", file=out)
        findings += 1
    else:
        try:
            ok = hostile_roundtrip(kind, text, fields, secrets)
        except Exception as e:  # noqa: BLE001
            print(f"{label}: rendered with hostile values does not parse as {kind}: {type(e).__name__} "
                  f"(a placeholder is not inside a quoted scalar)", file=out)
            findings += 1
        else:
            if not ok:
                print(f"{label}: a hostile value does not round-trip through {kind} (a placeholder changes the structure "
                      f"or is not inside a quoted scalar)", file=out)
                findings += 1

    if do_diff:
        try:
            rel_t = str(path.relative_to(root / "agents"))
        except ValueError:
            rel_t = ""
        live_rel = LIVE.get(rel_t)
        live = Path(os.environ.get("HOME", str(Path.home()))) / live_rel if live_rel else None
        if live is None or not live.is_file():
            print(f"{label}: --diff: no live file to compare", file=out)
        else:
            try:
                only_t, only_l, differs = diff_keys(text, live.read_text(), kind, os.environ.get("HOME", str(Path.home())))
            except Exception as e:  # noqa: BLE001
                print(f"{label}: --diff: cannot compare ({type(e).__name__})", file=out)
                findings += 1
            else:
                for k in only_t:
                    print(f"{label}: diff: only in template: {k}", file=out)
                for k in only_l:
                    print(f"{label}: diff: only in live file: {k}", file=out)
                for k in differs:
                    print(f"{label}: diff: differs: {k}", file=out)
                print(f"{label}: diff: {len(only_t)} only in template, {len(only_l)} only in live, {len(differs)} differ", file=out)
    return findings


def main(argv: list[str] | None = None, out=None) -> int:
    out = out or sys.stdout
    ap = argparse.ArgumentParser(prog="ade-template-check", description=__doc__.split("\n")[0])
    ap.add_argument("templates", nargs="*", type=Path)
    ap.add_argument("--diff", action="store_true", help="also compare each rendered template with the live file (key paths only)")
    ap.add_argument("--root", type=Path, default=REPO, help="repo root holding agents/ (default: this repo)")
    args = ap.parse_args(argv)
    root = args.root.resolve()
    paths = args.templates or sorted((root / "agents").glob("*/*.tmpl"))
    if not paths:
        print(f"ade-template-check: no templates under {root}/agents", file=sys.stderr)
        return 2
    total = 0
    for p in paths:
        if not p.is_file():
            print(f"ade-template-check: {p}: not a file", file=sys.stderr)
            return 2
        total += check_one(p.resolve(), root, args.diff, out)
    print(f"ade-template-check: {len(paths)} template(s), {total} finding(s)", file=out)
    return 1 if total else 0


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""Provision the broker's runtime credential from sudo-secretspec's environment.

Never rotates a different existing credential. Values travel only through stdin.
"""

import fcntl
import inspect
import json
import os
from pathlib import Path
import re
import shlex
import stat
import subprocess
import sys
import tempfile


def install_credential(path, payload):
    if (
        not isinstance(payload, dict)
        or set(payload) != {"authorization"}
        or not isinstance(payload["authorization"], dict)
        or set(payload["authorization"]) != {"token"}
        or not isinstance(payload["authorization"]["token"], str)
        or not re.fullmatch(r"[A-Za-z0-9_-]{32,}", payload["authorization"]["token"])
    ):
        raise ValueError("invalid credential shape")
    path = Path(path)
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    directory = path.parent.lstat()
    if (
        not stat.S_ISDIR(directory.st_mode)
        or directory.st_uid != os.geteuid()
        or directory.st_mode & 0o022
    ):
        raise ValueError("unsafe credential directory")
    fd = os.open(
        path.parent / ".ade-nats-auth.lock",
        os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW,
        0o600,
    )
    temporary = None
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        if path.exists() or path.is_symlink():
            metadata = path.lstat()
            if (
                not stat.S_ISREG(metadata.st_mode)
                or metadata.st_uid != os.geteuid()
                or stat.S_IMODE(metadata.st_mode) != 0o400
                or json.loads(path.read_text()) != payload
            ):
                raise ValueError(
                    "existing credential differs or is unsafe; rotation requires explicit decision"
                )
            return False
        handle, name = tempfile.mkstemp(prefix=".ade-nats-auth-", dir=path.parent)
        temporary = Path(name)
        with os.fdopen(handle, "w") as output:
            os.fchmod(output.fileno(), 0o400)
            json.dump(payload, output, sort_keys=True)
            output.flush()
            os.fsync(output.fileno())
        # Atomic publication without replacing an unexpected concurrently-created file.
        os.link(temporary, path)
        temporary.unlink()
        temporary = None
        parent = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(parent)
        finally:
            os.close(parent)
        return True
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)
        os.close(fd)


def main():
    import argparse

    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--ssh-host", required=True)
    args = parser.parse_args()
    token = os.environ.get("ADE_NATS_TOKEN", "")
    if not re.fullmatch(r"[A-Za-z0-9_.-]+", args.ssh_host) or args.ssh_host.startswith(
        "-"
    ):
        raise ValueError("SSH alias required")
    if not re.fullmatch(r"[A-Za-z0-9_-]{32,}", token):
        raise ValueError("managed ADE_NATS_TOKEN environment required")
    imports = "import fcntl,json,os,re,stat,sys,tempfile\nfrom pathlib import Path\n"
    remote = (
        imports
        + inspect.getsource(install_credential)
        + """
try:
    if os.geteuid() != 0:
        raise ValueError("root deployment endpoint required")
    changed = install_credential(Path("/etc/credstore/ade-nats-auth.json"), json.load(sys.stdin))
    print(json.dumps({"ok":True,"changed":changed}))
except (OSError,ValueError,TypeError,KeyError):
    print(json.dumps({"ok":False,"error":"runtime credential provisioning refused"}))
    raise SystemExit(1)
"""
    )
    # The boundary injects every declared credential. Forward only SSH necessities;
    # send the one consumer value through stdin, never argv or SSH environment.
    env = {
        key: os.environ[key]
        for key in ("PATH", "HOME", "SSH_AUTH_SOCK", "LANG", "LC_CTYPE")
        if key in os.environ
    }
    result = subprocess.run(
        [
            "/usr/bin/ssh",
            "-o",
            "BatchMode=yes",
            args.ssh_host,
            "python3",
            "-c",
            shlex.quote(remote),
        ],
        input=json.dumps({"authorization": {"token": token}}),
        capture_output=True,
        text=True,
        env=env,
        timeout=60,
    )
    if result.returncode:
        print(
            json.dumps(
                {
                    "ok": False,
                    "error": "runtime credential endpoint failed; reconcile before retry",
                }
            )
        )
        return 1
    response = json.loads(result.stdout)
    if not isinstance(response, dict) or response.get("ok") is not True:
        raise ValueError("credential endpoint did not confirm")
    print(
        json.dumps(
            {
                "ok": True,
                "host": args.ssh_host,
                "changed": bool(response.get("changed")),
            }
        )
    )
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError, subprocess.SubprocessError):
        print(
            json.dumps(
                {"ok": False, "error": "managed credential provisioning refused"}
            )
        )
        raise SystemExit(1)

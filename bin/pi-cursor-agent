#!/usr/bin/env python3
"""Cursor provider child launcher: preserve CLI auth; run print mode unattended."""
import os
import shutil
import sys


def launch_argv(args, executable):
    if any(flag in args for flag in ("--print", "-p")) and not any(
        flag in args for flag in ("--force", "--yolo")
    ):
        args = ["--force", *args]
    return [executable, *args]


def main():
    executable = shutil.which("cursor-agent")
    if executable is None or os.path.realpath(executable) == os.path.realpath(__file__):
        print("pi-cursor-agent: Cursor CLI is unavailable", file=sys.stderr)
        return 127
    os.execv(executable, launch_argv(sys.argv[1:], executable))


if __name__ == "__main__":
    sys.exit(main())

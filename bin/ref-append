#!/usr/bin/env python3
"""ref-append [--dir DIR] [--in-place] <BOT> [FILE|-]

Appends ONE fresh "Ref: <BOT>-<x>" line to the end of a post and prints the
finished text.

Reads FILE (or stdin if FILE is omitted or "-"). Uses ../bin/ref, so the same
global base-36 counter and lock. --dir and REFS_DIR are forwarded to ref (the
flag wins) so tests can use a throwaway copy.

Refuses (exit 2, nothing consumed) if the text is empty or its last non-blank
line already is a Ref line, so a post can only get one. With --in-place FILE,
rewrites FILE with the result as well as printing it (atomic replace).
"""
import os, re, subprocess, sys, tempfile

REF_RE = re.compile(r"^\s*Ref:\s*[A-Z0-9]+-[0-9a-z]+\s*$")
USAGE = "usage: ref-append [--dir DIR] [--in-place] <BOT> [FILE|-]"


def main(argv):
    args = list(argv[1:])
    in_place = False
    ref_dir = None
    rest = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--in-place":
            in_place = True
            i += 1
        elif a in ("--dir", "-d"):
            if i + 1 >= len(args):
                sys.exit(USAGE)
            ref_dir = args[i + 1]
            i += 2
        elif a.startswith("--dir="):
            ref_dir = a.split("=", 1)[1]
            i += 1
        else:
            rest.append(a)
            i += 1
    if not rest or rest[0].startswith("-") or len(rest) > 2:
        sys.exit(USAGE)
    bot, src = rest[0], (rest[1] if len(rest) > 1 else "-")
    if in_place and src == "-":
        sys.exit("--in-place needs a FILE")
    text = sys.stdin.read() if src == "-" else open(src, encoding="utf-8").read()
    lines = text.rstrip().splitlines()
    if not lines:
        sys.exit("ref-append: refusing, text is empty")
    if REF_RE.match(lines[-1]):
        sys.stderr.write("ref-append: refusing, text already ends with a Ref line: %s\n" % lines[-1].strip())
        sys.exit(2)
    ref_cmd = [os.path.join(os.path.dirname(os.path.abspath(__file__)), "ref")]
    if ref_dir is not None:
        ref_cmd.extend(["--dir", ref_dir])
    ref_cmd.append(bot)
    r = subprocess.run(ref_cmd, capture_output=True, text=True)
    ref = r.stdout.strip()
    if r.returncode != 0 or not REF_RE.match(ref):
        sys.exit("ref-append: ref failed: " + (r.stderr.strip() or ref))
    out = text.rstrip() + "\n\n" + ref + "\n"
    if in_place:
        d = os.path.dirname(os.path.abspath(src)) or "."
        fd, tmp = tempfile.mkstemp(dir=d)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(out)
        os.chmod(tmp, os.stat(src).st_mode & 0o7777)
        os.replace(tmp, src)
    sys.stdout.write(out)


if __name__ == "__main__":
    main(sys.argv)

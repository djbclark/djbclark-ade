#!/usr/bin/env python3
"""Bounded JSON driver; credentials supplied by the existing managed environment."""
import json
import sys
from pathlib import Path
def _coord():
    """Load only our trusted absolute sibling; valid after temporary -I paths restore."""
    import importlib.util
    import sys
    path = Path(__file__).resolve().with_name("ade_coord.py")
    name = "ade_coord"
    found = sys.modules.get(name)
    if found is not None and Path(found.__file__).resolve() == path:
        return found
    key = name if found is None else "_ade_coord_" + str(path)
    if key in sys.modules:
        return sys.modules[key]
    spec = importlib.util.spec_from_file_location(key, path)
    module = importlib.util.module_from_spec(spec)
    sys.modules[key] = module
    try:
        spec.loader.exec_module(module)
    except Exception:
        sys.modules.pop(key, None)
        raise
    return module


call = _coord().call
run_managed = _coord().run_managed
job_status = _coord().job_status
materialize = _coord().materialize
CoordinationError = _coord().CoordinationError
try:
    if len(sys.argv) != 3:
        raise CoordinationError("COMMAND_PAIR_REQUIRED")
    try:
        request = json.load(sys.stdin)
    except json.JSONDecodeError:
        raise CoordinationError("INVALID_JSON_REQUEST") from None
    if not isinstance(request, dict):
        raise CoordinationError("JSON_OBJECT_REQUIRED")
    command = " ".join(sys.argv[1:])
    if command == "role get" and not isinstance(request.get("role_id"), str):
        raise CoordinationError("ROLE_ID_REQUIRED")
    if command in ("inbox list", "inbox read", "inbox intake", "inbox dispose"):
        current = request.get("snapshot")
        if not isinstance(current, dict) or not isinstance(current.get("record"), dict) or type(current.get("revision")) is not int:
            raise CoordinationError("SNAPSHOT_RECORD_AND_REVISION_REQUIRED")
        if not isinstance(request.get("authority"), dict):
            raise CoordinationError("AUTHORITY_REQUIRED")
    if command == "handoff transfer":
        transfer = _coord()._sibling("ade_coord_handoff").transfer
        result = transfer(request)
    elif command in ("wake status", "wake reconcile"):
        module = _coord()._sibling("ade_coord_wake")
        result = module.status(_coord().config(), request["role_id"]) if command == "wake status" else module.reconcile(_coord().config(), request)
    elif command == "artifact materialize":
        result = materialize(request)
    elif command in ("job inspect", "job reconcile", "job bind", "job complete"):
        result = job_status(request, command)
    else:
        result = run_managed(request) if command == "job run" else call(command, request)
    print(json.dumps({"ok": True, "result": result}))
except Exception as error:
    print(json.dumps({"ok": False, "error": {"code": str(error) if isinstance(error, CoordinationError) else "UNKNOWN"}}))
    sys.exit(1)

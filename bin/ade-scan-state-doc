#!/usr/bin/env python3
"""ade-scan-state-doc: render docs/ade-everywhere-phase0-scan-2026-10-20.md from a scan JSON.

  ade-scan-state-doc SCAN.json OUT.md [--force]

SCAN.json is the output of one `bin/ade-scan-state --json` run (the command is in section 5 of the
doc). The tables and counts come from the JSON; the prose, the section 3 capture commands and the
findings about named checkouts are the 2026-10-20 snapshot's and are written here, so a scan taken
on another day needs its own copy of this script. `bin/ade-scan-state --markdown` prints the raw
tables only. The committed doc was rendered from the 2026-10-20 scan, whose JSON was not kept; later
scans regenerate their own doc. Every table cell goes through `esc` (same rule as ade-scan-state's
`esc`); a value inside a code span goes through `code`, whose fence is longer than any backtick run
in the value.

OUT must end in `.md`, must not be SCAN.json, and must not exist unless --force is given; it is
written to a temp file beside it and moved into place, so a failed run leaves OUT as it was.
"""
import json
import os
import re
import shlex
import sys
import tempfile
import time
from pathlib import Path

HOME = str(Path.home())


def tilde(p):
    return p.replace(HOME, "~")


def num(v):
    """A scan count as an int: the null of a skipped or incomplete record (no counts) is 0."""
    return v if isinstance(v, int) and not isinstance(v, bool) else 0


def human(n):
    v = float(n)
    for u in ("B", "K", "M", "G"):
        if v < 1024 or u == "G":
            return f"{v:.0f}{u}" if u == "B" else f"{v:.1f}{u}"
        v /= 1024


def esc(value, in_code=False):
    """One markdown table cell: `|` escaped, `<`, `>`, `&` HTML-escaped; backticks escaped outside
    a code span (CommonMark ignores a backslash inside one, `code` fences instead)."""
    text = "-" if value is None else str(value)
    text = text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
    text = text.replace("|", "\\|")
    if not in_code:
        text = text.replace("`", "\\`")
    return " ".join(text.split("\n"))


def shcode(fmt, *values):
    """A code span holding a shell command: every value is `shlex.quote`d before `code()` escapes it for markdown,
    so a checkout path or branch name shaped like `side$(touch x)` cannot run anything when the cell is pasted
    (adversary round 8 on PR 27, 2026-10-20)."""
    return code(fmt, *[shquote(v) for v in values])


def shquote(v):
    """`shlex.quote`, except that a leading `~/` (the generator's own home abbreviation, `tilde()`) stays
    outside the quotes so the shell still expands it: `~/'a b'/c`, never `'~/a b/c'` (adversary round 9)."""
    v = str(v)
    if v.startswith("~/"):
        return "~/" + shlex.quote(v[2:]) if v[2:] else "~/"
    return shlex.quote(v)


def code(fmt, *values):
    """A code span: `fmt` (literal text, `{}` slots) with each value escaped, fenced with more
    backticks than the longest run in the result."""
    text = fmt.format(*[esc(v, in_code=True) for v in values])
    runs = re.findall(r"`+", text)
    if not runs:
        return f"`{text}`"
    fence = "`" * (max(len(r) for r in runs) + 1)
    return f"{fence} {text} {fence}"


def day(t):
    return time.strftime("%Y-%m-%d", time.localtime(t))


def check_paths(src, out, force):
    """Refuse an OUT that would destroy the input, a non-markdown file or an existing file."""
    src, out = Path(src), Path(out)
    if out.resolve() == src.resolve():
        sys.exit(f"refusing: OUT is the input {src}")
    if out.suffix != ".md":
        sys.exit(f"refusing: OUT {out} does not end in .md")
    if out.is_dir():
        sys.exit(f"refusing: OUT {out} is a directory")
    if out.exists() and not force:
        sys.exit(f"refusing: {out} exists (--force replaces it)")


def write_atomic(out, text):
    """Temp file beside OUT, then os.replace: OUT is whole before and whole after."""
    out = Path(out)
    fd, tmp = tempfile.mkstemp(dir=out.parent, prefix=f".{out.name}.", suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
        umask = os.umask(0)
        os.umask(umask)
        os.chmod(tmp, 0o666 & ~umask)
        os.replace(tmp, out)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def render(d):
    bt, cos, sm = d["bigteam"], d["checkouts"], d["summary"]
    tasks = sorted(bt["tasks"], key=lambda t: -t["bytes"])
    uniq = [t for t in tasks if t["verdict"] == "unique"]
    mixed = [t for t in tasks if t["verdict"] == "mixed"]
    scr = [t for t in tasks if t["verdict"] == "scratch"]
    open_jobs = sum(len(t["open_job_records"]) for t in tasks)
    tasks_open_jobs = sum(1 for t in tasks if t["open_job_records"])
    bs = sm["bigteam"]
    cs = sm["checkouts"]
    unpushed = [c for c in cos if "unpushed commits" in c["flags"] or "orphan branch" in c["flags"]]
    out = []
    w = out.append

    w("# Phase 0 scan: bigteam task dirs and Orca / cow checkouts (2026-10-20)\n")
    w("Phase 0, slice 3 of [ade-everywhere-proposal.md](ade-everywhere-proposal.md) §8 item 1 "
      "(djbclark, 2026-10-20: \"Scan `~/.local/state/bigteam` and the Orca checkouts for unique reports, "
      "dirty trees, untracked files and unpushed commits and capture them. Nothing is deleted.\"). "
      "Nothing was moved, committed, stashed, checked out or deleted outside this pasture. The network "
      "calls were `git ls-remote --heads origin` and, only where an origin tip could not be compared "
      "with HEAD, `git fetch origin <branch>`: that run used the first version of `--fetch`, which "
      "downloaded the branch's objects but also rewrote `FETCH_HEAD`, may have updated "
      "`refs/remotes/origin/<branch>` and may have run auto-maintenance in that checkout (the tool now "
      "writes no refs, section 5). The first version also ran git inside each checkout with that "
      "checkout's own config in force, so a `core.fsmonitor` or `remote.*.uploadpack` line there would "
      "have run (the tool now skips such a checkout, section 5); whether any scanned checkout carried one "
      "was not checked (section 4). The first version also treated a git call that failed or timed out as "
      "\"nothing found\" and had no guard against a partial clone downloading objects during a count; the "
      "tool now reports `scan incomplete: <call> rc=<n>` for the first and sets `GIT_NO_LAZY_FETCH=1` on "
      "every git call for the second (section 4). Numbers below come from one real run of "
      "[`bin/ade-scan-state`](../bin/ade-scan-state) at "
      f"{d['scanned_at']} (commands in section 5); rerun it for a fresh scan. This document is "
      "rendered from that run's JSON by [`bin/ade-scan-state-doc`](../bin/ade-scan-state-doc). Slice 1 context: "
      "[ade-everywhere-inventory-2026-10-20-stores.md](ade-everywhere-inventory-2026-10-20-stores.md) "
      "§2 rows for bigteam and Orca, and the Orca section of "
      "[ade-everywhere-inventory-2026-10-19.md](ade-everywhere-inventory-2026-10-19.md).\n")

    w("## 0. Summary\n")
    w("| Measure | Value |\n|---|---|")
    w(f"| bigteam task dirs scanned | {bs['tasks']} ({human(bs['total_bytes'])} by `du -sk`) |")
    w(f"| verdict `unique` | {bs['verdicts'].get('unique', 0)} dirs, "
      f"{sum(t['bytes'] for t in uniq) / 2**20:.1f} MiB whole-dir |")
    w(f"| verdict `mixed` | {bs['verdicts'].get('mixed', 0)} dirs, "
      f"{sum(t['bytes'] for t in mixed) / 2**20:.0f} MiB whole-dir |")
    w(f"| verdict `scratch` | {bs['verdicts'].get('scratch', 0)} dirs, "
      f"{sum(t['bytes'] for t in scr) / 2**30:.1f} GiB whole-dir |")
    w(f"| bytes `unique` (report files no other document references) | {bs['unique_bytes']:,} B "
      f"({bs['unique_bytes'] / 2**20:.2f} MiB) |")
    w(f"| bytes `scratch` (everything else under bigteam) | {bs['scratch_bytes']:,} B "
      f"({bs['scratch_bytes'] / 2**30:.1f} GiB) |")
    w(f"| job records with no `closed` key | {open_jobs} in {tasks_open_jobs} task dirs |")
    w(f"| git checkouts scanned | {cs['count']} |")
    for k in ("clean and pushed", "unpushed commits", "orphan branch", "dirty"):
        w(f"| checkouts, verdict `{k}` | {cs['verdicts'].get(k, 0)} |")
    w(f"| checkouts with unpushed work (unpushed commits or orphan branch) | **{cs['with_unpushed_work']}** |")
    w(f"| checkouts with untracked non-ignored paths | {cs['with_untracked']} |")
    w(f"| checkouts with a stash | {cs['with_stash']} |")
    incomplete_tasks = [t for t in tasks if t["verdict"].startswith("scan incomplete")]
    w(f"| bigteam task dirs with `scan incomplete` (reference search failed) | {len(incomplete_tasks)} |")
    w(f"| checkouts `skipped` or `scan incomplete` (no counts, not in 3.2) | "
      f"{num(cs.get('skipped')) + num(cs.get('incomplete'))} |")
    w("")
    w("The three items that most need a human decision:\n")
    w("1. **`~/src/one-offs` has no `origin` remote at all** and 37 commits (plus the Orca worktree "
      "`~/orca/workspaces/one-offs/Hermes`, 2 commits, same repo). Nothing outside this Mac holds them; "
      "the only copy is this disk. Decide where it is hosted (a new repo needs the where-does-it-go "
      "question, rule 23) or take a bundle (section 3).")
    w("2. **Where the 41 `unique`/`mixed` bigteam report sets are preserved** "
      f"({bs['unique_bytes'] / 2**20:.1f} MiB of report markdown; the rest of those dirs is logs and "
      "worktrees). One destination answers all of them; two dirs (`emufix`, `wdfollow`) and several "
      "`unique` ones have an open `CLAIM`, so a session may still be writing there.")
    w("3. **Five more checkouts hold commits that exist on no origin branch** "
      "(`you-can-compact-yourself` 2, `aiuse-integration` 2, `crush-merge-v0981` 8, "
      "`opencode-v2` 1, `clinepass-pr44379` 2 plus a stash). Pushing a branch is outward-facing, so "
      "djbclark picks push or bundle per repo (section 3).")
    w("")
    w("A fourth finding that is not a decision yet: **54.5 GiB of the 60 GiB is one scratch tree**, "
      "`adhoc-2026-10-18/hm-promo-rehearsal/` (Hermes promotion rehearsal homes and snapshots). "
      "Deleting it is a later cleanup decision, not part of Phase 0.\n")

    # ---- 1 bigteam
    w("## 1. bigteam (`~/.local/state/bigteam/<task>/`)\n")
    w("**Method.** One row per task dir. *Size* is `du -sk`; *newest* is the newest mtime within two "
      "levels; *CLAIM* is `DONE` when the last non-blank line of `CLAIM` starts with `DONE`, `open` "
      "when a `CLAIM` exists without it, `no CLAIM` otherwise; *reports* are `*report*.md` files within "
      "three levels (not inside a git checkout) and whether `<file>.done` exists; *open jobs* counts "
      "`jobs/*.json` records with no `closed` key (a record written by `acp-dispatch` before it is "
      "reaped or closed; most are finished slices nobody closed, so this is a loose end, not lost "
      "data). Verdicts: `unique` = at least one report file and no document under "
      "`~/src/djbclark-ade/docs`, `~/ops/site-private/memory` or `~/.local/state/handoffs` mentions the "
      "task name (whole word, `rg -l -F -w`), and the dir is at most 5 MiB; `mixed` = the same but the "
      "dir is larger (logs, worktrees, caches around the reports); `scratch` = no report file, or every "
      "report's task name is already referenced elsewhere. **A reference proves a mention, not a copy**, "
      "and a short common task name can match by accident, so `scratch` for a dir that has reports means "
      "\"cited somewhere\", not \"safe to delete\"; the 93 scratch dirs have not been read. A fresh scan with the "
      "current tool marks a task dir whose `rg`/`grep` search failed (exit above 1, or a timeout) "
      "`scan incomplete`, never `scratch`, `unique` or `mixed`; the run above read such a failure as "
      "\"no reference\".\n")
    w(f"{bs['tasks']} dirs; {len(bt['loose_files'])} loose files at the root "
      f"({', '.join(bt['loose_files'][:6])}{'...' if len(bt['loose_files']) > 6 else ''}).\n")

    w("### 1.1 The ten largest dirs and what fills them\n")
    w("| # | task | size | verdict | largest children |\n|---|---|---|---|---|")
    for i, t in enumerate(tasks[:10], 1):
        fills = ", ".join(f"{code('{}', f['name'])} {human(f['bytes'])}" for f in t.get("fills", []))
        w(f"| {i} | {esc(t['task'])} | {human(t['bytes'])} | {esc(t['verdict'])} | {fills} |")
    w("")
    w("`adhoc-2026-10-18` is 91% of the total: `hm-promo-rehearsal/` holds the rehearsal copies "
      "`homeB`, `homeC`, `home`, `snap-step1`, `backups-C` and `tmp` (a few GiB each, all derived from a "
      "Hermes home). The `plektra-*` dirs are Android `*.apk` builds and git worktrees (`wt/`, "
      "`graft-wt/`); every one of them is reproducible from its repo.\n")

    w("### 1.2 `unique` and `mixed` dirs (the preservation list)\n")
    w("| task | verdict | size | newest | CLAIM | reports (.done?) | report bytes | open jobs |\n"
      "|---|---|---|---|---|---|---|---|")
    for t in uniq + mixed:
        reps = ", ".join(f"{esc(Path(r['path']).name)}{'' if r['done'] else ' (no .done)'}"
                         for r in t["reports"][:3])
        if len(t["reports"]) > 3:
            reps += f" +{len(t['reports']) - 3}"
        w(f"| {esc(t['task'])} | {esc(t['verdict'])} | {human(t['bytes'])} | {day(t['newest_mtime'])} | "
          f"{esc(t['claim'])} | {reps} | {t['unique_bytes']:,} | {len(t['open_job_records'])} |")
    w("")

    w("### 1.3 Every task dir\n")
    w("| task | size | newest | CLAIM | report files | open jobs | verdict |\n|---|---|---|---|---|---|---|")
    for t in tasks:
        w(f"| {esc(t['task'])} | {human(t['bytes'])} | {day(t['newest_mtime'])} | {esc(t['claim'])} | "
          f"{len(t['reports'])} | {len(t['open_job_records'])} | {esc(t['verdict'])} |")
    w("")
    if incomplete_tasks:
        w("Task dirs whose reference search failed (`rg`/`grep` exited with an error or timed out, "
          "`reference_search: incomplete: rc=<n>`) are `scan incomplete`, never `unique`, `mixed` or "
          "`scratch`: " + ", ".join(esc(t["task"]) for t in incomplete_tasks) + ". They are not in 1.2 "
          "or 3.1; rescan them before deciding anything.\n")

    # ---- 2 checkouts
    w("## 2. Orca and cow checkouts\n")
    w("**Method.** A checkout is a directory holding `.git` (file or directory) found up to two levels "
      "under `~/orca/workspaces`, `~/orca/projects` and `~/.cow/pastures`; in this run symlinks were "
      "followed, resolved and deduplicated (`~/orca/projects/djbclark-ade` and `one-offs` are links to "
      "`~/src/...`, so they appear under `~/src`); the tool no longer follows symlinks under a root, so "
      "a fresh scan names `--git-root ~/src/djbclark-ade --git-root ~/src/one-offs` itself. `~/orca/workspaces/{aiuse,mobile,wristchess,.orca-preparing}` are empty "
      "dirs. *Modified* and *untracked* count `git status --porcelain` lines (`??` = untracked, "
      "non-ignored; an untracked directory counts once). *Unpushed* is `git rev-list --count @{u}..HEAD`, "
      "or `no upstream`. *Ahead of origin* is commits reachable from HEAD and from no `origin/*` ref "
      "(with a check that the branch tip on origin does not already contain HEAD, because the local "
      "remote refs can be stale; `--fetch` downloads that branch's objects when they are missing, writing no refs). *On origin* comes from `git ls-remote --heads origin`. Verdict "
      "precedence: `unpushed commits` (also any local branch or a detached HEAD holding a commit on no "
      "origin ref), `orphan branch` (branch not on origin and commits origin lacks), `dirty`, "
      "`clean and pushed` (no local-only commit on any local branch); the *also* column lists the other "
      "flags (`detached`, `origin unknown`, `origin unreachable`, `local-only commits: <branch> <n>`). "
      "A checkout whose `status`, `rev-parse --abbrev-ref HEAD`, `for-each-ref` or `rev-list --count` call "
      "fails or times out is `scan incomplete: <call> rc=<n>` (`rc=124` is a timeout; `status` gets "
      "600 s, other calls 60 s) with null counts, and is never `clean and pushed`; a repository whose "
      "`.git/HEAD` git cannot read is `skipped: HEAD unreadable`, and one whose HEAD names no ref while "
      "other refs exist is `scan incomplete`, never a fresh repository.\n")
    w("| path | branch | mod | untr | unpushed | ahead of origin | stash | on origin | verdict | also |\n"
      "|---|---|---|---|---|---|---|---|---|---|")
    for c in cos:
        also = ", ".join(f for f in c["flags"] if f != c["verdict"])
        w(f"| {esc(tilde(c['path']))} | {esc(c['branch'])} | {esc(c['modified'])} | {esc(c['untracked'])} | "
          f"{esc(c['unpushed'])} | {esc(c['ahead_of_origin'])} | {esc(c['stashes'])} | "
          f"{esc(c['on_origin'])} | **{esc(c['verdict'])}** | {esc(also)} |")
    w("")
    dirt = [c for c in cos if "djbclark-ade" in c["path"] and c["verdict"] == "dirty"]
    w("**What the dirt is.** The seven `djbclark-ade` rows (the primary checkout and six pastures) "
      "show the same 7 untracked paths and about 4 modified ones (6 in `paseo-lifecycle`, 13 in the "
      "primary, which other agents kept editing during the scan) because `cow` copies the working tree, "
      "dirt included: `skills/graft/SKILL.md` and `skills/paseo-*/SKILL.md` (modified), and "
      "`.agents/skills/fastino-glide/`, `bin/graft/`, `docs/handoffs/HANDOFF_standalone-32c0_...`, "
      "`skills/paseo*/.paseo-managed-files.json` (untracked). They belong to other agents' in-flight "
      "work in the primary checkout; this scan does not touch them. The two `forgejo-ci-2026-10` rows "
      "likewise share `.forgejo/`, `apps/desktop/release-new/` and `scripts/forgejo-test-ref`. "
      "Untracked `graft/` directories are the reproducible graft index (`graft build`), not work. "
      "The `phase0-scan` pasture itself is dirty with this slice's own files while the scan ran, and "
      "is left out of 3.2.\n")

    # ---- 3 capture
    w("## 3. Capture (how each item would be preserved; none of this was run)\n")
    w("### 3.1 `unique` and `mixed` bigteam dirs\n")
    w("Proposed rule for all of them: copy the report files (not the dir) to one destination, "
      "`<DEST>/<task>/`, preserving names. `<DEST>` is the one decision (the repo question, rule 23; "
      "`~/ops/site-private` is private and fits unreviewed AI reports). Per item the file set is below; "
      "`needs decision` is `yes` only where a session may still be writing (open `CLAIM`, an unclosed "
      "job record with status running) or the dir is `mixed` (the logs next to the report may matter).\n")
    w("| task | copy | needs decision |\n|---|---|---|")
    for t in uniq + mixed:
        files = [r["path"] for r in t["reports"]]
        shown = ", ".join(code("{}", f) for f in files[:4]) + (f" +{len(files) - 4} more" if len(files) > 4 else "")
        need = []
        if t["claim"] == "open":
            need.append("CLAIM open: confirm the session is finished")
        if t["verdict"] == "mixed":
            need.append("mixed: say whether the logs/worktrees beside it matter")
        if t["open_job_records"]:
            need.append(f"{len(t['open_job_records'])} job record(s) unclosed")
        w(f"| {esc(t['task'])} | {shcode('cp ~/.local/state/bigteam/{}/', t['task'])} {shown} -> "
          f"{code('<DEST>/{}/', t['task'])} | "
          f"{'yes: ' + '; '.join(need) if any(not n.endswith('unclosed') for n in need) else 'no (only DEST)'} |")
    w("")
    w("The two open-claim `mixed` dirs and `research-brain-emulation-agent-teams` (22 reports, 88 MiB "
      "with no CLAIM) are the ones to read first.\n")

    w("### 3.2 Checkouts with unpushed commits or untracked non-ignored files\n")
    w("| checkout | what is not preserved | command | needs decision |\n|---|---|---|---|")
    for c in cos:
        raw_p = tilde(c["path"])
        p = esc(raw_p)
        name = Path(c["path"]).name
        if c["path"].endswith("/djbclark-ade/phase0-scan"):
            continue  # this slice's own pasture: its dirt is the files this slice is writing
        if c["verdict"].startswith(("skipped", "scan incomplete")):
            continue  # no counts (null): listed in the section 2 table with their verdict, nothing to capture
        untr = [u for u in (c.get("untracked_sample") or []) if u != "graft/"]
        real_untr = num(c["untracked"]) - (1 if "graft/" in (c.get("untracked_sample") or []) else 0)
        modified, stashes, local_n = num(c["modified"]), num(c["stashes"]), num(c.get("local_only_commits"))
        head_ahead = next((v for v in (c["ahead_of_origin"], c["unpushed"])
                           if isinstance(v, int) and v > 0), 0)
        if not head_ahead and real_untr <= 0 and not stashes and not modified and not local_n:
            continue
        what, cmd, need = [], [], "no"
        head_row = False
        covered_by_bundle = False
        if p.endswith("/one-offs/Hermes"):
            covered_by_bundle = True
            what.append(f"{c['ahead_of_origin']} commits on branch `Hermes` (no remote)")
            cmd.append("same repo as `~/src/one-offs`: its `--all` bundle (the `~/src/one-offs` row below) includes "
                       "branch `Hermes`")
            need = "**yes**: see `~/src/one-offs`"
        elif "no origin remote" in c["flags"]:
            covered_by_bundle = True
            what.append(f"all {c['ahead_of_origin']} commits (no remote)")
            cmd.append(shcode("git -C {} bundle create ~/ops/site-private/bundles/{}.bundle --all", raw_p, name)
                       + " or add a remote and `git push -u origin <branch>`")
            need = "**yes**: only copy; hosting or bundle destination"
        elif ("orphan branch" in c["flags"] or "unpushed commits" in c["flags"]) and head_ahead:
            head_row = True
            what.append(f"{head_ahead} commit(s) on {code('{}', c['branch'])}")
            cmd.append(shcode("git -C {} push -u origin {}", raw_p, c["branch"]) + " or "
                       + shcode("git -C {} bundle create <DEST>/{}-{}.bundle {}", raw_p, name,
                              c["branch"].replace("/", "_"), c["branch"]))
            need = "yes: pushing a branch publishes it; pick push or bundle"
        if local_n and not covered_by_bundle:
            # commits on other local branches (or a detached HEAD) that no origin ref holds, whatever HEAD's own state
            others = [b for b in (c.get("local_only_branches") or [])
                      if not (head_row and b["branch"] == c["branch"])]
            more = num(c.get("local_only_branches_uncounted"))
            names = ", ".join(f"{code('{}', b['branch'])} ({num(b['count'])})" for b in others)
            tail = f" and {more} more branches" if more > 0 else ""
            if others:
                what.append((f"local-only commits on other branches: {names}" if head_row
                             else f"{local_n} local-only commits on {names}") + tail)
            else:
                what.append(f"{local_n} local-only commits (branches not itemised)" + tail)
            lo_cmd = [shcode("git -C {} push origin {}", raw_p, b["branch"])
                      for b in others if b["branch"] != "HEAD"]
            lo_cmd.append(shcode("git -C {} bundle create <DEST>/{}-local-only.bundle --all", raw_p, name))
            cmd.append(" or ".join(lo_cmd) if len(lo_cmd) == 1 else "; ".join(lo_cmd[:-1]) + " or " + lo_cmd[-1])
            need = need if need.startswith(("yes", "**yes")) else "yes: pushing a branch publishes it; pick push or bundle"
        if modified:
            what.append(f"{modified} modified tracked file(s)")
            if "djbclark-ade" in c["path"]:
                cmd.append("same modified files as the primary checkout (cow copy; other agents' edits): "
                           "preserved there")
            else:
                cmd.append(shcode("git -C {} diff > <DEST>/{}-modified.patch", raw_p, name))
                need = need if need != "no" else "yes: decide whether they are work"
        if stashes:
            what.append(f"{stashes} stash")
            cmd.append(shcode("git -C {} stash show -p stash@{{0}} > <DEST>/{}-stash0.patch", raw_p, name))
        if real_untr > 0:
            shared = "djbclark-ade" in c["path"] or "forgejo-ci-2026-10" in c["path"]
            what.append(f"{real_untr} untracked ({', '.join(code('{}', u) for u in untr[:3])}"
                        f"{', ...' if len(untr) > 3 else ''})")
            if shared:
                cmd.append("same paths as the primary / sibling checkout (cow copy): preserve once there")
            else:
                cmd.append(f"copy the paths to {code('<DEST>/{}-untracked/', name)} (`cp -R`), or "
                           f"{shcode('git -C {} add', raw_p)} them on a branch and push")
                need = need if need != "no" else "yes: decide whether they are work"
        w(f"| {p} | {'; '.join(what)} | {'; '.join(cmd)} | {need} |")
    w("")
    w("Checkouts not listed are `clean and pushed` (branch on origin or no commits origin lacks, HEAD only; "
      "see limit 9), hold only the reproducible `graft/` index, or are `skipped` / `scan incomplete` "
      "(no counts: see their verdict in the section 2 table).\n")

    # ---- 4 caveats
    w("## 4. Limits of this scan\n")
    w("1. Bigteam `unique` means \"no document under three roots mentions the task name\"; it does not "
      "read the reports. A mention in `site-private/memory` is counted as preserved even if the report "
      "itself is only here.")
    w("2. Directories are classified by name, not content: the 93 `scratch` dirs were not opened, so a "
      "decision note in a file not named `*report*.md` (for example `findings.md`, `decision.md`, "
      "`out.txt`, `final.txt`) is not detected. Count of such files was not measured.")
    w("3. `du` totals ~64 GB here against ~61 GB in the slice 1 inventory: a different tool and a "
      "later moment (sessions kept writing during both).")
    w("4. `ls-remote` needs the remote to answer; a checkout whose origin refused would show "
      "`on origin: unknown` in the run's tool. None did in this run. The current tool falls back to the "
      "local `refs/remotes/origin/*` and adds the flag `origin unreachable`.")
    w("5. A pasture that was clean when created can become dirty or ahead later; this is a snapshot "
      f"at {d['scanned_at']}.")
    w("6. The scan ran with the first version of the tool, which did not look at a checkout's own config "
      "before running git there. The config of the scanned checkouts was not read afterwards for "
      "command-naming keys (`core.fsmonitor`, `core.sshCommand`, `remote.*.uploadpack`, `filter.*`, "
      "`credential.*`, `core.hooksPath`, `include.*`), so this document cannot say none of them ran "
      "something. The current tool scans only a checkout whose config uses allowlisted keys and lists any other as `skipped: unrecognised config <key>`.")
    w("7. The run's `--fetch` could have moved `refs/remotes/origin/<branch>` and `FETCH_HEAD` in the "
      "checkouts where it fetched; which ones it touched was not recorded.")
    w("8. The run's tool read a failed or timed-out git call as \"nothing found\", so a `clean and pushed` "
      "row above is only as good as every git call in that run having succeeded; failures were not "
      "recorded. A fresh scan with the current tool reports such a checkout as "
      "`scan incomplete: <call> rc=<n>`. Likewise whether any scanned checkout was a partial clone "
      "that downloaded objects during the run was not checked.")
    w("9. The run's tool counted only the commits of HEAD that lie on no origin ref, so a `clean and pushed` "
      "row above can still hold commits on another local branch, and a checkout on a detached HEAD or "
      "with an origin that did not answer was never checked against that. A fresh scan with the current "
      "tool counts them over HEAD and every local branch (`local_only_commits`, `local_only_branches`) "
      "and reports any as `unpushed commits`; none of the rows above was re-checked this way.\n")

    # ---- 5 commands
    w("## 5. Commands run\n")
    w("`W` is the slice's scratch dir under "
      "`~/.local/state/bigteam/ade-2026-10-20-phase0-queue/phase0-scan-work`. Besides writing `W`, the "
      "run's only effects outside this pasture were the `fetch` calls described above.\n")
    w("```sh")
    w("python3 -I bin/ade-scan-state --json \\")
    w("  --bigteam ~/.local/state/bigteam \\")
    w("  --ref-root ~/src/djbclark-ade/docs --ref-root ~/ops/site-private/memory \\")
    w("  --ref-root ~/.local/state/handoffs --exclude 'ade-everywhere-phase0-scan-*.md' \\")
    w("  --git-root ~/orca/workspaces --git-root ~/orca/projects --git-root ~/.cow/pastures \\")
    w("  --remote --fetch > $W/scan.json 2> $W/scan.err; echo rc=$? > $W/scan.rc")
    w("python3 -I bin/ade-scan-state-doc $W/scan.json docs/ade-everywhere-phase0-scan-2026-10-20.md")
    w("```\n")
    w("The first command is the run as executed. With the current tool the same scan adds "
      "`--git-root ~/src/djbclark-ade --git-root ~/src/one-offs` (symlinks under a root are not followed), "
      "its `--fetch` is `git -c maintenance.auto=false -c gc.auto=0 fetch --no-auto-maintenance "
      "--no-write-fetch-head --no-tags --refmap= origin refs/heads/<branch>`, every git call runs with "
      "`GIT_NO_LAZY_FETCH=1` (so the only network calls remain `ls-remote` and that fetch), and a "
      "checkout whose config names a command is listed as skipped.\n")
    w("Inside the tool: `du -sk <dir>`; `rg -l -F -w --no-messages -g '!<exclude>' -- <task> <roots>`; "
      "per checkout `git -C <path>` (in the run as executed, with `GIT_OPTIONAL_LOCKS=0` and the caller's "
      "other `GIT_*` variables; now `git --no-optional-locks -c core.fsmonitor=false -c core.hooksPath=/dev/null "
      "-c protocol.ext.allow=never` with every `GIT_*` variable dropped, preceded by `config --list "
      "--show-scope --includes -z`): `rev-parse --abbrev-ref HEAD`, "
      "`status --porcelain`, `rev-parse --abbrev-ref --symbolic-full-name @{u}`, "
      "`rev-list --count @{u}..HEAD`, `rev-list --count HEAD --not --remotes=origin`, `stash list`, "
      "`remote get-url origin`, `ls-remote --heads origin` (now `ls-remote --heads -- <url>` from an empty "
      "directory outside any repository), `rev-list --count HEAD --not --remotes=origin <tip>`, "
      "`fetch --quiet origin <branch>` (only when the tip's objects are missing). "
      "`bin/ade-scan-state ... --markdown` prints the raw tables; this document's tables and prose come from "
      "`bin/ade-scan-state-doc`. Before the run: `ls -la ~/orca/projects`, "
      "`ls -A ~/orca/workspaces/*`, `fd -H .git -d 4 ~/orca/workspaces`, `git -C ~/src/one-offs remote -v` "
      "(no output: no remote), and `du -sk ~/.local/state/bigteam/adhoc-2026-10-18/hm-promo-rehearsal/*` "
      "for 1.1.")
    return "\n".join(out) + "\n"


def main(argv):
    args = [a for a in argv[1:] if a != "--force"]
    if len(args) != 2:
        sys.exit(__doc__)
    check_paths(args[0], args[1], "--force" in argv)
    with open(args[0]) as f:
        d = json.load(f)
    write_atomic(args[1], render(d))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))

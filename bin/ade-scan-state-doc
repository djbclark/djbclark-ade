    for t in tasks:
        w(f"| {esc(t['task'])} | {human(t['bytes'])} | {day(t['newest_mtime'])} | {esc(t['claim'])} | "
          f"{len(t['reports'])} | {len(t['open_job_records'])} | {esc(t['verdict'])} |")
    w("")
    if incomplete_tasks:
        w("Task dirs whose reference search failed (`rg`/`grep` exited with an error or timed out, "
          "`reference_search: incomplete: rc=<n>`) are `scan incomplete`, never `unique`, `mixed` or "
          "`scratch`: " + ", ".join(esc(t["task"]) for t in incomplete_tasks) + ". They are not in 1.2 "
          "or 3.1; rescan them before deciding anything.\n")

    # ---- 2 checkouts
    w("## 2. Orca and cow checkouts\n")
    w("**Method.** A checkout is a directory holding `.git` (file or directory) found up to two levels "
      "under `~/orca/workspaces`, `~/orca/projects` and `~/.cow/pastures`; in this run symlinks were "
      "followed, resolved and deduplicated (`~/orca/projects/djbclark-ade` and `one-offs` are links to "
      "`~/src/...`, so they appear under `~/src`); the tool no longer follows symlinks under a root, so "
      "a fresh scan names `--git-root ~/src/djbclark-ade --git-root ~/src/one-offs` itself. `~/orca/workspaces/{aiuse,mobile,wristchess,.orca-preparing}` are empty "
      "dirs. *Modified* and *untracked* count `git status --porcelain` lines (`??` = untracked, "
      "non-ignored; an untracked directory counts once). *Unpushed* is `git rev-list --count @{u}..HEAD`, "
      "or `no upstream`. *Ahead of origin* is commits reachable from HEAD and from no `origin/*` ref "
      "(with a check that the branch tip on origin does not already contain HEAD, because the local "
      "remote refs can be stale; `--fetch` downloads that branch's objects when they are missing, writing no refs). *On origin* comes from `git ls-remote --heads origin`. Verdict "
      "precedence: `unpushed commits` (also any local branch or a detached HEAD holding a commit on no "
      "origin ref), `orphan branch` (branch not on origin and commits origin lacks), `dirty`, "
      "`clean and pushed` (no local-only commit on any local branch); the *also* column lists the other "
      "flags (`detached`, `origin unknown`, `local-only commits: <branch> <n>, tag <tag> <n>`) and the primary "
      "flag `origin unreachable: local-only count unverified` (`--remote` got no answer from origin, so the "
      "checkout is never `clean and pushed`) or `origin url holds a credential or names a remote helper: not queried` (the url has a "
      "password, or a username or query string on a non-ssh scheme, or names a remote helper, so it is never queried: the same, the url is in no record). "
      "A checkout whose `status`, `rev-parse --abbrev-ref HEAD`, `for-each-ref`, `rev-list --count` (the one against origin's tip too, unless git says the tip object is missing: that stays `origin tip not fetched`) or `remote get-url origin` call (only git's exit 2 `No such remote` means no origin) "
      "fails or times out is `scan incomplete: <call> rc=<n>` (`rc=124` is a timeout; `status` gets "
      "600 s, other calls 60 s) with null counts, and is never `clean and pushed`; a repository whose "
      "`.git/HEAD` git cannot read is `skipped: HEAD unreadable`, and one whose HEAD names no ref while "
      "other refs exist is `scan incomplete`, never a fresh repository.\n")
    w("| path | branch | mod | untr | unpushed | ahead of origin | stash | on origin | verdict | also |\n"
      "|---|---|---|---|---|---|---|---|---|---|")
    for c in cos:
        also = ", ".join(f for f in c["flags"] if f != c["verdict"])
        w(f"| {esc(tilde(c['path']))} | {esc(c['branch'])} | {esc(c['modified'])} | {esc(c['untracked'])} | "
          f"{esc(c['unpushed'])} | {esc(c['ahead_of_origin'])} | {esc(c['stashes'])} | "
          f"{esc(c['on_origin'])} | **{esc(c['verdict'])}** | {esc(also)} |")
    w("")
    dirt = [c for c in cos if "djbclark-ade" in c["path"] and c["verdict"] == "dirty"]
    w("**What the dirt is.** The seven `djbclark-ade` rows (the primary checkout and six pastures) "
      "show the same 7 untracked paths and about 4 modified ones (6 in `paseo-lifecycle`, 13 in the "
      "primary, which other agents kept editing during the scan) because `cow` copies the working tree, "
      "dirt included: `skills/graft/SKILL.md` and `skills/paseo-*/SKILL.md` (modified), and "
      "`.agents/skills/fastino-glide/`, `bin/graft/`, `docs/handoffs/HANDOFF_standalone-32c0_...`, "
      "`skills/paseo*/.paseo-managed-files.json` (untracked). They belong to other agents' in-flight "
      "work in the primary checkout; this scan does not touch them. The two `forgejo-ci-2026-10` rows "
      "likewise share `.forgejo/`, `apps/desktop/release-new/` and `scripts/forgejo-test-ref`. "
      "An untracked `graft/` directory is usually the reproducible graft index (`graft build`), but it is "
      "archived like any other untracked path: nothing verifies the name. Every checkout gets its own rows, "
      "the `phase0-scan` pasture included.\n")

    # ---- 3 capture
    w("## 3. Capture (how each item would be preserved; none of this was run)\n")
    w("Every command below uses GNU `cp`, `tar` and `sed` through three variables, so the same row runs on this Mac "
      "(coreutils and gnu-sed installed as `g*`) and on Linux (bare names; Codex pass 12 on PR 27): set "
      f"`{PLAN_PREAMBLE}` first, and `<DEST>` to an absolute path. The `unset`s, the loop and the `export` give every `git` the "
      "scanner's own environment: no `GIT_DIR`, `GIT_INDEX_FILE` or other ambient `GIT_*` variable, no global or "
      "system config, and `GIT_NO_LAZY_FETCH=1`, so a successful capture is of the checkout the scan read (Codex pass 42). "
      "In a partial clone a bundle row then fails with `could not fetch ... from promisor remote` instead of downloading "
      "from origin: archive the whole directory there, or unset the variable once contacting origin is acceptable. Paste it into bash or zsh "
      "(not sh or dash: the preamble uses `<<<`), in a shell you close afterwards (`bash -l` or a subshell), not your working one; the push rows are the exception, they need your "
      "own git credentials and config, so run them in a normal shell. Read this document in a rendered markdown view "
      "(GitHub, a viewer): the commands sit in table cells where a literal `|` is written `\\|`, and a plain-text editor "
      "shows that backslash.\n")
    w("### 3.1 `unique` and `mixed` bigteam dirs\n")
    w("Proposed rule for all of them: copy the report files (not the dir) to one destination, "
      "`<DEST>/bigteam/<task>/`, keeping each file's path below the task dir. `<DEST>` is the one decision "
      "(the repo question, rule 23; `~/ops/site-private` is private and fits unreviewed AI reports). The "
      "command in each row names every report of the task, none is left to a `+N more`; "
      "`needs decision` is `yes` only where a session may still be writing (open `CLAIM`, an unclosed "
      "job record with status running) or the dir is `mixed` (the logs next to the report may matter).\n")
    w("| task | reports | command (copies every report) | needs decision |\n|---|---|---|---|")
    for t in uniq + mixed:
        files = [r["path"] for r in t["reports"]]
        need = []
        if t["claim"] == "open":
            need.append("CLAIM open: confirm the session is finished")
        if t["verdict"] == "mixed":
            need.append("mixed: say whether the logs/worktrees beside it matter")
        if t["open_job_records"]:
            need.append(f"{len(t['open_job_records'])} job record(s) unclosed")
        # one cp over the whole set, paths relative to the task dir: nothing is dropped from what the plan keeps
        # (Codex pass 8 on PR 27: a row showing four of 22 paths could not be followed)
        slots = " ".join("{}" for _ in files)
        cmd = shcode("mkdir -p <DEST>/bigteam/{} && (cd {} && \"$GCP\" --parents -t <DEST>/bigteam/{} -- " + slots + ")",
                     t["task"], bt_root + "/" + t["task"], t["task"], *files) if files else "no reports"
        w(f"| {esc(t['task'])} | {len(files)} | {cmd} | "
          f"{'yes: ' + '; '.join(need) if need else 'no (only DEST)'} |")  # any unclosed job: yes (Codex pass 13)
    w("")
    w("The two open-claim `mixed` dirs and `research-brain-emulation-agent-teams` (22 reports, 88 MiB "
      "with no CLAIM) are the ones to read first.\n")

    w("### 3.2 Checkouts with unpushed commits or untracked non-ignored files\n")
    w("Every artifact of one checkout goes to its own directory, `<DEST>/checkouts/home/<path below ~>/` or "
      "`<DEST>/checkouts/abs/<absolute path>/`, so two checkouts with the same basename never overwrite each "
      "other; a branch bundle is named `branch-<branch, percent-encoded>.bundle`, a detached HEAD's `HEAD.bundle`.\n")
    w("| checkout | what is not preserved | command | needs decision |\n|---|---|---|---|")
    for c in cos:
        raw_p = tilde(c["path"])
        p = esc(raw_p)
        ck = checkout_dir(c["path"])  # one directory per checkout below <DEST>/checkouts/: two with one basename never share a file
        if c["verdict"].startswith(("skipped", "scan incomplete")):
            # no counts (null): anything may be in there, so the row demands a re-scan or a whole-directory archive,
            # never "nothing to capture" (Codex pass 19 on PR 27); no git command runs in a checkout the scan refused
            # split the absolute path, then abbreviate the parent: the checkout at HOME itself archives as
            # `-C <dirname HOME> -- <basename HOME>`, not the literal `~` (adversary round 62, LOW 2)
            parent, base = os.path.split(str(c["path"]).rstrip("/"))
            parent = tilde(parent) if parent else parent
            # a `.git` FILE (a linked worktree, an absorbed submodule) points at a git directory elsewhere, which holds
            # the refs, reflogs and perhaps the only copy of local commits; a linked worktree's objects are one step
            # further, in its `commondir`. The whole-directory archive alone misses both (Codex pass 26 on PR 27).
            # the parse matches git's gitfile reader (adversary round 32): the first line must read `gitdir: <path>`
            # (anything else is `false`), a missing final newline is accepted (`read` returns 1 at EOF, `$l` is
            # set), a CRLF is stripped; every failure prints a message and leaves a nonzero status. `-C "$g" ... .`
            # archives the directory's contents without gtar's "Removing leading ../" when commondir is `../..`.
            # Only a git directory is archived, by git's own `is_git_directory` test: `HEAD` in it, `objects` and
            # `refs` in the COMMON directory, so a linked worktree's own directory (`HEAD` and `commondir` only,
            # before git 2.44) passes; a `.git` file naming `/` or a home directory must not make the paste copy
            # the disk (rounds 33 and 35, Codex pass 30). The command text is GITDIR_FMT, run live by the tests
            if c["verdict"] == SKIP_GIT_SYMLINK:
                # the whole-directory archive keeps the link itself, not the git directory it names, where the history
                # is (round 43): that target is archived when it is a git directory, loudly refused otherwise
                gitdir = ("the `.git` symlink's target holds the history (the scan read nothing there): archive it too: "
                          + shcode(SYMLINK_GITDIR_FMT, raw_p, f"{ck}/gitdir.tar", f"{ck}/commondir.tar"))
            else:
                gitdir = ("when `.git` is a file the directory it points to and that one's common directory hold the "
                          "history, archive them too: " + shcode(GITDIR_FMT, *gitdir_values(raw_p, ck)))
            # a module, or the checkout itself (the record then carries `alternates`, whatever the reason it was skipped:
            # adversary round 64), whose `objects/info/alternates` is not empty keeps commits in another object store that
            # neither archive above holds (Codex thread 10 on PR 27): say so, and refuse the cleanup until they are bundled.
            # A bundle row needs none of this: `bundle create` reads through alternates. Older records lack the key
            alt_what, alt_warn, alt_need = "", "", ""
            if c["verdict"] == SKIP_ALTERNATES or isinstance(c.get("alternates"), list):
                targets = [t for t in (c.get("alternates") or []) if isinstance(t, str)][:3]
                names = ("; the first targets, as the alternates file writes them: " + ", ".join(shcode("{}", t) for t in targets)
                         if targets else "; the store named in `<gitdir>/objects/info/alternates` of " + (
                             "each module git directory" if c["verdict"] == SKIP_ALTERNATES else "the checkout's git directory"))
                alt_what = " and the alternate object store"
                alt_warn = (" **objects/info/alternates points outside this checkout; the store it names is NOT archived: do not "
                            "delete the checkout or that store until its commits are bundled**" + names + ".")
                alt_need = "; **do not clean up: the alternate object store is in no archive**"
            # a git directory whose `objects`, `refs` or `packed-refs` is a symlink out (git-new-workdir), or a `.git` directory
            # whose `commondir` names another git directory: both archives keep the link, not the store at its target
            # (adversary round 65, LOW 2). The record key is absent from older scans
            linked = [t for t in (c.get("linked_stores") or []) if isinstance(t, str)][:4]
            if linked:
                alt_what += " and the linked object store"
                alt_warn += (" **the git directory keeps its objects or refs in a store outside this checkout (a symlinked `objects`, "
                             "`refs` or `packed-refs`, or a `commondir` file); the store the link names is NOT archived, only the link: do "
                             "not delete the checkout or that store until its commits are bundled**; the links, as `<member> -> <target>`: "
                             + ", ".join(shcode("{}", t) for t in linked) + ".")
                alt_need += "; **do not clean up: the linked object store is in no archive**"
            w(f"| {p} | counts unknown{alt_what} ({esc(c['verdict'])}) | re-scan once the cause is fixed, or archive the whole "
              f"directory: {shcode('mkdir -p <DEST>/{} && TAR_OPTIONS= \"$GTAR\" -C {} -cf <DEST>/{} -- {}', ck, parent or '/', f'{ck}/whole.tar', base)}"
              f" (no git command: the scan did not run one there either); {gitdir}"
              " Git LFS payloads are in the store (`.git/lfs`, or the directory `lfs.storage` names): when that is a symlink or lives outside"
              " these archives, archive its `objects` directory too (resolve any symlink first: `realpath`)"
              f"{alt_warn}"
              f" | yes: counts unknown; re-scan or archive whole{alt_need} |")
            continue
        # every untracked path counts, a `graft/` directory included: nothing verifies that one is the reproducible
        # graft index rather than work under an ordinary name (Codex pass 28 on PR 27)
        untr = list(c.get("untracked_sample") or [])
        real_untr = num(c["untracked"])
        modified, stashes, local_n = num(c["modified"]), num(c["stashes"]), num(c.get("local_only_commits"))
        head_ahead = next((v for v in (c["ahead_of_origin"], c["unpushed"])
                           if isinstance(v, int) and v > 0), 0)
        # the url is in no record: the flag (`--remote` only) or the field `origin_credential` (every mode, since
        # adversary round 39; older records lack it) says so
        credential = ORIGIN_CREDENTIAL in c["flags"] or bool(c.get("origin_credential"))
        # no push row for such an origin: `git push origin` hands the credential-bearing url to the transport helper's
        # argv, the exposure the scanner itself avoids; the bundle alternative stands alone (Codex pass 33 on PR 27)
        cred_note = " (origin url holds a credential or names a remote helper: no push until it is removed from the url; bundle instead)"
        cred_need = "yes: bundle it; a push would hand the credential-bearing origin url to the transport"
        # a push to a local path or `file://` origin runs that repository's receive hooks and config programs, which
        # `-c core.hooksPath` does not reach: bundle only (adversary round 54 on PR 27, MEDIUM); not "unreachable"
        local_origin = bool(c.get("origin_local_path")) and not credential
        no_push = credential or local_origin
        if local_origin:
            cred_note = " (origin is a local path or file:// url: a push would run that repository's receive hooks and config programs: no push; bundle instead)"
            cred_need = "yes: bundle it; a push to a local-path origin runs that repository's hooks"
        unreachable = credential or ORIGIN_UNREACHABLE in c["flags"]  # `local_only_verified` is false with it, whatever the counts
        submodules = SUBMODULES_FLAG in c["flags"]  # `status --ignore-submodules=all`: the counts see nothing in there
        tag_others = c.get("local_only_tags") or []
        zero_tags = [t for t in tag_others if not num(t["count"])]  # tag objects on pushed commits (Codex pass 31)
        hidden, reflog = num(c.get("index_hidden")), num(c.get("reflog_only_commits"))  # Codex pass 32; older records lack both
        if (not unreachable and not submodules and not head_ahead and real_untr <= 0 and not stashes and not modified
                and not local_n and not zero_tags and not hidden and not reflog and not c.get("embedded_repos")):
            continue
        what, cmd, need = [], [], "no"
        head_row = False
        covered_by_bundle = False
        # no rule keyed on a path name: a checkout called `one-offs/Hermes` used to get "see `~/src/one-offs`" and no
        # command of its own, whatever repository it was (adversary round 30 on PR 27)
        if "no origin remote" in c["flags"]:
            covered_by_bundle = True
            what.append(f"all {c['ahead_of_origin'] or c.get('local_only_commits') or 0} commits (no remote)")
            # a `Home`, so the shell expands the `~`: a plain string would be quoted whole and the bundle written into a
            # directory named `~` below the working directory, inside the checkout it preserves (adversary round 62 on PR 27)
            bd = Home("~/ops/site-private/bundles/") + ck.removeprefix("checkouts/")
            cmd.append(shcode("mkdir -p {} && GIT_ADVICE=0 GIT_GRAFT_FILE=/dev/null GIT_NO_REPLACE_OBJECTS=1 git -C {} bundle create {} --all", bd, raw_p, bd + "/all.bundle")
                       + " or add a remote and `git push -u origin <branch>`")
            need = "**yes**: only copy; hosting or bundle destination"
        elif ("orphan branch" in c["flags"] or "unpushed commits" in c["flags"]) and head_ahead:
            head_row = True
            if c["branch"] == "HEAD":
                # detached: `refs/heads/HEAD` does not exist, a push of it fails (adversary round 13, Codex pass 8)
                what.append(f"{head_ahead} commit(s) on a detached HEAD")
                cmd.append(shcode("mkdir -p <DEST>/{} && GIT_ADVICE=0 GIT_GRAFT_FILE=/dev/null GIT_NO_REPLACE_OBJECTS=1 git -C {} bundle create <DEST>/{} HEAD",
                                  ck, raw_p, f"{ck}/HEAD.bundle")
                           + " (detached HEAD: bundle, or create a branch first: "
                           + shcode("git -C {} switch -c <name>", raw_p) + ")")
                need = "yes: HEAD names no branch; bundle it, or name a branch first"
            else:
                what.append(f"{head_ahead} commit(s) on {code('{}', c['branch'])}")
                # fully qualified refspecs: a branch named like an option (`--mirror`) must never reach git's option
                # parser, and shell quoting does not stop that (Codex pass 7 on PR 27); the bundle's file name is the
                # percent-encoded branch, so `a/b` and `a_b` stay distinct
                if ODD_NAME in c["branch"]:
                    # the scanner decoded a name that is not UTF-8 to U+FFFD: `refs/heads/<that>` names no ref, so only
                    # a bundle of every ref can hold the commits (Codex pass 48 on PR 27, P1)
                    bundle = shcode("mkdir -p <DEST>/{} && GIT_ADVICE=0 GIT_GRAFT_FILE=/dev/null GIT_NO_REPLACE_OBJECTS=1 git -C {} bundle create <DEST>/{} --all",
                                    ck, raw_p, f"{ck}/all-refs.bundle")
                    cmd.append(bundle + ODD_NAME_NOTE + (cred_note if no_push else ""))
                    need = cred_need if no_push else "yes: bundle it; the branch name cannot be typed into a push"
                else:
                    push = shcode("git -C {} -c core.hooksPath=/dev/null push -u origin refs/heads/{}:refs/heads/{}", raw_p, c["branch"], c["branch"])
                    bundle = shcode("mkdir -p <DEST>/{} && GIT_ADVICE=0 GIT_GRAFT_FILE=/dev/null GIT_NO_REPLACE_OBJECTS=1 git -C {} bundle create <DEST>/{} refs/heads/{}",
                                    ck, raw_p, f"{ck}/branch-{quote(c['branch'], safe='')}.bundle", c["branch"])
                    cmd.append(bundle + cred_note if no_push else push + " or " + bundle)
                    need = cred_need if no_push else "yes: pushing a branch publishes it; pick push or bundle"
        if local_n and not covered_by_bundle:
            # commits on other local branches, tags (or a detached HEAD) that no origin ref holds, whatever HEAD's own state
            others = [b for b in (c.get("local_only_branches") or [])
                      if not (head_row and b["branch"] == c["branch"])]
            more = num(c.get("local_only_branches_uncounted"))
            names = ", ".join([f"{code('{}', b['branch'])} ({num(b['count'])})" for b in others]
                              + [f"tag {code('{}', t['tag'])} ({num(t['count']) or 'tag only'})" for t in tag_others])
            tail = f" and {more} more branches or tags" if more > 0 else ""
            if others or tag_others:
                kind = "branches and tags" if tag_others else "branches"
                what.append((f"local-only commits on other {kind}: {names}" if head_row
                             else f"{local_n} local-only commits on {names}") + tail)
            else:
                what.append(f"{local_n} local-only commits (branches not itemised)" + tail)
            lo_cmd = [shcode("git -C {} -c core.hooksPath=/dev/null push origin refs/heads/{}:refs/heads/{}", raw_p, b["branch"], b["branch"])
                      for b in others if b["branch"] != "HEAD" and ODD_NAME not in b["branch"]]
            odd_names = any(ODD_NAME in b["branch"] for b in others) or any(ODD_NAME in t["tag"] for t in tag_others)
            # a tag is pushed by its full ref name, like a branch: a tag named like an option never reaches git's parser
            lo_cmd += [shcode("git -C {} -c core.hooksPath=/dev/null push origin refs/tags/{}:refs/tags/{}", raw_p, t["tag"], t["tag"])
                       for t in tag_others if ODD_NAME not in t["tag"]]
            bundle = shcode("mkdir -p <DEST>/{} && GIT_ADVICE=0 GIT_GRAFT_FILE=/dev/null GIT_NO_REPLACE_OBJECTS=1 git -C {} bundle create <DEST>/{} --all",
                            ck, raw_p, f"{ck}/local-only.bundle")
            if no_push:
                cmd.append(bundle + cred_note)
            elif num(c.get("local_only_other_refs")):
                # a commit only a ref outside refs/heads and refs/tags holds is in no push refspec (Codex pass 53, P1)
                cmd.append(bundle + " (some local-only commits are on refs outside refs/heads and refs/tags, which a push of branches and tags leaves behind: bundle)")
            elif more > 0:
                # branches and tags past the scan's cap are in no itemised push (adversary round 59, MEDIUM)
                cmd.append(bundle + f" ({more} more branches or tags are not itemised, so no push can name them all: bundle)")
            elif odd_names:
                cmd.append(bundle + ODD_NAME_NOTE)  # one bundle holds every ref; no push can name the odd one
            else:
                cmd.append(bundle if not lo_cmd else "; ".join(lo_cmd[:-1] + [lo_cmd[-1] + " or " + bundle]))
            need = need if need.startswith(("yes", "**yes")) else (
                cred_need if no_push else "yes: bundle it; a push would leave commits on other refs behind" if (num(c.get("local_only_other_refs")) or more > 0)
                else "yes: pushing a branch publishes it; pick push or bundle")
        if zero_tags and not (local_n and not covered_by_bundle):
            # a local tag origin lacks on a commit origin has: no commit count sees the tag object and no branch
            # bundle holds it; its name, annotation and signature are lost with the checkout (Codex pass 31 on PR 27)
            shown = ", ".join(code("{}", t["tag"]) for t in zero_tags[:5])
            more = max(len(zero_tags) - 5, 0)
            what.append(f"{len(zero_tags)} local tag(s) origin lacks: {shown}" + (f" and {more} more" if more else ""))
            # every tag at once, bounded whatever their number (adversary round 37): one origin already has at the
            # same object is up to date; one it has at another object is rejected, loudly
            bundle = shcode("mkdir -p <DEST>/{} && GIT_ADVICE=0 GIT_GRAFT_FILE=/dev/null GIT_NO_REPLACE_OBJECTS=1 git -C {} "
                            "bundle create <DEST>/{} --tags", ck, raw_p, f"{ck}/tags.bundle")
            cmd.append(bundle + cred_note if no_push else shcode("git -C {} -c core.hooksPath=/dev/null push origin --tags", raw_p) + " or " + bundle
                       + " (a tag origin has at another object is rejected by the push: bundle it, or decide to force)")
            need = need if need.startswith(("yes", "**yes")) else (
                cred_need if no_push else "yes: pushing a tag publishes it; pick push or bundle")
        if c.get("lfs_store"):
            # a bundle, a stash or reflog pack and a patch hold LFS pointers only and the generated push runs with hooks
            # off, so LFS's pre-push upload never runs: the payloads are in the store (Codex pass 52 on PR 27, P1; every
            # capture reason, not only unpushed commits: Codex pass 53 P1, adversary round 58 MEDIUM)
            # `lfs_store` is the resolved `objects` directory (a symlink on the way is followed by the scan, one inside
            # the store is kept as a link: no `tar -h`, adversary round 60, LOW 1); restore with `tar -C <objects> -xf`
            cmd.append("Git LFS payloads (the pointers in any bundle, patch or pack are all those hold) are in the LFS store (its `objects` directory); archive it: "
                       + shcode("mkdir -p <DEST>/{} && TAR_OPTIONS= \"$GTAR\" -C {} -cf <DEST>/{} .", ck, c["lfs_store"], f"{ck}/lfs.tar"))
        if hidden:
            what.append(f"{hidden} tracked path(s) marked assume-unchanged or skip-worktree (`status` cannot see their edits)")
            cmd.append(shcode(HIDDEN_FMT, *hidden_values(raw_p, ck)))
            need = need if need != "no" else "yes: decide whether their edits are work"
        if reflog:
            # a routine amend, rebase or squash-merge leaves such entries too, for `gc.reflogExpireUnreachable` (30 days
            # by default), so the count is a prompt to look, not proof of lost work (adversary round 38)
            what.append(f"{reflog} reflog-only commit(s) (left by a reset, amend, rebase or squash-merge in the last ~30 days; "
                        "no ref holds them; an older stash entry's base counts here too)")
            # the pack holds only what origin lacks, so it restores into a clone that has origin's history and this
            # checkout's bundles; a ref must then hold each commit or the next `gc` prunes it again (round 38)
            cmd.append(shcode(REFLOG_FMT, *reflog_values(raw_p, ck))
                       + " (restore into a clone, after this checkout's bundles, by copying the `.pack` and `.idx` into "
                       "`.git/objects/pack/`, then `git update-ref refs/recovered/<sha> <sha>` for each commit line of "
                       "`reflog-only.list`, the lines with no path)")
            need = need if need != "no" else "yes: decide whether they are work"
        if modified:
            what.append(f"{modified} modified tracked file(s)")
            # `status` counts staged changes too; a plain `diff` is worktree against index and misses them, so
            # the index gets its own patch (`--cached` works in an unborn repository too; Codex pass 20 on PR 27);
            # `--binary` keeps a changed binary file's bytes, a plain diff says only "Binary files differ" (pass 21).
            # Every checkout gets its own patch: that a path names a cow pasture of another checkout proves nothing
            # about its content (Codex pass 24; the generator used to infer "preserved in the primary" from the name)
            # (Codex pass 30: `--no-textconv` and friends, and an archive of the changed files: see `modified_fmt`)
            cmd.append(shcode(modified_fmt(), *modified_values(raw_p, ck)))
            need = need if need != "no" else "yes: decide whether they are work"
        if stashes:
            what.append(f"{stashes} stash" + ("es" if stashes > 1 else ""))
            # every stash entry, not stash@{0} alone, each with its untracked files (Codex pass 20, adversary round 26)
            cmd.append(shcode(STASH_FMT, *stash_values(raw_p, ck))
                       + " (a worktree patch and an index patch per entry, `stash.patch` and `stash-index.patch` for `refs/stash` alone when its reflog expired; restore with "
                       + code("git apply --allow-empty --cached <index patch> && git apply --allow-empty <patch>") + ")")
# `--allow-empty` (git 2.35+): a plain `git stash` of unstaged edits has an index equal to the base, so its index patch
# is empty and a bare `git apply` of it exits 128, skipping the worktree patch behind the `&&` (adversary round 37)
        if real_untr > 0:
            what.append(f"{real_untr} untracked ({', '.join(code('{}', visible(u)) for u in untr[:3])}"
                        f"{', ...' if len(untr) > 3 else ''})")
            # every untracked path, not the sample shown: an archive from `ls-files`, or `add -A` (which also
            # stages the modified tracked files) on a branch (Codex pass 7 on PR 27). Two commands joined by
            # `&&`, the list in a file: `ls-files | gtar` exits 0 when ls-files fails (Codex pass 9). Every checkout,
            # a cow pasture of another one included: the name proves nothing about the content (Codex pass 24)
            cmd.append("archive every untracked path: "
                       + shcode(UNTRACKED_FMT, *untracked_values(raw_p, ck))
                       + ("" if no_push else " or " + shcode("git -C {} add -A -- .", raw_p)
                          + " on a branch, commit and push (stages the modified tracked files too)"))
            need = need if need != "no" else "yes: decide whether they are work"
        embedded_list = c.get("embedded_repos") or []
        if embedded_list and real_untr <= 0:
            # found beneath an index-hidden path only: no untracked row above names it (Codex pass 55 on PR 27, P2)
            what.append(f"{len(embedded_list)} embedded repositor{'y' if len(embedded_list) == 1 else 'ies'} below index-hidden paths")
            need = need if need != "no" else "yes: decide whether they are work"
        # the list names an embedded repository's directory, not its files, and the archive takes no directory's
        # contents (`--no-recursion`): its ignored files and git metadata stay out of the non-ignored capture. The
        # repository is its own checkout: scan it, or archive the directory whole (Codex pass 50 on PR 27, P2)
        pointers = set(c.get("embedded_pointer_repos") or [])
        for i, e in enumerate(c.get("embedded_repos") or []):
            name = e.rstrip("/")  # the real name (`ls-files -z`); `--no-unquote` keeps tar from reading it as a quoted one
            if e in pointers:
                # its `.git` is a file or symlink: the directory archive holds the pointer, not the commits (round 57, LOW 4)
                cmd.append(f"embedded repository {code('{}', visible(e))}: its `.git` points elsewhere (a separate gitdir or a linked "
                           "worktree), so archiving the directory keeps no commits; scan it as a checkout of its own")
                continue
            cmd.append(f"embedded repository {code('{}', visible(e))}: archived as an empty entry in the archives above; its own state is not captured. "
                       "Scan it as a checkout of its own, or archive it whole (its ignored files and `.git` included): "
                       + shcode("mkdir -p <DEST>/{} && TAR_OPTIONS= \"$GTAR\" -C {} --no-unquote -cf <DEST>/{} -- {}",
                                ck, raw_p, f"{ck}/embedded-{i}.tar", name))
        if unreachable:
            # origin did not answer: the count trusted the local `refs/remotes/origin/*`, which a deleted or
            # force-pushed branch leaves stale, so even a 0 hides commits (adversary round 21, 1)
            what.append("local-only count unverified: origin url holds a credential or names a remote helper, not queried" if credential
                        else "local-only count unverified: origin did not answer")
            again = ("or remove the password (or the remote helper) from the origin url (ssh or a credential helper) and re-scan with "
                     "`--remote`" if credential else "or re-scan with `--remote` once origin answers")
            if local_n and not covered_by_bundle:  # the local-only branch above already printed the bundle command
                cmd.append(again)
            else:
                cmd.append(shcode("mkdir -p <DEST>/{} && GIT_ADVICE=0 GIT_GRAFT_FILE=/dev/null GIT_NO_REPLACE_OBJECTS=1 git -C {} bundle create <DEST>/{} --all",
                                  ck, raw_p, f"{ck}/local-only.bundle")
                           + " " + again)
            need = need if need.startswith(("yes", "**yes")) else (
                "yes: origin not queried (its url holds a credential or names a remote helper); bundle" if credential
                else "yes: origin did not answer; bundle, or re-scan")
        if submodules:
            # the scan's status and local-only counts ignore submodules and discovery stops at the superproject: a
            # submodule's modified, untracked or unpushed work is in no count above (Codex pass 18 on PR 27)
            what.append("submodules not inspected: their modified, untracked or unpushed content is in no count here")
            # an absorbed submodule carries `core.worktree`, which this scanner refuses (`skipped: worktree redirected`,
            # adversary round 24), so the inspection is by hand, inside each submodule. The paths are the ones the scan
            # vetted (`submodules_vetted`), each quoted in its own commands: no template, no `.gitmodules` listing for
            # the human to read and paste back (adversary rounds 43-46)
            vetted = c.get("submodules_vetted")
            modules = shcode(MODULES_FMT, *modules_values(raw_p, ck))
            if not isinstance(vetted, list):
                # a scan JSON from a version before `submodules_vetted`: there is no path the plan may name
                cmd.append("this record lists no vetted submodule path (scanned by an older version): re-scan with this "
                           "version to get per-submodule commands; until then archive every module git dir, which holds "
                           "the commits of each submodule, with " + modules + " before any cleanup")
            elif not [s for s in vetted if vettable(s)]:
                cmd.append("no submodule is checked out (each is de-initialised or never initialised): its commits live under "
                           "the git dir's `modules/`, which this archive keeps: " + modules + " before any cleanup")
            else:
                sets = [f"{code('{}', shquote(sub))}: " + ", ".join(submodule_commands(raw_p, ck, sub))
                        for sub in vetted if vettable(sub)]
                if any(isinstance(sub, str) and sub and not vettable(sub) for sub in vetted):
                    sets.append("a path in `submodules_vetted` that is absolute or holds `..` was left out (a hand-edited record?)")
                # the module git dirs hold a de-initialised or removed submodule's commits, which no command above can
                # reach (adversary round 42)
                cmd.append("in each checked-out submodule the scan vetted, the path is in the command: " + "; ".join(sets)
                           + " and " + modules + " before any cleanup (each command fails, saying so, if its submodule is no "
                           "longer a checkout; a de-initialised one is an empty directory whose commits live under the git "
                           "dir's `modules/`, which the last archive keeps; the scanner skips absorbed submodules: "
                           "`core.worktree`)")
            need = need if need.startswith(("yes", "**yes")) else "yes: inspect each submodule first"
        w(f"| {p} | {'; '.join(what)} | {'; '.join(cmd)} | {need} |")
    w("")
    w("Checkouts not listed are `clean and pushed` (branch on origin or no commits origin lacks, HEAD only; "
      "see limit 9). Every emitted `bundle create` runs with `GIT_ADVICE=0 GIT_GRAFT_FILE=/dev/null "
      "GIT_NO_REPLACE_OBJECTS=1`, like the scan's own counts: a grafts file or replace ref would otherwise leave "
      "real objects out of the bundle (`GIT_ADVICE=0`, git 2.46+, silences the grafts-deprecation hint that "
      "`GIT_GRAFT_FILE` provokes on every bundle; older gits ignore it). A `skipped` / `scan incomplete` checkout has "
      "no counts (its verdict is in the section 2 table) and is listed with a whole-directory archive: anything "
      "may be in there. A `skipped: submodule config unrecognised (nested submodule)` checkout has a submodule with "
      "a `.gitmodules`, a gitlink, an untracked repository or a repository at a skip-worktree or assume-unchanged path of its own: an edit or commit in the inner worktree is in no per-submodule artifact, so only the whole-directory "
      "archive holds it. One ending `(alternates)` has a module whose objects live in another store that no archive "
      "here holds, and any other `skipped` or `scan incomplete` row of a checkout whose own `objects/info/alternates` is not empty, whose `objects`, `refs` or `packed-refs` is a symlink out, or whose `.git` directory holds a `commondir` says the same: the row says so and refuses a cleanup until those commits are bundled. `skipped: git dir redirected (commondir)` is a `.git` directory whose `commondir` file names another git directory: the scan ran no git there, since every call would act on that directory. A checkout flagged `origin unreachable` is "
      "always listed, whatever its counts: its local-only count came from stale tracking refs and is "
      "unverified, so a 0 there is not `clean and pushed`. A checkout flagged `submodules not inspected` is "
      "always listed too: no count here covers a submodule's content.\n")

    # ---- 4 caveats
    w("## 4. Limits of this scan\n")
    w("1. Bigteam `unique` means \"no document under three roots mentions the task name\"; it does not "
      "read the reports. A mention in `site-private/memory` is counted as preserved even if the report "
      "itself is only here.")
    w("2. Directories are classified by name, not content: the 93 `scratch` dirs were not opened, so a "
      "decision note in a file not named `*report*.md` (for example `findings.md`, `decision.md`, "
      "`out.txt`, `final.txt`) is not detected. Count of such files was not measured.")
    w("3. `du` totals ~64 GB here against ~61 GB in the slice 1 inventory: a different tool and a "
      "later moment (sessions kept writing during both).")
    w("4. `ls-remote` needs the remote to answer; a checkout whose origin refused would show "
      "`on origin: unknown` in the run's tool. None did in this run. The current tool falls back to the "
      "local `refs/remotes/origin/*` for the count and makes the checkout `origin unreachable: local-only "
      "count unverified`, never `clean and pushed`; an advertisement of more than 16 MiB is killed and read the same way, "
      "never as the part of it that arrived.")
    w("5. A pasture that was clean when created can become dirty or ahead later; this is a snapshot "
      f"at {d['scanned_at']}.")
    w("6. The scan ran with the first version of the tool, which did not look at a checkout's own config "
      "before running git there. The config of the scanned checkouts was not read afterwards for "
      "command-naming keys (`core.fsmonitor`, `core.sshCommand`, `remote.*.uploadpack`, `filter.*`, "
      "`credential.*`, `core.hooksPath`, `include.*`), so this document cannot say none of them ran "
      "something. The current tool scans only a checkout whose config uses allowlisted keys and lists any other as `skipped: unrecognised config <key>`.")
    w("7. The run's `--fetch` could have moved `refs/remotes/origin/<branch>` and `FETCH_HEAD` in the "
      "checkouts where it fetched; which ones it touched was not recorded.")
    w("8. The run's tool read a failed or timed-out git call as \"nothing found\", so a `clean and pushed` "
      "row above is only as good as every git call in that run having succeeded; failures were not "
      "recorded. A fresh scan with the current tool reports such a checkout as "
      "`scan incomplete: <call> rc=<n>`. Likewise whether any scanned checkout was a partial clone "
      "that downloaded objects during the run was not checked.")
    w("9. The run's tool counted only the commits of HEAD that lie on no origin ref, so a `clean and pushed` "
      "row above can still hold commits on another local branch, and a checkout on a detached HEAD or "
      "with an origin that did not answer was never checked against that. A fresh scan with the current "
      "tool counts them over HEAD and every local ref (notes and replace refs included) (`local_only_commits`, `local_only_branches`) "
      "and reports any as `unpushed commits`; none of the rows above was re-checked this way.")
    w("10. `--remote` believes the refs origin advertises (`ls-remote`): an origin that names a ref for an object "
      "it does not hold, or a hostile one that names a local-only commit, makes that commit count as pushed. The "
      "origin is the operator's own server and nothing is deleted by this tool, but a `clean and pushed` verdict "
      "from a `--remote` scan is evidence, not proof of possession: before removing the only checkout of work, "
      "bundle it (`git -C <checkout> bundle create <file> --all`; a `clean and pushed` checkout has no row above) or "
      "fetch the branch from origin into a scratch clone and compare `git rev-parse` (2026-10-23, "
      "Codex pass 56 security review on PR 27).\n")

    # ---- 5 commands
    w("## 5. Commands run\n")
    w("`W` is the slice's scratch dir under "
      "`~/.local/state/bigteam/ade-2026-10-20-phase0-queue/phase0-scan-work`. Besides writing `W`, the "
      "run's only effects outside this pasture were the `fetch` calls described above.\n")
    w("```sh")
    w("python3 -I bin/ade-scan-state --json \\")
    w("  --bigteam ~/.local/state/bigteam \\")
    w("  --ref-root ~/src/djbclark-ade/docs --ref-root ~/ops/site-private/memory \\")
    w("  --ref-root ~/.local/state/handoffs --exclude 'ade-everywhere-phase0-scan-*.md' \\")
    w("  --git-root ~/orca/workspaces --git-root ~/orca/projects --git-root ~/.cow/pastures \\")
    w("  --remote --fetch > $W/scan.json 2> $W/scan.err; echo rc=$? > $W/scan.rc")
    w("python3 -I bin/ade-scan-state-doc $W/scan.json docs/ade-everywhere-phase0-scan-2026-10-20.md")
    w("```\n")
    w("The first command is the run as executed. With the current tool the same scan adds "
      "`--git-root ~/src/djbclark-ade --git-root ~/src/one-offs` (symlinks under a root are not followed), "
      "its `--fetch` is `git -c maintenance.auto=false -c gc.auto=0 fetch --no-auto-maintenance "
      "--no-write-fetch-head --no-tags --refmap= origin refs/heads/<branch>`, every git call runs with "
      "`GIT_NO_LAZY_FETCH=1` (so the only network calls remain `ls-remote` and that fetch), and a "
      "checkout whose config names a command is listed as skipped.\n")
    w("Inside the tool: `du -sk <dir>`; `rg -l -F -w --no-messages -g '!<exclude>' -- <task> <roots>`; "
      "per checkout `git -C <path>` (in the run as executed, with `GIT_OPTIONAL_LOCKS=0` and the caller's "
      "other `GIT_*` variables; now `git --no-optional-locks -c core.fsmonitor=false -c core.hooksPath=/dev/null "
      "-c protocol.ext.allow=never` with every `GIT_*` variable dropped, preceded by `config --list "
      "--show-scope --includes -z`): `rev-parse --abbrev-ref HEAD`, "
      "`status --porcelain`, `rev-parse --abbrev-ref --symbolic-full-name @{u}`, "
      "`rev-list --count @{u}..HEAD`, `rev-list --count HEAD --not --remotes=origin`, `stash list`, "
      "`remote get-url origin`, `ls-remote --heads origin` (now `ls-remote --heads -- <url>` from an empty "
      "directory outside any repository), `rev-list --count HEAD --not --remotes=origin <tip>`, "
      "`fetch --quiet origin <branch>` (only when the tip's objects are missing). "
      "`bin/ade-scan-state ... --markdown` prints the raw tables; this document's tables and prose come from "
      "`bin/ade-scan-state-doc`. Before the run: `ls -la ~/orca/projects`, "
      "`ls -A ~/orca/workspaces/*`, `fd -H .git -d 4 ~/orca/workspaces`, `git -C ~/src/one-offs remote -v` "
      "(no output: no remote), and `du -sk ~/.local/state/bigteam/adhoc-2026-10-18/hm-promo-rehearsal/*` "
      "for 1.1.")
    return "\n".join(out) + "\n"


def main(argv):
    args = [a for a in argv[1:] if a != "--force"]
    if len(args) != 2:
        sys.exit(__doc__)
    check_paths(args[0], args[1], "--force" in argv)
    with open(args[0]) as f:
        d = json.load(f)
    write_atomic(args[1], render(d))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))

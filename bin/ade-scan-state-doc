      "\"no reference\".\n")
    loose = bt.get("loose_files") or []
    w(f"{bs['tasks']} dirs; {len(loose)} loose files at the root "
      f"({', '.join(loose[:6])}{'...' if len(loose) > 6 else ''}).\n")


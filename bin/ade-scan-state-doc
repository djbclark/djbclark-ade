#!/usr/bin/env python3
"""ade-scan-state-doc: render docs/ade-everywhere-phase0-scan-2026-10-20.md from a scan JSON.

  ade-scan-state-doc SCAN.json OUT.md [--force]

SCAN.json is the output of one `bin/ade-scan-state --json` run (the command is in section 5 of the
doc). The tables and counts come from the JSON; the prose, the section 3 capture commands and the
findings about named checkouts are the 2026-10-20 snapshot's and are written here, so a scan taken
on another day needs its own copy of this script. `bin/ade-scan-state --markdown` prints the raw
tables only. The committed doc was rendered from the 2026-10-20 scan, whose JSON was not kept; later
scans regenerate their own doc. Every table cell goes through `esc` (control characters as backslash text,
never a raw CR or newline); a value inside a code span goes through `code`, whose fence is longer than any
backtick run in the value. Section 0 has one row per checkout verdict present (the rows sum to the checkout
count); section 3.2 lists every `origin unreachable` checkout, whatever its counts.

OUT must end in `.md`, must not be SCAN.json, and must not exist unless --force is given; it is
written to a temp file beside it and moved into place, so a failed run leaves OUT as it was.
"""
import json
import os
import re
import shlex
import sys
import tempfile
import time
from urllib.parse import quote
from pathlib import Path

HOME = str(Path.home())
ORIGIN_UNREACHABLE = "origin unreachable: local-only count unverified"  # ade-scan-state's flag text
ORIGIN_CREDENTIAL = "origin url holds a credential or names a remote helper: not queried"  # same: never queried, treated as unreachable
SUBMODULES_FLAG = "submodules not inspected"  # same: no count above covers a submodule's content
SKIP_GIT_SYMLINK = "skipped: .git is a symlink"  # same: the whole-directory archive keeps the link, not its target
SKIP_ALTERNATES = "skipped: submodule config unrecognised (alternates)"  # same: a module's objects live in a store no archive holds
# One patch per stash entry, untracked files and binary content included (`git stash show --include-untracked`,
# git 2.32+): `bundle create` takes ref names, not the reflog's commit ids, so a bundle of `stash@{n}` entries
# cannot be made without writing refs into the checkout (adversary round 26 on PR 27). The entries are listed when
# the command runs, not counted at scan time (a stash pushed since would be skipped), and the loop sits in a
# subshell so a failing `exit 1` ends the loop, not a pasted-into interactive shell (round 27). Slots: <ck>, <path>,
# <path>, <ck>. `${r//[^0-9]/}` (bash and zsh) turns `stash@{3}` into the file name `stash3.patch`. The entries are
# listed into a variable first, `&&`-guarded: `for r in $(false)` is an empty loop that exits 0, which would read as
# "every stash saved" (Codex pass 23 on PR 27); an empty list is a failure too, since this row exists only when the
# scan saw a stash, EXCEPT that an empty reflog beside a live `refs/stash` (`git reflog expire --expire=now --all`) is a
# stash `stash_count` counts: the loop then runs once over `refs/stash` itself (files `stash.patch` and
# `stash-index.patch`, no digits to keep), and a missing ref still fails inside it (Codex pass 65 on PR 27, P2).
# `$(printf '%s\n' "$l")`, not a bare `$l`: zsh does not word-split a parameter expansion, it
# does split a command substitution.
# `--no-ext-diff --no-textconv --no-color`: a configured external diff driver, textconv filter or `color.ui=always`
# would replace the bytes a patch is meant to keep (an attribute-selected textconv turned a changed binary file
# into an empty patch; Codex pass 30 on PR 27); `--binary` keeps a binary file's content (pass 21)
DIFF_OPTS = "diff --no-ext-diff --no-textconv --no-color --binary"
STASH_FMT = ("mkdir -p <DEST>/{} && ( l=$(git -C {} log -g --format=%gd refs/stash) && {{ [ -n \"$l\" ] || l=refs/stash; }} && for r in $(printf '%s\\n' \"$l\"); do "
             "git -C {} stash show -p --no-ext-diff --no-textconv --no-color --binary --include-untracked \"$r\" > <DEST>/{}/stash${{r//[^0-9]/}}.patch "
             "&& git -C {} diff --no-ext-diff --no-textconv --no-color --binary \"$r^1\" \"$r^2\" > <DEST>/{}/stash${{r//[^0-9]/}}-index.patch || exit 1; done )")
# `stash show -p` is base against the stashed worktree; an entry whose index held another version (`git add`, then
# more edits) keeps that version only in its second parent, which `stash apply --index` would restore and a
# worktree patch alone loses (Codex pass 31 on PR 27): hence the `<base>..<index>` patch per entry
# a `.git` FILE's target (a linked worktree's admin directory, an absorbed submodule's git dir) and its common
# directory, archived only when they are git directories by git's own test (`HEAD` here; `objects` and `refs` in
# the common directory, which is `$g` itself unless `commondir` names another; a linked worktree made before git
# 2.44 has no `refs/` of its own), and nothing is archived before the common directory passed (round 36: a
# directory holding only `HEAD`, a bad `commondir` and private files used to be archived before the failure);
# every failure is loud. The parse follows git's gitfile reader (round 32); a gitfile with a second line is refused
# outright, since git takes the whole file after `gitdir: ` and a first-line parse would archive another directory
# (round 43)
GITDIR_FMT = ("if [ -f {}/.git ]; then {{ {{ IFS= read -r l || [ -n \"$l\" ]; }} < {}/.git "
              "&& ! {{ IFS= read -r l1; IFS= read -r l2 || [ -n \"$l2\" ]; }} < {}/.git "
              "&& case \"$l\" in \"gitdir: \"*) g=${{l#gitdir: }}; g=${{g%$'\\r'}} ;; *) false ;; esac "
              "&& [ -n \"$g\" ] && case \"$g\" in /*) ;; *) g={}/$g ;; esac "
              "&& [ -f \"$g/HEAD\" ] && c=$g && if [ -f \"$g/commondir\" ]; then {{ IFS= read -r c || [ -n \"$c\" ]; }} < \"$g/commondir\" "
              "&& c=${{c%$'\\r'}} && case \"$c\" in /*) ;; *) c=\"$g/$c\" ;; esac; fi "
              "&& [ -d \"$c/objects\" ] && [ -d \"$c/refs\" ] && TAR_OPTIONS= \"$GTAR\" -C \"$g\" -cf <DEST>/{} . "
              "&& if [ -f \"$g/commondir\" ]; then TAR_OPTIONS= \"$GTAR\" -C \"$c\" -cf <DEST>/{} .; fi; }} "
              "|| {{ echo 'gitdir capture FAILED' >&2; false; }}; fi")


def gitdir_values(raw_p, ck):
    return (raw_p, raw_p, raw_p, raw_p, f"{ck}/gitdir.tar", f"{ck}/commondir.tar")


# a `.git` SYMLINK (`skipped: .git is a symlink`): chdir follows the link, so its target is archived behind the same
# git-directory test; a link to a gitfile or to anything else fails loudly, archiving nothing (round 43)
# (a link to a linked worktree's administration directory has `HEAD` and `commondir` but no `objects/` or `refs/` of its
# own: the common directory is archived too, behind the same test as GITDIR_FMT; Codex pass 45)
SYMLINK_GITDIR_FMT = ("g={}/.git && [ -f \"$g/HEAD\" ] && c=$g && if [ -f \"$g/commondir\" ]; then {{ IFS= read -r c || [ -n \"$c\" ]; }} < \"$g/commondir\" "
                      "&& c=${{c%$'\\r'}} && case \"$c\" in /*) ;; *) c=\"$g/$c\" ;; esac; fi "
                      "&& [ -d \"$c/objects\" ] && [ -d \"$c/refs\" ] && TAR_OPTIONS= \"$GTAR\" -C \"$g\" -cf <DEST>/{} . "
                      "&& if [ -f \"$g/commondir\" ]; then TAR_OPTIONS= \"$GTAR\" -C \"$c\" -cf <DEST>/{} .; fi "
                      "|| {{ echo 'gitdir capture FAILED' >&2; false; }}")


def modified_fmt():
    """The modified-files capture for one checkout, or for one submodule (its path and its `<DEST>` directory are
    the values): a worktree patch and an
    index patch (DIFF_OPTS), then an archive of every changed worktree file with its manifest, and a copy of the
    index file. An unmerged entry's bytes are in no patch (`git diff` prints `Binary files differ` or `* Unmerged
    path` for it), so the files themselves are archived too (Codex pass 30 on PR 27): `ls-files --modified` lists
    every tracked path whose worktree differs from the index (unmerged ones included), `diff --cached --diff-filter=d`
    every staged path still present; a path deleted from the worktree has no bytes to keep (`--ignore-failed-read`),
    and the archive always holds `modified.list` so an all-deletions list never makes gtar refuse an empty archive.
    Git's and tar's own read errors (`cannot lstat`: an unsearchable directory; `Cannot open: Permission denied`) go
    to `modified.err` and any line there that is not a plain `warning:` or tar's `Cannot stat: No such file or
    directory` (a deleted path, `LC_ALL=C` keeps the wording) fails the row, printing the file and a message, since
    `--ignore-failed-read` would otherwise turn them into rc 0 (adversary rounds 36 and 37: an ambiguous-refname
    warning is not a loss; Codex pass 34: an unreadable changed file vanished from the archive with rc 0); a listed
    directory (a submodule gitlink whose HEAD moved, a file replaced by a directory) is not recursed into: the
    submodule row covers its content, and its ignored files must not be copied (round 36). tar's own failure (an
    unwritable archive path) prints its stderr and fails the row instead of hiding behind the later grep; a tracked
    path whose parent is now a file (`Cannot stat: Not a directory`) has nothing to keep, like a missing one; a
    `TAR_OPTIONS` from the operator's environment must not change the archive (round 40). An unmerged entry's stage
    blobs (`ls-files -u`) may be reachable from no ref (a conflict against a commit since dropped, a `read-tree` or
    `update-index` state): the patches print `Binary files differ` / `* Unmerged path` for them and the index copy
    names objects the deleted checkout no longer has, so every object `ls-files -u` names is packed to
    `unmerged-<hash>.pack` (`pack-objects` fails loudly on a missing object; no unmerged entry gives an empty
    pack) (Codex pass 39)."""
    w, d = "git -C {}", "<DEST>/{}"
    return (f"mkdir -p {d} && {w} {DIFF_OPTS} > {d}/modified.patch && {w} {DIFF_OPTS} --cached > {d}/staged.patch "
            f"&& {w} ls-files -z --modified > {d}/modified.list 2> {d}/modified.err "
            f"&& {w} diff --cached -z --name-only --diff-filter=d >> {d}/modified.list 2>> {d}/modified.err "
            f"&& {{{{ TAR_OPTIONS= LC_ALL=C \"$GTAR\" -cf {d}/modified.tar -C {d} modified.list -C {{}} --null --no-recursion --ignore-failed-read -T {d}/modified.list 2>> {d}/modified.err "
            f"|| {{{{ cat {d}/modified.err >&2; echo 'modified capture FAILED' >&2; false; }}}}; }}}} "
            f"&& {{{{ ! grep -qv -e '^warning: ' -e ': Cannot stat: No such file or directory$' -e ': Cannot stat: Not a directory$' {d}/modified.err || {{{{ cat {d}/modified.err >&2; echo 'modified capture FAILED' >&2; false; }}}}; }}}} "
            f"&& \"$GCP\" -- \"$({w} rev-parse --absolute-git-dir)/index\" {d}/index "
            f"&& {w} ls-files -u > {d}/unmerged.list "
            f"&& \"$GSED\" -n 's/^[0-7]* \\([0-9a-f]*\\) [1-3]\\t.*$/\\1/p' {d}/unmerged.list > {d}/unmerged.ids "
            f"&& GIT_NO_LAZY_FETCH=1 {w} pack-objects {d}/unmerged < {d}/unmerged.ids")


def modified_values(raw_p, ck):
    return (ck, raw_p, ck, raw_p, ck, raw_p, ck, ck, raw_p, ck, ck, ck, ck, raw_p, ck, ck, ck, ck, ck, raw_p, ck,
            raw_p, ck, ck, ck, raw_p, ck, ck)


def stash_values(raw_p, ck):
    return (ck, raw_p, raw_p, ck, raw_p, ck)


# a tracked path marked assume-unchanged (lowercase `ls-files -v` tag) or skip-worktree (`S`): `status` reports
# nothing for it, so its edits are in no count and in no patch; the files themselves are archived with their
# manifest (Codex pass 32 on PR 27). GNU sed's `-z` keeps the NUL-separated names whole, like the untracked archive;
# `t` ends the script after the first substitution, or a path `S x` under tag `h` would print a second name `x`
# (adversary round 38). A hidden path replaced by a directory holds children `status` cannot see (Codex pass 33):
# they are listed through git's own ignore rules (`ls-files --others --exclude-standard` under each hidden path, a
# second manifest `hidden-children.list`) and archived without recursion, so an ignored file or a nested
# repository's content is never copied (adversary round 39). tar's stderr goes to `hidden.err`: `--ignore-failed-read`
# returns 0 with an unreadable file left out, so any line there but `Cannot stat: No such file or directory` (an
# assume-unchanged or sparse path with no file: nothing to keep) or `Not a directory` (its parent is a file now) fails
# the row loudly (Codex pass 34). The children step's stderr goes there too: `ls-files --others` skips an unreadable
# subdirectory with a warning and rc 0, the same loss class (round 40); tar's own failure prints its stderr
HIDDEN_FMT = ("mkdir -p <DEST>/{} && git -C {} ls-files -z -v > <DEST>/{}/hidden.raw "
              "&& \"$GSED\" -z -n 's/^[a-z] //p; t; s/^S //p' <DEST>/{}/hidden.raw > <DEST>/{}/hidden.list "
              "&& < <DEST>/{}/hidden.list xargs -0 -r git --literal-pathspecs -C {} ls-files -z --others --exclude-standard -- > <DEST>/{}/hidden-children.list 2> <DEST>/{}/hidden.err "
              "&& {{ TAR_OPTIONS= LC_ALL=C \"$GTAR\" -cf <DEST>/{}/hidden.tar -C <DEST>/{} hidden.list hidden-children.list -C {} --null --no-recursion --ignore-failed-read "
              "-T <DEST>/{}/hidden.list -T <DEST>/{}/hidden-children.list 2>> <DEST>/{}/hidden.err || {{ cat <DEST>/{}/hidden.err >&2; echo 'hidden capture FAILED' >&2; false; }}; }} "
              "&& {{ ! grep -qv -e ': Cannot stat: No such file or directory$' -e ': Cannot stat: Not a directory$' <DEST>/{}/hidden.err || {{ cat <DEST>/{}/hidden.err >&2; echo 'hidden capture FAILED' >&2; false; }}; }}")


def hidden_values(raw_p, ck):
    return (ck, raw_p, ck, ck, ck, ck, raw_p, ck, ck, ck, ck, raw_p, ck, ck, ck, ck, ck, ck)


# Every emitted tar runs with `TAR_OPTIONS=` cleared: with `TAR_OPTIONS=--exclude=*` in the operator's environment
# GNU tar wrote an empty archive and exited 0 (Codex pass 37; the modified and hidden rows had it since round 40)
UNTRACKED_FMT = ("mkdir -p <DEST>/{} && git -C {} ls-files -z --others --exclude-standard > <DEST>/{} "
                 "&& TAR_OPTIONS= \"$GTAR\" -C {} --null --no-recursion -T <DEST>/{} -cf <DEST>/{}")


def untracked_values(raw_p, ck):
    return (ck, raw_p, f"{ck}/untracked.list", raw_p, f"{ck}/untracked.list", f"{ck}/untracked.tar")


# a de-initialised submodule is an empty directory whose git dir (`<common>/modules/<sub>`) keeps its commits: every
# by-hand command run there acts on the SUPERPROJECT at rc 0 (adversary round 42), so each one in the submodule row
# is gated on the gitlink's `.git` (the scanner has verified it is a gitfile naming a vetted git dir), saying so when
# it stops (round 43: a silent rc 1 reads as "nothing happened"), and the module git dirs themselves are archived,
# which needs no worktree and runs nothing. Since round 47 the row holds one command set per path the scan vetted
# (`submodules_vetted`), that path quoted in every command: the human substitutes and pastes nothing
# `printf '%s\n'`, never `echo`: zsh's builtin and macOS `/bin/sh` interpret backslash escapes in the path (round 47 LOW)
SUB_GUARD = "{{ [ -e {}/.git ] || {{ printf '%s\\n' {} >&2; false; }}; }} && "  # values: the submodule's path, the message
MODULES_FMT = ("mkdir -p <DEST>/{} && d=$(git -C {} rev-parse --git-common-dir) "
               "&& TAR_OPTIONS= \"$GTAR\" -cf <DEST>/{}/modules.tar -C {} -C \"$d\" modules")


def modules_values(raw_p, ck):
    return (ck, raw_p, ck, raw_p)


def vettable(sub):
    """A record path the plan may name: a non-empty string below the checkout, never absolute or holding `..` (the scan
    refuses those itself; this is defence in depth for a hand-edited record, round 47 LOW 3)."""
    return isinstance(sub, str) and bool(sub) and not os.path.isabs(sub) and ".." not in sub.split("/")


def submodule_commands(raw_p, ck, sub):
    """The six guarded by-hand commands for one vetted submodule `sub` (a path below the checkout `raw_p`, as the
    scanner recorded it in `submodules_vetted`), each a code span with every value quoted. The submodule's path
    is the repository value, so each existing format runs unchanged against it; its artifacts go to
    `<DEST>/<ck>/submodules/<sub>`, below a `submodules/` directory of their own so a submodule named like one of the
    checkout's own artifacts (`modified.patch`) cannot collide with it, and two submodules never share one."""
    sp, sd = os.path.join(raw_p, sub), f"{ck}/submodules/{sub}"
    g = (sp, f"submodule {sub}: not a checked-out submodule (skipped)")  # never starts with `~/`, which shquote leaves open
    return [
        shcode(SUB_GUARD + "git -C {} status --porcelain", *g, sp),
        shcode(SUB_GUARD + "git -C {} log --oneline --branches --tags --not --remotes", *g, sp),
        shcode(SUB_GUARD + "mkdir -p <DEST>/{} && GIT_ADVICE=0 GIT_GRAFT_FILE=/dev/null GIT_NO_REPLACE_OBJECTS=1 git -C {} bundle create <DEST>/{}/all.bundle --all",
               *g, sd, sp, sd),
        # a bundle holds committed objects only: the modified, staged and untracked files need the same patches and
        # archive as an ordinary checkout (Codex pass 26 on PR 27)
        shcode(SUB_GUARD + modified_fmt(), *g, *modified_values(sp, sd)),
        # and the index-hidden archive: an assume-unchanged or skip-worktree edit in a submodule is in none of the
        # above (Codex pass 36)
        shcode(SUB_GUARD + HIDDEN_FMT, *g, *hidden_values(sp, sd)),
        shcode(SUB_GUARD + UNTRACKED_FMT, *g, *untracked_values(sp, sd)),
    ]


# a commit reachable from a reflog alone (a reset, amend or rebase left it): no ref holds it, no bundle above
# carries it, and `git reflog` recovers it only until expiry (Codex pass 32 on PR 27). Its objects go into one
# pack: `rev-list --objects` lists everything the reflogs reach that no ref does (a superset of the count: stash
# entries and origin's live tips included), `pack-objects` packs that list. A partial clone's missing promisor
# objects are listed as nothing to keep, never fetched: the capture plan's rows never reach the network (round 38)
ODD_NAME = "\ufffd"  # what the scanner's lossy decoding leaves of a ref name that is not UTF-8
ODD_NAME_NOTE = " (a branch or tag name is not valid UTF-8, so no push can name it: bundle every ref)"
REFLOG_FMT = ("mkdir -p <DEST>/{} && GIT_ADVICE=0 GIT_NO_LAZY_FETCH=1 GIT_GRAFT_FILE=/dev/null GIT_NO_REPLACE_OBJECTS=1 git -C {} "
              "rev-list --objects --missing=allow-promisor --reflog --not --all > <DEST>/{}/reflog-only.list "
              "&& GIT_ADVICE=0 GIT_NO_LAZY_FETCH=1 GIT_GRAFT_FILE=/dev/null GIT_NO_REPLACE_OBJECTS=1 git -C {} pack-objects <DEST>/{}/reflog-only < <DEST>/{}/reflog-only.list")


def reflog_values(raw_p, ck):
    return (ck, raw_p, ck, raw_p, ck, ck)


class Home(str):
    """A path the generator abbreviated with `~` (`tilde`): the only value `shquote` leaves a leading `~` unquoted for.
    A relative value that merely starts with `~/` (a report or an embedded directory named `~`) is data, quoted
    literally (Codex pass 56 on PR 27, P2). Joining another piece on keeps the mark."""
    def __add__(self, other):
        return Home(str.__add__(self, other))

    def rstrip(self, chars=None):
        return Home(str.rstrip(self, chars))


def tilde(p):
    """`~` for HOME itself, `~/rest` below it (a `Home`); never a substring match (`/tmp/root/x` with HOME `/root`)."""
    if p == HOME:
        return Home("~")
    if p.startswith(HOME + os.sep):
        return Home("~" + p[len(HOME):])
    return p


def checkout_dir(p):
    """The directory below `<DEST>` that holds everything captured from one checkout. Built from the full path,
    so two checkouts that share a basename (`~/src/foo`, `~/.cow/pastures/x/foo`) never share an artifact name
    (Codex pass 8 on PR 27); `home/` and `abs/` keep a path below HOME apart from one outside it."""
    t = tilde(p)
    if t == "~":
        return "checkouts/home"
    if t.startswith("~/"):
        return "checkouts/home/" + t[2:]
    return "checkouts/abs/" + t.lstrip("/")


def num(v):
    """A scan count as an int: the null of a skipped or incomplete record (no counts) is 0."""
    return v if isinstance(v, int) and not isinstance(v, bool) else 0


def human(n):
    v = float(n)
    for u in ("B", "K", "M", "G"):
        if v < 1024 or u == "G":
            return f"{v:.0f}{u}" if u == "B" else f"{v:.1f}{u}"
        v /= 1024


# the shell state every plan command assumes: GNU tools by name, and the scanner's own git environment (it drops every
# `GIT_*` variable and the global and system config, `git_env()`): with `GIT_DIR` set, `git -C <checkout> ls-files` read
# another repository's index and the tar that followed succeeded without the checkout's files (Codex pass 42)
PLAN_PREAMBLE = ("GCP=$(command -v gcp || command -v cp); GTAR=$(command -v gtar || command -v tar); "
                 "GSED=$(command -v gsed || command -v sed); "
                 "unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR "
                 "GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT; "
                 "_E=$(env) || echo 'env failed: GIT_* not cleared' >&2; "
                 "while IFS= read -r _L; do case ${_L%%=*} in GIT_*[!A-Za-z0-9_]*) ;; GIT_?*) case $_L in *=*) unset \"${_L%%=*}\";; esac;; esac; done <<< \"$_E\"; "
                 "unset _E _L; "
                 "export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 GIT_NO_LAZY_FETCH=1; "
                 "case $(git version 2>/dev/null) in \"git version \"[3-9].*|\"git version 2.\"4[5-9]*|\"git version 2.\"[5-9][0-9]*|\"git version 2.\"[1-9][0-9][0-9]*|\"git version \"[1-9][0-9]*.*) ;; "
                 "*) echo 'git older than 2.45 ignores GIT_NO_LAZY_FETCH: in a partial clone a capture may download from origin' >&2;; esac")


def esc(value, in_code=False):
    """One markdown table cell: `|` escaped; outside a code span `<`, `>`, `&` are HTML-escaped and backticks
    backslash-escaped. Inside a code span (a pasted command) only `|` is escaped: CommonMark and GFM decode no entity in
    a code span, so `&amp;` there would be shown, copied and run as five characters, and a submodule path `R&D` would
    reach the guard as `R&amp;D`, a "not a checked-out submodule (skipped)" for a real checkout (adversary round 47,
    MEDIUM); `code` fences with more backticks instead. Every control character (a bare CR ends a line in CommonMark)
    is shown as `visible()` text, never the raw byte."""
    text = "-" if value is None else str(value)
    if not in_code:
        text = text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
    text = text.replace("|", "\\|")
    if not in_code:
        text = text.replace("`", "\\`")
    return visible(text)


_CTRL = re.compile(r"[\x00-\x1f\x7f]")


def visible(v):
    """A value that is shown, never pasted, in a code span: control characters as backslash-n, -r, -t or -xNN text."""
    named = {"\n": "\\n", "\r": "\\r", "\t": "\\t"}
    return _SURROGATE.sub(lambda m: f"\\x{ord(m.group()) - 0xdc00:02x}",   # the byte, as `_quote` writes it (round 48 INFO 7)
                          _CTRL.sub(lambda m: named.get(m.group()) or f"\\x{ord(m.group()):02x}", str(v)))


def shcode(fmt, *values):
    """A code span holding a shell command: every value is `shlex.quote`d before `code()` escapes it for markdown,
    so a checkout path or branch name shaped like `side$(touch x)` cannot run anything when the cell is pasted
    (adversary round 8 on PR 27, 2026-10-20)."""
    return code(fmt, *[shquote(v) for v in values])


def shquote(v):
    """`shlex.quote`, except that a leading `~/` of a `Home` value (the generator's own home abbreviation,
    `tilde()`) stays outside the quotes so the shell still expands it: `~/'a b'/c`, never `'~/a b/c'`; a bare
    `~` (the home directory itself) stays unquoted too (adversary round 9, Codex pass 6). A plain string that
    starts with `~/` is a literal name and is quoted whole (Codex pass 56 on PR 27, P2). A value with a control character
    (newline, carriage return, tab, ...) is ANSI-C quoted, `$'a\\nb'`, which bash and zsh accept: `shlex.quote`
    keeps a raw newline, a markdown table row cannot, and turning it into a space would paste a different path
    (Codex pass 15 on PR 27)."""
    if isinstance(v, Home):
        if v == "~":
            return "~"
        if v.startswith("~/"):
            return "~/" + _quote(str(v)[2:]) if v[2:] else "~/"
    return _quote(str(v))


_SURROGATE = re.compile("[\udc80-\udcff]")  # a byte that is not UTF-8, as `surrogateescape` carries it in the scan JSON


def _quote(v):
    if not _CTRL.search(v) and not _SURROGATE.search(v):
        return shlex.quote(v)
    named = {"\n": "\\n", "\r": "\\r", "\t": "\\t", "\\": "\\\\", "'": "\\'"}
    # a lone surrogate is the original byte (`\xff`): the command names the path as it is on disk, and the file stays
    # valid UTF-8 (Codex pass 42 P2: the generator died with UnicodeEncodeError on a checkout named with byte 0xff)
    return "$'" + "".join(named.get(ch) or (f"\\x{ord(ch) - 0xdc00:02x}" if _SURROGATE.match(ch)
                                          else f"\\x{ord(ch):02x}" if _CTRL.match(ch) else ch) for ch in v) + "'"


def code(fmt, *values):
    """A code span: `fmt` (literal text, `{}` slots) with each value escaped, fenced with more
    backticks than the longest run in the result. A control character in a value is refused (ValueError)
    rather than turned into a space: shell values come through `shquote`, display values through `visible`."""
    for v in values:
        if _CTRL.search(str(v)):
            raise ValueError(f"control character in a code span value: {str(v)!r}")
    # a GFM table row ends a cell at every unescaped `|`, inside a code span too: the format's own pipes (`||`, `|`
    # in a `while read` loop) are escaped like a value's, so the rendered cell is one cell (adversary round 48)
    text = fmt.replace("|", "\\|").format(*[esc(v, in_code=True) for v in values])
    runs = re.findall(r"`+", text)
    if not runs:
        return f"`{text}`"
    fence = "`" * (max(len(r) for r in runs) + 1)
    return f"{fence} {text} {fence}"


def day(t):
    return time.strftime("%Y-%m-%d", time.localtime(t))


def check_paths(src, out, force):
    """Refuse an OUT that would destroy the input, a non-markdown file or an existing file."""
    src, out = Path(src), Path(out)
    if out.resolve() == src.resolve():
        sys.exit(f"refusing: OUT is the input {src}")
    if out.suffix != ".md":
        sys.exit(f"refusing: OUT {out} does not end in .md")
    if out.is_dir():
        sys.exit(f"refusing: OUT {out} is a directory")
    if out.exists() and not force:
        sys.exit(f"refusing: {out} exists (--force replaces it)")


def write_atomic(out, text):
    """Temp file beside OUT, then os.replace: OUT is whole before and whole after."""
    out = Path(out)
    fd, tmp = tempfile.mkstemp(dir=out.parent, prefix=f".{out.name}.", suffix=".tmp")
    try:
        # `backslashreplace`: a lone surrogate left in displayed text (a verdict, a cell) is written as `\udcff`, never an error
        with os.fdopen(fd, "w", encoding="utf-8", errors="backslashreplace") as f:
            f.write(text)
        umask = os.umask(0)
        os.umask(umask)
        os.chmod(tmp, 0o666 & ~umask)
        os.replace(tmp, out)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def render(d):
    # a scan can hold one category only (`--git` without `--bigteam`, or the reverse): the missing one renders empty
    # instead of raising KeyError (Codex pass 55 on PR 27, P2)
    bt = d.get("bigteam") or {"root": None, "tasks": [], "loose_files": []}
    cos = d.get("checkouts") or []
    sm = d.get("summary") or {}
    # the scanned root (`--bigteam`), never a hard-coded default: the capture rows must read the tree that was
    # scanned (Codex pass 14 on PR 27); `.get` for a scan written before the key existed
    bt_root = tilde(bt.get("root") or os.path.join(HOME, ".local/state/bigteam"))
    tasks = sorted(bt["tasks"], key=lambda t: -t["bytes"])
    uniq = [t for t in tasks if t["verdict"] == "unique"]
    mixed = [t for t in tasks if t["verdict"] == "mixed"]
    scr = [t for t in tasks if t["verdict"] == "scratch"]
    open_jobs = sum(len(t["open_job_records"]) for t in tasks)
    tasks_open_jobs = sum(1 for t in tasks if t["open_job_records"])
    bs = {"tasks": 0, "verdicts": {}, "total_bytes": 0, "unique_bytes": 0, "scratch_bytes": 0, "incomplete": 0,
          **(sm.get("bigteam") or {})}
    cs = {"count": 0, "verdicts": {}, "with_unpushed_work": 0, "with_local_only_commits": 0, "with_untracked": 0,
          "with_stash": 0, "skipped": 0, "incomplete": 0, **(sm.get("checkouts") or {})}
    unpushed = [c for c in cos if "unpushed commits" in c["flags"] or "orphan branch" in c["flags"]]
    out = []
    w = out.append

    w("# Phase 0 scan: bigteam task dirs and Orca / cow checkouts (2026-10-20)\n")
    w("Phase 0, slice 3 of [ade-everywhere-proposal.md](ade-everywhere-proposal.md) §8 item 1 "
      "(djbclark, 2026-10-20: \"Scan `~/.local/state/bigteam` and the Orca checkouts for unique reports, "
      "dirty trees, untracked files and unpushed commits and capture them. Nothing is deleted.\"). "
      "Nothing was moved, committed, stashed, checked out or deleted outside this pasture. The network "
      "calls were `git ls-remote --heads origin` and, only where an origin tip could not be compared "
      "with HEAD, `git fetch origin <branch>`: that run used the first version of `--fetch`, which "
      "downloaded the branch's objects but also rewrote `FETCH_HEAD`, may have updated "
      "`refs/remotes/origin/<branch>` and may have run auto-maintenance in that checkout (the tool now "
      "writes no refs, section 5). The first version also ran git inside each checkout with that "
      "checkout's own config in force, so a `core.fsmonitor` or `remote.*.uploadpack` line there would "
      "have run (the tool now skips such a checkout, section 5); whether any scanned checkout carried one "
      "was not checked (section 4). The first version also treated a git call that failed or timed out as "
      "\"nothing found\" and had no guard against a partial clone downloading objects during a count; the "
      "tool now reports `scan incomplete: <call> rc=<n>` for the first and sets `GIT_NO_LAZY_FETCH=1` on "
      "every git call for the second (section 4). Numbers below come from one real run of "
      "[`bin/ade-scan-state`](../bin/ade-scan-state) at "
      f"{d['scanned_at']} (commands in section 5); rerun it for a fresh scan. This document is "
      "rendered from that run's JSON by [`bin/ade-scan-state-doc`](../bin/ade-scan-state-doc). Slice 1 context: "
      "[ade-everywhere-inventory-2026-10-20-stores.md](ade-everywhere-inventory-2026-10-20-stores.md) "
      "§2 rows for bigteam and Orca, and the Orca section of "
      "[ade-everywhere-inventory-2026-10-19.md](ade-everywhere-inventory-2026-10-19.md).\n")

    w("## 0. Summary\n")
    w("| Measure | Value |\n|---|---|")
    w(f"| bigteam task dirs scanned | {bs['tasks']} ({human(bs['total_bytes'])} by `du -sk`) |")
    w(f"| verdict `unique` | {bs['verdicts'].get('unique', 0)} dirs, "
      f"{sum(t['bytes'] for t in uniq) / 2**20:.1f} MiB whole-dir |")
    w(f"| verdict `mixed` | {bs['verdicts'].get('mixed', 0)} dirs, "
      f"{sum(t['bytes'] for t in mixed) / 2**20:.0f} MiB whole-dir |")
    w(f"| verdict `scratch` | {bs['verdicts'].get('scratch', 0)} dirs, "
      f"{sum(t['bytes'] for t in scr) / 2**30:.1f} GiB whole-dir |")
    w(f"| bytes `unique` (report files no other document references) | {bs['unique_bytes']:,} B "
      f"({bs['unique_bytes'] / 2**20:.2f} MiB) |")
    w(f"| bytes `scratch` (everything else under bigteam) | {bs['scratch_bytes']:,} B "
      f"({bs['scratch_bytes'] / 2**30:.1f} GiB) |")
    w(f"| job records with no `closed` key | {open_jobs} in {tasks_open_jobs} task dirs |")
    w(f"| git checkouts scanned | {cs['count']} |")
    shown = ("clean and pushed", "unpushed commits", "orphan branch", "dirty")
    for k in (*shown, *sorted(k for k in cs["verdicts"] if k not in shown)):
        # one row per verdict present, so the rows sum to the checkout count (adversary round 21, INFO 5)
        w(f"| checkouts, verdict {code('{}', visible(k))} | {cs['verdicts'].get(k, 0)} |")
    w(f"| checkouts with unpushed work (unpushed commits, orphan branch or unpushed tags) | **{cs['with_unpushed_work']}** |")
    w(f"| checkouts with untracked non-ignored paths | {cs['with_untracked']} |")
    w(f"| checkouts with a stash | {cs['with_stash']} |")
    incomplete_tasks = [t for t in tasks if t["verdict"].startswith("scan incomplete")]
    w(f"| bigteam task dirs with `scan incomplete` (reference search failed) | {len(incomplete_tasks)} |")
    w(f"| checkouts `skipped` or `scan incomplete` (no counts; listed in 3.2 with a whole-directory archive) | "
      f"{num(cs.get('skipped')) + num(cs.get('incomplete'))} |")
    w("")
    w("The three items that most need a human decision:\n")
    w("1. **`~/src/one-offs` has no `origin` remote at all** and 37 commits (plus the Orca worktree "
      "`~/orca/workspaces/one-offs/Hermes`, 2 commits, same repo). Nothing outside this Mac holds them; "
      "the only copy is this disk. Decide where it is hosted (a new repo needs the where-does-it-go "
      "question, rule 23) or take a bundle (section 3).")
    w("2. **Where the 41 `unique`/`mixed` bigteam report sets are preserved** "
      f"({bs['unique_bytes'] / 2**20:.1f} MiB of report markdown; the rest of those dirs is logs and "
      "worktrees). One destination answers all of them; two dirs (`emufix`, `wdfollow`) and several "
      "`unique` ones have an open `CLAIM`, so a session may still be writing there.")
    w("3. **Five more checkouts hold commits that exist on no origin branch** "
      "(`you-can-compact-yourself` 2, `aiuse-integration` 2, `crush-merge-v0981` 8, "
      "`opencode-v2` 1, `clinepass-pr44379` 2 plus a stash). Pushing a branch is outward-facing, so "
      "djbclark picks push or bundle per repo (section 3).")
    w("")
    w("A fourth finding that is not a decision yet: **54.5 GiB of the 60 GiB is one scratch tree**, "
      "`adhoc-2026-10-18/hm-promo-rehearsal/` (Hermes promotion rehearsal homes and snapshots). "
      "Deleting it is a later cleanup decision, not part of Phase 0.\n")

    # ---- 1 bigteam
    w(f"## 1. bigteam ({code('{}/<task>/', visible(bt_root))})\n")
    w("**Method.** One row per task dir. *Size* is `du -sk`; *newest* is the newest mtime within two "
      "levels; *CLAIM* is `DONE` when the last non-blank line of `CLAIM` starts with `DONE`, `open` "
      "when a `CLAIM` exists without it, `no CLAIM` otherwise; *reports* are `*report*.md` files within "
      "three levels (not inside a git checkout) and whether `<file>.done` exists; *open jobs* counts "
      "`jobs/*.json` records with no `closed` key (a record written by `acp-dispatch` before it is "
      "reaped or closed; most are finished slices nobody closed, so this is a loose end, not lost "
      "data). Verdicts: `unique` = at least one report file and no document under "
      "`~/src/djbclark-ade/docs`, `~/ops/site-private/memory` or `~/.local/state/handoffs` mentions the "
      "task name (whole word, `rg -l -F -w`), and the dir is at most 5 MiB; `mixed` = the same but the "
      "dir is larger (logs, worktrees, caches around the reports); `scratch` = no report file, or every "
      "report's task name is already referenced elsewhere. **A reference proves a mention, not a copy**, "
      "and a short common task name can match by accident, so `scratch` for a dir that has reports means "
      "\"cited somewhere\", not \"safe to delete\"; the 93 scratch dirs have not been read. A fresh scan with the "
      "current tool marks a task dir whose `rg`/`grep` search failed (exit above 1, or a timeout) "

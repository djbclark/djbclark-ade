#!/usr/bin/env python3
"""Approve pending tool-permission requests for a lead's descendants, its `ade.lead=<lead>` workers,
selected ADE labels or, with `--all-local`, every agent this host's daemon lists. A request that is a question
or plan approval meant for the operator is skipped in any mode (best-effort name denylist, and only for
providers whose question names are known: claude, codex, opencode, pi, omp)."""
import argparse
from datetime import datetime, timezone
import fcntl
import json
import math
import os
import re
from pathlib import Path
import subprocess
import sys
import time
import uuid

sys.path.insert(0, str(Path(__file__).resolve().parent))
import ade_lead_succession as succ  # noqa: E402


class ProbeError(Exception):
    """An untrusted/unavailable CLI response; never authorizes a write."""


def identifier(value):
    try:
        return str(uuid.UUID(value)) == value
    except (ValueError, TypeError, AttributeError):
        return False


def call(args):
    # Local daemon only: never pass --host, and drop any host override from the environment.
    env = {k: v for k, v in os.environ.items() if k != "PASEO_HOST"}
    try:
        result = subprocess.run(["paseo", *args, "--json"], capture_output=True,
                                text=True, timeout=30, check=False, env=env)
        if result.returncode:
            raise ProbeError("paseo command failed")
        return json.loads(result.stdout)
    except (OSError, subprocess.TimeoutExpired, ValueError) as exc:
        raise ProbeError("paseo command unavailable or invalid JSON") from exc


def rows(value):
    if not isinstance(value, list):
        raise ProbeError("expected JSON list")
    return value


# A request that is a question or plan/mode approval for the operator must stay pending. Paseo's request
# kinds are tool|plan|question|mode|other, but `permit ls --json` rows expose only `name` (no `kind`; a kind
# is honoured when a row carries one), so this is a name-based, best-effort DENYLIST. A missing or empty name or
# a non-`tool` kind fails closed; an unlisted question name is NOT caught, so only providers in
# CLASSIFIED_PROVIDERS, whose names are known, are served. Names read from Paseo's source (2026-11-14): Claude
# AskUserQuestion / ExitPlanMode (every other Claude tool, `mcp__server__tool` included, is kind `tool`), Codex
# CodexPlanApproval / CodexMcpElicitation / request_user_input (CodexBash and CodexFileChange are tools),
# OpenCode question, Pi "Pi ask_user" / "Pi select|input|editor|confirm", OMP "OMP ask" / "OMP select|...", ACP
# switch_mode. Every provider fills `name`; `kind` is absent from the CLI rows for all of them.
#
# Matching: a name is split into words (separators and camelCase, so "TaskStop" is task+stop and "Task" is not
# "ask"). TOKENS are whole words. STEMS are matched in the run-together name (separators removed, so run-together
# and all-caps spellings still match); only WORD_START_STEMS must begin at a word start (so "task_user" is a tool
# and "ask_user" is not). Each match yields a rule label that the audit log records.
CLASSIFIED_PROVIDERS = {"claude", "codex", "opencode", "pi", "omp"}  # question names read from Paseo's source
STEMS = ("question", "elicit", "askuser", "userinput", "exitplan", "enterplan", "planmode", "planapproval",
         "switchmode", "requestinput")
WORD_START_STEMS = {"askuser"}  # short enough to occur inside other words ("task_user"); the rest match anywhere
TOKENS = {"ask", "plan", "mode", "prompt", "dialog", "approval", "approve", "choose", "choice", "answer"}
UI_TOKENS = {"select", "input", "editor", "confirm"}  # Pi/OMP extension-UI methods
# `mcp__<server>__<tool>` is a third-party MCP tool the model calls: approving it runs the tool and answers no
# question or plan, so only the STEMS (a tool that is itself a question or elicitation) keep it pending; the
# generic TOKENS and UI_TOKENS ("browser_select", "ask_gemini") do not.
# HOLD_TOOLS is an explicit hold list, not an allowlist (the operator wants no prompts, so unknown tools stay
# approvable): tools that act on ANOTHER agent's pending cards, mode or turn, or defer a prompt. A held tool is
# found in the run-together name under ANY prefix or suffix (OpenCode asks as `<server>_<tool>`, Claude as
# `mcp__<server>__<tool>`; `_v2`/`_async` variants too), case-folded and camelCase-split. respond_to_permission
# answers a card; set_agent_mode and update_agent (modeId) can widen an agent to bypassPermissions;
# send_agent_prompt or a steer denies every pending question and plan of its target; send_terminal_keys types into
# a TUI prompt and kill_terminal destroys it; cancel/kill/archive_agent and archive_workspace abort the turns that
# hold cards; create/update_schedule, run_schedule_once, resume_schedule and create_heartbeat set, fire or re-arm
# deferred prompts and modes. The tests classify Paseo's 41 core MCP tools and its 22 conditional browser tools (a hand
# list, not read from Paseo's source: a new Paseo tool is approved until added). `create_agent` and `stop_workspace_script`
# stay approvable on purpose (fan-out needs the first; a stopped dev server answers no card; operator trust ruling
# 2026-11-13). A shell `paseo` command run through Bash, or Paseo's browser tools driving the daemon web UI, are approved
# like any other tool: the hold covers Paseo's card/mode/turn MCP tools only.
HOLD_TOOLS = ("respond_to_permission", "set_agent_mode", "update_agent", "send_agent_prompt", "send_terminal_keys",
              "kill_terminal", "cancel_agent", "kill_agent", "archive_agent", "archive_workspace", "create_schedule",
              "update_schedule", "run_schedule_once", "resume_schedule", "create_heartbeat")
TOOL_SHAPE = re.compile(r"[A-Za-z][A-Za-z0-9_.:\-]{0,159}( [a-z_]{1,32})?")  # an identifier or "Pi method", never a command line
# A logged name that looks like a credential is redacted: a known token prefix at a name start/separator, or a long run.
CREDENTIAL = re.compile(r"(?:^|[_\-\s])(?:gh[pousr]_|github_pat_|sk-|sk_(?:live|test)_|xox[a-z]-|glpat-|AIza)"
                        r"|AKIA[0-9A-Z]{16}|[A-Za-z0-9+/=]{32,}")


def words(name):
    spaced = re.sub(r"([a-z0-9])([A-Z])", r"\1 \2", name)
    spaced = re.sub(r"([A-Z]+)([A-Z][a-z])", r"\1 \2", spaced)
    return [w for w in re.split(r"[^A-Za-z0-9]+", spaced.lower()) if w]


def tool_name(row, provider=None):
    """The permission row's `name` only (never arguments or descriptions), for the audit log. Only a classified
    provider's name that has the shape of a tool identifier is logged: ACP providers fill `name` with a free-text
    tool title (it can be a command line), which is redacted, as is any name that is not an identifier."""
    name = row.get("name") if isinstance(row, dict) else None
    if not isinstance(name, str):
        return None
    if provider not in CLASSIFIED_PROVIDERS or not TOOL_SHAPE.fullmatch(name) or CREDENTIAL.search(name):
        return "<redacted>"
    return name


def is_mcp_tool(name):
    parts = name.split("__")
    return len(parts) >= 3 and parts[0] == "mcp" and bool(parts[1]) and bool(parts[-1])


def classify(row):
    """The denylist rule that keeps this request pending for the operator, else None (a tool prompt).
    Missing/odd fields fail closed (`missing-name`, `kind`)."""
    name, kind = row.get("name"), row.get("kind")
    if kind is not None and kind != "tool":
        return "kind"
    parts = words(name) if isinstance(name, str) else []
    if not parts:
        return "missing-name"
    compact = "".join(parts)
    starts, offset = [], 0
    for part in parts:
        starts.append(offset)
        offset += len(part)
    for stem in STEMS:
        if any(compact.startswith(stem, at) for at in starts) if stem in WORD_START_STEMS else stem in compact:
            return f"stem:{stem}"
    for held in HOLD_TOOLS:
        if held.replace("_", "") in compact:
            return f"hold:{held}"
    if is_mcp_tool(name):
        return None
    if name.startswith("mcp__"):
        return "malformed-mcp-name"  # server or tool segment missing: not a name Paseo's providers emit
    for token in parts:
        if token in TOKENS:
            return f"token:{token}"
    for token in parts:
        if token in UI_TOKENS:
            return f"ui-token:{token}"
    return None


def operator_question(row):
    """True when the request must stay pending for the operator."""
    return classify(row) is not None


def log_event(log, decision, reason, agent=None, request=None, tool=None, rule=None):
    # Never record tool arguments, descriptions, stdout or stderr (may contain secrets): `tool` is the row's
    # `name` field only and `rule` is the denylist rule label that matched (None: no rule, a tool prompt).
    log.write(json.dumps(dict(time=datetime.now(timezone.utc).isoformat(),
                              decision=decision, reason=reason,
                              agent=agent, request=request, tool=tool, rule=rule)) + "\n")
    log.flush()


LOGGED_LINEAGE = set()  # one audit row per change, not one per 2 s sweep


def lead_lineage(lead, log):
    """(current lead, every lead whose descendants and labelled workers qualify, ids to ask `ls --label` about).
    `--lead` is followed through completed self-handoffs: a handoff must not leave this job approving the dead lead's workers
    only (2026-11-14). A cyclic ledger narrows to `--lead` itself (never wider) and is audited."""
    try:
        current = succ.effective_lead(lead)
        leads = {lead} | succ.lineage(current)
        queried = list(dict.fromkeys([lead, *succ.recent_lineage(current)]))
    except succ.SuccessionError as exc:
        key = ("cycle", lead)
        if key not in LOGGED_LINEAGE:
            LOGGED_LINEAGE.add(key)
            log_event(log, "error", "succession-ledger-inconsistent", rule=str(exc)[:200])
        return lead, {lead}, [lead]
    key = (lead, current, len(leads))
    if leads != {lead} and key not in LOGGED_LINEAGE:
        LOGGED_LINEAGE.add(key)
        log_event(log, "lineage", f"current={current} members={len(leads)}")
    return current, leads, queried


def descendant(agent, lead, cache):
    leads = {lead} if isinstance(lead, str) else set(lead)  # one id, or the lineage of a handed-off lead
    if agent in leads:
        return False
    seen = set()
    while agent not in seen:
        seen.add(agent)
        if agent not in cache:
            info = call(["agent", "inspect", agent])
            if not isinstance(info, dict) or info.get("Id") != agent:
                raise ProbeError("agent identity mismatch")
            cache[agent] = info.get("ParentAgentId")
        parent = cache[agent]
        if parent is None:
            return False
        if not identifier(parent):
            raise ProbeError("invalid parent id")
        if parent in leads:
            return True
        agent = parent
    return False


def sweep(lead, labels, log, all_local=False):
    current, leads, queried = lead_lineage(lead, log)
    requests = rows(call(["permit", "ls"]))
    eligible = {}
    # This host's daemon only (no --host): remote hosts' agents are never in this list. It also gives each
    # agent's provider, which decides whether its question names are known (CLASSIFIED_PROVIDERS).
    providers = {}
    for row in rows(call(["ls", "-a", "-g"])):
        if not isinstance(row, dict) or not identifier(row.get("id")):
            raise ProbeError("invalid local agent")
        provider = row.get("provider")
        providers[row["id"]] = provider.split("/")[0].lower() if isinstance(provider, str) else ""
    # Installed CLI inspect/ls do not expose labels. Exact server-side filters prove them.
    # The lead's own `ade.lead=<lead>` label is always checked: a lead launches top-level
    # (env-stripped) workers that are not descendants, and they carry that label.
    for reason, label in ([("lead-label", f"ade.lead={x}") for x in queried]
                          + [("ade-label", v) for v in labels]):
        for row in rows(call(["ls", "-a", "-g", "--label", label])):
            if not isinstance(row, dict) or not identifier(row.get("id")):
                raise ProbeError("invalid labelled agent")
            eligible.setdefault(row["id"], reason)
    cache, seen, failed = {}, set(), False
    for row in requests:
        if not isinstance(row, dict):
            log_event(log, "skip", "malformed-request")
            failed = True
            continue
        agent, request = row.get("agentId"), row.get("id")
        if not identifier(agent) or not isinstance(request, str) or not request or request.startswith("-"):
            log_event(log, "skip", "malformed-request")
            failed = True
            continue
        if (agent, request) in seen:
            continue
        seen.add((agent, request))
        tool, rule = tool_name(row, providers.get(agent)), classify(row)
        event = dict(tool=tool, rule=rule)
        if any(r is not row and isinstance(r, dict) and r.get("agentId") == agent
               and isinstance(r.get("id"), str) and r["id"] != request and r["id"].startswith(request)
               for r in requests):
            # `paseo permit allow` matches ids by prefix and takes the first hit: another pending id that
            # starts with this one could be answered instead (e.g. a question). Never allow such an id.
            # Snapshot-only: a prefix-colliding id that appears after this `permit ls` is not seen.
            log_event(log, "skip", "ambiguous-request-id", agent, request, **event)
            failed = True
            continue
        if rule is not None:
            # A question or plan approval is the operator's to answer. Checked before scope, in every mode.
            log_event(log, "skip", "operator-question", agent, request, **event)
            continue
        if agent not in providers:
            log_event(log, "skip", "outside-scope", agent, request, **event)
            continue
        if providers[agent] not in CLASSIFIED_PROVIDERS:
            # ACP-backed providers name questions by tool kind or free-text title, so a question cannot be
            # told from a tool prompt by name; their prompts stay for the operator.
            log_event(log, "skip", "unclassified-provider", agent, request, **event)
            continue
        try:
            if agent in leads:
                reason = None
            elif agent in eligible:
                reason = eligible[agent]
            else:
                try:
                    reason = "descendant" if descendant(agent, leads, cache) else None
                except ProbeError:
                    if not all_local:
                        raise
                    reason = None  # all-local does not depend on ancestry; local membership decides
            if reason is None and all_local and agent in providers:
                reason = "all-local"
            if reason is None:
                log_event(log, "skip", "outside-scope", agent, request, **event)
                continue
            # Audit intent BEFORE the only mutation. An audit failure aborts approval.
            log_event(log, "allow-attempt", reason, agent, request, **event)
            response = rows(call(["permit", "allow", agent, request]))
            if not any(isinstance(r, dict) and r.get("agentId") == agent
                       and r.get("requestId") == request and r.get("result") == "allowed"
                       for r in response):
                raise ProbeError("unconfirmed allow")
            log_event(log, "allowed", reason, agent, request, **event)
        except ProbeError:
            log_event(log, "error", "probe-or-allow-unconfirmed", agent, request, **event)
            failed = True
    return 1 if failed else 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--lead", required=True, help="full lead UUID (the lead itself is excluded unless --all-local)")
    parser.add_argument("--ade-label", action="append", default=[], metavar="ade.KEY=VALUE",
                        help="exact ADE label selectors; any matching selector qualifies")
    parser.add_argument("--all-local", action="store_true",
                        help="also approve every local agent of a classified provider (claude, codex, opencode, pi, omp), "
                             "the lead included (never a remote host's; best-effort skip of operator "
                             "questions and plan approvals; other providers keep their prompts)")
    parser.add_argument("--log", required=True, type=Path, help="append-only JSONL audit path")
    parser.add_argument("--watch", action="store_true")
    parser.add_argument("--interval", type=float, default=2)
    parser.add_argument("--duration", type=float, default=3600, help="watch lifetime in seconds")
    args = parser.parse_args()
    if not identifier(args.lead):
        parser.error("--lead must be a full canonical UUID")
    if any(not v.startswith("ade.") or "=" not in v or not v.split("=", 1)[0][4:]
           for v in args.ade_label):
        parser.error("--ade-label must be ade.KEY=VALUE")
    if any(not math.isfinite(v) or v <= 0 for v in (args.interval, args.duration)):
        parser.error("interval and duration must be finite and positive")
    args.log.parent.mkdir(parents=True, exist_ok=True)
    # One writer per audit path; cron/launchd overlap must not double-allow.
    with args.log.with_suffix(args.log.suffix + ".lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 1
        with args.log.open("a", encoding="utf-8") as log:
            deadline = time.monotonic() + args.duration
            status = 0
            while not args.watch or time.monotonic() < deadline:
                try:
                    status = sweep(args.lead, args.ade_label, log, args.all_local)
                except ProbeError:
                    log_event(log, "error", "enumeration-unavailable")
                    status = 1
                if not args.watch:
                    return status
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    return status
                time.sleep(min(args.interval, remaining))
            return status


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(130)

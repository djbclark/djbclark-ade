#!/usr/bin/env python3
"""Approve pending tool-permission requests for a lead's descendants, its `ade.lead=<lead>` workers,
selected ADE labels or, with `--all-local`, every agent this host's daemon lists. A request that is a question
or plan approval meant for the operator is skipped in any mode (best-effort name denylist, and only for
providers whose question names are known: claude, codex, opencode, pi, omp)."""
import argparse
from datetime import datetime, timezone
import fcntl
import json
import math
import os
import re
from pathlib import Path
import subprocess
import time
import uuid


class ProbeError(Exception):
    """An untrusted/unavailable CLI response; never authorizes a write."""


def identifier(value):
    try:
        return str(uuid.UUID(value)) == value
    except (ValueError, TypeError, AttributeError):
        return False


def call(args):
    # Local daemon only: never pass --host, and drop any host override from the environment.
    env = {k: v for k, v in os.environ.items() if k != "PASEO_HOST"}
    try:
        result = subprocess.run(["paseo", *args, "--json"], capture_output=True,
                                text=True, timeout=30, check=False, env=env)
        if result.returncode:
            raise ProbeError("paseo command failed")
        return json.loads(result.stdout)
    except (OSError, subprocess.TimeoutExpired, ValueError) as exc:
        raise ProbeError("paseo command unavailable or invalid JSON") from exc


def rows(value):
    if not isinstance(value, list):
        raise ProbeError("expected JSON list")
    return value


# A request that is a question or plan/mode approval for the operator must stay pending. Paseo's request
# kinds are tool|plan|question|mode|other, but `permit ls --json` rows expose only `name` (no `kind`), so
# this is a name-based, best-effort DENYLIST (a missing name or a non-`tool` kind fails closed; an unlisted
# question name is NOT caught, so only providers in CLASSIFIED_PROVIDERS, whose names are known, are served). Names seen in Paseo's providers: Claude AskUserQuestion / ExitPlanMode, Codex CodexPlanApproval /
# CodexMcpElicitation / request_user_input, OpenCode question, Pi "Pi ask_user" / "Pi select|input|editor|
# confirm", OMP "OMP ask" / "OMP select|...", ACP switch_mode. `kind` is also checked when a row carries it.
# Substring stems are matched against the lower-cased name with separators removed (catches run-together
# spellings); short words are matched as whole tokens (acronym- and camelCase-split) so "Task" is not "ask".
CLASSIFIED_PROVIDERS = {"claude", "codex", "opencode", "pi", "omp"}  # question names read from Paseo's source
STEMS = ("question", "elicit", "askuser", "userinput", "exitplan", "enterplan", "planmode", "planapproval",
         "switchmode", "requestinput")
TOKENS = {"ask", "plan", "mode", "prompt", "dialog", "approval", "approve", "choose", "choice", "answer"}
UI_TOKENS = {"select", "input", "editor", "confirm"}  # Pi/OMP extension-UI methods; ignored for mcp__ tools


def words(name):
    spaced = re.sub(r"([a-z0-9])([A-Z])", r"\1 \2", name)
    spaced = re.sub(r"([A-Z]+)([A-Z][a-z])", r"\1 \2", spaced)
    return [w for w in re.split(r"[^A-Za-z0-9]+", spaced.lower()) if w]


def operator_question(row):
    """True when the request must stay pending for the operator. Missing/odd fields fail closed."""
    name, kind = row.get("name"), row.get("kind")
    if kind is not None and kind != "tool":
        return True
    parts = words(name) if isinstance(name, str) else []
    if not parts:
        return True
    compact = "".join(parts)
    if any(stem in compact for stem in STEMS) or TOKENS.intersection(parts):
        return True
    return not name.startswith("mcp__") and bool(UI_TOKENS.intersection(parts))


def log_event(log, decision, reason, agent=None, request=None):
    # Never record tool arguments, descriptions, stdout or stderr (may contain secrets).
    log.write(json.dumps(dict(time=datetime.now(timezone.utc).isoformat(),
                              decision=decision, reason=reason,
                              agent=agent, request=request)) + "\n")
    log.flush()


def descendant(agent, lead, cache):
    if agent == lead:
        return False
    seen = set()
    while agent not in seen:
        seen.add(agent)
        if agent not in cache:
            info = call(["agent", "inspect", agent])
            if not isinstance(info, dict) or info.get("Id") != agent:
                raise ProbeError("agent identity mismatch")
            cache[agent] = info.get("ParentAgentId")
        parent = cache[agent]
        if parent is None:
            return False
        if not identifier(parent):
            raise ProbeError("invalid parent id")
        if parent == lead:
            return True
        agent = parent
    return False


def sweep(lead, labels, log, all_local=False):
    requests = rows(call(["permit", "ls"]))
    eligible = {}
    # This host's daemon only (no --host): remote hosts' agents are never in this list. It also gives each
    # agent's provider, which decides whether its question names are known (CLASSIFIED_PROVIDERS).
    providers = {}
    for row in rows(call(["ls", "-a", "-g"])):
        if not isinstance(row, dict) or not identifier(row.get("id")):
            raise ProbeError("invalid local agent")
        provider = row.get("provider")
        providers[row["id"]] = provider.split("/")[0].lower() if isinstance(provider, str) else ""
    # Installed CLI inspect/ls do not expose labels. Exact server-side filters prove them.
    # The lead's own `ade.lead=<lead>` label is always checked: a lead launches top-level
    # (env-stripped) workers that are not descendants, and they carry that label.
    for reason, label in [("lead-label", f"ade.lead={lead}")] + [("ade-label", v) for v in labels]:
        for row in rows(call(["ls", "-a", "-g", "--label", label])):
            if not isinstance(row, dict) or not identifier(row.get("id")):
                raise ProbeError("invalid labelled agent")
            eligible.setdefault(row["id"], reason)
    cache, seen, failed = {}, set(), False
    for row in requests:
        if not isinstance(row, dict):
            log_event(log, "skip", "malformed-request")
            failed = True
            continue
        agent, request = row.get("agentId"), row.get("id")
        if not identifier(agent) or not isinstance(request, str) or not request or request.startswith("-"):
            log_event(log, "skip", "malformed-request")
            failed = True
            continue
        if (agent, request) in seen:
            continue
        seen.add((agent, request))
        if any(r is not row and isinstance(r, dict) and r.get("agentId") == agent
               and isinstance(r.get("id"), str) and r["id"] != request and r["id"].startswith(request)
               for r in requests):
            # `paseo permit allow` matches ids by prefix and takes the first hit: another pending id that
            # starts with this one could be answered instead (e.g. a question). Never allow such an id.
            # Snapshot-only: a prefix-colliding id that appears after this `permit ls` is not seen.
            log_event(log, "skip", "ambiguous-request-id", agent, request)
            failed = True
            continue
        if operator_question(row):
            # A question or plan approval is the operator's to answer. Checked before scope, in every mode.
            log_event(log, "skip", "operator-question", agent, request)
            continue
        if agent not in providers:
            log_event(log, "skip", "outside-scope", agent, request)
            continue
        if providers[agent] not in CLASSIFIED_PROVIDERS:
            # ACP-backed providers name questions by tool kind or free-text title, so a question cannot be
            # told from a tool prompt by name; their prompts stay for the operator.
            log_event(log, "skip", "unclassified-provider", agent, request)
            continue
        try:
            if agent == lead:
                reason = None
            elif agent in eligible:
                reason = eligible[agent]
            else:
                try:
                    reason = "descendant" if descendant(agent, lead, cache) else None
                except ProbeError:
                    if not all_local:
                        raise
                    reason = None  # all-local does not depend on ancestry; local membership decides
            if reason is None and all_local and agent in providers:
                reason = "all-local"
            if reason is None:
                log_event(log, "skip", "outside-scope", agent, request)
                continue
            # Audit intent BEFORE the only mutation. An audit failure aborts approval.
            log_event(log, "allow-attempt", reason, agent, request)
            response = rows(call(["permit", "allow", agent, request]))
            if not any(isinstance(r, dict) and r.get("agentId") == agent
                       and r.get("requestId") == request and r.get("result") == "allowed"
                       for r in response):
                raise ProbeError("unconfirmed allow")
            log_event(log, "allowed", reason, agent, request)
        except ProbeError:
            log_event(log, "error", "probe-or-allow-unconfirmed", agent, request)
            failed = True
    return 1 if failed else 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--lead", required=True, help="full lead UUID (the lead itself is excluded unless --all-local)")
    parser.add_argument("--ade-label", action="append", default=[], metavar="ade.KEY=VALUE",
                        help="exact ADE label selectors; any matching selector qualifies")
    parser.add_argument("--all-local", action="store_true",
                        help="also approve every agent this host's daemon lists, the lead included "
                             "(never a remote host's, never an operator question or plan approval)")
    parser.add_argument("--log", required=True, type=Path, help="append-only JSONL audit path")
    parser.add_argument("--watch", action="store_true")
    parser.add_argument("--interval", type=float, default=2)
    parser.add_argument("--duration", type=float, default=3600, help="watch lifetime in seconds")
    args = parser.parse_args()
    if not identifier(args.lead):
        parser.error("--lead must be a full canonical UUID")
    if any(not v.startswith("ade.") or "=" not in v or not v.split("=", 1)[0][4:]
           for v in args.ade_label):
        parser.error("--ade-label must be ade.KEY=VALUE")
    if any(not math.isfinite(v) or v <= 0 for v in (args.interval, args.duration)):
        parser.error("interval and duration must be finite and positive")
    args.log.parent.mkdir(parents=True, exist_ok=True)
    # One writer per audit path; cron/launchd overlap must not double-allow.
    with args.log.with_suffix(args.log.suffix + ".lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 1
        with args.log.open("a", encoding="utf-8") as log:
            deadline = time.monotonic() + args.duration
            status = 0
            while not args.watch or time.monotonic() < deadline:
                try:
                    status = sweep(args.lead, args.ade_label, log, args.all_local)
                except ProbeError:
                    log_event(log, "error", "enumeration-unavailable")
                    status = 1
                if not args.watch:
                    return status
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    return status
                time.sleep(min(args.interval, remaining))
            return status


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(130)

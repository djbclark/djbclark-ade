#!/usr/bin/env bash
# self-slash — queue a built-in slash command (/compact, /context, ...) into THIS
# session's own terminal, so an agent can compact itself instead of asking the
# operator to type it.  Claude Code cannot run built-ins from the Skill tool
# (memory/reference_claude_code_model_cannot_run_builtin_slash_commands.md).
#
#   self-slash [--delay S] [--dry-run] "/compact <focus>"   (--dry-run: validate only, never test against a live pane without it)
#
# Hosts: a herdr pane ($HERDR_PANE_ID, via `herdr agent read` / `herdr pane run`)
# or an Orca terminal ($ORCA_TERMINAL_HANDLE, via `orca terminal read --screen` /
# `orca terminal send --enter`).  herdr wins when both are set (a herdr pane
# inside an Orca tab).  Anywhere else it refuses.
#
# Rules: only ever targets this session's own pane/terminal (never another);
# waits --delay seconds (default 6) so the current turn can end, then refuses if
# the operator has an unsent draft in the input box (a line starting with ❯ that
# is not empty), and otherwise sends the text +
# Enter.  On herdr it also waits (up to SELF_SLASH_WAIT, default 900 s) while the
# pane's agent_status is "working": a command sent mid-turn is swallowed, never run
# (seen 2026-10-09: a /rename sent while the session worked left no trace).
# A stale $HERDR_PANE_ID (pane moved between workspaces) is resolved via `herdr pane get`.
# Runs detached (nohup) so it survives the Bash tool returning; the log
# is ~/.local/state/self-slash.log.  First verified 2026-10-09 (ClaudeHelm, herdr);
# Orca backend verified 2026-10-09.
set -u
delay=6; dry=0
while :; do case "${1:-}" in --delay) delay="$2"; shift 2;; --dry-run) dry=1; shift;; *) break;; esac; done
text="${1:-}"
[ -n "$text" ] || { echo "usage: self-slash [--delay S] [--dry-run] \"/command args\"" >&2; exit 2; }
if [ "${HERDR_ENV:-}" = "1" ] && [ -n "${HERDR_PANE_ID:-}" ]; then
  host=herdr; pane="$HERDR_PANE_ID"
  # $HERDR_PANE_ID is fixed at launch; after the tab is moved to another workspace
  # the pane is renumbered (w2G:p1 -> w2H:p1, seen 2026-10-09). `pane get` resolves
  # the old id, but `agent read`/`pane list`/`pane run` do not, so resolve first.
  cur=$(herdr pane get "$pane" 2>/dev/null | python3 -c '
import json, sys
print(json.load(sys.stdin).get("result", {}).get("pane", {}).get("pane_id", ""))' 2>/dev/null)
  if [ -n "$cur" ] && [ "$cur" != "$pane" ]; then
    echo "self-slash: HERDR_PANE_ID=$pane is stale (pane moved); using $cur" >&2; pane="$cur"
  fi
elif [ -n "${ORCA_TERMINAL_HANDLE:-}" ] && command -v orca >/dev/null 2>&1; then
  host=orca; pane="$ORCA_TERMINAL_HANDLE"
else
  echo "self-slash: not inside a herdr pane or an Orca terminal (HERDR_PANE_ID and ORCA_TERMINAL_HANDLE unset); ask the operator to type: $text" >&2; exit 3
fi
case "$text" in /*) ;; *) echo "self-slash: only slash commands are sent (got: $text)" >&2; exit 2;; esac
# herdr and Orca both send a long argument as a bracketed paste and Claude Code then
# treats it as pasted content, not a command (seen 2026-10-09 with ~900 chars): keep it short.
if [ "${#text}" -gt "${SELF_SLASH_MAX:-300}" ]; then
  echo "self-slash: argument is ${#text} chars; anything over ~300 is pasted and the command is not run. Shorten it (or SELF_SLASH_MAX=N)." >&2; exit 2
fi
[ "$dry" = 1 ] && { echo "self-slash: dry run, would send to $host $pane after ${delay}s: ${text:0:80}"; exit 0; }
log="$HOME/.local/state/self-slash.log"; mkdir -p "$(dirname "$log")"
if [ "${SELF_SLASH_CHILD:-}" != "1" ]; then
  SELF_SLASH_CHILD=1 nohup "$0" --delay "$delay" "$text" >>"$log" 2>&1 </dev/null &
  echo "self-slash: queued for $host $pane in ${delay}s (log: $log)"
  exit 0
fi

# read_screen: print the visible screen lines.  Orca's JSON also has a `draft`
# field, but it is not used: on 2026-10-09 it held Claude Code's dim hint text
# ("Press up to edit queued messages") while the rendered ❯ line was empty.
read_screen() {
  if [ "$host" = herdr ]; then
    herdr agent read "$pane" --source visible --lines 12 2>/dev/null
  else
    orca terminal read --terminal "$pane" --screen --limit 12 --json 2>/dev/null | python3 -c '
import json, sys
t = json.load(sys.stdin).get("result", {}).get("terminal", {})
print("\n".join(t.get("tail") or []))'
  fi
}
send_text() {
  if [ "$host" = herdr ]; then
    herdr pane run "$pane" "$text"
  else
    orca terminal send --terminal "$pane" --text "$text" --enter --wait-submit 10 --json
  fi
}

sleep "$delay"
# herdr: never send while the session is mid-turn (status "working"); the input is
# accepted but Claude Code never runs it.  Wait for idle, bounded by SELF_SLASH_WAIT.
wait_idle() {
  [ "$host" = herdr ] || return 0
  waited=0; said=0
  while :; do
    st=$(herdr pane list 2>/dev/null | python3 -c '
import json, sys
pane = sys.argv[1]
for p in json.load(sys.stdin).get("result", {}).get("panes", []):
    if p.get("pane_id") == pane: print(p.get("agent_status", "")); break' "$pane" 2>/dev/null)
    [ "$st" = working ] || return 0
    [ "$said" = 1 ] || { echo "$(date '+%F %T') $host $pane: session is working, waiting for idle before sending"; said=1; }
    [ "$waited" -lt "${SELF_SLASH_WAIT:-900}" ] || { echo "$(date '+%F %T') $host $pane: gave up after ${waited}s, session still working; NOT sent: ${text:0:80}"; exit 6; }
    sleep 5; waited=$((waited+5))
  done
}
wait_idle
for attempt in 1 2 3 4 5 6 7 8 9; do
  screen=$(read_screen)
  prompt=$(printf '%s\n' "$screen" | grep -E '^[[:space:]]*❯' | tail -1 | sed -E 's/^[[:space:]]*❯[[:space:]]*//')
  # Claude Code's dim hint text reads as plain text on screen; treat it as empty
  # (same rule as Orca's isStockPlaceholder, src/shared/terminal-composer-draft.ts).
  case "$prompt" in 'Try "'*|'Try “'*|'Press up to edit queued messages'*) prompt="";; esac
  if ! printf '%s\n' "$screen" | grep -qE '^[[:space:]]*❯'; then
    echo "$(date '+%F %T') $host $pane: no input prompt on screen yet (attempt $attempt), waiting"; sleep 5; continue
  fi
  if [ -n "$prompt" ]; then
    # Text on the ❯ line is either the operator's unsent draft or a message the
    # operator QUEUED mid-turn, which Claude Code shows there (as the text, or as
    # "[Pasted text #1 +9 lines]") until the turn ends and it is consumed.  Seen
    # 2026-10-09: three compacts refused on queued messages.  A queued message
    # vanishes within seconds of idle (and the session goes back to working); a
    # real draft stays.  So re-read: gone -> wait for idle again and send after
    # the operator's turn; unchanged three times (~10 s) -> a real draft, refuse.
    if [ "$prompt" = "${last_prompt:-}" ]; then same=$((${same:-0}+1)); else same=1; last_prompt="$prompt"; fi
    if [ "$same" -ge 3 ]; then
      echo "$(date '+%F %T') $host $pane: REFUSED, unsent draft in input box: ${prompt:0:60}"; exit 4
    fi
    echo "$(date '+%F %T') $host $pane: text on input line (queued message or draft), re-checking: ${prompt:0:60}"
    sleep 4; wait_idle; continue
  fi
  send_text && { echo "$(date '+%F %T') $host $pane: sent ${text:0:80}"; exit 0; }
  echo "$(date '+%F %T') $host $pane: send failed (attempt $attempt)"; sleep 5
done
echo "$(date '+%F %T') $host $pane: gave up, no empty input prompt seen"; exit 5

#!/usr/bin/env bash
# self-slash — queue a built-in slash command (/compact, /context, ...) into THIS
# session's own terminal, so an agent can compact itself instead of asking the
# operator to type it.  Claude Code cannot run built-ins from the Skill tool
# (memory/reference_claude_code_model_cannot_run_builtin_slash_commands.md).
#
#   self-slash [--delay S] [--dry-run] [--then "/cmd" | --no-then] "/compact <focus>"
#   self-slash [--delay S] [--dry-run] --finish
#   (--dry-run: validate only, never test against a live pane without it)
#
# --then "/cmd": after the command has been sent, the same waiter waits for the
# session to be idle again and sends "/cmd" as the next prompt.  Default for /new,
# /clear and /reset: "/baton" (djbclark, 2026-10-19: "automate the baton after the
# handoff and clear/new"), so handoff -> self-slash "/new" ends in the fresh session
# resuming from its Tier 1 pointer with nobody typing; --no-then (or --then "")
# turns it off.  The follow-up starts SELF_SLASH_THEN_DELAY (default 10) seconds
# after the first send so the fresh session is up; it is logged as "then: ...".
# Codex (2026-10-25, a herdr pane whose `agent` herdr reports as codex, re-confirmed by `herdr agent get` right before every
# submit; a missing or different identity submits nothing, exit 8): a SKILL is invoked as `$baton`, a built-in stays `/new`,
# `/compact`, `/quit`.  The default follow-up there is `$baton`, and a legacy `--then "/baton PATH"` (or a `/baton` text) is
# rewritten ONCE to `$baton PATH`: only the exact command name `/baton` at the start, every byte after it kept.  An explicit
# `$baton PATH` is also taken, on a Codex pane only (single-quote it so the shell keeps the `$`: --then '$baton PATH'); any other
# `$word` is refused (exit 2).  Another client keeps `/baton`; a herdr pane that reports NO agent gets no baton follow-up at
# all (exit 3, nothing sent, even with --dry-run), because its syntax cannot be known.  --dry-run and the log show the text
# actually sent.  A Codex skill prompt goes in ONCE by `herdr agent prompt`, no Enter follows, and it counts as sent only when
# herdr still names that pane as codex and that session's rollout holds a user message that IS the exact text (byte for byte,
# not whitespace-folded; stamped after the submit; SELF_SLASH_RECEIPT_WAIT s, default 30); else exit 8 "NOT confirmed
# delivered", never retried.  Screen text and a zero exit from herdr are not receipts.
#
# --finish: end this session after the turn.  On herdr and Orca that is the real built-in
# /quit.  On Paseo /quit is not a command (the daemon runs only clear, compact, context,
# ... itself; /quit, /exit and /new reach Claude as plain text and do nothing, seen twice
# 2026-10-20), so --finish waits for the agent to be idle (`paseo wait`, bounded by
# SELF_SLASH_WAIT) and then runs `paseo agent archive <id>` WITHOUT --force: the agent
# is soft-deleted (kept under `paseo ls -a` and the UI's "Archived agents"), and if it
# became busy again the archive is refused and logged ("finish: archive refused", exit
# 8), never escalated to --force (that interrupts a running turn).  `self-slash "/quit"`
# on Paseo is mapped to --finish and says so on stderr (djbclark, 2026-10-20: "the goal is
# for handoffs to immediately clear context and then start a baton ..., or if there is
# nothing to continue to just clear context but in a way that the human can still read
# the final results").  Lifecycle actions (--finish, /new, /clear, /reset, /quit, /exit) also
# take a per-agent lock, ~/.local/state/self-slash/<host>_<pane>.lifecycle holding the
# waiter's pid and its start time (ps lstart): a second lifecycle for the same agent is
# refused (exit 7) while the first waiter lives.  A lock is stale (and broken by moving it
# aside, never rm) when its pid is dead, was reused by another process (start time differs),
# or, for a lock without a start time, is not a self-slash process.
#
# --finish --successor PROVIDER/MODEL [--thinking ID] [--mode MODE] [--title TEXT] (Paseo; herdr below;
# djbclark, 2026-10-23: a lead session on Fable burned ~30% of a week's Claude quota, so the
# handoff must be able to continue on another model without anyone typing): instead of a bare
# archive, the waiter (1) waits for this agent to be idle, (2) reads its name, mode and cwd
# (`paseo agent inspect`) and its workspace id (`paseo workspace ls --json`, matched by cwd;
# SELF_SLASH_WORKSPACE overrides, needed when several workspaces share the cwd), (3) starts
# the successor with `paseo run "/baton" --provider P/M --thinking T --mode MODE --workspace W
# --cwd C --title T --no-wait` (defaults: this agent's mode, --thinking high, title
# "<old name> → <model>"), (4) polls it (SELF_SLASH_SUCCESSOR_SETTLE seconds, default 20) and needs
# a new id (never this agent's), ParentAgentId null, the model asked and status idle, running or
# initializing, every key present (a renamed key is not read as null),
# and only then (5) archives this agent as --finish does.  The run uses `env -u PASEO_AGENT_ID`:
# paseo run passes the caller's agent id to the daemon whenever PASEO_AGENT_ID is set, even with
# --workspace, and the daemon then makes the new agent a SUBAGENT (Paseo 0.12.0 CLI source, read
# 2026-10-23).  Any failure in 2-4 exits 11 and archives nothing: this session stays usable and
# a successor that was created is left running (logged, never stopped).  The first prompt is
# /baton, so the Tier 1 pointer must be written first (handoff Step 7).  Not on Orca (exit 2).
# herdr (2026-10-25; one design with Paseo, see skills/handoff Step 9): `--finish --successor claude/MODEL
# [--thinking E] [--mode M] [--baton PATH]` runs skills/session-finder/launch.py successor, which waits for this
# pane's agent to be idle (blocked, a draft in the input box or SELF_SLASH_WAIT running out: exit 11), opens a new tab in
# the same herdr workspace and cwd, starts a real claude TUI there (`herdr agent start --kind claude -- --model M
# --effort E`, never acp-run: an acp-run session cannot take /new, /compact or a handoff), prompts /baton, and checks
# that the pane runs claude with another session id.  The old pane is left idle, never closed or exited
# (herdr-tidy closes it); any failure exits 11 and leaves it usable.  --title, --workspace and --keep-workspace
# are Paseo's and exit 2 here.  SELF_SLASH_LAUNCH replaces the launch.py command (tests).
# Workspaces (djbclark, 2026-10-23): the successor always lands in an EXISTING workspace, `paseo run
# --workspace <id>` (default this agent's, --workspace ID picks another), never --new-workspace and
# never a new Paseo window; its --title is kept short (an old name cut to 24 chars plus the model
# without "claude-"), as the sidebar shows only the first words.  A Paseo workspace name ends in -pw
# (herdr tabs end -t, panes -p); self-slash creates and renames none.  When --workspace names another
# workspace the successor's --cwd is that workspace's own cwd (its `workspace ls` row), never this
# agent's.  After the old agent is archived the old workspace is archived too (`paseo workspace
# archive` archives every agent in it, kills its terminals and deletes a Paseo-owned worktree, so it
# must be PROVEN no longer needed) only when ALL hold: its id came from exactly one realpath-cwd match
# (or an override whose row has this agent's cwd; SELF_SLASH_WORKSPACE and the prefer-foreground
# tie-break may place the successor but are never archive targets); it is not the successor's
# workspace; its row says isolation local (never a worktree); its cwd neither equals nor contains the
# successor's cwd; `paseo terminal ls --workspace <id> --json` lists none; and `paseo ls --background
# --json` shows no other agent in it (by workspaceId when the row has one, else by cwd equal to or below
# the workspace's cwd).  Every doubt keeps it, logged as "workspace: ... kept: <why>"; --keep-workspace
# skips the close.
#
# Never in a sub-agent or a dispatched slice (2026-10-20): they inherit the parent's
# PASEO_AGENT_ID, so a lifecycle action there would clear or archive the PARENT's agent.
# acp-run scrubs PASEO_AGENT_ID, PASEO_AGENT_CWD and ORCA_TERMINAL_HANDLE and sets
# ACP_RUN_AGENT=1; self-slash refuses every lifecycle action and /compact when it sees that
# marker (exit 9).  An Agent-tool sub-agent shares the parent's environment with no
# marker of its own (checked 2026-10-20), so the skills (handoff Step 9, loose Rule 4,
# docs/dispatch-footer.md) also say a sub-agent treats a handoff as document-only.
#
# Native OpenCode Go (2026-10-25): an explicit ADE_OPENCODE_SESSION_ID and native
# directory from a supported host controller select /compact before host lookup. It queues
# that exact session at a safe point; no parent UI or extra inference probe.
# Native /new, /clear, /reset and /compact focus are refused until a durable
# owned handoff and supported successor/baton route can be verified.
#
# Hosts: a herdr pane ($HERDR_PANE_ID, via `herdr agent read` / `herdr pane run`),
# an Orca terminal ($ORCA_TERMINAL_HANDLE, via `orca terminal read --screen` /
# `orca terminal send --enter`), or a Paseo agent ($PASEO_AGENT_ID, via `paseo wait`
# then `paseo send`).  herdr wins when both it and Orca are set (a herdr pane
# inside an Orca tab); Paseo only when neither is.  Anywhere else it refuses.
# Paseo (verified 2026-10-19, Paseo 0.12.0, Claude provider): the daemon runs the
# built-ins it lists as root-only (clear, compact, context, usage, ...) when the
# prompt is sent to an IDLE agent, so the child waits with `paseo wait` and then
# sends.  The send runs with PASEO_AGENT_ID unset: an agent-originated send gets a
# "[Message received] <parent>" envelope and reaches Claude as plain text (the
# model answers "I can't run /compact"; upstream getpaseo/paseo#7169 did not cover
# a self-send on 0.12.0).  Paseo has no /new: /new and /reset are sent as /clear,
# which rebinds the agent to a fresh Claude session (verified the same day).
#
# Rules: only ever targets this session's own pane/terminal (never another);
# waits --delay seconds (default 6) so the current turn can end, then refuses if
# the operator has an unsent draft in the input box (a line starting with ❯ that
# is not empty), and otherwise sends the text +
# Enter.  On herdr it also waits (up to SELF_SLASH_WAIT, default 900 s) while the
# pane's agent_status is "working": a command sent mid-turn is swallowed, never run
# (seen 2026-10-09: a /rename sent while the session worked left no trace).
# A stale $HERDR_PANE_ID (pane moved between workspaces) is resolved via `herdr pane get`.
# Refuses (exit 7) a /compact while another command is queued for the same pane.
# Refuses (exit 7) a /compact, /new, /clear or /reset within SELF_SLASH_COMPACT_GAP
# (default 1800 s) of any of those four sent there (2026-10-18: the context hook now
# recommends handoff + /new at a finished task, so a model that misjudges "done"
# must not loop); checked again by the waiter just before sending, so a /new queued
# behind a /compact is refused too. --dry-run reports the same refusal. Any other
# command queues behind the pending one (2026-10-14: /quit after autorename's
# /rename at the end of /loose + /handoff was refused).
# Queue it as the turn's LAST action: an AskUserQuestion/clarify prompt opened after it
# puts its text on the input line, which reads as a draft, and the command is refused
# unsent after 900 s (2026-10-18: a /reload-plugins meant to unload agent-radar never
# ran, and the session kept its scans for 2 h). Check the log before saying it ran.
# herdr and Orca: after the send, Enter is pressed again (up to 3 times) while the command is
# still on the input line; if it never leaves the line the waiter exits 8 and logs "NOT confirmed
# run" rather than typing it a second time (2026-10-20; Orca branch added 2026-10-24, the bare
# `orca terminal send --enter` form not yet seen live).
# Runs detached (nohup) so it survives the Bash tool returning; the log
# is ~/.local/state/self-slash.log.  First verified 2026-10-09 (ClaudeHelm, herdr);
# Orca backend verified 2026-10-09.
# cursor-agent (herdr only; the pane's `agent` is "cursor"): its input line starts
# with → instead of ❯, a turn shows "ctrl+c to stop", and the first Enter after a
# slash command only accepts the autocomplete, so up to two more Enters are sent
# while the text (or its menu row) is still on screen (verified 2026-10-10 with
# /rename; /quit left its menu row open, cursor-agent 2026.10.01).
# Preserve the tool caller's OpenCode selection. GNU tools for host controllers
# may live in Homebrew, but its opencode can be a different install.
self_slash_caller_path="$PATH"
export PATH="/opt/homebrew/bin:$PATH"
set -u
# An inherited BASHOPTS=nocasematch (bash >= 4.1 applies it at startup) would make every `case`
# guard below case-blind, so "Claude" would pass the plain-id check (adversary pr35 round 2, L1).
shopt -u nocasematch
delay=6; dry=0; then=""; then_set=0; finish=0
successor=""; s_thinking=""; s_mode=""; s_title=""; s_workspace=""; s_keepws=0; s_baton=""
# Text that came from paseo, an operator flag or an agent name goes through `clean` before it is
# logged or used as a title: a newline in it could forge a "sent /compact" log line that
# gap_check reads (adversary 2026-10-23, L4).  Defined early: --baton is checked at parse time.
clean() { printf '%s' "$1" | python3 -c 'import sys; print("".join(c for c in sys.stdin.read() if c.isprintable()))' 2>/dev/null; }
# A value flag as the last argument made `shift 2` fail and this loop spin (adversary L3).
need2() { [ "$#" -ge 2 ] || { echo "self-slash: $1 needs a value (usage: see self-slash with no arguments)" >&2; exit 2; }; }
while :; do case "${1:-}" in
  --delay) need2 "$@"; delay="$2"; shift 2;;
  --dry-run) dry=1; shift;;
  --then) need2 "$@"; then="$2"; then_set=1; shift 2;;
  --no-then) then=""; then_set=1; shift;;
  --finish) finish=1; shift;;
  --successor) need2 "$@"; successor="$2"; shift 2;;
  --thinking) need2 "$@"; s_thinking="$2"; shift 2;;
  --mode) need2 "$@"; s_mode="$2"; shift 2;;
  --title) need2 "$@"; s_title="$2"; shift 2;;
  --workspace) need2 "$@"; s_workspace="$2"; shift 2;;
  --keep-workspace) s_keepws=1; shift;;
  --baton) need2 "$@"; s_baton="$2"; shift 2;;
  *) break;;
esac; done
text="${1:-}"
finish_flag=$finish
[ "$finish" = 1 ] && [ -z "$text" ] && text="/quit"
[ -n "$text" ] || { echo "usage: self-slash [--delay S] [--dry-run] [--then \"/cmd\" | --no-then] \"/command args\"
       (Codex panes run a skill as \$baton and a built-in as /new; single-quote the \$ in the shell: --then '\$baton PATH')
       self-slash [--delay S] [--dry-run] --finish   (end the session; Paseo: archive this agent)
       self-slash [--delay S] [--dry-run] --finish --successor PROVIDER/MODEL [--thinking ID] [--mode MODE] [--title TEXT]
                  [--workspace ID] [--keep-workspace] [--baton PATH]
                  (Paseo, or herdr with claude/MODEL: start /baton on another model in an EXISTING workspace (--workspace <id>, default this
                  agent's; never a new workspace or window), then archive this agent; the old workspace is archived too
                  when it differs from the successor's and holds no other agent (--keep-workspace skips that); keep the
                  --title short, its first words show in the sidebar; a Paseo workspace name ends in -pw;
                  --baton PATH makes the first prompt \"/baton PATH\" so the successor resumes that chain log (an absolute
                  path to an existing file, else exit 2); --mode defaults to this agent's mode for the same provider (an
                  empty mode passes none), bypassPermissions for a claude successor from another provider, else the
                  provider's own default; without --mode, an inspect of this agent that lacks a Provider or a Mode
                  value exits 11 and starts nothing)
       exit codes: 2 usage, 3 no host or unknown baton syntax, 4 draft in the input box, 5 no prompt, 6 session still working,
       7 refused (gap check or lifecycle already queued), 8 archive refused or Codex submission unconfirmed (identity, target change or no rollout receipt), 9 dispatched agent
       (ACP_RUN_AGENT=1): lifecycle actions and /compact run only in the top-level session,
       11 successor not started, not top-level or not verified, or the successor path aborted (nothing archived; this session stays usable)" >&2; exit 2; }
if [ "$finish" = 1 ] && [ "$text" != /quit ]; then echo "self-slash: --finish takes no command (got: $text)" >&2; exit 2; fi
if [ -n "$successor" ] && [ "$finish" != 1 ]; then echo "self-slash: --successor needs --finish (it replaces the bare archive)" >&2; exit 2; fi
if [ -z "$successor" ] && { [ -n "$s_thinking" ] || [ -n "$s_mode" ] || [ -n "$s_title" ] || [ -n "$s_workspace" ] || [ "$s_keepws" = 1 ] || [ -n "$s_baton" ]; }; then echo "self-slash: --thinking, --mode, --title, --workspace, --keep-workspace and --baton only go with --successor" >&2; exit 2; fi
# Plain-id character sets spelled out: bash 3.2 matches a bracket range ([a-z]) by locale
# collation, so under en_US.UTF-8 it also takes upper-case and accented letters (adversary
# pr35 B1, 2026-10-24).  Patterns below use these, never a range.
lc=abcdefghijklmnopqrstuvwxyz; uc=ABCDEFGHIJKLMNOPQRSTUVWXYZ; dg=0123456789
case "$successor" in ""|["$uc$lc$dg"]*) ;; *) echo "self-slash: --successor takes PROVIDER or PROVIDER/MODEL (got: $successor)" >&2; exit 2;; esac
case "$successor$s_thinking$s_mode$s_workspace" in *[!"$uc$lc$dg"._/:-]*) echo "self-slash: --successor, --thinking, --mode and --workspace take plain ids (letters, digits, . _ / : -)" >&2; exit 2;; esac
# --finish ends the session, so a follow-up would be typed into whatever is left (a shell prompt).
if [ "$finish" = 1 ] && [ -n "$then" ] && [ "${SELF_SLASH_CHILD:-}" != "1" ]; then echo "self-slash: --finish takes no --then (got: $then)" >&2; exit 2; fi
# Lifecycle actions end the session or throw its context away.
lifecycle=0
case "$text" in /new|/clear|/reset|/quit|/exit|"/new "*|"/clear "*|"/reset "*|"/quit "*|"/exit "*) lifecycle=1;; esac
[ "$finish" = 1 ] && lifecycle=1
# A per-tool OpenCode plugin scope wins over inherited terminal/parent identities.
# Native compaction queues this exact session at a safe point, including ACP slices;
# it never invokes a parent lifecycle action. A reset requires a durable handoff and
# a verified successor, so unsupported native resets fail closed (2026-10-25).
if [ -n "${ADE_OPENCODE_SESSION_ID:-}" ]; then
  case "$text" in
    /compact)
      if [ "$finish" = 1 ] || [ "$then_set" = 1 ]; then
        echo "self-slash: native compact takes no lifecycle or --then options" >&2; exit 2
      fi
      native_helper="$(dirname "$(realpath "${BASH_SOURCE[0]}")")/opencode-self-compact"
      if [ "$dry" = 1 ]; then PATH="$self_slash_caller_path" exec python3 "$native_helper" --dry-run; fi
      PATH="$self_slash_caller_path" exec python3 "$native_helper";;
    "/compact "*|/new|/clear|/reset|/quit|/exit|"/new "*|"/clear "*|"/reset "*|"/quit "*|"/exit "*)
      echo "self-slash: native OpenCode accepts /compact without focus; resets need an owned handoff and a verified successor, never a parent terminal clear" >&2; exit 2;;
  esac
fi
# Not for a dispatched slice or a sub-agent: see the header.  The waiter child skips this, so a
# chain the top-level session started is never cut off.
if [ "${SELF_SLASH_CHILD:-}" != "1" ] && [ "${ACP_RUN_AGENT:-}" = "1" ]; then
  case "$text" in /compact|"/compact "*) guarded=1;; *) guarded=$lifecycle;; esac
  if [ "$guarded" = 1 ]; then
    echo "self-slash: refused ($text): this agent was started by acp-run (ACP_RUN_AGENT=1: a dispatched slice or an acp-run --interactive session); lifecycle actions and /compact run only in the top-level session. Treat a handoff as document-only and say what the operator should type." >&2; exit 9
  fi
fi
# herdr is the host when the pane named by $HERDR_PANE_ID exists.  A Cline tool shell inherits the
# hub daemon's HERDR_* with a pane that no longer exists (2026-10-25), so an id herdr does not know
# is not a host.  1eda130 gated this branch on PASEO_SELF_TRUST_HERDR, which nothing sets: every
# plain herdr session then fell through to paseo-self, which named another Cline agent, so a herdr
# handoff would have sent /clear and /baton to a stranger (fixed 2026-10-25).
if [ "${HERDR_ENV:-}" = "1" ] && [ -n "${HERDR_PANE_ID:-}" ] && herdr pane get "$HERDR_PANE_ID" >/dev/null 2>&1; then
  host=herdr; pane="$HERDR_PANE_ID"
  # $HERDR_PANE_ID is fixed at launch; after the tab is moved to another workspace
  # the pane is renumbered (w2G:p1 -> w2H:p1, seen 2026-10-09). `pane get` resolves
  # the old id, but `agent read`/`pane list`/`pane run` do not, so resolve first.
  info=$(herdr pane get "$pane" 2>/dev/null | python3 -c '
import json, sys
p = json.load(sys.stdin).get("result", {}).get("pane", {})
print(p.get("pane_id", ""), p.get("agent") or "")' 2>/dev/null)
  cur=${info%% *}; tui=${info#* }; [ "$tui" = "$info" ] && tui=""
  if [ -n "$cur" ] && [ "$cur" != "$pane" ]; then
    echo "self-slash: HERDR_PANE_ID=$pane is stale (pane moved); using $cur" >&2; pane="$cur"
  fi
elif [ -n "${ORCA_TERMINAL_HANDLE:-}" ] && command -v orca >/dev/null 2>&1; then
  host=orca; pane="$ORCA_TERMINAL_HANDLE"; tui=""
  if [ "${CURSOR_AGENT:-}" = "1" ]; then
    echo "self-slash: cursor-agent in an Orca terminal is not supported (prompt detection is herdr-only); ask the operator to type: $text" >&2; exit 3
  fi
elif [ -n "${PASEO_AGENT_ID:-}" ]; then
  host=paseo; pane="$PASEO_AGENT_ID"; tui=""
  paseo_cli="${PASEO_CLI:-$(command -v paseo || true)}"
  [ -n "$paseo_cli" ] && [ -x "$paseo_cli" ] || { echo "self-slash: PASEO_AGENT_ID is set but no paseo CLI (PASEO_CLI unset, none on PATH); ask the operator to type: $text" >&2; exit 3; }
else
  # SELF-DISCOVERY (djbclark, 2026-10-25): a Cline agent under Paseo has NO usable environment route
  # to its own identity. PASEO_AGENT_ID is set on the agent process but NOT in tool shells (they are
  # children of the shared cline hub daemon), and HERDR_PANE_ID is inherited from that daemon and
  # stale -- a shell had HERDR_ENV=1 with a pane that no longer exists, so the herdr branch above
  # would have typed into a stranger's pane. Ask the hub instead: `paseo-self agent` reads the
  # session id the hub recorded for the tool call in progress and looks it up in Paseo's own agent
  # state. Refuses (exit 3) rather than guessing, so this is safe to try before giving up.
  SELF_TOOL="$(dirname "$(realpath "${BASH_SOURCE[0]}")")/paseo-self"
  # Only a Cline tool shell needs it.  A Claude Code session (CLAUDECODE=1) is never one, and the hub's
  # newest tool.started row then belongs to some other Cline agent (seen 2026-10-25: it named a
  # stranger while the caller was a Claude session), so there is no one to discover.
  if [ "${CLAUDECODE:-}" = "1" ]; then
    echo "self-slash: not inside a herdr pane, an Orca terminal or a Paseo agent (HERDR_PANE_ID unknown to herdr or unset, ORCA_TERMINAL_HANDLE and PASEO_AGENT_ID unset; a Claude Code session is never discovered through the Cline hub); ask the operator to type: $text" >&2; exit 3
  elif [ -x "$SELF_TOOL" ]; then
    if discovered=$("$SELF_TOOL" agent 2>/dev/null) && [ -n "$discovered" ]; then
      host=paseo; pane="$discovered"; tui=""
      paseo_cli="${PASEO_CLI:-$(command -v paseo || true)}"
      if [ -z "$paseo_cli" ] || [ ! -x "$paseo_cli" ]; then
        echo "self-slash: discovered agent $discovered but no paseo CLI (PASEO_CLI unset, none on PATH); ask the operator to type: $text" >&2; exit 3
      fi
      echo "self-slash: no PASEO_AGENT_ID in the environment; discovered agent ${discovered:0:8} from the cline hub" >&2
    else
      echo "self-slash: not inside a herdr pane, an Orca terminal or a Paseo agent, and paseo-self could not identify this session (PASEO_AGENT_ID, ORCA_TERMINAL_HANDLE unset); ask the operator to type: $text" >&2; exit 3
    fi
  else
    echo "self-slash: not inside a herdr pane, an Orca terminal or a Paseo agent (HERDR_PANE_ID, ORCA_TERMINAL_HANDLE and PASEO_AGENT_ID unset; no $SELF_TOOL to self-discover); ask the operator to type: $text" >&2; exit 3
  fi
fi
if [ -n "$successor" ] && [ "$host" != paseo ] && [ "$host" != herdr ]; then
  echo "self-slash: successor needs Paseo or herdr; hand off and relaunch \`claude --model <m>\` in the pane (host: $host)" >&2; exit 2
fi
# herdr (2026-10-25, one design with Paseo): a NEW claude TUI in a new tab of this workspace via launch.py successor.
if [ -n "$successor" ] && [ "$host" = herdr ]; then
  case "$successor" in claude/?*) ;; *) echo "self-slash: on herdr the successor is claude/MODEL (got: $successor); another provider: hand off and start it in a new pane by hand" >&2; exit 2;; esac
  if [ -n "$s_title$s_workspace" ] || [ "$s_keepws" = 1 ]; then echo "self-slash: --title, --workspace and --keep-workspace are Paseo options; herdr names the tab from this one and never closes the old pane" >&2; exit 2; fi
fi
# Codex: see the header.  $codex is 1 only for a herdr pane herdr reports as codex.
codex=0; [ "$host" = herdr ] && [ "$tui" = codex ] && codex=1
# The waiter sees the pane again: if what herdr reports now is not what the parent saw, the follow-up syntax chosen
# there may be wrong for this target, so nothing is sent.
if [ "${SELF_SLASH_CHILD:-}" = "1" ] && [ -n "${SELF_SLASH_TUI+x}" ] && [ "$SELF_SLASH_TUI" != "$tui" ]; then
  echo "$(gdate '+%F %T') $host $pane: target changed: the parent saw agent '${SELF_SLASH_TUI:-none}', herdr reports '${tui:-none}' now; NOT sent: ${text:0:80}"; exit 8
fi
if [ "${SELF_SLASH_CHILD:-}" = "1" ]; then
  then="${SELF_SLASH_THEN:-}"
elif [ "$then_set" = 0 ]; then
  case "$text" in /new|/clear|/reset|"/new "*|"/clear "*|"/reset "*) then="/baton";; esac
fi
# A baton follow-up, requested, legacy or generated, is a skill whose syntax depends on the client (/baton on Claude, $baton on
# Codex).  A herdr pane that reports no agent could be either, so it would be queued blind: refused before anything is sent.
if [ "$host" = herdr ] && [ -z "$tui" ]; then
  for b in "$text" "$then"; do
    case "$b" in /baton|/baton[[:space:]]*|'$baton'|'$baton'[[:space:]]*)
      echo "self-slash: herdr reports no agent for $pane, so the syntax of a baton follow-up (/baton for Claude, \$baton for Codex) is unknown; nothing was sent; ask the operator to type it: $(clean "$b")" >&2; exit 3;;
    esac
  done
fi
if [ "$codex" = 1 ]; then
  # Exact command name /baton only (the end or whitespace after it); `$baton PATH` already in place is left alone.
  case "$text" in /baton|/baton[[:space:]]*) text='$baton'"${text#/baton}";; esac
  case "$then" in /baton|/baton[[:space:]]*) then='$baton'"${then#/baton}";; esac
fi
case "$text" in
  /*) ;;
  '$baton'|'$baton'[[:space:]]*) [ "$codex" = 1 ] || { echo "self-slash: \$baton is a Codex skill and goes only to a herdr pane herdr reports as codex (host $host, agent '${tui:-none}'); got: $text" >&2; exit 2; };;
  *) echo "self-slash: only slash commands (or \$baton on a Codex pane) are sent (got: $text)" >&2; exit 2;;
esac
case "$then" in
  ""|/*) ;;
  '$baton'|'$baton'[[:space:]]*) [ "$codex" = 1 ] || { echo "self-slash: --then \$baton is a Codex skill and goes only to a herdr pane herdr reports as codex (host $host, agent '${tui:-none}'); got: $then" >&2; exit 2; };;
  *) echo "self-slash: --then takes a slash command (got: $then)" >&2; exit 2;;
esac
if [ "$host" = paseo ]; then
  # Paseo's Claude provider knows /clear, not Claude Code's /new or /reset aliases.
  case "$text" in /new|/reset) text="/clear";; "/new "*|"/reset "*) text="/clear";; esac
  # ... and no /quit or /exit at all: sent as text they do nothing.  End = archive.
  case "$text" in
    /quit|/exit|"/quit "*|"/exit "*)
      [ "${SELF_SLASH_CHILD:-}" = "1" ] || [ "$finish_flag" = 1 ] || echo "self-slash: $text is not a Paseo command (it would reach Claude as plain text); mapping to --finish: archive this agent once idle, no --force" >&2
      finish=1;;
  esac
fi
# ... and a follow-up /quit or /exit would be sent as plain text, or end the fresh session.
if [ "$host" = paseo ] && [ "${SELF_SLASH_CHILD:-}" != "1" ]; then
  case "$then" in /quit|/exit|"/quit "*|"/exit "*) echo "self-slash: --then $then is not a Paseo command; use --finish after the turn instead" >&2; exit 2;; esac
fi
if [ "$finish" = 1 ] && [ -n "$then" ] && [ "${SELF_SLASH_CHILD:-}" != "1" ]; then echo "self-slash: $text ends the session and takes no --then (got: $then)" >&2; exit 2; fi
if [ "${SELF_SLASH_CHILD:-}" = "1" ]; then finish="${SELF_SLASH_FINISH:-0}"; fi
if [ "${SELF_SLASH_CHILD:-}" = "1" ]; then
  successor="${SELF_SLASH_SUCCESSOR:-}"; s_thinking="${SELF_SLASH_S_THINKING:-}"; s_mode="${SELF_SLASH_S_MODE:-}"; s_title="${SELF_SLASH_S_TITLE:-}"
  s_workspace="${SELF_SLASH_S_WORKSPACE:-}"; s_keepws="${SELF_SLASH_S_KEEPWS:-0}"; s_baton="${SELF_SLASH_S_BATON:-}"
fi
# --baton goes into the successor's first prompt and the log: an absolute path to an existing
# regular file of printable characters only (a relative path would resolve in the successor's cwd, a
# newline could forge a log line; adversary adv-selfslash-1, L1).  The waiter child re-checks the
# value it got through the environment.
if [ -n "$s_baton" ]; then
  case "$s_baton" in /*) ;; *) echo "self-slash: --baton takes an absolute path (got: $(clean "$s_baton"))" >&2; exit 2;; esac
  [ "$(clean "$s_baton")" = "$s_baton" ] || { echo "self-slash: --baton takes printable characters only (no newline or control character): $(clean "$s_baton")" >&2; exit 2; }
  [ -f "$s_baton" ] || { echo "self-slash: --baton is not an existing regular file: $s_baton" >&2; exit 2; }
fi
s_thinking="${s_thinking:-high}"
# herdr names the TUI in the pane's `agent` field. Prompt detection knows Codex (›), Claude Code (❯), cursor-agent (→) and omp
# (the input box's last row, `╰─ `, 2026-10-24: omp's row has no ❯, so --finish sent to an omp pane polled 9 times
# and gave up).  Another TUI cannot be read, so say so now: the waiter would only log "gave up" after ~50 s.
case "$tui" in cursor) marker="→";; omp) marker="╰─ ";; codex) marker="›";; *) marker="❯";; esac
if [ "$host" = herdr ] && [ -n "$tui" ] && [ "$tui" != claude ] && [ "$tui" != cursor ] && [ "$tui" != omp ] && [ "$tui" != codex ] && [ "${SELF_SLASH_CHILD:-}" != "1" ]; then
  echo "self-slash: warning: herdr reports agent '$tui' for $pane; prompt detection only knows claude, cursor, omp and codex, so the waiter will probably give up (exit 5, see $HOME/.local/state/self-slash.log)" >&2
fi
# herdr and Orca both send a long argument as a bracketed paste and Claude Code then
# treats it as pasted content, not a command (seen 2026-10-09 with ~900 chars): keep it short.
if [ "$host" != paseo ] && [ "${#text}" -gt "${SELF_SLASH_MAX:-300}" ]; then
  echo "self-slash: argument is ${#text} chars; anything over ~300 is pasted and the command is not run. Shorten it (or SELF_SLASH_MAX=N)." >&2; exit 2
fi
log="$HOME/.local/state/self-slash.log"
# One waiter per pane, and no second /compact soon after one: on 2026-10-10 the
# log showed five pairs sent to one pane within 1-3 minutes, and one compacted a
# freshly compacted 37k context into 126k (the queued second /compact ran after
# the first, and each one costs ~150k+ base-input-equivalent tokens). /new,
# /clear and /reset (aliases) count too: each throws the cached context away.
# The patterns match the child's "<date> <time> $host $pane: sent <text>" line.
gap_check() {
  case "$text" in /compact*|/new*|/clear*|/reset*) ;; *) return 0;; esac
  gap="${SELF_SLASH_COMPACT_GAP:-1800}"
  # Anchored at the line start (adversary 2026-10-23, L4): a logged agent name or title that
  # mentioned "<host> <pane>: sent /compact" must not count as a sent command.
  prev=$(ggrep -E "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9:]{8} $host $pane: sent /(compact|new|clear|reset)" "$log" 2>/dev/null | gtail -1)
  [ -n "$prev" ] || return 0
  ago=$(( $(gdate +%s) - $(gdate -d "${prev:0:19}" +%s 2>/dev/null || echo 0) ))
  [ "$ago" -lt "$gap" ] || return 0
  cmd=${prev#*: sent }; cmd=${cmd%% *}
  echo "self-slash: $cmd was already sent to $host $pane ${ago}s ago (< ${gap}s); not sending ${text%% *}. Compaction and a fresh session are not free; keep working (SELF_SLASH_COMPACT_GAP=N to override)."
  return 7
}
if [ "${SELF_SLASH_CHILD:-}" != "1" ]; then
  gap_check >&2 || exit 7
fi
lockdir="$HOME/.local/state/self-slash"
safe_pane=$(printf '%s' "$pane" | gtr -c 'A-Za-z0-9_.-' '_')
lock="$lockdir/$safe_pane.pid"
# Lifecycle actions (end the session, or throw its context away) hold a per-agent lock for
# the whole transition, /new -> /baton included, so two waiters cannot race (a /clear
# racing an archive).  The parent checks and takes it; the lock holds the waiter's pid.
tlock="$lockdir/${host}_$safe_pane.lifecycle"
self_name=$(basename "$0")
# A lock file holds "<pid><TAB><ps lstart>".  Held means the pid lives AND is still the process
# that took the lock (same start time; a bare-pid lock, from before this check, must at least
# be a self-slash process): a pid freed by a SIGKILL or a reboot and reused by any other
# long-lived process of the user is stale, not held (adversary 2026-10-20, finding 5).
proc_start() { ps -o lstart= -p "$1" 2>/dev/null | gtr -s ' ' ' ' | gsed 's/ *$//'; }
lock_stamp() { printf '%s\t%s\n' "$1" "$(proc_start "$1")"; }
lock_pid() { local c; c=$(cat "$1" 2>/dev/null); printf '%s' "${c%%$'\t'*}"; }
# lock_state FILE: print "free", "stale" (dead or reused pid, or an empty file that stayed
# empty) or "held <pid>".
lock_state() {
  local f="$1" c pid start now
  [ -e "$f" ] || { echo free; return; }
  c=$(cat "$f" 2>/dev/null)
  [ -n "$c" ] || { sleep 0.3; c=$(cat "$f" 2>/dev/null); }
  pid=${c%%$'\t'*}; start=""; case "$c" in *$'\t'*) start=${c#*$'\t'};; esac
  case "$pid" in ""|*[!0-9]*) echo stale; return;; esac
  kill -0 "$pid" 2>/dev/null || { echo stale; return; }
  if [ -n "$start" ]; then
    now=$(proc_start "$pid")
    [ "$now" = "$start" ] || { echo stale; return; }
  else
    case "$(ps -o command= -p "$pid" 2>/dev/null)" in *"$self_name --delay "*) ;; *) echo stale; return;; esac
  fi
  echo "held $pid"
}
tlock_state() { lock_state "$tlock"; }
# The .pid lock names only a pid: alive and still a self-slash WAITER (the parent always starts
# it as "$0" --delay ...), not any process whose command line mentions the script, such as a
# `tail -f` on its log or an editor on it (adversary round 2, 2026-10-20).
waiter_alive() {
  kill -0 "$1" 2>/dev/null || return 1
  case "$(ps -o command= -p "$1" 2>/dev/null)" in *"$self_name --delay "*) return 0;; *) return 1;; esac
}
if [ "${SELF_SLASH_CHILD:-}" != "1" ] && [ "$lifecycle" = 1 ]; then
  case "$(tlock_state)" in
    held*) holder=$(lock_pid "$tlock"); echo "self-slash: a lifecycle action (/new, /clear, /reset, /quit, /exit or --finish) is already queued for $host $pane (pid $holder); not queuing another. See $log." >&2; exit 7;;
  esac
fi
if [ "$dry" = 1 ]; then
  if [ "$finish" = 1 ] && [ "$host" = paseo ] && [ -n "$successor" ]; then
    s_model="${successor#*/}"; [ "$s_model" = "$successor" ] && s_model=""
    s_short="${s_model:-$successor}"; s_short="${s_short#claude-}"
    if [ -n "$s_title" ]; then dry_title="$s_title"; else dry_title="<old name> → $s_short"; fi
    echo "self-slash: dry run, would wait ${delay}s, then (every call with PASEO_AGENT_ID and PASEO_AGENT_CWD unset):"
    echo "  $paseo_cli wait $pane --timeout ${SELF_SLASH_WAIT:-900} --json"
    echo "  $paseo_cli agent inspect $pane --json            (name, mode, cwd)"
    echo "  $paseo_cli workspace ls --background --json      (this agent's workspace: exactly one row with cwd ${PASEO_AGENT_CWD:-<agent cwd>}${SELF_SLASH_WORKSPACE:+; SELF_SLASH_WORKSPACE=$SELF_SLASH_WORKSPACE only places the successor}${s_workspace:+; --workspace $s_workspace: its own row gives the successor cwd})"
    if [ -n "$s_workspace" ]; then dry_cwd="<cwd of that workspace>"; else dry_cwd="${PASEO_AGENT_CWD:-<agent cwd>}"; fi
    if [ -n "$s_mode" ]; then dry_mode=" --mode $s_mode"; else dry_mode=" --mode <agent mode if the same provider; claude: bypassPermissions; else none>"; fi
    echo "  $paseo_cli run \"/baton${s_baton:+ $s_baton}\" --provider $successor --thinking $s_thinking$dry_mode --workspace ${s_workspace:-<id>} --cwd $dry_cwd --title \"$dry_title\" --no-wait --json   (never --new-workspace)"
    echo "  $paseo_cli agent inspect <new id> --json         (polled up to ${SELF_SLASH_SUCCESSOR_SETTLE:-20}s; needs a new id, ParentAgentId null,${s_model:+ model $s_model,} status idle|running|initializing; else exit 11, nothing archived)"
    echo "  $paseo_cli agent archive -- $pane                (never --force)"
    if [ "$s_keepws" = 1 ]; then echo "  (--keep-workspace: the old workspace stays)"
    else
      echo "  then the old workspace is archived only when ALL hold (every doubt keeps it, logged):"
      echo "    it is proven this agent's (one cwd match, not an override or a tie-break), is not the successor's, is isolation local (never a worktree),"
      echo "    its cwd neither equals nor contains the successor's cwd,"
      echo "  $paseo_cli terminal ls --workspace <old id> --json     (none listed)"
      echo "  $paseo_cli ls --background --json                (no other agent in it: by workspaceId, else cwd equal to or below the workspace's)"
      echo "  $paseo_cli workspace archive -- <old id>"
    fi
  elif [ "$finish" = 1 ] && [ "$host" = herdr ] && [ -n "$successor" ]; then
    echo "self-slash: dry run, would wait ${delay}s, then: launch.py successor --pane $pane --model ${successor#*/} --effort ${s_thinking} ${s_mode:+--mode $s_mode }${s_baton:+--baton $s_baton }(waits for $pane to be idle, opens a tab in its workspace, starts claude there, prompts /baton, checks it; $pane is left idle, never closed)"
  elif [ "$finish" = 1 ] && [ "$host" = paseo ]; then
    echo "self-slash: dry run, would wait ${delay}s, wait for $pane to be idle, then archive it (paseo agent archive $pane, never --force)"
  else
    echo "self-slash: dry run, would send to $host $pane after ${delay}s: ${text:0:80}${then:+; then, once idle again: $then}"
  fi
  exit 0
fi
mkdir -p "$(dirname "$log")" "$lockdir"
prompt_line="$(dirname "$(grealpath "$0")")/../skills/session-finder/prompt_line.py"
if [ "${SELF_SLASH_CHILD:-}" != "1" ]; then
  after=""
  if [ -s "$lock" ] && waiter_alive "$(cat "$lock")"; then
    case "$text" in
      /compact*)
        echo "self-slash: a command is already queued for $host $pane (pid $(cat "$lock")); not queuing another. See $log." >&2; exit 7;;
      *)
        # A different command (e.g. /quit after autorename's /rename) runs after it.
        after="$(cat "$lock")"
        echo "self-slash: $host $pane already has a queued command (pid $after); this one runs after it" >&2;;
    esac
  fi
fi
if [ "${SELF_SLASH_CHILD:-}" != "1" ]; then
  if [ "$lifecycle" = 1 ]; then
    # Atomic create (noclobber) with our own pid as the placeholder; the waiter's pid
    # replaces it below.  A stale lock is moved aside (never rm: two callers that both read
    # "stale" would each delete the other's fresh lock), then looked at again: if what we
    # moved turns out to be held after all, it goes back (ln fails if a lock exists) and we stop.
    if [ "$(tlock_state)" = stale ]; then
      aside="$tlock.stale.$$"
      if mv "$tlock" "$aside" 2>/dev/null; then
        case "$(lock_state "$aside")" in
          held*) ln "$aside" "$tlock" 2>/dev/null; rm -f "$aside"
                 echo "self-slash: another lifecycle action won the lock for $host $pane (pid $(lock_pid "$tlock")); not queuing." >&2; exit 7;;
        esac
        rm -f "$aside"
      fi
    fi
    if ! ( set -C; lock_stamp $$ > "$tlock" ) 2>/dev/null; then
      echo "self-slash: another lifecycle action won the lock for $host $pane (pid $(lock_pid "$tlock")); not queuing." >&2; exit 7
    fi
  fi
  # A tool executor may clean up its process group after the parent exits.
  # Detach before Popen returns; nohup alone does not create a new session.
  child=$(SELF_SLASH_CHILD=1 SELF_SLASH_TUI="$tui" SELF_SLASH_AFTER="$after" SELF_SLASH_THEN="$then" SELF_SLASH_FINISH="$finish" \
    SELF_SLASH_SUCCESSOR="$successor" SELF_SLASH_S_THINKING="$s_thinking" SELF_SLASH_S_MODE="$s_mode" SELF_SLASH_S_TITLE="$s_title" \
    SELF_SLASH_S_WORKSPACE="$s_workspace" SELF_SLASH_S_KEEPWS="$s_keepws" SELF_SLASH_S_BATON="$s_baton" \
    SELF_SLASH_TLOCK="$([ "$lifecycle" = 1 ] && echo "$tlock")" \
    python3 - "$0" "$delay" "$text" "$log" <<'PY'
import subprocess, sys
with open(sys.argv[4], "ab") as log:
    child = subprocess.Popen([sys.argv[1], "--delay", sys.argv[2], sys.argv[3]],
                             stdin=subprocess.DEVNULL, stdout=log,
                             stderr=subprocess.STDOUT, start_new_session=True)
print(child.pid)
PY
  ) || { [ "$lifecycle" != 1 ] || [ "$(lock_pid "$tlock")" != "$$" ] || rm -f "$tlock"; echo "self-slash: could not detach waiter" >&2; exit 1; }
  if [ "$lifecycle" = 1 ]; then
    # Replace the placeholder only while it is still ours; if not, the child must not run.
    if [ "$(lock_pid "$tlock")" = "$$" ]; then lock_stamp "$child" > "$tlock.$$" && mv -f "$tlock.$$" "$tlock"
    else kill "$child" 2>/dev/null; echo "self-slash: the lifecycle lock for $host $pane changed hands; not queuing." >&2; exit 7; fi
  fi
  echo "self-slash: queued for $host $pane in ${delay}s${then:+, then $then once the session is idle again} (log: $log)"
  exit 0
fi

# read_screen: print the visible screen lines.  Orca's JSON also has a `draft`
# field, but it is not used: on 2026-10-09 it held Claude Code's dim hint text
# ("Press up to edit queued messages") while the rendered ❯ line was empty.
# classify_prompt: print NOPROMPT, EMPTY, or the operator's own text on the ❯ line.
# herdr is read with ANSI codes: Claude Code paints its hint text and its suggested
# next prompt (ghost text, accepted with Tab) in grey (38;2;153;153;153, the ❯'s own
# colour) or dim; the operator's typed text is in the default colour.  Seen
# 2026-10-09 17:00: a waiter sat for minutes on a ghost suggestion.  Verified
# 17:03: the suggestion ("did the compact fire this time?") arrived as plain dim
# (ESC[2m, no RGB grey), was classified EMPTY, and the /compact was sent over it.
classify_prompt() {
  if [ "$host" = paseo ]; then
    # No terminal input line: the GUI composer's draft is untouched by a CLI send.
    echo EMPTY
  elif [ "$host" = herdr ]; then
    # The rules (dim, grey, reverse video, known hints) live in prompt_line.py, shared with relay.py.
    herdr agent read "$pane" --source visible --lines 12 --format ansi 2>/dev/null \
      | python3 "$prompt_line" "$marker" 2>>"$log"
  else
    screen=$(read_screen)
    if ! printf "%s\n" "$screen" | ggrep -qE "^[[:space:]]*❯"; then echo NOPROMPT; return; fi
    prompt=$(printf "%s\n" "$screen" | ggrep -E "^[[:space:]]*❯" | gtail -1 | gsed -E "s/^[[:space:]]*❯[[:space:]]*//")
    case "$prompt" in "Try \""*|"Try “"*|"Press up to edit queued messages"*) prompt="";; esac
    echo "${prompt:-EMPTY}"
  fi
}
read_screen() {
  if [ "$host" = herdr ]; then
    herdr agent read "$pane" --source visible --lines 12 2>/dev/null
  else
    orca terminal read --terminal "$pane" --screen --limit 12 --json 2>/dev/null | python3 -c '
import json, sys
t = json.load(sys.stdin).get("result", {}).get("terminal", {})
print("\n".join(t.get("tail") or []))'
  fi
}
# Codex identity and receipt (2026-10-25).  `ident PANE`: `herdr agent get` must succeed and name provider codex, this pane,
# an idle or done status and a well-formed session record; prints "<session id>\t<rollout size>" (either may be empty/0 right
# after /new: Codex publishes a session id only with its first prompt) and exits 0, else prints the reason and exits 1.
# `wait PANE SID SIZE TEXT TYPED_AT SECS`: after the submit, polls herdr until the pane STILL reports codex and this same
# pane (a working status is expected; a failed or malformed answer proves nothing; another provider or pane ends the wait,
# exit 1) and the session it names has a rollout line, after the byte SIZE (from byte 0 when the session id changed since
# SID), stamped no earlier than TYPED_AT, whose user message is TEXT byte for byte; exit 0 only then.  The rollout shape and
# the id-to-file lookup are relay.py's (loaded, not copied); the comparison is deliberately NOT relay's whitespace-folded
# tx_state, because a path in TEXT may hold significant runs of spaces.  Any other mode: exit 2.
codex_proof() {
  python3 - "$(dirname "$(grealpath "$0")")/../skills/session-finder/relay.py" "$@" <<'PY'
import importlib.util, json, subprocess, sys, time
relay_py, mode = sys.argv[1], sys.argv[2]

def agent(pane):
    """herdr's agent record for PANE, or None when herdr fails or answers with something else."""
    try:
        r = subprocess.run(["herdr", "agent", "get", pane], stdin=subprocess.DEVNULL, capture_output=True, text=True,
                           timeout=15)
        a = (json.loads(r.stdout).get("result") or {}).get("agent")
    except (OSError, ValueError, AttributeError, subprocess.SubprocessError):
        return None
    return a if r.returncode == 0 and isinstance(a, dict) else None

def session(a):
    """(well-formed, session id): "" when herdr names none; a session record of any other shape is malformed."""
    s = a.get("agent_session")
    if s is None or (isinstance(s, dict) and s.get("value") is None):
        return True, ""
    return (True, s["value"]) if isinstance(s, dict) and isinstance(s.get("value"), str) else (False, "")

def load_relay():
    spec = importlib.util.spec_from_file_location("relay", relay_py)
    m = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(m)
    return m

def receipt(relay, tx, mark, text, since):
    """TX, after byte MARK, holds a user message whose single input_text block IS TEXT exactly, stamped >= SINCE."""
    with open(tx, "rb") as fh:
        fh.seek(mark)
        lines = fh.read().decode("utf-8", "replace").split("\n")
    for ln in lines:
        try:
            o = json.loads(ln)
        except ValueError:
            continue
        p = o.get("payload") if isinstance(o, dict) and o.get("type") == "response_item" else None
        if not (isinstance(p, dict) and p.get("type") == "message" and p.get("role") == "user"
                and isinstance(p.get("content"), list)):
            continue
        blocks = [b.get("text") for b in p["content"] if isinstance(b, dict) and b.get("type") == "input_text"]
        ts = relay._ts(o)
        if blocks == [text] and ts is not None and ts >= since:
            return True
    return False

if mode == "ident":
    pane = sys.argv[3]
    a = agent(pane)
    why = None
    if a is None:
        why = "herdr agent get failed or returned no agent record"
    elif a.get("agent") != "codex":
        why = f"herdr agent get reports agent {a.get('agent')!r}, not codex"
    elif a.get("pane_id") != pane:
        why = f"herdr agent get names pane {a.get('pane_id')!r}, not {pane}"
    elif a.get("agent_status") not in ("idle", "done"):
        why = f"codex status {a.get('agent_status') or 'unknown'}"
    elif not session(a)[0]:
        why = "herdr agent get names a malformed session record"
    if why:
        print(" ".join(why.split())[:160])
        sys.exit(1)
    sid, size = session(a)[1], 0
    if sid:
        tx = load_relay().pane_transcript({"agent": "codex", "sid": sid})
        size = tx.stat().st_size if tx and tx.is_file() else 0
    print(f"{sid}\t{size}")
    sys.exit(0)
elif mode == "wait":
    pane, pre_sid, pre_size, text, typed_at, secs = sys.argv[3:9]
    relay = load_relay()
    typed_at, deadline = float(typed_at), time.time() + float(secs)
    while True:
        a = agent(pane)
        if a is not None:
            if a.get("agent") != "codex" or a.get("pane_id") != pane:
                sys.exit(f"after the submit herdr reports agent {a.get('agent')!r} on pane {a.get('pane_id')!r}, not codex on {pane}")
            ok, sid = session(a)
            tx = relay.pane_transcript({"agent": "codex", "sid": sid}) if ok and sid else None
            if tx is not None and tx.is_file() and receipt(relay, tx, int(pre_size) if sid == pre_sid else 0, text, typed_at):
                print("delivered")
                sys.exit(0)
        if time.time() >= deadline:
            sys.exit("no exact user message in the rollout before the deadline")
        time.sleep(0.5)
else:
    sys.exit(f"codex_proof: unknown mode {mode!r}")
PY
}
send_text() {
  if [ "$host" = paseo ]; then
    # PASEO_AGENT_ID unset so the daemon does not envelope the send as agent-to-agent
    # text; --behavior steer so a turn that began meanwhile is never torn down.
    out=$(env -u PASEO_AGENT_ID -u PASEO_AGENT_CWD "$paseo_cli" send "$pane" --no-wait --behavior steer --json "$text" 2>&1) || { echo "$(gdate '+%F %T') $host $pane: paseo send failed: ${out:0:200}"; return 1; }
    echo "$(gdate '+%F %T') $host $pane: paseo send: $(printf '%s' "$out" | gtr -s ' \n' ' ' | gcut -c1-160)"
    return 0
  elif [ "$host" = herdr ]; then
    if [ "$tui" = codex ]; then
      # The target is looked at again right before the submit: provider, pane and status come from herdr itself.
      if ! ident=$(codex_proof ident "$pane" 2>>"$log"); then
        echo "$(gdate '+%F %T') $host $pane: Codex identity not confirmed ($(clean "$ident")); NOT submitted: ${text:0:80}"
        exit 8
      fi
      pre_sid=${ident%%$'\t'*}; pre_size=${ident#*$'\t'}
      typed_at=$(gdate +%s.%N)
      if ! herdr agent prompt "$pane" "$text"; then
        echo "$(gdate '+%F %T') $host $pane: Codex submission failed or is unverified; NOT retried"
        exit 8
      fi
      case "$text" in
        '$baton'|'$baton'[[:space:]]*)
          # A skill prompt: one submit, no Enter, no retry.  Only the rollout's exact user message is a receipt.
          if codex_proof wait "$pane" "$pre_sid" "$pre_size" "$text" "$typed_at" "${SELF_SLASH_RECEIPT_WAIT:-30}" >/dev/null 2>>"$log"; then
            echo "$(gdate '+%F %T') $host $pane: Codex transcript holds exactly: ${text:0:80}"
            return 0
          fi
          echo "$(gdate '+%F %T') $host $pane: Codex transcript does not show ${text:0:80} within ${SELF_SLASH_RECEIPT_WAIT:-30}s; NOT confirmed delivered, NOT retried, no Enter sent"
          exit 8;;
      esac
    else
      herdr pane run "$pane" "$text" || return 1
    fi
    # The first Enter after a slash command can only accept the autocomplete row, and the
    # command stays on the input line unrun (Claude Code too: /reload-plugins was logged
    # "sent" on 2026-10-18 and never ran). So for every TUI, press Enter again while the
    # typed text is still on the input line. The last → line may be the still-open
    # autocomplete row ("→ /quit   Exit", seen 2026-10-10), so match the text as a prefix.
    for _ in 1 2 3; do
      sleep 2
      case "$(classify_prompt)" in "$text"*) herdr agent send-keys "$pane" enter >/dev/null ;; *) return 0 ;; esac
    done
    sleep 2
    case "$(classify_prompt)" in "$text"*)
      # Still on the line: do not type it again (that would append a second copy). Stop here.
      echo "$(gdate '+%F %T') $host $pane: $text is still on the input line after 3 Enters; NOT confirmed run, left for the operator"
      exit 8;;
    esac
    return 0
  else
    orca terminal send --terminal "$pane" --text "$text" --enter --wait-submit 10 --json || return 1
    # Same check as herdr: the receipt says the text was accepted, not that it ran, and the
    # command can stay on the input line. Press Enter again while it is still there; never retype.
    for _ in 1 2 3; do
      sleep 2
      case "$(classify_prompt)" in "$text"*) orca terminal send --terminal "$pane" --enter --json >/dev/null 2>&1 || true ;; *) return 0 ;; esac
    done
    sleep 2
    case "$(classify_prompt)" in "$text"*)
      echo "$(gdate '+%F %T') $host $pane: $text is still on the input line after 3 Enters; NOT confirmed run, left for the operator"
      exit 8;;
    esac
    return 0
  fi
}

# Queued behind another waiter: wait for it to finish (bounded), then take the lock.
if [ -n "${SELF_SLASH_AFTER:-}" ]; then
  end=$(( $(gdate +%s) + ${SELF_SLASH_WAIT:-900} ))
  while kill -0 "$SELF_SLASH_AFTER" 2>/dev/null; do
    [ "$(gdate +%s)" -lt "$end" ] || { echo "$(gdate '+%F %T') $host $pane: waiter $SELF_SLASH_AFTER still queued after ${SELF_SLASH_WAIT:-900}s; NOT sent: ${text:0:80}"; exit 7; }
    sleep 2
  done
  # The one ahead may have been a /compact or /new: re-check the gap.
  msg=$(gap_check) || { echo "$(gdate '+%F %T') $host $pane: NOT sent: ${msg#self-slash: }"; exit 7; }
fi
# Two parents can pass the check above before either child writes the lock.
if [ -s "$lock" ] && [ "$(cat "$lock")" != "$$" ] && waiter_alive "$(cat "$lock")"; then
  echo "$(gdate '+%F %T') $host $pane: another waiter (pid $(cat "$lock")) already queued; NOT sent: ${text:0:80}"; exit 7
fi
echo $$ > "$lock"
# The lifecycle lock, when this chain holds one, names this pid (the parent wrote it):
# release it with the pid lock, but only if it is still ours.
release() {
  rm -f "$lock"
  tl="${SELF_SLASH_TLOCK:-}"
  [ -n "$tl" ] && [ "$(lock_pid "$tl")" = "$$" ] && rm -f "$tl"
  return 0
}
trap release EXIT
sleep "$delay"
# herdr: never send while the session is mid-turn (status "working"); the input is
# accepted but Claude Code never runs it.  Wait for idle, bounded by SELF_SLASH_WAIT.
wait_idle() {
  if [ "$host" = paseo ]; then
    # Idle is the daemon's own state; a root-only command sent to a running agent
    # is either enveloped into the turn as text or interrupts it, never run.
    st=$("$paseo_cli" agent inspect "$pane" --json 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("Status",""))' 2>/dev/null)
    [ "$st" = idle ] && return 0
    echo "$(gdate '+%F %T') $host $pane: agent is ${st:-unknown}, waiting for idle before sending"
    "$paseo_cli" wait "$pane" --timeout "${SELF_SLASH_WAIT:-900}" --json >/dev/null 2>&1 \
      || { echo "$(gdate '+%F %T') $host $pane: gave up after ${SELF_SLASH_WAIT:-900}s, agent still running; NOT sent: ${text:0:80}"; exit 6; }
    return 0
  fi
  [ "$host" = herdr ] || return 0
  if [ "$tui" = omp ]; then
    # herdr has no state detector for omp (`herdr agent explain`: default_known_agent_idle_fallback), so
    # its status is "idle" mid-turn too and the check below never waits.  omp's own signal is the terminal
    # title: "π ⠙ <session title>" (a braille spinner) while a turn runs, "π > <dir>" when it is idle
    # (seen 2026-10-24).  A /quit sent mid-turn would run at once and cut the turn off.
    waited=0; said=0
    while :; do
      title=$(herdr pane get "$pane" 2>/dev/null | python3 -c '
import json, sys
print(json.load(sys.stdin).get("result", {}).get("pane", {}).get("terminal_title_stripped", ""))' 2>/dev/null)
      case "$title" in "π "[⠀-⣿]*) ;; *) return 0;; esac
      [ "$said" = 1 ] || { echo "$(gdate '+%F %T') $host $pane: omp turn running (title spinner), waiting for idle before sending"; said=1; }
      [ "$waited" -lt "${SELF_SLASH_WAIT:-900}" ] || { echo "$(gdate '+%F %T') $host $pane: gave up after ${waited}s, omp still running; NOT sent: ${text:0:80}"; exit 6; }
      sleep 5; waited=$((waited+5))
    done
  fi
  waited=0; said=0
  while :; do
    st=$(herdr pane list 2>/dev/null | python3 -c '
import json, sys
pane = sys.argv[1]
for p in json.load(sys.stdin).get("result", {}).get("panes", []):
    if p.get("pane_id") == pane: print(p.get("agent_status", "")); break' "$pane" 2>/dev/null)
    if [ "$tui" = codex ]; then
      # A Codex composer remains visible mid-turn. Unknown/blocked state is
      # never permission to submit a lifecycle command or answer a dialog.
      case "$st" in idle|done) return 0;; esac
      [ "$said" = 1 ] || { echo "$(gdate '+%F %T') $host $pane: codex status ${st:-unknown}, waiting for idle before sending"; said=1; }
      [ "$waited" -lt "${SELF_SLASH_WAIT:-900}" ] || { echo "$(gdate '+%F %T') $host $pane: codex did not become idle; NOT sent: ${text:0:80}"; exit 6; }
      sleep 5; waited=$((waited+5)); continue
    fi
    [ "$st" = working ] || return 0
    # herdr says "working" whenever Claude Code's title glyph is busy, which it
    # also is while only a BACKGROUND sub-agent runs and the main turn is over
    # (2026-10-09 19:25: a /compact waited 15 min beside an idle prompt because a
    # writer sub-agent was running, then gave up).  The main turn's own marker is
    # the spinner line above the input box ("✻ Cultivating… (1m 4s · ↓ 2.8k
    # tokens)", or "esc to interrupt"); no such line means the turn has ended and
    # the command will run, so treat that as idle.  cursor-agent's marker is
    # "ctrl+c to stop" at the right of its input box.
    if ! herdr agent read "$pane" --source visible --lines 60 2>/dev/null | ggrep -qE '…[[:space:]]*\([0-9]+[smh]|esc to interrupt|ctrl\+c to stop'; then
      [ "$said" = 2 ] || { echo "$(gdate '+%F %T') $host $pane: status working but no main-turn spinner on screen (background sub-agent only); treating as idle"; said=2; }
      return 0
    fi
    [ "$said" = 1 ] || { echo "$(gdate '+%F %T') $host $pane: session is working, waiting for idle before sending"; said=1; }
    [ "$waited" -lt "${SELF_SLASH_WAIT:-900}" ] || { echo "$(gdate '+%F %T') $host $pane: gave up after ${waited}s, session still working; NOT sent: ${text:0:80}"; exit 6; }
    sleep 5; waited=$((waited+5))
  done
}
# Paseo --finish: archive this agent, without --force.  `paseo wait` blocks until the
# agent is idle (the turn that queued this has ended), so the final message is in the
# timeline that archive snapshots.  An agent that became busy again is refused by archive
# itself; never escalate to --force (it interrupts the running turn).  The env -u keeps
# the daemon from treating the call as agent-originated, as in send_text.  The `--` ends option
# parsing (the CLI is commander 12, which honours it; read from the Paseo.app bundle 2026-10-20).
finish_paseo() {
  env -u PASEO_AGENT_ID -u PASEO_AGENT_CWD "$paseo_cli" wait "$pane" --timeout "${SELF_SLASH_WAIT:-900}" --json >/dev/null 2>&1 \
    || { echo "$(gdate '+%F %T') $host $pane: finish: gave up after ${SELF_SLASH_WAIT:-900}s, agent still running; NOT archived"; exit 6; }
  out=$(env -u PASEO_AGENT_ID -u PASEO_AGENT_CWD "$paseo_cli" agent archive -- "$pane" 2>&1); rc=$?
  if [ "$rc" = 0 ]; then
    echo "$(gdate '+%F %T') $host $pane: finish: archived $pane"; exit 0
  fi
  echo "$(gdate '+%F %T') $host $pane: finish: archive refused (rc=$rc): $(printf '%s' "$out" | gtr -s ' \n' ' ' | gcut -c1-200)"; exit 8
}
# Paseo --finish --successor: start the successor agent, check it, then archive this one.
# Every paseo call runs with PASEO_AGENT_ID and PASEO_AGENT_CWD unset (see the header: the run
# would otherwise create a subagent).  Failures before the archive exit 11 and leave this
# agent as it is.  The workspace id is looked up by cwd because `paseo agent inspect` does not
# print it on 0.12.0 (upstream getpaseo/paseo#7592).
successor_fail() { echo "$(gdate '+%F %T') $host $pane: successor: $(clean "$1"); NOT archived, this session stays usable"; exit 11; }
pcli() { env -u PASEO_AGENT_ID -u PASEO_AGENT_CWD "$paseo_cli" "$@"; }
# jfield JSON-TEXT KEY...: the first KEY present in the top-level JSON OBJECT (null prints an empty
# line); exit 3 when the text is not an object or no key is present (a renamed key must not read
# as null, L2; a list is never unwrapped, L1).  jfield_nn is the same but a null value is also
# exit 3, and so is any value that is not a string (an object, a number, a bool): the key is
# "present" only with a string value (adv-selfslash-4 F1).
jfield_py() {
  printf '%s' "$2" | python3 -c '
import json, sys
# Strict: the whole text is one JSON value.  `paseo run --json` prints "Using workspace <id>" on
# stderr (console.error), which the caller keeps apart (adv-selfslash-1, L4).
try:
    d = json.loads(sys.stdin.read())
except ValueError:
    sys.exit(3)
if not isinstance(d, dict):
    sys.exit(3)
nonnull = sys.argv[1] == "1"
for k in sys.argv[2:]:
    if k in d:
        v = d[k]
        if nonnull and not isinstance(v, str):
            sys.exit(3)
        print("" if v is None else v)
        sys.exit(0)
sys.exit(3)' "$1" "${@:3}" 2>/dev/null
}
jfield() { local text="$1"; shift; jfield_py 0 "$text" "$@"; }
jfield_nn() { local text="$1"; shift; jfield_py 1 "$text" "$@"; }
# workspace_plan AGENT-CWD: from `paseo workspace ls --background --json` on stdin print one JSON
# object: ws (where the successor goes), cwd (its --cwd: the target workspace's own row when
# --workspace names one, else "" = this agent's), old_ws (this agent's workspace), proven (1 only
# for exactly one realpath-cwd match, or an override whose row has this agent's cwd), old_iso,
# old_cwd, note, err.  An id from the override or the prefer-foreground tie-break may PLACE the
# successor but is never an archive target (M1); the cwd of a --workspace target never falls
# back to this agent's (H1).
workspace_plan() {
  python3 -c '
import json, os, sys
agent_cwd = os.path.realpath(sys.argv[1]); override, target = sys.argv[2], sys.argv[3]
out = dict(ws="", cwd="", old_ws="", proven="0", old_iso="", old_cwd="", note="", err="")
def emit():
    print(json.dumps(out)); sys.exit(0)
try:
    rows = json.load(sys.stdin)
except ValueError:
    rows = None
if isinstance(rows, dict):
    rows = next((v for v in rows.values() if isinstance(v, list)), None)
if not isinstance(rows, list):
    out["err"] = "workspace ls printed no list"; emit()
rows = [r for r in rows if isinstance(r, dict) and r.get("workspaceId")]
byid = {r["workspaceId"]: r for r in rows}
def rp(r):
    c = r.get("cwd") if r else None
    return os.path.realpath(c) if isinstance(c, str) and c else None
old = ""
# Proof that a row is the workspace of THIS agent: exactly one row has the realpath cwd of this agent, and no
# other row cwd is a proper ancestor of it (an agent may live in a subdirectory of its workspace,
# so a workspace whose cwd is exactly that subdirectory could belong to another agent, adversary round 2 L3).
hit = [r for r in rows if rp(r) == agent_cwd]
ancestor = any(rp(r) and agent_cwd.startswith(rp(r).rstrip("/") + "/") for r in rows)
unique = len(hit) == 1 and not ancestor
if override:
    old = override
    if unique and hit[0]["workspaceId"] == override:
        out["proven"] = "1"
    else:
        out["note"] = "SELF_SLASH_WORKSPACE " + override + " is not proven to be this agent workspace (it is not the only row with this cwd, or a workspace above that cwd exists), so it is never archived"
else:
    if len(hit) == 1:
        old = hit[0]["workspaceId"]
        if ancestor:
            out["note"] = old + " has this cwd but a workspace above it exists, so this agent may live in that one; never archived"
        else:
            out["proven"] = "1"
    elif len(hit) > 1:
        fg = [r for r in hit if not r.get("background")]
        if len(fg) == 1:
            old = fg[0]["workspaceId"]
            out["note"] = "several workspaces share this cwd; " + old + " was picked by preference and is never archived"
        else:
            out["note"] = "several workspaces share this cwd, none can be told to be this agent one"
out["old_ws"] = old
orow = byid.get(old)
if orow:
    out["old_iso"] = str(orow.get("isolation") or ""); out["old_cwd"] = orow.get("cwd") or ""
if target:
    trow = byid.get(target)
    if rp(trow) is None:
        out["err"] = "workspace " + target + " is not in workspace ls or has no cwd"; emit()
    out["ws"] = target; out["cwd"] = trow["cwd"]
else:
    out["ws"] = old
    if not old:
        out["err"] = out["note"] or "no Paseo workspace has this cwd"
emit()' "$@" 2>/dev/null
}
# paths_overlap OLD-CWD RUN-CWD: exit 0 when OLD equals or contains RUN (realpath), so the old
# workspace backs the successor's directory.
paths_overlap() {
  python3 -c '
import os, sys
a, b = os.path.realpath(sys.argv[1]), os.path.realpath(sys.argv[2])
sys.exit(0 if b == a or b.startswith(a.rstrip("/") + "/") else 1)' "$1" "$2" 2>/dev/null
}
# pcli_split ARGS...: one paseo call, stdout alone in $pcli_out (the only text parsed as JSON),
# stderr in $pcli_err (status lines, Node warnings; shown only in a failure message), rc in $pcli_rc.
# stderr goes to one fixed file per pane under $lockdir, removed at once and overwritten by the next
# call, so a signal can leave at most that one file, never an accumulating mktemp pile
# (adv-selfslash-2 L2); a TERM/INT trap would need a second cleanup path for the same bound.
pcli_split() {
  local errf="$lockdir/$safe_pane.paseo-err"
  pcli_out=$(pcli "$@" 2>"$errf"); pcli_rc=$?
  pcli_err=$(cat "$errf" 2>/dev/null); rm -f "$errf"
}
successor_paseo() {
  pcli wait "$pane" --timeout "${SELF_SLASH_WAIT:-900}" --json >/dev/null 2>&1 \
    || { echo "$(gdate '+%F %T') $host $pane: finish: gave up after ${SELF_SLASH_WAIT:-900}s, agent still running; NOT archived"; exit 6; }
  pcli_split agent inspect "$pane" --json; info="$pcli_out"
  [ "$pcli_rc" = 0 ] || successor_fail "inspect of this agent failed: $(printf '%s' "$pcli_out $pcli_err" | gtr -s ' \n' ' ' | gcut -c1-200)"
  # Fail closed: defaults must never replace an unreadable old mode (a plan-mode agent would get a
  # bypassPermissions successor, adv-selfslash-2 L1).
  jfield "$info" Id Name Status >/dev/null || successor_fail "inspect of this agent printed no single JSON object (got: $(printf '%s' "$pcli_out${pcli_err:+ stderr: $pcli_err}" | gtr -s ' \n' ' ' | gcut -c1-160)); nothing was started"
  old_name=$(jfield "$info" Name); old_cwd=$(jfield "$info" Cwd)
  cwd="${PASEO_AGENT_CWD:-$old_cwd}"
  [ -n "$cwd" ] || successor_fail "this agent cwd is unknown"
  wsout=$(pcli workspace ls --background --json 2>&1) || successor_fail "workspace ls failed: $(printf '%s' "$wsout" | gtr -s ' \n' ' ' | gcut -c1-200)"
  plan=$(printf '%s' "$wsout" | workspace_plan "$cwd" "${SELF_SLASH_WORKSPACE:-}" "$s_workspace")
  [ -n "$plan" ] || successor_fail "workspace ls output could not be read"
  perr=$(jfield "$plan" err); [ -z "$perr" ] || successor_fail "$perr (SELF_SLASH_WORKSPACE=<id> or --workspace <id> names one)"
  ws=$(jfield "$plan" ws); run_cwd=$(jfield "$plan" cwd); run_cwd="${run_cwd:-$cwd}"
  old_ws=$(jfield "$plan" old_ws); proven=$(jfield "$plan" proven); old_iso=$(jfield "$plan" old_iso)
  old_wcwd=$(jfield "$plan" old_cwd); ws_note=$(jfield "$plan" note)
  s_model="${successor#*/}"; [ "$s_model" = "$successor" ] && s_model=""
  # The old mode is a provider's own id: copied only to the same provider (an omp "full" is not a
  # claude mode, 2026-10-23); a claude successor from another provider runs bypassPermissions (every
  # agent runs yolo, home rule 16); any other provider gets its own default.
  mode="$s_mode"
  if [ -z "$mode" ]; then
    # No explicit --mode: the successor gets this agent's own mode or none.  A Provider or Mode this
    # agent's inspect does not carry (key missing, null) is never replaced by a default (adv-selfslash-3 F1).
    old_provider=$(jfield_nn "$info" Provider) && [ -n "$old_provider" ] || successor_fail "inspect of this agent has no Provider, so its mode cannot be passed on safely (--mode MODE names one); nothing was started"
    old_mode=$(jfield_nn "$info" Mode) || successor_fail "inspect of this agent has no Mode value, so its mode cannot be passed on safely (--mode MODE names one); nothing was started"
    # Only a plain lower-case provider id and a plain mode name are believed: "Claude", " claude" or
    # a mode with spaces would otherwise read as another provider and take the bypassPermissions
    # branch (adv-selfslash-4 F1).
    case "$old_provider" in *[!"$lc$dg"_-]*) successor_fail "inspect of this agent gives Provider '$old_provider', not a plain provider id, so its mode cannot be passed on safely (--mode MODE names one); nothing was started";; esac
    case "$old_mode" in *[!"$uc$lc$dg"_-]*) successor_fail "inspect of this agent gives Mode '$old_mode', not a plain mode name, so its mode cannot be passed on safely (--mode MODE names one); nothing was started";; esac
    # The same provider gets the old mode as it is: an empty one (no mode set) passes no --mode, the
    # provider's own default, never a made-up mode name.
    if [ "${successor%%/*}" = "$old_provider" ]; then mode="$old_mode"
    elif [ "${successor%%/*}" = claude ]; then mode=bypassPermissions
    fi
  fi
  first_prompt="/baton${s_baton:+ $s_baton}"
  old_name=$(clean "$old_name"); [ "$old_name" != "-" ] || old_name=""
  # A short title: its first words are all the sidebar shows.
  short_name=$(printf '%s' "${old_name:-agent}" | python3 -c 'import sys; print(sys.stdin.read()[:24].rstrip())')
  short_model="${s_model:-$successor}"; short_model="${short_model#claude-}"
  title=$(clean "${s_title:-$short_name → $short_model}")
  settle="${SELF_SLASH_SUCCESSOR_SETTLE-20}"
  case "$settle" in ""|*[!0-9]*) successor_fail "SELF_SLASH_SUCCESSOR_SETTLE must be whole seconds (got: $settle); nothing was started";; esac
  echo "$(gdate '+%F %T') $host $pane: successor: starting $successor (thinking $s_thinking, mode ${mode:-<provider default>}, workspace $(clean "$ws"), cwd $(clean "$run_cwd"), title \"$title\", prompt \"$(clean "$first_prompt")\")"
  # Empty on a bash older than 4.4 is "unbound" under set -u unless the expansion is guarded.
  mode_args=(); [ -z "$mode" ] || mode_args=(--mode "$mode")
  # JSON comes from stdout alone: Paseo prints its status lines ("Using workspace <id>") and any Node
  # warning on stderr, which pcli_split keeps apart; only a failure message shows it (adv-selfslash-1, L4).
  pcli_split run "$first_prompt" --provider "$successor" --thinking "$s_thinking" ${mode_args[@]+"${mode_args[@]}"} --workspace "$ws" --cwd "$run_cwd" --title "$title" --no-wait --json
  rc="$pcli_rc"; runout="$pcli_out"
  [ "$rc" = 0 ] || successor_fail "paseo run failed (rc=$rc): $(printf '%s' "$pcli_out $pcli_err" | gtr -s ' \n' ' ' | gcut -c1-200)"
  newid=$(jfield "$runout" agentId id Id) || successor_fail "paseo run printed no single agent object with an id: $(printf '%s' "$pcli_out${pcli_err:+ stderr: $pcli_err}" | gtr -s ' \n' ' ' | gcut -c1-200)"
  case "$newid" in ""|*[!"$uc$lc$dg"._:-]*) successor_fail "paseo run printed an unusable agent id";; esac
  if [ "$newid" = "$pane" ] || [ "$newid" = "${pane:0:7}" ] || [ "${newid:0:7}" = "${pane:0:7}" ]; then
    successor_fail "paseo run returned this agent own id ($newid), not a new agent"
  fi
  # Poll the new agent for up to SELF_SLASH_SUCCESSOR_SETTLE seconds (default 20; a late error,
  # as upstream #5705's version gate, shows in the first seconds, L6).  Any bad look is final.
  end=$(( $(gdate +%s) + settle )); seen=0; nmodel=""; nstatus=""
  while :; do
    pcli_split agent inspect "$newid" --json; ninfo="$pcli_out"
    nerr="$pcli_out${pcli_err:+ stderr: $pcli_err}"
    if [ "$pcli_rc" = 0 ]; then
      seen=1
      parent=$(jfield "$ninfo" ParentAgentId) || successor_fail "successor $newid: inspect has no ParentAgentId key, cannot tell it is top-level (got: $(printf '%s' "$nerr" | gtr -s ' \n' ' ' | gcut -c1-160); left running)"
      nstatus=$(jfield "$ninfo" Status) || successor_fail "successor $newid: inspect has no Status key (left running)"
      nmodel=$(jfield "$ninfo" Model) || nmodel=""
      [ -z "$parent" ] || successor_fail "successor $newid is a subagent (ParentAgentId $parent; left running)"
      case "$nstatus" in idle|running|initializing) ;; *) successor_fail "successor $newid is in status '$nstatus', not idle, running or initializing (left running)";; esac
      case "$nmodel" in ""|"-") ;; *) [ -z "$s_model" ] || [ "$nmodel" = "$s_model" ] || successor_fail "successor $newid runs model '$nmodel', not $s_model (left running)";; esac
    elif [ "$seen" = 1 ]; then
      successor_fail "successor $newid answered inspect once and then failed: $(printf '%s' "$nerr" | gtr -s ' \n' ' ' | gcut -c1-120) (left running)"
    fi
    [ "$(gdate +%s)" -lt "$end" ] || break
    sleep 2
  done
  [ "$seen" = 1 ] || successor_fail "successor $newid started but inspect never answered: $(printf '%s' "$nerr" | gtr -s ' \n' ' ' | gcut -c1-200) (left running)"
  [ -z "$s_model" ] || [ "$nmodel" = "$s_model" ] || successor_fail "successor $newid runs model '${nmodel:-?}', not $s_model (left running)"
  echo "$(gdate '+%F %T') $host $pane: successor: $newid is top-level on $(clean "${nmodel:-$successor}") (status $(clean "$nstatus"))"
  out=$(pcli agent archive -- "$pane" 2>&1); rc=$?
  if [ "$rc" != 0 ]; then
    echo "$(gdate '+%F %T') $host $pane: finish: archive refused (rc=$rc): $(printf '%s' "$out" | gtr -s ' \n' ' ' | gcut -c1-200); successor $newid left running"; exit 8
  fi
  echo "$(gdate '+%F %T') $host $pane: finish: archived $pane (successor $newid)"
  close_old_workspace
  exit 0
}
# After the old agent is archived: archive its workspace too, but only when it is PROVEN no longer
# needed, because `paseo workspace archive` archives every agent of the workspace by id, kills its
# terminals and deletes a Paseo-owned worktree (Paseo 0.12.0, adversary 2026-10-23).  All of these
# must hold, any doubt keeps the workspace with the reason logged, never an error:
#   1. no --keep-workspace; 2. the id is proven this agent's (M1: exactly one realpath-cwd match,
#   or an override whose row has this agent's cwd); 3. it is not the successor's workspace;
#   4. its row says isolation "local" (never a worktree); 5. its cwd neither equals nor contains
#   the successor's cwd (H1); 6. `paseo terminal ls --workspace` lists none; 7. no other agent
#   (not this one, not the successor) is in it: by workspaceId when the `paseo ls --json` row
#   carries one, else by cwd equal to or below the workspace's cwd (M2).
close_old_workspace() {
  wlog() { echo "$(gdate '+%F %T') $host $pane: workspace: $(clean "$1")"; }
  if [ "$s_keepws" = 1 ]; then wlog "kept (--keep-workspace)"; return 0; fi
  if [ -z "$old_ws" ]; then wlog "kept: ${ws_note:-the workspace of this agent is unknown}"; return 0; fi
  if [ "$old_ws" = "$ws" ]; then wlog "$old_ws kept: the successor lives in it"; return 0; fi
  if [ "$proven" != 1 ]; then wlog "$old_ws kept: ${ws_note:-not proven to be this agent workspace}"; return 0; fi
  if [ "$old_iso" != local ]; then wlog "$old_ws kept: ${old_iso:-unknown} workspace, archive it yourself (archiving a worktree workspace deletes the worktree)"; return 0; fi
  if [ -z "$old_wcwd" ]; then wlog "$old_ws kept: its cwd is unknown"; return 0; fi
  if paths_overlap "$old_wcwd" "$run_cwd"; then wlog "$old_ws kept: its cwd $old_wcwd equals or contains the successor cwd $run_cwd"; return 0; fi
  tout=$(pcli terminal ls --workspace "$old_ws" --json 2>&1) || { wlog "$old_ws kept: terminal ls failed: $(printf '%s' "$tout" | gtr -s ' \n' ' ' | gcut -c1-120)"; return 0; }
  terms=$(printf '%s' "$tout" | python3 -c '
import json, sys
try:
    rows = json.load(sys.stdin)
except ValueError:
    print("unparsable"); sys.exit(0)
if isinstance(rows, dict):
    rows = next((v for v in rows.values() if isinstance(v, list)), None)
print("unparsable" if not isinstance(rows, list) else len(rows))' 2>/dev/null) || terms="unparsable"
  if [ "$terms" != 0 ]; then wlog "$old_ws kept: terminals in it ($terms)"; return 0; fi
  lsout=$(pcli ls --background --json 2>&1) || { wlog "$old_ws kept: paseo ls failed: $(printf '%s' "$lsout" | gtr -s ' \n' ' ' | gcut -c1-120)"; return 0; }
  others=$(printf '%s' "$lsout" | python3 -c '
import json, os, sys
wcwd = os.path.realpath(sys.argv[1]); wid = sys.argv[2]; skip = set(sys.argv[3:])
try:
    rows = json.load(sys.stdin)
except ValueError:
    print("unparsable"); sys.exit(0)
if isinstance(rows, dict):
    rows = next((v for v in rows.values() if isinstance(v, list)), None)
if not isinstance(rows, list):
    print("unparsable"); sys.exit(0)
names = []
for r in rows:
    if not isinstance(r, dict) or r.get("id") in skip or r.get("shortId") in skip:
        continue
    name = str(r.get("shortId") or r.get("id") or "?")
    rwid = r.get("workspaceId")
    if rwid:
        if rwid == wid:
            names.append(name)
        continue
    c = r.get("cwd")
    if not isinstance(c, str) or not c:
        names.append(name); continue
    c = os.path.realpath(os.path.expanduser(c))
    if c == wcwd or c.startswith(wcwd.rstrip("/") + "/"):
        names.append(name)
print(" ".join(names))' "$old_wcwd" "$old_ws" "$pane" "${pane:0:7}" "$newid" "${newid:0:7}" 2>/dev/null) || others="unparsable"
  if [ -n "$others" ]; then wlog "$old_ws kept: other agents in it or below $old_wcwd: ${others:0:80}"; return 0; fi
  out=$(pcli workspace archive -- "$old_ws" 2>&1); rc=$?
  if [ "$rc" = 0 ]; then wlog "archived $old_ws (local, no terminals, no other agent; the successor is in $ws)"
  else wlog "$old_ws kept: workspace archive failed (rc=$rc): $(printf '%s' "$out" | gtr -s ' \n' ' ' | gcut -c1-160)"; fi
  return 0
}
if [ "$finish" = 1 ] && [ "$host" = paseo ] && [ -n "$successor" ]; then successor_paseo; fi
# Unreachable unless successor_paseo returned or aborted without exiting (a bash arithmetic error
# once fell through to the bare archive, adversary round 2, L1): never archive unverified.
if [ "$finish" = 1 ] && [ "$host" = paseo ] && [ -n "$successor" ]; then
  echo "$(gdate '+%F %T') $host $pane: successor path aborted; NOT archived, this session stays usable"; exit 11
fi
if [ "$finish" = 1 ] && [ "$host" = paseo ] && [ -z "$successor" ]; then finish_paseo; fi
# herdr --finish --successor claude/MODEL: launch.py's `successor` waits for idle, opens a tab in this pane's
# workspace, starts a real claude TUI there on the model asked, prompts /baton and checks it; exit 11 on any
# failure.  The old pane is left idle for herdr-tidy, never closed or exited.
if [ "$finish" = 1 ] && [ "$host" = herdr ] && [ -n "$successor" ]; then
  launch_cmd=(python3 "$(dirname "$(grealpath "$0")")/../skills/session-finder/launch.py")
  [ -z "${SELF_SLASH_LAUNCH:-}" ] || launch_cmd=("$SELF_SLASH_LAUNCH")
  largs=(successor --pane "$pane" --model "${successor#*/}" --effort "$s_thinking" --wait "${SELF_SLASH_WAIT:-900}")
  [ -z "$s_mode" ] || largs+=(--mode "$s_mode")
  [ -z "$s_baton" ] || largs+=(--baton "$s_baton")
  "${launch_cmd[@]}" "${largs[@]}"; rc=$?
  [ "$rc" = 0 ] || echo "$(gdate '+%F %T') $host $pane: successor path ended with exit $rc; the old pane is untouched"
  exit "$rc"
fi
wait_idle
noprompt=0; sendfail=0; drafted=0; last_prompt=""; same=0
while :; do
  prompt=$(classify_prompt)
  if [ "$prompt" = NOPROMPT ]; then
    noprompt=$((noprompt+1)); [ "$noprompt" -le 9 ] || break
    echo "$(gdate '+%F %T') $host $pane: no input prompt on screen yet (attempt $noprompt), waiting"; sleep 5; continue
  fi
  if [ "$prompt" != EMPTY ]; then
    # Operator text on the ❯ line: an unsent draft, a message QUEUED mid-turn
    # (shown until the turn ends), or the operator typing right now.  Never
    # send over it (the command would be appended to it and submitted with it).
    # Wait for it to be sent, re-wait for idle, then send; give up (exit 4) when
    # SELF_SLASH_WAIT runs out.  There is NO "unchanged for N seconds, so it must
    # be a ghost suggestion" failsafe by default: on 2026-10-09 19:06 that rule
    # (20 s) submitted the operator's finished, unsent question together with the
    # /compact.  A finished draft he is re-reading is indistinguishable from a
    # ghost by stillness; styled ghosts are already classified EMPTY above.
    # SELF_SLASH_GHOST=<seconds> re-enables the old behaviour explicitly, at the
    # caller's risk; unset or 0 means never.
    if [ "$prompt" = "$last_prompt" ]; then same=$((same+5)); else same=0; last_prompt="$prompt"
      echo "$(gdate '+%F %T') $host $pane: text on input line (draft or queued message), waiting: ${prompt:0:60}"; fi
    drafted=$((drafted+5))
    if [ "$drafted" -ge "${SELF_SLASH_WAIT:-900}" ]; then
      echo "$(gdate '+%F %T') $host $pane: REFUSED after ${drafted}s, text still in input box; NOT sent: ${prompt:0:60}"; exit 4
    fi
    ghost="${SELF_SLASH_GHOST:-0}"
    if [ "$ghost" -le 0 ] || [ "$same" -lt "$ghost" ]; then sleep 5; wait_idle; continue; fi
    echo "$(gdate '+%F %T') $host $pane: unchanged for ${same}s while idle and SELF_SLASH_GHOST=$ghost set by caller; sending over it"
  fi
  if send_text; then
    echo "$(gdate '+%F %T') $host $pane: sent ${text:0:80}"
    [ -n "$then" ] || exit 0
    # Same process, same pid, so the lock stays ours; the follow-up re-runs the
    # whole wait (delay, idle, empty prompt) against the fresh session.
    echo "$(gdate '+%F %T') $host $pane: then: ${then:0:80} once the session is idle again (in ${SELF_SLASH_THEN_DELAY:-10}s at the earliest)"
    trap - EXIT
    SELF_SLASH_THEN= SELF_SLASH_AFTER= SELF_SLASH_FINISH=0 SELF_SLASH_CHILD=1 exec "$0" --delay "${SELF_SLASH_THEN_DELAY:-10}" "$then"
  fi
  sendfail=$((sendfail+1)); [ "$sendfail" -le 6 ] || break
  echo "$(gdate '+%F %T') $host $pane: send failed (attempt $sendfail)"; sleep 5
done
echo "$(gdate '+%F %T') $host $pane: gave up, no empty input prompt seen"; exit 5

#!/usr/bin/env python3
"""Offline evaluation of bin/jev against a Haiku baseline on this machine's own work.

build   write datasets under ~/.local/state/jev/eval/ (labels for slice-kind and
        prompt-effort come from <dataset>.labels.json, written by a reviewer)
show    print candidate rows so a reviewer can label them
run     score a dataset with one decider (jev | haiku); resumable
score   print accuracy, confusion, latency, cost and Jev calibration as JSON

Jev is called as a subprocess (bin/jev decide, JEV_MODE=shadow, --site eval-<name>),
so every call lands in the normal decision log. Standard library only.
"""
import argparse
import concurrent.futures
import glob
import hashlib
import json
import math
import os
import random
import re
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
JEV = HERE / "jev"
EVAL = Path.home() / ".local/state/jev/eval"
BIGTEAM = Path.home() / ".local/state/bigteam"
PROJECTS = Path.home() / ".claude/projects"
THRESHOLDS = (0.6, 0.8, 0.9)
BUCKETS = ((0.0, 0.5), (0.5, 0.6), (0.6, 0.7), (0.7, 0.8), (0.8, 0.9), (0.9, 1.0001))
HAIKU_BUDGET_USD = 2.0
PROMPT_EXCERPT = 1500
EXCLUDE_TASKS = ("jev-eval",)  # this evaluation's own briefs must not be in its dataset

DISPATCH_OPTIONS = ["done", "partial", "blocked", "refused", "provider_error", "no_report"]
KIND_OPTIONS = ["judgment", "code", "research", "bulk", "mechanical", "github"]
EFFORT_OPTIONS = ["mechanical", "normal", "hard"]
# bin/jev only attaches these descriptions for site "prompt-effort"; an eval-* site
# gets bare names, so the descriptions travel in the question for both deciders.
EFFORT_TEXT = {
    "mechanical": "Apply a decision already made: edits, commits, doc writing, running known commands",
    "normal": "Ordinary implementation with a clear shape",
    "hard": "Unclear shape, architecture, adjudication, debugging that already failed once",
}
DATASETS = {
    "dispatch-verdict": dict(
        question="What is the outcome of this delegated coding-agent task?",
        options=DISPATCH_OPTIONS),
    "slice-kind": dict(
        question="What kind of work is this delegated task? judgment = high-stakes review, "
                 "design or adjudication; code = write or change code; research = find and "
                 "synthesize information; bulk = many repetitive items; mechanical = "
                 "apply a fully specified change; github = pull requests, issues, CI",
        options=KIND_OPTIONS),
    "prompt-effort": dict(
        question="How much reasoning effort does this operator prompt need? " + "; ".join(
            f"{k} = {v}" for k, v in EFFORT_TEXT.items()),
        options=EFFORT_OPTIONS),
}
SYSTEM = ("You are a classifier. Answer with exactly one option name from the closed "
          "list and nothing else: no punctuation, no explanation.")


def sha(*parts):
    return hashlib.sha256("\0".join(parts).encode()).hexdigest()[:12]


def tail(path, size):
    try:
        with Path(path).open("rb") as stream:
            stream.seek(0, os.SEEK_END)
            stream.seek(max(0, stream.tell() - size))
            return stream.read(size).decode("utf-8", errors="replace")
    except (OSError, TypeError):
        return ""


def dispatch_truth(rec):
    """Same mapping the retired jev_shadow() in bin/acp-dispatch used; None when not final."""
    status = rec.get("status", "")
    if status == "running":
        return None
    truth = status.replace("-", "_")
    if truth == "done" and rec.get("exit") not in (None, 0):
        truth = "partial"
    if truth == "no_report" and rec.get("failure"):
        truth = "refused" if rec["failure"].startswith("NO-REPORT: refused ") else "provider_error"
    return truth if truth in DISPATCH_OPTIONS else None


def build_dispatch(root=BIGTEAM):
    rows = []
    for path in sorted(glob.glob(str(root / "*/jobs/*.json"))):
        try:
            rec = json.loads(Path(path).read_text())
        except (OSError, ValueError):
            continue
        truth = dispatch_truth(rec)
        if truth is None:
            continue
        summary = (tail(rec.get("stderr"), 8192).strip().splitlines() or [""])[-1]
        state = tail(rec.get("report"), 16000) or tail(rec.get("final"), 16000)
        rows.append(dict(id=sha("dispatch", path), truth=truth, truth_source="record",
                         state=summary + "\n" + state[-4000:],
                         meta=dict(task=rec.get("task", ""), name=rec.get("name", ""),
                                   agent=rec.get("agent", ""))))
    return rows


def brief_paths(root=BIGTEAM):
    found = set()
    for path in glob.glob(str(root / "**/*brief*.md"), recursive=True):
        if "/work" in path.replace(str(root), ""):
            continue
        found.add(path)
    return sorted(found)


def kind_candidates(root=BIGTEAM, cap=80, seed=20261011):
    """Stratify by task directory (<= 4 each), shuffled with a fixed seed."""
    rng = random.Random(seed)
    by_dir, seen = {}, set()
    for path in brief_paths(root):
        try:
            text = Path(path).read_text(errors="replace")
        except OSError:
            continue
        if len(text.strip()) < 80:
            continue
        if Path(path).parent.name in EXCLUDE_TASKS:
            continue
        key = re.sub(r"\s+", " ", text)[:600]
        if key in seen:  # the same brief is often copied under two names
            continue
        seen.add(key)
        by_dir.setdefault(Path(path).parent.name, []).append((path, text))
    picked = []
    for name in sorted(by_dir):
        items = by_dir[name]
        rng.shuffle(items)
        marked = [i for i in items if header_kind(i[1])]  # a kind taken from the brief: always in
        plain = [i for i in items if not header_kind(i[1])]
        picked += [(name, p, t) for p, t in marked + plain[:4]]
    rng.shuffle(picked)
    return [dict(id=sha("kind", p), state=t[:4000], meta=dict(task=n, file=Path(p).name))
            for n, p, t in picked[:cap]]


AGENT_TEXT = re.compile(
    r"(Another Claude session|An AI coding session|You are performing|You are one |You are a |"
    r"Use the Bash tool|Reply with exactly|# |Task from Daniel|ARCHITECTURE CONSULTATION|"
    r"CONTINUATION|Brief:|TASK:|This session is being continued|Your previous turn|You are picking up|"
    r"You are the |Call AskUserQuestion|Fix the bug in calc|Use the grafana|What was the exact word)")


def typed_text(entry):
    """Real typed operator text of a transcript entry, or None."""
    if entry.get("type") != "user" or entry.get("isMeta") or entry.get("isSidechain"):
        return None
    content = (entry.get("message") or {}).get("content")
    if isinstance(content, list):
        if any(isinstance(b, dict) and b.get("type") == "tool_result" for b in content):
            return None
        content = "\n".join(b.get("text", "") for b in content
                            if isinstance(b, dict) and b.get("type") == "text")
    if not isinstance(content, str):
        return None
    text = content.strip()
    if len(text) < 20 or text.startswith(("<", "/", "[Request interrupted", "Caveat:")):
        return None
    if "<system-reminder>" in text[:200] or "<task-notification" in text[:200]:
        return None
    if AGENT_TEXT.match(text) or "<teammate-message" in text[:400]:
        return None  # dispatched briefs, relayed peer messages, harness test prompts
    return text


KIND_HEADER = re.compile(r"\(kind: (%s)\)" % "|".join(KIND_OPTIONS))


def header_kind(text):
    """A kind the orchestrator wrote into the brief's own title, e.g. `(kind: code)`."""
    match = KIND_HEADER.search(text[:300])
    return match.group(1) if match else None


def prompt_candidates(root=PROJECTS, cap=100, per_project=10, seed=20261011, labels=None):
    """Already-labelled prompts first (so a rebuild never drops a label), then fill to
    the cap round-robin across projects in a hash order that does not depend on the pool."""
    labels = labels or {}
    by_project = {}
    for path in sorted(glob.glob(str(root / "*/*.jsonl"))):
        seen = by_project.setdefault(Path(path).parent.name, [])
        try:
            with open(path, errors="replace") as stream:
                for line in stream:
                    try:
                        text = typed_text(json.loads(line))
                    except ValueError:
                        continue
                    if text:
                        seen.append(text)
        except OSError:
            continue
    rows, taken = [], set()
    for project in sorted(by_project):
        for text in dict.fromkeys(by_project[project]):
            rid = sha("prompt", text[:PROMPT_EXCERPT])
            if rid in labels and rid not in taken:
                taken.add(rid)
                rows.append((project, text))
    fill = []
    for project in sorted(by_project):
        items = sorted(dict.fromkeys(by_project[project]),
                       key=lambda t: sha(str(seed), t[:PROMPT_EXCERPT]))
        fill.append([(project, t) for t in items if sha("prompt", t[:PROMPT_EXCERPT]) not in taken][:per_project])
    for rank in range(per_project):
        for group in fill:
            if len(rows) >= cap:
                break
            if rank < len(group):
                rows.append(group[rank])
    return [dict(id=sha("prompt", t[:PROMPT_EXCERPT]), state=t[:PROMPT_EXCERPT],
                 meta=dict(project=p.replace("-Users-djbclark-", "")[:40]))
            for p, t in rows[:max(cap, len(taken))]]


def load_labels(name):
    try:
        raw = json.loads((EVAL / f"{name}.labels.json").read_text())
    except (OSError, ValueError):
        return {}
    return {k: (v if isinstance(v, dict) else dict(label=v, source="reviewer")) for k, v in raw.items()}


def write_jsonl(path, rows):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    tmp = path.with_suffix(path.suffix + ".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as stream:
        for row in rows:
            stream.write(json.dumps(row) + "\n")
    os.replace(tmp, path)


def read_jsonl(path):
    try:
        with open(path) as stream:
            return [json.loads(line) for line in stream if line.strip()]
    except FileNotFoundError:
        return []


def build(names):
    summary = {}
    for name in names:
        if name == "dispatch-verdict":
            rows = build_dispatch()
        else:
            cands = (kind_candidates() if name == "slice-kind"
                     else prompt_candidates(labels=load_labels(name)))
            write_jsonl(EVAL / f"{name}.candidates.jsonl", cands)
            labels = load_labels(name)
            allowed = DATASETS[name]["options"]
            rows = []
            for c in cands:
                kind = header_kind(c["state"]) if name == "slice-kind" else None
                if kind:  # truth from the brief's own header; mask it so it is not a leak
                    rows.append(dict(c, state=KIND_HEADER.sub("", c["state"], 1), truth=kind,
                                     truth_source="brief-header"))
                elif c["id"] in labels and labels[c["id"]]["label"] in allowed:
                    rows.append(dict(c, truth=labels[c["id"]]["label"], truth_source=labels[c["id"]]["source"]))
        write_jsonl(EVAL / f"{name}.jsonl", rows)
        counts = {}
        for r in rows:
            counts[r["truth"]] = counts.get(r["truth"], 0) + 1
        sources = {}
        for r in rows:
            sources[r["truth_source"]] = sources.get(r["truth_source"], 0) + 1
        summary[name] = dict(rows=len(rows), truth=counts, sources=sources)
    return summary


# ------------------------------------------------------------------ deciders

def jev_call(row, spec, timeout=30):
    args = [sys.executable, str(JEV), "decide", "--site", "eval-" + row["_dataset"],
            "--question", spec["question"], "--incumbent", row["truth"],
            "--timeout", str(timeout), "--meta", "eval_row=" + row["id"]]
    for option in spec["options"]:
        args += ["--option", option]
    started = time.monotonic()
    try:
        proc = subprocess.run(args, input=row["state"], capture_output=True, text=True,
                              env=dict(os.environ, JEV_MODE="shadow"), timeout=timeout + 15)
        wall = (time.monotonic() - started) * 1000
        out = json.loads(proc.stdout) if proc.stdout.strip() else {}
    except (subprocess.TimeoutExpired, ValueError) as exc:
        return dict(id=row["id"], answer=None, error=type(exc).__name__,
                    wall_ms=(time.monotonic() - started) * 1000)
    return dict(id=row["id"], answer=out.get("answer"), prob=out.get("prob"),
                probs=out.get("probs"), error=out.get("error") or (None if proc.returncode == 0 else "rc%d" % proc.returncode),
                wall_ms=wall, latency_ms=out.get("latency_ms"), jev_id=out.get("id"),
                input_tokens=out.get("input_tokens"))


def haiku_prompt(row, spec):
    listing = "\n".join("- " + o for o in spec["options"])
    return (f"Question: {spec['question']}\n\nOptions (answer with exactly one name):\n{listing}\n\n"
            f"<state>\n{row['state']}\n</state>\n\nAnswer:")


def parse_haiku(text, options):
    """Strict: the whole reply, trimmed of whitespace, must be one option name."""
    reply = (text or "").strip()
    return reply if reply in options else None


def haiku_call(row, spec, timeout=90):
    args = ["claude", "-p", "--model", "haiku", "--setting-sources", "", "--strict-mcp-config",
            "--disable-slash-commands", "--tools", "", "--no-session-persistence",
            "--effort", "low", "--output-format", "json", "--system-prompt", SYSTEM,
            haiku_prompt(row, spec)]
    started = time.monotonic()
    try:
        proc = subprocess.run(args, capture_output=True, text=True, cwd=str(EVAL_CWD()), timeout=timeout)
        wall = (time.monotonic() - started) * 1000
        data = json.loads(proc.stdout)
    except (subprocess.TimeoutExpired, ValueError, OSError) as exc:
        return dict(id=row["id"], answer=None, error=type(exc).__name__,
                    wall_ms=(time.monotonic() - started) * 1000, cost=0.0)
    usage = data.get("usage") or {}
    raw = data.get("result")
    answer = parse_haiku(raw, spec["options"])
    error = "api_error" if data.get("is_error") else None
    return dict(id=row["id"], answer=answer, raw=(raw or "")[:80], error=error, wall_ms=wall,
                cost=float(data.get("total_cost_usd") or 0),
                input_tokens=(usage.get("input_tokens") or 0) + (usage.get("cache_creation_input_tokens") or 0)
                + (usage.get("cache_read_input_tokens") or 0),
                output_tokens=usage.get("output_tokens") or 0)


def EVAL_CWD():
    path = Path("/tmp/jev-eval-cwd")
    path.mkdir(exist_ok=True)
    return path


def run(name, decider, limit=None, workers=4, caller=None):
    spec = DATASETS[name]
    rows = read_jsonl(EVAL / f"{name}.jsonl")[:limit]
    out_path = EVAL / f"{name}.{decider}.results.jsonl"
    done = {r["id"] for r in read_jsonl(out_path)}
    todo = [dict(r, _dataset=name) for r in rows if r["id"] not in done]
    call = caller or (jev_call if decider == "jev" else haiku_call)
    spent = sum(r.get("cost") or 0 for r in read_jsonl(out_path)) if decider == "haiku" else 0.0
    stopped = False
    with concurrent.futures.ThreadPoolExecutor(max_workers=min(4, max(1, workers))) as pool, \
            open(out_path, "a") as stream:
        pending = set()
        queue = iter(todo)
        while True:
            while len(pending) < min(4, max(1, workers)) and not stopped:
                row = next(queue, None)
                if row is None:
                    break
                pending.add(pool.submit(call, row, spec))
            if not pending:
                break
            finished, pending = concurrent.futures.wait(pending, return_when=concurrent.futures.FIRST_COMPLETED)
            for future in finished:
                result = future.result()
                stream.write(json.dumps(result) + "\n")
                stream.flush()
                spent += result.get("cost") or 0
            if decider == "haiku" and spent > HAIKU_BUDGET_USD:
                stopped = True
    return dict(dataset=name, decider=decider, attempted=len(todo), haiku_spend_usd=round(spent, 4),
                stopped_on_budget=stopped)


# ------------------------------------------------------------------ scoring

def percentile(values, fraction):
    ordered = sorted(values)
    if not ordered:
        return None
    index = (len(ordered) - 1) * fraction
    lo, hi = math.floor(index), math.ceil(index)
    return round(ordered[lo] + (ordered[hi] - ordered[lo]) * (index - lo), 1)


def jev_log_costs():
    """id -> cost (USD) from the shared decision log; API cost else the brief's token price."""
    costs = {}
    try:
        with open(Path.home() / ".local/state/jev/decisions.jsonl") as stream:
            for line in stream:
                try:
                    r = json.loads(line)
                except ValueError:
                    continue
                if "id" in r:
                    costs[r["id"]] = r["cost"] if r.get("cost") is not None else (r.get("input_tokens") or 0) * 0.042 / 1e6
    except FileNotFoundError:
        pass
    return costs


def score_rows(rows, results, options, costs=None):
    truth = {r["id"]: r["truth"] for r in rows}
    got = [r for r in results if r["id"] in truth]
    n = len(got)
    correct = sum(r.get("answer") == truth[r["id"]] for r in got)
    errors = sum(bool(r.get("error")) for r in got)
    off_list = sum(r.get("answer") is None and not r.get("error") for r in got)
    confusion = {}
    for r in got:
        cell = confusion.setdefault(truth[r["id"]], {})
        key = r.get("answer") or "(none)"
        cell[key] = cell.get(key, 0) + 1
    walls = [r["wall_ms"] for r in got if r.get("wall_ms") is not None]
    if costs is None:
        cost = sum(r.get("cost") or 0 for r in got)
    else:
        cost = sum(costs.get(r.get("jev_id"), 0) for r in got)
    majority = max((sum(v == o for v in truth.values()) for o in options), default=0)
    out = dict(n=n, accuracy=correct / n if n else None, correct=correct, errors=errors,
               off_list=off_list, majority_baseline=majority / len(truth) if truth else None,
               confusion=confusion, wall_p50_ms=percentile(walls, .5), wall_p95_ms=percentile(walls, .95),
               cost_usd=round(cost, 6), cost_per_call_usd=cost / n if n else None)
    jev_lat = [r["latency_ms"] for r in got if r.get("latency_ms") is not None]
    if jev_lat:
        out.update(jev_latency_p50_ms=percentile(jev_lat, .5), jev_latency_p95_ms=percentile(jev_lat, .95),
                   over_3s=sum(v > 3000 for v in jev_lat), over_5s=sum(v > 5000 for v in jev_lat))
    probbed = [r for r in got if r.get("prob") is not None and not r.get("error")]
    if probbed:
        buckets = []
        for lo, hi in BUCKETS:
            sel = [r for r in probbed if lo <= r["prob"] < hi]
            buckets.append(dict(bucket=f"{lo:.1f}-{min(hi, 1.0):.1f}", n=len(sel),
                                accuracy=sum(r["answer"] == truth[r["id"]] for r in sel) / len(sel) if sel else None))
        out["calibration"] = buckets
        out["thresholds"] = []
        for t in THRESHOLDS:
            sel = [r for r in probbed if r["prob"] >= t]
            out["thresholds"].append(dict(
                threshold=t, covered=len(sel), coverage=len(sel) / n if n else None,
                accuracy=sum(r["answer"] == truth[r["id"]] for r in sel) / len(sel) if sel else None,
                wrong=sum(r["answer"] != truth[r["id"]] for r in sel)))
        out["confident_mechanical_on_hard"] = sum(
            r["answer"] == "mechanical" and r["prob"] >= .8 and truth[r["id"]] == "hard" for r in probbed)
        out["confident_mechanical_on_non_mechanical"] = sum(
            r["answer"] == "mechanical" and r["prob"] >= .8 and truth[r["id"]] != "mechanical" for r in probbed)
    return out


def score(names):
    report = {}
    costs = jev_log_costs()
    for name in names:
        rows = read_jsonl(EVAL / f"{name}.jsonl")
        if not rows:
            continue
        report[name] = dict(
            rows=len(rows),
            truth_source=dict((s, sum(r["truth_source"] == s for r in rows))
                              for s in sorted({r["truth_source"] for r in rows})),
            jev=score_rows(rows, read_jsonl(EVAL / f"{name}.jev.results.jsonl"), DATASETS[name]["options"], costs),
            haiku=score_rows(rows, read_jsonl(EVAL / f"{name}.haiku.results.jsonl"), DATASETS[name]["options"]))
    return report


def show(name, offset, count, width):
    for i, row in enumerate(read_jsonl(EVAL / f"{name}.candidates.jsonl")[offset:offset + count], offset):
        text = re.sub(r"\s+", " ", row["state"])[:width]
        print(f"[{i}] {row['id']} {row['meta']}\n    {text}")


def main(argv=None):
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="command", required=True)
    for cmd in ("build", "score"):
        s = sub.add_parser(cmd)
        s.add_argument("--dataset", choices=sorted(DATASETS), action="append")
    s = sub.add_parser("show")
    s.add_argument("--dataset", choices=("slice-kind", "prompt-effort"), required=True)
    s.add_argument("--offset", type=int, default=0)
    s.add_argument("--count", type=int, default=20)
    s.add_argument("--width", type=int, default=400)
    s = sub.add_parser("run")
    s.add_argument("--dataset", choices=sorted(DATASETS), required=True)
    s.add_argument("--decider", choices=("jev", "haiku"), required=True)
    s.add_argument("--limit", type=int)
    s.add_argument("--workers", type=int, default=4)
    a = p.parse_args(argv)
    names = getattr(a, "dataset", None) if a.command in ("build", "score") else None
    if a.command in ("build", "score"):
        names = names or sorted(DATASETS)
    if a.command == "build":
        print(json.dumps(build(names), indent=2))
    elif a.command == "score":
        print(json.dumps(score(names), indent=2))
    elif a.command == "show":
        show(a.dataset, a.offset, a.count, a.width)
    else:
        print(json.dumps(run(a.dataset, a.decider, a.limit, a.workers), indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env bash
# cow-pasture — create/remove `cow` pastures safely for agent workspaces.
#
# `cow create` clones the whole directory via APFS clonefile, so a pasture
# inherits every untracked file of the source, including gitignored secrets
# such as .env (verified 2026-09-20). This wrapper:
#   create  → cow create, then delete gitignored secret-like files (default on),
#             optionally register the pasture with Orca (`--orca`, needed for
#             `orca orchestration worker-start --worktree path:<pasture>`
#             until stablyai/orca#16226 lands).
#             Also pre-trusts the folder for Claude Code (default on, `--no-trust`
#             to skip): without it `worker-start --agent claude` stalls at the
#             "Quick safety check" dialog and fails `agent_readiness`. And it
#             excludes graft/.cache in the pasture so graft's session files do
#             not make a fresh pasture look dirty.
#   remove  → drop graft's untracked session cache, clear the macOS uchg flag
#             (copied .env files often carry it, which makes `cow remove`
#             fail), cow remove, then unregister the pasture from Orca
#             (`orca project setup-delete`, verified 2026-09-20). Accepts the
#             short name (`foo`) or the full `<source>/<name>`.
#
# Never touches the source repo. Never runs in ~/ops/* (deployment checkouts;
# operator decision 2026-09-20).
set -euo pipefail

usage() {
  cat <<'EOF'
usage: cow-pasture create <name> --source <repo> [--branch <b>] [--orca]
                          [--no-trust] [--keep-secrets] [--dry-run]
       cow-pasture remove <name> [--force]
       cow-pasture scrub <pasture-path> [--dry-run]

create: cow create --print-path, then scrub gitignored secrets.
scrub : delete gitignored files matching SECRET_PATTERNS inside <pasture-path>.
remove: drop graft cache, chflags -R nouchg, cow remove, unregister from Orca.
EOF
  exit 2
}

# Gitignored files that should never be handed to an agent workspace.
# Dependency and build dirs are deliberately NOT listed: keeping them is the
# point of cow. Add patterns here, not per-invocation.
SECRET_PATTERNS=(
  '.env' '.env.*' '*.pem' '*.key' '*.p12' '*.pfx' 'id_rsa*' 'id_ed25519*'
  '.netrc' '.npmrc' '.pypirc' 'credentials' 'credentials.*' '*.secret'
  'secrets.*' '*.tfvars' 'service-account*.json'
)

log() { printf 'cow-pasture: %s\n' "$*" >&2; }

matches_secret() { # $1 = path relative to pasture
  local base; base=$(basename "$1")
  local pat
  for pat in "${SECRET_PATTERNS[@]}"; do
    # shellcheck disable=SC2254
    case "$base" in $pat) return 0 ;; esac
  done
  return 1
}

scrub() { # $1 = pasture path, $2 = dry-run flag (0/1)
  local p=$1 dry=$2 n=0 f
  [ -d "$p/.git" ] || { log "not a primary git repo: $p"; return 1; }
  # -o -i --exclude-standard: untracked AND ignored only — tracked files are
  # never candidates, so a repo that (wrongly) commits .env is left alone
  # and reported instead.
  while IFS= read -r -d '' f; do
    matches_secret "$f" || continue
    n=$((n+1))
    if [ "$dry" = 1 ]; then log "would remove $f"; continue; fi
    chflags nouchg "$p/$f" 2>/dev/null || true
    rm -f -- "$p/$f"
    log "removed $f"
  done < <(git -C "$p" ls-files -o -i --exclude-standard -z)
  # Tracked secrets are a source-repo problem; say so loudly, don't fix here.
  while IFS= read -r -d '' f; do
    matches_secret "$f" && log "WARNING: tracked secret-like file left in place: $f"
  done < <(git -C "$p" ls-files -z)
  log "scrub: $n gitignored secret-like file(s) $( [ "$dry" = 1 ] && echo would-be-removed || echo removed )"
}

# Claude Code keeps per-folder trust in ~/.claude.json (projects[<path>]).
# Pre-seeding it is the only mechanism: the binary has no trust flag or env
# var for local use (verified 2026-09-20). Atomic replace with a backup, since
# running sessions also write this file.
trust_claude() { # $1 = pasture path
  python3 - "$1" <<'PY' && log "pre-trusted for Claude Code: $1" || log "WARNING: could not pre-trust $1 for Claude Code"
import json, os, sys, shutil
path = os.path.realpath(sys.argv[1])
f = os.path.expanduser('~/.claude.json')
d = json.load(open(f))
proj = d.setdefault('projects', {}).setdefault(path, {
    'allowedTools': [], 'mcpContextUris': [], 'mcpServers': {},
    'enabledMcpjsonServers': [], 'disabledMcpjsonServers': [],
    'hasTrustDialogAccepted': False,
    'hasClaudeMdExternalIncludesApproved': False,
    'hasClaudeMdExternalIncludesWarningShown': False})
if proj.get('hasTrustDialogAccepted') is True:
    sys.exit(0)
proj['hasTrustDialogAccepted'] = True
shutil.copy2(f, f + '.bak.cow-pasture')
tmp = f + '.tmp.cow-pasture'
with open(tmp, 'w') as fh:
    json.dump(d, fh, indent=2)
os.chmod(tmp, 0o600)
os.replace(tmp, f)
PY
}

# graft writes graft/.cache/session/*.json into every workspace an agent
# opens. Keep it out of `git status` so the pasture is not "dirty".
exclude_graft_cache() { # $1 = pasture path
  local ex="$1/.git/info/exclude"
  mkdir -p "$1/.git/info"
  grep -qxF 'graft/.cache/' "$ex" 2>/dev/null || printf 'graft/.cache/\n' >> "$ex"
}

# Delete graft's untracked session cache (and graft/ itself if that is all it
# holds). Never touches tracked graft content.
clean_graft_cache() { # $1 = pasture path
  local p=$1
  [ -d "$p/graft" ] || return 0
  if ! git -C "$p" ls-files --error-unmatch graft >/dev/null 2>&1; then
    if [ -z "$(find "$p/graft" -mindepth 1 -not -path "$p/graft/.cache" -not -path "$p/graft/.cache/*" -print -quit)" ]; then
      rm -rf -- "$p/graft"; log "removed untracked graft/ cache"
    fi
  elif [ -d "$p/graft/.cache" ] && [ -z "$(git -C "$p" ls-files graft/.cache)" ]; then
    rm -rf -- "$p/graft/.cache"; log "removed untracked graft/.cache"
  fi
}

# Orca keeps a registration after the directory is gone; setup-delete is the
# only CLI unregister (setup id == repo id for a registered pasture).
orca_unregister() { # $1 = pasture path
  local id
  id=$(orca repo list --json 2>/dev/null | python3 -c '
import sys, json
p = sys.argv[1]
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
r = d.get("result", d)
repos = r.get("repos", r) if isinstance(r, dict) else r
for x in repos or []:
    if isinstance(x, dict) and x.get("path") == p:
        print(x["id"]); break' "$1" || true)
  [ -n "$id" ] || return 0
  if orca project setup-delete --setup "$id" --json >/dev/null 2>&1; then
    log "unregistered from Orca: $1"
  else
    log "WARNING: could not unregister $1 from Orca (orca project setup-delete --setup $id)"
  fi
}

refuse_ops() {
  case "$(cd "$1" 2>/dev/null && pwd -P)" in
    "$HOME"/ops/*|"$HOME"/ops) log "refusing: $1 is a deployment checkout under ~/ops"; exit 3 ;;
  esac
}

cmd=${1:-}; shift || usage
case "$cmd" in
  create)
    name=${1:-}; [ -n "$name" ] || usage; shift
    source=. branch='' orca=0 keep=0 dry=0 trust=1
    while [ $# -gt 0 ]; do
      case "$1" in
        --source) source=$2; shift 2 ;;
        --branch) branch=$2; shift 2 ;;
        --orca) orca=1; shift ;;
        --keep-secrets) keep=1; shift ;;
        --no-trust) trust=0; shift ;;
        --dry-run) dry=1; shift ;;
        *) usage ;;
      esac
    done
    refuse_ops "$source"
    [ "$dry" = 1 ] && { log "dry-run: would cow create $name --source $source ${branch:+--branch $branch}"; exit 0; }
    args=(create "$name" --source "$source" --print-path)
    [ -n "$branch" ] && args+=(--branch "$branch")
    # cow prints "Switched to a new branch" on stdout before the path; keep the last line.
    path=$(cow "${args[@]}" | tail -n 1)
    [ -d "$path" ] || { log "cow create did not yield a directory: $path"; exit 1; }
    if [ "$keep" = 1 ]; then log "--keep-secrets: skipping scrub"; else scrub "$path" 0; fi
    exclude_graft_cache "$path"
    [ "$trust" = 1 ] && trust_claude "$path"
    if [ "$orca" = 1 ]; then
      if orca repo add --path "$path" --json >/dev/null; then
        log "registered with Orca: $path"
      else
        log "WARNING: orca repo add failed; worker-start path: selectors will not resolve"
      fi
    fi
    printf '%s\n' "$path"
    ;;
  scrub)
    p=${1:-}; [ -d "$p" ] || usage; shift; dry=0
    [ "${1:-}" = --dry-run ] && dry=1
    scrub "$p" "$dry"
    ;;
  remove)
    name=${1:-}; [ -n "$name" ] || usage; shift
    force=(); [ "${1:-}" = --force ] && force=(--force)
    path=$(cow path "$name" 2>/dev/null || true)
    if [ -z "$path" ]; then # short name: match `<source>/<name>`
      full=$(cow list --json 2>/dev/null | python3 -c '
import sys, json
n = sys.argv[1]
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
m = [x["name"] for x in d if x.get("name", "").endswith("/" + n)]
print(m[0] if len(m) == 1 else "")' "$name" || true)
      if [ -n "$full" ]; then name=$full; path=$(cow path "$name" 2>/dev/null || true); fi
    fi
    if [ -n "$path" ] && [ -d "$path" ]; then
      clean_graft_cache "$path"
      chflags -R nouchg "$path" 2>/dev/null || true
    fi
    cow remove "$name" ${force[@]+"${force[@]}"}
    if [ -n "$path" ] && [ ! -e "$path" ]; then orca_unregister "$path"; fi
    ;;
  *) usage ;;
esac

#!/usr/bin/env -S python3 -I
"""ade-install: transitional install catalog, plan, doctor, keys, and bounded apply.

  ade-install check [--root DIR] [--json]
  ade-install catalog [--root DIR] [--json]
  ade-install plan [--root DIR] [--json]
  ade-install doctor [--root DIR] [--json]
  ade-install keys [--root DIR] [--json]
  ade-install linux-e2e [--root DIR] [--json]
  ade-install apply [--root DIR] [--json] [--dry-run|--yes] [--id ID ...] [--force]

Doctor runs recorded probe_argv when present (else PATH presence); never
repairs. Keys is observe-only presence via sudo-secretspec check (no values).
linux-e2e chains doctor + keys + hard-dep apply --dry-run (Linux system_argv
preview included) so CI proves the one-step path without a Mac. Apply defaults
to --dry-run; --yes runs user install_argv. --system --dry-run previews
system_argv; executing system_argv is refused. Secrets are never read.
Uses config/install.toml only while config/ade.toml is absent.
See docs/install-catalog.md.
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

BIN = Path(__file__).resolve().parent
if str(BIN) not in sys.path:
    sys.path.insert(0, str(BIN))

import ade_install as ai  # noqa: E402


def _print_json(obj: object) -> None:
    json.dump(obj, sys.stdout, indent=2, sort_keys=True, default=str)
    sys.stdout.write("\n")


def cmd_check(args: argparse.Namespace) -> int:
    try:
        catalog = ai.load_catalog(root=Path(args.root) if args.root else None)
    except ai.InstallError as e:
        if args.json:
            _print_json({"ok": False, "errors": [str(e)]})
        else:
            print(str(e), file=sys.stderr)
            print("ade-install check: FAIL", file=sys.stderr)
        return 1
    if args.json:
        _print_json({"ok": True, "summary": ai.catalog_summary(catalog)})
    else:
        s = ai.catalog_summary(catalog)
        print("ade-install check: OK")
        print(f"  path={s['path']}")
        print(f"  components={s['components']} keys={s['keys']} logins={s['logins']}")
        print(f"  by_class={s['by_class']}")
    return 0


def cmd_catalog(args: argparse.Namespace) -> int:
    try:
        catalog = ai.load_catalog(root=Path(args.root) if args.root else None)
    except ai.InstallError as e:
        print(str(e), file=sys.stderr)
        return 1
    if args.json:
        _print_json({
            "summary": ai.catalog_summary(catalog),
            "component": catalog.components,
            "key": catalog.keys,
            "login": catalog.logins,
        })
    else:
        s = ai.catalog_summary(catalog)
        print(f"ade-install catalog: {s['components']} components, {s['keys']} keys, {s['logins']} logins")
        for row in catalog.components:
            chosen = row.get("chosen")
            ch = "" if chosen is None else f" chosen={chosen}"
            argv = " argv" if row.get("install_argv") else ""
            sys_flag = " needs_system" if row.get("needs_system") else ""
            print(f"  [{row['class']}] {row['id']}{ch}{argv}{sys_flag}")
        print("keys:")
        for row in catalog.keys:
            print(f"  {row['name']} (reference only)")
        print("logins:")
        for row in catalog.logins:
            print(f"  {row['id']}")
    return 0


def cmd_plan(args: argparse.Namespace) -> int:
    try:
        catalog = ai.load_catalog(root=Path(args.root) if args.root else None)
        steps = ai.plan(catalog)
    except ai.InstallError as e:
        print(str(e), file=sys.stderr)
        return 1
    if args.json:
        _print_json({
            "steps": steps,
            "note": "print-only; ade-install apply --dry-run|--yes executes install_argv",
        })
    else:
        print(f"ade-install plan: {len(steps)} step(s) (print-only; does not install)")
        for step in steps:
            print(f"  {step['action']}: {step['id']} — {step['reason']}")
    return 0


def cmd_doctor(args: argparse.Namespace) -> int:
    try:
        catalog = ai.load_catalog(root=Path(args.root) if args.root else None)
        observations, rc = ai.doctor(catalog)
    except ai.InstallError as e:
        if args.json:
            _print_json({"ok": False, "errors": [str(e)]})
        else:
            print(str(e), file=sys.stderr)
            print("ade-install doctor: FAIL", file=sys.stderr)
        return 1
    if args.json:
        _print_json({
            "ok": rc == 0,
            "observations": [
                {"kind": o.kind, "id": o.id, "status": o.status, "detail": o.detail}
                for o in observations
            ],
        })
    else:
        print("ade-install doctor: " + ("OK" if rc == 0 else "FAIL") + " (observe-only; no repair)")
        for o in observations:
            print(f"  {o.status:9} {o.kind}/{o.id}: {o.detail}")
    return rc


def cmd_keys(args: argparse.Namespace) -> int:
    try:
        catalog = ai.load_catalog(root=Path(args.root) if args.root else None)
        observations, rc = ai.keys_observe(catalog)
    except ai.InstallError as e:
        if args.json:
            _print_json({"ok": False, "errors": [str(e)]})
        else:
            print(str(e), file=sys.stderr)
            print("ade-install keys: FAIL", file=sys.stderr)
        return 1
    if args.json:
        _print_json({
            "ok": rc == 0,
            "observations": [
                {"kind": o.kind, "id": o.id, "status": o.status, "detail": o.detail}
                for o in observations
            ],
            "note": "observe-only; sudo-secretspec check only; no get/export/set/verify",
        })
    else:
        print(
            "ade-install keys: "
            + ("OK" if rc == 0 else "FAIL")
            + " (observe-only; no values; no verify probes yet)"
        )
        for o in observations:
            print(f"  {o.status:9} {o.kind}/{o.id}: {o.detail}")
    return rc


def cmd_linux_e2e(args: argparse.Namespace) -> int:
    """Doctor + keys + hard apply dry-run; never writes; no Mac required."""
    try:
        catalog = ai.load_catalog(root=Path(args.root) if args.root else None)
        report, rc = ai.linux_e2e(catalog)
    except ai.InstallError as e:
        if args.json:
            _print_json({"ok": False, "errors": [str(e)]})
        else:
            print(str(e), file=sys.stderr)
            print("ade-install linux-e2e: FAIL", file=sys.stderr)
        return 1
    if args.json:
        _print_json(report)
    else:
        print(
            "ade-install linux-e2e: "
            + ("OK" if rc == 0 else "FAIL")
            + " (doctor + keys + hard apply dry-run; no Mac)"
        )
        linger = report.get("linger") or {}
        if linger:
            print(f"  linger: {linger.get('status')}: {linger.get('detail')}")
        ss = report.get("secretspec_check") or {}
        if ss:
            print(f"  secretspec: {ss.get('status')}: {ss.get('detail')}")
        print(f"  hard_ids: {', '.join(report.get('hard_ids') or []) or '(none)'}")
        apply_stage = (report.get("stages") or {}).get("apply_hard_dry_run") or {}
        for row in apply_stage.get("results") or []:
            extra = ""
            if row.get("argv"):
                extra = " argv=" + " ".join(row["argv"])
            print(f"  {row['action']:20} {row['id']}: {row['reason']}{extra}")
    return rc


def cmd_apply(args: argparse.Namespace) -> int:
    if args.yes and args.dry_run_flag:
        print("ade-install apply: refuse both --yes and --dry-run", file=sys.stderr)
        return 2
    dry_run = not args.yes  # default dry-run; --yes executes
    try:
        catalog = ai.load_catalog(root=Path(args.root) if args.root else None)
        ids = set(args.id) if args.id else None
        results, rc = ai.apply(
            catalog,
            dry_run=dry_run,
            ids=ids,
            force=args.force,
            allow_system=args.system,
            state_dir=Path(args.state_dir) if args.state_dir else None,
            prefix=Path(args.prefix) if args.prefix else None,
        )
    except ai.InstallError as e:
        if args.json:
            _print_json({"ok": False, "errors": [str(e)]})
        else:
            print(str(e), file=sys.stderr)
            print("ade-install apply: FAIL", file=sys.stderr)
        return 2
    mode = "dry-run" if dry_run else "yes"
    if args.json:
        _print_json({
            "ok": rc == 0,
            "mode": mode,
            "results": results,
        })
    else:
        label = "OK" if rc == 0 else ("REFUSED" if rc == 2 else "FAIL")
        print(f"ade-install apply ({mode}): {label}")
        for row in results:
            extra = ""
            if row.get("argv"):
                extra = " argv=" + " ".join(row["argv"])
            print(f"  {row['action']:14} {row['id']}: {row['reason']}{extra}")
    return rc


def main(argv: list[str] | None = None) -> int:
    shared = argparse.ArgumentParser(add_help=False)
    shared.add_argument("--root", default=argparse.SUPPRESS,
                        help="repository root; before/after command, last explicit wins")
    parser = argparse.ArgumentParser(
        prog="ade-install",
        description=(
            "Install catalog, plan, observe-only doctor/keys, linux-e2e dry-run path, "
            "and bounded user-scoped apply."
        ),
        parents=[shared],
    )
    sub = parser.add_subparsers(dest="cmd", required=True)

    for name, func, help_text in (
        ("check", cmd_check, "validate config/install.toml"),
        ("catalog", cmd_catalog, "list components, key references, and login checks"),
        ("plan", cmd_plan, "print-only install plan (no writes)"),
        ("doctor", cmd_doctor, "run probe_argv or observe PATH; never repairs or reads secrets"),
        (
            "keys",
            cmd_keys,
            "observe-only key presence via sudo-secretspec check; never reads values",
        ),
        (
            "linux-e2e",
            cmd_linux_e2e,
            "doctor + keys + hard apply dry-run (Linux; no Mac required)",
        ),
    ):
        p = sub.add_parser(name, parents=[shared], help=help_text)
        p.add_argument("--json", action="store_true")
        p.set_defaults(func=func)

    ap = sub.add_parser(
        "apply",
        parents=[shared],
        help="bounded apply: --dry-run (default) or --yes; --system dry-runs system_argv only",
    )
    ap.add_argument("--json", action="store_true")
    mode = ap.add_mutually_exclusive_group()
    mode.add_argument(
        "--dry-run",
        dest="dry_run_flag",
        action="store_true",
        help="print planned install_argv; change nothing (default when --yes is absent)",
    )
    mode.add_argument(
        "--yes",
        action="store_true",
        help="execute recorded install_argv for missing expected components",
    )
    ap.add_argument(
        "--id",
        action="append",
        default=[],
        help="limit to this component id (repeatable)",
    )
    ap.add_argument(
        "--force",
        action="store_true",
        help="re-run install_argv even when presence probe is ok",
    )
    ap.add_argument(
        "--system",
        action="store_true",
        help="preview system_argv (with --dry-run); executing system_argv is always refused",
    )
    ap.add_argument(
        "--state-dir",
        default=None,
        help="ledger directory (default: ~/.local/state/djbclark-ade/install or ADE_INSTALL_STATE_DIR)",
    )
    ap.add_argument(
        "--prefix",
        default=None,
        help="user install prefix for {prefix} token (default: ~/.local/bin)",
    )
    ap.set_defaults(func=cmd_apply, dry_run_flag=False, yes=False)

    args = parser.parse_args(argv)
    args.root = getattr(args, "root", None)
    return int(args.func(args))


if __name__ == "__main__":
    sys.exit(main())

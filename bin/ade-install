#!/usr/bin/env -S python3 -I
"""ade-install: transitional install catalog, plan, doctor, keys, and bounded apply.

  ade-install                 print first-run guidance only (exit 0)
  ade-install check [--root DIR] [--json]
  ade-install catalog [--root DIR] [--json]
  ade-install plan [--root DIR] [--json]
  ade-install doctor [--root DIR] [--id ID ...] [--json]
  ade-install keys [--root DIR] [--json] [--keys-state PATH]
  ade-install apply [--root DIR] [--json] [--dry-run|--yes] [--id ID ...] [--force]
                    [--system] [--print-system-argv] [--apply-system]

Doctor runs recorded probe_argv when present (else PATH presence) and, when
agents/claude/settings.json.tmpl is under --root, checks live
~/.claude/settings.json for context_size_nudge.py registration; also probes
credential-bak delete-after (WARN approaching / FAIL past; never deletes);
never repairs or mutates settings. Keys runs sudo-secretspec check, then per-key
verify_argv under sudo-secretspec run when recorded (no values printed).
Apply defaults to --dry-run; --yes runs user install_argv. --system --dry-run /
--print-system-argv preview system_argv. Live system_argv needs --yes --system
--apply-system (default refuse). Secrets are never read.
Uses config/install.toml only while config/ade.toml is absent.
See docs/install-catalog.md.
"""
from __future__ import annotations

import sys

if sys.version_info < (3, 11):
    print(
        "ade-install requires Python 3.11+ (running "
        f"{sys.version_info[0]}.{sys.version_info[1]}). "
        "Make a supported python3 available on PATH, then rerun. "
        "No installation was attempted.",
        file=sys.stderr,
    )
    raise SystemExit(2)


def print_first_run_guidance() -> None:
    print(
        "ADE first-run checklist (guidance only; no changes made).\n"
        "Prerequisite: Python 3.11+ available as python3 on PATH.\n"
        "From the cloned repository, validate and preview:\n"
        "  ./bin/ade-install check\n"
        "  ./bin/ade-install plan\n"
        "  ./bin/ade-install apply --dry-run\n"
        "To install missing Just explicitly when ready:\n"
        "  ./bin/ade-install apply --yes --id just\n"
        "These direct commands do not require Just. Automatic Python/Just "
        "bootstrap is not implemented."
    )


# A cold no-argument run must not import repository modules or create bytecode.
if __name__ == "__main__" and len(sys.argv) == 1:
    print_first_run_guidance()
    raise SystemExit(0)


import argparse
import json
from pathlib import Path

BIN = Path(__file__).resolve().parent
if str(BIN) not in sys.path:
    sys.path.insert(0, str(BIN))

import ade_install as ai  # noqa: E402


def _print_json(obj: object) -> None:
    json.dump(obj, sys.stdout, indent=2, sort_keys=True, default=str)
    sys.stdout.write("\n")


def cmd_check(args: argparse.Namespace) -> int:
    try:
        catalog = ai.load_catalog(root=Path(args.root) if args.root else None)
    except ai.InstallError as e:
        if args.json:
            _print_json({"ok": False, "errors": [str(e)]})
        else:
            print(str(e), file=sys.stderr)
            print("ade-install check: FAIL", file=sys.stderr)
        return 1
    if args.json:
        _print_json({"ok": True, "summary": ai.catalog_summary(catalog)})
    else:
        s = ai.catalog_summary(catalog)
        print("ade-install check: OK")
        print(f"  path={s['path']}")
        print(f"  components={s['components']} keys={s['keys']} logins={s['logins']} "
              f"jobs={s.get('jobs', 0)} retired_jobs={s.get('retired_jobs', 0)}")
        print(f"  by_class={s['by_class']}")
        if s.get("jobs_by_owner"):
            print(f"  jobs_by_owner={s['jobs_by_owner']}")
    return 0


def cmd_catalog(args: argparse.Namespace) -> int:
    try:
        catalog = ai.load_catalog(root=Path(args.root) if args.root else None)
    except ai.InstallError as e:
        print(str(e), file=sys.stderr)
        return 1
    if args.json:
        _print_json({
            "summary": ai.catalog_summary(catalog),
            "component": catalog.components,
            "key": catalog.keys,
            "login": catalog.logins,
        })
    else:
        s = ai.catalog_summary(catalog)
        print(f"ade-install catalog: {s['components']} components, {s['keys']} keys, {s['logins']} logins")
        for row in catalog.components:
            chosen = row.get("chosen")
            ch = "" if chosen is None else f" chosen={chosen}"
            argv = " argv" if row.get("install_argv") else ""
            sys_flag = " needs_system" if row.get("needs_system") else ""
            print(f"  [{row['class']}] {row['id']}{ch}{argv}{sys_flag}")
        print("keys:")
        for row in catalog.keys:
            print(f"  {row['name']} (reference only)")
        print("logins:")
        for row in catalog.logins:
            print(f"  {row['id']}")
    return 0


def cmd_plan(args: argparse.Namespace) -> int:
    try:
        catalog = ai.load_catalog(root=Path(args.root) if args.root else None)
        steps = ai.plan(catalog)
    except ai.InstallError as e:
        print(str(e), file=sys.stderr)
        return 1
    if args.json:
        _print_json({
            "steps": steps,
            "note": "print-only; ade-install apply --dry-run|--yes executes install_argv",
        })
    else:
        print(f"ade-install plan: {len(steps)} step(s) (print-only; does not install)")
        for step in steps:
            print(f"  {step['action']}: {step['id']} — {step['reason']}")
    return 0


def cmd_doctor(args: argparse.Namespace) -> int:
    ids = list(dict.fromkeys(args.ids)) if args.ids is not None else None
    scope = (
        {"kind": "components", "component_ids": ids}
        if ids is not None else {"kind": "all"}
    )
    try:
        catalog = ai.load_catalog(root=Path(args.root) if args.root else None)
        observations, rc = ai.doctor(catalog, component_ids=ids)
    except ai.InstallError as e:
        if args.json:
            _print_json({"ok": False, "scope": scope, "errors": [str(e)]})
        else:
            print(str(e), file=sys.stderr)
            print("ade-install doctor: FAIL", file=sys.stderr)
        return 1
    if args.json:
        _print_json({
            "ok": rc == 0,
            "scope": scope,
            "observations": [
                {"kind": o.kind, "id": o.id, "status": o.status, "detail": o.detail}
                for o in observations
            ],
        })
    else:
        note = "observe-only; no repair"
        if ids is not None:
            note += "; components: " + ", ".join(ids) + "; not whole-installation health"
        print("ade-install doctor: " + ("OK" if rc == 0 else "FAIL") + " (" + note + ")")
        for o in observations:
            print(f"  {o.status:9} {o.kind}/{o.id}: {o.detail}")
    return rc


def cmd_keys(args: argparse.Namespace) -> int:
    try:
        catalog = ai.load_catalog(root=Path(args.root) if args.root else None)
        state = Path(args.keys_state) if getattr(args, "keys_state", None) else None
        observations, rc = ai.keys_observe(catalog, keys_state_path=state)
    except ai.InstallError as e:
        if args.json:
            _print_json({"ok": False, "errors": [str(e)]})
        else:
            print(str(e), file=sys.stderr)
            print("ade-install keys: FAIL", file=sys.stderr)
        return 1
    if args.json:
        _print_json({
            "ok": rc == 0,
            "observations": [
                {"kind": o.kind, "id": o.id, "status": o.status, "detail": o.detail}
                for o in observations
            ],
            "note": (
                "observe-only; sudo-secretspec check then verify_argv under "
                "sudo-secretspec run; no get/export/set; no values printed"
            ),
        })
    else:
        print(
            "ade-install keys: "
            + ("OK" if rc == 0 else "FAIL")
            + " (observe-only; no values; verify under sudo-secretspec run when recorded)"
        )
        for o in observations:
            print(f"  {o.status:9} {o.kind}/{o.id}: {o.detail}")
    return rc


def cmd_apply(args: argparse.Namespace) -> int:
    if args.yes and args.dry_run_flag:
        print("ade-install apply: refuse both --yes and --dry-run", file=sys.stderr)
        return 2
    if args.print_system_argv and (args.yes or args.apply_system):
        print(
            "ade-install apply: --print-system-argv is print-only "
            "(refuse with --yes / --apply-system)",
            file=sys.stderr,
        )
        return 2
    if args.apply_system and not args.yes:
        print(
            "ade-install apply: --apply-system requires --yes "
            "(use --system --dry-run or --print-system-argv to preview)",
            file=sys.stderr,
        )
        return 2
    if args.apply_system and not args.system:
        # Opt-in live path always implies --system consideration.
        args.system = True
    dry_run = not args.yes  # default dry-run; --yes executes
    if args.reconcile_sched and args.no_reconcile_sched:
        print("ade-install apply: refuse both --reconcile-sched and --no-reconcile-sched",
              file=sys.stderr)
        return 2
    try:
        catalog = ai.load_catalog(root=Path(args.root) if args.root else None)
        ids = set(args.id) if args.id else None
        prefix = Path(args.prefix) if args.prefix else None
        if args.print_system_argv:
            rows = ai.collect_system_argv(catalog, ids=ids, prefix=prefix)
            if args.json:
                _print_json({
                    "ok": all(r.get("ok") for r in rows) if rows else True,
                    "mode": "print-system-argv",
                    "results": rows,
                })
            else:
                print(f"ade-install apply (print-system-argv): {len(rows)} row(s)")
                for row in rows:
                    extra = ""
                    if row.get("argv"):
                        extra = " argv=" + " ".join(row["argv"])
                    print(f"  {row['action']:18} {row['id']}: {row['reason']}{extra}")
            # Missing platform argv is a soft miss (exit 1); print-only never installs.
            return 0 if all(r.get("ok") for r in rows) or not rows else 1
        reconcile_sched = None
        if getattr(args, "reconcile_sched", False):
            reconcile_sched = True
        if getattr(args, "no_reconcile_sched", False):
            reconcile_sched = False
        results, rc = ai.apply(
            catalog,
            dry_run=dry_run,
            ids=ids,
            force=args.force,
            allow_system=args.system,
            apply_system=args.apply_system,
            state_dir=Path(args.state_dir) if args.state_dir else None,
            prefix=prefix,
            reconcile_sched=reconcile_sched,
        )
    except ai.InstallError as e:
        if args.json:
            _print_json({"ok": False, "errors": [str(e)]})
        else:
            print(str(e), file=sys.stderr)
            print("ade-install apply: FAIL", file=sys.stderr)
        return 2
    mode = "dry-run" if dry_run else ("yes+apply-system" if args.apply_system else "yes")
    if args.json:
        _print_json({
            "ok": rc == 0,
            "mode": mode,
            "results": results,
        })
    else:
        label = "OK" if rc == 0 else ("REFUSED" if rc == 2 else "FAIL")
        print(f"ade-install apply ({mode}): {label}")
        for row in results:
            extra = ""
            if row.get("argv"):
                extra = " argv=" + " ".join(row["argv"])
            print(f"  {row['action']:14} {row['id']}: {row['reason']}{extra}")
    return rc


def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    if not argv:
        print_first_run_guidance()
        return 0
    shared = argparse.ArgumentParser(add_help=False)
    shared.add_argument("--root", default=argparse.SUPPRESS,
                        help="repository root; before/after command, last explicit wins")
    parser = argparse.ArgumentParser(
        prog="ade-install",
        description="Install catalog, plan, observe-only doctor, and bounded user-scoped apply.",
        parents=[shared],
    )
    sub = parser.add_subparsers(dest="cmd", required=True)

    for name, func, help_text in (
        ("check", cmd_check, "validate config/install.toml"),
        ("catalog", cmd_catalog, "list components, key references, and login checks"),
        ("plan", cmd_plan, "print-only install plan (no writes)"),
        ("doctor", cmd_doctor,
         "run probe_argv / PATH presence, Claude context_size_nudge, credential-bak delete-after, advisory UNACCEPTED Pi pools; never repairs"),
        (
            "keys",
            cmd_keys,
            "sudo-secretspec check + per-key verify_argv under run; never prints values",
        ),
    ):
        p = sub.add_parser(name, parents=[shared], help=help_text)
        p.add_argument("--json", action="store_true")
        if name == "doctor":
            p.add_argument(
                "--id", dest="ids", action="append",
                help="check only this component (repeatable); skips installation-wide checks",
            )
        if name == "keys":
            p.add_argument(
                "--keys-state",
                default=None,
                help="outcomes JSON path (default ~/.local/state/djbclark-ade/keys.json "
                "or ADE_KEYS_STATE_PATH); never stores values",
            )
        p.set_defaults(func=func)

    ap = sub.add_parser(
        "apply",
        parents=[shared],
        help=(
            "bounded apply: --dry-run (default) or --yes; "
            "--system previews system_argv; --apply-system opts into live system_argv"
        ),
    )
    ap.add_argument("--json", action="store_true")
    mode = ap.add_mutually_exclusive_group()
    mode.add_argument(
        "--dry-run",
        dest="dry_run_flag",
        action="store_true",
        help="print planned install_argv; change nothing (default when --yes is absent)",
    )
    mode.add_argument(
        "--yes",
        action="store_true",
        help="execute recorded install_argv for missing expected components",
    )
    ap.add_argument(
        "--id",
        action="append",
        default=[],
        help="limit to this component id (repeatable)",
    )
    ap.add_argument(
        "--force",
        action="store_true",
        help="re-run install_argv even when presence probe is ok",
    )
    ap.add_argument(
        "--system",
        action="store_true",
        help=(
            "consider system_argv: with --dry-run preview as would-system-install; "
            "with --yes alone still refuse; with --yes --apply-system execute"
        ),
    )
    ap.add_argument(
        "--print-system-argv",
        action="store_true",
        help="print-only: dump platform system_argv for needs_system rows; never execute",
    )
    ap.add_argument(
        "--apply-system",
        action="store_true",
        help=(
            "operator opt-in: with --yes (and --system), execute system_argv via argv "
            "list (never shell); default without this flag is refuse-system-exec"
        ),
    )
    ap.add_argument(
        "--state-dir",
        default=None,
        help="ledger directory (default: ~/.local/state/djbclark-ade/install or ADE_INSTALL_STATE_DIR)",
    )
    ap.add_argument(
        "--prefix",
        default=None,
        help="user install prefix for {prefix} token (default: ~/.local/bin)",
    )
    ap.add_argument(
        "--reconcile-sched",
        action="store_true",
        help=(
            "after component steps, run ade-sched reconcile for ADE-owned labeled "
            "jobs (default on for a full apply with no --id)"
        ),
    )
    ap.add_argument(
        "--no-reconcile-sched",
        action="store_true",
        help="skip the post-apply ade-sched reconcile step",
    )
    ap.set_defaults(
        func=cmd_apply,
        dry_run_flag=False,
        yes=False,
        print_system_argv=False,
        apply_system=False,
        reconcile_sched=False,
        no_reconcile_sched=False,
    )

    args = parser.parse_args(argv)
    args.root = getattr(args, "root", None)
    return int(args.func(args))


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env -S python3 -I
"""skill-get — load one agent skill on demand, for small-context models.

  skill-get --list [keyword ...]        compact catalogue (names only; with keywords: name + one-liner)
  skill-get <name> [--offset N] [--max-chars N]
  skill-get <name> --ref <relative/path>   a file under the skill's references/ or scripts/

A model whose context is small (Crush + Qwen on SIPB, 32k) cannot afford every skill's description in
every request. Keep the skills disabled in its harness and let it pull exactly one with this
command when the task needs it: the SKILL.md body (frontmatter stripped) is printed in pages of at
most --max-chars (default 7000), with the exact command for the next page.
Exit 0 ok, 1 not found, 2 usage.
"""
from __future__ import annotations

import argparse
import difflib
import os
import re
import sys
from pathlib import Path

HOME = Path(os.path.expanduser("~"))
ROOTS = [
    HOME / "src/djbclark-ade/skills",
    HOME / ".claude/skills",
    HOME / ".agents/skills",
    HOME / "ops/site-private/skills",
]
if os.environ.get("SKILL_GET_ROOTS"):
    ROOTS = [Path(p) for p in os.environ["SKILL_GET_ROOTS"].split(os.pathsep) if p]


def find_skills() -> dict[str, Path]:
    found: dict[str, Path] = {}
    for root in ROOTS:
        if not root.is_dir():
            continue
        for d in sorted(root.iterdir()):
            if d.name.startswith(".") or not (d / "SKILL.md").is_file():
                continue
            found.setdefault(d.name, d)
    return found


def split_frontmatter(text: str) -> tuple[str, str]:
    m = re.match(r"\A---\s*\n(.*?)\n---\s*\n?", text, re.S)
    return (m.group(1), text[m.end():]) if m else ("", text)


def description(front: str) -> str:
    m = re.search(r"^description:[ \t]*(.*(?:\n[ \t]+.*)*)", front, re.M)
    if not m:
        return ""
    d = re.sub(r"\s+", " ", m.group(1)).strip()
    return re.sub(r"^[>|][-+]?\s*", "", d).strip("\"'")


def cmd_list(skills: dict[str, Path], words: list[str]) -> int:
    if not words:
        names = sorted(skills)
        print(f"{len(names)} skills. Names only; `skill-get --list <keyword>` shows what they do, "
              "`skill-get <name>` loads one.")
        print(", ".join(names))
        return 0
    rows = []
    for name, d in sorted(skills.items()):
        desc = description(split_frontmatter((d / "SKILL.md").read_text(errors="replace"))[0])
        hay = (name + " " + desc).lower()
        if all(w.lower() in hay for w in words):
            rows.append(f"{name}: {desc[:120]}")
    if not rows:
        print("no skill matches " + " ".join(words) + "; try one keyword, or `skill-get --list`.")
        return 1
    print("\n".join(rows[:25]))
    if len(rows) > 25:
        print(f"... {len(rows) - 25} more; add a keyword.")
    return 0


def cmd_get(skills: dict[str, Path], name: str, offset: int, max_chars: int, ref: str | None) -> int:
    d = skills.get(name)
    if d is None:
        near = difflib.get_close_matches(name, list(skills), n=5, cutoff=0.5)
        print(f"skill-get: no skill named {name!r}." + (f" Close: {', '.join(near)}." if near else "")
              + " `skill-get --list <keyword>` searches.")
        return 1
    if ref:
        f = (d / ref).resolve()
        if not str(f).startswith(str(d.resolve())) or not f.is_file():
            print(f"skill-get: {ref!r} is not a file inside {d}.")
            return 1
        body, head = f.read_text(errors="replace"), f"FILE: {f}"
        again = f"skill-get {name} --ref {ref}"
    else:
        body = split_frontmatter((d / "SKILL.md").read_text(errors="replace"))[1].lstrip("\n")
        head = f"SKILL: {name}   DIR: {d.resolve()}   (relative paths in it are under DIR)"
        again = f"skill-get {name}"
    chunk = body[offset:offset + max_chars]
    print(head)
    print()
    print(chunk.rstrip())
    end = offset + len(chunk)
    if end < len(body):
        print(f"\nTRUNCATED: {len(body) - end} more characters. Next page: {again} --offset {end}")
    if not ref and offset == 0:
        extra = [str(p.relative_to(d)) for sub in ("references", "scripts")
                 for p in sorted((d / sub).glob("*")) if p.is_file()][:12]
        if extra:
            print("\nMORE FILES (read one only if needed): " + ", ".join(extra)
                  + f"  -> {again} --ref <path>")
    return 0


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description="Load an agent skill on demand.")
    ap.add_argument("name", nargs="*", help="skill name; with --list, keywords")
    ap.add_argument("--list", action="store_true", help="catalogue (names only) or keyword search")
    ap.add_argument("--offset", type=int, default=0)
    ap.add_argument("--max-chars", type=int, default=7000)
    ap.add_argument("--ref", help="a file under the skill dir, e.g. references/foo.md")
    a = ap.parse_args(argv)
    skills = find_skills()
    if a.list:
        return cmd_list(skills, a.name)
    if len(a.name) != 1:
        ap.error("give exactly one skill name, or --list [keyword]")
    return cmd_get(skills, a.name[0].lstrip("/"), max(0, a.offset), max(500, a.max_chars), a.ref)


if __name__ == "__main__":
    sys.exit(main())

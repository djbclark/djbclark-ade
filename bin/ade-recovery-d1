#!/usr/bin/env -S python3 -I
"""ade-recovery-d1: observe-only D1 / native-resume preflight (Carried #2, 2026-11-10).

  ade-recovery-d1 [--root DIR] [--paseo-home DIR] [--json]

Reports the measurement matrix that unparks interruption recovery (issue 278 /
docs/checkpoint.md §E D1, PR 290 parked on PLAN J6/J9). It never installs
plugins, never resumes or sends to agents, never writes state, and never reads
credential file contents (presence only via Path.is_file / is_dir).

Probes (each status: ok | missing | error | info):

  docs_contract       docs/checkpoint.md names D1 and the native resume ladder
  paseo_cli           `paseo` on PATH (or ADE_RECOVERY_D1_PASEO / PASEO_CLI)
  paseo_version       `paseo --version` / `version` text (info; notes <0.15.0)
  paseo_daemon        `paseo ls -g --background --json` returns a JSON list
  agents_dir          `$PASEO_HOME/agents` is a directory (presence)
  local_credential    `$PASEO_HOME/local-credential` exists as a file (presence;
                      present while the daemon runs per checkpoint G.6 / #290)
  session_recovery    `$PASEO_HOME/plugin-data/session-recovery` present (info)
  node_runtime        `node` version for a future ade-recovery install (info)

Exit: 0 when docs_contract + paseo_cli + paseo_daemon are ok (host is ready to
measure native resume); 1 when any of those three fails; 2 usage / bad root.
Stdlib only; subprocess argv lists only.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Any

TOOL = "ade-recovery-d1"
EXIT_OK, EXIT_BLOCKED, EXIT_USAGE = 0, 1, 2

# Inventory in docs/checkpoint.md §F was read against CLI 0.15.0 (2026-11-04).
NATIVE_INVENTORY_VERSION = (0, 15, 0)
NODE_MIN = (22, 18)

VERSION_RE = re.compile(r"(\d+)\.(\d+)\.(\d+)")


def die(msg: str, code: int = EXIT_USAGE) -> int:
    print(f"{TOOL}: {msg}", file=sys.stderr)
    return code


def paseo_bin() -> str | None:
    return (
        os.environ.get("ADE_RECOVERY_D1_PASEO")
        or os.environ.get("PASEO_CLI")
        or shutil.which("paseo")
    )


def paseo_home(explicit: Path | None) -> Path:
    if explicit is not None:
        return explicit.expanduser().resolve()
    raw = os.environ.get("PASEO_HOME")
    if raw is None:
        return (Path.home() / ".paseo").resolve()
    # Match upstream ?? semantics only for missing; empty string resolves vs cwd.
    p = Path(raw).expanduser()
    return p.resolve()


def run_argv(argv: list[str], *, timeout: float = 20) -> tuple[int, str, str]:
    try:
        p = subprocess.run(
            argv,
            capture_output=True,
            text=True,
            timeout=timeout,
            check=False,
        )
    except subprocess.TimeoutExpired:
        return 124, "", f"timed out after {timeout:g}s"
    except OSError as exc:
        return 127, "", f"{exc.__class__.__name__}: {exc}"
    return p.returncode, p.stdout or "", p.stderr or ""


def parse_semver(text: str) -> tuple[int, int, int] | None:
    m = VERSION_RE.search(text)
    if not m:
        return None
    return int(m.group(1)), int(m.group(2)), int(m.group(3))


def probe_docs(root: Path) -> dict[str, Any]:
    path = root / "docs" / "checkpoint.md"
    if not path.is_file():
        return {
            "id": "docs_contract",
            "status": "missing",
            "detail": "docs/checkpoint.md not found",
        }
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError as exc:
        return {
            "id": "docs_contract",
            "status": "error",
            "detail": f"unreadable: {exc.__class__.__name__}",
        }
    need = ("D1", "paseo send", "native")
    missing = [t for t in need if t not in text]
    if missing:
        return {
            "id": "docs_contract",
            "status": "error",
            "detail": f"checkpoint.md missing markers: {', '.join(missing)}",
        }
    return {
        "id": "docs_contract",
        "status": "ok",
        "detail": "docs/checkpoint.md names D1 and native resume",
    }


def probe_paseo_cli() -> tuple[dict[str, Any], str | None]:
    exe = paseo_bin()
    if not exe:
        return (
            {
                "id": "paseo_cli",
                "status": "missing",
                "detail": "paseo not on PATH (set ADE_RECOVERY_D1_PASEO)",
            },
            None,
        )
    return (
        {"id": "paseo_cli", "status": "ok", "detail": exe},
        exe,
    )


def probe_paseo_version(exe: str | None) -> dict[str, Any]:
    if not exe:
        return {
            "id": "paseo_version",
            "status": "missing",
            "detail": "skipped (no paseo)",
        }
    # Prefer `paseo --version`; fall back to `paseo version`.
    for argv in ([exe, "--version"], [exe, "version"]):
        rc, out, err = run_argv(argv, timeout=10)
        text = (out or err).strip()
        if rc == 0 and text:
            ver = parse_semver(text)
            note = ""
            if ver is not None and ver < NATIVE_INVENTORY_VERSION:
                note = (
                    f"; below inventory 0.15.0 (live may still be 0.14.x; "
                    f"D1 confirms on operator daemon)"
                )
            return {
                "id": "paseo_version",
                "status": "ok",
                "detail": text.splitlines()[0][:200] + note,
                "version": list(ver) if ver else None,
            }
    return {
        "id": "paseo_version",
        "status": "error",
        "detail": "paseo --version / version failed",
    }


def probe_paseo_daemon(exe: str | None) -> dict[str, Any]:
    if not exe:
        return {
            "id": "paseo_daemon",
            "status": "missing",
            "detail": "skipped (no paseo)",
        }
    rc, out, err = run_argv(
        [exe, "ls", "-g", "--background", "--json"], timeout=30
    )
    if rc != 0:
        return {
            "id": "paseo_daemon",
            "status": "error",
            "detail": f"paseo ls exited {rc}: {(err or out).strip()[:200]}",
        }
    try:
        data = json.loads(out) if out.strip() else None
    except json.JSONDecodeError:
        return {
            "id": "paseo_daemon",
            "status": "error",
            "detail": "paseo ls printed no JSON list",
        }
    if not isinstance(data, list):
        return {
            "id": "paseo_daemon",
            "status": "error",
            "detail": "paseo ls JSON is not a list",
        }
    return {
        "id": "paseo_daemon",
        "status": "ok",
        "detail": f"{len(data)} agent row(s)",
        "count": len(data),
    }


def probe_path(
    *,
    probe_id: str,
    path: Path,
    kind: str,
    ok_detail: str,
    missing_detail: str,
) -> dict[str, Any]:
    try:
        if kind == "dir":
            ok = path.is_dir()
        else:
            ok = path.is_file()
    except OSError as exc:
        return {
            "id": probe_id,
            "status": "error",
            "detail": f"{exc.__class__.__name__}",
        }
    if ok:
        return {"id": probe_id, "status": "ok", "detail": ok_detail}
    return {"id": probe_id, "status": "missing", "detail": missing_detail}


def probe_node() -> dict[str, Any]:
    exe = shutil.which("node")
    if not exe:
        return {
            "id": "node_runtime",
            "status": "info",
            "detail": "node not on PATH (needed only if installing ade-recovery later)",
        }
    rc, out, err = run_argv([exe, "-p", "process.versions.node"], timeout=10)
    text = (out or err).strip()
    if rc != 0 or not text:
        return {
            "id": "node_runtime",
            "status": "info",
            "detail": "node present but version unread",
        }
    ver = parse_semver(text)
    if ver is None:
        return {"id": "node_runtime", "status": "info", "detail": text[:80]}
    if ver < NODE_MIN:
        return {
            "id": "node_runtime",
            "status": "info",
            "detail": f"node {text} (< 22.18; ade-recovery would refuse)",
            "version": list(ver),
        }
    return {
        "id": "node_runtime",
        "status": "ok",
        "detail": f"node {text}",
        "version": list(ver),
    }


def assess(root: Path, home: Path) -> dict[str, Any]:
    probes: list[dict[str, Any]] = []
    probes.append(probe_docs(root))
    cli_probe, exe = probe_paseo_cli()
    probes.append(cli_probe)
    probes.append(probe_paseo_version(exe))
    probes.append(probe_paseo_daemon(exe))
    probes.append(
        probe_path(
            probe_id="agents_dir",
            path=home / "agents",
            kind="dir",
            ok_detail=str(home / "agents"),
            missing_detail=f"{home / 'agents'} not a directory",
        )
    )
    # Presence only — never open/read local-credential contents.
    probes.append(
        probe_path(
            probe_id="local_credential",
            path=home / "local-credential",
            kind="file",
            ok_detail="present (daemon likely up; contents not read)",
            missing_detail="absent (daemon down or non-default home)",
        )
    )
    probes.append(
        probe_path(
            probe_id="session_recovery",
            path=home / "plugin-data" / "session-recovery",
            kind="dir",
            ok_detail="plugin-data/session-recovery present (observe only)",
            missing_detail="sm1ee/session-recovery data not present (expected until install)",
        )
    )
    # Treat a bare state.json file path as info too if the dir missing but file exists.
    if probes[-1]["status"] == "missing":
        state = home / "plugin-data" / "session-recovery" / "state.json"
        if state.is_file():
            probes[-1] = {
                "id": "session_recovery",
                "status": "ok",
                "detail": "state.json present (observe only; not read)",
            }
    probes.append(probe_node())

    required = ("docs_contract", "paseo_cli", "paseo_daemon")
    by_id = {p["id"]: p for p in probes}
    blocked = [
        by_id[i]["detail"]
        for i in required
        if by_id[i]["status"] != "ok"
    ]
    ready = not blocked
    return {
        "tool": TOOL,
        "ready": ready,
        "paseo_home": str(home),
        "root": str(root),
        "probes": probes,
        "blocked": blocked,
        "note": (
            "observe-only; does not measure crash recovery or install plugins. "
            "A ready host can run the native-resume D1 matrix on the operator daemon."
        ),
    }


def print_text(report: dict[str, Any]) -> None:
    status = "READY" if report["ready"] else "BLOCKED"
    print(f"{TOOL}: {status} (native-resume D1 preflight)")
    print(f"  root: {report['root']}")
    print(f"  paseo_home: {report['paseo_home']}")
    for p in report["probes"]:
        print(f"  [{p['status']}] {p['id']}: {p['detail']}")
    if report["blocked"]:
        print("blocked:")
        for b in report["blocked"]:
            print(f"  - {b}")
    print(f"note: {report['note']}")


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        prog=TOOL,
        description=(
            "Observe-only D1 / native-resume preflight for interruption recovery "
            "(Carried #2). Never installs, resumes, or reads credential contents."
        ),
    )
    ap.add_argument(
        "--root",
        type=Path,
        default=None,
        help="repository root (default: parent of this script's bin/)",
    )
    ap.add_argument(
        "--paseo-home",
        type=Path,
        default=None,
        help="Paseo home for presence probes (default: $PASEO_HOME or ~/.paseo)",
    )
    ap.add_argument("--json", action="store_true", help="print one JSON object")
    args = ap.parse_args(argv)

    here = Path(__file__).resolve().parent
    root = (args.root if args.root is not None else here.parent).expanduser()
    try:
        root = root.resolve()
    except OSError as exc:
        return die(f"unreadable --root: {exc}")
    if not root.is_dir():
        return die(f"--root is not a directory: {root}")

    try:
        home = paseo_home(args.paseo_home)
    except OSError as exc:
        return die(f"unreadable --paseo-home: {exc}")

    report = assess(root, home)
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print_text(report)
    return EXIT_OK if report["ready"] else EXIT_BLOCKED


if __name__ == "__main__":
    sys.exit(main())

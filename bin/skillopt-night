#!/usr/bin/env python3
"""skillopt-night — the fleet-wide nightly SkillOpt-Sleep cycle for this Mac.

SkillOpt-Sleep (https://microsoft.github.io/SkillOpt/, `uv tool install` from
upstream main) mines past agent transcripts into tasks, replays them against the
current skills, and stages gated edits to SKILL.md / CLAUDE.md for review. Its
CLI handles one transcript source per run; this wrapper runs one stateful
`skillopt-sleep run --scope all` per source that has data on this Mac (five
native, eight through bin/skillopt_sources.py adapters, Hermes included), in
sequence, under `nice`, with a bounded timeout each, staging everything under
~/src/djbclark-ade. docs/skillopt-sleep.md is the operator guide.

    skillopt-night                     # the nightly run (launchd, 03:30)
    skillopt-night --dry-run           # mock backend, never advances checkpoints
    skillopt-night --source claude     # restrict (repeatable)
    skillopt-night chain-check         # preflight the backend chain, print the table
    skillopt-night sources             # which sources have data here
    skillopt-night install             # copy + bootstrap the launchd plist
    skillopt-night uninstall           # bootout + remove the plist

**Backend: a failover chain, executed through acp-run.** SkillOpt's
`get_backend` is a fixed if-chain (an unknown name silently becomes the mock
backend), so no external backend can be registered without patching it. The
night therefore runs SkillOpt's `handoff` backend: the engine writes each round
of model calls to pending.json and exits 3; this runner answers every prompt
through one entry of the chain in ~/.skillopt-sleep/night.json (bin/failover.py:
acp-run --strip-user-config in a clean empty dir under the entry's --perm, so each
prompt gets a fresh context, or an OpenAI-compatible POST for the SIPB endpoint) and
reruns, until
the engine finishes. One entry answers a whole source night, so baseline and
candidate scores come from the same model. If an entry fails (preflight, an
answer, the run itself, or the night's diagnostics), the runner restores
state.json, wipes that source's handoff dir and reruns the source night on the
next entry; when none is left it records `chain_exhausted`.

Guards, in order:

1. A stateful night refuses unless night.json exists with `"enabled": true` and
   a non-empty chain: it prints "waiting for backend decision" and exits 0, so
   the launchd job stays inert until the operator approves the chain. A chain
   that violates policy (bin/failover.py DENY, the allowlist, a perm outside
   deny/all) is refused whole. night.json "perm" (entry "perm" overrides) picks
   acp-run's --perm per entry: "deny" (failover's default: the deny canary, the
   exit-77 tripwire) or "all" (operator 2026-10-13: "I want all of the TUIs and
   hermes to be able to run any tools they want"; no canary, no tripwire, the agent
   runs any tool with the user's permissions in an empty temp dir). Every attempt
   line, attempts.jsonl row and nights.jsonl row names the perm.
2. The load gate reuses `machine_overloaded()` from bin/acp-dispatch (load above
   4x CPUs or critical memory pressure); it waits up to --load-wait seconds,
   then skips the night. Since 2026-10-13 every prompt has its own, stricter gate
   (failover.Pacing via prompt_pacing): before each acp-run spawn it waits while
   the 1-minute load per core is above 2.0 (night.json `prompt_max_load`, env
   SKILLOPT_NIGHT_PROMPT_MAX_LOAD), polling every 15 s, at most 600 s per spawn
   (`prompt_load_wait_s`, SKILLOPT_NIGHT_PROMPT_LOAD_WAIT) and never past the
   deadline; a longer wait is a retryable startup failure. Critical memory
   pressure seen before any spawn ends the night (NightStop).
3. One night at a time (an flock under the state dir).

Upstream keys the harvest checkpoint by project only, so a second source run in
the same night would see only sessions newer than the first run. This wrapper
keeps one cursor per source in cursors.json and swaps it into
~/.skillopt-sleep/state.json before each run. Upstream's codex harvester reads
only a flat ~/.codex/archived_sessions (Codex Desktop); Codex CLI keeps rollouts
in ~/.codex/sessions/YYYY/MM/DD, so the codex run gets a shim --codex-home whose
archived_sessions holds symlinks to every rollout. Upstream's handoff dir is per
project and is archived only when a night stages something, so each source gets
its own dir (SKILLOPT_SLEEP_HANDOFF_DIR) and the runner archives it after every
finished night.

Outputs: ~/.local/state/skillopt-sleep/<date>-<source>.log per run, one JSON
line per source night in nights.jsonl, every preflight/attempt in attempts.jsonl
(both carry `tokens`, the backend-reported counts of the answered prompts; see
docs/failover.md), and at most one `hermes-ping` per event (proposals staged, chain exhausted,
chain invalid).

Test hooks (environment): SKILLOPT_NIGHT_STATE_DIR, SKILLOPT_NIGHT_BIN,
SKILLOPT_NIGHT_PING, SKILLOPT_NIGHT_LAUNCH_AGENTS, SKILLOPT_NIGHT_NO_INSTALL=1
(install/uninstall print the plan, change nothing), SKILLOPT_NIGHT_NO_GATE=1;
bin/failover.py reads FAILOVER_AIUSE_JSON, FAILOVER_ACP_RUN, FAILOVER_SECRETSPEC.
"""
from __future__ import annotations

import argparse
import contextlib
import fcntl
import importlib.machinery
import importlib.util
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timedelta
from pathlib import Path
from typing import Any

REPO = Path(__file__).resolve().parent.parent
if str(REPO / "bin") not in sys.path:
    sys.path.insert(0, str(REPO / "bin"))
import failover
import skillopt_sources

LABEL = "com.djbclark.skillopt-sleep"
PLIST_SRC = REPO / "launchd" / f"{LABEL}.plist"
PREFERENCES = REPO / "docs" / "skillopt-preferences.md"
# Sources SkillOpt harvests natively (pi excluded by the operator, 2026-10-12) and the ones
# this repo adapts (bin/skillopt_sources.py, fed to the handoff path as pinned digests;
# hermes, grok, muse, cline and acp_dispatch added 2026-10-13). A source name is where
# transcripts are read from; it says nothing about which backends may answer (NIGHT_DENY).
NATIVE_SOURCES = ("claude", "codex", "cursor", "opencode", "copilot_cli")
ADAPTER_SOURCES = ("zcode", "agy", "crush", "hermes", "grok", "muse", "cline", "acp_dispatch")
SOURCES = NATIVE_SOURCES + ADAPTER_SOURCES
# Operator 2026-10-12 (approved chain): the only backends a night may use, and words no
# entry may contain (on top of failover.DENY: cursor, cline, clinepass, opus, fable).
# Hermes admitted 2026-10-13 (operator: "I want all of the TUIs and hermes to be able to
# run any tools they want"); muse, pi, grok, codex, copilot (and failover.DENY's cursor,
# cline/clinepass, opus, fable) stay denied until the operator revisits them.
DEFAULT_ALLOW = ["opencode", "agy", "zcode", "claude", "crush", "hermes"]
NIGHT_DENY = (*failover.DENY, "muse", "pi", "grok", "codex", "copilot")
# Chain entries that SkillOpt can also drive with its own backend (--native).
NATIVE_BACKENDS = ("opencode", "claude")
DEFAULT_TIMEOUT_S = 5400
DEFAULT_LOAD_WAIT_S = 1800
# Handoff rounds are cheap reruns; consolidation asks one or two dependent prompts per
# round (reflect, then each gate trial), so a night needs far more than upstream's
# "3-6" (run A, 2026-10-12: 8 rounds ended with skill groups still in progress).
# A round that asks exactly the prompts it asked last round, answers written, is
# stuck and fails the attempt; this cap is only a backstop.
DEFAULT_MAX_ROUNDS = 60
DEFAULT_JOBS = 2
# The per-prompt gate (2026-10-13): no acp-run spawn while the 1-minute load per core is
# above this (16 on 8 cores; acp-run notes session/new slowing at load 20-70), waiting at
# most DEFAULT_PROMPT_LOAD_WAIT_S per spawn before it counts as a startup failure.
DEFAULT_PROMPT_MAX_LOAD = 2.0
DEFAULT_PROMPT_LOAD_WAIT_S = 600
GATE_LOAD_PER_CPU = 4  # same number as bin/acp-dispatch; used only if its import fails
PING = "~/.local/bin/hermes-ping"
REVIEW = "skillopt-sleep status --project ~/src/djbclark-ade"
DEFAULT_DEADLINE = "06:30"  # local time the whole night must end by (M4)
# The first user prompt of sessions the cycle itself creates (upstream's attempt, miner
# and judge templates): upstream's harvesters skip them through this env (H2).
ENGINE_MARKERS = ("Complete the following task for the user,"
                  "You are mining a user's past AI-assistant sessions,"
                  "Score how well the response satisfies the rubric")


class NightStop(Exception):
    """The night must stop now (deadline passed or machine overloaded); not an entry failure."""


def home() -> Path:
    return Path.home()


def state_dir() -> Path:
    return Path(os.environ.get("SKILLOPT_NIGHT_STATE_DIR")
                or home() / ".local" / "state" / "skillopt-sleep")


def skillopt_bin() -> str:
    return (os.environ.get("SKILLOPT_NIGHT_BIN") or shutil.which("skillopt-sleep")
            or str(home() / ".local" / "bin" / "skillopt-sleep"))


def config_path() -> Path:
    return home() / ".skillopt-sleep" / "config.json"


def night_path() -> Path:
    return home() / ".skillopt-sleep" / "night.json"


def sleep_state_path() -> Path:
    return home() / ".skillopt-sleep" / "state.json"


def handoff_dir(source: str) -> Path:
    return REPO / ".skillopt-sleep-handoff" / source


def load_config() -> dict[str, Any]:
    try:
        data = json.loads(config_path().read_text())
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def load_night() -> dict[str, Any]:
    try:
        data = json.loads(night_path().read_text())
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def load_entries(night: dict[str, Any]) -> list[failover.Entry]:
    """The night's chain: night.json "perm" is the chain default (failover's "deny" when
    absent), an entry's "perm" overrides it; every acp entry gets acp-run
    --strip-user-config (the 2026-10-13 startup-failure fix, not a permission control)."""
    return failover.load_chain(night.get("chain") or [],
                               allow=night.get("allow") or DEFAULT_ALLOW, deny=NIGHT_DENY,
                               perm=night.get("perm"), strip_user_config=True)


# ── sources ──────────────────────────────────────────────────────────────────

def source_root(source: str, cfg: dict[str, Any]) -> Path:
    """The transcript store skillopt-sleep reads for this source on this Mac."""
    h = home()
    roots = {
        "claude": Path(cfg.get("claude_home") or h / ".claude") / "projects",
        "codex": Path(cfg.get("codex_home") or h / ".codex") / "sessions",
        "cursor": Path(cfg.get("cursor_home") or h / ".cursor") / "projects",
        "opencode": Path(cfg.get("opencode_db")
                         or h / ".local" / "share" / "opencode" / "opencode.db"),
        "copilot_cli": Path(cfg.get("copilot_cli_session_store")
                            or h / ".copilot" / "session-store.db"),
    }
    return Path(os.path.expanduser(str(roots[source])))


def has_data(root: Path) -> bool:
    if root.is_file():
        return root.stat().st_size > 0
    if root.is_dir():
        return any(root.iterdir())
    return False


def source_present(source: str, cfg: dict[str, Any]) -> bool:
    if source in ADAPTER_SOURCES:
        return skillopt_sources.store_present(source)
    return has_data(source_root(source, cfg))


def available_sources(cfg: dict[str, Any], only: list[str] | None = None) -> list[str]:
    wanted = only or list(SOURCES)
    return [s for s in SOURCES if s in wanted and source_present(s, cfg)]


def tool_python() -> str:
    """The skillopt uv tool's interpreter (its shebang), so adapters reuse upstream's
    redaction and replay filters; this interpreter as a fallback."""
    override = os.environ.get("SKILLOPT_NIGHT_TOOL_PYTHON")
    if override:
        return override
    try:
        first = Path(skillopt_bin()).read_text(errors="ignore").splitlines()[0]
        if first.startswith("#!") and "python" in first and Path(first[2:].strip()).exists():
            return first[2:].strip()
    except (OSError, IndexError):
        pass
    return sys.executable


def adapter_since(source: str, cfg: dict[str, Any]) -> str:
    """This source's cursor, else the configured first-night lookback (local time)."""
    cur = _read_json(state_dir() / "cursors.json", {}).get(source)
    if cur:
        return str(cur)
    hours = float(cfg.get("lookback_hours") or 72)
    return datetime.fromtimestamp(time.time() - hours * 3600).isoformat(timespec="seconds")


def engine_env(extra: dict[str, str] | None = None) -> dict[str, str]:
    """A minimal env for the engine and the adapters (M2), with the engine markers (H2)."""
    return failover.minimal_env({"SKILLOPT_SLEEP_AGENT_MARKERS": ENGINE_MARKERS, **(extra or {})})


def adapter_digests(source: str, cfg: dict[str, Any], out: Path, limit: int,
                    exclude: list[str] | None = None) -> int:
    """Write SessionDigest JSON for any source (native ones through upstream's own
    harvester); every digest passes skillopt_sources.finalize: project exclusions,
    the engine's own sessions dropped, extra redaction. Returns how many."""
    out.parent.mkdir(parents=True, exist_ok=True)
    cmd = [tool_python(), "-I", str(REPO / "bin" / "skillopt_sources.py"), source,
           "--since", adapter_since(source, cfg), "--limit", str(limit), "--out", str(out)]
    for path in exclude or []:
        cmd += ["--exclude-project", path]
    if source == "codex":
        cmd += ["--codex-home", str(codex_shim(cfg))]
    try:
        proc = failover.run_bounded(cmd, env=engine_env(), timeout=1800)
    except subprocess.TimeoutExpired as e:
        raise RuntimeError(f"skillopt_sources {source} timed out") from e
    if proc.returncode != 0:
        raise RuntimeError(f"skillopt_sources {source} rc={proc.returncode}: {(proc.stderr or '')[-300:]}")
    data = _read_json(out, None)
    if isinstance(data, list):
        return len(data)
    raise RuntimeError(f"skillopt_sources {source} wrote no digest list")


def codex_shim(cfg: dict[str, Any]) -> Path:
    """A --codex-home whose archived_sessions links every Codex CLI rollout."""
    shim = state_dir() / "codex-home"
    arch = shim / "archived_sessions"
    arch.mkdir(parents=True, exist_ok=True)
    for old in arch.iterdir():
        if old.is_symlink():
            old.unlink()
    for path in sorted(source_root("codex", cfg).rglob("*.jsonl")):
        link = arch / path.name
        if not link.exists():
            link.symlink_to(path)
    return shim


# ── per-source harvest cursors ──────────────────────────────────────────────

def _read_json(path: Path, default: Any) -> Any:
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return default


def _write_json(path: Path, data: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(data, indent=2) + "\n")
    os.replace(tmp, path)


def swap_in_cursor(source: str, project: str) -> str | None:
    """Put this source's own cursor into state.json; return it."""
    cur = _read_json(state_dir() / "cursors.json", {}).get(source)
    sp = sleep_state_path()
    state = _read_json(sp, None)
    if state is None and cur is None:
        return None
    state = state if isinstance(state, dict) else {}
    lh = state.setdefault("last_harvest", {})
    if cur:
        lh[project] = cur
    else:
        lh.pop(project, None)
    _write_json(sp, state)
    return cur


def save_cursor(source: str, project: str, before: str | None) -> None:
    after = (_read_json(sleep_state_path(), {}) or {}).get("last_harvest", {}).get(project)
    if after and after != before:
        path = state_dir() / "cursors.json"
        cursors = _read_json(path, {})
        cursors[source] = after
        _write_json(path, cursors)


def snapshot_state() -> bytes | None:
    try:
        return sleep_state_path().read_bytes()
    except OSError:
        return None


def restore_state(snap: bytes | None) -> None:
    """Undo whatever a failed attempt did to state.json (night counter, history, cursor)."""
    sp = sleep_state_path()
    if snap is None:
        with contextlib.suppress(FileNotFoundError):
            sp.unlink()
        return
    tmp = sp.with_name(sp.name + ".tmp")
    tmp.write_bytes(snap)
    os.replace(tmp, sp)


# ── guards ───────────────────────────────────────────────────────────────────

def machine_overloaded() -> str | None:
    """bin/acp-dispatch's gate when importable, else the same load rule."""
    try:
        loader = importlib.machinery.SourceFileLoader(
            "acp_dispatch_gate", str(REPO / "bin" / "acp-dispatch"))
        spec = importlib.util.spec_from_loader("acp_dispatch_gate", loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        return mod.machine_overloaded()
    except Exception:  # noqa: BLE001 - any import failure falls back to the plain check
        load1 = os.getloadavg()[0]
        ncpu = os.cpu_count() or 8
        if load1 > GATE_LOAD_PER_CPU * ncpu:
            return f"load {load1:.0f} > {GATE_LOAD_PER_CPU}x{ncpu} cpus"
        return None


def wait_for_capacity(max_wait: int) -> str | None:
    """None when the machine has room; else why, after waiting up to max_wait."""
    if os.environ.get("SKILLOPT_NIGHT_NO_GATE") == "1":
        return None
    start = time.monotonic()
    why = machine_overloaded()
    while why and time.monotonic() - start < max_wait:
        time.sleep(60)
        why = machine_overloaded()
    return why


# ── one skillopt-sleep invocation ────────────────────────────────────────────

def preferences_text() -> str:
    try:
        return PREFERENCES.read_text().strip()
    except OSError:
        return ""


def build_command(source: str, *, dry_run: bool, cfg: dict[str, Any],
                  codex_home: Path | None = None, backend: str | None = None,
                  model: str = "", max_sessions: int = 0, pinned: bool = True) -> list[str]:
    """backend None: mock for a dry-run, handoff otherwise. pinned (every night except a
    --native entry): the source's sessions arrive as the handoff dir's digests.json, so
    the engine runs as `--source opencode --opencode-db :memory:`, which harvests nothing."""
    backend = backend or ("mock" if dry_run else "handoff")
    cli_source = ["opencode", "--opencode-db", ":memory:"] if pinned else [source]
    cmd = ["nice", "-n", "10", skillopt_bin(), "dry-run" if dry_run else "run",
           "--project", str(REPO), "--scope", "all", "--source", *cli_source,
           "--skill-root", str(REPO / "skills"), "--progress", "--json", "--backend", backend]
    if model:
        cmd += ["--model", model]
    if not pinned and source == "codex" and codex_home is not None:
        cmd += ["--codex-home", str(codex_home)]
    if max_sessions and not dry_run and not pinned:
        cmd += ["--max-sessions", str(max_sessions)]
    prefs = preferences_text()
    if prefs:
        cmd += ["--preferences", prefs]
    return cmd


def parse_result(stdout: str) -> dict[str, Any]:
    """The JSON object skillopt-sleep prints last on stdout ({} if none)."""
    start = stdout.rfind("\n{")
    start = 0 if stdout.startswith("{") and start < 0 else start + 1
    try:
        data = json.loads(stdout[start:]) if start >= 0 else {}
    except ValueError:
        return {}
    return data if isinstance(data, dict) else {}


def n_proposals(result: dict[str, Any]) -> int:
    """Proposals actually staged: the staging manifest's per-skill rows plus its legacy
    (managed skill / CLAUDE.md) entries. A staging dir alone is not a proposal: a
    rejected night writes one too (run A, 2026-10-12, pinged "staged 1" for nothing)."""
    staging = result.get("staging_dir")
    if staging:
        manifest = _read_json(Path(staging) / "manifest.json", None)
        if isinstance(manifest, dict):
            return len(manifest.get("skills") or []) + len(manifest.get("legacy") or {})
    return len(result.get("staged_skills") or [])


def invoke(cmd: list[str], *, log: Path, env: dict[str, str], timeout: float) -> tuple[int, str]:
    """Run the engine in its own process group; on timeout kill the whole group (M5)."""
    shown = list(cmd)
    if "--preferences" in shown:
        shown[shown.index("--preferences") + 1] = "<docs/skillopt-preferences.md>"
    with open(log, "a") as lf:
        lf.write(f"\n== {datetime.now().isoformat(timespec='seconds')} {' '.join(shown)}\n")
        lf.flush()
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=lf, stdin=subprocess.DEVNULL,
                                text=True, env=env, cwd=str(REPO), start_new_session=True)
        try:
            stdout, _ = proc.communicate(timeout=max(1, timeout))
            rc = proc.returncode
        except subprocess.TimeoutExpired:
            failover.kill_group(proc)
            rc, stdout = 124, ""
        lf.write(stdout or "")
        lf.write(f"\n== rc={rc}\n")
    return rc, stdout or ""


def night_failure(rc: int, result: dict[str, Any]) -> str | None:
    """Why a finished night does not count as the backend answering, or None."""
    if rc != 0:
        return f"skillopt-sleep rc={rc}"
    if result.get("ok") is False:
        return f"skillopt-sleep error: {result.get('error')}: {str(result.get('message'))[:200]}"
    staging = result.get("staging_dir")
    if staging:
        diag = Path(staging) / "diagnostics.json"
        text = diag.read_text(errors="ignore") if diag.exists() else ""
        if "empty response on all" in text:
            return "diagnostics: empty response on all attempts"
        data = _read_json(diag, {}) if text else {}
        for key in ("call_error", "last_call_error"):
            if isinstance(data, dict) and str(data.get(key) or "").strip():
                return f"diagnostics: {key}: {str(data[key])[:200]}"
        report = _read_json(Path(staging) / "report.json", {})
        if isinstance(report, dict) and report.get("n_tasks") and report.get("n_replayed") == 0:
            return "tasks were mined but none was replayed"
    return None


def reset_dir(path: Path) -> None:
    shutil.rmtree(path, ignore_errors=True)


def archive_handoff(source: str) -> None:
    """Move a finished night's handoff dir aside (upstream keeps it when nothing staged)."""
    hdir = handoff_dir(source)
    if not hdir.exists():
        return
    arch = state_dir() / "handoff-archive"
    arch.mkdir(parents=True, exist_ok=True)
    shutil.move(str(hdir), str(arch / f"{source}-{datetime.now():%Y%m%d-%H%M%S}"))
    # keep the newest ten by time (L3), not by name; they hold transcript excerpts
    for old in sorted(arch.iterdir(), key=lambda p: p.stat().st_mtime)[:-10]:
        shutil.rmtree(old, ignore_errors=True)


def pending_ids(hdir: Path) -> frozenset[str]:
    data = _read_json(hdir / "pending.json", {})
    pending = data.get("pending") if isinstance(data, dict) else None
    return frozenset(str(p["id"]) for p in pending or [])


def answer_pending(entry: failover.Entry, hdir: Path, jobs: int,
                   pacing: failover.Pacing | None = None) -> int:
    """Answer every prompt in pending.json on this entry; return how many."""
    data = _read_json(hdir / "pending.json", {})
    pending = data.get("pending") if isinstance(data, dict) else None
    if not pending:
        raise failover.AttemptFailed("handoff exit 3 with no pending prompts")
    prompts = {str(p["id"]): str(p["prompt"]) for p in pending}
    answers = failover.ask_many(entry, prompts, jobs=jobs, pacing=pacing)
    adir = hdir / "answers"
    adir.mkdir(parents=True, exist_ok=True)
    for key, text in answers.items():
        (adir / f"{key}.md").write_text(text)
    return len(answers)


def record(row: dict[str, Any]) -> None:
    sd = state_dir()
    sd.mkdir(parents=True, exist_ok=True)
    row = {"at": datetime.now().isoformat(timespec="seconds"), **row}
    with open(sd / "nights.jsonl", "a") as f:
        f.write(json.dumps(row) + "\n")


def ping(line: str) -> None:
    exe = os.path.expanduser(os.environ.get("SKILLOPT_NIGHT_PING") or PING)
    try:
        subprocess.run([exe, line], timeout=60, check=False,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        pass


def log_path(source: str, dry_run: bool) -> Path:
    sd = state_dir()
    sd.mkdir(parents=True, exist_ok=True)
    return sd / f"{datetime.now():%Y-%m-%d}-{source}{'-dry' if dry_run else ''}.log"


def deadline_at(night: dict[str, Any], now: float | None = None) -> float:
    """The epoch time the whole night must end by: the next HH:MM (night.json
    "deadline", default 06:30 local) after now."""
    now = time.time() if now is None else now
    hh, mm = (int(x) for x in str(night.get("deadline") or DEFAULT_DEADLINE).split(":", 1))
    cand = datetime.fromtimestamp(now).replace(hour=hh, minute=mm, second=0, microsecond=0)
    if cand.timestamp() <= now:
        cand += timedelta(days=1)
    return cand.timestamp()


def night_guard(deadline: float, load_wait: int) -> None:
    """Before each source and each attempt: stop at the deadline, and wait (bounded by
    the deadline) while the machine is overloaded (M4)."""
    left = deadline - time.time()
    if left <= 0:
        raise NightStop(f"deadline {datetime.fromtimestamp(deadline):%H:%M} passed")
    why = wait_for_capacity(int(min(load_wait, left)))
    if why:
        raise NightStop(f"overloaded: {why}")


def memory_stop() -> None:
    """failover.Pacing.stop, before every prompt's spawn: end the night on critical memory
    pressure (night_guard's check, machine_overloaded); high load only delays the spawn."""
    if os.environ.get("SKILLOPT_NIGHT_NO_GATE") == "1":
        return
    why = machine_overloaded()
    if why and "memory" in why:
        raise NightStop(f"overloaded: {why}")


def _setting(env: str, night: dict[str, Any], key: str, default: float) -> float:
    """A number from the environment, else night.json, else default (a bad value too)."""
    for name, raw in ((env, os.environ.get(env)), (key, night.get(key))):
        if raw is None or raw == "":
            continue
        try:
            return float(raw)
        except (TypeError, ValueError):
            print(f"skillopt-night: ignoring {name}={raw!r}", file=sys.stderr)
    return default


def prompt_pacing(night: dict[str, Any], deadline: float, source: str) -> failover.Pacing:
    """The per-prompt gate and startup-failure retries for one source night (2026-10-13)."""
    gate = os.environ.get("SKILLOPT_NIGHT_NO_GATE") != "1"
    return failover.Pacing(
        max_load=(_setting("SKILLOPT_NIGHT_PROMPT_MAX_LOAD", night, "prompt_max_load",
                           DEFAULT_PROMPT_MAX_LOAD) if gate else None),
        load_wait=_setting("SKILLOPT_NIGHT_PROMPT_LOAD_WAIT", night, "prompt_load_wait_s",
                           DEFAULT_PROMPT_LOAD_WAIT_S),
        deadline=deadline, stop=memory_stop if gate else None,
        log_path=state_dir() / "attempts.jsonl", task=f"skillopt-night {source}")


def claude_bypass() -> bool:
    """~/.claude/settings.json makes bypassPermissions the default mode."""
    data = _read_json(home() / ".claude" / "settings.json", {}) or {}
    return (data.get("permissions") or {}).get("defaultMode") == "bypassPermissions"


def run_dry(source: str, *, cfg: dict[str, Any], timeout: int, limit: int = 120,
            exclude: list[str] | None = None) -> dict[str, Any]:
    """A free preview of one source, the same path a real night takes: the source's
    digests (after exclusions and redaction) are pinned into a throwaway handoff dir and
    the engine runs `dry-run --backend handoff`, which makes no model calls and saves
    no state; it exits 3 with the round-1 prompts, which are counted and discarded."""
    log = log_path(source, True)
    with tempfile.TemporaryDirectory(prefix=f"skillopt-dry-{source}-") as tmp:
        hdir = Path(tmp) / "handoff"
        try:
            n = adapter_digests(source, cfg, hdir / "digests.json", limit, exclude)
        except (RuntimeError, OSError, subprocess.SubprocessError) as e:
            row = {"source": source, "mode": "dry-run", "rc": None, "ok": False,
                   "status": "adapter-failed", "why": str(e)[:300], "log": str(log)}
            record(row)
            return row
        cmd = build_command(source, dry_run=True, cfg=cfg, backend="handoff")
        rc, stdout = invoke(cmd, log=log, timeout=timeout,
                            env=engine_env({"SKILLOPT_SLEEP_HANDOFF_DIR": str(hdir)}))
        pending = _read_json(hdir / "pending.json", {})
        n_pending = len(pending.get("pending") or []) if isinstance(pending, dict) else 0
    result = parse_result(stdout)
    row = {"source": source, "mode": "dry-run", "rc": rc, "ok": rc in (0, 3), "sessions": n,
           "tasks": result.get("n_tasks"), "pending_prompts": n_pending, "proposals": 0,
           "log": str(log)}
    record(row)
    return row


def run_source_chain(source: str, entries: list[failover.Entry], *, cfg: dict[str, Any],
                     timeout: int, max_rounds: int, jobs: int, max_sessions: int = 0,
                     native: bool = False, deadline: float | None = None,
                     load_wait: int = 0, exclude: list[str] | None = None,
                     pacing: failover.Pacing | None = None) -> dict[str, Any]:
    """One stateful source night through the chain; returns its nights.jsonl row."""
    project = str(REPO)
    log = log_path(source, False)
    hdir = handoff_dir(source)
    deadline = deadline if deadline is not None else time.time() + timeout
    pacing = pacing or prompt_pacing({}, deadline, source)
    shim = codex_shim(cfg) if source == "codex" else None
    env = engine_env({"SKILLOPT_SLEEP_HANDOFF_DIR": str(hdir)})
    pinned = state_dir() / f"digests-{source}.json"
    try:
        n_pinned = adapter_digests(source, cfg, pinned, max_sessions or 120, exclude)
    except (RuntimeError, OSError, subprocess.SubprocessError) as e:
        row = {"source": source, "mode": "run", "status": "adapter-failed",
               "why": str(e)[:300], "proposals": 0, "log": str(log)}
        record(row)
        return row

    def attempt(entry: failover.Entry) -> dict[str, Any]:
        night_guard(deadline, load_wait)  # NightStop is not an entry failure: it ends the night
        use_native = (native and source in NATIVE_SOURCES and entry.tui.name in NATIVE_BACKENDS)
        snap = snapshot_state()
        before = swap_in_cursor(source, project)
        reset_dir(hdir)
        if not use_native:
            hdir.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(pinned, hdir / "digests.json")
        cmd = build_command(source, dry_run=False, cfg=cfg, codex_home=shim,
                            max_sessions=max_sessions, pinned=not use_native,
                            backend=entry.tui.name if use_native else "handoff",
                            model=entry.native_model if use_native else "")
        stop = time.monotonic() + max(1.0, min(timeout, deadline - time.time()))
        rounds = answered = 0
        last: frozenset[str] = frozenset()
        try:
            with open(log, "a") as lf:
                lf.write(f"\n== attempt on {entry.label} perm={entry.perm}"
                         f"{' (native backend)' if use_native else ''}\n")
            while True:
                rounds += 1
                rc, stdout = invoke(cmd, log=log, env=env, timeout=stop - time.monotonic())
                if rc != 3:
                    break
                ids = pending_ids(hdir)
                if ids and ids == last:
                    raise failover.AttemptFailed(f"no progress: round {rounds} asked the same "
                                                 f"{len(ids)} prompt(s) again after they were answered")
                last = ids
                if rounds >= max_rounds:
                    raise failover.AttemptFailed(f"still pending after {rounds} rounds")
                if time.monotonic() >= stop:
                    raise failover.AttemptFailed(f"timeout after {rounds} rounds")
                answered += answer_pending(entry, hdir, jobs, pacing)
            result = parse_result(stdout)
            why = night_failure(rc, result)
            if why:
                raise failover.AttemptFailed(why)
        except (failover.AttemptFailed, NightStop):  # NightStop: memory pressure mid-attempt
            restore_state(snap)
            reset_dir(hdir)
            raise
        save_cursor(source, project, before)
        archive_handoff(source)
        return {"rc": rc, "result": result, "rounds": rounds, "answered": answered}

    perms = {e.label: e.perm for e in entries}
    stopped = None
    try:
        res = failover.run_chain(entries, attempt, task=f"skillopt-night {source}",
                                 log_path=state_dir() / "attempts.jsonl", tally=pacing.tally)
    except NightStop as e:
        stopped, res = str(e), None
    finally:
        pinned.unlink(missing_ok=True)  # transcript excerpts; the night's own copy is archived
    if res is None:
        row = {"source": source, "mode": "run", "status": f"stopped: {stopped}", "rc": None,
               "proposals": 0, "retries": pacing.retried, "perms": perms, "log": str(log),
               **pacing.tally.row_fields()}
    elif not res.ok:
        failed = [f"{r['label']}: {r['why']}" for r in res.attempts if not r["ok"]]
        row = {"source": source, "mode": "run", "status": "chain_exhausted", "rc": None,
               "proposals": 0, "failed": failed, "retries": pacing.retried, "perms": perms,
               "log": str(log), **pacing.tally.row_fields()}
    else:
        failed = [f"{r['label']}: {r['why']}" for r in res.attempts if not r["ok"]]
        v, result = res.value, res.value["result"]
        row = {"source": source, "mode": "run", "status": "ok", "entry": res.entry.label,
               "perm": res.entry.perm, "rc": v["rc"], "rounds": v["rounds"], "answered": v["answered"],
               # the engine reports 0 sessions for pinned digests: count what was pinned
               "sessions": n_pinned if not result.get("n_sessions") else result.get("n_sessions"),
               "tasks": result.get("n_tasks"),
               "accepted": result.get("accepted"), "gate": result.get("gate_action") or None,
               "proposals": n_proposals(result), "staging_dir": result.get("staging_dir") or None,
               "failed": failed, "retries": pacing.retried, "perms": perms, "log": str(log),
               **pacing.tally.row_fields()}
    record(row)
    return row


# ── commands ─────────────────────────────────────────────────────────────────

def cmd_night(args: argparse.Namespace) -> int:
    cfg = load_config()
    sources = available_sources(cfg, args.source)
    entries: list[failover.Entry] = []
    night = load_night()
    mode = "dry-run" if args.dry_run else "run"
    if not args.dry_run:
        if not night.get("enabled") or not night.get("chain"):
            print("skillopt-night: waiting for backend decision (no enabled chain in "
                  f"{night_path()}); run `skillopt-night --dry-run` (see docs/skillopt-sleep.md)")
            record({"mode": "run", "status": "waiting-backend"})
            return 0
        if args.native and claude_bypass():
            msg = ("--native refused: ~/.claude/settings.json defaultMode is bypassPermissions, so "
                   "SkillOpt's native claude backend would replay tool tasks with tools on")
            print(f"skillopt-night: {msg}", file=sys.stderr)
            record({"mode": "run", "status": "native-refused", "why": msg})
            return 2
        try:
            entries = load_entries(night)
        except failover.ChainError as e:
            print(f"skillopt-night: chain refused: {e}", file=sys.stderr)
            record({"mode": "run", "status": "chain-invalid", "why": str(e)})
            ping(f"djbclark-ade: skillopt-sleep chain refused ({e}); fix {night_path()}")
            return 1
    if not sources:
        print("skillopt-night: no transcript source with data", file=sys.stderr)
        return 0
    exclude = [os.path.expanduser(str(x)) for x in night.get("exclude_projects") or []]
    deadline = deadline_at(night)
    limit = args.max_sessions or int(night.get("max_sessions") or 120)
    sd = state_dir()
    sd.mkdir(parents=True, exist_ok=True)
    sd.chmod(0o700)
    rows: list[dict[str, Any]] = []
    with open(sd / "night.lock", "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            print("skillopt-night: another night is running", file=sys.stderr)
            return 0
        try:
            for s in sources:
                try:
                    night_guard(deadline, args.load_wait)
                except NightStop as e:
                    why = str(e).removeprefix("overloaded: ")
                    print(f"skillopt-night: skipped, {e}", file=sys.stderr)
                    record({"mode": mode, "status": f"skipped: {why}", "source": s})
                    break
                if args.dry_run:
                    rows.append(run_dry(s, cfg=cfg, timeout=args.timeout or DEFAULT_TIMEOUT_S,
                                        limit=limit, exclude=exclude))
                    continue
                timeout = args.timeout or int(night.get("source_timeout_s", DEFAULT_TIMEOUT_S))
                row = run_source_chain(s, entries, cfg=cfg, timeout=timeout,
                                       max_rounds=int(night.get("max_rounds", DEFAULT_MAX_ROUNDS)),
                                       jobs=int(night.get("jobs", DEFAULT_JOBS)), max_sessions=limit,
                                       native=args.native, deadline=deadline,
                                       load_wait=args.load_wait, exclude=exclude,
                                       pacing=prompt_pacing(night, deadline, s))
                rows.append(row)
                if str(row.get("status", "")).startswith("stopped"):
                    break
        finally:
            failover.sweep_logs()
    for r in rows:
        print(f"{r['source']:12} {r.get('status', 'ok'):15} entry={r.get('entry', '-')} "
              f"perm={r.get('perm') or ','.join(sorted(set((r.get('perms') or {}).values()))) or '-'} "
              f"rc={r.get('rc')} sessions={r.get('sessions')} tasks={r.get('tasks')} "
              f"pending={r.get('pending_prompts', '-')} "
              f"gate={r.get('gate')} proposals={r.get('proposals')} log={r['log']}")
    if args.dry_run:
        return 0 if all(r.get("ok") for r in rows) else 1
    staged = [r for r in rows if r.get("proposals")]
    if staged:
        n = sum(r["proposals"] for r in staged)
        ping(f"djbclark-ade: skillopt-sleep staged {n} proposal(s) from "
             f"{','.join(r['source'] for r in staged)}; review: {REVIEW}")
    exhausted = [r for r in rows if r.get("status") == "chain_exhausted"]
    if exhausted:
        ping(f"djbclark-ade: skillopt-sleep chain exhausted for "
             f"{','.join(r['source'] for r in exhausted)}; see {sd}/attempts.jsonl")
    return 0 if not exhausted else 1


# Deterministic flags on lines a staged proposal ADDS (adversary review 2026-10-12, M3):
# staged text is LLM-written from transcripts, so anything that would steer a future
# agent toward running commands, fetching URLs or skipping review must be shown to
# djbclark and acknowledged before `skillopt-sleep adopt`.
PREADOPT_FLAGS = (
    ("url", re.compile(r"https?://\S+")),
    ("pipe-to-shell", re.compile(r"(?i)\b(curl|wget)\b[^\n|]*\|\s*(sudo\s+)?(ba|z)?sh\b")),
    ("shell-command", re.compile(
        r"(?<![\w-])(curl|wget|sudo|rm\s+-rf|chmod|chown|ssh|scp|ncat|eval|base64\s+-[dD]|osascript"
        r"|launchctl|crontab|security\s+find-|gh\s+pr\s+merge|git\s+push|npm\s+publish|pip\s+install"
        r"|uv\s+tool\s+install|brew\s+install|sudo-secretspec\s+get)\b")),
    ("override-wording", re.compile(
        r"(?i)\b(ignore|disregard|forget)\b.{0,40}\b(previous|prior|above|earlier|instructions|rules)\b"
        r"|\boverride\b|\bnever ask\b|\bwithout (asking|confirmation|review)\b|\bdo(n't| not) ask\b"
        r"|\balways\b|\bbypass|\bskip (the )?(review|confirmation|tests|gate)\b|--dangerously"
        r"|auto[- ]?adopt|--yolo|\byolo\b")),
    ("secret-words", re.compile(r"(?i)\b(api[_ -]?key|token|password|passphrase|secret|credential)s?\b")),
)


def added_lines(live: str, proposed: str) -> list[tuple[int, str]]:
    """(line number in proposed, text) for every line the proposal adds or changes."""
    import difflib

    a, b = live.splitlines(), proposed.splitlines()
    out: list[tuple[int, str]] = []
    for tag, _i1, _i2, j1, j2 in difflib.SequenceMatcher(None, a, b, autojunk=False).get_opcodes():
        if tag in ("insert", "replace"):
            out.extend((j + 1, b[j]) for j in range(j1, j2))
    return out


def proposal_pairs(target: Path, live: Path | None = None) -> list[tuple[Path, Path | None]]:
    """(staged proposal, live file) pairs from a staging dir's manifest, or one file."""
    if target.is_file():
        return [(target, live)]
    manifest = _read_json(target / "manifest.json", {}) or {}
    pairs: list[tuple[Path, Path | None]] = []
    for row in manifest.get("skills") or []:
        if row.get("proposed_file"):
            lp = row.get("live_skill_path")
            pairs.append((target / str(row["proposed_file"]), Path(lp) if lp else None))
    for entry in (manifest.get("legacy") or {}).values():
        if isinstance(entry, dict) and entry.get("proposed_file"):
            lp = entry.get("live_path")
            pairs.append((target / str(entry["proposed_file"]), Path(lp) if lp else None))
    if not pairs:  # an unknown layout: check every staged markdown file in full
        pairs = [(f, None) for f in sorted(target.glob("proposed_*.md"))]
    return pairs


def preadopt_findings(target: Path, live: Path | None = None) -> list[dict[str, Any]]:
    findings = []
    for proposed, lp in proposal_pairs(target, live):
        try:
            new = proposed.read_text(errors="replace")
        except OSError:
            findings.append({"file": str(proposed), "line": 0, "kind": "unreadable", "text": ""})
            continue
        old = lp.read_text(errors="replace") if lp is not None and lp.exists() else ""
        for n, text in added_lines(old, new):
            for kind, pat in PREADOPT_FLAGS:
                if pat.search(text):
                    findings.append({"file": str(proposed), "live": str(lp) if lp else None,
                                     "line": n, "kind": kind, "text": text.strip()[:160]})
    return findings


def cmd_preadopt_check(args: argparse.Namespace) -> int:
    """Exit 0 when no added line is flagged, 1 when something needs djbclark's
    acknowledgement, 2 on a bad target. Prints the diff commands to show him."""
    if not args.target:
        print("skillopt-night: preadopt-check needs a staging dir or a proposal file", file=sys.stderr)
        return 2
    target = Path(args.target).expanduser()
    if not target.exists():
        print(f"skillopt-night: no such staging dir or file: {target}", file=sys.stderr)
        return 2
    live = Path(args.live).expanduser() if args.live else None
    for proposed, lp in proposal_pairs(target, live):
        print(f"diff: diff -u {lp or '/dev/null'} {proposed}")
    findings = preadopt_findings(target, live)
    for f in findings:
        print(f"FLAG {f['kind']:16} {f['file']}:{f['line']}: {f['text']}")
    print(f"preadopt-check: {len(findings)} flag(s)"
          + ("; show each to djbclark and adopt only with his explicit go" if findings else ""))
    return 1 if findings else 0


def cmd_chain_check(args: argparse.Namespace) -> int:
    night = load_night()
    print(f"chain: {night_path()} enabled={bool(night.get('enabled'))} "
          f"allow={night.get('allow') or DEFAULT_ALLOW} "
          f"perm={night.get('perm') or failover.DEFAULT_PERM} (entry perm overrides)")
    try:
        entries = load_entries(night)
    except failover.ChainError as e:
        print(f"chain refused: {e}")
        return 2
    if not entries:
        print("chain is empty")
        return 1
    rows = failover.check_table(entries, probe=args.probe)
    failover.print_table(rows, ["#", "label", "vendor", "pool", "pool_family",
                                "floor_percent", "perm", "ready", "why"])
    return 0 if any(r["ready"] == "yes" for r in rows) else 1


def cmd_sources(_args: argparse.Namespace) -> int:
    cfg = load_config()
    for s in SOURCES:
        where = "bin/skillopt_sources.py" if s in ADAPTER_SOURCES else str(source_root(s, cfg))
        print(f"{s:12} {'data' if source_present(s, cfg) else 'none':5} {where}")
    return 0


def _launchctl(*argv: str) -> int:
    return subprocess.run(["launchctl", *argv], check=False,
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode


def launch_agents() -> Path:
    return Path(os.environ.get("SKILLOPT_NIGHT_LAUNCH_AGENTS")
                or home() / "Library" / "LaunchAgents")


def cmd_install(_args: argparse.Namespace) -> int:
    dest = launch_agents() / PLIST_SRC.name
    domain = f"gui/{os.getuid()}"
    if os.environ.get("SKILLOPT_NIGHT_NO_INSTALL") == "1":
        print(f"would copy {PLIST_SRC} -> {dest}; launchctl bootstrap {domain} {dest}")
        return 0
    state_dir().mkdir(parents=True, exist_ok=True)
    dest.parent.mkdir(parents=True, exist_ok=True)
    tmp = dest.with_name(dest.name + ".tmp")
    shutil.copyfile(PLIST_SRC, tmp)
    os.replace(tmp, dest)
    _launchctl("bootout", f"{domain}/{LABEL}")
    rc = _launchctl("bootstrap", domain, str(dest))
    print(f"installed {dest}; bootstrap rc={rc}")
    return rc


def cmd_uninstall(_args: argparse.Namespace) -> int:
    dest = launch_agents() / PLIST_SRC.name
    domain = f"gui/{os.getuid()}"
    if os.environ.get("SKILLOPT_NIGHT_NO_INSTALL") == "1":
        print(f"would launchctl bootout {domain}/{LABEL}; remove {dest}")
        return 0
    _launchctl("bootout", f"{domain}/{LABEL}")
    with contextlib.suppress(FileNotFoundError):
        dest.unlink()
    print(f"removed {dest}")
    return 0


def parse_args(argv: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(prog="skillopt-night",
                                description="fleet-wide nightly SkillOpt-Sleep cycle")
    p.add_argument("command", nargs="?", default="night",
                   choices=["night", "chain-check", "preadopt-check", "sources", "install", "uninstall"])
    p.add_argument("target", nargs="?", help="preadopt-check: a staging dir or a proposal file")
    p.add_argument("--live", help="preadopt-check on one file: the live file it would replace")
    p.add_argument("--chain-check", action="store_true", help="same as the chain-check command")
    p.add_argument("--probe", action="store_true",
                   help="chain-check: also run probe preflights (crush; these call the model)")
    p.add_argument("--native", action="store_true",
                   help="opencode/claude entries use SkillOpt's own backend instead of acp-run "
                        "answers (native sources only)")
    p.add_argument("--dry-run", action="store_true",
                   help="skillopt-sleep dry-run --backend mock; never advances checkpoints")
    p.add_argument("--source", action="append", choices=list(SOURCES),
                   help="restrict to this source (repeatable)")
    p.add_argument("--timeout", type=int, default=0,
                   help="seconds per source attempt, all rounds (default: night.json "
                        f"source_timeout_s, else {DEFAULT_TIMEOUT_S})")
    p.add_argument("--max-sessions", type=int, default=0,
                   help="cap harvested sessions for this run (default: night.json max_sessions)")
    p.add_argument("--load-wait", type=int, default=DEFAULT_LOAD_WAIT_S,
                   help="seconds to wait for load to drop before skipping (default %(default)s)")
    args = p.parse_args(argv)
    if args.chain_check:
        args.command = "chain-check"
    return args


def main(argv: list[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    os.umask(0o077)  # logs, digests and handoff rounds hold transcript excerpts (L2)
    return {"night": cmd_night, "chain-check": cmd_chain_check, "sources": cmd_sources,
            "preadopt-check": cmd_preadopt_check,
            "install": cmd_install, "uninstall": cmd_uninstall}[args.command](args)


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""skillopt-night — the fleet-wide nightly SkillOpt-Sleep cycle for this Mac.

SkillOpt-Sleep (https://microsoft.github.io/SkillOpt/, `uv tool install` from
upstream main) mines past agent transcripts into tasks, replays them against the
current skills, and stages gated edits to SKILL.md / CLAUDE.md for review. Its
CLI handles one transcript source per run; this wrapper runs one stateful
`skillopt-sleep run --scope all` per source that has data on this Mac, in
sequence, under `nice`, with a bounded timeout each, staging everything under
~/src/djbclark-ade. docs/skillopt-sleep.md is the operator guide.

    skillopt-night                     # the nightly run (launchd, 03:30)
    skillopt-night --dry-run           # mock backend, never advances checkpoints
    skillopt-night --source claude     # restrict (repeatable)
    skillopt-night chain-check         # preflight the backend chain, print the table
    skillopt-night sources             # which sources have data here
    skillopt-night install             # copy + bootstrap the launchd plist
    skillopt-night uninstall           # bootout + remove the plist

**Backend: a failover chain, executed through acp-run.** SkillOpt's
`get_backend` is a fixed if-chain (an unknown name silently becomes the mock
backend), so no external backend can be registered without patching it. The
night therefore runs SkillOpt's `handoff` backend: the engine writes each round
of model calls to pending.json and exits 3; this runner answers every prompt
through one entry of the chain in ~/.skillopt-sleep/night.json (bin/failover.py:
acp-run in a clean empty dir with --perm deny, so each prompt gets a fresh
context, or an OpenAI-compatible POST for the SIPB endpoint) and reruns, until
the engine finishes. One entry answers a whole source night, so baseline and
candidate scores come from the same model. If an entry fails (preflight, an
answer, the run itself, or the night's diagnostics), the runner restores
state.json, wipes that source's handoff dir and reruns the source night on the
next entry; when none is left it records `chain_exhausted`.

Guards, in order:

1. A stateful night refuses unless night.json exists with `"enabled": true` and
   a non-empty chain: it prints "waiting for backend decision" and exits 0, so
   the launchd job stays inert until the operator approves the chain. A chain
   that violates policy (bin/failover.py DENY, the allowlist) is refused whole.
2. The load gate reuses `machine_overloaded()` from bin/acp-dispatch (load above
   4x CPUs or critical memory pressure); it waits up to --load-wait seconds,
   then skips the night.
3. One night at a time (an flock under the state dir).

Upstream keys the harvest checkpoint by project only, so a second source run in
the same night would see only sessions newer than the first run. This wrapper
keeps one cursor per source in cursors.json and swaps it into
~/.skillopt-sleep/state.json before each run. Upstream's codex harvester reads
only a flat ~/.codex/archived_sessions (Codex Desktop); Codex CLI keeps rollouts
in ~/.codex/sessions/YYYY/MM/DD, so the codex run gets a shim --codex-home whose
archived_sessions holds symlinks to every rollout. Upstream's handoff dir is per
project and is archived only when a night stages something, so each source gets
its own dir (SKILLOPT_SLEEP_HANDOFF_DIR) and the runner archives it after every
finished night.

Outputs: ~/.local/state/skillopt-sleep/<date>-<source>.log per run, one JSON
line per source night in nights.jsonl, every preflight/attempt in attempts.jsonl,
and at most one `hermes-ping` per event (proposals staged, chain exhausted,
chain invalid).

Test hooks (environment): SKILLOPT_NIGHT_STATE_DIR, SKILLOPT_NIGHT_BIN,
SKILLOPT_NIGHT_PING, SKILLOPT_NIGHT_LAUNCH_AGENTS, SKILLOPT_NIGHT_NO_INSTALL=1
(install/uninstall print the plan, change nothing), SKILLOPT_NIGHT_NO_GATE=1;
bin/failover.py reads FAILOVER_AIUSE_JSON, FAILOVER_ACP_RUN, FAILOVER_SECRETSPEC.
"""
from __future__ import annotations

import argparse
import contextlib
import fcntl
import importlib.machinery
import importlib.util
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
from datetime import datetime
from pathlib import Path
from typing import Any

REPO = Path(__file__).resolve().parent.parent
if str(REPO / "bin") not in sys.path:
    sys.path.insert(0, str(REPO / "bin"))
import failover
import skillopt_sources

LABEL = "com.djbclark.skillopt-sleep"
PLIST_SRC = REPO / "launchd" / f"{LABEL}.plist"
PREFERENCES = REPO / "docs" / "skillopt-preferences.md"
# Sources SkillOpt harvests natively (pi excluded by the operator, 2026-10-12) and the three
# this repo adapts (bin/skillopt_sources.py, fed to the handoff path as pinned digests).
NATIVE_SOURCES = ("claude", "codex", "cursor", "opencode", "copilot_cli")
ADAPTER_SOURCES = ("zcode", "agy", "crush")
SOURCES = NATIVE_SOURCES + ADAPTER_SOURCES
# Operator 2026-10-12 (approved chain): the only backends a night may use, and words no
# entry may contain (on top of failover.DENY: cursor, cline, clinepass, hermes, opus, fable).
DEFAULT_ALLOW = ["opencode", "agy", "zcode", "claude", "crush"]
NIGHT_DENY = (*failover.DENY, "muse", "pi", "grok", "codex", "copilot")
# Chain entries that SkillOpt can also drive with its own backend (--native).
NATIVE_BACKENDS = ("opencode", "claude")
DEFAULT_TIMEOUT_S = 5400
DEFAULT_LOAD_WAIT_S = 1800
DEFAULT_MAX_ROUNDS = 8
DEFAULT_JOBS = 2
GATE_LOAD_PER_CPU = 4  # same number as bin/acp-dispatch; used only if its import fails
PING = "~/.local/bin/hermes-ping"
REVIEW = "skillopt-sleep status --project ~/src/djbclark-ade"


def home() -> Path:
    return Path.home()


def state_dir() -> Path:
    return Path(os.environ.get("SKILLOPT_NIGHT_STATE_DIR")
                or home() / ".local" / "state" / "skillopt-sleep")


def skillopt_bin() -> str:
    return (os.environ.get("SKILLOPT_NIGHT_BIN") or shutil.which("skillopt-sleep")
            or str(home() / ".local" / "bin" / "skillopt-sleep"))


def config_path() -> Path:
    return home() / ".skillopt-sleep" / "config.json"


def night_path() -> Path:
    return home() / ".skillopt-sleep" / "night.json"


def sleep_state_path() -> Path:
    return home() / ".skillopt-sleep" / "state.json"


def handoff_dir(source: str) -> Path:
    return REPO / ".skillopt-sleep-handoff" / source


def load_config() -> dict[str, Any]:
    try:
        data = json.loads(config_path().read_text())
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def load_night() -> dict[str, Any]:
    try:
        data = json.loads(night_path().read_text())
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def load_entries(night: dict[str, Any]) -> list[failover.Entry]:
    return failover.load_chain(night.get("chain") or [],
                               allow=night.get("allow") or DEFAULT_ALLOW, deny=NIGHT_DENY)


# ── sources ──────────────────────────────────────────────────────────────────

def source_root(source: str, cfg: dict[str, Any]) -> Path:
    """The transcript store skillopt-sleep reads for this source on this Mac."""
    h = home()
    roots = {
        "claude": Path(cfg.get("claude_home") or h / ".claude") / "projects",
        "codex": Path(cfg.get("codex_home") or h / ".codex") / "sessions",
        "cursor": Path(cfg.get("cursor_home") or h / ".cursor") / "projects",
        "opencode": Path(cfg.get("opencode_db")
                         or h / ".local" / "share" / "opencode" / "opencode.db"),
        "copilot_cli": Path(cfg.get("copilot_cli_session_store")
                            or h / ".copilot" / "session-store.db"),
    }
    return Path(os.path.expanduser(str(roots[source])))


def has_data(root: Path) -> bool:
    if root.is_file():
        return root.stat().st_size > 0
    if root.is_dir():
        return any(root.iterdir())
    return False


def source_present(source: str, cfg: dict[str, Any]) -> bool:
    if source in ADAPTER_SOURCES:
        return skillopt_sources.store_present(source)
    return has_data(source_root(source, cfg))


def available_sources(cfg: dict[str, Any], only: list[str] | None = None) -> list[str]:
    wanted = only or list(SOURCES)
    return [s for s in SOURCES if s in wanted and source_present(s, cfg)]


def tool_python() -> str:
    """The skillopt uv tool's interpreter (its shebang), so adapters reuse upstream's
    redaction and replay filters; this interpreter as a fallback."""
    override = os.environ.get("SKILLOPT_NIGHT_TOOL_PYTHON")
    if override:
        return override
    try:
        first = Path(skillopt_bin()).read_text(errors="ignore").splitlines()[0]
        if first.startswith("#!") and "python" in first and Path(first[2:].strip()).exists():
            return first[2:].strip()
    except (OSError, IndexError):
        pass
    return sys.executable


def adapter_since(source: str, cfg: dict[str, Any]) -> str:
    """This source's cursor, else the configured first-night lookback (local time)."""
    cur = _read_json(state_dir() / "cursors.json", {}).get(source)
    if cur:
        return str(cur)
    hours = float(cfg.get("lookback_hours") or 72)
    return datetime.fromtimestamp(time.time() - hours * 3600).isoformat(timespec="seconds")


def adapter_digests(source: str, cfg: dict[str, Any], out: Path, limit: int) -> int:
    """Write SessionDigest JSON for an adapter source; return how many."""
    out.parent.mkdir(parents=True, exist_ok=True)
    proc = subprocess.run([tool_python(), "-I", str(REPO / "bin" / "skillopt_sources.py"), source,
                           "--since", adapter_since(source, cfg), "--limit", str(limit),
                           "--out", str(out)],
                          capture_output=True, text=True, timeout=1800, check=False)
    if proc.returncode != 0:
        raise RuntimeError(f"skillopt_sources {source} rc={proc.returncode}: {proc.stderr[-300:]}")
    data = _read_json(out, None)
    if isinstance(data, list):
        return len(data)
    raise RuntimeError(f"skillopt_sources {source} wrote no digest list")


def codex_shim(cfg: dict[str, Any]) -> Path:
    """A --codex-home whose archived_sessions links every Codex CLI rollout."""
    shim = state_dir() / "codex-home"
    arch = shim / "archived_sessions"
    arch.mkdir(parents=True, exist_ok=True)
    for old in arch.iterdir():
        if old.is_symlink():
            old.unlink()
    for path in sorted(source_root("codex", cfg).rglob("*.jsonl")):
        link = arch / path.name
        if not link.exists():
            link.symlink_to(path)
    return shim


# ── per-source harvest cursors ──────────────────────────────────────────────

def _read_json(path: Path, default: Any) -> Any:
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return default


def _write_json(path: Path, data: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(data, indent=2) + "\n")
    os.replace(tmp, path)


def swap_in_cursor(source: str, project: str) -> str | None:
    """Put this source's own cursor into state.json; return it."""
    cur = _read_json(state_dir() / "cursors.json", {}).get(source)
    sp = sleep_state_path()
    state = _read_json(sp, None)
    if state is None and cur is None:
        return None
    state = state if isinstance(state, dict) else {}
    lh = state.setdefault("last_harvest", {})
    if cur:
        lh[project] = cur
    else:
        lh.pop(project, None)
    _write_json(sp, state)
    return cur


def save_cursor(source: str, project: str, before: str | None) -> None:
    after = (_read_json(sleep_state_path(), {}) or {}).get("last_harvest", {}).get(project)
    if after and after != before:
        path = state_dir() / "cursors.json"
        cursors = _read_json(path, {})
        cursors[source] = after
        _write_json(path, cursors)


def snapshot_state() -> bytes | None:
    try:
        return sleep_state_path().read_bytes()
    except OSError:
        return None


def restore_state(snap: bytes | None) -> None:
    """Undo whatever a failed attempt did to state.json (night counter, history, cursor)."""
    sp = sleep_state_path()
    if snap is None:
        with contextlib.suppress(FileNotFoundError):
            sp.unlink()
        return
    tmp = sp.with_name(sp.name + ".tmp")
    tmp.write_bytes(snap)
    os.replace(tmp, sp)


# ── guards ───────────────────────────────────────────────────────────────────

def machine_overloaded() -> str | None:
    """bin/acp-dispatch's gate when importable, else the same load rule."""
    try:
        loader = importlib.machinery.SourceFileLoader(
            "acp_dispatch_gate", str(REPO / "bin" / "acp-dispatch"))
        spec = importlib.util.spec_from_loader("acp_dispatch_gate", loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        return mod.machine_overloaded()
    except Exception:  # noqa: BLE001 - any import failure falls back to the plain check
        load1 = os.getloadavg()[0]
        ncpu = os.cpu_count() or 8
        if load1 > GATE_LOAD_PER_CPU * ncpu:
            return f"load {load1:.0f} > {GATE_LOAD_PER_CPU}x{ncpu} cpus"
        return None


def wait_for_capacity(max_wait: int) -> str | None:
    """None when the machine has room; else why, after waiting up to max_wait."""
    if os.environ.get("SKILLOPT_NIGHT_NO_GATE") == "1":
        return None
    start = time.monotonic()
    why = machine_overloaded()
    while why and time.monotonic() - start < max_wait:
        time.sleep(60)
        why = machine_overloaded()
    return why


# ── one skillopt-sleep invocation ────────────────────────────────────────────

def preferences_text() -> str:
    try:
        return PREFERENCES.read_text().strip()
    except OSError:
        return ""


def build_command(source: str, *, dry_run: bool, cfg: dict[str, Any],
                  codex_home: Path | None = None, backend: str | None = None,
                  model: str = "", max_sessions: int = 0) -> list[str]:
    """backend None: mock for a dry-run, handoff otherwise. An adapter source runs as
    `--source opencode --opencode-db :memory:` (harvests nothing by construction); its
    sessions arrive as the handoff dir's pinned digests.json."""
    backend = backend or ("mock" if dry_run else "handoff")
    cli_source = ["opencode", "--opencode-db", ":memory:"] if source in ADAPTER_SOURCES else [source]
    cmd = ["nice", "-n", "10", skillopt_bin(), "dry-run" if dry_run else "run",
           "--project", str(REPO), "--scope", "all", "--source", *cli_source,
           "--skill-root", str(REPO / "skills"), "--progress", "--json", "--backend", backend]
    if model:
        cmd += ["--model", model]
    if source == "codex" and codex_home is not None:
        cmd += ["--codex-home", str(codex_home)]
    if max_sessions and not dry_run:
        # Each harvested session costs one LLM-mining prompt (one agent spawn) in round 1.
        cmd += ["--max-sessions", str(max_sessions)]
    prefs = preferences_text()
    if prefs:
        cmd += ["--preferences", prefs]
    return cmd


def parse_result(stdout: str) -> dict[str, Any]:
    """The JSON object skillopt-sleep prints last on stdout ({} if none)."""
    start = stdout.rfind("\n{")
    start = 0 if stdout.startswith("{") and start < 0 else start + 1
    try:
        data = json.loads(stdout[start:]) if start >= 0 else {}
    except ValueError:
        return {}
    return data if isinstance(data, dict) else {}


def n_proposals(result: dict[str, Any]) -> int:
    staged = result.get("staged_skills") or []
    if staged:
        return len(staged)
    return 1 if result.get("staging_dir") else 0


def invoke(cmd: list[str], *, log: Path, env: dict[str, str], timeout: float) -> tuple[int, str]:
    shown = list(cmd)
    if "--preferences" in shown:
        shown[shown.index("--preferences") + 1] = "<docs/skillopt-preferences.md>"
    with open(log, "a") as lf:
        lf.write(f"\n== {datetime.now().isoformat(timespec='seconds')} {' '.join(shown)}\n")
        lf.flush()
        try:
            proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=lf, stdin=subprocess.DEVNULL,
                                  text=True, env=env, cwd=str(REPO), timeout=max(1, timeout),
                                  check=False)
            rc, stdout = proc.returncode, proc.stdout or ""
        except subprocess.TimeoutExpired as e:
            rc = 124
            stdout = e.stdout.decode() if isinstance(e.stdout, bytes) else (e.stdout or "")
        lf.write(stdout)
        lf.write(f"\n== rc={rc}\n")
    return rc, stdout


def night_failure(rc: int, result: dict[str, Any]) -> str | None:
    """Why a finished night does not count as the backend answering, or None."""
    if rc != 0:
        return f"skillopt-sleep rc={rc}"
    if result.get("ok") is False:
        return f"skillopt-sleep error: {result.get('error')}: {str(result.get('message'))[:200]}"
    staging = result.get("staging_dir")
    if staging:
        diag = Path(staging) / "diagnostics.json"
        text = diag.read_text(errors="ignore") if diag.exists() else ""
        if "empty response on all" in text:
            return "diagnostics: empty response on all attempts"
        data = _read_json(diag, {}) if text else {}
        for key in ("call_error", "last_call_error"):
            if isinstance(data, dict) and str(data.get(key) or "").strip():
                return f"diagnostics: {key}: {str(data[key])[:200]}"
        report = _read_json(Path(staging) / "report.json", {})
        if isinstance(report, dict) and report.get("n_tasks") and report.get("n_replayed") == 0:
            return "tasks were mined but none was replayed"
    return None


def reset_dir(path: Path) -> None:
    shutil.rmtree(path, ignore_errors=True)


def archive_handoff(source: str) -> None:
    """Move a finished night's handoff dir aside (upstream keeps it when nothing staged)."""
    hdir = handoff_dir(source)
    if not hdir.exists():
        return
    arch = state_dir() / "handoff-archive"
    arch.mkdir(parents=True, exist_ok=True)
    shutil.move(str(hdir), str(arch / f"{source}-{datetime.now():%Y%m%d-%H%M%S}"))
    for old in sorted(arch.iterdir())[:-10]:  # keep the last ten rounds; they hold transcript excerpts
        shutil.rmtree(old, ignore_errors=True)


def answer_pending(entry: failover.Entry, hdir: Path, jobs: int) -> int:
    """Answer every prompt in pending.json on this entry; return how many."""
    data = _read_json(hdir / "pending.json", {})
    pending = data.get("pending") if isinstance(data, dict) else None
    if not pending:
        raise failover.AttemptFailed("handoff exit 3 with no pending prompts")
    prompts = {str(p["id"]): str(p["prompt"]) for p in pending}
    answers = failover.ask_many(entry, prompts, jobs=jobs)
    adir = hdir / "answers"
    adir.mkdir(parents=True, exist_ok=True)
    for key, text in answers.items():
        (adir / f"{key}.md").write_text(text)
    return len(answers)


def record(row: dict[str, Any]) -> None:
    sd = state_dir()
    sd.mkdir(parents=True, exist_ok=True)
    row = {"at": datetime.now().isoformat(timespec="seconds"), **row}
    with open(sd / "nights.jsonl", "a") as f:
        f.write(json.dumps(row) + "\n")


def ping(line: str) -> None:
    exe = os.path.expanduser(os.environ.get("SKILLOPT_NIGHT_PING") or PING)
    try:
        subprocess.run([exe, line], timeout=60, check=False,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        pass


def log_path(source: str, dry_run: bool) -> Path:
    sd = state_dir()
    sd.mkdir(parents=True, exist_ok=True)
    return sd / f"{datetime.now():%Y-%m-%d}-{source}{'-dry' if dry_run else ''}.log"


def run_dry(source: str, *, cfg: dict[str, Any], timeout: int, limit: int = 120) -> dict[str, Any]:
    if source in ADAPTER_SOURCES:
        return run_dry_adapter(source, cfg=cfg, timeout=timeout, limit=limit)
    shim = codex_shim(cfg) if source == "codex" else None
    cmd = build_command(source, dry_run=True, cfg=cfg, codex_home=shim)
    swap_in_cursor(source, str(REPO))
    log = log_path(source, True)
    rc, stdout = invoke(cmd, log=log, env=dict(os.environ), timeout=timeout)
    result = parse_result(stdout)
    row = {"source": source, "mode": "dry-run", "rc": rc, "ok": rc == 0,
           "sessions": result.get("n_sessions"),
           "tasks": result.get("n_tasks"), "accepted": result.get("accepted"),
           "gate": result.get("gate_action") or None, "proposals": n_proposals(result),
           "staging_dir": result.get("staging_dir") or None, "log": str(log)}
    record(row)
    return row


def run_dry_adapter(source: str, *, cfg: dict[str, Any], timeout: int, limit: int) -> dict[str, Any]:
    """Adapter sources have no mock path (pinned digests load only through handoff): a
    handoff dry-run in a throwaway dir makes no model calls and saves no state; it exits 3
    with the round-1 prompts, which are counted and discarded."""
    log = log_path(source, True)
    with tempfile.TemporaryDirectory(prefix=f"skillopt-dry-{source}-") as tmp:
        hdir = Path(tmp) / "handoff"
        try:
            n = adapter_digests(source, cfg, hdir / "digests.json", limit)
        except (RuntimeError, OSError, subprocess.SubprocessError) as e:
            row = {"source": source, "mode": "dry-run", "rc": None, "ok": False,
                   "status": "adapter-failed", "why": str(e)[:300], "log": str(log)}
            record(row)
            return row
        cmd = build_command(source, dry_run=True, cfg=cfg, backend="handoff")
        rc, stdout = invoke(cmd, log=log, timeout=timeout,
                            env={**os.environ, "SKILLOPT_SLEEP_HANDOFF_DIR": str(hdir)})
        pending = _read_json(hdir / "pending.json", {})
        n_pending = len(pending.get("pending") or []) if isinstance(pending, dict) else 0
    result = parse_result(stdout)
    row = {"source": source, "mode": "dry-run", "rc": rc, "ok": rc in (0, 3), "sessions": n,
           "tasks": result.get("n_tasks"), "pending_prompts": n_pending, "proposals": 0,
           "log": str(log)}
    record(row)
    return row


def run_source_chain(source: str, entries: list[failover.Entry], *, cfg: dict[str, Any],
                     timeout: int, max_rounds: int, jobs: int,
                     max_sessions: int = 0, native: bool = False) -> dict[str, Any]:
    """One stateful source night through the chain; returns its nights.jsonl row."""
    project = str(REPO)
    log = log_path(source, False)
    hdir = handoff_dir(source)
    shim = codex_shim(cfg) if source == "codex" else None
    env = {**os.environ, "SKILLOPT_SLEEP_HANDOFF_DIR": str(hdir)}
    pinned: Path | None = None
    if source in ADAPTER_SOURCES:
        pinned = state_dir() / f"digests-{source}.json"
        try:
            adapter_digests(source, cfg, pinned, max_sessions or 120)
        except (RuntimeError, OSError, subprocess.SubprocessError) as e:
            row = {"source": source, "mode": "run", "status": "adapter-failed",
                   "why": str(e)[:300], "proposals": 0, "log": str(log)}
            record(row)
            return row

    def attempt(entry: failover.Entry) -> dict[str, Any]:
        snap = snapshot_state()
        before = swap_in_cursor(source, project)
        reset_dir(hdir)
        if pinned is not None:
            hdir.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(pinned, hdir / "digests.json")
        use_native = native and pinned is None and entry.tui.name in NATIVE_BACKENDS
        cmd = build_command(source, dry_run=False, cfg=cfg, codex_home=shim,
                            max_sessions=max_sessions,
                            backend=entry.tui.name if use_native else "handoff",
                            model=entry.native_model if use_native else "")
        deadline = time.monotonic() + timeout
        rounds = answered = 0
        try:
            with open(log, "a") as lf:
                lf.write(f"\n== attempt on {entry.label}{' (native backend)' if use_native else ''}\n")
            while True:
                rounds += 1
                rc, stdout = invoke(cmd, log=log, env=env, timeout=deadline - time.monotonic())
                if rc != 3:
                    break
                if rounds >= max_rounds:
                    raise failover.AttemptFailed(f"still pending after {rounds} rounds")
                if time.monotonic() >= deadline:
                    raise failover.AttemptFailed(f"timeout after {rounds} rounds")
                answered += answer_pending(entry, hdir, jobs)
            result = parse_result(stdout)
            why = night_failure(rc, result)
            if why:
                raise failover.AttemptFailed(why)
        except failover.AttemptFailed:
            restore_state(snap)
            reset_dir(hdir)
            raise
        save_cursor(source, project, before)
        archive_handoff(source)
        return {"rc": rc, "result": result, "rounds": rounds, "answered": answered}

    res = failover.run_chain(entries, attempt, task=f"skillopt-night {source}",
                             log_path=state_dir() / "attempts.jsonl")
    failed = [f"{r['label']}: {r['why']}" for r in res.attempts if not r["ok"]]
    if not res.ok:
        row = {"source": source, "mode": "run", "status": "chain_exhausted", "rc": None,
               "proposals": 0, "failed": failed, "log": str(log)}
    else:
        v, result = res.value, res.value["result"]
        row = {"source": source, "mode": "run", "status": "ok", "entry": res.entry.label,
               "rc": v["rc"], "rounds": v["rounds"], "answered": v["answered"],
               "sessions": result.get("n_sessions"), "tasks": result.get("n_tasks"),
               "accepted": result.get("accepted"), "gate": result.get("gate_action") or None,
               "proposals": n_proposals(result), "staging_dir": result.get("staging_dir") or None,
               "failed": failed, "log": str(log)}
    if pinned is not None:
        pinned.unlink(missing_ok=True)  # transcript excerpts; the night's own copy is archived
    record(row)
    return row


# ── commands ─────────────────────────────────────────────────────────────────

def cmd_night(args: argparse.Namespace) -> int:
    cfg = load_config()
    sources = available_sources(cfg, args.source)
    entries: list[failover.Entry] = []
    night = load_night()
    if not args.dry_run:
        if not night.get("enabled") or not night.get("chain"):
            print("skillopt-night: waiting for backend decision (no enabled chain in "
                  f"{night_path()}); run `skillopt-night --dry-run` (see docs/skillopt-sleep.md)")
            record({"mode": "run", "status": "waiting-backend"})
            return 0
        try:
            entries = load_entries(night)
        except failover.ChainError as e:
            print(f"skillopt-night: chain refused: {e}", file=sys.stderr)
            record({"mode": "run", "status": "chain-invalid", "why": str(e)})
            ping(f"djbclark-ade: skillopt-sleep chain refused ({e}); fix {night_path()}")
            return 1
    if not sources:
        print("skillopt-night: no transcript source with data", file=sys.stderr)
        return 0
    sd = state_dir()
    sd.mkdir(parents=True, exist_ok=True)
    with open(sd / "night.lock", "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            print("skillopt-night: another night is running", file=sys.stderr)
            return 0
        why = wait_for_capacity(args.load_wait)
        if why:
            print(f"skillopt-night: skipped, machine overloaded ({why})", file=sys.stderr)
            record({"mode": "dry-run" if args.dry_run else "run", "status": f"skipped: {why}"})
            return 0
        if args.dry_run:
            rows = [run_dry(s, cfg=cfg, timeout=args.timeout or DEFAULT_TIMEOUT_S,
                            limit=args.max_sessions or int(night.get("max_sessions") or 120))
                    for s in sources]
        else:
            timeout = args.timeout or int(night.get("source_timeout_s", DEFAULT_TIMEOUT_S))
            rows = [run_source_chain(s, entries, cfg=cfg, timeout=timeout,
                                     max_rounds=int(night.get("max_rounds", DEFAULT_MAX_ROUNDS)),
                                     jobs=int(night.get("jobs", DEFAULT_JOBS)),
                                     max_sessions=args.max_sessions or int(night.get("max_sessions", 0)),
                                     native=args.native)
                    for s in sources]
    for r in rows:
        print(f"{r['source']:12} {r.get('status', 'ok'):15} entry={r.get('entry', '-')} "
              f"rc={r.get('rc')} sessions={r.get('sessions')} tasks={r.get('tasks')} "
              f"pending={r.get('pending_prompts', '-')} "
              f"gate={r.get('gate')} proposals={r.get('proposals')} log={r['log']}")
    if args.dry_run:
        return 0 if all(r.get("ok") for r in rows) else 1
    staged = [r for r in rows if r.get("proposals")]
    if staged:
        n = sum(r["proposals"] for r in staged)
        ping(f"djbclark-ade: skillopt-sleep staged {n} proposal(s) from "
             f"{','.join(r['source'] for r in staged)}; review: {REVIEW}")
    exhausted = [r for r in rows if r.get("status") == "chain_exhausted"]
    if exhausted:
        ping(f"djbclark-ade: skillopt-sleep chain exhausted for "
             f"{','.join(r['source'] for r in exhausted)}; see {sd}/attempts.jsonl")
    return 0 if not exhausted else 1


def cmd_chain_check(args: argparse.Namespace) -> int:
    night = load_night()
    print(f"chain: {night_path()} enabled={bool(night.get('enabled'))} "
          f"allow={night.get('allow') or DEFAULT_ALLOW}")
    try:
        entries = load_entries(night)
    except failover.ChainError as e:
        print(f"chain refused: {e}")
        return 2
    if not entries:
        print("chain is empty")
        return 1
    rows = failover.check_table(entries, probe=args.probe)
    failover.print_table(rows, ["#", "label", "vendor", "pool", "pool_family",
                                "floor_percent", "ready", "why"])
    return 0 if any(r["ready"] == "yes" for r in rows) else 1


def cmd_sources(_args: argparse.Namespace) -> int:
    cfg = load_config()
    for s in SOURCES:
        where = "bin/skillopt_sources.py" if s in ADAPTER_SOURCES else str(source_root(s, cfg))
        print(f"{s:12} {'data' if source_present(s, cfg) else 'none':5} {where}")
    return 0


def _launchctl(*argv: str) -> int:
    return subprocess.run(["launchctl", *argv], check=False,
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode


def launch_agents() -> Path:
    return Path(os.environ.get("SKILLOPT_NIGHT_LAUNCH_AGENTS")
                or home() / "Library" / "LaunchAgents")


def cmd_install(_args: argparse.Namespace) -> int:
    dest = launch_agents() / PLIST_SRC.name
    domain = f"gui/{os.getuid()}"
    if os.environ.get("SKILLOPT_NIGHT_NO_INSTALL") == "1":
        print(f"would copy {PLIST_SRC} -> {dest}; launchctl bootstrap {domain} {dest}")
        return 0
    state_dir().mkdir(parents=True, exist_ok=True)
    dest.parent.mkdir(parents=True, exist_ok=True)
    tmp = dest.with_name(dest.name + ".tmp")
    shutil.copyfile(PLIST_SRC, tmp)
    os.replace(tmp, dest)
    _launchctl("bootout", f"{domain}/{LABEL}")
    rc = _launchctl("bootstrap", domain, str(dest))
    print(f"installed {dest}; bootstrap rc={rc}")
    return rc


def cmd_uninstall(_args: argparse.Namespace) -> int:
    dest = launch_agents() / PLIST_SRC.name
    domain = f"gui/{os.getuid()}"
    if os.environ.get("SKILLOPT_NIGHT_NO_INSTALL") == "1":
        print(f"would launchctl bootout {domain}/{LABEL}; remove {dest}")
        return 0
    _launchctl("bootout", f"{domain}/{LABEL}")
    with contextlib.suppress(FileNotFoundError):
        dest.unlink()
    print(f"removed {dest}")
    return 0


def parse_args(argv: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(prog="skillopt-night",
                                description="fleet-wide nightly SkillOpt-Sleep cycle")
    p.add_argument("command", nargs="?", default="night",
                   choices=["night", "chain-check", "sources", "install", "uninstall"])
    p.add_argument("--chain-check", action="store_true", help="same as the chain-check command")
    p.add_argument("--probe", action="store_true",
                   help="chain-check: also run probe preflights (crush; these call the model)")
    p.add_argument("--native", action="store_true",
                   help="opencode/claude entries use SkillOpt's own backend instead of acp-run "
                        "answers (native sources only)")
    p.add_argument("--dry-run", action="store_true",
                   help="skillopt-sleep dry-run --backend mock; never advances checkpoints")
    p.add_argument("--source", action="append", choices=list(SOURCES),
                   help="restrict to this source (repeatable)")
    p.add_argument("--timeout", type=int, default=0,
                   help="seconds per source attempt, all rounds (default: night.json "
                        f"source_timeout_s, else {DEFAULT_TIMEOUT_S})")
    p.add_argument("--max-sessions", type=int, default=0,
                   help="cap harvested sessions for this run (default: night.json max_sessions)")
    p.add_argument("--load-wait", type=int, default=DEFAULT_LOAD_WAIT_S,
                   help="seconds to wait for load to drop before skipping (default %(default)s)")
    args = p.parse_args(argv)
    if args.chain_check:
        args.command = "chain-check"
    return args


def main(argv: list[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    return {"night": cmd_night, "chain-check": cmd_chain_check, "sources": cmd_sources,
            "install": cmd_install, "uninstall": cmd_uninstall}[args.command](args)


if __name__ == "__main__":
    sys.exit(main())

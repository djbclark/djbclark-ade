#!/usr/bin/env -S python3 -I
"""claude-quota-guard: turn the Claude quota reading into a level that sessions act on.

Why (2026-10-20): the Claude Code weekly window hit 100% at 17:07Z, 2.6 days before its
reset, and every orchestrating session stopped. aiuse had carried a `conserve` alert for
provider `claude` since 06:02Z ("projected to run out ~1 day before reset (34% left)"), but
nothing read it, nothing pinged and no session downshifted. This guard reads aiuse's cache
(no live probe), derives a level, writes ~/.local/state/ade/quota-guard.json for the
UserPromptSubmit hook claude/hooks/quota_nudge.py, and pings once per upward crossing.

  claude-quota-guard [check]       probe, write the state file, ping on a rise; exit code = level
  claude-quota-guard status [--json]   print the state file, no probing
  claude-quota-guard --install     write the launchd job (every 15 min) and print the
                                   `launchctl bootstrap` line; never runs launchctl itself

Levels and exit codes: 0 ok, 1 watch, 2 tight, 3 critical, 10 aiuse could not be read (level
fields left untouched; see below), 64 bad CLAUDE_QUOTA_GUARD_THRESHOLDS, 69 `--install` off macOS (launchd
only; run `check` every 15 min from a systemd user timer or cron instead). The binding window
is the lowest `remaining_percent` among the Claude rows' windows (weekly, 5-hour and Fable's
sublimit):
  watch    weekly left < 40, Fable sublimit left < 15, or any Claude `conserve` alert
  tight    weekly left < 30, or a `conserve` alert on a weekly window that says "projected to
           run out ... before reset" (matched against the weekly windows' own labels, so a
           Fable-cap alert never counts; ignored altogether while that window has
           `pace_early: true`, since early in a window the projection swings wildly)
  critical weekly left < 15, 5-hour left < 10, a Claude account with `usable_now: false` or an
           exhausted weekly / 5-hour window, or aiuse exit 3 with no Claude row
`aiuse --available` drops every pool with `usable_now: false`, so an exhausted Claude is an
absent row (exit 0): the windows then come from the payload's top-level `excluded[]` (an
operator exclusion) or the newest snapshot's `accounts[]`; a snapshot-only Claude is `critical`
when blocked and at least `watch` otherwise (state `source` "snapshot-only": aiuse dropped it
for a reason the snapshot predates). aiuse also drops the Fable pool when the Fable cap is
exhausted: the Fable window is then read from the snapshot (exhausted = 0% left = `watch`).
A live `available` Claude row without `windows[]` is judged by its own `headroom_percent` /
`binding_window` / `usable_now`, and counts beside rows that do have windows (a summary-only
Fable row never hides). aiuse exit 3 is `critical` even when the snapshot looks healthy.
Exit 10 when Claude appears nowhere, on any malformed aiuse or snapshot data (a present
`available` / `excluded` / `accounts` / `alerts` that is not a list of objects, or holds a
non-object item; a present `windows` that is not a list of objects; a newest snapshot file that
does not parse or is not an object; an omitted key is empty and a missing snapshot directory or
no files is "no snapshot"), or when another
check holds <state>.lock for about 5 s. What exit 10 does to the state: the level, advice and
number fields are left exactly as they were (a failed read never writes a level), but a read
that fails after the lock was taken records the episode in three bookkeeping fields,
`unreadable_since` (first failing run), `last_unreadable_at` (every failing run) and
`last_unreadable_pinged_at`; the second failing run
in a row sends ONE ping "Claude quota guard cannot read aiuse: <reason> (every run since
<unreadable_since>)" per episode, and the next good read clears all three. (A held lock records
nothing.) The hook prints "[quota-guard unreadable]" once per session only after that ping was
sent AND the guard failed again within the last 2 h (a stopped guard or a one-off hiccup prints
nothing). One `hermes-ping` per level per reset period (the mark
survives level drops; a new weekly `resets_at` clears it). Data older than 3 h (the oldest of
the payload's `age_seconds`, every row that fed the decision (judged rows and any snapshot rows
whose lowest Fable, borrowed or display windows were used) by `age_seconds` / `collected_at`, and the
snapshot mtime: a dead collector) sets `stale: true` ("(stale)" in the human line), raises the
level to at least `watch` with the advice "aiuse data <age> old: collector down? run `aiuse
--live --json`", suppresses level pings, and sends ONE ping per stale episode (mark
`last_stale_pinged_at`, cleared when the data is fresh again). `check` holds a flock on
<state>.lock, saves
the state before it pings and records the ping afterwards (a ping cut off by a kill is retried
next run: at least once).
Thresholds live in THRESHOLDS; env CLAUDE_QUOTA_GUARD_THRESHOLDS (JSON) overrides keys.

Env (tests): CLAUDE_QUOTA_GUARD_AIUSE (default ~/.local/bin/aiuse), _SNAPSHOTS (default
~/.cache/aiuse/snapshots), _STATE (default ~/.local/state/ade/quota-guard.json), _PING
(default ~/.local/bin/hermes-ping), _LAUNCH_AGENTS (default ~/Library/LaunchAgents), _NOW
(ISO time standing in for the clock).
"""
from __future__ import annotations

import argparse
import contextlib
import fcntl
import json
import math
import os
import plistlib
import re
import shlex
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timezone
from pathlib import Path

HOME = Path.home()
LABEL = "com.djbclark.claude-quota-guard"
INTERVAL_SECONDS = 15 * 60  # aiuse's collector is hourly; the guard only reads its cache

THRESHOLDS = {
    "watch_weekly": 40.0,       # weekly left below this -> watch
    "tight_weekly": 30.0,       # -> tight
    "critical_weekly": 15.0,    # -> critical
    "critical_five_hour": 10.0,  # 5-hour left below this -> critical
    "watch_fable": 15.0,        # Fable sublimit left below this -> watch (advice already bans Fable)
    "alert_max_age_s": 21600.0,  # ignore snapshot alerts older than this (aiuse's own rows are fresher)
    "period_tolerance_s": 7200.0,  # two resets_at this close are the same reset period (clock jitter)
    "aiuse_timeout_s": 90.0,
    "ping_timeout_s": 30.0,
    "stale_age_s": 10800.0,     # data older than this (dead collector): reported "(stale)", never pinged
    "lock_retries": 10.0,       # non-blocking flock attempts ...
    "lock_wait_s": 0.5,         # ... this far apart, then exit 10 "another check holds the lock"
}

LEVELS = ("ok", "watch", "tight", "critical")
EXIT_CODES = {"ok": 0, "watch": 1, "tight": 2, "critical": 3}
EX_UNREADABLE = 10
EX_CONFIG = 64  # bad CLAUDE_QUOTA_GUARD_THRESHOLDS: never 1-3, which mean watch/tight/critical
EX_NO_LAUNCHD = 69  # --install off macOS (EX_UNAVAILABLE)
AIUSE_NOTHING_USABLE = 3


class ConfigError(Exception):
    pass

_SELF_SLASH = ("`~/src/djbclark-ade/bin/self-slash --finish --successor claude/claude-sonnet-5-5 "
               "--thinking high`")
_ADVERSARY = "`acp-dispatch omp --model anthropic/claude-opus-5-5 --kind judgment --effort high`"
_RUNNING_PROJECTED = re.compile(r"projected to run out.*before reset", re.I | re.S)


def _advice(level: str, resets_at: str | None, source: str = "available",
            stale_age: float | None = None) -> str:
    if level == "ok":
        return ""
    items = [
        "Claude quota watch: no Fable or Opus Agent-tool sub-agents.",
        f"Adversary rounds via {_ADVERSARY}.",
        "Route code/bulk slices to other pools.",
    ]
    if level in ("tight", "critical"):
        items[0] = "Claude quota tight: no Fable or Opus Agent-tool sub-agents."
        items += [
            f"A lead on Opus or Fable hands off now and continues on Sonnet 5.5 high: {_SELF_SLASH} "
            "(Paseo; herdr/Orca: handoff then relaunch on Sonnet).",
            "No `acp-dispatch claude` slices.",
        ]
    if level == "critical":
        items[0] = "Claude quota critical: no Fable or Opus Agent-tool sub-agents."
        # aiuse rate-gates omp (it spends through the Claude account) while every Claude weekly
        # window is exhausted: the main critical case.
        items[1] = (f"Adversary rounds via {_ADVERSARY}, only while `aiuse --available --json` "
                    "still lists omp (it is rate-gated when every Claude weekly window is exhausted).")
        items.append(f"No new Claude work of any kind until the reset at {resets_at or 'unknown'}; "
                     "finish the running turn, hand off, stop.")
    if source == "snapshot-only":
        items.append("aiuse dropped Claude from --available: a live 429 or a note; "
                     "re-check `aiuse --available --json`.")
    if stale_age is not None:
        items.append(f"aiuse data {_age_short(stale_age)} old: collector down? run `aiuse --live --json`.")
    return "\n".join(f"{i}. {t}" for i, t in enumerate(items, 1))


# -- paths and environment -------------------------------------------------

def _path(env: str, default: Path) -> Path:
    return Path(os.environ.get(env) or default).expanduser()


def state_path() -> Path:
    return _path("CLAUDE_QUOTA_GUARD_STATE", HOME / ".local/state/ade/quota-guard.json")


def thresholds() -> dict:
    t = dict(THRESHOLDS)
    raw = os.environ.get("CLAUDE_QUOTA_GUARD_THRESHOLDS")
    if raw:
        try:
            over = json.loads(raw)
        except json.JSONDecodeError as e:
            raise ConfigError(f"CLAUDE_QUOTA_GUARD_THRESHOLDS is not JSON: {e}")
        if not isinstance(over, dict):
            raise ConfigError("CLAUDE_QUOTA_GUARD_THRESHOLDS must be a JSON object")
        for k, v in over.items():
            if k not in t or not isinstance(v, (int, float)) or isinstance(v, bool) or not math.isfinite(v):
                raise ConfigError(f"unknown or non-numeric threshold {k!r}")
            t[k] = float(v)
    return t


def now() -> datetime:
    raw = os.environ.get("CLAUDE_QUOTA_GUARD_NOW")
    if raw:
        return _parse_ts(raw) or datetime.now(timezone.utc)
    return datetime.now(timezone.utc)


def _parse_ts(text) -> datetime | None:
    if not isinstance(text, str) or not text:
        return None
    try:
        d = datetime.fromisoformat(text.replace("Z", "+00:00"))
    except ValueError:
        return None
    return d if d.tzinfo else d.replace(tzinfo=timezone.utc)


def _iso(d: datetime) -> str:
    return d.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _num(v) -> float | None:
    return float(v) if isinstance(v, (int, float)) and not isinstance(v, bool) and math.isfinite(v) else None


# -- reading aiuse ---------------------------------------------------------

class Unreadable(Exception):
    pass


def read_aiuse() -> tuple[int, dict]:
    """(exit code, parsed JSON) of `aiuse --available --json`. Raises Unreadable."""
    exe = str(_path("CLAUDE_QUOTA_GUARD_AIUSE", HOME / ".local/bin/aiuse"))
    try:
        p = subprocess.run([exe, "--available", "--json"], capture_output=True, text=True,
                           timeout=thresholds()["aiuse_timeout_s"], check=False, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError) as e:
        raise Unreadable(f"could not run {exe}: {e}")
    if p.returncode not in (0, AIUSE_NOTHING_USABLE):
        raise Unreadable(f"{exe} exited {p.returncode}: {(p.stderr or p.stdout).strip()[:300]}")
    try:
        data = json.loads(p.stdout) if p.stdout.strip() else {}
    except json.JSONDecodeError as e:
        if p.returncode == AIUSE_NOTHING_USABLE:
            data = {}  # exit 3 may print only prose; the exit code is the verdict
        else:
            raise Unreadable(f"{exe} printed invalid JSON: {e}")
    if not isinstance(data, dict):
        if p.returncode == AIUSE_NOTHING_USABLE:
            return p.returncode, {}  # exit 3 is the verdict whatever else it printed (`[]`, a string...)
        raise Unreadable(f"{exe} printed JSON that is not an object")
    return p.returncode, data


def _rows(container, key: str, where: str = "the aiuse data") -> list[dict]:
    """Claude rows (dicts with provider == claude) under container[key].

    An omitted key (or a container that is not an object) is empty. A PRESENT value that is not a
    list, or a list holding an item that is not an object, is malformed: Unreadable naming the key
    and `where` (exit 10), so corrupt output can never read as "nothing there" (no alerts, no
    Fable fallback, no Claude row) and then `ok`."""
    if not isinstance(container, dict) or key not in container:
        return []
    items = container[key]
    if not isinstance(items, list) or not all(isinstance(r, dict) for r in items):
        raise Unreadable(f"malformed `{key}` in {where}: not a list of objects")
    return [r for r in items if r.get("provider") == "claude"]


def claude_windows(rows: list[dict]) -> list[dict]:
    """Every window of the given Claude rows, tagged weekly / five_hour / fable.

    `resets_at` is normalised through _parse_ts here, so nothing aiuse printed in that field
    reaches the advice text, the state file or the hook's stdout (an unparsable value is None)."""
    out = []
    for row in rows:
        windows = row.get("windows")
        for w in windows if isinstance(windows, list) else []:
            if not isinstance(w, dict):
                continue
            label = str(w.get("label") or w.get("window_label") or "")
            low = label.lower()
            left = _num(w.get("remaining_percent"))
            if left is None and _num(w.get("used_percent")) is not None:
                left = 100.0 - _num(w.get("used_percent"))
            if left is None:
                continue
            fable = "fable" in low or w.get("pool_family") == "fable" or w.get("quota_scope") == "model_sublimit"
            if fable:
                kind = "fable"
            elif "5-hour" in low or "5 hour" in low or w.get("window_minutes") == 300:
                kind = "five_hour"
            elif "weekly" in low or w.get("window_minutes") == 10080:
                kind = "weekly"
            else:
                continue
            reset = _parse_ts(w.get("resets_at"))
            out.append({"kind": kind, "label": label,
                        # an exhausted Fable cap is 0% left whatever the rounded number says
                        "left": 0.0 if kind == "fable" and w.get("state") == "exhausted" else left,
                        "resets_at": _iso(reset) if reset else None,
                        "pace": _num(w.get("pace_percent")),
                        "pace_early": w.get("pace_early") is True,
                        "exhausted": w.get("state") == "exhausted"})
    return out


def _lowest(windows: list[dict], kind: str) -> dict | None:
    rows = [w for w in windows if w["kind"] == kind]
    return min(rows, key=lambda w: w["left"]) if rows else None


# -- reading the snapshot --------------------------------------------------

def read_snapshot() -> tuple[dict | None, float | None, str | None]:
    """The newest aiuse snapshot (parsed), its age in seconds and its file name. (None, None, None)
    when there is no snapshot (no directory, no files); a newest file that cannot be read, is not
    JSON or is not an object raises Unreadable naming it: a half-written or corrupt snapshot must
    not read as "no alerts, no Fable fallback"."""
    d = _path("CLAUDE_QUOTA_GUARD_SNAPSHOTS", HOME / ".cache/aiuse/snapshots")
    try:
        files = [f for f in d.glob("*.json") if f.is_file()]
        newest = max(files, key=lambda f: f.stat().st_mtime)
    except (OSError, ValueError):               # no directory / no files (max of nothing)
        return None, None, None
    try:
        age = max(0.0, now().timestamp() - newest.stat().st_mtime)
        snap = json.loads(newest.read_text())
    except (OSError, ValueError) as e:
        raise Unreadable(f"snapshot {newest.name} is unreadable or not JSON ({type(e).__name__})")
    if not isinstance(snap, dict):
        raise Unreadable(f"snapshot {newest.name} is not a JSON object")
    return snap, age, newest.name


def validate_inputs(data: dict, snap: dict | None, snap_name: str | None) -> None:
    """Raise Unreadable (naming key and file) for any container decide() reads that is malformed."""
    for key in ("available", "excluded"):
        _rows(data, key, "the aiuse payload")
    for key in ("accounts", "alerts"):
        _rows(snap, key, f"snapshot {snap_name}" if snap_name else "the snapshot")


def snapshot_alerts(snap: dict | None, age: float | None, t: dict) -> list[dict]:
    """Claude `conserve` alerts of a snapshot no older than alert_max_age_s."""
    if snap is None or age is None or age > t["alert_max_age_s"]:
        return []
    return [a for a in _rows(snap, "alerts", "the snapshot") if a.get("kind") == "conserve"]


# -- the decision ----------------------------------------------------------

def _row_age(row: dict, now_dt: datetime | None) -> float | None:
    """How old a judged row's own reading is: its `age_seconds`, and `collected_at` against now."""
    ages = [_num(row.get("age_seconds"))]
    collected = _parse_ts(row.get("collected_at"))
    if collected is not None and now_dt is not None:
        ages.append(max(0.0, (now_dt - collected).total_seconds()))
    ages = [a for a in ages if a is not None]
    return max(ages) if ages else None


def _has_summary(row: dict) -> bool:
    """A live row that carries its own verdict (headroom or usable_now) even without windows[]."""
    return _num(row.get("headroom_percent")) is not None or isinstance(row.get("usable_now"), bool)


def _summary_window(row: dict, display: list[dict]) -> dict | None:
    """The row's `binding_window` / `headroom_percent` as one window for the thresholds. A row of
    `pool_family: "fable"` is the Fable cap, never the shared weekly ("Claude Code weekly - Fable",
    kind fable); otherwise weekly unless `binding_window` names the 5-hour window. Reset time and
    pace are borrowed from the snapshot's window of the same kind (recorded in `borrowed`)."""
    headroom = _num(row.get("headroom_percent"))
    if headroom is None:
        return None
    label = str(row.get("binding_window") or "Claude binding window")
    extra = {}
    if row.get("pool_family") == "fable":
        label, extra = "Claude Code weekly \u2014 Fable", {"pool_family": "fable", "quota_scope": "model_sublimit"}
    got = claude_windows([{"windows": [{"label": label, "remaining_percent": headroom,
                                        "window_minutes": 10080, "resets_at": row.get("available_at"),
                                        **extra}]}])
    if not got:
        return None
    w = got[0]
    twin = _lowest(display, w["kind"])
    w["borrowed"] = None
    if twin is not None and w["resets_at"] is None:
        w["resets_at"], w["pace"], w["borrowed"] = twin["resets_at"], twin["pace"], twin
    return w


def decide(rc: int, data: dict, snap: dict | None, alerts: list[dict], t: dict,
           now_dt: datetime | None = None) -> dict:
    """Level plus the numbers behind it. Pure: no clock, no I/O.

    aiuse exit 3 is the live verdict that nothing is usable: `critical` whatever the snapshot
    shows (its numbers only fill the state fields; source `snapshot`). A live `available` Claude
    row without `windows[]` still counts as present: its `headroom_percent` is judged as the
    binding window (`binding_window` says which kind, weekly by default), `usable_now: false` is
    `critical`, source `available`; the snapshot's windows only fill the display fields.

    Claude rows come from `aiuse --available`; that list drops every pool with
    `usable_now: false`, so an exhausted or frozen Claude is an ABSENT row (exit 0). Then the
    rows come from the payload's own top-level `excluded[]` (an operator exclusion; windows
    judged by their numbers) or else the newest snapshot's `accounts[]` (`excluded` is never a
    snapshot key). From the snapshot, `usable_now: false` or an exhausted weekly / 5-hour window
    is `critical` (source `snapshot`); a healthy-looking row that aiuse nevertheless dropped is
    at least `watch` (source `snapshot-only`: a live 429 or a note the snapshot predates). Only
    when Claude appears nowhere: exit 3 means exhausted (critical), exit 0 means unreadable.

    When `available` has Claude rows but no Fable window (aiuse drops the Fable pool once the
    Fable cap is exhausted), the Fable window is taken from the snapshot; an exhausted Fable
    counts as 0% left, so `watch`. Only the snapshot row holding the lowest such window ages the
    decision. A windowless live row (summary only) is judged by its headroom beside the detailed
    rows, so a summary-only Fable row next to a detailed default row still counts.

    A weekly "projected to run out ... before reset" alert is ignored altogether while the
    matching weekly window has `pace_early: true` (early in a window the projection swings
    wildly: 293 of 1,146 such alerts in 2026 snapshots fired at 60% or more left)."""
    rows, judge_usable = _rows(data, "available", "the aiuse payload"), True
    snap_rows = _rows(snap, "accounts", "the snapshot")
    excluded_rows = _rows(data, "excluded", "the aiuse payload")  # an operator exclusion, payload top level
    # A present `windows` that is not a list of objects is malformed output (an omitted key is a
    # valid windowless summary): fail closed rather than read it as "no windows".
    for row in rows + excluded_rows + snap_rows:
        shape = row.get("windows", [])
        if not isinstance(shape, list) or not all(isinstance(w, dict) for w in shape):
            raise Unreadable(f"malformed `windows` in a Claude row ({type(shape).__name__}): not a list of objects")
    windows, source = claude_windows(rows), "available"
    display: list[dict] = []
    fed: list[dict] = []     # snapshot rows whose windows were used besides the judged rows: they age too
    # A live row that carries its own verdict (headroom / usable_now) but no recognised window is
    # judged by that verdict, beside the detailed rows (a summary-only Fable row never hides).
    summary_rows = [r for r in rows if _has_summary(r) and not claude_windows([r])]
    live_only = not windows and bool(summary_rows)
    if summary_rows:
        per_row = [(r, claude_windows([r])) for r in snap_rows]
        display = [w for _, ws in per_row for w in ws]
        windows += [w for w in (_summary_window(r, display) for r in summary_rows) if w]
        used: set[int] = set()
        if not any(w["kind"] == "fable" for w in windows):
            low = _lowest(display, "fable")
            if low is not None:
                windows.append(low)
                used.add(id(low))
        # Only the snapshot windows that were really used age the decision: the one Fable window
        # `_lowest` picked, the borrowed reset/pace, and the display fill for a kind the live rows
        # could not give.
        used |= {id(w["borrowed"]) for w in windows if w.get("borrowed") is not None}
        for kind in ("weekly", "five_hour"):
            if not any(w["kind"] == kind for w in windows):
                low = _lowest(display, kind)
                if low is not None:
                    used.add(id(low))
        fed = [r for r, ws in per_row if any(id(w) in used for w in ws)]
    elif not windows:
        if claude_windows(excluded_rows):
            rows, judge_usable, source = excluded_rows, False, "excluded"
        elif claude_windows(snap_rows):
            rows, source = snap_rows, "snapshot"
        windows = claude_windows(rows)
    elif not any(w["kind"] == "fable" for w in windows):
        # aiuse drops the Fable pool (not the default one) when the Fable cap is exhausted. Only the
        # snapshot row holding the lowest Fable window (the one `_lowest` judges) ages the decision.
        per_row = [(r, claude_windows([r])) for r in snap_rows]
        low = _lowest([w for _, ws in per_row for w in ws], "fable")
        if low is not None:
            windows.append(low)
            fed = [r for r, ws in per_row if any(w is low for w in ws)]
    weekly, five, fable = (_lowest(windows, k) for k in ("weekly", "five_hour", "fable"))
    level = "ok"

    def raise_to(new: str) -> None:
        nonlocal level
        if LEVELS.index(new) > LEVELS.index(level):
            level = new

    if not windows and not live_only:
        if rc != AIUSE_NOTHING_USABLE:
            raise Unreadable("aiuse has no Claude window (not in `available`, `excluded` or the snapshot)")
        raise_to("critical")  # aiuse found nothing usable and Claude is not among it: exhausted
    if rc == AIUSE_NOTHING_USABLE:
        # exit 3 is the live verdict that nothing is usable: critical whatever the snapshot shows
        # (its numbers only fill the state fields; the source stays `snapshot`, not `snapshot-only`)
        raise_to("critical")
    blocked = (judge_usable and any(r.get("usable_now") is False for r in rows)) or any(
        w["exhausted"] for w in windows if w["kind"] in ("weekly", "five_hour"))
    if blocked:
        raise_to("critical")  # exhausted shared window, or a frozen measurement
    elif source == "snapshot" and rc != AIUSE_NOTHING_USABLE:
        # Claude is in the raw snapshot but aiuse dropped it from --available (a live 429 or a
        # note the snapshot predates): the snapshot's numbers are not to be trusted to say `ok`.
        raise_to("watch")
        source = "snapshot-only"
    if weekly:
        if weekly["left"] < t["watch_weekly"]:
            raise_to("watch")
        if weekly["left"] < t["tight_weekly"]:
            raise_to("tight")
        if weekly["left"] < t["critical_weekly"]:
            raise_to("critical")
    if five and five["left"] < t["critical_five_hour"]:
        raise_to("critical")
    if fable and fable["left"] < t["watch_fable"]:
        raise_to("watch")
    weekly_labels = {w["label"].strip().lower(): [x for x in windows if x["kind"] == "weekly"
                                                    and x["label"].strip().lower() == w["label"].strip().lower()]
                     for w in windows if w["kind"] == "weekly"}
    for a in alerts:
        matched = weekly_labels.get(str(a.get("window_label") or "").strip().lower(), [])
        projected = bool(matched) and bool(_RUNNING_PROJECTED.search(str(a.get("message") or "")))
        if projected and all(w["pace_early"] for w in matched):
            continue
        raise_to("watch")
        if projected:
            raise_to("tight")

    # Window the level answers to: the lowest remaining among weekly and 5-hour.
    candidates = [w for w in (weekly, five) if w]
    rows_age = max((a for a in (_row_age(r, now_dt) for r in rows + fed) if a is not None), default=None)
    binding = min(candidates, key=lambda w: w["left"]) if candidates else None
    resets_at = binding["resets_at"] if binding else None
    if not windows and not live_only:
        weekly_left = five_left = 0.0
    else:
        weekly_left = weekly["left"] if weekly else None
        five_left = five["left"] if five else None
    # A live row without windows[] is judged by its headroom; the snapshot's windows only fill
    # the fields it cannot give (display, never the level).
    shown_weekly, shown_five, shown_fable = (weekly or _lowest(display, "weekly"),
                                             five or _lowest(display, "five_hour"),
                                             fable or _lowest(display, "fable"))
    if live_only:
        weekly_left = shown_weekly["left"] if shown_weekly else None
        five_left = shown_five["left"] if shown_five else None
    return {
        "rows_age_s": rows_age,
        "level": level,
        "weekly_left": weekly_left,
        "five_hour_left": five_left,
        "fable_left": shown_fable["left"] if shown_fable else None,
        "resets_at": resets_at,
        "weekly_resets_at": shown_weekly["resets_at"] if shown_weekly else None,
        "pace": (weekly or binding or shown_weekly or {}).get("pace") if (windows or live_only) else None,
        "source": source if (windows or live_only) else "none",
    }


# -- state file and ping ---------------------------------------------------

def load_state() -> dict:
    try:
        d = json.loads(state_path().read_text())
    except (OSError, ValueError):
        return {}
    return d if isinstance(d, dict) else {}


def save_state(state: dict) -> None:
    """Temp file beside the target, then os.replace: a reader never sees half a file."""
    p = state_path()
    p.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=p.name + ".", suffix=".tmp", dir=p.parent)
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(state, f, indent=2)
            f.write("\n")
        os.replace(tmp, p)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def _same_period(a, b, tol: float) -> bool:
    da, db = _parse_ts(a), _parse_ts(b)
    if da is None or db is None:
        return a == b
    return abs((da - db).total_seconds()) <= tol


def _rank(level) -> int:
    return LEVELS.index(level) if level in LEVELS else 0


def _reset_phrase(resets_at) -> str:
    d = _parse_ts(resets_at)
    return d.astimezone().strftime("%a %H:%M %Z") if d else "unknown"


def send_ping(msg: str, t: dict) -> bool:
    exe = str(_path("CLAUDE_QUOTA_GUARD_PING", HOME / ".local/bin/hermes-ping"))
    try:
        r = subprocess.run([exe, msg], capture_output=True, text=True, timeout=t["ping_timeout_s"],
                           check=False, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError) as e:
        print(f"claude-quota-guard: ping failed: {e}", file=sys.stderr)
        return False
    if r.returncode != 0:
        print(f"claude-quota-guard: ping exited {r.returncode}: {r.stderr.strip()[:200]}", file=sys.stderr)
        return False
    return True


def ping(level: str, st: dict, t: dict) -> bool:
    weekly = st["weekly_left"]
    first = st["advice"].splitlines()[0] if st["advice"] else ""
    first = re.sub(r"^\d+\.\s*", "", first)
    return send_ping(f"djbclark-ade: Claude quota {level}: weekly "
                     f"{'?' if weekly is None else format(weekly, 'g')}% left, resets "
                     f"{_reset_phrase(st['weekly_resets_at'] or st['resets_at'])}; {first}", t)


def plan_ping(prev: dict, st: dict, t: dict) -> str | None:
    """Carry last_pinged_level/at from `prev` onto `st`; return the level to ping, or None.

    The mark is kept for the whole reset period, whatever the level does in between, so there
    is one ping per level per period (an alert that flaps on and off cannot ping again). A new
    `weekly_resets_at` (beyond period_tolerance_s) clears it. A ping is due when the level is
    above `ok` and ranks higher than the mark."""
    pinged = prev.get("last_pinged_level") if prev.get("last_pinged_level") in LEVELS else None
    at = prev.get("last_pinged_at")
    prev_period = prev.get("weekly_resets_at") or prev.get("resets_at")
    period = st["weekly_resets_at"] or st["resets_at"]
    if pinged and not _same_period(prev_period, period, t["period_tolerance_s"]):
        pinged = None
    st["last_pinged_level"] = pinged
    st["last_pinged_at"] = at if pinged else None
    level = st["level"]
    return level if level != "ok" and _rank(level) > _rank(pinged) else None


@contextlib.contextmanager
def _locked(t: dict):
    """Exclusive flock on <state>.lock (macOS and Linux): two checks never interleave.

    Non-blocking with a bounded retry (lock_retries x lock_wait_s, about 10 x 0.5 s), so a lock
    some other process holds open cannot wedge the launchd job: Unreadable (exit 10) instead."""
    p = state_path()
    p.parent.mkdir(parents=True, exist_ok=True)
    with open(p.with_name(p.name + ".lock"), "a") as lock:
        for attempt in range(max(1, int(t["lock_retries"]))):
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                time.sleep(t["lock_wait_s"])
        else:
            raise Unreadable("another check holds the lock")
        try:
            yield
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN)


# -- subcommands -----------------------------------------------------------

def _check_locked(t: dict) -> dict:
    try:
        rc, data = read_aiuse()
        snap, snap_age, snap_name = None, None, None
        try:
            snap, snap_age, snap_name = read_snapshot()
            validate_inputs(data, snap, snap_name)
        except Unreadable as e:
            if rc != AIUSE_NOTHING_USABLE:
                raise
            # exit 3 is critical whatever the snapshot or payload says, so broken data cannot change it
            print(f"claude-quota-guard: {e}; ignored: aiuse exit 3 is critical regardless", file=sys.stderr)
            data, snap, snap_age = {}, None, None
        d = decide(rc, data, snap, snapshot_alerts(snap, snap_age, t), t, now())
    except (Unreadable, ConfigError):
        raise
    except Exception as e:  # malformed aiuse or snapshot types must never read as `watch` (exit 1)
        raise Unreadable(f"unexpected {type(e).__name__} reading aiuse or the snapshot: {e}")
    st = dict(d)
    st["unreadable_since"] = st["last_unreadable_pinged_at"] = st["last_unreadable_at"] = None  # a good read ends the episode
    # Data age: the oldest of the payload's top-level age, every judged row's own age (a Claude
    # pool can be hours old inside a fresh snapshot: cswap stalls) and the snapshot file's mtime.
    ages = [a for a in (_num(data.get("age_seconds")), st.pop("rows_age_s"), snap_age) if a is not None]
    data_age = max(ages) if ages else None
    st["checked_at"] = _iso(now())
    st["snapshot_age_s"] = None if snap_age is None else round(snap_age)
    st["data_age_s"] = None if data_age is None else round(data_age)
    st["stale"] = data_age is not None and data_age > t["stale_age_s"]
    stale_age = data_age if st["stale"] else None
    if st["stale"] and _rank(st["level"]) < _rank("watch"):
        st["level"] = "watch"  # a dead collector: frozen numbers can never climb, so never say ok
    st["advice"] = _advice(st["level"], st["resets_at"], st["source"], stale_age)
    prev = load_state()
    due = plan_ping(prev, st, t)
    if st["stale"]:
        due = None  # numbers this old (dead collector) are reported, never announced as a level
    # One ping per stale episode: the mark is carried while stale and cleared when it ends.
    stale_ping = st["stale"] and not prev.get("last_stale_pinged_at")
    st["last_stale_pinged_at"] = prev.get("last_stale_pinged_at") if st["stale"] else None
    save_state(st)  # before the pings: the hook sees the new level at once
    if due and ping(due, st, t):
        st["last_pinged_level"], st["last_pinged_at"] = due, st["checked_at"]
        save_state(st)  # a failed ping leaves the mark unset, so the next run retries
    if stale_ping and send_ping(f"djbclark-ade: Claude quota guard: aiuse data {_age_short(data_age)} old "
                                "(collector down?)", t):
        st["last_stale_pinged_at"] = st["checked_at"]
        save_state(st)
    return st  # a ping cut off by a kill is retried next run too: at least once, never silently lost


def _note_unreadable(err: Exception, t: dict) -> None:
    """Record a failed read WITHOUT touching the level fields: only `unreadable_since`,
    `last_unreadable_at` (every failing run) and `last_unreadable_pinged_at` change. The first
    failing run sets `unreadable_since`; the next one (still failing, so not a one-off) sends ONE
    ping for the episode. The next successful read rebuilds the state and clears all three."""
    try:
        prev = load_state()
        since = _parse_ts(prev.get("unreadable_since"))
        first = since is None
        since_iso = _iso(since or now())
        st = dict(prev)
        st["unreadable_since"] = since_iso
        st["last_unreadable_at"] = _iso(now())   # every failing run: tells the hook the guard still runs
        st.setdefault("last_unreadable_pinged_at", None)
        save_state(st)  # before the ping, like the level pings
        if not first and not st.get("last_unreadable_pinged_at"):
            reason = re.sub(r"[^\x20-\x7e]+", " ", str(err)).strip()[:160]
            if send_ping(f"djbclark-ade: Claude quota guard cannot read aiuse: {reason} "
                         f"(every run since {since_iso})", t):
                st["last_unreadable_pinged_at"] = _iso(now())
                save_state(st)
    except OSError as e:
        print(f"claude-quota-guard: could not record the unreadable episode: {e}", file=sys.stderr)


def cmd_check(args) -> int:
    t = thresholds()
    try:
        with _locked(t):
            try:
                st = _check_locked(t)
            except Unreadable as e:
                _note_unreadable(e, t)
                raise
    except Unreadable as e:
        print(f"claude-quota-guard: {e}; level fields left unchanged", file=sys.stderr)
        return EX_UNREADABLE
    except ConfigError:
        raise
    except Exception as e:
        print(f"claude-quota-guard: unexpected {type(e).__name__}: {e}", file=sys.stderr)
        return EX_UNREADABLE
    if args.json:
        print(json.dumps(st, indent=2))
    else:
        print(_human(st))
    return EXIT_CODES[st["level"]]


def _fmt(v) -> str:
    return "?" if v is None else f"{v:g}%"


def _age_short(seconds) -> str | None:
    if not isinstance(seconds, (int, float)) or isinstance(seconds, bool):
        return None
    s = int(seconds)
    if s < 3600:
        return f"{s // 60}m"
    if s < 86400:
        return f"{s // 3600}h{s % 3600 // 60:02d}m"
    return f"{s // 86400}d{s % 86400 // 3600:02d}h"


def _age_phrase(seconds) -> str:
    short = _age_short(seconds)
    return "age unknown" if short is None else f"{short} old"


def _human(st: dict) -> str:
    stale = " (stale)" if st.get("stale") else ""
    since = _parse_ts(st.get("unreadable_since"))
    unreadable = f" [aiuse unreadable since {_iso(since)}]" if since else ""
    return (f"claude-quota-guard: {st.get('level', '?')}{stale}: weekly {_fmt(st.get('weekly_left'))} left, "
            f"5-hour {_fmt(st.get('five_hour_left'))}, fable {_fmt(st.get('fable_left'))}, "
            f"resets {_reset_phrase(st.get('resets_at'))}, data {_age_phrase(st.get('data_age_s'))}, "
            f"checked {st.get('checked_at', '?')}{unreadable}")


def cmd_status(args) -> int:
    st = load_state()
    if not st:
        print(f"claude-quota-guard: no state at {state_path()}; run `claude-quota-guard check`", file=sys.stderr)
        return EX_UNREADABLE
    if args.json:
        print(json.dumps(st, indent=2))
    else:
        print(_human(st))
        if st.get("advice"):
            print(st["advice"])
    return 0


def cmd_install(args) -> int:
    script = Path(__file__).resolve()
    if sys.platform != "darwin":
        print(f"claude-quota-guard: launchd only; on Linux run `{shlex.quote(str(script))} check` every "
              "15 min from a systemd user timer or cron", file=sys.stderr)
        return EX_NO_LAUNCHD
    la = _path("CLAUDE_QUOTA_GUARD_LAUNCH_AGENTS", HOME / "Library/LaunchAgents")
    dest = la / f"{LABEL}.plist"
    log_dir = HOME / ".local/state/ade"
    log = log_dir / "claude-quota-guard.launchd.log"
    job = {
        "Label": LABEL,
        "ProgramArguments": [str(script), "check"],
        "EnvironmentVariables": {"PATH": f"{HOME}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"},
        "RunAtLoad": True,
        "StartInterval": INTERVAL_SECONDS,
        "ProcessType": "Background",
        "LowPriorityIO": True,
        "StandardOutPath": str(log),
        "StandardErrorPath": str(log),
    }
    log_dir.mkdir(parents=True, exist_ok=True)  # launchd will not create the log's directory
    la.mkdir(parents=True, exist_ok=True)
    tmp = dest.with_suffix(".plist.tmp")
    tmp.write_bytes(plistlib.dumps(job))
    os.replace(tmp, dest)
    print(f"wrote {dest}")
    uid = os.getuid()
    print(shlex.join(["launchctl", "bootout", f"gui/{uid}/{LABEL}"]) + " 2>/dev/null; "
          + shlex.join(["launchctl", "bootstrap", f"gui/{uid}", str(dest)]))
    return 0


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(prog="claude-quota-guard", description=__doc__.split("\n\n")[0])
    ap.add_argument("command", nargs="?", choices=("check", "status"), default="check")
    ap.add_argument("--json", action="store_true", help="print the state as JSON")
    ap.add_argument("--install", action="store_true", help="write the launchd job; print the bootstrap line")
    args = ap.parse_args(argv)
    try:
        if args.install:
            return cmd_install(args)
        return cmd_status(args) if args.command == "status" else cmd_check(args)
    except ConfigError as e:
        print(f"claude-quota-guard: {e}", file=sys.stderr)
        return EX_CONFIG


if __name__ == "__main__":
    sys.exit(main())

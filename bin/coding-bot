def state_dir() -> Path:
    return Path(os.environ.get("CODING_BOT_STATE") or Path.home() / ".local/state/coding-bot")


class Timeout(Exception):
    pass


def finite_secs(v: str) -> float:
    try:
        x = float(v)
    except ValueError:
        raise argparse.ArgumentTypeError(f"{v!r} is not a number of seconds") from None
    if not math.isfinite(x) or x < 0:
        raise argparse.ArgumentTypeError(f"{v!r}: seconds must be finite and 0 or more")
    return x


def name_arg(pattern: re.Pattern[str], what: str):
    def check(v: str) -> str:
        if not pattern.fullmatch(v):
            raise argparse.ArgumentTypeError(f"{v!r} is not a valid {what}")
        return v
    return check


CRED: dict[str, str | None] = {URL_NAME: None, KEY_NAME: None}
SECRET_ENV = {URL_NAME, KEY_NAME, "CODING_BOT_WEBHOOK_HEADER"}
RUN_GUARD = "CODING_BOT_UNDER_RUN"
# What a child process (clip, pbpaste, git, ssh) may inherit once the credentials are in memory. `sudo-secretspec run`
# puts EVERY declared secret into the environment; none of the others, nor ours, may leak to a child. Proxy and CA
# overrides are NOT kept: they could point the Bearer key at a caller-chosen machine (see scrub_network_env).
KEEP_ENV = re.compile(r"(PATH|HOME|USER|LOGNAME|SHELL|TMPDIR|TERM|LANG|SSH_AUTH_SOCK|LC_\w*|CODING_BOT_\w+|CLIP|PBPASTE)")


def needs_credentials(cmd: str) -> bool:
    return cmd in {"ask", "send", "prompt", "status"}


def reexec_under_run(argv: list[str]) -> None:
    """Credentials come only through `sudo-secretspec run` (AGENTS.md: a key never appears in argv, a log, or a
    `get` on stdout). Without them in the environment, run this same command again under `run` once."""
    if (os.environ.get(URL_NAME) and os.environ.get(KEY_NAME)) or os.environ.get(RUN_GUARD):
        return
    exe = shutil.which("sudo-secretspec")
    if not exe:
        return
    # -I: isolated mode ignores PYTHON* variables, the user site and the current directory, so nothing the caller
    # planted (PYTHONPATH, a sitecustomize, a stray json.py) can run in the process that holds the vault credentials.
    os.execve(exe, [exe, "run", "--reason", "coding-bot: reach the Coding bot", "--", sys.executable, "-I",
                    os.path.abspath(__file__), *argv], {**os.environ, RUN_GUARD: "1"})


def take_credentials() -> None:
    """Move the two values out of the environment into memory, then drop every other secret from it."""
    for name in (URL_NAME, KEY_NAME):
        CRED[name] = os.environ.get(name, "").strip() or None
    for name in list(os.environ):
        if name in SECRET_ENV or not KEEP_ENV.fullmatch(name):
            del os.environ[name]


def channel() -> tuple[str | None, str | None]:
    return CRED[URL_NAME], CRED[KEY_NAME]


def check_url(url: str) -> str | None:
    """None when url may receive the key, else the reason it may not (never the URL: it is a secret)."""
    try:
        u = urllib.parse.urlsplit(url)
    except ValueError:
        return "the webhook URL is not a valid URL"
    if u.scheme == "https" and u.hostname in WEBHOOK_HOSTS:
        return None
    if u.scheme == "http" and u.hostname in LOOPBACK:
        return None
    return "the webhook URL's host is not an allowed Grok Bot routine host"


def clean(s: str) -> str:
    """Drop terminal control characters (ESC sequences, C0, C1) but keep newline and tab."""
    return CONTROL.sub("", s)


def state_path(name: str) -> Path:
    """state/name, its directory 0700 (the files hold task text and replies)."""
    d = state_dir()
    d.mkdir(parents=True, exist_ok=True)
    os.chmod(d, 0o700)
    return d / name


def parse(raw: str, name: str) -> list[dict]:
    """The records of a JSONL file; a torn or garbled line is skipped and reported, never fatal."""
    out, bad = [], 0
    for line in raw.split("\n"):  # NOT splitlines(): it also splits at U+2028, U+0085, \x0b ... inside a JSON string
        if not line.strip():
            continue
        try:
            rec = json.loads(line)
        except ValueError:
            rec = None
        if isinstance(rec, dict):
            out.append(rec)
        else:
            bad += 1
    if bad:
        print(f"coding-bot: skipped {bad} unreadable line(s) in {state_dir() / name}", file=sys.stderr)
    return out


def append(name: str, rec: dict, *, number: str | None = None, unless=None) -> str | None:
    """Add rec as one JSON line to state/name: the whole file is rewritten to a temp file beside it, fsynced,
    then `os.replace`d, all under an flock on `name.lock`, so a crash or a full disk leaves the old file whole
    and a reader never sees a partial one. An unreadable line already there is kept as is and fenced off with
    a newline (reads skip it). With `number` (an id prefix) the record gets `<prefix>-N`, N one more than the
    highest used; returns that id (or ""). With `unless` (a test on the records already there, run under the lock) the
    record is not added when it is true, and None is returned: a check-then-add that two processes cannot both pass."""
    path = state_path(name)
    lock = os.open(f"{path}.lock", os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX)
        raw = path.read_bytes().decode("utf-8", "replace") if path.exists() else ""
        if unless is not None and unless(parse(raw, name)):
            return None
        mid = ""
        if number:
            used = [int(m.group(1)) for r in parse(raw, name) if (m := re.fullmatch(rf"{number}-(\d+)", str(r.get("id", ""))))]
            mid = f"{number}-{max(used, default=0) + 1}"
            rec = {"id": mid, **rec}
        new = (raw + ("\n" if raw and not raw.endswith("\n") else "")
               + json.dumps({"ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"), **rec}) + "\n")  # ASCII-only: one record, one line
        fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{name}.", suffix=".tmp")  # 0600
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                f.write(new)
                f.flush()
                os.fsync(f.fileno())
            os.replace(tmp, path)
        except BaseException:
            with contextlib.suppress(FileNotFoundError):
                os.unlink(tmp)
            raise
        dfd = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(dfd)
        finally:
            os.close(dfd)
        return mid
    finally:
        os.close(lock)


def records(name: str) -> list[dict]:
    """Whole records only: the file is replaced atomically, so a read needs no lock."""
    p = state_dir() / name
    if not p.exists():
        return []
    return parse(p.read_bytes().decode("utf-8", "replace"), name)


def clip(text: str) -> bool:
    """The operator's `clip` first (it fixes LC_CTYPE and takes -q); a `clip` on PATH only as a fallback."""
    for exe in (os.environ.get("CLIP"), str(Path.home() / "ops/site-private-djbclark/bin/clip"), shutil.which("clip")):
        if exe and os.access(exe, os.X_OK):
            return subprocess.run([exe, "-q"], input=text, text=True, check=False).returncode == 0
    return False


def paste() -> str | None:
    exe = os.environ.get("PBPASTE") or shutil.which("pbpaste")
    if not exe:
        return None
    r = subprocess.run([exe], capture_output=True, check=False, env={**os.environ, "LC_CTYPE": "UTF-8"})
    return r.stdout.decode("utf-8", "replace") if r.returncode == 0 else None


def project() -> str:
    r = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=False)
    return Path(r.stdout.strip() if r.returncode == 0 and r.stdout.strip() else os.getcwd()).name


def fail(msg: str, code: int = 2) -> int:
    print(msg, file=sys.stderr)
    return code


def task_text(arg: str, secrets: tuple[str | None, ...]) -> str | int:
    raw = sys.stdin.read(MAX_TEXT + 1) if arg == "-" else arg
    if len(raw) > MAX_TEXT:  # the raw size, before stripping can shrink it
        return fail(f"refused: the text is over {MAX_TEXT} characters; send a summary or a pointer")
    text = raw.strip()
    if not text:
        return fail("empty message")
    if SECRET_SHAPES.search(text) or any(s and len(s) >= 8 and s in text for s in secrets):
        return fail("refused: the text contains something shaped like a credential; remove it and send again")
    return text


def header(sender: str, mid: str, re_id: str | None, nonce: str | None = None) -> str:
    return (f"[{sender} -> {RECIPIENT}] id={mid}" + (f" nonce={nonce}" if nonce else "")
            + (f" re={re_id}" if re_id else ""))


def pasteable(sender: str, mid: str, re_id: str | None, text: str, nonce: str | None = None) -> str:
    return (f"{PREFACE.format(sender=sender, id=mid, nonce=nonce or '<nonce>')}\n"
            f"{header(sender, mid, re_id, nonce)}\n\n{text}\n")


class NoRedirect(urllib.request.HTTPRedirectHandler):
    """A 3xx is an error, never followed: urllib would re-send the Authorization header to the Location host."""

    def redirect_request(self, *args, **kwargs):  # noqa: ANN002, ANN003
        return None


def opener() -> urllib.request.OpenerDirector:
    """Built per call, after scrub_network_env: no proxy at all (not the environment's, not macOS's system setting), the
    default system trust store, and no redirects."""
    ctx = ssl.create_default_context()
    return urllib.request.build_opener(urllib.request.ProxyHandler({}), urllib.request.HTTPSHandler(context=ctx), NoRedirect)


def _deadline(signum, frame):  # noqa: ANN001
    raise Timeout


def webhook_post(url: str, key: str, payload: dict) -> tuple[bool, str]:
    """One POST. Every failure is reported by kind only: an exception's text can quote the URL (a secret)."""
    # 30 s is per socket operation; the alarm makes it a total deadline (a trickling server cannot hold us).
    old = signal.signal(signal.SIGALRM, _deadline)
    signal.setitimer(signal.ITIMER_REAL, TOTAL_DEADLINE_S)
    try:
        req = urllib.request.Request(
            url, data=json.dumps(payload).encode(), method="POST",
            headers={"Content-Type": "application/json", "Authorization": f"Bearer {key}",
                     "User-Agent": "coding-bot/1.0"})
        with opener().open(req, timeout=30) as resp:
            body = resp.read(2000).decode(errors="replace")
            try:
                run = json.loads(body).get("runUuid")
            except (ValueError, AttributeError):
                run = None
            return True, f"HTTP {resp.status}" + (f" runUuid={clean(run)}" if isinstance(run, str) else "")
    except urllib.error.HTTPError as e:
        return False, f"webhook rejected: HTTP {e.code}"
    except Timeout:
        return False, f"webhook unreachable: no answer in {TOTAL_DEADLINE_S:g}s"
    except urllib.error.URLError as e:
        why = e.reason
        return False, "webhook unreachable: " + (clean(why.strerror) if isinstance(why, OSError) and why.strerror
                                                  else type(why).__name__)
    except OSError as e:
        return False, "webhook unreachable: " + (clean(e.strerror) if e.strerror else type(e).__name__)
    except Exception as e:  # noqa: BLE001  (a malformed URL raises ValueError/InvalidURL quoting itself)
        return False, f"webhook failed: {type(e).__name__}"
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, old)


def clipboard_or_3(what: str, text: str) -> int:
    return 0 if clip(text) else fail(f"{what}: could not reach the clipboard tool (clip)", 3)


# ---------------------------------------------------------------- drop transports (ssh drop dir, git mailbox)
class TransportError(Exception):
    def __init__(self, msg: str, rc: int | None = None) -> None:
        super().__init__(msg)
        self.rc = rc  # the command's exit status, when it ran and failed


class DeadlineError(TransportError):
    """The caller's own wait deadline cut the command short: not the transport's fault, so no backoff."""


class FileError(TransportError):
    """One bot file could not be read (permissions, a vanished file): the route itself works. Reported, marked seen,
    and the poll goes on with the other files; the transport is not backed off."""


def expand(p: str) -> str:
    return os.path.expanduser(str(p))


DEADLINE: list[float] = []  # a monotonic deadline that bounds every transport command while `wait` runs
PROBE: list[float] = []     # the current poll's own, shorter deadline inside it (a share of what is left)


def run_cmd(argv: list[str], *, stdin: str | None = None, timeout: float, pidfile: Path | None = None) -> str:
    """stdout of argv (never a shell). Any failure is a TransportError that names the command and its first
    stderr line, nothing else. While a `wait` deadline is set, no command runs past it, nor past its poll's share of
    the time left: a cut there is a DeadlineError (our budget, not the route's fault: no backoff). `pidfile` records
    the child's process group while it runs (removed once it is reaped), so one orphaned by a SIGKILL can be found."""
    by_wait = False
    now = time.monotonic()
    if DEADLINE:
        left = DEADLINE[0] - now
        if left < 0.5:
            raise DeadlineError(f"{argv[0]}: no time left before the wait deadline")
        by_wait, timeout = left < timeout, min(timeout, left)
    if PROBE and PROBE[0] - now < timeout:
        if PROBE[0] - now < 0.5:
            raise DeadlineError(f"{argv[0]}: this poll's share of the wait is used up")
        timeout, by_wait = PROBE[0] - now, True
    try:
        # its own process group, so a timeout kills the whole tree (git pull's fetch, a rebase) before the caller lets go
        # of the clone lock, not just the top process
        proc = subprocess.Popen(argv, stdin=subprocess.PIPE if stdin is not None else subprocess.DEVNULL,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, encoding="utf-8",
                                errors="replace", env={**os.environ, "GIT_TERMINAL_PROMPT": "0"}, start_new_session=True)
    except OSError as e:
        raise TransportError(f"{argv[0]}: {e.strerror or type(e).__name__}") from None
    if pidfile is not None:
        tmp = pidfile.with_name(f".{pidfile.name}.{os.getpid()}.tmp")
        try:  # atomic: a reader sees no record or a whole one
            tmp.write_text(f"{proc.pid}\n")
            os.replace(tmp, pidfile)
        except BaseException as e:  # no record, no child: never leave a git running that nothing can find
            with contextlib.suppress(ProcessLookupError):
                os.killpg(proc.pid, signal.SIGKILL)
            proc.communicate()
            with contextlib.suppress(OSError):
                tmp.unlink()
            if isinstance(e, OSError):
                raise TransportError(f"{argv[0]}: could not record its pid ({e.strerror or type(e).__name__})") from None
            raise
    try:
        return _finish(proc, argv, stdin, timeout, by_wait)
    finally:
        if pidfile is not None:
            with contextlib.suppress(FileNotFoundError):
                pidfile.unlink()


def _finish(proc: subprocess.Popen, argv: list[str], stdin: str | None, timeout: float, by_wait: bool) -> str:
    try:
        out, err = proc.communicate(stdin, timeout=timeout)
    except subprocess.TimeoutExpired:
        with contextlib.suppress(ProcessLookupError):
            os.killpg(proc.pid, signal.SIGKILL)
        proc.communicate()
        raise (DeadlineError if by_wait else TransportError)(f"{argv[0]} timed out after {timeout:g}s") from None
    except BaseException:
        with contextlib.suppress(ProcessLookupError):
            os.killpg(proc.pid, signal.SIGKILL)
        proc.wait()
        raise
    r = subprocess.CompletedProcess(argv, proc.returncode, out, err)
    if r.returncode != 0:
        first = next((ln for ln in r.stderr.splitlines() if ln.strip()), "")
        raise TransportError(f"{argv[0]} exited {r.returncode}: {clean(first)[:120]}", r.returncode)
    return r.stdout


class Ssh:
    """The restricted ssh account on the bot's box: <to_dir>/ade-N.md written by us, <from_dir>/ade-N--coding-K.md by the bot."""
    name = "ssh"

    def __init__(self, c: dict) -> None:
        self.c = c

    def _argv(self, remote: str) -> list[str]:
        c = self.c
        # -F /dev/null: no user ssh config (ProxyCommand, ForwardAgent, extra identities) can change this connection;
        # only the private known_hosts vouches for the host, never the system-wide one
        return ["ssh", "-F", "/dev/null", "-p", str(c.get("port", 22)), "-i", expand(c["key"]), "-o", "IdentitiesOnly=yes",
                "-o", "IdentityAgent=none", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8",
                "-o", "StrictHostKeyChecking=yes", "-o", f"UserKnownHostsFile={expand(c['known_hosts'])}",
                "-o", "GlobalKnownHostsFile=/dev/null", "-o", "ForwardAgent=no", "-o", "ClearAllForwardings=yes",
                f"{c['user']}@{c['host']}", remote]

    def put(self, mid: str, content: str) -> None:
        d, f = shlex.quote(self.c["to_dir"]), f"{mid}.md"
        # written to a dot file, then hard-linked to its name: the bot never reads half a message, and `ln` (unlike `mv`)
        # fails when the name exists, so a colliding id never replaces someone else's message
        t = f"{d}/.{f}.$$.tmp"
        try:
            # a connection that drops mid-upload can hand `cat` an early EOF: only the full byte count is published
            size = len(content.encode())
            run_cmd(self._argv(f"umask 022; cat > {t} && n=$(wc -c < {t}) && [ $n -eq {size} ] && ln {t} {d}/{f}; "
                               f"rc=$?; rm -f {t}; exit $rc"), stdin=content, timeout=SSH_TIMEOUT_S)
        except DeadlineError:
            raise
        except TransportError as e:
            if e.rc not in (None, 255):
                raise  # the remote command itself said no (the name exists, a full disk): nothing was stored
            # the connection broke: the `ln` may have landed. Look once; if we cannot tell, say so instead of "not stored"
            try:
                landed = run_cmd(self._argv(f"head -c {len(content.encode()) + 1} -- {d}/{f}"), timeout=SSH_TIMEOUT_S) == content
            except TransportError:
                raise UncertainPut(f"{e}; whether {f} landed is unknown") from None
            if not landed:
                raise

    def list_files(self) -> list[str]:
        """The reply, claim and heartbeat files in from_dir. A plain listing, filtered here: a pipeline with `|| true`
        would turn an unreadable folder into "no files"."""
        out = run_cmd(self._argv(f"cd {shlex.quote(self.c['from_dir'])} && ls -1A"), timeout=SSH_TIMEOUT_S)
        return [n for n in out.split("\n") if bot_file(n)]

    def read(self, name: str) -> str:
        if not bot_file(name):
            raise TransportError("bad bot file name")
        try:
            return run_cmd(self._argv(f"head -c {4 * MAX_TEXT + 8} -- {shlex.quote(self.c['from_dir'])}/{name}"),
                           timeout=SSH_TIMEOUT_S)
        except DeadlineError:
            raise
        except TransportError as e:
            if e.rc not in (None, 255):  # ssh itself fails with 255; anything else is the remote `head` on this file
                raise FileError(str(e), e.rc) from None
            raise


class UncertainPut(TransportError):
    """The connection broke mid-put and a check could not tell whether the message landed: it may still run."""


class OversizeReply(TransportError):
    """A reply file larger than the reply cap: refused for good, never read into memory."""


class Git:
    """A private mailbox repo cloned on this machine: to-coding/ade-N.md by us, from-coding/ade-N--coding-K.md by the bot.
    The clone is tool-owned and shared by every project's coding-bot, so each transaction holds an flock on it."""
    name = "git"

    def __init__(self, c: dict) -> None:
        self.path, self.remote, self.branch = Path(expand(c["path"])), c.get("remote", "origin"), c.get("branch", "main")

    def _git(self, *args: str, locked: bool = True) -> str:
        """A git command on the clone; `locked=False` for a read-only object lookup run outside the clone flock, which
        takes no lock and so is not recorded (it must never overwrite the record of a git that holds one)."""
        return run_cmd(["git", "-C", str(self.path), "-c", "user.name=coding-bot agent",
                        "-c", "user.email=coding-bot@users.noreply.github.com", "-c", "commit.gpgsign=false",
                        "-c", "core.symlinks=false", *args], timeout=GIT_TIMEOUT_S,
                       pidfile=self._child_file() if locked else None)

    def _child_file(self) -> Path:
        return state_path(f"git-{hashlib.sha256(str(self.path).encode()).hexdigest()[:12]}.child")

    def _reap_orphan(self) -> None:
        """Under the clone flock: a child-pid record left behind means a coding-bot died (SIGKILL) with a git running.
        That git may still be alive, holding index or ref locks, with no timeout. Only once its process group is gone
        (it ended, or ran past GIT_TIMEOUT_S and is killed here) are the locks it left removed."""
        pf = self._child_file()
        try:
            pid = int(pf.read_text().split()[0])
            started = pf.stat().st_mtime
        except FileNotFoundError:
            return
        except (OSError, ValueError, IndexError):
            pid, started = 0, 0.0
        if pid > 1 and self._ours_alive(pid):
            if time.time() - started < GIT_TIMEOUT_S:
                raise TransportError(f"git: an orphaned git (pid {pid}) is still working in the mailbox clone")
            with contextlib.suppress(ProcessLookupError, PermissionError):
                os.killpg(pid, signal.SIGKILL)
            for _ in range(40):
                if not self._ours_alive(pid):
                    break
                time.sleep(0.05)
            else:
                raise TransportError(f"git: the orphaned git (pid {pid}) in the mailbox clone would not die")
        with contextlib.suppress(FileNotFoundError):
            pf.unlink()
        self._clear_locks(0)  # its owner is gone: whatever it held is dead

    def _ours_alive(self, pid: int) -> bool:
        """A live process group `pid` whose leader is a command on this clone (a reused pid is someone else's)."""
        try:
            os.killpg(pid, 0)
        except (ProcessLookupError, PermissionError):
            return False
        r = subprocess.run(["ps", "-o", "command=", "-p", str(pid)], capture_output=True, text=True, check=False)
        return str(self.path) in r.stdout

    @contextlib.contextmanager
    def locked(self):
        """One transaction at a time on the clone (pull/commit/push and fetch), across processes. Waits at most the
        git timeout, or what is left of a `wait` deadline."""
        lock = os.open(state_path(f"git-{hashlib.sha256(str(self.path).encode()).hexdigest()[:12]}.lock"),
                       os.O_RDWR | os.O_CREAT, 0o600)
        try:
            limit = time.monotonic() + GIT_TIMEOUT_S
            for cap in (DEADLINE, PROBE):  # never wait for the lock past the wait, or past this poll's share of it
                if cap:
                    limit = min(limit, cap[0])
            while True:
                try:
                    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    if time.monotonic() >= limit:
                        raise (DeadlineError if DEADLINE or PROBE else TransportError)("git: mailbox clone busy") from None
                    time.sleep(0.1)
            self._reap_orphan()
            yield
        finally:
            os.close(lock)

    def recover(self) -> None:
        """Undo what an interrupted transaction left behind: a rebase in progress, or a staged but uncommitted message.
        The clone is tool-owned, so its index is ours to reset; committed but unpublished messages are kept."""
        self._clear_locks()
        for d in ("rebase-merge", "rebase-apply"):
            if (self.path / self._git("rev-parse", "--git-path", d).strip()).exists():
                with contextlib.suppress(TransportError):
                    self._git("rebase", "--abort")
                break
        if self._git("diff", "--cached", "--name-only").strip():
            self._git("reset", "--quiet")

    def _locks(self) -> list[Path]:
        gd = Path(self._git("rev-parse", "--absolute-git-dir").strip())
        return [gd / n for n in ("index.lock", "HEAD.lock", "ORIG_HEAD.lock", "packed-refs.lock", "config.lock",
                                 "shallow.lock")] + list((gd / "refs").rglob("*.lock"))

    def _clear_locks(self, min_age: float = GIT_TIMEOUT_S, keep: frozenset = frozenset()) -> None:
        """Remove lock files a killed git left behind. Only ever called under the clone's flock, and only coding-bot uses
        the clone. `run_cmd` kills and reaps a timed-out git's whole process group, and so does a SIGTERM/SIGHUP/SIGINT of
        coding-bot (main turns them into an exit); a git orphaned by a SIGKILL is found and ended by `_reap_orphan` first,
        so a lock older than GIT_TIMEOUT_S has no live owner. `min_age=0` only right after this process reaped its own git, and
        then never for a lock in `keep` (one that existed before that git started, so not its)."""
        now = time.time()
        for lk in self._locks():
            if lk in keep:
                continue
            with contextlib.suppress(FileNotFoundError):
                if lk.is_file() and not lk.is_symlink() and now - lk.stat().st_mtime >= min_age:
                    lk.unlink()

    def sync_branch(self) -> None:
        """Bring the clone up to the remote, replaying any local commit an earlier send could not publish (so one failed
        push never wedges the transport); a rebase that cannot finish is aborted and reported."""
        self.recover()
        try:
            self._git("pull", "--rebase", "--quiet", self.remote, self.branch)
        except TransportError:
            with contextlib.suppress(TransportError):
                self._git("rebase", "--abort")
            raise

    def _target(self, rel: str) -> Path:
        """The file to write, refused if the (bot-writable) repo made it or its folder a symlink or points it outside."""
        root = self.path.resolve()
        parent = self.path / "to-coding"
        if parent.is_symlink() or (parent.exists() and not parent.is_dir()):
            raise TransportError("git: to-coding/ is not a plain folder in the mailbox; refusing to write")
        parent.mkdir(exist_ok=True)
        target = self.path / rel
        if target.is_symlink() or (os.path.lexists(target) and not target.is_file()):
            raise TransportError(f"git: {rel} exists and is not a plain file; refusing to write")
        if target.parent.resolve() != root / "to-coding":
            raise TransportError("git: to-coding/ resolves outside the mailbox; refusing to write")
        return target

    def put(self, mid: str, content: str) -> None:
        rel = f"to-coding/{mid}.md"
        with self.locked():
            self.sync_branch()
            try:
                self._write(mid, rel, content)
            except OSError as e:  # an unwritable folder or a full disk is this route failing, not a crash
                raise TransportError(f"git: could not write {rel} ({e.strerror or type(e).__name__})") from None
            before = frozenset(lk for lk in self._locks() if lk.exists())
            try:
                # add and commit sit inside the recovery too: a commit that lands and then times out (a slow hook) must
                # be rolled back or reported uncertain like a failed push
                self._git("add", "--", rel)
                self._git("commit", "--quiet", "-m", f"{mid}: message to coding", "--", rel)
                try:
                    self._git("push", "--quiet", self.remote, f"HEAD:{self.branch}")
                except TransportError:  # the bot pushed a reply meanwhile: rebase once and retry
                    self.sync_branch()
                    self._git("push", "--quiet", self.remote, f"HEAD:{self.branch}")
            except TransportError:
                # "not stored" must be true: either the push did land (seen on the remote) or the local commit goes, so a
                # later send can never publish this message behind the sender's back
                published = self._published(rel, content)
                if published:
                    return
                if published is None:  # the remote cannot be asked: the push may have landed. Keep the commit (a later
                    # send publishes it, which is harmless: the caller was told the message MAY be stored) and say so
                    raise UncertainPut(f"git: push of {rel} failed and the remote cannot be checked") from None
                try:
                    self._clear_locks(0, keep=before)  # only what this put's own reaped git left behind
                    self._git("reset", "--quiet", "--hard", f"{self.remote}/{self.branch}")
                except TransportError:  # the commit stays, so a later send would publish it: not "not stored"
                    raise UncertainPut(f"git: push of {rel} failed and its local commit could not be rolled back") from None
                raise

    def _published(self, rel: str, content: str) -> bool | None:
        """True: the remote has the message; False: it surely does not; None: the remote cannot be asked."""
        try:
            self._git("fetch", "--quiet", self.remote, self.branch)
        except TransportError:
            return None
        try:
            return self._git("cat-file", "blob", f"{self.remote}/{self.branch}:{rel}") == content
        except TransportError:
            return False  # fetched, and the file is not there

    def _write(self, mid: str, rel: str, content: str) -> None:
        target = self._target(rel)
        if target.exists():
            if target.read_text(encoding="utf-8", errors="replace") != content:
                raise TransportError(f"{rel} already exists with other content")
            return
        fd, tmp = tempfile.mkstemp(dir=target.parent, prefix=f".{mid}.", suffix=".tmp")
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                f.write(content)
                f.flush()
                os.fsync(f.fileno())
            os.replace(tmp, target)
        except BaseException:
            with contextlib.suppress(FileNotFoundError):
                os.unlink(tmp)
            raise

    def list_files(self) -> list[str]:
        """The reply, claim and heartbeat files in from-coding/."""
        with self.locked():
            self._clear_locks()  # a poll killed mid-fetch leaves a ref lock that would fail every later fetch
            self._git("fetch", "--quiet", self.remote, self.branch)
            out = self._git("ls-tree", "--name-only", f"{self.remote}/{self.branch}", "from-coding/")
        return [n.split("/", 1)[1] for n in out.split("\n") if "/" in n and bot_file(n.split("/", 1)[1])]

    def read(self, name: str) -> str:
        if not bot_file(name):
            raise TransportError("bad bot file name")
        rev = f"{self.remote}/{self.branch}:from-coding/{name}"
        try:
            # one blob id for both the size check and the read: a concurrent fetch cannot swap the blob in between
            blob = self._git("rev-parse", "--verify", "--quiet", rev, locked=False).strip()
            size = self._git("cat-file", "-s", blob, locked=False).strip()
            if not size.isdigit() or int(size) > 4 * MAX_TEXT + 8:
                raise OversizeReply(f"reply file is {size} bytes, over the reply cap")
            return self._git("cat-file", "blob", blob, locked=False)
        except (DeadlineError, OversizeReply):
            raise
        except TransportError as e:  # a local object read: never the network
            raise FileError(str(e), e.rc) from None


def load_config() -> dict:
    p = Path(os.environ.get("CODING_BOT_TRANSPORTS") or state_dir() / "transports.json")
    try:
        cfg = json.loads(p.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    return cfg if isinstance(cfg, dict) else {}


def build_transports(cfg: dict) -> list:
    out = []
    s, g = cfg.get("ssh"), cfg.get("git")
    if isinstance(s, dict) and all(isinstance(s.get(k), str) for k in ("host", "user", "key", "known_hosts", "to_dir", "from_dir")):
        out.append(Ssh(s))
    if isinstance(g, dict) and isinstance(g.get("path"), str):
        out.append(Git(g))
    return out


# Health: one JSON object {transport: {ewma_s, fails, down_until, last_ok, last_fail, why}}, rewritten atomically
# under a lock (same discipline as the logs), shared by every project's coding-bot.
def update_json(name: str, mutate) -> dict:
    path = state_path(name)
    lock = os.open(f"{path}.lock", os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            data = json.loads(path.read_text(encoding="utf-8", errors="replace")) if path.exists() else {}
        except ValueError:
            data = {}
        if not isinstance(data, dict):
            data = {}
        mutate(data)
        fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{name}.", suffix=".tmp")
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                json.dump(data, f)
                f.flush()
                os.fsync(f.fileno())
            os.replace(tmp, path)
        except BaseException:
            with contextlib.suppress(FileNotFoundError):
                os.unlink(tmp)
            raise
        return data
    finally:
        os.close(lock)


def read_json(name: str) -> dict:
    try:
        data = json.loads((state_dir() / name).read_text(encoding="utf-8", errors="replace"))
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def backoff_s(fails: int, rand=random.random) -> float:
    """15 s, doubling per consecutive failure to a 15 min cap, jittered 0.75-1.25x so concurrent callers spread out.
    The exponent is clamped first: a long outage's failure count must never overflow the float maths."""
    return min(BACKOFF_CAP_S, BACKOFF_BASE_S * 2 ** min(max(0, fails - 1), 16)) * (0.75 + 0.5 * rand())


def note_ok(name: str, secs: float, now: float | None = None, *, put: bool = True) -> None:
    """Record a success. Only a PUT's duration feeds the cost used to rank transports for sending (`ewma_s`): a
    git fetch is cheap and a git push is not, so a poll must not make a transport look fast for sending. Any
    success ends a backoff."""
    now = time.time() if now is None else now

    def m(d: dict) -> None:
        h = d.setdefault(name, {})
        key = "ewma_s" if put else "poll_s"
        prev = h.get(key)
        h[key] = secs if not isinstance(prev, (int, float)) else EWMA_ALPHA * secs + (1 - EWMA_ALPHA) * prev
        h.update(fails=0, down_until=0, last_ok=now, why="")
        if put:
            h["last_put"] = now
    update_json("health.json", m)


def note_fail(name: str, why: str, now: float | None = None) -> None:
    now = time.time() if now is None else now

    def m(d: dict) -> None:
        h = d.setdefault(name, {})
        fails = int(h.get("fails", 0)) + 1 if isinstance(h.get("fails", 0), (int, float)) else 1
        h.update(fails=fails, down_until=now + backoff_s(fails), last_fail=now, why=clean(why)[:120])
    update_json("health.json", m)


def cost(name: str, h: dict, now: float) -> float:
    """Expected seconds: the measured EWMA, decaying to the prior as the measurement goes stale, so a transport
    once measured slow is retried now and then and one never measured is assumed to cost its prior."""
    prior, ewma, last = PRIOR_COST_S.get(name, 5.0), h.get("ewma_s"), h.get("last_put", h.get("last_ok"))
    if not isinstance(ewma, (int, float)) or not isinstance(last, (int, float)):
        return prior
    w = min(1.0, max(0.0, now - last) / STALE_S)
    return (1 - w) * ewma + w * prior


def in_backoff(name: str, health: dict, now: float) -> bool:
    d = health.get(name, {}).get("down_until", 0)
    return isinstance(d, (int, float)) and d > now


def ordered(ts: list, now: float | None = None) -> list:
    """Transports to try: those not in backoff, cheapest first, then those in backoff, soonest-back first. A
    transport whose backoff has ended competes on cost again, which is how traffic returns to the faster one."""
    now = time.time() if now is None else now
    health = read_json("health.json")
    up = sorted((t for t in ts if not in_backoff(t.name, health, now)), key=lambda t: cost(t.name, health.get(t.name, {}), now))
    down = sorted((t for t in ts if in_backoff(t.name, health, now)), key=lambda t: health[t.name]["down_until"])
    return up + down


def put_message(ts: list, mid: str, content: str) -> tuple[str | None, float, list[str], str | None]:
    """Write the message through the first transport that takes it: (name or None, seconds, failure notes, the name of a
    transport where it MAY have landed). A transport in backoff is not tried at all (its backoff ending is what lets it
    compete again), so a full outage costs no connection timeouts and the caller falls back to the webhook at once."""
    notes: list[str] = []
    uncertain: str | None = None
    health, now = read_json("health.json"), time.time()
    for t in ordered(ts, now):
        if in_backoff(t.name, health, now):
            notes.append(f"{t.name}: skipped, in backoff for {health[t.name]['down_until'] - now:.0f}s more")
            continue
        t0 = time.monotonic()
        try:
            t.put(mid, content)
        except TransportError as e:
            if isinstance(e, UncertainPut):
                uncertain = t.name
            note_fail(t.name, str(e))
            notes.append(f"{t.name}: {clean(str(e))[:120]}")
            continue
        secs = time.monotonic() - t0
        note_ok(t.name, secs)
        return t.name, secs, notes, uncertain
    return None, 0.0, notes, uncertain


def message_file(a: argparse.Namespace, mid: str, text: str, nonce: str | None = None) -> str:
    # newlines canonical (\n only): every read-back (`run_cmd`'s text mode) normalizes CR and CRLF, so a stored message
    # must already be in that form, or a delivery check would call a message that landed absent
    text = text.replace("\r\n", "\n").replace("\r", "\n")
    return f"{header(a.sender, mid, a.re, nonce)}\nproject: {project()}\n\n{text}\n"


def heartbeat_gate(force: bool) -> int:
    """0 when a send may go ahead, EXIT_STALE when the bot's last heartbeat is older than
    $CODING_BOT_HEARTBEAT_STALE_S (2700 s) and `force` is off. A heartbeat that was never seen only prints a note (the
    sweep routine may not exist yet). One poll first, only when the recorded heartbeat is missing or stale."""
    stale_s = _env_secs("CODING_BOT_HEARTBEAT_STALE_S", HEARTBEAT_STALE_S)

    def last() -> float | None:
        v = read_json("health.json").get("bot_heartbeat")
        return float(v) if isinstance(v, (int, float)) and not isinstance(v, bool) else None

    hb = last()
    if hb is None or time.time() - hb > stale_s:
        # read ONLY heartbeat.md, one transport at a time (cheapest first), each within a bounded probe, and stop at the
        # first fresh one: no reply backlog and no slow or down fallback can delay or fail the send
        for t in ordered(build_transports(load_config())):
            if in_backoff(t.name, read_json("health.json"), time.time()):
                continue
            PROBE[:] = [time.monotonic() + HEARTBEAT_PROBE_S]
            try:
                if HEARTBEAT_FILE in t.list_files():
                    if why := file_heartbeat(t.read(HEARTBEAT_FILE)):
                        print(f"coding-bot: {t.name}: {why}; ignored", file=sys.stderr)
            except DeadlineError:
                pass  # this probe's own time ran out: not the route's fault
            except (OversizeReply, FileError) as e:  # a bad heartbeat file, not a bad route: no backoff
                print(f"coding-bot: {t.name}: {HEARTBEAT_FILE} not read: {clean(str(e))[:120]}", file=sys.stderr)
            except TransportError as e:  # the route is down: back it off now, so the send does not try it again
                note_fail(t.name, str(e))
                print(f"coding-bot: heartbeat probe on {t.name}: {clean(str(e))[:120]}", file=sys.stderr)
            finally:
                PROBE.clear()
            hb = last()
            if hb is not None and time.time() - hb <= stale_s:
                break
        hb = last()
    if hb is None:
        print("coding-bot: no bot heartbeat has been seen yet; sending without the liveness check", file=sys.stderr)
        return 0
    age = time.time() - hb
    if age <= stale_s:
        return 0
    if force:
        print(f"coding-bot: the bot's heartbeat is {age / 60:.0f} min old; sending anyway (--force)", file=sys.stderr)
        return 0
    return fail(f"coding-bot: the Coding bot's heartbeat is {age / 60:.0f} min old; nothing was sent; `--force` sends "
                "anyway, or use `prompt`", EXIT_STALE)


def do_send(a: argparse.Namespace, text: str, url: str | None, key: str | None,
            receipts=sys.stdout) -> tuple[int, str]:
    """(exit code, message id). With a webhook: the message goes into a drop transport (when any is configured and
    works) and the webhook rings a short doorbell; if no transport takes it the webhook carries the text. Without a
    webhook: the clipboard prompt (EXIT_CLIPBOARD). A stale bot heartbeat refuses before anything is recorded
    (EXIT_STALE; `--force` overrides). Every message gets a random nonce the bot must echo. Receipts go to `receipts`
    (stdout; `ask` passes stderr: its stdout carries only the reply); failures always to stderr."""
    nonce = secrets.token_hex(8)
    base = {"from": a.sender, "project": project(), "re": a.re, "chars": len(text), "nonce": nonce, "text": text}
    if not (url and key):
        mid = append("outbox.jsonl", {**base, "via": "clipboard", "why": "no webhook configured"}, number=ID_PREFIX)
        rc = clipboard_or_3(mid, pasteable(a.sender, mid, a.re, text, nonce))
        if rc == 0:
            print(f"{mid}: no webhook configured ({URL_NAME}/{KEY_NAME}); the prompt is on the clipboard: "
                  "the operator pastes it into the Coding bot, then `coding-bot deliver --clipboard` files its reply",
                  file=receipts)
        return (rc or EXIT_CLIPBOARD), mid
    if (why := check_url(url)):
        return fail(why, 1), ""
    if (gate := heartbeat_gate(bool(getattr(a, "force", False)))):
        return gate, ""
    # Record first: the id is allocated under the lock, and a send that dies mid-flight still shows.
    mid = append("outbox.jsonl", {**base, "via": "webhook"}, number=ID_PREFIX)
    via, secs, notes, uncertain = put_message(build_transports(load_config()), mid, message_file(a, mid, text, nonce))
    payload = {k: base[k] for k in ("from", "project", "re", "nonce")} | {"id": mid}
    if via:
        payload["text"] = (f"New message {mid} from {a.sender} ({project()}). Read {mid}.md ({via}); "
                           "the message is in that file, not in this line.")
        payload["paths"] = [via]
    else:
        payload["text"] = text
    ok, detail = ring(url, key, payload)
    where = f" via {via} {secs:.1f}s" if via else ""
    append("outbox.jsonl", {"result_for": mid, "ok": ok, "detail": detail + where, "put": via, "put_s": round(secs, 2),
                            "put_failures": notes, "stored": True if via else ("uncertain" if uncertain else False)})
    for n in notes:
        print(f"coding-bot: transport {n}", file=sys.stderr)
    if not ok and not via and uncertain:
        # it may be sitting in the drop, where the sweep would find it: telling the caller "nothing stored" invites a second
        # copy of the task under another id. `wait` reports exit 5 if nothing ever picks it up.
        print(f"{mid}: delivery uncertain: the {uncertain} connection broke mid-write and the doorbell failed ({detail}). "
              f"Do NOT send it again; `coding-bot wait {mid}` (exit 5 means it was never picked up).", file=sys.stderr)
        print(f"{mid}: delivery uncertain ({uncertain}); doorbell failed", file=receipts)
        return 0, mid
    if not ok and via:
        # the message is stored durably and the bot's 15-minute sweep will pick it up: that is a send, not a failure.
        # Sending it again would run the task twice under two ids.
        print(f"{mid}: stored in {via}{where}; the doorbell failed ({detail}), so the bot's sweep picks it up within about "
              f"15 minutes. Do NOT send it again; `coding-bot wait {mid}`.", file=sys.stderr)
        print(f"{mid}: stored{where}; doorbell failed", file=receipts)
        return 0, mid
    print(f"{mid}: {detail}{where}", file=receipts if ok else sys.stderr)
    return (0 if ok else 1), mid


def ring(url: str, key: str, payload: dict) -> tuple[bool, str]:
    """The webhook call, retried twice more (1 s, then 2 s; $CODING_BOT_RETRY_S scales it) on a 429, a 5xx or no
    answer. Any other refusal (a 4xx: wrong key, paused routine) is final at once."""
    pause = _env_secs("CODING_BOT_RETRY_S", 1.0)
    for attempt in range(3):
        ok, detail = webhook_post(url, key, payload)
        code = re.search(r"HTTP (\d{3})", detail)
        if ok or (code and code.group(1).startswith("4") and code.group(1) != "429"):
            return ok, detail
        if attempt < 2:
            time.sleep(pause * (attempt + 1))
    return ok, detail


def cmd_send(a: argparse.Namespace) -> int:
    url, key = channel()
    text = task_text(a.text, (url, key))
    return text if isinstance(text, int) else do_send(a, text, url, key)[0]


def cmd_prompt(a: argparse.Namespace) -> int:
    text = task_text(a.text, channel())
    if isinstance(text, int):
        return text
    nonce = secrets.token_hex(8)
    mid = append("outbox.jsonl", {"from": a.sender, "project": project(), "re": a.re, "chars": len(text),
                                  "nonce": nonce, "text": text, "via": "clipboard"}, number=ID_PREFIX)
    rc = clipboard_or_3(mid, pasteable(a.sender, mid, a.re, text, nonce))
    if rc == 0:
        print(f"{mid}: prompt is on the clipboard ({len(text)} chars of task); the reply should start "
              f"`[coding -> {a.sender}] id=coding-N re={mid} nonce={nonce}`; file it with `coding-bot deliver --clipboard`")
    return rc


def cmd_bootstrap(a: argparse.Namespace) -> int:
    rc = clipboard_or_3("bootstrap", SWEEP_BOOTSTRAP if a.sweep else BOOTSTRAP)
    if rc == 0 and a.sweep:
        print("sweep prompt is on the clipboard. Paste it into the Coding bot: it replaces the instruction of "
              '"Agent inbound" and creates the 15-minute "Agent sweep" routine that writes heartbeat.md. It needs '
              "no secret; the bot must not paste any.")
    elif rc == 0:
        print("bootstrap prompt is on the clipboard. Paste it into the Coding bot. Then store its webhook "
              f"URL and key one at a time, never in chat (SKILL.md: {URL_NAME}, {KEY_NAME}).")
    return rc


def last_line(text: str) -> str:
    return next((ln.strip() for ln in reversed(text.split("\n")) if ln.strip()), "")


def header_field(text: str, name: str) -> str | None:
    """`name=value` from a first line that looks like a protocol header (starts with `[`) but did not match REPLY_HEADER
    exactly (fields reordered or extra): its nonce and re are still checked, never ignored."""
    first = text.split("\n", 1)[0].strip()
    if not first.startswith("["):
        return None
    f = re.search(rf"(?:^|\s){name}=(\S+)", first)
    return f.group(1) if f else None


def file_reply(raw: str, hint: str | None, *, from_drop: bool = False) -> tuple[int, str, bool]:
    """The one sink for a reply, from `deliver` or a drop transport: (rc, message, newly_filed). rc 0 is filed or a
    duplicate, 2 is refused. `hint` is the ade-N the caller knows it answers (--re, or the reply file's name). When the
    message has a nonce, a reply with another one is refused. One with none is refused when it comes `from_drop` (a file
    named for the id proves nothing: ids restart, mailboxes are shared, anyone with write access can pre-write one); from
    `deliver` (the operator's paste) it is filed with `nonce_ok: false`."""
    if len(raw) > MAX_TEXT:  # the raw size, before cleaning or stripping can shrink it
        return 2, f"the reply is over {MAX_TEXT} characters; not filed", False
    text = clean(raw).strip()
    if not text:
        return 2, "empty reply", False
    m = REPLY_HEADER.match(text)  # the header must be the reply's first line, not a quotation further down
    said_re = m.group(2) if m else header_field(text, "re")  # a header with its fields out of order still counts
    if hint and said_re and said_re != hint:
        return 2, f"the header says re={said_re} but the reply is for {hint}", False
    rid = hint or (m.group(2) if m else None)
    if not rid:
        return 2, ("the reply does not start with `[coding -> FROM] id=coding-N re=ade-N`; pass --re ID "
                   "to file a reply that has no header"), False
    rec = next((r for r in records("outbox.jsonl") if r.get("id") == rid), None)
    if rec is None:
        return 2, f"{rid} is not in the outbox ({state_dir() / 'outbox.jsonl'})", False
    nonce_ok = nonce_check(rec, m.group(3) if m else header_field(text, "nonce"))
    if nonce_ok == "mismatch":
        return 2, f"nonce mismatch: the reply's nonce is not the one sent with {rid}; not filed", False
    if nonce_ok is False and from_drop:
        return 2, f"no nonce: a reply file must echo the nonce sent with {rid}; not filed", False
    sha = hashlib.sha256(text.encode()).hexdigest()
    filed = records("inbox.jsonl")
    terminal = bool(TERMINAL.match(last_line(text)))
    if terminal and any(r.get("re") == rid and r.get("terminal") and r.get("sha") != sha for r in filed):
        print(f"coding-bot: {rid} already has a final reply; this one supersedes it (`wait` returns the latest)",
              file=sys.stderr)
    extra = {} if nonce_ok is None else {"nonce_ok": nonce_ok}
    loose_id = header_field(text, "id")  # a reordered header still names its revision, so ordering keeps working
    bot_id = m.group(1) if m else (loose_id if loose_id and BOT_ID_RE.fullmatch(loose_id) else None)
    added = append("inbox.jsonl", {"re": rid, "bot_id": bot_id, "sha": sha, "text": text,
                                   "terminal": terminal, **extra},
                   # the duplicate check runs under the inbox lock: two pollers cannot both file one reply
                   unless=lambda recs: any(r.get("re") == rid and r.get("sha") == sha for r in recs))
    if added is None:  # the same text may answer another task, so the check is per id
        return 0, f"{rid}: this reply is already filed", False
    return 0, f"{rid}: reply filed ({len(text)} chars)", True


def nonce_check(rec: dict, got: str | None) -> bool | str | None:
    """None: the outbox record has no nonce (an older message), nothing to check. True: `got` is its nonce. False: the
    bot echoed none. "mismatch": it echoed another one. Constant-time comparison."""
    want = rec.get("nonce")
    if not isinstance(want, str) or not want:
        return None
    if not got:
        return False
    return True if hmac.compare_digest(got.encode(), want.encode()) else "mismatch"


def cmd_deliver(a: argparse.Namespace) -> int:
    raw = paste() if a.clipboard else sys.stdin.read(MAX_TEXT + 1)
    if raw is None:
        return fail("deliver: could not read the clipboard", 3)
    rc, msg, _ = file_reply(raw, a.re)
    print(msg if rc == 0 else f"deliver: {msg}", file=sys.stdout if rc == 0 else sys.stderr)
    return rc


def reply_order(fname: str) -> tuple[int, int]:
    """ade-N--coding-K.md sorted by (N, K) as numbers, so coding-10 comes after coding-9."""
    m = re.fullmatch(r"ade-(\d+)--coding-(\d+)\.md", fname)
    return (int(m.group(1)), int(m.group(2))) if m else (0, 0)


def scan_order(fname: str, fid: str | None, prefer: str | None) -> tuple:
    """The waited-for id's files first, its NEWEST revision first (so the early return after its final reply never
    stops on an older one); then everything else oldest first."""
    _, k = reply_order(fname)
    return (0, -k) if prefer and fid == prefer else (1, *reply_order(fname))


def bot_num(rec: dict) -> int | None:
    m = re.fullmatch(r"coding-(\d{1,9})", str(rec.get("bot_id") or ""))
    return int(m.group(1)) if m else None


def final_reply(replies: list[dict]) -> dict | None:
    """The reply `wait` returns: the latest final one, except that a bot reply never supersedes a final reply the bot
    numbered higher (an older revision imported late must not win). A headerless reply (the operator's `deliver`)
    supersedes by arrival order as before."""
    best = None
    for r in replies:
        if not r.get("terminal"):
            continue
        n, bn = bot_num(r), bot_num(best) if best else None
        if best is None or n is None or bn is None or n >= bn:
            best = r
    return best


def prune_seen(name: str, listed: list[str]) -> None:
    """Forget seen and partial entries for files no longer listed, so the state never grows without bound."""
    keep = set(listed)
    cur = read_json("seen.json")
    stale = [n for n in cur.get(name, []) if n not in keep] if isinstance(cur.get(name), list) else []
    p, fo = cur.get(f"{name}#partial"), cur.get(f"{name}#foreign")
    if (not stale and not (isinstance(p, dict) and any(n not in keep for n in p))
            and not (isinstance(fo, list) and any(n not in keep for n in fo))):
        return  # nothing to forget: no write

    def m(d: dict) -> None:
        if isinstance(d.get(name), list):
            d[name] = [n for n in d[name] if n in keep]
        if isinstance(d.get(f"{name}#partial"), dict):
            d[f"{name}#partial"] = {n: v for n, v in d[f"{name}#partial"].items() if n in keep}
        if isinstance(d.get(f"{name}#foreign"), list):
            d[f"{name}#foreign"] = [n for n in d[f"{name}#foreign"] if n in keep]
    update_json("seen.json", m)


# refusals that prove a file was read and belongs to another message (not unreadable, not half-written): such a file is
# never evidence that the waited-for message was picked up
FOREIGN_REFUSALS = ("nonce mismatch", "no nonce", "the header says re=")


def note_foreign(name: str, fname: str) -> None:
    def m(d: dict) -> None:
        f = d.get(f"{name}#foreign")
        if not isinstance(f, list):
            f = d[f"{name}#foreign"] = []
        if fname not in f:
            f.append(fname)
    update_json("seen.json", m)


def note_partial(name: str, fname: str) -> None:
    def m(d: dict) -> None:
        p = d.get(f"{name}#partial")
        if not isinstance(p, dict):
            p = d[f"{name}#partial"] = {}
        p[fname] = time.time()
    update_json("seen.json", m)


def mark_seen(name: str, fname: str) -> None:
    def m(d: dict) -> None:
        names = d.setdefault(name, [])
        if isinstance(names, list) and fname not in names:
            names.append(fname)
    update_json("seen.json", m)


def parse_iso_utc(s: str) -> float | None:
    """Epoch seconds of an ISO 8601 time (no zone means UTC), or None."""
    try:
        t = dt.datetime.fromisoformat(s.strip())
        return (t if t.tzinfo else t.replace(tzinfo=dt.timezone.utc)).timestamp()
    except (ValueError, OverflowError, OSError):
        return None


def file_claim(rid: str, raw: str, via: str) -> tuple[int, str]:
    """Record the bot's pickup of `rid` in claims.json (the first claim stays): (rc, message), rc 2 is refused. A claim
    must echo the message's nonce (when it has one): another one or none is refused."""
    first = clean(raw).strip().split("\n", 1)[0].strip()
    m = CLAIM_LINE.fullmatch(first)
    if not m or m.group(1) != rid:
        return 2, f"not a claim line for {rid}"
    rec = next((r for r in records("outbox.jsonl") if r.get("id") == rid), None)
    if rec is None:
        return 2, f"{rid} is not in the outbox"
    nonce_ok = nonce_check(rec, m.group(4))
    if nonce_ok == "mismatch":
        return 2, f"nonce mismatch: the claim's nonce is not the one sent with {rid}"
    if nonce_ok is False:
        return 2, f"no nonce: a claim must echo the nonce sent with {rid}"

    def mutate(d: dict) -> None:
        e = d.get(rid)
        if not isinstance(e, dict):
            e = d[rid] = {}
        if not isinstance(e.get("claim"), dict):
            e["claim"] = {"by": m.group(2), "at": m.group(3), "seen": time.time(), "via": via, "nonce_ok": nonce_ok}
    update_json("claims.json", mutate)
    return 0, f"{rid}: claimed by {m.group(2)}"


def file_heartbeat(raw: str) -> str | None:
    """Keep the newest heartbeat time in health.json (`bot_heartbeat`, epoch seconds). None, or why it was ignored."""
    ts = parse_iso_utc(clean(raw).strip().split("\n", 1)[0])
    if ts is None:
        return f"{HEARTBEAT_FILE} does not hold an ISO 8601 time"
    if ts > time.time() + HEARTBEAT_SKEW_S:
        return f"{HEARTBEAT_FILE} is dated in the future"

    def mutate(d: dict) -> None:
        cur = d.get("bot_heartbeat")
        if isinstance(cur, bool) or not isinstance(cur, (int, float)) or ts > cur:
            d["bot_heartbeat"] = ts
    update_json("health.json", mutate)
    return None


HEARTBEAT_READ_AT: dict[str, float] = {}


def file_id(name: str) -> str | None:
    """The ade-N a bot file belongs to (a reply or a claim), or None (the heartbeat)."""
    m = re.match(r"(?:claim-)?(ade-\d{1,9})", name)
    return m.group(1) if m else None


def poll_transports(ts: list, force: bool = False, prefer: str | None = None, read_ok: set | None = None,
                    evidence: set | None = None) -> int:
    """List each transport's bot files in numeric order: file the replies and claims not seen before and read the
    heartbeat (at most every HEARTBEAT_READ_EVERY_S per transport: the file is rewritten in place, so it is never marked
    seen). A transport in backoff is skipped unless `force`. A file is marked seen only once it is settled: a claim, a
    final reply (filed or a duplicate) or a permanent refusal. An empty or unfinished reply (no DONE/BLOCKED last line) is
    read again next time, so a reply caught mid-write is never lost. The files of `prefer` (the id a `wait` is for) are
    read first, so older unfinished replies to other ids can never use up a poll's time before it. Returns how many
    replies were newly filed."""
    new, health, now = 0, read_json("health.json"), time.time()
    for t in ts:
        if not force and in_backoff(t.name, health, now):
            continue
        t0 = time.monotonic()
        try:
            names = sorted(t.list_files(), key=lambda n: scan_order(n, file_id(n), prefer))
            if evidence is not None and prefer:
                # a claim or reply file for the waited id is proof of pickup even if it cannot be read, unless it was read
                # and shown to belong to another message (another nonce: an older message that reused the id)
                foreign = set(read_json("seen.json").get(f"{t.name}#foreign", []))
                evidence.update(f"{t.name}:{n}" for n in names if file_id(n) == prefer and n not in foreign)
            done_early = False
            prune_seen(t.name, names)
            seen = read_json("seen.json")
            done = set(seen.get(t.name, []))
            partial = seen.get(f"{t.name}#partial", {})
            budget = MAX_FILES_PER_POLL
            for fname in names:
                if read_ok is not None and prefer and file_id(fname) != prefer:
                    # the waited id's files sort first and are all handled: this route counts as read for pickup, so a
                    # backlog for other ids can never hold off "not picked up"
                    read_ok.add(t.name)
                if fname == HEARTBEAT_FILE or fname in done:
                    continue
                last_partial = partial.get(fname) if isinstance(partial, dict) else None
                if (file_id(fname) != prefer and isinstance(last_partial, (int, float))
                        and time.time() - last_partial < PARTIAL_REREAD_S):
                    continue  # an unfinished reply to another id: not read again on every poll
                if budget <= 0:
                    break  # the rest wait for the next poll
                budget -= 1
                what = "claim file" if CLAIM_FILE.fullmatch(fname) else "reply file"
                try:
                    raw = t.read(fname)
                except (OversizeReply, FileError) as e:
                    print(f"coding-bot: {what} {t.name}:{fname} not filed: {e}", file=sys.stderr)
                    mark_seen(t.name, fname)
                    continue
                # a file is judged for good only once it is complete: a reply ends DONE or BLOCKED, a claim ends its line.
                # One caught mid-write (even inside its header, where the nonce may be cut short) is read again later
                # (at most every PARTIAL_REREAD_S for another id), and a refusal of it proves nothing yet
                if cm := CLAIM_FILE.fullmatch(fname):
                    rc, msg = file_claim(cm.group(1), raw, t.name)
                    final = rc == 0 or raw.endswith("\n")
                else:
                    rc, msg, filed = file_reply(raw, REPLY_FILE.fullmatch(fname).group(1), from_drop=True)
                    new += filed
                    final = bool(TERMINAL.match(last_line(clean(raw).strip())))
                settled = final
                if rc:
                    print(f"coding-bot: {what} {t.name}:{fname} not filed: {msg}", file=sys.stderr)
                if rc and settled and msg.startswith(FOREIGN_REFUSALS):
                    note_foreign(t.name, fname)  # read and shown to be another message's: not pickup evidence
                    if evidence is not None:
                        evidence.discard(f"{t.name}:{fname}")
                if settled:
                    mark_seen(t.name, fname)
                else:
                    note_partial(t.name, fname)
                if prefer and rc == 0 and not cm and final and file_id(fname) == prefer:
                    done_early = True
                    break  # the waited-for answer is filed: hand back to the waiter before reading other ids
            # the heartbeat is refreshed only when the waiter is not about to be handed its answer
            if (not done_early and HEARTBEAT_FILE in names
                    and time.monotonic() - HEARTBEAT_READ_AT.get(t.name, -1e9) >= HEARTBEAT_READ_EVERY_S):
                HEARTBEAT_READ_AT[t.name] = time.monotonic()
                try:
                    why = file_heartbeat(t.read(HEARTBEAT_FILE))
                except (OversizeReply, FileError) as e:
                    why = str(e)
                if why:
                    print(f"coding-bot: {t.name}: {why}; ignored", file=sys.stderr)
        except DeadlineError:
            break
        except TransportError as e:
            note_fail(t.name, str(e))
            print(f"coding-bot: transport {t.name}: {clean(str(e))[:120]}", file=sys.stderr)
            continue
        note_ok(t.name, time.monotonic() - t0, put=False)
        if read_ok is not None:
            read_ok.add(t.name)  # this transport's files were actually listed and read
    return new


def cmd_sync(a: argparse.Namespace) -> int:
    ts = build_transports(load_config())
    if not ts:
        print("coding-bot: no drop transports configured (transports.json); nothing to sync")
        return 0
    DEADLINE[:] = [time.monotonic() + SYNC_DEADLINE_S]  # a slow route cannot hold `sync` for N files x the timeout
    try:
        n = poll_transports(ts, force=a.force)
    finally:
        DEADLINE.clear()
    print(f"coding-bot: {n} new reply(ies) filed from {', '.join(t.name for t in ts)}")
    return 0


def sent_age_s(rec: dict | None) -> float:
    """Seconds since the outbox record was written (0 when unknown)."""
    try:
        return max(0.0, time.time() - dt.datetime.strptime(str((rec or {}).get("ts")), "%Y-%m-%dT%H:%M:%S%z").timestamp())
    except ValueError:
        return 0.0


def escalate(rid: str, kind: str, rec: dict | None, minutes: float) -> None:
    """Ping Hermes once per id and kind ("not picked up", "no reply"): the slot is taken in claims.json before the call,
    so a second `wait` (or a racing one) stays quiet. Nothing here may change the caller's exit code."""
    taken: list[bool] = []

    def mutate(d: dict) -> None:
        e = d.get(rid)
        if not isinstance(e, dict):
            e = d[rid] = {}
        esc = e.get("escalations")
        if not isinstance(esc, dict):
            esc = e["escalations"] = {}
        if kind not in esc:
            esc[kind] = time.time()
            taken.append(True)
    try:
        update_json("claims.json", mutate)
    except OSError as e:
        print(f"coding-bot: could not record the escalation ({e.strerror or type(e).__name__}); not pinging", file=sys.stderr)
        return
    if not taken:
        return
    exe = os.environ.get("CODING_BOT_HERMES_PING") or shutil.which("hermes-ping")
    if not exe or not os.access(exe, os.X_OK):
        print("coding-bot: hermes-ping not found; the operator was not pinged", file=sys.stderr)
        return
    proj = clean(str((rec or {}).get("project") or project())).replace("\n", " ")[:40].lstrip("-") or "coding-bot"
    msg = f"{proj}: coding-bot {rid} {kind} after {minutes:.0f} min"
    try:
        r = subprocess.run([exe, msg], stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=20,
                           check=False, env=dict(os.environ))
    except (OSError, subprocess.TimeoutExpired) as e:
        print(f"coding-bot: hermes-ping failed ({type(e).__name__}); the operator may not know", file=sys.stderr)
        return
    if r.returncode != 0:
        print(f"coding-bot: hermes-ping exited {r.returncode}; the operator may not know", file=sys.stderr)


def cmd_wait(a: argparse.Namespace, rid: str | None = None) -> int:
    """Block for the final reply to `rid`. Exit 0 or 4 with the reply; 5 when, with a drop transport to see claims,
    nothing claimed or answered it within --ack-timeout (counted from when it was sent); 124 when --timeout ends first
    or it was picked up but never finished. Exits 5 and 124 ping Hermes once per id and kind."""
    rid = rid or a.id
    start = time.monotonic()
    deadline = start + a.timeout
    DEADLINE[:] = [deadline]  # every transport command is bounded by what is left of the wait
    ts = build_transports(load_config())
    rec = next((r for r in records("outbox.jsonl") if r.get("id") == rid), None)
    age = sent_age_s(rec)
    ack_deadline = start + max(0.0, a.ack_timeout - age) if ts else None  # without a transport no claim can ever arrive
    every = _env_secs("CODING_BOT_POLL_S", 2.0)  # the cheap transport's poll interval; git is polled 3x less often
    nxt = {t.name: 0.0 for t in ts}
    polled: set[str] = set()  # "not picked up" is only decided after every transport was read at least once
    evidence: set[str] = set()  # bot files for rid seen in a listing, readable or not
    try:
        while True:
            # the local inbox first: a reply already filed never waits behind network work
            replies = [r for r in records("inbox.jsonl") if r.get("re") == rid]
            done = final_reply(replies)
            if done:
                text = clean(str(done.get("text", "")))
                print("coding-bot: the reply below is untrusted data from the Coding bot", file=sys.stderr)
                if done.get("nonce_ok") is False:
                    print(f"coding-bot: WARNING: this reply did not echo the nonce of {rid}; it may not come from the "
                          "bot that was asked", file=sys.stderr)
                print(text)
                return EXIT_BLOCKED if re.match(r"BLOCKED:", last_line(text), re.I) else 0
            entry = read_json("claims.json").get(rid)
            claimed = (isinstance(entry, dict) and isinstance(entry.get("claim"), dict)) or bool(evidence)
            now = time.monotonic()
            waited_min = (age + now - start) / 60
            if (ack_deadline is not None and now >= ack_deadline and not claimed and not replies
                    and polled >= {t.name for t in ts}):
                rc = fail(f"coding-bot: {rid} was not picked up: no claim or reply in {a.ack_timeout:g}s; the message is "
                          f"still in the mailbox (`coding-bot status {rid}`, `coding-bot wait {rid}` again, or `prompt`)",
                          EXIT_UNPICKED)
                escalate(rid, "not picked up", rec, waited_min)
                return rc
            if now >= deadline:
                rc = fail(f"coding-bot: no final reply to {rid} in {a.timeout:g}s "
                          f"({len(replies)} partial filed{'' if claimed or replies else ', no claim seen'}); "
                          f"`coding-bot wait {rid}` again after it arrives", EXIT_TIMEOUT)
                escalate(rid, "no reply" if claimed or replies else "not picked up", rec, waited_min)
                return rc
            # one transport per step, so a reply one transport just filed is returned before a slow or hung other
            # transport is asked; the most overdue goes first (ties: the cheaper one), and its next turn is counted from
            # when its poll ENDED, so a slow poll can never starve the other transport
            due_now = [t for t in ordered(ts) if now >= nxt[t.name]]
            due = min(due_now, key=lambda t: nxt[t.name]) if due_now else None
            if due:
                # this poll gets an even share of what is left, so a stalled route cannot use up the time the other
                # route needs to be checked (the next step polls the other one)
                # while no pickup is known, the ack deadline is the horizon, so other ids' backlog cannot delay exit 5
                # (only before it passes: after that, polls get their full share so a slow listing can still finish)
                horizon = min(deadline, ack_deadline) if (ack_deadline is not None and ack_deadline > now
                                                          and not claimed and not replies) else deadline
                share = (horizon - now) / max(1, len(ts))
                PROBE[:] = [now + max(1.0, share)]
                read_ok: set[str] = set()
                try:
                    poll_transports([due], prefer=rid, read_ok=read_ok, evidence=evidence)
                finally:
                    PROBE.clear()
                # only the LATEST poll of a route counts: a route that failed or was skipped (backoff) since it was last read
                # could be holding a claim right now, so it is unchecked again and "not picked up" must wait for it
                polled.discard(due.name)
                polled |= read_ok
                nxt[due.name] = time.monotonic() + every * (1 if due.name == "ssh" else 3)
                continue  # look at the inbox again at once
            time.sleep(min(0.5, max(0.05, min(deadline, ack_deadline or deadline) - time.monotonic())))
    finally:
        DEADLINE.clear()


def cmd_ask(a: argparse.Namespace) -> int:
    url, key = channel()
    text = task_text(a.text, (url, key))
    if isinstance(text, int):
        return text
    rc, mid = do_send(a, text, url, key, receipts=sys.stderr)
    if rc != 0:
        return rc
    print(f"coding-bot: waiting up to {a.timeout:g}s for the reply to {mid} (`coding-bot deliver` files it)",
          file=sys.stderr)
    return cmd_wait(a, mid)


def cmd_inbox(a: argparse.Namespace) -> int:
    for r in records("inbox.jsonl")[-a.n:] if a.n > 0 else []:
        first = clean(next((ln for ln in str(r.get("text", "")).split("\n") if ln.strip()), ""))
        print(f"{r.get('ts', '?')} re={r.get('re', '?')} {'final' if r.get('terminal') else 'partial'} {first[:100]}")
    return 0


def cmd_status(a: argparse.Namespace) -> int:
    url, key = channel()
    for name, v in ((URL_NAME, url), (KEY_NAME, key)):
        print(f"{name}: " + (f"set (len {len(v)})" if v else "not set"))
    if url:
        print("webhook host: " + (check_url(url) or "ok"))
    out, inn = records("outbox.jsonl"), records("inbox.jsonl")
    print(f"outbox: {sum('id' in r for r in out)} messages, inbox: {len(inn)} replies ({state_dir()})")
    for r in out[-5:]:
        print("  " + (f"{r['id']} {r.get('ts', '?')} {r.get('via', '?')} from={clean(str(r.get('from', '?')))} "
                      f"project={clean(str(r.get('project', '?')))}" if "id" in r
                      else f"  result of {r.get('result_for', '?')}: {clean(str(r.get('detail', '?')))}"))
    ts, health, now = build_transports(load_config()), read_json("health.json"), time.time()
    hb = health.get("bot_heartbeat")
    if isinstance(hb, (int, float)) and not isinstance(hb, bool):
        stale = now - hb > _env_secs("CODING_BOT_HEARTBEAT_STALE_S", HEARTBEAT_STALE_S)
        print(f"bot heartbeat: {max(0.0, now - hb) / 60:.0f} min old" + (" (STALE: a send refuses without --force)" if stale else ""))
    else:
        print("bot heartbeat: never seen")
    print("transports: " + ("none configured" if not ts else "preferred first"))
    for t in ordered(ts, now):
        h = health.get(t.name, {})
        measured = isinstance(h.get("ewma_s"), (int, float))
        line = f"  {t.name}: cost {cost(t.name, h, now):.1f}s ({'measured' if measured else 'prior'})"
        if in_backoff(t.name, health, now):
            line += f", IN BACKOFF {h['down_until'] - now:.0f}s more after {h.get('fails', '?')} failure(s): {clean(str(h.get('why', '')))}"
        print(line)
    return history(a.id, out, inn) if a.id else 0


def iso_local(epoch: object) -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%S%z", time.localtime(epoch)) if isinstance(epoch, (int, float)) else "?"


def history(rid: str, out: list[dict], inn: list[dict]) -> int:
    """`status ade-N`: when it was sent and through what, whether and when the bot claimed it, its replies, the pings."""
    rec = next((r for r in out if r.get("id") == rid), None)
    if rec is None:
        return fail(f"{rid}: not in the outbox", 2)
    res = next((r for r in reversed(out) if r.get("result_for") == rid), {})
    print(f"{rid}: sent {rec.get('ts', '?')} via {clean(str(res.get('put') or rec.get('via', '?')))} "
          f"({clean(str(res.get('detail', 'no result recorded')))}); nonce {'sent' if rec.get('nonce') else 'none (older message)'}")
    entry = read_json("claims.json").get(rid)
    entry = entry if isinstance(entry, dict) else {}
    c = entry.get("claim")
    if isinstance(c, dict):
        ok = {True: "echoed", False: "NOT echoed", None: "not checked"}.get(c.get("nonce_ok"), "?")
        print(f"  claimed: at {clean(str(c.get('at', '?')))} by {clean(str(c.get('by', '?')))}, first seen "
              f"{iso_local(c.get('seen'))} via {clean(str(c.get('via', '?')))}, nonce {ok}")
    else:
        print("  claimed: no")
    rs = [r for r in inn if r.get("re") == rid]
    print(f"  replies: {len(rs)} ({sum(bool(r.get('terminal')) for r in rs)} final, {sum(not r.get('terminal') for r in rs)} partial)")
    for r in rs:
        print(f"    {r.get('ts', '?')} {clean(str(r.get('bot_id') or '?'))} {'final' if r.get('terminal') else 'partial'}"
              + (" nonce NOT echoed" if r.get("nonce_ok") is False else ""))
    esc = entry.get("escalations")
    for kind, t in (esc.items() if isinstance(esc, dict) else []):
        print(f"  escalated: {clean(str(kind))} at {iso_local(t)}")
    if not isinstance(esc, dict) or not esc:
        print("  escalations: none")
    return 0


def main(argv: list[str]) -> int:
    p = argparse.ArgumentParser(prog="coding-bot", description=__doc__.split("\n\n")[0], allow_abbrev=False)
    p.add_argument("--from", dest="sender", default=os.environ.get("CODING_BOT_FROM", DEFAULT_FROM),
                   type=name_arg(NAME_RE, "agent name (letters, digits, . _ -)"),
                   help="who is asking (header and payload `from`), default claude-code; goes BEFORE the subcommand")
    sub = p.add_subparsers(dest="cmd", required=True)
    for name, fn, helptext in (("ask", cmd_ask, "send, then block for the reply"),
                               ("send", cmd_send, "send (webhook, else clipboard exit 10), do not wait"),
                               ("prompt", cmd_prompt, "clipboard prompt, always")):
        s = sub.add_parser(name, help=helptext, allow_abbrev=False)
        s.add_argument("--re", type=name_arg(BOT_ID_RE, "bot message id (coding-N)"),
                       help="id of the bot message this answers (coding-N)")
        if name != "prompt":
            s.add_argument("--force", action="store_true", help="send even when the bot's heartbeat is stale (exit 6)")
        if name == "ask":
            s.add_argument("--timeout", type=finite_secs, default=REPLY_TIMEOUT_S,
                           help=f"seconds to wait for the final reply (default {REPLY_TIMEOUT_S:g}, longer than --ack-timeout)")
            s.add_argument("--ack-timeout", type=finite_secs, default=ACK_TIMEOUT_S,
                           help="seconds without a claim or reply before exit 5 (default 1800)")
        s.add_argument("text", help="the task, or - for stdin")
        s.set_defaults(fn=fn)
    w = sub.add_parser("wait", help="block for the reply to ID", allow_abbrev=False)
    w.add_argument("id", type=name_arg(OUT_ID_RE, "message id (ade-N)"))
    w.add_argument("--timeout", type=finite_secs, default=REPLY_TIMEOUT_S)
    w.add_argument("--ack-timeout", type=finite_secs, default=ACK_TIMEOUT_S,
                   help="seconds without a claim or reply before exit 5 (default 1800)")
    w.set_defaults(fn=cmd_wait)
    d = sub.add_parser("deliver", help="file a reply (stdin or --clipboard)", allow_abbrev=False)
    d.add_argument("--clipboard", action="store_true")
    d.add_argument("--re", type=name_arg(OUT_ID_RE, "message id (ade-N)"),
                   help="the ade-N it answers, when its header has none")
    d.set_defaults(fn=cmd_deliver)
    i = sub.add_parser("inbox", help="list filed replies", allow_abbrev=False)
    i.add_argument("-n", type=int, default=10)
    i.set_defaults(fn=cmd_inbox)
    bs = sub.add_parser("bootstrap", help="clipboard: ask the bot to create its inbound webhook", allow_abbrev=False)
    bs.add_argument("--sweep", action="store_true",
                    help="ask for the scheduled \"Agent sweep\" routine (heartbeat) and the new \"Agent inbound\" instruction")
    bs.set_defaults(fn=cmd_bootstrap)
    st = sub.add_parser("status", help="channels, bot heartbeat, transport health, recent outbox; ID: one message's history",
                        allow_abbrev=False)
    st.add_argument("id", nargs="?", type=name_arg(OUT_ID_RE, "message id (ade-N)"))
    st.set_defaults(fn=cmd_status)
    sy = sub.add_parser("sync", help="fetch replies from the drop transports once", allow_abbrev=False)
    sy.add_argument("--force", action="store_true", help="also try a transport that is in backoff")
    sy.set_defaults(fn=cmd_sync)
    scrub_network_env()
    a = p.parse_args(argv)
    if needs_credentials(a.cmd):
        reexec_under_run(argv)
    take_credentials()
    for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
        # an exit, not a silent death: `run_cmd` then kills and reaps the child git or ssh before any lock is let go
        signal.signal(sig, lambda n, _f: sys.exit(128 + n))
    return a.fn(a)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

#!/usr/bin/env python3
"""ade-retro: a read-only raw report for a retrospective over a date window (2026-11-04).

usage: ade-retro --since YYYY-MM-DD [--until YYYY-MM-DD] [--repo OWNER/NAME] [--root DIR] [--json]

  --since D   first day of the window (required, inclusive).
  --until D   last day of the window (inclusive; default: today).
  --repo R    GitHub OWNER/NAME for the merged-PR query (default: parsed from the `origin` remote of --root).
  --root DIR  repository checkout to read changelog.d/, CHANGELOG.md, docs/handoffs/ and git history from
              (default: the checkout this script is in).
  --json      print JSON instead of Markdown:
              {tool, repo, since, until, prs, changelog:[{section, text, pr, prs, source}], handoffs:[{path, date, title}], notes}
              (`prs`: every number of the entry's final group; `pr`: the last of them in the window)

Sources, all read-only (this tool writes nothing anywhere):
  * merged PRs: REST search, `gh api -X GET search/issues -f q="repo:R is:pr is:merged merged:SINCE..UNTIL" --paginate`
    (no GraphQL: `gh pr list` returns 403 in cloud sessions; no headRefName; search caps at 1000 results, noted);
    a PR's title is kept only when its author_association is OWNER, MEMBER or COLLABORATOR, otherwise it reads
    "(title withheld: author association X)": a title is remote text an agent reads (2026-11-05, PR 289);
    each JSON PR also carries `association`;
  * changelog entries whose trailing `(#N)` (or `(DATE, #N)`, or `(#N, #M)`: any of them) is one of those PRs, from
    CHANGELOG.md and from the changelog.d/*.md
    fragments at HEAD (fragment parser loaded from bin/changelog-fold);
  * when gh fails: the fragments added to git in the window (`git log --diff-filter=A -- changelog.d/`, filtered by
    committer date), each read
    at the commit that added it;
  * docs/handoffs/HANDOFF_*_YYYY-MM-DD_*.md files dated inside the window.

Markdown output has headings A. Merged PRs, B. Changelog, C. Handoffs, D. Gaps, with plain links, so the `report`
skill can format it.

Exit codes: 0 ok; 2 usage; 3 a source failed (gh, git or a file): the partial report is still printed, and the
failure is listed under `notes` (JSON) or D. Gaps (Markdown).
"""
from __future__ import annotations

import argparse
import datetime
import json
import re
import subprocess
import sys
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path

EXIT_OK, EXIT_USAGE, EXIT_PARTIAL = 0, 2, 3
TIMEOUT = 60
HERE = Path(__file__).resolve().parent
PR_END = re.compile(r"\(([^()]*)\)\.?$")  # the final parenthesised group, e.g. (#31) or (2026-10-23, #31).
PR_NUM = re.compile(r"#(\d+)")


def entry_prs(text):
    """Every #N inside the final parenthesised group at the end of an entry, in order: `(#12, #13)` is [12, 13]."""
    m = PR_END.search(text)
    return [int(n) for n in PR_NUM.findall(m.group(1))] if m else []


def entry_pr(text):
    """The last PR number of entry_prs, else None (the entry's `pr` field when no window narrows it)."""
    nums = entry_prs(text)
    return nums[-1] if nums else None
HANDOFF_DATE = re.compile(r"_(\d{4}-\d{2}-\d{2})_")
SECTION_ORDER = ("Added", "Changed", "Deprecated", "Removed", "Fixed", "Security")


def run(argv, cwd=None):
    """(rc, stdout, stderr) of an argv list; a missing binary or a timeout is rc 127 / 124, never an exception."""
    try:
        p = subprocess.run(argv, cwd=cwd, capture_output=True, text=True, timeout=TIMEOUT)
    except FileNotFoundError:
        return 127, "", "%s: not found" % argv[0]
    except subprocess.TimeoutExpired:
        return 124, "", "%s: timed out after %ds" % (argv[0], TIMEOUT)
    except OSError as e:
        return 127, "", "%s: %s" % (argv[0], e)
    return p.returncode, p.stdout, p.stderr


def load_fold():
    """bin/changelog-fold as a module (it has a `__main__` guard), or None."""
    path = HERE / "changelog-fold"
    try:
        loader = SourceFileLoader("changelog_fold_for_retro", str(path))
        spec = spec_from_loader(loader.name, loader)
        mod = module_from_spec(spec)
        loader.exec_module(mod)
        if not callable(getattr(mod, "parse_fragment_text", None)):
            return None
        return mod
    except Exception:
        return None


def local_sections(text):
    """{heading: [entry line lists]} of a changelog-shaped text (fallback parser and CHANGELOG.md reader)."""
    sections, heading, entry = {}, None, None
    for line in text.splitlines():
        if line.startswith("## "):
            heading, entry = None, None
        elif line.startswith("### "):
            heading, entry = line[4:].strip(), None
            sections.setdefault(heading, [])
        elif line.startswith("- ") and heading is not None:
            entry = [line]
            sections[heading].append(entry)
        elif line[:1] in (" ", "\t") and entry is not None and line.strip():
            entry.append(line)
        else:
            entry = None
    return sections


def parse_fragment(fold, label, text):
    if fold is not None:
        try:
            sections, _problems = fold.parse_fragment_text(label, text)
            return sections
        except Exception:
            pass
    return local_sections(text)


def entry_body(lines):
    return " ".join(l.strip() for l in lines)[2:].strip()


def collect(sections, source, wanted, out):
    """Append entries of `sections` to `out`; wanted=None keeps all, else only those with a (#N) in the set. `prs` lists
    every number of the final group; `pr` is the last one in the window (the last one at all when unfiltered)."""
    for heading, entries in sections.items():
        for lines in entries:
            text = entry_body(lines)
            prs = entry_prs(text)
            hits = prs if wanted is None else [n for n in prs if n in wanted]
            if wanted is None or hits:
                out.append({"section": heading, "text": text, "pr": hits[-1] if hits else None, "prs": prs,
                            "source": source})


def origin_repo(root):
    rc, out, _ = run(["git", "-C", str(root), "remote", "get-url", "origin"])
    if rc != 0:
        return None
    m = re.search(r"github\.com[:/]+([^/\s]+)/([^/\s]+?)(?:\.git)?/?\s*$", out.strip())
    return "%s/%s" % (m.group(1), m.group(2)) if m else None


def parse_pages(text):
    """`gh api --paginate` prints one JSON document PER PAGE, concatenated (the same shape the removed PR waiter decoded): decode all."""
    dec, docs, i, n = json.JSONDecoder(), [], 0, len(text)
    while True:
        while i < n and text[i].isspace():
            i += 1
        if i >= n:
            return docs
        doc, i = dec.raw_decode(text, i)
        docs.append(doc)


def merged_prs(repo, since, until):
    """(prs, error, note): REST search (GraphQL `gh pr list` is refused with 403 in cloud sessions)."""
    q = "repo:%s is:pr is:merged merged:%s..%s" % (repo, since, until)
    argv = ["gh", "api", "-X", "GET", "search/issues", "-f", "q=" + q, "-f", "per_page=100", "--paginate"]
    rc, out, err = run(argv)
    if rc != 0:
        return None, "gh api search/issues failed (rc=%d): %s" % (rc, (err or out).strip()[:200]), None
    try:
        docs = parse_pages(out or "")
    except ValueError as e:
        return None, "gh api search/issues printed unreadable JSON (%s)" % e, None
    items, total = [], 0
    for doc in docs:
        if not isinstance(doc, dict) or not isinstance(doc.get("items"), list):
            return None, "gh api search/issues printed JSON without an items list", None
        items += doc["items"]
        if isinstance(doc.get("total_count"), int):
            total = max(total, doc["total_count"])
    prs = []
    for it in items:
        if not isinstance(it, dict) or not isinstance(it.get("number"), int):
            continue
        user = it.get("user") if isinstance(it.get("user"), dict) else {}
        pr = it.get("pull_request") if isinstance(it.get("pull_request"), dict) else {}
        assoc = it.get("author_association") if isinstance(it.get("author_association"), str) else ""
        title = it.get("title", "") if isinstance(it.get("title"), str) else ""
        if assoc not in TRUSTED_ASSOC:
            # A PR title is remote text an agent reads (Codex security review, PR 289): keep only titles
            # written by the owner, members or collaborators.
            title = "(title withheld: author association %s)" % (assoc or "unknown")
        prs.append({"number": it["number"], "title": title, "url": it.get("html_url", ""),
                    "author": {"login": user.get("login", "")}, "association": assoc,
                    "mergedAt": pr.get("merged_at")})
    prs.sort(key=lambda p: (p.get("mergedAt") or "", p["number"]))
    note = None
    if total > len(items):
        note = "search capped: total_count %d but only %d PRs returned (search returns at most 1000); the list is incomplete" % (total, len(items))
    return prs, None, note


TRUSTED_ASSOC = ("OWNER", "MEMBER", "COLLABORATOR")


def git_added_fragments(root, since, until, fold, notes):
    """Entries of fragments added to git inside the window, each read at its adding commit."""
    # No --since/--until: git stops walking at the first too-old commit, which hides later-dated ones after
    # a merge or a rebase. The window is applied here to each commit's committer date instead.
    rc, out, err = run(["git", "-C", str(root), "log", "--diff-filter=A", "--name-only", "--format=@@%H %cI",
                        "--", "changelog.d/"])
    if rc != 0:
        notes.append("git log failed (rc=%d): %s" % (rc, err.strip()[:200]))
        return [], False
    entries, commit = [], None
    for line in out.splitlines():
        if line.startswith("@@"):
            sha, _, when = line[2:].partition(" ")
            commit = sha if since <= when[:10] <= until else None
        elif line.strip().endswith(".md") and commit and Path(line).name != "README.md":
            rc, text, err = run(["git", "-C", str(root), "show", "%s:%s" % (commit, line.strip())])
            if rc != 0:
                notes.append("git show %s:%s failed: %s" % (commit[:8], line.strip(), err.strip()[:120]))
                continue
            collect(parse_fragment(fold, Path(line).name, text), "git:" + line.strip(), None, entries)
    return entries, True


def handoffs(root, since, until, notes):
    d = root / "docs" / "handoffs"
    found = []
    if not d.is_dir():
        return found
    try:
        names = sorted(p for p in d.iterdir() if p.name.startswith("HANDOFF_") and p.suffix == ".md")
    except OSError as e:
        notes.append("cannot list %s: %s" % (d, e))
        return found
    for p in names:
        m = HANDOFF_DATE.search(p.name)
        if not m or not (since <= m.group(1) <= until):
            continue
        title = ""
        try:
            with p.open(encoding="utf-8", errors="replace") as f:
                for line in f:
                    if line.startswith("# "):
                        title = line[2:].strip()
                        break
        except OSError as e:
            notes.append("cannot read %s: %s" % (p.name, e))
        found.append({"path": "docs/handoffs/" + p.name, "date": m.group(1), "title": title})
    found.sort(key=lambda h: (h["date"], h["path"]))
    return found


def build(args, root):
    since, until = args.since, args.until
    notes, failed = [], False
    fold = load_fold()
    if fold is None:
        notes.append("bin/changelog-fold could not be loaded; using the local fragment parser")
    repo = args.repo or origin_repo(root)
    prs = None
    if not repo:
        notes.append("no --repo given and no github.com origin remote: merged PRs skipped")
        failed = True
    else:
        prs, err, note = merged_prs(repo, since, until)
        if note:
            notes.append(note)
        if err:
            notes.append(err)
            failed = True
    changelog = []
    if prs is not None:
        wanted = {p["number"] for p in prs}
        for src, path in (("CHANGELOG.md", root / "CHANGELOG.md"),):
            try:
                collect(local_sections(path.read_text(encoding="utf-8-sig")), src, wanted, changelog)
            except (OSError, UnicodeDecodeError) as e:
                notes.append("cannot read %s: %s" % (src, e))
                failed = True
        fdir = root / "changelog.d"
        if fdir.is_dir():
            for p in sorted(fdir.glob("*.md")):
                if p.name == "README.md":
                    continue
                try:
                    text = p.read_text(encoding="utf-8-sig")
                except (OSError, UnicodeDecodeError) as e:
                    notes.append("cannot read changelog.d/%s: %s" % (p.name, e))
                    failed = True
                    continue
                collect(parse_fragment(fold, p.name, text), "changelog.d/" + p.name, wanted, changelog)
    else:
        entries, ok = git_added_fragments(root, since, until, fold, notes)
        failed = failed or not ok
        changelog = entries
        notes.append("fallback: changelog entries are the fragments added to git in the window")
    changelog.sort(key=lambda e: (SECTION_ORDER.index(e["section"]) if e["section"] in SECTION_ORDER else 99,
                                  e["pr"] or 0))
    return {"tool": "ade-retro", "repo": repo, "since": since, "until": until, "prs": prs or [],
            "changelog": changelog, "handoffs": handoffs(root, since, until, notes), "notes": notes}, failed


def cell(s):
    return str(s).replace("|", "\\|").replace("\n", " ")


def render(rep, repo_known_prs):
    out = ["# Retro %s to %s" % (rep["since"], rep["until"]), ""]
    out += ["## A. Merged PRs", ""]
    if rep["prs"]:
        out += ["| PR | Merged | Author | Title |", "|---|---|---|---|"]
        for p in rep["prs"]:
            author = (p.get("author") or {}).get("login", "") if isinstance(p.get("author"), dict) else ""
            out.append("| [#%d](%s) | %s | %s | %s |" % (p["number"], p.get("url", ""), (p.get("mergedAt") or "")[:10],
                                                         cell(author), cell(p.get("title", ""))))
    else:
        out.append("No merged PRs listed." if repo_known_prs else "Merged PR list unavailable (see D. Gaps).")
    out += ["", "## B. Changelog", ""]
    if rep["changelog"]:
        for sec in sorted({e["section"] for e in rep["changelog"]},
                          key=lambda s: SECTION_ORDER.index(s) if s in SECTION_ORDER else 99):
            out += ["### %s" % sec, ""]
            out += ["- %s (%s)" % (e["text"], e["source"]) for e in rep["changelog"] if e["section"] == sec]
            out.append("")
    else:
        out += ["No changelog entries matched.", ""]
    out += ["## C. Handoffs", ""]
    out += ["- `%s` (%s) %s" % (h["path"], h["date"], h["title"]) for h in rep["handoffs"]] or ["No handoffs dated in the window."]
    out += ["", "## D. Gaps", ""]
    gaps = list(rep["notes"])
    have = {n for e in rep["changelog"] for n in (e.get("prs") or [e.get("pr")])}
    for p in rep["prs"]:
        if p["number"] not in have:
            gaps.append("PR #%d has no changelog entry (internal or doc-only PRs may skip): %s" % (p["number"], p.get("title", "")))
    out += ["- " + g for g in gaps] or ["None."]
    return "\n".join(out) + "\n"


def main(argv):
    ap = argparse.ArgumentParser(prog="ade-retro", description="Read-only raw report for a retrospective "
                                 "(exit 0 ok, 2 usage, 3 a source failed; partial report printed).")
    ap.add_argument("--since", required=True, help="YYYY-MM-DD, inclusive")
    ap.add_argument("--until", help="YYYY-MM-DD, inclusive (default: today)")
    ap.add_argument("--repo", help="OWNER/NAME (default: from the origin remote)")
    ap.add_argument("--root", default=str(HERE.parent), help="repository checkout (default: this one)")
    ap.add_argument("--json", action="store_true", help="print JSON")
    try:
        args = ap.parse_args(argv)
    except SystemExit as e:
        return EXIT_OK if e.code == 0 else EXIT_USAGE
    args.until = args.until or datetime.date.today().isoformat()
    for flag, val in (("--since", args.since), ("--until", args.until)):
        try:
            if datetime.date.fromisoformat(val).isoformat() != val:
                raise ValueError(val)
        except ValueError:
            print("ade-retro: %s must be YYYY-MM-DD, got %r" % (flag, val), file=sys.stderr)
            return EXIT_USAGE
    if args.since > args.until:
        print("ade-retro: --since is after --until", file=sys.stderr)
        return EXIT_USAGE
    if args.repo is not None and not re.fullmatch(r"[\w.-]+/[\w.-]+", args.repo):
        print("ade-retro: --repo must be OWNER/NAME", file=sys.stderr)
        return EXIT_USAGE
    root = Path(args.root)
    if not root.is_dir():
        print("ade-retro: --root %s is not a directory" % root, file=sys.stderr)
        return EXIT_USAGE
    rep, failed = build(args, root)
    if args.json:
        print(json.dumps(rep, indent=2, sort_keys=True))
    else:
        sys.stdout.write(render(rep, not failed))
    return EXIT_PARTIAL if failed else EXIT_OK


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

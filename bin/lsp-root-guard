#!/usr/bin/env python3
"""lsp-root-guard: stop a language server from indexing a container directory (queue item 89).

A Claude Code (or Codex) session started in `~` or `~/src` tells every LSP server that its workspace root is that
directory. basedpyright, marksman and tsserver then walk and index everything below it: one server held 2-3 GB
compressed (2026-11-21 load-watcher evidence). The root is the session's cwd, so the plugin configs cannot fix it;
this proxy sits between the client and the server on stdio and, only when the root is a container, rewrites the
`initialize` request to carry no root (rootUri / rootPath / workspaceFolders = null). The server then runs in
single-file mode: it serves the files the client opens and walks nothing. A project root passes through untouched,
byte for byte.

Usage in an LSP plugin entry:   "command": "lsp-root-guard", "args": ["--", "basedpyright-langserver", "--stdio"]

  lsp-root-guard [--container PATH]... [--no-heuristic] [--check URI_OR_PATH] -- CMD [ARGS...]

A root is a container when its realpath is in `config/lsp-roots.toml` [containers].paths (`~` expanded; an entry with a
`*` is a glob, e.g. `~/s/*`), in `--container`, or in `ADE_LSP_CONTAINER_ROOTS` (colon list); or, unless --no-heuristic
(which means "listed roots only"), when it is not itself a project (no .git, .jj, .hg, pyproject.toml, setup.py,
package.json, Cargo.toml, go.mod, Package.swift, tsconfig.json, Makefile, Gemfile, pyrightconfig.json, requirements.txt,
setup.cfg, deno.json, flake.nix, or an empty `.lsp-root-guard-project` file, the opt-out) and either is a directory
directly under `/` or above `$HOME` (structural rule), or has at least `min_repo_children` (default 3) of its first 400
children holding a `.git` (symlinked children count).

A root that is not an absolute, existing directory is never kept as a project root: with every root a container the
server gets none.

  --check ROOT   print `container` or `project` for ROOT and exit 0 (no server is started)

The child is run from an argv list (never a shell) with this process's cwd and environment. Client bytes the guard
does not change are forwarded as received. Exit: the child's exit code; 127 command not found; 2 bad arguments.
"""
from __future__ import annotations

import glob
import json
import os
import shutil
import signal
import subprocess
import sys
import threading
from pathlib import Path
from typing import Any, BinaryIO, Callable
from urllib.parse import unquote

try:
    import tomllib
except ModuleNotFoundError:  # Python < 3.11: the built-in container list below still applies
    tomllib = None  # type: ignore[assignment]

PROJECT_MARKERS = (".git", ".jj", ".hg", "pyproject.toml", "setup.py", "package.json", "Cargo.toml", "go.mod",
                   "Package.swift", "tsconfig.json", "Makefile", "Gemfile", "pyrightconfig.json", "requirements.txt", "setup.cfg",
                   "deno.json", "flake.nix", ".lsp-root-guard-project")
DEFAULT_CONTAINERS = ("~", "~/src", "~/s", "~/s/*", "~/ops", "~/tendcf-ops", "~/Desktop", "~/Documents", "~/Downloads", "~/Library", "/",
                      "/Users", "/Users/Shared", "/Volumes", "/Applications", "/System", "/usr", "/etc", "/opt", "/tmp",
                      "/private", "/private/tmp", "/var", "/private/var", "/Library", "/home", "/nix", "/mnt", "/srv",
                      "/Network", "/media", "/root")
HEURISTIC_SCAN_LIMIT = 400


def _repo_root() -> Path:
    return Path(os.path.realpath(__file__)).parent.parent


def _custom_tendcf_ops_root() -> str | None:
    if "TENDCF_OPS_ROOT" not in os.environ:
        return None
    bin_dir = str(_repo_root() / "bin")
    if bin_dir not in sys.path:
        sys.path.insert(0, bin_dir)
    try:
        import ade_ops_paths  # noqa: PLC0415
        root = ade_ops_paths.tendcf_ops_root()
        return str(root) if root is not None else None
    except Exception:
        return None


def load_policy() -> tuple[list[str], int]:
    paths = list(DEFAULT_CONTAINERS)
    min_children = 3
    cfg = _repo_root() / "config" / "lsp-roots.toml"
    if tomllib is not None and cfg.is_file():
        try:
            data = tomllib.loads(cfg.read_text(encoding="utf-8"))
            paths = [str(p) for p in data.get("containers", {}).get("paths", paths)]
            min_children = int(data.get("containers", {}).get("min_repo_children", min_children))
        except (OSError, ValueError, TypeError, AttributeError):
            pass  # a bad config falls back to the built-in list: the guard must never block a server
    custom_tendcf = _custom_tendcf_ops_root()
    if custom_tendcf and custom_tendcf not in paths:
        paths.append(custom_tendcf)
    extra = os.environ.get("ADE_LSP_CONTAINER_ROOTS", "")
    paths += [p for p in extra.split(":") if p]
    return paths, min_children


def _real(p: str) -> str:
    return os.path.realpath(os.path.expanduser(p))


def uri_to_path(uri_or_path: str) -> str | None:
    """Path of a file: URI or plain path; None for a remote or non-file URI. `#` and `?` stay in the path (an
    unencoded one in a directory name must not truncate the root)."""
    if uri_or_path.startswith("file:"):
        rest = uri_or_path[5:]
        if rest.startswith("//"):
            rest = rest[2:]
            if rest.startswith("localhost/"):
                rest = rest[len("localhost"):]
            elif not rest.startswith("/"):
                return None
        path = unquote(rest)
        # `file:Users/x` has no root slash; WHATWG URL and vscode-uri read it as `/Users/x`, so the guard judges that path
        # (None here would let a malformed client hand the server `~` unchecked)
        return path if path.startswith("/") else "/" + path
    if "://" in uri_or_path:
        return None
    return uri_or_path


def _same_dir(a: str, b: str) -> bool:
    try:
        return os.path.samefile(a, os.path.expanduser(b))
    except (OSError, ValueError):
        return False


def is_container(root: str, containers: list[str], min_repo_children: int, heuristic: bool = True) -> bool:
    try:
        real = _real(root)
    except ValueError:  # a NUL byte in the path
        return False
    listed: list[str] = []
    for c in containers:  # an entry may be a glob (`~/s/*`: category folders of links to repos)
        listed += glob.glob(os.path.expanduser(c)) if "*" in c else [c]
    if real in {_real(c) for c in listed} or any(_same_dir(real, c) for c in listed):
        return True
    if not os.path.isdir(real):
        return False
    if any(os.path.exists(os.path.join(real, m)) for m in PROJECT_MARKERS):
        return False
    if not heuristic:  # --no-heuristic: listed roots only
        return False
    # structural rule: a non-project directory directly under / or above $HOME is a container whatever the list says
    home = _real("~")
    if os.path.dirname(real) == "/" or home.startswith(real.rstrip(os.sep) + os.sep):
        return True
    repos = 0
    try:
        with os.scandir(real) as it:
            for n, entry in enumerate(it):
                if n >= HEURISTIC_SCAN_LIMIT:
                    break
                try:
                    if entry.is_dir() and os.path.exists(  # follows symlinks: ~/s-like folders hold links to repos
                            os.path.join(entry.path, ".git")):
                        repos += 1
                        if repos >= min_repo_children:
                            return True
                except OSError:
                    continue
    except OSError:
        return False
    return False


def _roots_in(params: dict[str, Any]) -> list[str]:
    out: list[str] = []
    for key in ("rootUri", "rootPath"):
        v = params.get(key)
        if isinstance(v, str) and v:
            p = uri_to_path(v)
            if p:
                out.append(p)
    for f in params.get("workspaceFolders") or []:
        if isinstance(f, dict) and isinstance(f.get("uri"), str):
            p = uri_to_path(f["uri"])
            if p:
                out.append(p)
    return out


def _keepable(path: str | None, containers: list[str], min_children: int, heuristic: bool) -> bool:
    """A root worth handing the server: an absolute, existing, non-container directory (a relative path cannot become a
    URI, and a missing one is no root: both used to fail open)."""
    return bool(path) and os.path.isabs(path or "") and os.path.isdir(path or "") \
        and not is_container(path or "/", containers, min_children, heuristic)


def guard_initialize(msg: dict[str, Any], containers: list[str], min_children: int, heuristic: bool) -> str | None:
    """Rewrite an `initialize` request in place when every named root is a container. Returns the denied root or None.

    A mix of a container and a project root keeps the project folders only (multi-root clients)."""
    params = msg.get("params")
    if not isinstance(params, dict):
        return None
    roots = _roots_in(params)
    if not roots:
        return None
    bad = [r for r in roots if is_container(r, containers, min_children, heuristic)]
    if not bad:
        return None
    good_folders = [f for f in params.get("workspaceFolders") or []
                    if isinstance(f, dict) and isinstance(f.get("uri"), str)
                    and (uri_to_path(f["uri"]) or "") not in bad
                    and _keepable(uri_to_path(f["uri"]), containers, min_children, heuristic)]
    if good_folders:
        params["workspaceFolders"] = good_folders
        params["rootUri"] = good_folders[0]["uri"]
        params["rootPath"] = uri_to_path(good_folders[0]["uri"])
    else:
        keep = next((r for r in (uri_to_path(params["rootUri"]) if isinstance(params.get("rootUri"), str) else None,
                                 params.get("rootPath") if isinstance(params.get("rootPath"), str) else None)
                     # an absolute, existing directory only: a relative path cannot become a URI and a missing one
                     # is no root worth keeping (both used to fail open and hand the server the container)
                     if r and r not in bad and _keepable(r, containers, min_children, heuristic)), None)
        if keep is not None:  # a project root with a container-only folder list: the root wins
            params["rootUri"] = Path(keep).as_uri()
            params["rootPath"] = keep
            params["workspaceFolders"] = [{"uri": Path(keep).as_uri(), "name": Path(keep).name}]
        else:
            params["rootUri"] = None
            params["rootPath"] = None
            params["workspaceFolders"] = None
    return bad[0]


def read_message(stream: BinaryIO, want: Callable[[bytes], bool] | None = None) -> tuple[bytes, dict[str, Any] | None] | None:
    """One LSP frame: (raw bytes incl. headers, parsed JSON object or None). None at EOF. The body is parsed only when
    `want(body)` is true (default: always), so the large frames the guard has no use for are never decoded."""
    headers = b""
    length = -1
    while True:
        line = stream.readline()
        if not line:
            return None
        headers += line
        if line in (b"\r\n", b"\n"):
            break
        name, _, value = line.partition(b":")
        if name.strip().lower() == b"content-length":
            try:
                length = int(value.strip())
            except ValueError:
                length = -1
    if length < 0:
        return headers, None
    body = stream.read(length)
    if len(body) < length:
        return None
    if want is not None and not want(body):
        return headers + body, None
    try:
        obj = json.loads(body)
    except ValueError:
        return headers + body, None
    return headers + body, obj if isinstance(obj, dict) else None


def frame(obj: dict[str, Any]) -> bytes:
    body = json.dumps(obj, separators=(",", ":"), ensure_ascii=True).encode("ascii")
    return b"Content-Length: " + str(len(body)).encode() + b"\r\n\r\n" + body


class Guard:
    """mode None: root untouched. "strip": every root was a container, folders are answered null. "filter": a
    multi-root client kept its project folders, so folder lists are filtered, never nulled. `kept` holds the folders
    the rewritten `initialize` named: a later folder reply that filtering would empty is answered with them."""

    def __init__(self, containers: list[str], min_children: int, heuristic: bool) -> None:
        self.containers, self.min_children, self.heuristic = containers, min_children, heuristic
        self.mode: str | None = None
        self.kept: list[Any] = []
        self.folder_request_ids: set[Any] = set()
        self.lock = threading.Lock()

    def _bad(self, uri: Any) -> bool:
        p = uri_to_path(uri) if isinstance(uri, str) else None
        return p is not None and is_container(p, self.containers, self.min_children, self.heuristic)

    @staticmethod
    def _same_folder(uri: Any) -> Any:
        """A comparison key for a folder URI: its real path (trailing slash, percent-encoding and symlinks agree)."""
        p = uri_to_path(uri) if isinstance(uri, str) else None
        return os.path.realpath(p) if p else uri

    def _forget(self, event: dict[str, Any]) -> None:
        """Drop folders the client removed from the kept list, so a closed folder is not re-added."""
        removed = event.get("removed")
        if not isinstance(removed, list):
            return
        gone = {self._same_folder(f.get("uri")) for f in removed if isinstance(f, dict)}
        self.kept = [f for f in self.kept if not (isinstance(f, dict) and self._same_folder(f.get("uri")) in gone)]

    def client_wants(self, body: bytes) -> bool:
        if b'"initialize"' in body or b"didChangeWorkspaceFolders" in body:
            return True
        return bool(self.folder_request_ids)  # a reply may be any frame: parse them all while a request is pending

    def server_wants(self, body: bytes) -> bool:
        return self.mode is not None and b"workspaceFolders" in body

    def from_client(self, raw: bytes, msg: dict[str, Any] | None) -> bytes | None:
        """Bytes to forward to the server, or None to drop the message. Any guard error forwards the original."""
        try:
            return self._from_client(raw, msg)
        except Exception as e:  # the guard must never stop a server from starting
            sys.stderr.write(f"lsp-root-guard: passing a message through unchanged ({type(e).__name__})\n")
            return raw

    def _from_client(self, raw: bytes, msg: dict[str, Any] | None) -> bytes | None:
        if msg is None:
            return raw
        method = msg.get("method")
        if method == "initialize" and "id" in msg:
            before = json.dumps(msg.get("params"), sort_keys=True)
            denied = guard_initialize(msg, self.containers, self.min_children, self.heuristic)
            if denied is None:
                return raw
            self.kept = list((msg.get("params") or {}).get("workspaceFolders") or [])
            self.mode = "filter" if self.kept else "strip"
            sys.stderr.write(f"lsp-root-guard: workspace root {denied} is a container, "
                             f"{'its folder dropped' if self.kept else 'started with no root'}\n")
            return frame(msg) if json.dumps(msg.get("params"), sort_keys=True) != before else raw
        if self.mode is None:
            return raw
        if method == "workspace/didChangeWorkspaceFolders":
            if self.mode == "strip":
                return None
            event = (msg.get("params") or {}).get("event")
            if isinstance(event, dict) and isinstance(event.get("added"), list):
                event["added"] = [f for f in event["added"] if not (isinstance(f, dict) and self._bad(f.get("uri")))]
                self._forget(event)
                if not event["added"] and not event.get("removed"):
                    return None
                return frame(msg)
            if isinstance(event, dict):
                self._forget(event)  # a removal alone still closes a kept folder
            return raw
        if "method" not in msg and msg.get("id") in self.folder_request_ids:
            with self.lock:
                self.folder_request_ids.discard(msg.get("id"))
            if "error" in msg:
                return raw
            if self.mode == "strip":
                msg["result"] = None
            elif isinstance(msg.get("result"), list):
                original = msg["result"]
                msg["result"] = [f for f in original if not (isinstance(f, dict) and self._bad(f.get("uri")))]
                if original and not msg["result"] and self.kept:  # the client's list held only containers: keep the root we kept
                    msg["result"] = list(self.kept)
            return frame(msg)
        return raw

    def from_server(self, msg: dict[str, Any] | None) -> None:
        if self.mode is not None and msg is not None and msg.get("method") == "workspace/workspaceFolders" and "id" in msg:
            with self.lock:
                self.folder_request_ids.add(msg["id"])


def _exit_code(rc: int) -> int:
    return rc if rc >= 0 else 128 - rc


def run(argv: list[str], stdin: BinaryIO, stdout: BinaryIO, containers: list[str], min_children: int,
        heuristic: bool) -> int:
    exe = shutil.which(argv[0])
    if exe is None:
        sys.stderr.write(f"lsp-root-guard: command not found: {argv[0]}\n")
        return 127
    child = subprocess.Popen([exe, *argv[1:]], stdin=subprocess.PIPE, stdout=subprocess.PIPE)  # noqa: S603 - argv list, no shell
    assert child.stdin is not None and child.stdout is not None
    guard = Guard(containers, min_children, heuristic)
    shutting_down = threading.Event()

    def kill_child(code: int) -> None:
        shutting_down.set()
        if child.poll() is None:
            child.terminate()
            try:
                child.wait(timeout=3)
            except subprocess.TimeoutExpired:
                child.kill()
        os._exit(code)

    for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
        signal.signal(sig, lambda signum, _frame: kill_child(128 + signum))

    def pump() -> None:
        assert child.stdout is not None
        while True:
            got = read_message(child.stdout, guard.server_wants)
            if got is None:
                break
            raw, msg = got
            guard.from_server(msg)
            stdout.write(raw)
            stdout.flush()
        if not shutting_down.is_set():  # the server ended first: report its status, do not wait for the client
            try:
                stdout.flush()
            except OSError:
                pass
            os._exit(_exit_code(child.wait()))

    t = threading.Thread(target=pump, daemon=True)
    t.start()
    try:
        while True:
            got = read_message(stdin, guard.client_wants)
            if got is None:
                break
            data = guard.from_client(*got)
            if data is not None:
                child.stdin.write(data)
                child.stdin.flush()
    except (BrokenPipeError, KeyboardInterrupt, OSError):
        pass
    finally:
        shutting_down.set()
        try:
            child.stdin.close()
        except OSError:
            pass
    try:
        rc = child.wait(timeout=5)
    except subprocess.TimeoutExpired:
        child.terminate()
        try:
            rc = child.wait(timeout=3)
        except subprocess.TimeoutExpired:
            child.kill()
            rc = child.wait()
    t.join(timeout=2)
    try:
        stdout.flush()
    except OSError:
        pass
    os._exit(_exit_code(rc))  # a pump thread stuck on a closed client pipe must not abort interpreter shutdown


def main(argv: list[str]) -> int:
    containers, min_children = load_policy()
    heuristic = True
    check: str | None = None
    args = list(argv)
    cmd: list[str] = []
    while args:
        a = args.pop(0)
        if a == "--":
            cmd = args
            break
        if a == "--container" and args:
            containers.append(args.pop(0))
        elif a == "--no-heuristic":
            heuristic = False
        elif a == "--check" and args:
            check = args.pop(0)
        else:
            sys.stderr.write(__doc__ or "")
            return 2
    if check is not None:
        p = uri_to_path(check)
        if p is None:
            sys.stderr.write("lsp-root-guard: not a file path or file:// URI\n")
            return 2
        print("container" if is_container(p, containers, min_children, heuristic) else "project")
        return 0
    if not cmd:
        sys.stderr.write(__doc__ or "")
        return 2
    return run(cmd, sys.stdin.buffer, sys.stdout.buffer, containers, min_children, heuristic)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

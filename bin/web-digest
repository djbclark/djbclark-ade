#!/usr/bin/env -S python3 -I
"""web-digest — one-call web research for small-context models.

  web-digest "<question>" [--url URL ...] [--max-tokens 700] [--pages 4] [--thorough]

Searches (or reads the given --url pages), fetches the best pages through the `web-get` failover
ladder, ranks passages against the question (BM25, no model call), and prints a few cited passages
within a hard size cap. A 32k-context model gets one bounded answer-shaped block instead of whole
pages. The result is passages with source numbers; the caller does the reading and the answering.

Output (stdout): numbered SOURCES, then PASSAGES tagged [n]. Failures are stated in the output:
  - `NOT FETCHED:` lines name pages that failed (retry with --thorough --url <url>, which walks the
    whole ladder, including the JavaScript renderer and the Wayback Machine).
  - Exit 5 and a `WEB-DIGEST FAILED` block: the whole ladder failed. Operator pause rule: stop,
    tell the user, never answer from memory.
Exit codes: 0 ok (stdout has passages), 2 usage, 5 nothing could be fetched or searched.
"""
from __future__ import annotations

import argparse
import concurrent.futures as cf
import math
import os
import re
import subprocess
import sys
import time
from collections import Counter
from pathlib import Path

HERE = Path(__file__).resolve().parent
WEB_GET = os.environ.get("WEB_DIGEST_WEB_GET") or str(HERE / "web-get")
CHARS_PER_TOKEN = 4
FAST_SKIP = "crawl4ai,wayback"  # a cold Chromium start or a Wayback walk takes minutes
PASSAGE_MAX = 700
PASSAGE_MIN = 60
STOP = set(
    "a an and are as at be but by can do does for from has have how i if in into is it its of on "
    "or that the their then there these this to was were what when where which who why will with "
    "you your about use using used get gets".split()
)


def tokens(text: str) -> list[str]:
    out = []
    for w in re.findall(r"[a-z0-9][a-z0-9.+#_-]*", text.lower()):
        w = w.strip(".-_")
        if not w or w in STOP:
            continue
        for suf in ("ing", "ed", "es", "s"):
            if len(w) > len(suf) + 3 and w.endswith(suf):
                w = w[: -len(suf)]
                break
        out.append(w)
    return out


def clean(md: str) -> str:
    md = re.sub(r"!\[[^\]]*\]\([^)]*\)", "", md)  # images
    md = re.sub(r"\[([^\]]*)\]\([^)]*\)", r"\1", md)  # links -> text
    md = re.sub(r"https?://\S{60,}", "", md)  # very long bare URLs
    md = re.sub(r"<[^>]{1,200}>", "", md)  # stray tags
    md = re.sub(r"[ \t]+", " ", md)
    return md


def passages(text: str) -> list[str]:
    """Split page text into passages of PASSAGE_MIN..PASSAGE_MAX chars."""
    out: list[str] = []
    buf = ""
    for block in re.split(r"\n\s*\n", clean(text)):
        block = block.strip()
        if not block:
            continue
        links = len(re.findall(r"\bhttps?://", block))
        if links > 3 and len(block) / (links + 1) < 80:  # a link list, not prose
            continue
        if len(block) < PASSAGE_MIN:
            buf = (buf + " " + block).strip() if len(buf) + len(block) < PASSAGE_MAX else block
            if len(buf) >= PASSAGE_MIN * 2:
                out.append(buf)
                buf = ""
            continue
        if buf:
            out.append(buf)
            buf = ""
        while len(block) > PASSAGE_MAX:
            cut = max(block.rfind(". ", 0, PASSAGE_MAX), block.rfind("\n", 0, PASSAGE_MAX))
            cut = cut + 1 if cut > PASSAGE_MAX // 2 else PASSAGE_MAX
            out.append(block[:cut].strip())
            block = block[cut:].strip()
        if block:
            out.append(block)
    if buf:
        out.append(buf)
    return out


def rank(question: str, docs: list[tuple[int, str, float]], k1=1.4, b=0.75):
    """docs: (source_no, passage, boost). Returns [(score, source_no, passage)] best first."""
    q = [t for t in tokens(question)]
    if not docs:
        return []
    toks = [tokens(p) for _, p, _ in docs]
    avg = sum(len(t) for t in toks) / len(toks) or 1
    df = Counter()
    for t in toks:
        df.update(set(t))
    n = len(docs)
    scored = []
    for (src, p, boost), t in zip(docs, toks):
        tf = Counter(t)
        s = 0.0
        for w in set(q):
            if w not in tf:
                continue
            idf = math.log(1 + (n - df[w] + 0.5) / (df[w] + 0.5))
            s += idf * tf[w] * (k1 + 1) / (tf[w] + k1 * (1 - b + b * len(t) / avg))
        scored.append((s * boost, src, p))
    scored.sort(key=lambda x: -x[0])
    return scored


def parse_search(content: str) -> list[dict]:
    res = []
    for block in re.split(r"\n---\n", content):
        m = re.search(r"^URL:\s*(\S+)", block, re.M)
        if not m:
            continue
        title = re.search(r"^Title:\s*(.+)$", block, re.M)
        snip = re.search(r"^Snippet:\s*(.*)", block, re.M | re.S)
        res.append({
            "url": m.group(1),
            "title": title.group(1).strip() if title else m.group(1),
            "snippet": snip.group(1).strip() if snip else "",
        })
    return res


def run_web_get(args: list[str], timeout: float) -> dict:
    import json

    try:
        p = subprocess.run([WEB_GET, *args, "--json"], capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return {"ok": False, "error": f"timeout after {timeout:.0f}s"}
    try:
        d = json.loads(p.stdout)
    except ValueError:
        return {"ok": False, "error": (p.stderr.strip().splitlines() or ["no output"])[-1][:200]}
    if not d.get("ok"):
        errs = "; ".join(f"{a['provider']}: {a.get('error')}" for a in d.get("attempts", [])[-3:])
        d["error"] = errs or "all providers failed"
    return d


def fetch_page(url: str, thorough: bool, deadline: float) -> tuple[str, dict]:
    left = max(10.0, deadline - time.monotonic())
    args = ["fetch", url, "--max-bytes", "300000", "--timeout", "30" if not thorough else "60"]
    if not thorough:
        args += ["--skip", FAST_SKIP, "--walk-budget", "15"]
    return url, run_web_get(args, left)


def digest(question, urls, max_tokens, pages, thorough, total_s):
    deadline = time.monotonic() + total_s
    sources: list[dict] = []  # {url,title,snippet}
    notes: list[str] = []
    if urls:
        sources = [{"url": u, "title": u, "snippet": ""} for u in urls]
    else:
        s = run_web_get(["search", question, "--n", str(max(pages + 2, 6))], min(90.0, total_s))
        if not s.get("ok"):
            return None, f"search failed: {s.get('error')}"
        sources = parse_search(s.get("content", ""))
        if not sources:
            return None, "search returned no results"
        sources = sources[: pages + 2]
    want = sources if urls else sources[:pages]
    docs: list[tuple[int, str, float]] = []
    fetched: dict[str, str] = {}
    with cf.ThreadPoolExecutor(max_workers=min(4, len(want) or 1)) as ex:
        futs = [ex.submit(fetch_page, s["url"], thorough, deadline) for s in want]
        for f in futs:
            url, d = f.result()
            if d.get("ok"):
                fetched[url] = d.get("content", "")
                if d.get("truncated"):
                    notes.append(f"CUT SHORT: {url} (provider size cap; only the start was read)")
            else:
                notes.append(f"NOT FETCHED: {url} ({d.get('error')}); retry: web-digest --thorough --url {url} \"...\"")
    numbered = []
    for s in sources:
        n = len(numbered) + 1
        numbered.append((n, s))
        if s["snippet"]:
            for p in passages(re.sub(r"\s*\n?\.\.\.\n?\s*", "\n\n", s["snippet"])):
                docs.append((n, p, 1.25))  # search snippets are already query-targeted
        body = fetched.get(s["url"])
        if body:
            for p in passages(body):
                docs.append((n, p, 1.0))
    if not docs:
        return None, "no readable text: " + " | ".join(notes[:4] or ["nothing fetched"])
    ranked = rank(question, docs)
    budget = max_tokens * CHARS_PER_TOKEN
    picked: list[tuple[int, str]] = []
    seen: set[str] = set()
    per_src = Counter()
    used = 0
    top = ranked[0][0] if ranked else 0.0
    for score, src, p in ranked:
        if picked and (score <= 0 or score < 0.3 * top):  # the tail is filler headings
            break
        key = re.sub(r"\W+", " ", p.lower())[:80]
        if key in seen or per_src[src] >= 3:
            continue
        if used + len(p) > budget and picked:
            continue
        picked.append((src, p))
        seen.add(key)
        per_src[src] += 1
        used += len(p)
        if used >= budget:
            break
    used_src = sorted({n for n, _ in picked})
    out = ["SOURCES:"]
    for n, s in numbered:
        if n in used_src:
            out.append(f"[{n}] {s['title'][:100]} - {s['url']}")
    out.append("")
    out.append("PASSAGES (ranked by relevance to the question; cite sources by [n]):")
    for n, p in picked:
        out.append(f"[{n}] {' '.join(p.split())}")
    if notes:
        out.append("")
        out += notes
    return "\n".join(out), None


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description="One-call web research digest for small-context models.")
    ap.add_argument("question", help="the question or search query")
    ap.add_argument("--url", action="append", default=[], help="read this page instead of searching (repeatable)")
    ap.add_argument("--max-tokens", type=int, default=700, help="output cap in tokens (default 700, hard max 2000)")
    ap.add_argument("--pages", type=int, default=4, help="search results to fetch (default 4)")
    ap.add_argument("--thorough", action="store_true", help="walk the whole ladder per page (slower)")
    ap.add_argument("--timeout", type=float, default=120.0, help="total wall-clock budget in seconds")
    a = ap.parse_args(argv)
    a.max_tokens = max(100, min(a.max_tokens, 2000))
    text, err = digest(a.question, a.url, a.max_tokens, max(1, min(a.pages, 8)), a.thorough, a.timeout)
    if err:
        print(
            "WEB-DIGEST FAILED: " + err + "\n"
            "STOP. Tell the user the web lookup failed and quote the line above. "
            "Do NOT answer from memory and do not guess.",
        )
        return 5
    print(text)
    return 0


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env -S python3 -I
"""wave6-delete-check: refuse Wave 6 shim deletion until gates pass; `--dry-run` / `--inventory` never invent Mac live (2026-11-10).

  wave6-delete-check [--root DIR] [--evidence PATH] [--json] [--allow-early]
  wave6-delete-check --dry-run [--root DIR] [--json]
  wave6-delete-check --inventory [--dry-run] [--root DIR] [--json]

Read-only. Exit 0 only when every gate is green (safe to open the deletion PR
that removes relay.py / acp-dispatch / acp-run). Exit 1 with named reasons
otherwise. Exit 2 usage / unreadable root or evidence. Never deletes, never
posts, never merges. Docs: docs/slim/wave6-follow-up.md (queue Carried 33).

--dry-run (FIXTURE regression only):
  Points at tests/fixtures/wave6-mac-proofs/evidence.FIXTURE.json under --root,
  checks FAILCLOSED proof-file shape for Mac *and* C3 labels (skips callers /
  soft_deadline), and refuses unless the bundle is still labeled FIXTURE.
  Exit 0 means fixture shape OK — never live Mac proof, never deletion-ready.
  `mac_live_blocked` stays true. Incompatible with --evidence / --allow-early.
  Linux-safe partial Mac probes: bin/wave6-mac-proof-capture --linux-safe
  (NOT deletion evidence). Live Mac cycle: --live (Darwin only).

--inventory (caller inventory; Mac still blocked):
  Lists every remaining LIVE_RE hit under the gated §A paths (CALLER_SKILLS /
  CALLER_BINS / loose) untruncated, scans other skills/*/SKILL.md for ungated
  holes, and reports gate_exits proving callers are covered (callers exit 1
  while hits remain; evaluate_no_evidence exit 1 without Mac/C3 evidence).
  Exit 0 when coverage_ok (no ungated skill hits) and — if combined with
  --dry-run — fixture_shape_ok; ready stays false; mac_live_blocked stays true.
  Exit 1 on ungated holes or (with --dry-run) bad FIXTURE shape. Never invents
  Mac live proof. Incompatible with --evidence / --allow-early.

Gates:
  callers_skills   listed skills still teach/invoke the shims as live commands
  callers_bins     listed bin/ callers still invoke the shims at runtime
  callers_loose    skills/loose still uses acp-run --perm deny (must port first)
  ungated_skills   --inventory found LIVE_RE in a skills/*/SKILL.md outside §A
  evidence_missing --evidence not passed (Mac live-cycle + C3 ticks required)
  evidence_invalid evidence JSON missing keys or bad values
  fixture_invalid  --dry-run bundle missing, unlabeled, or not FIXTURE
  mac_not_live     --evidence points at FIXTURE / LINUX-SAFE Mac proofs
  c3_<key>         that C3 row is not migrated|waived
  c3_<key>_proof_missing   c3_proofs.<key> path missing, empty, or unreadable
  mac_<flag>       that Mac idle/smoke flag is not true
  mac_<flag>_proof_missing mac_proofs.<flag> path missing, empty, or unreadable
  soft_deadline    today < 2026-11-20 and --allow-early was not passed
                   (even with evidence; early delete needs the flag explicitly)

Evidence JSON must name a non-empty proof file per C3 key and Mac flag
(`c3_proofs` / `mac_proofs`; paths relative to the evidence file's directory).
The gate FAILCLOSEs when a proof path is absent, empty, or unreadable — it
never invents Mac stdout or outside-repo migration proofs. Mac B1 idle
captures must still be non-empty: record cmd + `verified: no match` (see
docs/slim/wave6-follow-up.md); a bare empty `pgrep` redirect is not evidence.
FIXTURE and LINUX-SAFE labeled Mac proofs never green deletion (`mac_not_live`).
Stdlib only.
"""
from __future__ import annotations

import argparse
import datetime
import json
import re
import sys
from pathlib import Path
from typing import Any

TOOL = "wave6-delete-check"
SOFT_DEADLINE = datetime.date(2026, 11, 20)
FIXTURE_EVIDENCE_REL = Path("tests/fixtures/wave6-mac-proofs/evidence.FIXTURE.json")
FIXTURE_RECORDED = "FIXTURE-not-live-Mac"
FIXTURE_PROOF_LABEL = "FIXTURE — NOT live Mac stdout"
C3_FIXTURE_PROOF_LABEL = "FIXTURE — NOT live outside-repo probe"
LINUX_SAFE_PROOF_LABEL = "LINUX-SAFE — NOT Mac live-cycle"
# First-line markers that mean the Mac proof is not a Darwin --live capture.
MAC_NOT_LIVE_PREFIXES = (FIXTURE_PROOF_LABEL, LINUX_SAFE_PROOF_LABEL)

# Paths that must not teach the shims as live commands before deletion.
CALLER_SKILLS = (
    "skills/fan-out/SKILL.md",
    "skills/model-routing/SKILL.md",
    "skills/session-handoff/SKILL.md",
    "skills/old-handoff-use-paseo-handoff/SKILL.md",
    "skills/oc-go-key/SKILL.md",
    "skills/baton/SKILL.md",
    "skills/research/SKILL.md",
    "skills/dialogue/SKILL.md",
)
LOOSE_SKILL = "skills/loose/SKILL.md"

# Executable / library callers that still invoke the shims at runtime (Codex P2 on #398:
# skill prose alone must not green the gate while bin/deadline still shells relay.py).
CALLER_BINS = (
    "bin/deadline",
    "bin/load-watch",
    "bin/instruction-lint",
    "bin/ade_claims.py",
)

# Live invocation / path forms (not every historical prose mention).
LIVE_RE = re.compile(
    r"(?:"
    r"bin/acp-dispatch(?:-wait)?"
    r"|skills/session-finder/relay\.py"
    r"|~/src/djbclark-ade/skills/session-finder/relay\.py"
    r"|\[\"acp-run\""
    r"|`acp-run`"
    r"|acp-run\s+--perm"
    r"|acp-dispatch\s+(?:claude|codex|antigravity|cursor|omp|hermes|footer|check|wait|tell|resume|reap|outcome|ls)"
    r"|relay\.py\s+<"
    r")"
)

C3_KEYS = (
    "tendcf",
    "nix2cf",
    "cfengine",
    "paseo_upstream",
    "plektra",
    "paseo4herdr",
    "pi",
    "sudo_secretspec",
    "aiuse",
    "paseo_runner",
    "site_public_home_agents",
    "aiuse_config_opencode_go",
)
MAC_FLAGS = (
    "relay_idle",
    "acp_dispatch_idle",
    "acp_run_idle",
    "paseo_smoke_ok",
)
C3_OK = frozenset({"migrated", "waived"})


def die(msg: str, code: int = 2) -> int:
    print(f"{TOOL}: {msg}", file=sys.stderr)
    return code


def scan_file(path: Path) -> list[str]:
    """Return matching line snippets for LIVE_RE (empty if missing/unreadable)."""
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return [f"unreadable:{path}"]
    hits: list[str] = []
    for i, line in enumerate(text.splitlines(), 1):
        if LIVE_RE.search(line):
            hits.append(f"{path.as_posix()}:{i}")
    return hits


def check_callers(root: Path) -> list[str]:
    reasons: list[str] = []
    skill_hits: list[str] = []
    for rel in CALLER_SKILLS:
        skill_hits.extend(scan_file(root / rel))
    if skill_hits:
        sample = ", ".join(skill_hits[:8])
        more = "" if len(skill_hits) <= 8 else f" (+{len(skill_hits) - 8} more)"
        reasons.append(f"callers_skills: {sample}{more}")

    bin_hits: list[str] = []
    for rel in CALLER_BINS:
        bin_hits.extend(scan_file(root / rel))
    if bin_hits:
        sample = ", ".join(bin_hits[:8])
        more = "" if len(bin_hits) <= 8 else f" (+{len(bin_hits) - 8} more)"
        reasons.append(f"callers_bins: {sample}{more}")

    loose = root / LOOSE_SKILL
    loose_hits = scan_file(loose)
    # Port gate: any acp-run --perm (or quoted acp-run argv) in loose.
    if loose_hits or (
        loose.is_file()
        and re.search(r"acp-run", loose.read_text(encoding="utf-8", errors="replace"))
    ):
        # Narrow: only fail loose when acp-run still appears (item 33 port).
        try:
            text = loose.read_text(encoding="utf-8", errors="replace")
        except OSError:
            text = ""
        if "acp-run" in text:
            reasons.append(
                "callers_loose: skills/loose/SKILL.md still names acp-run "
                "(port off --perm deny before delete)"
            )
    return reasons


def _rel_posix(root: Path, path: Path) -> str:
    try:
        return path.resolve().relative_to(root.resolve()).as_posix()
    except (OSError, ValueError):
        return path.as_posix()


def _scan_inventory_hits(
    root: Path,
    path: Path,
    *,
    kind: str,
    match_acp_run_any: bool = False,
) -> list[dict[str, Any]]:
    """Structured LIVE_RE (and optional any-acp-run) hits with relative path:line."""
    rel = _rel_posix(root, path)
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return [
            {
                "path": rel,
                "line": 0,
                "kind": kind,
                "gated": True,
                "snippet": "unreadable",
            }
        ]
    hits: list[dict[str, Any]] = []
    for i, line in enumerate(text.splitlines(), 1):
        if LIVE_RE.search(line) or (match_acp_run_any and "acp-run" in line):
            hits.append(
                {
                    "path": rel,
                    "line": i,
                    "kind": kind,
                    "gated": True,
                    "snippet": line.strip()[:160],
                }
            )
    return hits


def inventory_gated_references(root: Path) -> list[dict[str, Any]]:
    """Every remaining gated §A reference — untruncated (skills / bins / loose)."""
    refs: list[dict[str, Any]] = []
    for rel in CALLER_SKILLS:
        refs.extend(_scan_inventory_hits(root, root / rel, kind="skills"))
    for rel in CALLER_BINS:
        refs.extend(_scan_inventory_hits(root, root / rel, kind="bins"))
    refs.extend(
        _scan_inventory_hits(
            root,
            root / LOOSE_SKILL,
            kind="loose",
            match_acp_run_any=True,
        )
    )
    return refs


def inventory_ungated_skill_hits(root: Path) -> list[dict[str, Any]]:
    """LIVE_RE in skills/*/SKILL.md outside CALLER_SKILLS/loose — gate coverage holes."""
    gated = frozenset(CALLER_SKILLS) | {LOOSE_SKILL}
    skills_dir = root / "skills"
    if not skills_dir.is_dir():
        return []
    hits: list[dict[str, Any]] = []
    for skill_md in sorted(skills_dir.glob("*/SKILL.md")):
        rel = _rel_posix(root, skill_md)
        if rel in gated:
            continue
        for hit in _scan_inventory_hits(root, skill_md, kind="ungated"):
            hit["gated"] = False
            hits.append(hit)
    return hits


def evaluate_inventory(root: Path, *, with_dry_run: bool) -> dict[str, Any]:
    """List every gated caller hit + prove gate exit codes; never Mac-live / never ready."""
    references = inventory_gated_references(root)
    ungated = inventory_ungated_skill_hits(root)
    caller_reasons = check_callers(root)
    callers_exit = 1 if caller_reasons else 0
    # Prove the deletion gate refuses without Mac/C3 evidence (and while callers remain).
    full = evaluate(root, evidence=None, allow_early=False)
    full_exit = 0 if full["ready"] else 1

    dry_exit: int | None = None
    fixture_shape_ok: bool | None = None
    reasons: list[str] = []
    if ungated:
        sample = ", ".join(f"{h['path']}:{h['line']}" for h in ungated[:8])
        more = "" if len(ungated) <= 8 else f" (+{len(ungated) - 8} more)"
        reasons.append(f"ungated_skills: {sample}{more}")

    if with_dry_run:
        dry = evaluate_dry_run(root)
        fixture_shape_ok = bool(dry.get("fixture_shape_ok"))
        dry_exit = 0 if fixture_shape_ok else 1
        if not fixture_shape_ok:
            # Keep fixture reasons; drop the soft "OK but not ready" advisory when failing.
            reasons.extend(
                r for r in dry["reasons"] if not r.startswith("dry_run:")
            )

    # Consistency: remaining gated hits must make the callers gate refuse.
    if references and callers_exit != 1:
        reasons.append(
            "inventory_inconsistent: gated references present but callers gate exit != 1"
        )
    if full_exit != 1:
        reasons.append(
            "inventory_inconsistent: evaluate_no_evidence exit != 1 "
            "(expected refuse without Mac/C3 evidence)"
        )

    coverage_ok = not ungated and not any(
        r.startswith("inventory_inconsistent:") for r in reasons
    )
    shape_ok = True if fixture_shape_ok is None else fixture_shape_ok
    inventory_ok = coverage_ok and shape_ok and full_exit == 1

    advisory: list[str] = []
    if inventory_ok:
        advisory.append(
            "inventory: every remaining skill LIVE_RE hit is under gated §A paths; "
            f"callers_remaining={len(references)}; gate_exits.callers={callers_exit}; "
            f"gate_exits.evaluate_no_evidence={full_exit}"
            + (
                f"; gate_exits.dry_run_fixture={dry_exit}"
                if dry_exit is not None
                else ""
            )
            + " — NOT live Mac; NOT deletion-ready"
        )

    return {
        "tool": TOOL,
        "root": str(root),
        "soft_deadline": SOFT_DEADLINE.isoformat(),
        "allow_early": False,
        "evidence": None,
        "dry_run": with_dry_run,
        "mode": "caller-inventory",
        "references": references,
        "callers_remaining": len(references),
        "ungated_references": ungated,
        "gate_exits": {
            "callers": callers_exit,
            "evaluate_no_evidence": full_exit,
            "dry_run_fixture": dry_exit,
        },
        "gate_reasons": caller_reasons,
        "coverage_ok": coverage_ok,
        "fixture_shape_ok": fixture_shape_ok,
        "inventory_ok": inventory_ok,
        "mac_live_blocked": True,
        "ready": False,
        "reasons": reasons if reasons else advisory,
    }


def _proof_path(evidence_dir: Path, raw: Any) -> Path | None:
    """Resolve a proof path relative to the evidence JSON's directory."""
    if not isinstance(raw, str) or not raw.strip():
        return None
    p = Path(raw)
    if not p.is_absolute():
        p = evidence_dir / p
    return p


def _check_proof_file(
    *,
    reason_prefix: str,
    evidence_dir: Path,
    proofs: Any,
    key: str,
) -> str | None:
    """Return a named reason when the proof file is missing/empty/unreadable."""
    if not isinstance(proofs, dict):
        return f"{reason_prefix}_proof_missing: c3_proofs/mac_proofs object missing"
    raw = proofs.get(key)
    path = _proof_path(evidence_dir, raw)
    if path is None:
        return (
            f"{reason_prefix}_proof_missing: want non-empty path for {key!r}, "
            f"got {raw!r}"
        )
    try:
        if not path.is_file():
            return f"{reason_prefix}_proof_missing: not a file: {path}"
        # Fail closed on empty captures (claimed tick with no paste). Idle Mac
        # B1 probes that find no process must still write cmd + verified line —
        # see docs/slim/wave6-follow-up.md capture recipe (Codex P2 on #417).
        if path.stat().st_size == 0:
            return f"{reason_prefix}_proof_missing: empty file: {path}"
        # Touch-read so an unreadable path cannot green the gate.
        path.read_bytes()
    except OSError as exc:
        return (
            f"{reason_prefix}_proof_missing: unreadable {path}: "
            f"{exc.__class__.__name__}"
        )
    return None


def _mac_not_live_reasons(data: dict[str, Any], evidence_dir: Path) -> list[str]:
    """Refuse FIXTURE / LINUX-SAFE Mac proofs as deletion evidence (Mac live blocked)."""
    reasons: list[str] = []
    if data.get("recorded") == FIXTURE_RECORDED:
        reasons.append(
            "mac_not_live: evidence.recorded is FIXTURE-not-live-Mac "
            "(use Darwin wave6-mac-proof-capture --live, not the FIXTURE bundle)"
        )
    note = data.get("note")
    if isinstance(note, str) and "FIXTURE" in note and "NOT" in note:
        # Only when recorded did not already trip (avoid duplicate noise).
        if data.get("recorded") != FIXTURE_RECORDED:
            reasons.append(
                "mac_not_live: evidence.note declares FIXTURE / NOT live Mac"
            )
    mac_proofs = data.get("mac_proofs")
    if not isinstance(mac_proofs, dict):
        return reasons
    for flag in MAC_FLAGS:
        path = _proof_path(evidence_dir, mac_proofs.get(flag))
        if path is None:
            continue
        try:
            text = path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        for prefix in MAC_NOT_LIVE_PREFIXES:
            if text.startswith(prefix):
                reasons.append(
                    f"mac_not_live: mac_proofs.{flag} starts with {prefix!r} "
                    "(not Darwin --live capture)"
                )
                break
    return reasons


def check_evidence(
    path: Path | None,
    *,
    allow_early: bool,
    refuse_non_live_mac: bool = True,
) -> list[str]:
    reasons: list[str] = []
    if path is None:
        reasons.append(
            "evidence_missing: pass --evidence PATH with Mac live-cycle + C3 ticks "
            "(docs/slim/wave6-follow-up.md B/C)"
        )
        return reasons
    try:
        raw = path.read_text(encoding="utf-8")
        data: Any = json.loads(raw)
    except OSError as exc:
        return [f"evidence_invalid: cannot read {path}: {exc.__class__.__name__}"]
    except json.JSONDecodeError:
        return [f"evidence_invalid: {path} is not JSON"]

    if not isinstance(data, dict):
        return ["evidence_invalid: root must be a JSON object"]

    try:
        evidence_dir = path.resolve().parent
    except OSError as exc:
        return [f"evidence_invalid: cannot resolve {path}: {exc.__class__.__name__}"]

    c3 = data.get("c3")
    if not isinstance(c3, dict):
        reasons.append("evidence_invalid: missing c3 object")
        c3 = {}
    c3_proofs = data.get("c3_proofs")
    if not isinstance(c3_proofs, dict):
        reasons.append("evidence_invalid: missing c3_proofs object")
        c3_proofs = {}
    for key in C3_KEYS:
        val = c3.get(key)
        if val not in C3_OK:
            reasons.append(f"c3_{key}: want migrated|waived, got {val!r}")
        miss = _check_proof_file(
            reason_prefix=f"c3_{key}",
            evidence_dir=evidence_dir,
            proofs=c3_proofs,
            key=key,
        )
        if miss is not None:
            reasons.append(miss)

    mac = data.get("mac")
    if not isinstance(mac, dict):
        reasons.append("evidence_invalid: missing mac object")
        mac = {}
    mac_proofs = data.get("mac_proofs")
    if not isinstance(mac_proofs, dict):
        reasons.append("evidence_invalid: missing mac_proofs object")
        mac_proofs = {}
    for flag in MAC_FLAGS:
        if mac.get(flag) is not True:
            reasons.append(f"mac_{flag}: want true, got {mac.get(flag)!r}")
        miss = _check_proof_file(
            reason_prefix=f"mac_{flag}",
            evidence_dir=evidence_dir,
            proofs=mac_proofs,
            key=flag,
        )
        if miss is not None:
            reasons.append(miss)

    # Deletion path only: FIXTURE / LINUX-SAFE Mac captures never count as live.
    if refuse_non_live_mac:
        reasons.extend(_mac_not_live_reasons(data, evidence_dir))

    today = datetime.date.today()
    if today < SOFT_DEADLINE and not allow_early:
        reasons.append(
            f"soft_deadline: today {today.isoformat()} < {SOFT_DEADLINE.isoformat()}; "
            "pass --allow-early only when C3+Mac evidence is complete"
        )
    return reasons


def evaluate(
    root: Path,
    *,
    evidence: Path | None,
    allow_early: bool,
) -> dict[str, Any]:
    reasons = check_callers(root)
    reasons.extend(check_evidence(evidence, allow_early=allow_early))
    return {
        "tool": TOOL,
        "root": str(root),
        "soft_deadline": SOFT_DEADLINE.isoformat(),
        "allow_early": allow_early,
        "evidence": str(evidence) if evidence else None,
        "dry_run": False,
        "ready": not reasons,
        "reasons": reasons,
    }


def _fixture_label_reasons(evidence: Path) -> list[str]:
    """FAILCLOSED: dry-run only accepts the labeled FIXTURE bundle (not invented live)."""
    reasons: list[str] = []
    try:
        data: Any = json.loads(evidence.read_text(encoding="utf-8"))
    except OSError as exc:
        return [f"fixture_invalid: cannot read {evidence}: {exc.__class__.__name__}"]
    except json.JSONDecodeError:
        return [f"fixture_invalid: {evidence} is not JSON"]
    if not isinstance(data, dict):
        return ["fixture_invalid: root must be a JSON object"]
    if data.get("recorded") != FIXTURE_RECORDED:
        reasons.append(
            f"fixture_invalid: recorded must be {FIXTURE_RECORDED!r}, "
            f"got {data.get('recorded')!r}"
        )
    note = data.get("note")
    if not isinstance(note, str) or "FIXTURE" not in note or "NOT" not in note:
        reasons.append(
            "fixture_invalid: note must declare FIXTURE / NOT live Mac "
            "(refuse invented live proofs)"
        )
    try:
        evidence_dir = evidence.resolve().parent
    except OSError as exc:
        return [f"fixture_invalid: cannot resolve {evidence}: {exc.__class__.__name__}"]

    mac_proofs = data.get("mac_proofs")
    if not isinstance(mac_proofs, dict):
        reasons.append("fixture_invalid: missing mac_proofs object")
    else:
        for flag in MAC_FLAGS:
            path = _proof_path(evidence_dir, mac_proofs.get(flag))
            if path is None:
                reasons.append(
                    f"fixture_invalid: mac_proofs.{flag} missing for FIXTURE label check"
                )
                continue
            try:
                text = path.read_text(encoding="utf-8", errors="replace")
            except OSError as exc:
                reasons.append(
                    f"fixture_invalid: unreadable mac proof {path}: "
                    f"{exc.__class__.__name__}"
                )
                continue
            if not text.startswith(FIXTURE_PROOF_LABEL):
                reasons.append(
                    f"fixture_invalid: {path.name} must start with "
                    f"{FIXTURE_PROOF_LABEL!r} (not live Mac stdout)"
                )
            elif "cmd:" not in text or "verified:" not in text:
                reasons.append(
                    f"fixture_invalid: {path.name} must include cmd: and verified: "
                    "(Linux-safe probe shape; still NOT live Mac)"
                )

    c3_proofs = data.get("c3_proofs")
    if not isinstance(c3_proofs, dict):
        reasons.append("fixture_invalid: missing c3_proofs object")
    else:
        for key in C3_KEYS:
            path = _proof_path(evidence_dir, c3_proofs.get(key))
            if path is None:
                reasons.append(
                    f"fixture_invalid: c3_proofs.{key} missing for FIXTURE label check"
                )
                continue
            try:
                text = path.read_text(encoding="utf-8", errors="replace")
            except OSError as exc:
                reasons.append(
                    f"fixture_invalid: unreadable c3 proof {path}: "
                    f"{exc.__class__.__name__}"
                )
                continue
            if not text.startswith(C3_FIXTURE_PROOF_LABEL):
                reasons.append(
                    f"fixture_invalid: {path.name} must start with "
                    f"{C3_FIXTURE_PROOF_LABEL!r} (not invented outside probe)"
                )
                continue
            # C3 FIXTURE shape: key + Linux-safe cmd (or waive) + verified stand-in.
            if f"c3_key: {key}" not in text:
                reasons.append(
                    f"fixture_invalid: {path.name} must declare c3_key: {key}"
                )
            has_cmd = "cmd:" in text
            has_waive = "waive:" in text
            if not has_cmd and not has_waive:
                reasons.append(
                    f"fixture_invalid: {path.name} must include cmd: (Linux-safe rg) "
                    "or waive: (operator one-liner)"
                )
            if "verified:" not in text:
                reasons.append(
                    f"fixture_invalid: {path.name} must include verified: "
                    "(FIXTURE stand-in until outside probe paste)"
                )
    return reasons


def evaluate_dry_run(root: Path) -> dict[str, Any]:
    """FIXTURE-only FAILCLOSED shape regression; never deletion-ready / never live Mac."""
    evidence = root / FIXTURE_EVIDENCE_REL
    reasons: list[str] = []
    if not evidence.is_file():
        reasons.append(f"fixture_invalid: missing {FIXTURE_EVIDENCE_REL.as_posix()}")
    else:
        reasons.extend(_fixture_label_reasons(evidence))
        # Soft deadline does not apply to fixture shape regression.
        # Skip mac_not_live: dry-run *requires* the FIXTURE Mac labels.
        reasons.extend(
            check_evidence(evidence, allow_early=True, refuse_non_live_mac=False)
        )
    # Drop soft_deadline if check_evidence ever reintroduces it without allow_early.
    reasons = [r for r in reasons if not r.startswith("soft_deadline:")]
    fixture_shape_ok = not reasons
    return {
        "tool": TOOL,
        "root": str(root),
        "soft_deadline": SOFT_DEADLINE.isoformat(),
        "allow_early": False,
        "evidence": str(evidence) if evidence.is_file() else None,
        "dry_run": True,
        "mode": "dry-run-fixture",
        "fixture_shape_ok": fixture_shape_ok,
        # Mac live cycle stays blocked on this path (no Darwin host required).
        "mac_live_blocked": True,
        # Never green deletion from --dry-run, even when fixture shape is OK.
        "ready": False,
        "reasons": reasons
        if reasons
        else [
            "dry_run: FIXTURE Mac+C3 proofs shape OK — NOT live Mac; NOT deletion-ready "
            "(C3 outside still needs operator paste; Mac needs "
            "wave6-mac-proof-capture --live on Darwin; Linux-safe probes via --linux-safe "
            "never count as Mac live)"
        ],
    }


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(
        prog=TOOL,
        description=__doc__.split("\n\n")[0],
    )
    p.add_argument(
        "--root",
        type=Path,
        default=None,
        help="repository root (default: parent of bin/)",
    )
    p.add_argument(
        "--evidence",
        type=Path,
        default=None,
        help="Mac live-cycle + C3 evidence JSON (wave6-follow-up.md B)",
    )
    p.add_argument(
        "--allow-early",
        action="store_true",
        help="permit delete before 2026-11-20 when evidence gates are green",
    )
    p.add_argument(
        "--dry-run",
        action="store_true",
        help=(
            "FIXTURE FAILCLOSED shape regression only "
            f"({FIXTURE_EVIDENCE_REL.as_posix()}); not deletion-ready"
        ),
    )
    p.add_argument(
        "--inventory",
        action="store_true",
        help=(
            "list every remaining gated §A relay/acp-dispatch/acp-run reference "
            "with gate_exits proving coverage; never Mac-live / never deletion-ready"
        ),
    )
    p.add_argument("--json", action="store_true", help="print the full result as JSON")
    args = p.parse_args(argv)

    if (args.dry_run or args.inventory) and (
        args.evidence is not None or args.allow_early
    ):
        return die(
            "--dry-run/--inventory is incompatible with --evidence / --allow-early"
        )

    root = args.root
    if root is None:
        root = Path(__file__).resolve().parent.parent
    try:
        root = root.resolve()
    except OSError as exc:
        return die(f"unreadable root: {exc.__class__.__name__}")
    if not root.is_dir():
        return die(f"root is not a directory: {root}")

    if args.inventory:
        result = evaluate_inventory(root, with_dry_run=args.dry_run)
        ok = bool(result.get("inventory_ok"))
    elif args.dry_run:
        result = evaluate_dry_run(root)
        ok = bool(result.get("fixture_shape_ok"))
    else:
        result = evaluate(root, evidence=args.evidence, allow_early=args.allow_early)
        ok = bool(result["ready"])

    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    elif args.inventory and ok:
        n = int(result.get("callers_remaining") or 0)
        print(
            f"{TOOL}: inventory OK ({n} gated caller hit(s); "
            "NOT live Mac; NOT deletion-ready)"
        )
    elif args.dry_run and ok:
        print(
            f"{TOOL}: dry-run FIXTURE shape OK "
            "(NOT live Mac; NOT deletion-ready)"
        )
    elif result["ready"]:
        print(f"{TOOL}: ready (all gates green)")
    else:
        if args.inventory:
            label = "inventory not OK"
        elif args.dry_run:
            label = "dry-run not OK"
        else:
            label = "not ready"
        print(
            f"{TOOL}: {label} ({len(result['reasons'])} reason(s))",
            file=sys.stderr,
        )
        for r in result["reasons"]:
            print(f"  - {r}", file=sys.stderr)
        if args.inventory and not args.json:
            # Always surface the untruncated gated list on stderr for humans.
            for hit in result.get("references") or []:
                print(
                    f"  ref: {hit.get('kind')} {hit.get('path')}:{hit.get('line')} "
                    f"{hit.get('snippet')}",
                    file=sys.stderr,
                )

    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())

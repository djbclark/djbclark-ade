#!/usr/bin/env bash
# heavy-shim: PATH shim for `swift` and `xcodebuild` (linked as ~/.local/bin/swift and. Implementation: console/game/tools/heavy_shim.rpy.
# The invoked name ($0, e.g. ~/.local/bin/swift) is passed first, because the tool's behaviour depends on it.
exec "$(dirname "$(readlink -f "$0")")/ade-console-run" tool_heavy_shim "$(basename "$0")" "$@"

    "checks": (EV_CHECK_SUITE, EV_STATE, EV_HEAD, EV_MERGE_CONFLICT),
    "review": (EV_REVIEW, EV_STATE),
    "merge": (EV_STATE,),
    "any": (EV_CHECK_SUITE, EV_REVIEW, EV_STATE, EV_HEAD, EV_MERGE_CONFLICT),
}

LISTEN_READY_MARKER = "Listening for events."
PR_FIELDS_CHECKS = "url,state,mergedAt,headRefOid,mergeable,statusCheckRollup"
PR_FIELDS_MERGE = "url,state,mergedAt,headRefOid"

REVIEW_GRAPHQL_QUERY = (
    "query($owner:String!,$name:String!,$number:Int!){"
    "repository(owner:$owner,name:$name){"
    "pullRequest(number:$number){"
    "url state mergedAt headRefOid "
    "reviews(last:100){nodes{id databaseId state submittedAt author{login}}}"
    "}}}"
)

ANY_GRAPHQL_QUERY = (
    "query($owner:String!,$name:String!,$number:Int!){"
    "repository(owner:$owner,name:$name){"
    "pullRequest(number:$number){"
    "url state mergedAt headRefOid mergeable "
    "reviews(last:100){nodes{id databaseId state submittedAt author{login}}} "
    "commits(last:1){nodes{commit{statusCheckRollup{contexts(last:100){nodes{"
    "__typename "
    "... on CheckRun{name status conclusion} "
    "... on StatusContext{context state}"
    "}}}}}}"
    "}}}"
)

VALID_PR_STATES = frozenset({"OPEN", "MERGED", "CLOSED"})
SUBMITTED_REVIEW_STATES = frozenset({"APPROVED", "CHANGES_REQUESTED", "COMMENTED", "DISMISSED"})
CHECK_PASS_CONCLUSIONS = frozenset({"SUCCESS", "NEUTRAL", "SKIPPED"})

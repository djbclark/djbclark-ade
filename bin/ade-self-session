#!/usr/bin/env -S python3 -I
"""Explicit native self-session operations (local daemon only).

ade-self-session handoff --checkpoint FILE --quiesced [--thinking LEVEL] [--title TEXT] [--role ROLE]
ade-self-session compact --checkpoint FILE --request-id TOKEN
ade-self-session status|reconcile --record FILE
ade-self-session finish --record FILE [--stable S] [--wait-timeout S] [--poll S]
ade-self-session accept --record FILE --ack-file FILE

Checkpoint files are nonsecret agent-authored briefings. Creation/send receipts
are requests, never completed handoffs or compactions. No force/workspace archive.

Exit: 0 the step reached its reported state (requested, awaiting-ack, acknowledged, archived); 1 blocked or unknown
(including creation-unknown: reconcile); 3 creation-refused (Paseo refused before creating anything; the predecessor keeps working).
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
from ade_self_session import FINISH_POLL, FINISH_STABLE, FINISH_TIMEOUT, Service, SessionError


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('--state-dir', type=Path, default=Path(os.environ.get('ADE_SELF_SESSION_STATE') or Path.home() / '.local/state/djbclark-ade/self-session'))  # same default as ade_lead_succession.default_state_dir (this script is copied alone in tests: no import)
    p.add_argument('--paseo-home', type=Path, default=Path(os.environ.get('PASEO_HOME') or Path.home() / '.paseo'))
    sub = p.add_subparsers(dest='command', required=True)
    for command in ('handoff', 'compact'):
        q = sub.add_parser(command)
        q.add_argument('--checkpoint', required=True, type=Path)
        if command == 'handoff':
            q.add_argument('--mode', choices=('plan', 'read-only', 'dontAsk'), help='explicit operator-requested restrictive successor mode; must exist in native catalog')
            q.add_argument('--thinking', metavar='LEVEL', help='successor thinking option ID (for example high); default: the predecessor\'s own level when it has an explicit one')
            q.add_argument('--title', help='successor title; default: the predecessor\'s own name (a lead keeps its name through every handoff)')
            q.add_argument('--role', help='ade.role label for the successor; default: the one the predecessor\'s handoff record carried (Paseo\'s CLI cannot read labels back, so a chain\'s first handoff names it here)')
            q.add_argument('--route-kind', choices=('code', 'judgment', 'research', 'bulk', 'mechanical'), help='explicit routed Pi successor; requires post-ack first-real-turn verification')
            q.add_argument('--quiesced', action='store_true', help='attest other jobs/writes finished; successor waits for retirement')
        else:
            q.add_argument('--request-id', required=True, help='reuse on retry; new ID only for a deliberately new request')
    for command in ('status', 'reconcile', 'accept', 'finish', 'verify-turn', 'retry', 'appoint'):
        q = sub.add_parser(command)
        q.add_argument('--record', required=True, type=Path)
        if command == 'appoint':
            q.add_argument('--appointed', required=True)
            q.add_argument('--pool', required=True, help='explicit physical account pool of appointed lead')
            q.add_argument('--operator-appointed', action='store_true')
            q.add_argument('--quiesced', action='store_true')
        if command == 'accept':
            q.add_argument('--ack-file', required=True, type=Path)
        if command == 'finish':
            q.add_argument('--stable', type=float, default=FINISH_STABLE, metavar='SECONDS', help='predecessor must stay idle (no permission waits) this long before archive (default %(default)g); 0 = one sample')
            q.add_argument('--wait-timeout', type=float, default=FINISH_TIMEOUT, metavar='SECONDS', help='overall bound for the waits and AGENT_RUNNING retries (default %(default)g); with --stable 0, 0 = no waiting: one sample, one archive attempt')
            q.add_argument('--poll', type=float, default=FINISH_POLL, metavar='SECONDS', help='seconds between samples (default %(default)g)')
    a = p.parse_args()
    service = Service(a.state_dir, a.paseo_home, progress=lambda message: print(message, file=sys.stderr, flush=True))
    try:
        if a.command == 'handoff':
            result = service.handoff(a.checkpoint, quiesced=a.quiesced, requested_mode=a.mode,
                                     requested_thinking=a.thinking, requested_title=a.title,
                                     requested_role=a.role, route_kind=a.route_kind)
        elif a.command == 'appoint':
            result = service.appoint(a.record, appointed=a.appointed, pool=a.pool,
                                     operator_appointed=a.operator_appointed, quiesced=a.quiesced)
        elif a.command == 'verify-turn':
            result = service.verify_turn(a.record)
        elif a.command == 'compact':
            result = service.compact(a.checkpoint, request_id=a.request_id)
        elif a.command == 'accept':
            result = service.accept(a.record, a.ack_file)
        elif a.command == 'finish':
            result = service.finish(a.record, stable=a.stable, timeout=a.wait_timeout, poll=a.poll)
        else:
            result = getattr(service, a.command)(a.record)
    except SessionError as error:
        print(json.dumps({'status': 'blocked', 'reason': str(error)}))
        return 1
    except (OSError, ValueError, KeyError, ImportError):
        print(json.dumps({'status': 'blocked', 'reason': 'operation unconfirmed; preserve checkpoint/sessions and inspect supported API, identity and transaction before retry'}))
        return 1
    print(json.dumps(result, indent=2, sort_keys=True))
    if result['status'] == 'creation-refused':
        print('creation-refused: Paseo refused the successor (see native_error); nothing was created and the predecessor keeps working', file=sys.stderr)
        return 3
    return 0 if result['status'] in ('requested', 'awaiting-ack', 'ack-pending-turn', 'acknowledged', 'archived') else 1


if __name__ == '__main__':
    raise SystemExit(main())

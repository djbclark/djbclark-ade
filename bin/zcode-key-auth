#!/usr/bin/env node
/*
zcode-key-auth: keep zcode on the Z.ai Coding Plan API key, so its login never expires. No model.

    zcode-key-auth status            auth-source, and whether the stored key matches the vault (hashes only)
    zcode-key-auth apply [--ping]    set auth-source=manual and the vault key; exit 0 unchanged or repaired
    zcode-key-auth install|uninstall the launchd check (launchd/com.djbclark.zcode-key-auth.plist)

Why (2026-10-18): `zcode login` stores an OAuth token, and every turn exchanges it at
api.z.ai/api/auth/z/login for the key the model API takes. That exchange stops working about a day
after each login (`project_token_login_failed`; zai-org/feedback#1001, 248 failed turns 2026-10-14..16).
The account provider (`account:zai-individual-coding-plan`, listed as `builtin:zai-coding-plan\GLM-5.3`)
has a second mode the desktop app uses: with `account-provider:<id>:auth-source` = "manual" it sends the
API key stored under `account-provider:coding-plan:<id>:account:<identity>:api-key` and never touches the
OAuth token. The CLI's own login always writes "oauth", so **never run `zcode login` again**; if
something does, `apply` puts it back. The separate API-key providers (`builtin:zai`, or a custom one)
are not selectable on zcode 3.15.3 (zai-org/feedback#1067), so this is the only key route.
Proved with a HOME holding no OAuth or JWT entries at all: a turn completed (2026-10-18).

credentials.json values are `enc:v1:<iv>.<tag>.<ct>` (base64url), AES-256-GCM, key =
sha256(ZCODE_CREDENTIAL_SECRET or `zcode-credential-fallback:<platform>:<home>:<user>`), read from
zcode-app-cli 3.15.3-36's bundle (vendor/zcode.cjs, createZCodeCredentialCipher). Node, not Python:
the stdlib has no AES-GCM, and zcode needs Node anyway.

The key lives in sudo-secretspec as ZAI_CODING_PLAN_API_KEY; without it in the environment this
re-runs itself under `sudo-secretspec run`. No value is ever printed.
Exit: 0 ok (unchanged or repaired), 1 failed, 2 usage.
*/
"use strict";
const crypto = require("crypto"), os = require("os"), fs = require("fs"), path = require("path");
const { execFileSync, spawnSync } = require("child_process");

const CRED = path.join(os.homedir(), ".zcode/v2/credentials.json");
const PROVIDER = "account:zai-individual-coding-plan";
const SOURCE = `account-provider:${PROVIDER}:auth-source`;
const VAULT = "ZAI_CODING_PLAN_API_KEY";
const LABEL = "com.djbclark.zcode-key-auth";
const PLIST_SRC = path.join(__dirname, "..", "launchd", `${LABEL}.plist`);
const PLIST_DST = path.join(os.homedir(), "Library/LaunchAgents", `${LABEL}.plist`);

const secret = (process.env.ZCODE_CREDENTIAL_SECRET || "").trim()
  || `zcode-credential-fallback:${os.platform()}:${os.homedir()}:${os.userInfo().username}`;
const KEY = crypto.createHash("sha256").update(secret).digest();
const fp = s => crypto.createHash("sha256").update(s).digest("hex").slice(0, 8);

function decrypt(v) {
  if (!v.startsWith("enc:v1:")) return v;
  const [iv, tag, ct] = v.slice(7).split(".").map(p => Buffer.from(p, "base64url"));
  const d = crypto.createDecipheriv("aes-256-gcm", KEY, iv);
  d.setAuthTag(tag);
  return Buffer.concat([d.update(ct), d.final()]).toString("utf8");
}

function encrypt(s) {
  const iv = crypto.randomBytes(12), c = crypto.createCipheriv("aes-256-gcm", KEY, iv);
  const ct = Buffer.concat([c.update(s, "utf8"), c.final()]);
  return "enc:v1:" + [iv, c.getAuthTag(), ct].map(b => b.toString("base64url")).join(".");
}

function load() {
  const d = JSON.parse(fs.readFileSync(CRED, "utf8"));
  const keyName = Object.keys(d).find(k => k.startsWith(`account-provider:coding-plan:${PROVIDER}:account:`)
    && k.endsWith(":api-key"));
  // The identity and key entries exist once `zcode login` has run on this machine; without them
  // there is no account to attach the key to.
  if (!keyName || !d[`account-provider:${PROVIDER}:identity`])
    throw new Error(`no ${PROVIDER} identity in ${CRED}: run \`zcode login\` once, then \`zcode-key-auth apply\``);
  return { d, keyName, source: d[SOURCE] ? decrypt(d[SOURCE]) : null, stored: decrypt(d[keyName] || "") };
}

function ping(msg) {
  spawnSync(path.join(os.homedir(), ".local/bin/hermes-ping"), [msg], { stdio: "ignore" });
}

function withVault(args) {
  if (process.env[VAULT]) return process.env[VAULT].trim();
  // Up to 3 tries, 10 s apart (2026-10-18): concurrent opens of the vault's history DB can race on
  // CREATE TRIGGER ("trigger captured_values_is_append_only already exists"), and the first launchd run,
  // at load 85, hit it; an immediate retry succeeds. The child is this script, so a retry is idempotent.
  let r;
  for (let i = 0; i < 3; i++) {
    if (i) spawnSync("/bin/sleep", ["10"]);
    r = spawnSync("sudo-secretspec", ["run", "--reason", "zcode-key-auth: keep zcode on the coding plan key",
      "--", process.execPath, __filename, "apply", ...args],
      { stdio: "inherit", env: { ...process.env, ZKA_CHILD: "1" } });
    if (r.status === 0) break;
  }
  // The child never pings a failure (ZKA_CHILD), so three tries make one ping, here.
  if (r.status !== 0 && args.includes("--ping"))
    ping(`djbclark-ade: zcode-key-auth apply failed after 3 tries (rc ${r.status}); see ~/.local/state/zcode-key-auth/apply.err`);
  process.exit(r.status ?? 1);
}

function status() {
  const { source, stored } = load();
  const vault = (process.env[VAULT] || "").trim();
  console.log(`auth-source=${source} stored-key=${stored ? fp(stored) : "none"}`
    + (vault ? ` vault-key=${fp(vault)} match=${vault === stored}` : ""));
  return source === "manual" && (!vault || vault === stored) ? 0 : 1;
}

function apply(args) {
  const want = withVault(args);
  const { d, keyName, source, stored } = load();
  if (source === "manual" && stored === want) {
    if (!args.includes("--quiet")) console.log("zcode-key-auth: unchanged (auth-source=manual, key matches the vault)");
    return 0;
  }
  d[SOURCE] = encrypt("manual");
  d[keyName] = encrypt(want);
  // Atomic replace, mode kept (0600): zcode reads this file on every turn.
  const tmp = `${CRED}.tmp${process.pid}`;
  fs.writeFileSync(tmp, JSON.stringify(d, null, 2), { mode: fs.statSync(CRED).mode & 0o777 });
  fs.renameSync(tmp, CRED);
  const msg = `zcode-key-auth: repaired (auth-source ${source} -> manual, key ${stored ? fp(stored) : "none"} -> ${fp(want)})`;
  console.log(msg);
  if (args.includes("--ping")) ping(`djbclark-ade: ${msg}; did someone run zcode login?`);
  return 0;
}

function install() {
  fs.mkdirSync(path.dirname(PLIST_DST), { recursive: true });
  fs.mkdirSync(path.join(os.homedir(), ".local/state/zcode-key-auth"), { recursive: true });
  fs.copyFileSync(PLIST_SRC, PLIST_DST);
  spawnSync("launchctl", ["bootout", `gui/${os.userInfo().uid}/${LABEL}`], { stdio: "ignore" });
  execFileSync("launchctl", ["bootstrap", `gui/${os.userInfo().uid}`, PLIST_DST], { stdio: "inherit" });
  console.log(`installed ${PLIST_DST}`);
  return 0;
}

function uninstall() {
  spawnSync("launchctl", ["bootout", `gui/${os.userInfo().uid}/${LABEL}`], { stdio: "ignore" });
  fs.rmSync(PLIST_DST, { force: true });
  console.log(`removed ${PLIST_DST}`);
  return 0;
}

const [cmd, ...rest] = process.argv.slice(2);
const table = { status, apply: () => apply(rest), install, uninstall };
if (!table[cmd]) {
  console.error("usage: zcode-key-auth status | apply [--ping] [--quiet] | install | uninstall");
  process.exit(2);
}
try {
  process.exit(table[cmd]());
} catch (e) {
  console.error(`zcode-key-auth: ${e.message}`);
  if (rest.includes("--ping") && !process.env.ZKA_CHILD) ping(`djbclark-ade: zcode-key-auth failed: ${e.message}`);
  process.exit(1);
}

#!/usr/bin/env bash
# ade-git-guard — a `git` front door for what git's own hooks cannot see in a workspace another agent owns.
#
# TWO ENFORCEMENT POINTS (O2, 2026-10-25; docs/git-guard.md): git's hooks guard REFS (libexec/git-hooks/reference-transaction
# and pre-push: `refs/heads/<claimed>` is refused however the argv spelled the write); this shim guards what hooks cannot
# see: a foreign workspace (read-only allowlist), the shared checkout's destructive forms, `worktree remove|move|prune`,
# `branch -m|-c` destinations, and it FAILS CLOSED on what it cannot read (an unknown option or subcommand, config that
# redirects the hooks, `push --no-verify`). It installs the hooks lazily.
#
# SEATBELT, NOT A SANDBOX (design 5.7): it stops accidental or careless git, not a determined agent. Out of reach by
# design: an absolute path to the real git, unsetting ACP_RUN_AGENT/ADE_CLAIM_ID, another agent's ADE_CLAIM_ID,
# editing the claim registry, and EVERYTHING GIT ITSELF SPAWNS (`bisect run`, `submodule foreach`, pagers,
# core.fsmonitor, diff.external, core.sshCommand, `fetch --upload-pack`, any `git` a `!` alias runs): git puts its own
# exec-path first on its children's PATH, so they reach the real git, not this shim. (The hooks still run for those.)
#
# Installed as libexec/agent-bin/git (a relative symlink to ../../bin/ade-git-guard). Integration stage as of
# 2026-10-25: only this guard, the hooks and bin/ade_claims.py exist (slice W1). Slices W3 (acp-dispatch exports
# ADE_CLAIM_ID), W4 (acp-run puts libexec/agent-bin first on the PATH of every agent it launches) and W2 (cow-pasture
# installs the hooks into a new pasture) are NOT wired yet, so nothing reaches git through here until they land; the
# operator's shell, Orca and IDEs never will.
# Design: design-isolation-report.md 3.4-3.5 (2026-10-24); O2 design: frontier-pr59-design-report.md (2026-10-25).
#
#   git ARGS...                           (the shim) run the real git, or refuse with exit 77
#   ade-git-guard git-ARGS...             the same, called by name
#   ade-git-guard install [DIR]           install the hook stubs into DIR's repository (exit 2 not a repository,
#                                         78 core.hooksPath is set, 73 NAME.pre-ade is in the way)
#   ade-git-guard --real-git              print the git this guard would run
#   ade-git-guard --help
#
# Order of work, cheapest first (one bash exec and no Python for the common call):
#   1. Not an agent process (neither ACP_RUN_AGENT=1 nor ADE_CLAIM_ID set): exec the real git untouched.
#   2. Inside a git hook (GIT_INDEX_FILE set) or pre-commit (PRE_COMMIT set): exec the real git untouched.
#   3. A plain read (status log show diff rev-parse ls-files ls-tree cat-file blame describe rev-list for-each-ref grep
#      shortlog name-rev merge-base version help), after -C/-c/--git-dir=...: exec. No argument is scanned.
#   4. Everything else: `python3 -I -S ade_claims.py guard -- ARGS`, which looks up the workspace claim
#      (`.git/ade-claim` -> ~/.local/state/ade/claims/<id>.json). Exit 0 -> exec the real git (after installing the hooks
#      into the repository when they are missing); exit 77 -> the refusal text (owner, claim id, safe alternative) is on
#      stderr, one line is in ~/.local/state/ade/guard.log, and git never runs.
# A broken guard (no python3, a crash) fails OPEN with a warning on stderr: a guard bug must not stop all git.
#
# Exit codes: 77 refused (EX_NOPERM); every other code is the real git's.
# Environment: ADE_CLAIM_ID (the caller's claim id, exported by acp-dispatch), ACP_RUN_AGENT, ADE_STATE_DIR
# (default ~/.local/state/ade; claims/ and guard.log live there), ADE_REAL_GIT (skip the PATH search),
# ADE_PYTHON (default python3), ACP_OPERATOR_APPROVED=git-guard (allow and log one call).
set -u

self="$0"
real=""
if [ -n "${ADE_REAL_GIT:-}" ] && [ -x "$ADE_REAL_GIT" ] && ! [ "$ADE_REAL_GIT" -ef "$self" ]; then
  real="$ADE_REAL_GIT"
else
  set -f
  IFS=:
  for d in $PATH; do
    if [ -n "$d" ] && [ -x "$d/git" ] && ! [ "$d/git" -ef "$self" ]; then
      real="$d/git"
      break
    fi
  done
  unset IFS
  set +f
  if [ -z "$real" ]; then
    for c in /usr/bin/git /opt/homebrew/bin/git /usr/local/bin/git; do
      if [ -x "$c" ] && ! [ "$c" -ef "$self" ]; then real="$c"; break; fi
    done
  fi
fi
if [ -z "$real" ]; then
  echo "ade-git-guard: no real git found on PATH" >&2
  exit 127
fi

# python library next to this script, through the shim's symlink
lib_path() {
  local src="$self" t
  case "$src" in */*) ;; *) src="./$src" ;; esac
  while [ -L "$src" ]; do
    t=$(readlink "$src")
    case "$t" in /*) src="$t" ;; *) src="${src%/*}/$t" ;; esac
  done
  printf '%s/ade_claims.py' "${src%/*}"
}

# -I: isolated (no PYTHON* variables, no user site, no script dir on sys.path), -S: no site import (faster)
run_python() {
  local py lib
  py="${ADE_PYTHON:-python3}"
  lib=$(lib_path)
  command -v "$py" > /dev/null 2>&1 && [ -f "$lib" ] || return 126
  ADE_REAL_GIT="$real" "$py" -I -S "$lib" "$@"
}

# the leading comment block as usage text; a function, because bash 3.2 cannot parse a `case` pattern's `)` inside `$( )`
print_usage() {
  local line
  while IFS= read -r line; do
    case "$line" in "#!"*) continue ;; "#"*) printf '%s\n' "${line#\# }" ;; *) break ;; esac
  done < "$self"
}

if [ "${self##*/}" = "ade-git-guard" ]; then
  case "${1:-}" in
    -h | --help | "")
      print_usage
      exit 0
      ;;
    --real-git)
      printf '%s\n' "$real"
      exit 0
      ;;
    install)
      run_python install "${@:2}"
      rc=$?
      case "$rc" in 126) echo "ade-git-guard: install needs python3 and bin/ade_claims.py" >&2; exit 1 ;; *) exit "$rc" ;; esac
      ;;
  esac
fi

# 1-2: not an agent, or inside a git hook
if { [ -z "${ADE_CLAIM_ID:-}" ] && { [ -z "${ACP_RUN_AGENT:-}" ] || [ "${ACP_RUN_AGENT}" = 0 ]; }; } \
  || [ -n "${GIT_INDEX_FILE:-}" ] || [ -n "${PRE_COMMIT:-}" ]; then
  exec "$real" "$@"
fi

# 3: first non-option word (skipping -C DIR, -c K=V and the value-less global flags) is one of the plain reads that cannot
# move a ref or touch another agent's tree (O2: a stray --output file is a nuisance, not lost work, so no argument is scanned)
args=("$@")
n=${#args[@]}
i=0
sub=""
while [ "$i" -lt "$n" ]; do
  a="${args[$i]}"
  case "$a" in
    -C | -c) i=$((i + 2)) ;;
    --no-pager | -P | -p | --paginate | --no-optional-locks | --no-replace-objects | --literal-pathspecs) i=$((i + 1)) ;;
    --git-dir=* | --work-tree=*) i=$((i + 1)) ;;
    -*) break ;;
    *) sub="$a"; break ;;
  esac
done
case "$sub" in
  status | log | show | diff | rev-parse | ls-files | ls-tree | cat-file | blame | describe | rev-list | for-each-ref \
    | grep | shortlog | name-rev | merge-base | version | help)
    exec "$real" "$@"
    ;;
esac

# 4: the rules
run_python guard -- "$@"
rc=$?
case "$rc" in
  0) exec "$real" "$@" ;;
  77) exit 77 ;;
  *)
    echo "ade-git-guard: guard unavailable or failed (rc=$rc); running git unguarded" >&2
    exec "$real" "$@"
    ;;
esac

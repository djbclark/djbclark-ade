#!/usr/bin/env python3
"""Cross-harness messaging helper (docs/cross-harness-messaging.md).

Two verified directions, one command:

    xmsg to-paseo <agent-id> 'message…'      # paseo send --json --no-wait, then print the JSON status
    xmsg to-claude <session-id> 'message…'   # atomic mailbox drop into its inbox

Read-only otherwise; never reads a message it did not write. The mailbox write
goes to a temp name then mv's, so the reader never sees a half-written file.
"""
from __future__ import annotations

import json
import subprocess
import sys
import tempfile
from pathlib import Path


def _mailbox_home() -> Path:
    return Path.home() / ".local" / "state" / "agent-reports"


def to_paseo(agent_id: str, text: str) -> int:
    r = subprocess.run(["paseo", "send", "--json", "--no-wait", agent_id, "--prompt", text],
                       capture_output=True, text=True)
    if r.returncode != 0:
        print(f"xmsg: paseo send failed: {r.stderr.strip()}", file=sys.stderr)
        return 1
    try:
        body = json.loads(r.stdout)
    except ValueError:
        body = {"raw": r.stdout.strip()}
    status = body.get("status", "?")
    print(f"xmsg: to-paseo {agent_id} status={status}")
    return 0


def to_claude(session_id: str, text: str) -> int:
    inbox = _mailbox_home() / session_id / "inbox"
    inbox.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(inbox.parent), suffix=".tmp")
    with open(fd, "w") as fh:
        fh.write(text + "\n")
    dest = inbox / f"{session_id[:8]}-{tmp.split('.tmp')[0].split('/')[-1]}.msg"
    Path(tmp).rename(dest)
    print(f"xmsg: to-claude {session_id} -> {dest}")
    return 0


def main() -> int:
    if len(sys.argv) < 4:
        print("xmsg to-paseo <agent-id> 'message…'", file=sys.stderr)
        print("xmsg to-claude <session-id> 'message…'", file=sys.stderr)
        return 2
    direction, target, text = sys.argv[1], sys.argv[2], sys.argv[3]
    if direction == "to-paseo":
        return to_paseo(target, text)
    if direction == "to-claude":
        return to_claude(target, text)
    print(f"xmsg: unknown direction {direction!r}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""Cross-harness messaging helper (docs/cross-harness-messaging.md).

Two verified directions, one command, with a machine-checkable ack:

    xmsg to-paseo <agent-id> 'message…' [--reply-file PATH]
    xmsg to-claude <reply-path> 'message…'

The reply path is always explicit, never guessed. A local Claude Code session
names its own scratchpad file (e.g. .../scratchpad/lead-reply.md) and the
recipient writes its ack there atomically; a Paseo recipient writes the named
`.ack` artifact. Every write goes to a temp name then mv's, so the reader never
sees a half-written file.

Read-only otherwise; never reads a message it did not write.
"""
from __future__ import annotations

import json
import subprocess
import sys
import tempfile
from pathlib import Path


def _atomic_write(path: Path, text: str) -> Path:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=path.name + ".", suffix=".tmp")
    with open(fd, "w") as fh:
        fh.write(text + "\n")
    Path(tmp).rename(path)
    return path


def to_paseo(agent_id: str, text: str, reply_file: str | None) -> int:
    argv = ["paseo", "send", "--json", "--no-wait", agent_id, "--prompt", text]
    r = subprocess.run(argv, capture_output=True, text=True)
    if r.returncode != 0:
        print(f"xmsg: paseo send failed: {r.stderr.strip()}", file=sys.stderr)
        return 1
    try:
        body = json.loads(r.stdout)
    except ValueError:
        body = {"raw": r.stdout.strip()}
    status = body.get("status", "?")
    print(f"xmsg: to-paseo {agent_id} status={status}")
    # If the sender named a reply file, write the send's own status there so a
    # machine check can distinguish "queued" (accepted) from a failure.
    if reply_file:
        _atomic_write(Path(reply_file), f"xmsg-status: {status}")
    return 0


def to_claude(reply_path: str, text: str) -> int:
    p = Path(reply_path)
    _atomic_write(p, text)
    print(f"xmsg: to-claude -> {p}")
    return 0


def ack(reply_path: str, text: str) -> int:
    """The recipient's acknowledgement: write it to the sender's named reply path."""
    return to_claude(reply_path, text)


def main() -> int:
    args = sys.argv[1:]
    if not args:
        print(__doc__, file=sys.stderr)
        return 2
    direction = args[0]
    if direction == "to-paseo":
        # xmsg to-paseo <id> 'msg' [--reply-file PATH]
        if len(args) < 3:
            print("xmsg to-paseo <agent-id> 'message…' [--reply-file PATH]", file=sys.stderr)
            return 2
        agent_id, text = args[1], args[2]
        reply_file = None
        if len(args) >= 5 and args[3] == "--reply-file":
            reply_file = args[4]
        return to_paseo(agent_id, text, reply_file)
    if direction == "to-claude":
        if len(args) < 3:
            print("xmsg to-claude <reply-path> 'message…'", file=sys.stderr)
            return 2
        return to_claude(args[1], args[2])
    if direction == "ack":
        if len(args) < 3:
            print("xmsg ack <reply-path> 'ack text…'", file=sys.stderr)
            return 2
        return ack(args[1], args[2])
    print(f"xmsg: unknown direction {direction!r}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env -S python3 -I
"""ade-release-ready: dry-run gate for the first (or next) release tag (Carried #15, 2026-11-10).

  ade-release-ready [--repo DIR] [--version X.Y.Z] [--date YYYY-MM-DD] [--json]

Validates release readiness in-repo and prints what a release *would* do. It never
creates, moves or pushes a git tag, never writes CHANGELOG.md, and never folds
fragments (it only runs `changelog-fold --check`). The daily `ade-update --check`
timer install is out of scope (Mac/Linux install PRs; no launchd/systemd apply here).

Checks (queue Carried #15: "tag once CI, rule 10 and ade-update are settled"):

  1. rule 10 — CHANGELOG.md has `## Unreleased`; `changelog-fold --check` passes;
     Unreleased (plus valid fragments that would fold) has at least one `- ` entry
  2. CI     — `.github/workflows/test.yml` and `adversary-marker.yml` are present;
     `ade-roster --check` passes (the same local gate CI's context-policy runs)
  3. ade-update — `bin/ade-update` and sibling `bin/changelog-fold` exist; ade-update's
     usage text advertises `--check`
  4. tag slot — no local git tag `vX.Y.Z` / `X.Y.Z`, and CHANGELOG has no `## X.Y.Z`
     section yet (slim-* / pre-slim-* tags are ignored)

On success it prints the dry-run plan (fold N fragments; move Unreleased under
`## X.Y.Z - DATE`; create tag `vX.Y.Z` at HEAD) and exits 0. Failures list every
problem and exit 1. Exit 2 is usage / an unreadable repo.

Default version is 0.1.0 (first release). Stdlib only; subprocess argv lists only.
"""
from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from datetime import date
from pathlib import Path

EXIT_OK, EXIT_NOT_READY, EXIT_USAGE = 0, 1, 2

VERSION_RE = re.compile(r"^\d+\.\d+\.\d+(?:[-+][A-Za-z0-9.-]+)?$")
DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
RELEASE_TAG_RE = re.compile(r"^v?\d+\.\d+\.\d+(?:[-+][A-Za-z0-9.-]+)?$")
HEADING_RE = re.compile(r"^##\s+(\d+\.\d+\.\d+(?:[-+][A-Za-z0-9.-]+)?)\b")


def run(argv: list[str], *, cwd: Path | None = None, timeout: float = 60) -> tuple[int, str, str]:
    """Run argv (never shell=True); return (rc, stdout, stderr) with UTF-8 replace decode."""
    try:
        p = subprocess.run(
            argv,
            cwd=str(cwd) if cwd is not None else None,
            capture_output=True,
            timeout=timeout,
        )
    except (OSError, subprocess.SubprocessError) as e:
        return 127, "", f"{type(e).__name__}: {e}"
    out = p.stdout.decode("utf-8", "replace")
    err = p.stderr.decode("utf-8", "replace")
    return p.returncode, out, err


def fragment_names(frag_dir: Path) -> list[str]:
    if not frag_dir.is_dir():
        return []
    names = []
    for p in sorted(frag_dir.iterdir(), key=lambda q: q.name):
        if p.name.startswith(".") or p.name == "README.md":
            continue
        if p.is_file() and p.suffix == ".md":
            names.append(p.name)
    return names


def unreleased_entry_count(text: str) -> int:
    """Count `- ` entries under `## Unreleased` (before the next `## ` heading)."""
    lines = text.splitlines()
    start = next((i for i, l in enumerate(lines) if l.startswith("## Unreleased")), None)
    if start is None:
        return 0
    end = next((i for i in range(start + 1, len(lines)) if lines[i].startswith("## ")), len(lines))
    return sum(1 for l in lines[start + 1:end] if l.startswith("- "))


def changelog_has_version(text: str, version: str) -> bool:
    for line in text.splitlines():
        m = HEADING_RE.match(line)
        if m and m.group(1) == version:
            return True
    return False


def local_release_tags(repo: Path) -> list[str]:
    rc, out, err = run(["git", "-C", str(repo), "tag", "-l"], timeout=30)
    if rc != 0:
        return []  # not a git checkout, or git missing: other checks name that
    tags = []
    for line in out.splitlines():
        name = line.strip()
        if name and RELEASE_TAG_RE.fullmatch(name):
            tags.append(name)
    return tags


def head_sha(repo: Path) -> str | None:
    rc, out, err = run(["git", "-C", str(repo), "rev-parse", "HEAD"], timeout=30)
    if rc != 0:
        return None
    sha = out.strip()
    return sha if len(sha) == 40 and all(c in "0123456789abcdef" for c in sha) else None


def script_mentions_check(path: Path) -> bool:
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return False
    # usage / argparse only: avoid matching prose that says "check" elsewhere
    return bool(re.search(r"(--check|add_argument\(\s*[\"']--check)", text))


def assess(repo: Path, version: str, release_date: str) -> dict:
    """Build the readiness report. Never mutates the tree or creates a tag."""
    problems: list[str] = []
    notes: list[str] = []
    checks: dict[str, object] = {}

    changelog = repo / "CHANGELOG.md"
    frag_dir = repo / "changelog.d"
    fold = repo / "bin" / "changelog-fold"
    update = repo / "bin" / "ade-update"
    roster = repo / "bin" / "ade-roster"
    test_wf = repo / ".github" / "workflows" / "test.yml"
    adv_wf = repo / ".github" / "workflows" / "adversary-marker.yml"

    # --- rule 10 ---
    if not changelog.is_file():
        problems.append(f"rule10: {changelog.name} missing")
        checks["changelog"] = "missing"
        cl_text = ""
    else:
        try:
            cl_text = changelog.read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError) as e:
            problems.append(f"rule10: cannot read CHANGELOG.md ({e})")
            checks["changelog"] = "unreadable"
            cl_text = ""
        else:
            if any(l.startswith("## Unreleased") for l in cl_text.splitlines()):
                checks["changelog"] = "ok"
            else:
                problems.append("rule10: CHANGELOG.md has no `## Unreleased` section")
                checks["changelog"] = "no-unreleased"

    fold_rc = None
    fold_out = fold_err = ""
    if not fold.is_file():
        problems.append("rule10: bin/changelog-fold missing")
        checks["changelog_fold"] = "missing"
    else:
        fold_rc, fold_out, fold_err = run(
            [sys.executable, str(fold), "--check", "--repo", str(repo)], timeout=60
        )
        checks["changelog_fold"] = {"rc": fold_rc, "out": (fold_out or fold_err).strip()[:300]}
        if fold_rc != 0:
            problems.append(
                f"rule10: changelog-fold --check failed (rc={fold_rc}): "
                f"{(fold_err or fold_out).strip()[:200] or 'no output'}"
            )

    frags = fragment_names(frag_dir)
    entries = unreleased_entry_count(cl_text) if cl_text else 0
    checks["unreleased_entries"] = entries
    checks["fragments"] = frags
    if entries == 0 and not frags:
        problems.append("rule10: nothing to release (Unreleased empty and no changelog.d fragments)")
    elif entries == 0 and frags and fold_rc not in (0, None):
        problems.append("rule10: Unreleased empty and fragments did not validate (cannot count a fold)")

    # --- CI ---
    if not test_wf.is_file():
        problems.append("ci: .github/workflows/test.yml missing")
        checks["test_workflow"] = False
    else:
        checks["test_workflow"] = True
    if not adv_wf.is_file():
        problems.append("ci: .github/workflows/adversary-marker.yml missing")
        checks["adversary_workflow"] = False
    else:
        checks["adversary_workflow"] = True

    roster_rc = None
    if not roster.is_file():
        problems.append("ci: bin/ade-roster missing (CI context-policy runs --check)")
        checks["ade_roster"] = "missing"
    else:
        roster_rc, roster_out, roster_err = run(
            [sys.executable, str(roster), "--check", "--root", str(repo)], timeout=60
        )
        checks["ade_roster"] = {"rc": roster_rc, "err": (roster_err or roster_out).strip()[:200]}
        if roster_rc != 0:
            problems.append(
                f"ci: ade-roster --check failed (rc={roster_rc}): "
                f"{(roster_err or roster_out).strip()[:200] or 'stale or missing roster block'}"
            )

    # --- ade-update ---
    if not update.is_file():
        problems.append("ade-update: bin/ade-update missing")
        checks["ade_update"] = "missing"
    else:
        has_check = script_mentions_check(update)
        checks["ade_update"] = {"path": str(update), "has_check": has_check}
        if not has_check:
            problems.append("ade-update: bin/ade-update does not advertise --check")
    if not fold.is_file():
        # already reported under rule10; keep the settle check explicit
        if "ade-update: bin/changelog-fold missing (ade-update's fragment sibling)" not in problems:
            problems.append("ade-update: bin/changelog-fold missing (ade-update's fragment sibling)")

    # --- tag slot ---
    tag_name = f"v{version}"
    tags = local_release_tags(repo)
    checks["local_release_tags"] = tags
    colliding = [t for t in tags if t in (tag_name, version) or t.lstrip("v") == version]
    if colliding:
        problems.append(f"tag: local release tag already exists: {', '.join(colliding)}")
    if cl_text and changelog_has_version(cl_text, version):
        problems.append(f"tag: CHANGELOG.md already has `## {version}`")
        checks["changelog_version_section"] = True
    else:
        checks["changelog_version_section"] = False

    sha = head_sha(repo)
    checks["head"] = sha
    if sha is None:
        # a throwaway fixture without git can still validate changelog/CI files;
        # note it, but only fail when we needed a tag plan against a real HEAD
        notes.append("git: HEAD not resolved (not a git checkout, or git failed); tag plan names no sha")

    ready = not problems
    plan = {
        "version": version,
        "date": release_date,
        "tag": tag_name,
        "head": sha,
        "would_fold_fragments": frags,
        "would_changelog_heading": f"## {version} - {release_date}",
        "would_create_tag": tag_name,
        "would_push_tag": False,
        "performed": [],  # always empty: this tool never mutates
    }
    return {
        "ready": ready,
        "problems": problems,
        "notes": notes,
        "checks": checks,
        "plan": plan,
    }


def format_text(rep: dict) -> str:
    status = "READY" if rep["ready"] else "NOT READY"
    lines = [f"ade-release-ready: {status} (dry-run; no tag created, CHANGELOG unchanged)"]
    plan = rep["plan"]
    lines.append(f"  version: {plan['version']}")
    lines.append(f"  date: {plan['date']}")
    lines.append(f"  head: {plan['head'] or '?'}")
    lines.append(
        f"  would: fold {len(plan['would_fold_fragments'])} fragment(s); "
        f"move Unreleased -> {plan['would_changelog_heading']!r}; "
        f"create tag {plan['would_create_tag']} at HEAD (NOT DONE; never pushed)"
    )
    if plan["would_fold_fragments"]:
        lines.append(f"  fragments: {', '.join(plan['would_fold_fragments'])}")
    if rep["problems"]:
        lines.append("  problems:")
        for p in rep["problems"]:
            lines.append(f"    - {p}")
    if rep["notes"]:
        lines.append("  notes:")
        for n in rep["notes"]:
            lines.append(f"    - {n}")
    return "\n".join(lines) + "\n"


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        prog="ade-release-ready",
        description=__doc__.split("\n\n")[0],
        epilog="Exit: 0 ready, 1 not ready, 2 usage. Never creates or pushes a tag.",
    )
    ap.add_argument(
        "--repo",
        default=str(Path(__file__).resolve().parent.parent),
        help="repository root (default: the checkout this script is in)",
    )
    ap.add_argument("--version", default="0.1.0", help="proposed release version (default: 0.1.0)")
    ap.add_argument(
        "--date",
        default=date.today().isoformat(),
        help="proposed CHANGELOG date YYYY-MM-DD (default: today)",
    )
    ap.add_argument("--json", action="store_true", help="print one JSON object on stdout")
    try:
        args = ap.parse_args(argv)
    except SystemExit as e:
        return EXIT_OK if e.code == 0 else EXIT_USAGE

    if not VERSION_RE.fullmatch(args.version):
        print(f"ade-release-ready: bad --version {args.version!r} (want X.Y.Z)", file=sys.stderr)
        return EXIT_USAGE
    if not DATE_RE.fullmatch(args.date):
        print(f"ade-release-ready: bad --date {args.date!r} (want YYYY-MM-DD)", file=sys.stderr)
        return EXIT_USAGE

    repo = Path(args.repo)
    if not repo.is_dir():
        print(f"ade-release-ready: --repo {repo} is not a directory", file=sys.stderr)
        return EXIT_USAGE

    # Refuse flags that would imply mutation if a future caller invents them on argv
    # (this tool has none; the comment documents the contract for reviewers).
    assert not hasattr(args, "tag") and not hasattr(args, "push")

    rep = assess(repo.resolve(), args.version, args.date)
    if args.json:
        print(json.dumps(rep, indent=2, sort_keys=True))
    else:
        print(format_text(rep), end="")
    return EXIT_OK if rep["ready"] else EXIT_NOT_READY


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

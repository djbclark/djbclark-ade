#!/usr/bin/env python3
"""Monthly AI re-rank of routing.toml good_at from calibrate suggestions. No model.

    routing-recalibrate [--dry-run]

Runs `route_agent.py calibrate --json --since 30`. With no suggestions, exits 0
after a one-line note. Otherwise writes a brief under
`~/.local/state/bigteam/routing-recalibrate/<date>/`, dispatches it to Claude
Opus high (`acp-dispatch … --kind judgment --detach --no-wait`), and
hermes-pings. `--dry-run` prints the brief and the dispatch command and runs
nothing (no write, no dispatch, no ping).

Operator /steps 1.5, 2026-10-18: AI re-rank, not human. launchd
`com.djbclark.routing-recalibrate` (Day 1 09:00) calls this; the lead loads it.

Env: ROUTING_RECALIBRATE_STATE (brief root), ACP_DISPATCH (binary), ACP_DISPATCH_STATE
(calibrate input, via route_agent), ROUTING_RECALIBRATE_REPO (dispatch -C).
"""
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import time
from pathlib import Path

ADE = Path(__file__).resolve().parent.parent
ROUTE = ADE / "bin" / "route_agent.py"
STATE = Path(os.environ.get(
    "ROUTING_RECALIBRATE_STATE",
    Path.home() / ".local" / "state" / "bigteam" / "routing-recalibrate",
))
REPO = Path(os.environ.get("ROUTING_RECALIBRATE_REPO", ADE))
ACP_DISPATCH = Path(os.environ.get(
    "ACP_DISPATCH",
    ADE / "bin" / "acp-dispatch",
))
HERMES_PING = Path(os.environ.get(
    "ROUTING_RECALIBRATE_PING",
    Path.home() / ".local" / "bin" / "hermes-ping",
))


def stamp_date() -> str:
    return time.strftime("%Y-%m-%d", time.localtime())


def run_calibrate() -> dict:
    env = dict(os.environ)
    proc = subprocess.run(
        [sys.executable, str(ROUTE), "calibrate", "--json", "--since", "30"],
        check=False, capture_output=True, text=True, env=env, timeout=120,
    )
    if proc.returncode != 0:
        sys.stderr.write(proc.stderr or proc.stdout or "calibrate failed\n")
        raise SystemExit(proc.returncode or 1)
    return json.loads(proc.stdout)


def build_brief(report: dict, date: str) -> str:
    suggestions = report.get("suggestions") or []
    lines = [
        f"# Routing recalibrate {date}",
        "",
        "You are re-ranking `good_at` in `config/routing.toml` from the calibrate",
        "report below. Edit **only** the suggested service × kind ranks.",
        "",
        "## Rules",
        "",
        "1. Change `good_at` ranks for the suggested groups only, by the listed delta",
        "   (`+N` means worse / higher number; negative means better / lower number).",
        "2. One commit; message lists each change with its before/after numbers and",
        "   the done_rate vs peer median that justified it.",
        "3. Never change kinds eligibility, gates, reserve floors, frontier rows,",
        "   burn_first flags, pace thresholds, or `[calibrate]` / `[discovery]` /",
        "   `[dispatch]` / `[hermes]`.",
        "4. Never touch any group under the calibrate minimum (`min_n` in the JSON).",
        "5. Run `tests/test_route_agent.py` (and pace/calibrate siblings) via",
        "   `/Users/djbclark/ops/site-private/bin/bg uv run --with pytest python -m pytest -q …`.",
        "6. Push the branch (or master, if that is where you work) when green.",
        "",
        "## Suggestions",
        "",
    ]
    if not suggestions:
        lines.append("(none)")
    else:
        for s in suggestions:
            sign = "+" if s["suggest_rank_delta"] > 0 else ""
            lines.append(
                f"- `{s['service']}` × `{s['kind']}`: rank {sign}{s['suggest_rank_delta']} "
                f"(done {s['done_rate']}% vs peer median {s['peer_median_done_rate']}%, "
                f"n={s['n']}) — {s['reason']}"
            )
    lines += [
        "",
        "## Calibrate JSON",
        "",
        "```json",
        json.dumps(report, indent=2, sort_keys=True),
        "```",
        "",
    ]
    return "\n".join(lines)


def dispatch_cmd(date: str, brief: Path) -> list[str]:
    return [
        str(ACP_DISPATCH), "claude",
        "--model", "opus",
        "--effort", "high",
        "--kind", "judgment",
        "--name", f"recalibrate-{date}",
        "--task", "routing-recalibrate",
        "-C", str(REPO),
        "-f", str(brief),
        "--detach", "--no-wait",
    ]


def _hermes_ping(msg: str) -> None:
    if HERMES_PING.is_file():
        subprocess.run([str(HERMES_PING), msg], check=False)
    else:
        print(msg)


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(description=__doc__.split("\n", 1)[0])
    p.add_argument("--dry-run", action="store_true",
                   help="print brief and dispatch command; change nothing")
    args = p.parse_args(argv)

    # Create the state dir before any write (briefs, calibrate.json, or launchd
    # siblings). launchd still needs the dir present before first load so it
    # can open StandardOutPath/StandardErrorPath.
    STATE.mkdir(parents=True, exist_ok=True)

    report = run_calibrate()
    suggestions = report.get("suggestions") or []
    date = stamp_date()

    if not suggestions:
        print(f"routing-recalibrate: no suggestions (min_n={report.get('min_n')})")
        return 0

    brief_text = build_brief(report, date)
    out_dir = STATE / date
    brief_path = out_dir / "brief.md"
    cmd = dispatch_cmd(date, brief_path)

    if args.dry_run:
        print(brief_text)
        print("# dispatch:", " ".join(cmd))
        return 0

    out_dir.mkdir(parents=True, exist_ok=True)
    brief_path.write_text(brief_text)
    (out_dir / "calibrate.json").write_text(
        json.dumps(report, indent=2, sort_keys=True) + "\n")

    proc = subprocess.run(cmd, check=False)
    if proc.returncode != 0:
        print(f"routing-recalibrate: dispatch exited {proc.returncode}",
              file=sys.stderr)
        _hermes_ping(
            f"djbclark-ade: routing recalibrate dispatch failed "
            f"(rc={proc.returncode})")
        return proc.returncode

    _hermes_ping(
        f"djbclark-ade: routing recalibrate dispatched "
        f"({len(suggestions)} suggestions)")
    print(f"routing-recalibrate: brief {brief_path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

#!/usr/bin/env -S python3 -I
"""gh-pr-checks: thin wrapper around `gh pr checks` that self-registers a deadline for `--watch`.

  gh-pr-checks [--budget DUR] [--no-deadline] [--] [gh pr checks args…]

Forwards every argument to `gh pr checks` (GH_BIN, default `gh`). When `--watch` is present and
DEADLINE_NAME is unset, runs under `deadline run` (name `gh-pr-checks-<pid>`, default budget 20m,
`--on-expire kill`, no heartbeat: gh does not beat). `--no-deadline` opts out; a missing or unusable
deadline tool is one stderr warning and the watch continues unregistered. A non-watch call never
registers. docs/deadline.md Known gaps / Waiters register themselves.
"""
from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
DEFAULT_BUDGET = "20m"


def note(msg: str) -> None:
    print(f"gh-pr-checks: {msg}", file=sys.stderr, flush=True)


def gh_bin() -> str:
    return os.environ.get("GH_BIN") or "gh"


def deadline_tool() -> Path | None:
    tool = Path(os.environ.get("DEADLINE_BIN") or (HERE / "deadline"))
    return tool if tool.is_file() else None


def split_argv(argv: list[str]) -> tuple[str, bool, list[str]]:
    """Pull our flags; the rest is forwarded to `gh pr checks`."""
    budget = os.environ.get("GH_PR_CHECKS_BUDGET") or DEFAULT_BUDGET
    no_deadline = False
    out: list[str] = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--":
            out.extend(argv[i + 1 :])
            break
        if a == "--no-deadline":
            no_deadline = True
        elif a == "--budget":
            i += 1
            if i >= len(argv):
                note("--budget needs a duration (e.g. 20m)")
                raise SystemExit(2)
            budget = argv[i]
        elif a.startswith("--budget="):
            budget = a.split("=", 1)[1]
            if not budget:
                note("--budget needs a duration (e.g. 20m)")
                raise SystemExit(2)
        else:
            out.append(a)
        i += 1
    return budget, no_deadline, out


def wants_watch(gh_argv: list[str]) -> bool:
    return "--watch" in gh_argv


def maybe_supervise_under_deadline(gh_argv: list[str], *, budget: str, no_deadline: bool) -> int | None:
    """Re-run `gh pr checks` under `deadline run` when watching and uncovered. None = call gh here."""
    if no_deadline or not wants_watch(gh_argv) or "DEADLINE_NAME" in os.environ:
        return None
    tool = deadline_tool()
    if tool is None:
        note("no usable deadline tool (bin/deadline or $DEADLINE_BIN): continuing without a registered deadline")
        return None
    name = f"gh-pr-checks-{os.getpid()}"
    cmd = [str(tool), "run"]
    owner = (os.environ.get("PASEO_AGENT_ID") or "").strip()
    if owner:
        cmd += ["--owner", owner]
    # No --heartbeat: gh does not emit deadline beat; budget alone is the outer limit (docs example's 5m
    # heartbeat would kill a healthy watch that never beats).
    cmd += ["--name", name, "--budget", budget, "--on-expire", "kill", "--", gh_bin(), "pr", "checks", *gh_argv]
    note(f"registering deadline {name} budget={budget}")
    try:
        return subprocess.call(cmd)
    except OSError as e:
        note(f"deadline run failed to start ({e}): continuing without a registered deadline")
        return None


def run_gh(gh_argv: list[str]) -> int:
    cmd = [gh_bin(), "pr", "checks", *gh_argv]
    try:
        return subprocess.call(cmd)
    except OSError as e:
        note(f"cannot run {cmd[0]!r} ({e})")
        return 127


def main(argv: list[str] | None = None) -> int:
    try:
        budget, no_deadline, gh_argv = split_argv(list(argv if argv is not None else sys.argv[1:]))
    except SystemExit as e:
        return int(e.code) if isinstance(e.code, int) else 2
    supervised = maybe_supervise_under_deadline(gh_argv, budget=budget, no_deadline=no_deadline)
    if supervised is not None:
        return supervised
    return run_gh(gh_argv)


if __name__ == "__main__":
    raise SystemExit(main())

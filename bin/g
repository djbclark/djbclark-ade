#!/bin/sh
# Plain-English BarnOwl.  `g list my subs` runs one Grok turn on the barnowl skill.
set -eu
if [ "$#" -eq 0 ]; then
  echo "usage: g <plain English BarnOwl request>" >&2
  echo "example: g list my subs" >&2
  exit 2
fi
# --single must take the prompt itself. A later flag is not a value.
# grok-4.5 at low effort is the weakest model this account lists.
exec grok --model grok-4.5 --reasoning-effort low \
  --single "/barnowl $*" --no-plan --permission-mode bypassPermissions \
  --no-subagents --max-turns 12 --cwd "$HOME"

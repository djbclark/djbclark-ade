#!/usr/bin/env -S python3 -I
"""Mechanically classify CI waivers using trusted master's policy; see docs/ci-waiver.md.

ci-waiver classify --repo-dir DIR --pr N [--repo OWNER/NAME] [--json]
ci-waiver classify --repo-dir DIR --base REF --head REF [--repo OWNER/NAME] [--json]

PR mode fetches all evidence into a fresh private GitHub object store; repo-dir
is used only by offline base/head mode. Only the docs-only class exists: a merge of
master is never waived (docs/ci-waiver.md, "Why not master-merge").
Exit 0: classification printed (including fail-closed none); 2: bad usage.
This file deliberately imports no repository Python code.
"""
from __future__ import annotations
import argparse
import contextlib
import fnmatch
import json
import os
import posixpath
import re
import subprocess
import sys
import tempfile
import unicodedata
from pathlib import Path

WAIVABLE_PATHS = ("CHANGELOG.md", "docs/handoffs/**")
DEFAULT_REPO = "djbclark/djbclark-ade"
WORKFLOW_PATHS = ("tests", "claude/hooks/handoff-tools/tests")
# GitHub records a PR retarget as any of these (automatic retarget of a stacked PR after
# its base branch is deleted is base_ref_deleted + automatic_base_change_succeeded).
RETARGET_EVENTS = ("base_ref_changed", "base_ref_deleted", "automatic_base_change_succeeded")


def normalized(path):
    path = unicodedata.normalize("NFC", path.replace("\\", "/")).casefold()
    if path.startswith("/") or ".." in path.split("/") or re.match(r"^[a-z]:", path):
        raise ValueError("unsafe-path:" + path)
    return posixpath.normpath(path)


def waivable(path):
    return any(fnmatch.fnmatchcase(path, p) for p in WAIVABLE_PATHS)


def excluded(path):
    p = normalized(path)
    parts = p.split("/")
    return (any(part.startswith(".git") for part in parts) or "tests" in parts
            or parts[-1] in ("conftest.py", "pyproject.toml", "pytest.ini", ".pytest.ini",
                             "pytest.toml", ".pytest.toml", "setup.cfg", "tox.ini", "uv.lock", "uv.toml")
            or parts[0] in ("pytest.py", "pytest", "_pytest")
            or fnmatch.fnmatchcase(parts[-1], "requirements*.txt")
            or fnmatch.fnmatchcase(parts[-1], "test_*.py")
            or p.startswith("config/") or p in ("config", "bin/pr-wait", "bin/ci-waiver")
            or any(p == q or p.startswith(q + "/") for q in WORKFLOW_PATHS))


class Repository:
    def __init__(self, directory):
        self.directory = Path(directory).resolve(strict=True)
        common = self.git("rev-parse", "--git-common-dir").stdout.decode().strip()
        if (self.directory / common / "info/grafts").exists():
            raise ValueError("git-grafts-present")

    def git(self, *args, allowed=(0,), env=None):
        if env is None:
            env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
        else:
            env = dict(env)
        env.pop("GIT_REPLACE_REF_BASE", None)
        env.update(GIT_NO_REPLACE_OBJECTS="1", GIT_GRAFT_FILE=os.devnull)
        r = subprocess.run(["git", "-c", "core.commitGraph=false", "-c", "gc.writeCommitGraph=false",
                            "-c", "fetch.writeCommitGraph=false", *args], cwd=self.directory, env=env,
                           capture_output=True, timeout=60)
        if r.returncode not in allowed:
            operation = list(args)
            while operation[:1] == ["-c"]:
                del operation[:2]
            raise ValueError("git-error:" + operation[0])
        return r

    def sha(self, ref):
        value = self.git("rev-parse", "--verify", "--end-of-options", ref + "^{commit}").stdout.decode().strip()
        if not re.fullmatch(r"[0-9a-f]{40}", value):
            raise ValueError("unreadable-commit")
        return value

    def paths(self, a, b):
        return [p.decode("utf-8", "surrogateescape") for p in
                self.git("diff", "--no-renames", "--name-only", "-z", a, b, "--").stdout.split(b"\0") if p]

    def safe_doc_modes(self, a, b):
        fields = self.git("diff", "--raw", "--no-abbrev", "--no-renames", "-z", a, b, "--").stdout.split(b"\0")
        for i in range(0, len(fields) - 1, 2):
            path = fields[i + 1].decode("utf-8", "surrogateescape")
            if waivable(path):
                old, new = fields[i].split()[:2]
                if old not in (b":000000", b":100644") or new not in (b"000000", b"100644"):
                    raise ValueError("unsafe-doc-mode:" + path)


class GitHubRepository(Repository):
    """Only objects fetched by this invocation; never opens the checkout's gitdir."""

    def __init__(self, directory, repo):
        if not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", repo):
            raise ValueError("invalid-github-repository")
        self.directory = Path(directory)
        self.url = f"https://github.com/{repo}.git"
        self.fetched = set()
        self.git("-c", "init.templateDir=", "init", "--bare", ".")

    def git(self, *args, **kwargs):
        env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
        env.update(GIT_CONFIG_NOSYSTEM="1", GIT_CONFIG_GLOBAL=os.devnull, GIT_ATTR_NOSYSTEM="1")
        # No inherited GIT_DIR, object directories, alternates, templates or config.
        kwargs["env"] = env
        return super().git("-c", "protocol.allow=never", "-c", "protocol.https.allow=always",
                           "-c", "core.hooksPath=" + os.devnull, *args, **kwargs)

    def sha(self, ref):
        if not isinstance(ref, str) or not re.fullmatch(r"[0-9a-f]{40}", ref):
            raise ValueError("unreadable-github-commit")
        if ref not in self.fetched:
            self.git("fetch", "--no-tags", "--no-write-fetch-head", "--no-recurse-submodules", self.url, ref)
            if super().sha(ref) != ref:
                raise ValueError("fetched-commit-mismatch")
            self.fetched.add(ref)
        return ref


def gh(endpoint):
    r = subprocess.run(["gh", "api", "--hostname", "github.com", "--paginate", endpoint], capture_output=True, text=True, timeout=120)
    if r.returncode:
        raise ValueError("gh-error:" + endpoint.split("?")[0])
    decoder, docs, i = json.JSONDecoder(), [], 0
    while i < len(r.stdout):
        if r.stdout[i].isspace():
            i += 1
            continue
        doc, i = decoder.raw_decode(r.stdout, i)
        docs.append(doc)
    if not docs:
        raise ValueError("empty-gh-response")
    return docs


def items(endpoint, key=None):
    out = []
    for doc in gh(endpoint):
        part = doc[key] if key else doc
        if not isinstance(part, list) or any(not isinstance(x, dict) for x in part):
            raise ValueError("unreadable-list")
        out.extend(part)
    return out


def classify(base, head, repo, pr, repo_dir):
    result = {"class": "none", "reasons": [], "head": None}
    try:
        with contextlib.ExitStack() as stack:
            if pr is not None:
                doc = gh(f"repos/{repo}/pulls/{pr}")[0]
                if doc["base"]["ref"] != "master":
                    raise ValueError("base-not-master")
                base, head = doc["base"]["sha"], doc["head"]["sha"]
                r = GitHubRepository(stack.enter_context(tempfile.TemporaryDirectory(prefix="ci-waiver-objects-")), repo)
                master = r.sha(gh(f"repos/{repo}/branches/master")[0]["commit"]["sha"])
            else:
                r = Repository(repo_dir)
            if r.git("rev-parse", "--is-shallow-repository").stdout.strip() != b"false":
                raise ValueError("shallow-history")
            base, head = r.sha(base), r.sha(head)
            result["head"] = head
            if pr is not None:
                if r.git("merge-base", "--is-ancestor", base, master, allowed=(0, 1)).returncode:
                    raise ValueError("base-not-on-master")
                timeline = items(f"repos/{repo}/issues/{pr}/timeline?per_page=100")
                if any(e.get("event") in RETARGET_EVENTS for e in timeline):
                    raise ValueError("pr-base-retargeted")
            ancestor = r.sha(r.git("merge-base", base, head).stdout.decode().strip())
            changed = r.paths(ancestor, head)
            hard = ["hard-exclusion:" + p for p in changed if excluded(p)]
            if hard:
                return {**result, "reasons": hard}
            r.safe_doc_modes(ancestor, head)
            if changed and all(waivable(p) for p in changed):
                return {**result, "class": "docs-only", "reasons": ["only-waivable-paths"]}
            reasons = ["touches-nonwaivable:" + p for p in changed if not waivable(p)] or ["no-changes"]
            parents = r.git("rev-list", "--parents", "-n", "1", head).stdout.decode().split()[1:]
            if len(parents) > 1:
                # Five adversary rounds found a new hole every time in proving an earlier
                # green run for a merge of master; a merge is judged by ordinary CI only.
                reasons.insert(0, "master-merge-not-waivable")
            return {**result, "reasons": reasons}
    except Exception as e:
        return {**result, "reasons": [str(e)[:240] or type(e).__name__]}


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    c = p.add_subparsers(dest="command", required=True).add_parser("classify")
    c.add_argument("--repo-dir", required=True)
    c.add_argument("--pr", type=int)
    c.add_argument("--repo", default=DEFAULT_REPO)
    c.add_argument("--base")
    c.add_argument("--head")
    c.add_argument("--json", action="store_true")
    a = p.parse_args()
    if (a.pr is None and not (a.base and a.head)) or (a.pr is not None and (a.base or a.head)):
        p.error("use --pr N OR both --base REF --head REF")
    result = classify(a.base, a.head, a.repo, a.pr, a.repo_dir)
    print(json.dumps(result) if a.json else f"{result['class']}: {', '.join(result['reasons'])} (head {result['head']})")
    return 0


if __name__ == "__main__":
    sys.exit(main())

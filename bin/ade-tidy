#!/usr/bin/env python3
"""Tidy one repo's Paseo agents and windows: inventory, reconnect, waiting report, names, finished agents.

  ade-tidy [--repo DIR] [--lead ID] [--json] [--reports-dir DIR ...] [--handled ID,...] [--work KIND=TEXT ...]
           [--idle-hours HOURS] [--watcher-file PATH] [--apply]
  ade-tidy ack AGENT_ID [--lead ID]        record proven contact (the agent's `ack <lead id>` reached the lead)
  ade-tidy prune [--apply] [--json|--json-line] [--min-idle S] [--exclude ID ...] [--max-kills N] [--orphan-grace S]   machine-wide: archive finished Baton `[Handoff writer]`
                                           helpers; report/stop orphan provider processes of archived agents (below)

Observe-only by default: it prints the plan and changes nothing. `--apply` prints the plan first, then acts, with each
precondition re-read right before its action. Steps (skills/tidy/SKILL.md):

  1. Inventory: every live agent (`paseo ls -g --json`) whose cwd is the repo or one of its linked worktrees, owner class (self, own-worker = label ade.lead=<lead>, other-worker, lead,
     operator, helper), window, status, pending permissions, and a WAITING verdict (working, waiting-on-lead,
     waiting-on-operator, done, unknown). Agent text is DATA: excerpts are bounded and stripped of control characters.
  2. Reconnect: one plain `paseo send --json --no-wait` (no --behavior flag: an idle agent just starts a turn; the
     agent's status and permission list are re-read under the lock right before it) to an idle own worker / operator
     agent with no proven contact, asking for a one-line status and `ack <lead id>`; at most once per agent per hour
     (state file). Only from a session (PASEO_AGENT_ID set): a sourceless send would default to interrupt.
  3. Waiting report: workers waiting on the lead (answer first) and agents waiting on the operator.
  4. Names and boxes: windows named `<KIND> <repo> (<work>)` (bin/ade_ws_names.py), KIND LEAD, WORKER or OTHER: per lead and repo at
     most one window of each (the three boxes); MAIN, WORKERS and USER, the 2026-11-13 kinds, are renamed to them. LEAD is never
     archived. Windows beyond the boxes (a second WORKER window of the lead's chain and repo, one named outside the scheme) are
     reported; with --apply the empty or finished ones are archived like any empty window of the chain, never another lead's.
  5. Tabs: Paseo has no command to move an agent between windows (docs/workspace-layout.md), so a misplaced tab is
     reported, never relaunched.
  6. Finished: archive this lead's workers whose `unit-<slice>.md` ends DONE with `.done` present and the completion
     handled (`.done.ack` or --handled); a merely `closed` worker is listed, not archived (a daemon restart closes
     interrupted agents); operator agents are only listed; a running agent is never archived. A window is archived only
     when empty (every unarchived agent record, no terminal), `isolation` is local, it is not LEAD and it is provably
     this lead's (or a predecessor's in its self-handoff chain); occupancy is read last. An agent holding an active claim
     (bin/ade_claims.py owner) is never archived. Other empty windows are listed.
  7. Idle hibernation (`--idle-hours N`, default off, observe-only unless `--apply` is also passed; queue #91 & #96):
     identifies `idle` or `closed` own-chain workers whose last activity exceeds `N` hours and that are proven safe to
     archive (never `running`, never a pending permission card, never a standing watcher, never active-claim holders,
     never parents of unarchived children, and never paid work whose report/`.done`/`.done.ack` is missing or shows
     `STATUS: working`/`BLOCKED:`/`NO-REPORT:`). Operator-owned sessions and other leads' workers are listed only as
     operator-call candidates and never archived by `--apply`. Lists idle age, process RSS (if available), and the
     reversibility note `bin/ade-revive <id>`.

`prune` (2026-11-14) is a separate, machine-wide mode (no repo, no lead): it archives only Baton helpers (title `[Handoff writer]` AND
label `baton-writer=1`; parent in label `paseo.parent-agent-id`) that are idle for --min-idle seconds (default 300), have no pending
permission, are not a lead/MAIN agent or the caller, and whose work is done: the parent is archived, closed or gone, or Baton's
state (`plugin-data/baton/baton-state.json`) records the parent's handoff as done in a non-empty file written after the helper was
created. Everything else is skipped with a reason code. Observe-only by default; `--apply` re-reads the machine, archives with
`paseo agent archive ID` and appends one JSON line per attempt to ~/.local/state/ade/helper-prune.log (ADE_HELPER_PRUNE_LOG).
Scheduled every 30 minutes by config/launchd/com.djbclark.ade-helper-prune.plist (docs/scheduling.md).

Exit 0: ok (also when nothing to do); 1: refused or a paseo call failed; 2: usage.
"""
from __future__ import annotations

import argparse
import fcntl
import json
import math
import os
from pathlib import Path
import re
import signal
import subprocess
import sys
import tempfile
import stat
import time
import unicodedata
from datetime import datetime, timezone

UUID_RE = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")
WKS_RE = re.compile(r"wks_[A-Za-z0-9]+")
CLI_TIMEOUT = 60
NAME_LIMIT = 100
RESEND_SECONDS = 3600  # at most one send per agent per hour
CONTACT_FRESH_SECONDS = 6 * 3600  # an ack older than this no longer proves the link (memory: overdue acks re-route after 6h)
EXCERPT = 300
TAG_RE = re.compile(r"^\[[A-Za-z][A-Za-z ]*\]")
# `paseo logs` labels (packages/protocol paseo-tool-presentation/agent-message.ts, activity-curator.ts): another party's words
INBOUND_TAGS = ("[User]", "[Message received]", "[Agent finished]", "[Agent errored]", "[Agent closed]", "[Agent needs permission]")
ACK_BODY_RE = re.compile(r"\s*ack\s+\S+(\s+\S+)?\s*", re.I)  # a bare `ack <id> [<msg-id>]` body: the lead's receipt, not a re-task
CTRL_RE = re.compile(r"[\x00-\x08\x0b-\x1f\x7f-\x9f]")
KINDS = ("LEAD", "WORKER", "OTHER")  # the three boxes (operator ruling 2026-11-14); MAIN, WORKERS and USER are their 2026-11-13 names
KIND_FOR_CLASS = {"self": "LEAD", "lead": "LEAD", "own-worker": "WORKER", "operator": "OTHER"}
LEAD_NAME_RE = re.compile(r"(?:LEAD|MAIN)\b")
SKIP_CLASSES = ("helper",)
MAX_WATCHER_BYTES = 65536
WATCHER_TITLE_RE = re.compile(r"\b(load[- ]?watch(?:er)?|watcher|watch[- ]?load)\b", re.I)
WATCHER_ROLE_RE = re.compile(r"watch", re.I)


class Refused(Exception):
    pass


class ExcludeRefused(Refused):
    """The exclude list could not be read or parsed: a prune run that cannot tell what is protected does nothing more."""


# ----------------------------------------------------------------------------------------------- paseo plumbing

def paseo_bin() -> str:
    """Explicit test-fake path (`ADE_TIDY_PASEO`) or `paseo` on PATH (Rule 2: no PATH replacement in new tests)."""
    return os.environ.get("ADE_TIDY_PASEO") or "paseo"


def paseo(args: list[str], timeout: int | None = CLI_TIMEOUT) -> tuple[int, str, str]:
    """One paseo call, argv list, stdout and stderr read back from files (never a pipe)."""
    with tempfile.TemporaryFile("w+") as out, tempfile.TemporaryFile("w+") as err:
        try:
            rc = subprocess.run([paseo_bin(), *args], stdin=subprocess.DEVNULL, stdout=out, stderr=err,
                                timeout=timeout).returncode
        except FileNotFoundError:
            raise Refused("paseo is not on PATH")
        except subprocess.TimeoutExpired:
            raise Refused(f"paseo {' '.join(args[:2])} timed out after {timeout}s")
        out.seek(0)
        err.seek(0)
        return rc, out.read(), err.read()


def paseo_json(args: list[str]):
    rc, out, err = paseo(args)
    if rc != 0:
        raise Refused(f"paseo {' '.join(args[:2])} failed (rc {rc}): {clean(err.strip() or out.strip())[:200]}")
    try:
        return json.loads(out)
    except ValueError:
        raise Refused(f"paseo {' '.join(args[:2])} did not print JSON")


def clean(text: str, limit: int = EXCERPT) -> str:
    """Agent-written text is data: control characters out, one line, bounded."""
    text = "".join(" " if unicodedata.category(c) in ("Cf", "Cc", "Cs", "Co") else c for c in str(text))
    text = CTRL_RE.sub(" ", text)
    text = " ".join(text.split())
    return text if len(text) <= limit else text[: limit - 1] + "…"


def paseo_home() -> Path:
    return Path(os.environ.get("PASEO_HOME") or Path.home() / ".paseo")


def state_file(agent_id: str) -> dict | None:
    for p in sorted((paseo_home() / "agents").glob(f"*/{agent_id}.json")):
        try:
            data = json.loads(p.read_text())
        except (OSError, ValueError):
            return None
        return data if isinstance(data, dict) else None
    return None


def live_agents() -> list[dict]:
    rows = paseo_json(["ls", "-g", "--json"])  # no -a: archived agents are not listed
    if not isinstance(rows, list):
        raise Refused("paseo ls -g --json did not return a list")
    return [r for r in rows if isinstance(r, dict) and isinstance(r.get("id"), str) and UUID_RE.fullmatch(r["id"])]


def workspaces() -> list[dict]:
    rows = paseo_json(["workspace", "ls", "--json"])
    if not isinstance(rows, list):
        raise Refused("paseo workspace ls --json did not return a list")
    return [r for r in rows if isinstance(r, dict) and WKS_RE.fullmatch(str(r.get("workspaceId", "")))]


def terminals_in(wks: str) -> int:
    rows = paseo_json(["terminal", "ls", "--workspace", wks, "--json"])
    if not isinstance(rows, list):
        raise Refused(f"paseo terminal ls for {wks} did not return a list")
    return len(rows)


def terminals_in_safe(wks: str) -> int:
    """Terminal count, or 1 (treated as occupied) when the list cannot be read: never archive on a failed read."""
    try:
        return terminals_in(wks)
    except Refused:
        return 1


def pending_permissions() -> dict[str, str] | None:
    """agent id -> the pending request's tool name (`paseo permit ls --json`, keyed by the row's agentId, never its own
    request id); None when the list cannot be read, so apply can refuse to act on a blind view."""
    try:
        rows = paseo_json(["permit", "ls", "--json"])
    except Refused:
        return None
    found: dict[str, str] = {}
    for row in rows if isinstance(rows, list) else []:
        if not isinstance(row, dict):
            continue
        agent = row.get("agentId") or row.get("agent_id")
        if isinstance(agent, str) and UUID_RE.fullmatch(agent):
            found[agent] = clean(str(row.get("name") or row.get("tool") or "request"), 40)
    return found


def log_tail(agent_id: str) -> str | None:
    """`paseo logs --tail 40`, or None when it cannot be read (fail closed: no text means no veto)."""
    try:
        rc, out, _ = paseo(["logs", agent_id, "--tail", "40"], timeout=30)
    except Refused:
        return None
    return out if rc == 0 else None


def last_text(log: str | None) -> tuple[str, bool, str]:
    """(trailing untagged text, a question-card/permission event in the last 5 tagged lines, state) where state is
    "ok", "unreadable" (no log, an empty one, `No activity to display.`, or one with no tagged line at all) or "inbound"
    (the untagged tail follows a `[User]` / `[Message received]` / `[Agent finished|errored|closed]` header: it is another
    party's message, or the agent's plain-text reply to it, which the log does not tell apart; the text is still
    returned so a BLOCKED line or a question in it is shown, never archived over)."""
    if log is None or not log.strip() or log.strip() == "No activity to display." \
            or not any(TAG_RE.match(ln) for ln in log.splitlines()):
        return "", False, "unreadable"
    lines = log.splitlines()
    tail: list[str] = []
    head = ""
    for line in reversed(lines):
        if TAG_RE.match(line):
            head = line
            break
        tail.append(line)
    tail.reverse()
    tagged = [ln for ln in lines if TAG_RE.match(ln)][-5:]
    card = any(re.search(r"AskUserQuestion|\[Question\]|\[Permission\]", ln) for ln in tagged)
    if head.startswith(INBOUND_TAGS):
        body = [ln for ln in tail if ln.strip()]
        if head.startswith("[Message received]") and body and ACK_BODY_RE.fullmatch(body[0]):
            return "\n".join(body[1:]).strip(), card, "ok"  # the lead's receipt `ack <id> <msg-id>` + the worker's own reply (the log does not tell them apart)
        return "\n".join(tail).strip(), card, "inbound"
    return "\n".join(tail).strip(), card, "ok"


# The worker's own completion notice (footer rule 22: `completion-notice --send`, a plain `paseo send ... done:`, the relay shim,
# or the send tool) and its ordinary replies to an ack. Matched on the command itself (first word, optional path), never a mention.
_CMD = r"^\[(?:Shell|Bash)\]\s+(?:[A-Za-z_]+=\S+\s+)*(?:python3\s+)?(?:\S*/)?"
NOTICE_RE = re.compile(_CMD + r"(?:completion-notice\s+--send\b|(?:paseo\s+send|relay\.py)\b.*\bdone:)|^\[Send message\].*\bdone:")
REPLY_TOOL_RE = re.compile(_CMD + r"(?:completion-notice\s+--(?:send|check-ack|print)\b|paseo\s+send\b)|^\[Send message\]")
RECEIPT_RE = re.compile(r"\s*ack\s+\S+\s+\S+\s*", re.I)  # the lead's completion ack: `ack <worker id> <msg-id>` (rule 22)


def scan_log(log: str | None) -> tuple[bool, bool]:
    """(retask, receipt) read from the log tail. retask: a `[Message received]` entry whose first body line is not a bare
    `ack <id> [<msg-id>]` (the lead's `paseo send` re-task does not move the state record's lastUserMessageAt: an
    agent-sourced message is projected as a tool call, not a user message), or, after the LAST ack, a tool call other than
    the worker's ordinary reply (REPLY_TOOL_RE); `[Thought]` entries and any amount of plain text are the worker's reply.
    receipt: the lead's `ack <id> <msg-id>` is in the tail and the worker's own completion notice (NOTICE_RE) was its last
    tool call before it (replies in between allowed), so the ack belongs to this round. The initial brief is a `[User]`
    entry and is not counted (a human prompt moves lastUserMessageAt). The tail is only 40 items: `verdict` bounds
    `lastActivityAt` too."""
    if not log:
        return False, False
    body: list[str] = []
    inbound = acked = receipt_ok = tool_after = notice_pending = False
    for line in log.splitlines() + ["[end]"]:
        if not TAG_RE.match(line):
            body.append(line)
            continue
        lines = [b for b in body if b.strip()]
        if inbound:
            if not lines or not ACK_BODY_RE.fullmatch(lines[0]):
                return True, False
            acked, receipt_ok, tool_after = True, notice_pending and bool(RECEIPT_RE.fullmatch(lines[0])), False
        if line != "[end]" and not line.startswith(INBOUND_TAGS) and not line.startswith("[Thought]"):
            if NOTICE_RE.match(line):
                notice_pending = True  # a completion notice (after a receipt it is also an ordinary reply, not work)
            elif REPLY_TOOL_RE.match(line) and acked:
                pass  # the worker's reply to the ack: keeps the pending notice, is not work
            else:
                notice_pending = False  # any other tool call: the notice is no longer the last thing the worker did
                if acked:
                    tool_after = True
        inbound = line.startswith("[Message received]")
        body = []
    return tool_after, acked and receipt_ok and not tool_after


# ----------------------------------------------------------------------------------------------- repo + agents

def repo_info(repo_arg: str | None) -> tuple[str, list[str]]:
    """(repo name, realpaths of the main checkout and every linked worktree). The name is the main checkout's."""
    start = os.path.realpath(repo_arg or os.getcwd())
    r = subprocess.run(["git", "-C", start, "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    if r.returncode != 0:
        raise Refused(f"{start} is not inside a git repository")
    top = os.path.realpath(r.stdout.strip())
    w = subprocess.run(["git", "-C", top, "worktree", "list", "--porcelain"], capture_output=True, text=True)
    paths = [os.path.realpath(ln[len("worktree "):]) for ln in w.stdout.splitlines() if ln.startswith("worktree ")]
    if w.returncode != 0 or not paths:
        raise Refused(f"git worktree list failed in {top}")
    return os.path.basename(paths[0]), sorted({*paths, top})


def real(path: str) -> str:
    return os.path.realpath(os.path.expanduser(path))


def in_roots(cwd: str, roots: list[str]) -> bool:
    c = real(cwd) if cwd else ""
    return any(c == r or c.startswith(r + os.sep) for r in roots)


def _is_truthy_label(val) -> bool:
    return str(val or "").strip().lower() in ("1", "true", "yes")


def _box_from_labels(labels: dict | None) -> str | None:
    if not isinstance(labels, dict):
        return None
    raw_box = str(labels.get("ade.box") or "").strip().upper()
    if raw_box in ("LEAD", "WORKER", "OTHER"):
        return raw_box
    if raw_box in ("MAIN", "WORKERS", "USER"):
        return {"MAIN": "LEAD", "WORKERS": "WORKER", "USER": "OTHER"}[raw_box]
    raw_place = str(labels.get("ade.placement") or "").strip().lower()
    return {"lead": "LEAD", "main": "LEAD", "worker": "WORKER", "workers": "WORKER", "other": "OTHER", "user": "OTHER"}.get(raw_place)


def classify(agent: dict, st: dict | None, lead: str, lead_ids: set[str], foreign_main: bool = False,
             chain: set[str] | None = None) -> str:
    """Classify an agent strictly from structured metadata first (2026-11-25 ruling).

    Display names (`[Handoff writer]`, `LEAD`/`MAIN`) are consulted only as a legacy fallback when
    no structured label/state record classifies the agent, never overriding structured labels.
    """
    aid, name = agent["id"], str(agent.get("name") or "")
    labels = (st or {}).get("labels") if isinstance((st or {}).get("labels"), dict) else (agent.get("labels") if isinstance(agent.get("labels"), dict) else {})
    owner = labels.get("ade.lead") if isinstance(labels, dict) else None
    if aid == lead:
        return "self"
    if ((st or {}).get("internal") is True
            or _is_truthy_label(labels.get("ade.internal"))
            or str(labels.get("baton-writer") or "") == "1"
            or name.startswith("[Handoff writer]")):  # legacy fallback for unlabelled pre-existing Baton helpers
        return "helper"
    if owner == lead or (owner and chain and owner in chain):  # a predecessor's worker in the same self-handoff chain is ours
        return "own-worker"
    if owner:
        return "other-worker"
    structured_box = _box_from_labels(labels)
    if (aid in lead_ids
            or foreign_main
            or bool(labels.get("ade.role"))
            or bool(labels.get("ade.chain"))
            or structured_box == "LEAD"):
        return "lead"
    if structured_box in ("WORKER", "OTHER"):
        return "operator"
    if re.match(r"(?i)(lead|main)\b", name):  # legacy fallback when no structured labels exist
        return "lead"
    return "operator"


def report_for(slice_name: str | None, reports_dirs: list[str]) -> Path | None:
    """The worker's own report: `unit-<slice>.md` in a --reports-dir (a regular file, resolved inside that folder).
    A path an agent writes in its text is never used: it could name another worker's report."""
    if not slice_name or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", slice_name):
        return None
    for d in reports_dirs:
        root = os.path.realpath(os.path.expanduser(d))
        raw = os.path.join(root, f"unit-{slice_name}.md")
        rp = os.path.realpath(raw)
        try:
            ok = rp == raw and rp.startswith(root + os.sep) and stat.S_ISREG(os.lstat(raw).st_mode)  # never through a symlink
        except OSError:
            continue
        if ok:
            return Path(rp)
    return None


def reports_for_slice(slice_name: str | None, reports_dirs: list[str]) -> list[Path]:
    """All regular report files for `slice_name` inside `reports_dirs` (`unit-<slice>.md`, `<slice>-report.md`,
    `<slice>-N-report.md`), never following symlinks."""
    if not slice_name or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", slice_name):
        return []
    suffixed = re.compile(re.escape(slice_name) + r"-\d+-report\.md")
    found: list[Path] = []
    seen: set[str] = set()
    for d in reports_dirs:
        root = os.path.realpath(os.path.expanduser(d))
        if not os.path.isdir(root):
            continue
        candidates = [f"unit-{slice_name}.md", f"{slice_name}-report.md"]
        try:
            for entry in sorted(os.listdir(root)):
                if suffixed.fullmatch(entry) and entry not in candidates:
                    candidates.append(entry)
        except OSError:
            continue
        for name in candidates:
            raw = os.path.join(root, name)
            rp = os.path.realpath(raw)
            try:
                ok = rp == raw and rp.startswith(root + os.sep) and stat.S_ISREG(os.lstat(raw).st_mode)
            except OSError:
                continue
            if ok and rp not in seen:
                seen.add(rp)
                found.append(Path(rp))
    return found


def default_watcher_file() -> Path:
    lw = Path(os.environ.get("LW_STATE_DIR") or Path.home() / ".local/state/load-watch")
    return lw / "watcher.json"


def load_load_watch_watcher(path: Path | None = None) -> tuple[str | None, str | None]:
    """Read load-watch `watcher.json` fail-closed (same contract as bin/ade-archive-retired).

    Returns `(watcher_agent_id_lower, error_reason)`:
    - Missing file or `channel == "relay"` -> `(None, None)`.
    - Valid `channel == "paseo"` matching active `PASEO_HOME` -> `(target_uuid_lower, None)`.
    - Anything unreadable, symlinked, non-regular, oversized, corrupt, or mismatched -> `(None, reason)`.
    """
    p = path or default_watcher_file()
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0) | getattr(os, "O_CLOEXEC", 0)
    try:
        fd = os.open(p, flags)
    except FileNotFoundError:
        return None, None
    except OSError as exc:
        return None, f"watcher unreadable ({p}): {clean(str(exc), 120)}"
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            return None, f"watcher is not a regular file ({p})"
        raw = os.read(fd, MAX_WATCHER_BYTES + 1)
    except OSError as exc:
        return None, f"watcher read failed ({p}): {clean(str(exc), 120)}"
    finally:
        os.close(fd)
    if len(raw) > MAX_WATCHER_BYTES:
        return None, f"watcher file exceeds {MAX_WATCHER_BYTES} bytes ({p})"
    try:
        data = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, ValueError) as exc:
        return None, f"watcher corrupt JSON ({p}): {clean(str(exc), 120)}"
    if not isinstance(data, dict):
        return None, f"watcher JSON is not an object ({p})"
    channel = data.get("channel")
    if not isinstance(channel, str) or channel not in ("paseo", "relay"):
        return None, f"watcher has invalid channel ({p})"
    if channel == "relay":
        return None, None
    target = data.get("target")
    if not isinstance(target, str):
        return None, f"watcher paseo channel missing valid target ({p})"
    norm_target = target.strip().lower()
    if not UUID_RE.fullmatch(norm_target):
        return None, f"watcher paseo target is not a full UUID ({p})"
    raw_home = data.get("paseo_home")
    if raw_home is None:
        watcher_home_path = Path.home() / ".paseo"
    elif isinstance(raw_home, str) and raw_home and os.path.isabs(raw_home):
        watcher_home_path = Path(raw_home)
    else:
        return None, f"watcher paseo_home is invalid ({p})"
    try:
        watcher_home = watcher_home_path.resolve()
        expected_home = paseo_home().resolve()
    except (OSError, RuntimeError, ValueError) as exc:
        return None, f"watcher paseo_home unresolvable ({p}): {clean(str(exc), 120)}"
    if watcher_home != expected_home:
        return None, f"watcher paseo_home mismatch ({p})"
    return norm_target, None


def standing_watcher_reason(row: dict, st: dict | None, watcher_id: str | None) -> str | None:
    """Non-empty reason if this agent is a standing watcher (never archived/hibernated)."""
    if watcher_id and row["id"].lower() == watcher_id:
        return "registered load-watch watcher"
    labels = (st or {}).get("labels") if isinstance((st or {}).get("labels"), dict) else (row.get("labels") or {})
    if isinstance(labels, dict):
        for k in ("ade.role", "ade.kind"):
            val = labels.get(k)
            if isinstance(val, str) and WATCHER_ROLE_RE.search(val):
                return f"label {k}={clean(val, 40)}"
        if str(labels.get("ade.watcher") or "").strip().lower() in ("1", "true", "yes"):
            return "label ade.watcher"
    name = str(row.get("name") or "")
    if WATCHER_TITLE_RE.search(name):
        return f"title matches watcher ({clean(name, 50)})"
    return None


def idle_paid_work_check(
    row: dict,
    st: dict | None,
    reports_dirs: list[str],
    handled: set[str],
    log: str | None,
    logstate: str,
    retask_log: bool,
    receipt: bool = False,
) -> tuple[bool, str, str]:
    """Verify an own-chain idle/closed worker has no unreported or unacked paid work (~/CLAUDE.md item 9).

    Returns `(safe, code, detail)`. Fails closed on unreadable logs, unanswered inbound messages, pending cards,
    `STATUS: working` / `BLOCKED:` / `NO-REPORT:` / `Please reply: ack` in the log tail, missing/unverified slice
    reports, missing `.done`, missing `.done.ack` (unless `--handled`), re-tasks or post-completion activity past
    `ACTIVITY_MARGIN`, and `closed` ad-hoc workers (unless `--handled`).
    """
    if logstate == "inbound":
        return False, "unanswered-inbound", "last log entry is an inbound message not yet answered"
    if logstate == "unreadable":
        return False, "log-unreadable", "log is unreadable (fail closed)"
    text, card, _ = last_text(log)
    if card:
        return False, "waiting-on-operator", "question or permission card in log tail"
    if re.search(r"(^|\n)\s*BLOCKED:", text):
        return False, "waiting-on-lead", "BLOCKED line in log tail"
    if re.search(r"(^|\n)\s*NO-REPORT:", text):
        return False, "unreported-work", "NO-REPORT line in log tail"
    if re.search(r"(^|\n)\s*STATUS:\s*working\b", text):
        return False, "unreported-work", "log tail shows STATUS: working"
    if re.search(r"Please reply:\s*ack", text):
        return False, "waiting-on-lead", "asks for ack in log tail"
    labels = (st or {}).get("labels") if isinstance((st or {}).get("labels"), dict) else (row.get("labels") or {})
    if isinstance(labels, dict) and labels.get("ade.placement") == "main" and row["id"] not in handled:
        return False, "main-placement", "main-placed worker (pass --handled to include)"
    slice_name = row.get("slice") or (labels.get("slice") if isinstance(labels, dict) else None)
    if slice_name:
        reps = reports_for_slice(slice_name, reports_dirs)
        if not reps:
            return False, "missing-report", f"slice {clean(slice_name, 40)} has no verifiable report in --reports-dir"
        for rep in reps:
            blocked, _ = report_scan(rep)
            if blocked:
                return False, "unreported-work", f"report {rep.name} contains STATUS: working / BLOCKED / NO-REPORT"
        rep = max(reps, key=lambda p: mtime(p) or 0.0)
        ok, acked = report_done(rep)
        if not ok:
            if row["id"] in handled and report_handled_ok(rep):
                ok, acked = True, True
            else:
                return False, "missing-done-marker", f"report {rep.name} is not DONE with a current .done marker"
        if not acked and row["id"] not in handled:
            return False, "unacked-work", f"report {rep.name} completion not acked (missing .done.ack and not in --handled)"
        done_m = mtime(Path(f"{rep}.done"))
        ack_m = mtime(Path(f"{rep}.done.ack"))
        done_ev = max(filter(None, (mtime(rep), done_m)), default=None)
        act_base = max(done_ev, ack_m) if receipt and ack_m and done_ev else done_ev
        rename_m = max((mtime(q) or 0.0 for q in rep.parent.glob(rep.name + ".done.r*")), default=None)
        if (
            retask_log
            or done_ev is None
            or act_base is None
            or (rename_m is not None and (done_m is None or done_m <= rename_m))
            or last_user_message(row["id"]) > done_ev + 2
            or last_activity(row["id"]) > act_base + ACTIVITY_MARGIN
        ):
            return False, "retasked-unreported", f"worker re-tasked or active after {rep.name} without new .done/.done.ack"
        return True, "verified-done-idle", f"report {rep.name} DONE + .done + acked"
    if row.get("status") == "closed" and row["id"] not in handled:
        return False, "closed-unverified", "closed ad-hoc worker without verified report (resume or pass --handled)"
    return True, "idle-no-unreported-work", "ad-hoc own-worker, readable log, no pending work"


def agent_rss_mb_map(agent_ids: set[str]) -> dict[str, float]:
    """Best-effort map of agent_id -> resident RSS in MB (provider + direct children) via ps; empty if ps fails."""
    if not agent_ids:
        return {}
    try:
        rows = ps_rows()
    except Refused:
        return {}
    sess_to_aids: dict[str, set[str]] = {}
    for aid in agent_ids:
        st = state_file(aid) or {}
        for sid in record_sessions(st):
            sess_to_aids.setdefault(sid, set()).add(aid)
    kids: dict[int, list[dict]] = {}
    for r in rows:
        kids.setdefault(r["ppid"], []).append(r)
    by_agent: dict[str, dict[int, int]] = {}
    for r in rows:
        matched: str | None = None
        callers = provider_callers(r)
        if len(callers) == 1 and callers[0] in agent_ids:
            matched = callers[0]
        else:
            sid = provider_session(r)
            if sid and len(sess_to_aids.get(sid, set())) == 1:
                matched = next(iter(sess_to_aids[sid]))
        if matched is None:
            continue
        pids = by_agent.setdefault(matched, {})
        pids[r["pid"]] = r["rss_kb"]
        for c in kids.get(r["pid"], []):
            pids[c["pid"]] = c["rss_kb"]
    return {aid: round(sum(pmap.values()) / 1024.0, 1) for aid, pmap in by_agent.items() if pmap}


def mtime(path: Path) -> float | None:
    try:
        return path.stat().st_mtime
    except OSError:
        return None


def report_scan(report: Path) -> tuple[bool, bool]:
    """(blocked, ends_done) read from a bounded head and tail of the report. blocked: a `BLOCKED:`/`NO-REPORT:` line or
    `STATUS: working` in the first non-empty lines (footer rule 6 puts BLOCKED on line 1) or the last 4 KB; such a report
    is not a finished one even when it also ends DONE. ends_done: the last non-empty line is exactly DONE."""
    try:
        with report.open("rb") as fh:  # never read a huge file whole
            head = fh.read(4096).decode("utf-8", "replace")
            fh.seek(0, os.SEEK_END)
            fh.seek(max(0, fh.tell() - 4096))
            tail = fh.read().decode("utf-8", "replace")
    except OSError:
        return True, False
    hl = [ln.strip() for ln in head.splitlines() if ln.strip()][:5]
    tl = [ln.strip() for ln in tail.splitlines() if ln.strip()]
    bad = re.compile(r"(BLOCKED|NO-REPORT):|STATUS:\s*working")
    return any(bad.match(ln) for ln in hl + tl), bool(tl) and tl[-1] == "DONE"


def report_done(report: Path | None) -> tuple[bool, bool]:
    """(finished, acked). finished: not blocked, the last non-empty line is DONE and `<report>.done` exists, touched no
    earlier than the report. acked: `<report>.done.ack` exists, touched no earlier than `.done`. An ack without `.done` is
    not proof (the lead renames `.done` to `.done.rN` to re-task a round): the lead passes --handled for that case."""
    if report is None:
        return False, False
    blocked, ends_done = report_scan(report)
    done = Path(f"{report}.done")
    r_m, d_m, a_m = mtime(report), mtime(done), mtime(Path(f"{done}.ack"))
    finished = not blocked and ends_done and d_m is not None and r_m is not None and r_m <= d_m + 1
    return finished, finished and a_m is not None and a_m + 1 >= d_m


def report_handled_ok(report: Path) -> bool:
    """The --handled path (no `.done`/ack needed): the same validator, plus the report must be quiet (not written in the last
    two minutes: a worker may still be rewriting it) and, if a `.done` exists at all, not newer than it."""
    blocked, ends_done = report_scan(report)
    r_m, d_m = mtime(report), mtime(Path(f"{report}.done"))
    if blocked or not ends_done or r_m is None or time.time() - r_m < 120:
        return False
    return d_m is None or r_m <= d_m + 1


def last_user_message(agent_id: str) -> float:
    """Epoch seconds of the last human/sourceless message to the agent (state record `lastUserMessageAt`, a UTC ISO string
    with `Z`); 0 when absent; infinity when present but unparsable (fail closed: counts as a re-task). An agent-sourced
    message (the lead's `paseo send`) does not move this field: `scan_log` and `last_activity` cover that."""
    v = (state_file(agent_id) or {}).get("lastUserMessageAt")
    if v in (None, ""):
        return 0.0
    try:
        return datetime.fromisoformat(str(v).replace("Z", "+00:00")).timestamp()
    except ValueError:
        return float("inf")


def last_activity(agent_id: str) -> float:
    """Epoch seconds of the agent's last activity (state record `lastActivityAt`, UTC with Z): 0 when absent, infinity when
    present but unparsable. A finished worker does nothing after its completion notice and the lead's ack."""
    v = (state_file(agent_id) or {}).get("lastActivityAt")
    if v in (None, ""):
        return 0.0
    try:
        return datetime.fromisoformat(str(v).replace("Z", "+00:00")).timestamp()
    except ValueError:
        return float("inf")


ACTIVITY_MARGIN = 90  # seconds of reply latency tolerated between the worker's completion (or the lead's ack) and its last activity


def verdict(row: dict, text: str, card: bool, permit: str | None, reports_dirs: list[str], handled: set[str],
            logstate: str = "ok", retask_log: bool = False, receipt: bool = False) -> None:
    """Fill row['verdict'], row['reason'] (bounded excerpt) and row['verified_done']. Order matters: a question, a
    BLOCKED line or a card always wins over a finished report, so such an agent is shown, never archived."""
    cls, status = row["class"], row["status"]
    last_line = next((ln for ln in reversed(text.splitlines()) if ln.strip()), "")
    row["verified_done"] = False
    if permit is not None:
        row["verdict"], row["reason"] = "waiting-on-operator", f"permission card: {permit}"
        return
    if status == "running":
        row["verdict"], row["reason"] = "working", ""
        return
    rep = report_for(row.get("slice"), reports_dirs)
    ok, acked = report_done(rep)
    row["report"] = str(rep) if rep else None
    own = cls == "own-worker"
    # evidence older than the last message sent to the agent is stale (a re-task): never "done"
    done_m = mtime(Path(f"{rep}.done")) if rep else None
    ack_m = mtime(Path(f"{rep}.done.ack")) if rep else None
    done_evidence = max(filter(None, (mtime(rep) if rep else None, done_m)), default=None)  # the WORKER's own completion evidence
    # last activity is explained by the lead's ack only when its receipt is visible in the log; else it must be near completion
    # (a prompt-only ack with no `.done.ack` on disk explains nothing: write the file)
    act_base = max(done_evidence, ack_m) if receipt and ack_m and done_evidence else done_evidence
    rename_m = max((mtime(q) or 0.0 for q in rep.parent.glob(rep.name + ".done.r*")), default=None) if rep else None
    retasked = bool(rep) and (retask_log or (rename_m is not None and (done_m is None or done_m <= rename_m))  # a newer `.done` is the next round's
                              or (done_evidence is not None and (last_user_message(row["id"]) > done_evidence + 2
                                                                 or last_activity(row["id"]) > act_base + ACTIVITY_MARGIN)))
    if retasked:
        ok = acked = False
    if logstate != "ok":
        ok = acked = False
    if own and re.search(r"(^|\n)\s*BLOCKED:", text):
        row["verdict"], row["reason"] = "waiting-on-lead", clean(text[text.rfind("BLOCKED:"):])
    elif last_line.rstrip().endswith("?"):
        row["verdict"] = "waiting-on-lead" if own else "waiting-on-operator"
        row["reason"] = clean(last_line)
    elif card:
        row["verdict"], row["reason"] = "waiting-on-operator", "question card pending: " + clean(text)
    elif logstate == "unreadable":
        row["verdict"], row["reason"] = "unknown", "log unreadable: nothing is archived on a blind view"
    elif logstate == "inbound":
        row["verdict"], row["reason"] = "unknown", "a message to the agent is the last entry: it has not answered yet"
    elif own and ok:
        if acked or row["id"] in handled:
            row["verified_done"] = True
            row["verdict"], row["reason"] = "done", "report ends DONE, .done present, completion handled"
        else:
            row["verdict"], row["reason"] = "waiting-on-lead", "completion notice not acked (write <done>.ack or pass --handled)"
    elif own and re.search(r"Please reply:\s*ack", text):
        row["verdict"], row["reason"] = "waiting-on-lead", "asks for ack: " + clean(last_line)
    elif own and row["id"] in handled and rep is not None and not retasked and report_handled_ok(rep):
        row["verified_done"] = True
        row["verdict"], row["reason"] = "done", "report ends DONE, lead passed --handled (no .done marker)"
    elif re.search(r"\bdone\b|^\s*written:", last_line, re.I):
        row["verdict"], row["reason"] = "done", "says done (report not verified)"
    elif status == "closed":
        row["verdict"], row["reason"] = "unknown", "closed (interrupted or daemon restart?): resume or re-task it; not archived"
    else:
        row["verdict"], row["reason"] = "unknown", clean(last_line)


_STATE_CACHE: list = [None]


def agent_state_files(refresh: bool = False) -> list[dict]:
    """Every agent record under $PASEO_HOME/agents (live and archived): the daemon archives a window by these. Cached per
    phase; an unreadable record is returned as {"_bad": True}, which occupies every window (fail closed)."""
    if _STATE_CACHE[0] is not None and not refresh:
        return _STATE_CACHE[0]
    out = []
    for p in sorted((paseo_home() / "agents").glob("*/*.json")):
        try:
            d = json.loads(p.read_text())
        except (OSError, ValueError):
            out.append({"_bad": True})
            continue
        out.append(d if isinstance(d, dict) else {"_bad": True})
    _STATE_CACHE[0] = out
    return out


def occupants_of(wks: str, live_ids: set[str], refresh: bool = False) -> list[str]:
    """Agents in a window by what the daemon would archive: unarchived state records with that workspaceId, plus any live
    agent whose record says so (background and internal agents are in the records, not in `paseo ls -g`)."""
    recs = agent_state_files(refresh)
    if any(d.get("_bad") for d in recs):
        return ["<unreadable record>"]
    found = {d["id"] for d in recs if d.get("workspaceId") == wks and not d.get("archivedAt") and isinstance(d.get("id"), str)}
    return sorted(found | {i for i in live_ids if (state_file(i) or {}).get("workspaceId") == wks})


def chain_of(lead: str) -> set[str]:
    """`lead` plus the archived leads it replaced through completed self-handoffs (bin/ade_lead_succession.py): their windows,
    window records and `ade.lead` labels are this lead's (the same lineage ade-worker-run uses). A cyclic ledger refuses."""
    sys.path.insert(0, str(Path(os.path.realpath(__file__)).parent))
    try:
        import ade_lead_succession as succ
    except ImportError:
        return {lead}
    try:
        return set(succ.lineage(lead)) | {lead}
    except succ.SuccessionError as e:
        raise Refused(f"{e}; fix or remove the handoff records by hand")


def claim_holders() -> set[str]:
    """Agent ids (owner agent, record or session) holding an ACTIVE claim (bin/ade_claims.py): such a tab is never archived.
    Fails closed: a missing module, an unreadable claims directory or a claim file that does not parse raises Refused (ownership
    of a worktree is unknown, so nothing is archived); a claims directory that does not exist means no claims."""
    sys.path.insert(0, str(Path(os.path.realpath(__file__)).parent))
    try:
        import ade_claims
    except ImportError as e:
        raise Refused(f"bin/ade_claims.py cannot be imported ({e}): claims are unknown, nothing is archived")
    d = ade_claims.claims_dir()
    try:
        files = sorted(p for p in d.iterdir() if p.suffix == ".json" and not p.name.startswith(".")) if d.exists() else []
    except OSError as e:
        raise Refused(f"the claims directory {d} cannot be read ({type(e).__name__}): nothing is archived")
    out: set[str] = set()
    for f in files:
        c = ade_claims.read_claim(f.stem)  # None for an invalid id, an unreadable file or a non-object: not "no claim"
        if c is None:
            raise Refused(f"the claim file {f} cannot be read: claims are unknown, nothing is archived (fix or remove it by hand)")
        if ade_claims.claim_state_active(c):
            owner = c.get("owner") if isinstance(c.get("owner"), dict) else {}
            out |= {v for v in (owner.get("agent"), owner.get("record"), owner.get("session"), c.get("id")) if isinstance(v, str) and v}
    return out


def window_is_ours(wks: str, name: str, lead: str) -> bool:
    """Provably this lead's (or a predecessor's in its self-handoff chain): every agent ever recorded in it (live or archived)
    carries ade.lead=<one of them> and there is at least one, or it is in one of their window records, or its name is the legacy
    `workers ... <lead id>` form. An empty window of unknown owner is only listed."""
    mine = chain_of(lead)
    if wks in other_leads_windows(lead):
        return False
    if any(wks in read_registry(x) for x in mine):
        return True
    if name.startswith(("workers ", "WORKERS ")) and any(name.endswith(f" {x}") for x in mine):
        return True
    recs = [d for d in agent_state_files() if d.get("workspaceId") == wks]
    return bool(recs) and not any(d.get("_bad") for d in agent_state_files()) and all((d.get("labels") or {}).get("ade.lead") in mine for d in recs)


def inventory(opts, lead: str, repo: str, roots: list[str]) -> tuple[list[dict], list[dict]]:
    allrows = live_agents()
    wmap = {w["workspaceId"]: w for w in workspaces()}
    states = {r["id"]: state_file(r["id"]) for r in allrows}
    lead_ids = {s["labels"]["ade.lead"] for s in states.values()
                if s and isinstance(s.get("labels"), dict) and s["labels"].get("ade.lead")}
    self_wks = (states.get(lead) or {}).get("workspaceId")
    chain = chain_of(lead)
    # Windows structurally known to hold another lead (by ade.lead target or ade.role/ade.chain/ade.box=LEAD),
    # regardless of whether a human renamed the window.
    foreign_lead_wks = set()
    for a in allrows:
        st = states[a["id"]]
        wks_a = st.get("workspaceId") if st and WKS_RE.fullmatch(str(st.get("workspaceId", ""))) else None
        if not wks_a or wks_a == self_wks or a["id"] in chain:
            continue
        lbls = (st or {}).get("labels") if isinstance((st or {}).get("labels"), dict) else {}
        if (a["id"] in lead_ids or lbls.get("ade.role") or lbls.get("ade.chain")
                or _box_from_labels(lbls) == "LEAD"):
            foreign_lead_wks.add(wks_a)
    permits = opts.permits or {}
    handled = set(filter(None, (opts.handled or "").split(",")))
    out = []
    for a in allrows:
        st = states[a["id"]]
        wks = st.get("workspaceId") if st and WKS_RE.fullmatch(str(st.get("workspaceId", ""))) else None
        win = wmap.get(wks) if wks else None
        if not in_roots(a.get("cwd") or "", roots):  # by the agent's own directory only (a window's project is just its basename)
            continue
        foreign_main = bool(wks and wks != self_wks and (
            wks in foreign_lead_wks
            or (win and LEAD_NAME_RE.match(str(win.get("name") or "")))  # legacy fallback for unlabelled foreign lead window
        ))
        row = {"id": a["id"], "name": clean(a.get("name") or "", 120), "status": clean(a.get("status"), 20),
               "cwd": a.get("cwd"), "windowId": wks, "windowName": clean(win.get("name"), 120) if win else None,
               "class": classify(a, st, lead, lead_ids, foreign_main, chain), "slice": ((st or {}).get("labels") or {}).get("slice"),
               "labels": (st or {}).get("labels") or {}}
        if row["class"] in SKIP_CLASSES:
            row.update(verdict="n/a", reason="", verified_done=False)
        else:
            log = log_tail(a["id"]) if a.get("status") != "running" else None
            text, card, lstate = last_text(log) if a.get("status") != "running" else ("", False, "ok")
            verdict(row, text, card, permits.get(a["id"]), opts.reports_dir or [], handled, lstate, *scan_log(log))
        out.append(row)
    return out, [w for w in wmap.values()]


# ----------------------------------------------------------------------------------------------- state

def state_path(lead: str) -> Path:
    base = os.environ.get("ADE_TIDY_STATE")
    return Path(base) if base else Path.home() / ".local/state/ade/tidy" / f"{lead}.json"


def load_state(lead: str) -> dict:
    try:
        d = json.loads(state_path(lead).read_text())
    except (OSError, ValueError):
        return {"sends": {}, "acks": {}}
    d = d if isinstance(d, dict) else {}
    for k in ("sends", "acks"):
        if not isinstance(d.get(k), dict):
            d[k] = {}
    return d


def num(v, default: float) -> float:
    return float(v) if isinstance(v, (int, float)) and not isinstance(v, bool) else default


def send_ts(st: dict, aid: str, now: float) -> float:
    """When the last send to aid was made; an unreadable record counts as 'just now' (fail closed: no second send)."""
    rec = st["sends"].get(aid)
    return 0.0 if rec is None else (num(rec.get("ts"), now) if isinstance(rec, dict) else now)


def save_state(lead: str, data: dict) -> None:
    p = state_path(lead)
    p.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=p.parent, prefix=".tidy-")
    with os.fdopen(fd, "w") as fh:
        json.dump(data, fh, indent=1, sort_keys=True)
    os.replace(tmp, p)


def flock_timeout(path: Path, seconds: int = 120):
    path.parent.mkdir(parents=True, exist_ok=True)
    fh = path.open("a")
    end = time.time() + seconds
    while True:
        try:
            fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return fh
        except OSError:
            if time.time() > end:
                fh.close()
                raise Refused(f"could not take {path} within {seconds}s (another ade-tidy or ade-worker-run holds it)")
            time.sleep(0.5)


def state_lock(lead: str):
    return flock_timeout(state_path(lead).with_suffix(".lock"), 30)


def worker_run_dir() -> Path:
    return Path(os.environ.get("ADE_WORKER_RUN_STATE") or Path.home() / ".local/state/ade/worker-run")


class Locks:
    """ade-worker-run's locks, in its order (the lead's own, then `_global.lock`), each with a bounded wait: window ownership
    is read and written across leads, so a tidy's find+rename+archive never interleaves with a launch or archive-window."""

    def __init__(self, lead: str):
        self.fhs: list = []
        try:
            for name in (f"{lead}.lock", "_global.lock"):
                self.fhs.append(flock_timeout(worker_run_dir() / name, 120))
        except BaseException:
            self.close()
            raise

    def close(self) -> None:
        for fh in reversed(self.fhs):
            fh.close()


def lock_for(lead: str) -> Locks:
    return Locks(lead)


def read_registry_entries(lead: str) -> tuple[set[str], dict[str, dict]]:
    """The window ids and structured entries ade-worker-run recorded as this lead's (`<lead>.windows.json`).
    A missing file is empty; an unreadable one raises Refused: ownership is unknown, so nothing is renamed or archived."""
    path = worker_run_dir() / f"{lead}.windows.json"
    names = names_mod()
    try:
        if names is not None and hasattr(names, "read_window_registry"):
            return names.read_window_registry(path)
        data = json.loads(path.read_text())
        ids = data["windows"]
        if not isinstance(ids, list) or not all(isinstance(i, str) and WKS_RE.fullmatch(i) for i in ids):
            raise ValueError("bad window id")
        raw_entries = data.get("entries") or {}
        if not isinstance(raw_entries, dict):
            raise ValueError("bad entries")
        return set(ids), {k: v for k, v in raw_entries.items() if k in ids and isinstance(v, dict)}
    except FileNotFoundError:
        return set(), {}
    except (OSError, ValueError, KeyError, TypeError):
        raise Refused(f"the window ownership record {path} is unreadable: nothing is renamed or archived (fix or remove it by hand)")


def read_registry(lead: str) -> set[str]:
    """The window ids ade-worker-run recorded as this lead's (`<lead>.windows.json`)."""
    return read_registry_entries(lead)[0]


def chain_registry_entries(lead: str) -> dict[str, dict]:
    """Merged structured window metadata across `lead` and its self-handoff chain (`lead` takes precedence)."""
    merged: dict[str, dict] = {}
    for x in sorted(chain_of(lead)):
        _, ents = read_registry_entries(x)
        for wks, entry in ents.items():
            if x == lead or wks not in merged:
                merged[wks] = entry
    return merged


def other_leads_windows(lead: str) -> dict[str, str]:
    """Window id -> another lead that registered it (such a window is never renamed or archived from here)."""
    out: dict[str, str] = {}
    mine = chain_of(lead)
    for path in worker_run_dir().glob("*.windows.json"):
        owner = path.name[: -len(".windows.json")]
        if owner not in mine and UUID_RE.fullmatch(owner):  # a predecessor in the lead's own chain is not another lead
            for wks in read_registry(owner):
                out.setdefault(wks, owner)
    return out


def register_window(lead: str, wks: str, *, box: str | None = None, repo: str | None = None,
                    cwd: str | None = None, work: str | None = None) -> None:
    ids, entries = read_registry_entries(lead)
    if any(v is not None for v in (box, repo, cwd, work)) or wks in entries:
        entry = dict(entries.get(wks) or {"windowId": wks})
        entry["windowId"] = wks
        entry["lead"] = lead
        if box is not None:
            entry["box"] = box
        if repo is not None:
            entry["repo"] = repo
        if cwd is not None:
            entry["cwd"] = cwd
        if work is not None:
            entry["work"] = work
        entries[wks] = entry
    _write_registry(lead, ids | {wks}, entries)


def unregister_window(lead: str, wks: str) -> None:
    ids, entries = read_registry_entries(lead)
    if wks in ids:
        entries.pop(wks, None)
        _write_registry(lead, ids - {wks}, entries)


def _write_registry(lead: str, ids: set[str], entries: dict[str, dict] | None = None) -> None:
    """Atomic, in ade-worker-run's format (the caller holds the lead and global locks)."""
    path = worker_run_dir() / f"{lead}.windows.json"
    names = names_mod()
    if names is not None and hasattr(names, "write_window_registry"):
        names.write_window_registry(path, ids, entries)
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    payload: dict[str, object] = {"windows": sorted(ids)}
    if entries:
        clean_entries = {w: entries[w] for w in sorted(ids) if w in entries and entries[w]}
        if clean_entries:
            payload["entries"] = clean_entries
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".")
    try:
        with os.fdopen(fd, "w") as fh:
            json.dump(payload, fh, sort_keys=True)
        os.replace(tmp, path)
    except BaseException:
        Path(tmp).unlink(missing_ok=True)
        raise


# ----------------------------------------------------------------------------------------------- plan

def send_text(lead: str, repo: str) -> str:
    return (f"Lead {lead} is tidying the {repo} windows. Reply with ONE line: your status (working, done, blocked, "
            f"or waiting on whom). Nothing else is needed. Please reply: ack {lead}")


def reconnect_candidates(rows: list[dict], st: dict, now: float) -> list[dict]:
    out = []
    for r in rows:
        if r["class"] not in ("own-worker", "operator") or r["status"] != "idle":
            continue
        if r["verdict"] != "unknown":  # waiting-on-lead is answered, not pinged; done and operator-waiting need nothing
            continue
        if now - num(st["acks"].get(r["id"]), 0.0) < CONTACT_FRESH_SECONDS:
            continue  # contact proven recently
        if now - send_ts(st, r["id"], now) < RESEND_SECONDS:
            continue
        if r["id"] in st["sends"] and num(st["acks"].get(r["id"]), 0.0) <= send_ts(st, r["id"], now):
            continue  # one unacked send per agent: listed as unreached, never pinged again until an ack is recorded
        out.append(r)
    return out


def window_kind(agents: list[dict]) -> str | None:
    """The window's kind by majority class of its live agents (ties: LEAD > WORKER > OTHER); None = foreign/empty."""
    counts = {k: 0 for k in KINDS}
    for r in agents:
        k = KIND_FOR_CLASS.get(r["class"])
        if k:
            counts[k] += 1
    if any(r["class"] == "self" for r in agents):
        return "LEAD"
    best = max(KINDS, key=lambda k: (counts[k], -KINDS.index(k)))
    return best if counts[best] else None


# ----------------------------------------------------------------------------------------------- windows

def names_mod():
    """bin/ade_ws_names.py (window name builder/parser, ws-naming slice), or None: only the rename step needs it."""
    sys.path.insert(0, str(Path(os.path.realpath(__file__)).parent))
    try:
        import ade_ws_names
    except ImportError:
        return None
    return ade_ws_names


def derive_work(kind: str, agents: list[dict], repo: str) -> str | None:
    """A current-work text when the window name carries none: the lead tab's name for LEAD, slice names otherwise."""
    if kind == "LEAD":
        for r in agents:
            if r["class"] in ("self", "lead"):
                w = re.sub(r"^(?i:lead|main)\s+", "", r["name"]).strip()
                w = w[len(repo):].strip() if w.startswith(repo + " ") else w
                if w and w != repo:
                    return w
        return None
    bits: list[str] = []
    for r in agents:
        b = r.get("slice") or r["name"]
        if b and clean(b, 40) not in bits:
            bits.append(clean(b, 40))
    text = ""
    for i, b in enumerate(bits):
        nxt = f"{text}, {b}" if text else b
        if len(nxt) > 45:
            return (text + f" +{len(bits) - i} more") if text else b[:50]
        text = nxt
    return text or None


def plan_windows(rows, wins, occupancy, repo, roots, opts, names) -> dict:
    by_win: dict[str, list[dict]] = {}
    for r in rows:
        if r["windowId"]:
            by_win.setdefault(r["windowId"], []).append(r)
    own_entries = chain_registry_entries(opts.lead_id) if getattr(opts, "lead_id", None) else {}
    work_over = {}
    for item in opts.work or []:
        k, _, v = item.partition("=")
        if k not in KINDS or not v:
            raise Refused(f"--work wants KIND=TEXT with KIND in {KINDS}, got {item!r}")
        work_over[k] = v
    out = {"windows": [], "renames": [], "misplaced": [], "notes": []}
    for w in wins:
        wks = w["workspaceId"]
        agents = [r for r in by_win.get(wks, []) if r["class"] not in SKIP_CLASSES]
        if not (in_roots(w.get("cwd") or "", roots) or by_win.get(wks)):
            continue
        w_entry = own_entries.get(wks) or {}
        kind = window_kind(agents)
        # Prefer structured registry box or explicit worker labels when present (2026-11-25 ruling).
        if kind != "LEAD":
            if w_entry.get("box") in KINDS:
                kind = w_entry["box"]
            elif kind == "WORKER":
                explicit_boxes = {_box_from_labels(r.get("labels")) for r in agents if _box_from_labels(r.get("labels"))}
                if explicit_boxes == {"OTHER"}:
                    kind = "OTHER"
        occupants = occupancy.get(wks, [])
        foreign = [a for a in occupants if a not in {r["id"] for r in by_win.get(wks, [])}]
        entry = {"windowId": wks, "name": clean(w.get("name"), 120), "cwd": w.get("cwd"), "kind": kind, "isolation": w.get("isolation"), "agents": [r["id"] for r in agents],
                 "occupants": len(occupants), "outsideRepoAgents": len(foreign)}
        out["windows"].append(entry)
        for r in agents:
            ok_kinds = set(KINDS) if r["class"] == "own-worker" else {KIND_FOR_CLASS.get(r["class"])}  # a lead's own worker may sit in any of its boxes
            if kind and r["class"] in KIND_FOR_CLASS and kind not in ok_kinds:
                out["misplaced"].append({"agent": r["id"], "name": r["name"], "class": r["class"], "window": wks,
                                         "windowName": w.get("name"), "windowKind": kind,
                                         "wantKind": KIND_FOR_CLASS[r["class"]]})
        if kind is None:
            continue  # empty of our agents, or another lead's: no name from here
        if foreign:
            out["notes"].append(f"{wks} holds {len(foreign)} live agent(s) outside {repo}: not renamed")
            continue
        cur = w.get("name") or ""
        if names is None:
            out["notes"].append("bin/ade_ws_names.py is missing: no window is renamed")
            continue
        if wks in (opts.other_windows or {}):
            out["notes"].append(f"{wks} is registered to another lead: not renamed")
            continue
        parsed, legacy = names.parse(cur), names.parse_legacy(cur)
        if any(r["class"] in ("other-worker", "lead") for r in by_win.get(wks, [])) or (legacy and legacy.lead not in (None, *chain_of(opts.lead_id))):
            out["notes"].append(f"{wks} holds another lead's agent(s) or carries another lead's id: not renamed")
            continue
        if not w_entry.get("box") and (parsed or legacy):
            kind = parsed.box if parsed else names.BOX_OF[legacy.kind]  # display fallback when no structured box exists
        work = work_over.get(kind) or (parsed.work if parsed else None) \
            or w_entry.get("work") \
            or (names.normalize_work(legacy.middle, repo) if legacy else None) or derive_work(kind, agents, repo)
        if not work:
            out["notes"].append(f"{wks} ({kind}): no current-work text; pass --work {kind}=TEXT")
            continue
        try:
            want = names.build(kind, repo, work)
        except ValueError as e:
            out["notes"].append(f"{wks}: {e}")
            continue
        if want != cur:
            out["renames"].append({"windowId": wks, "from": cur, "to": want})
    return out


def is_main_name(name: str) -> bool:
    """Legacy display-name fallback for a LEAD/MAIN window (never sole authority; see `is_lead_window`)."""
    return bool(LEAD_NAME_RE.match(name or ""))


def structured_window_box(wks: str, lead: str, entries: dict[str, dict] | None = None) -> str | None:
    """Resolve a window's box (`LEAD`, `WORKER`, `OTHER`) from explicit structured records and agent labels, else None."""
    lead_state = state_file(lead)
    if lead_state and lead_state.get("workspaceId") == wks:
        return "LEAD"
    entry = (entries or {}).get(wks)
    if isinstance(entry, dict) and entry.get("box") in KINDS:
        return entry["box"]
    mine = chain_of(lead)
    recs = [d for d in agent_state_files() if not d.get("_bad") and d.get("workspaceId") == wks]
    if any(d.get("id") in mine for d in recs):
        return "LEAD"
    boxes: set[str] = set()
    for d in recs:
        labels = d.get("labels") if isinstance(d.get("labels"), dict) else {}
        b = _box_from_labels(labels)
        if b:
            boxes.add(b)
    if "LEAD" in boxes:
        return "LEAD"
    if len(boxes) == 1:
        return next(iter(boxes))
    return None


def is_lead_window(wks: str, name: str, lead: str, entries: dict[str, dict] | None = None, kind: str | None = None) -> bool:
    """True when `wks` is a LEAD window by structured metadata (lead's own window, registry, agent labels)
    or legacy `LEAD`/`MAIN` display name. Never archived by ade-tidy even if a human renamed it."""
    if kind == "LEAD":
        return True
    if structured_window_box(wks, lead, entries) == "LEAD":
        return True
    return is_main_name(name)


def _ours_or_unknown(wks: str, nm: str, lead: str) -> bool:
    try:
        return window_is_ours(wks, nm, lead)
    except Refused:
        return False


def extra_windows(wins: list[dict], occupancy: dict, opts, lead: str, names, archiving: set[str]) -> list[dict]:
    """Windows of this lead's chain beyond the three boxes: per (repo, box) every owned window but the keeper (most live agents;
    ties: a current-form name, then the id), and an owned window with neither a structured box nor a scheme name (the lead's own
    LEAD window excepted). Uses structured registry/label metadata FIRST (2026-11-25 ruling), so a human-renamed WORKER or OTHER
    box is still grouped under its true box and repo rather than falsely flagged as outside the scheme."""
    if names is None:
        return []
    own_entries = chain_registry_entries(lead)
    groups: dict[tuple[str, str], list[dict]] = {}
    out = []
    for w in wins:
        wks, nm = w["windowId"], w.get("name") or ""
        if wks in (opts.other_windows or {}) or not _ours_or_unknown(wks, nm, lead):
            continue
        parsed, legacy = names.parse(nm), names.parse_legacy(nm)
        w_entry = own_entries.get(wks) or {}
        # Structured box first (registry -> agent records -> live agent kind), display name only as legacy fallback.
        box = (w_entry.get("box") if w_entry.get("box") in KINDS else None) \
            or structured_window_box(wks, lead, own_entries) \
            or (w.get("kind") if w.get("kind") in KINDS else None) \
            or (parsed.box if parsed else (names.BOX_OF[legacy.kind] if legacy else None))
        if box is None:
            if not is_lead_window(wks, nm, lead, own_entries, w.get("kind")):
                out.append({"windowId": wks, "name": nm, "box": None, "live": len(occupancy.get(wks, [])), "why": "named outside the scheme"})
            continue
        if box == "LEAD" or is_lead_window(wks, nm, lead, own_entries, w.get("kind")):
            continue  # a lead's own window; a successor's predecessor window is archived by the handoff, not here
        repo_name = w_entry.get("repo") or (parsed.repo if parsed else None) or (names.repo_of(w["cwd"]) if w.get("cwd") else "?")
        groups.setdefault((repo_name, box), []).append(w)
    for (repo_name, box), ws in sorted(groups.items()):
        if len(ws) < 2:
            continue
        ws.sort(key=lambda w: (-len(occupancy.get(w["windowId"], [])), not (names.parse(w.get("name") or "") or names.Name("", "", "")).current, w["windowId"]))
        for w in ws[1:]:
            out.append({"windowId": w["windowId"], "name": w.get("name") or "", "box": box, "live": len(occupancy.get(w["windowId"], [])),
                        "why": f"second {box} window for {repo_name} (keeper: {ws[0]['windowId']})"})
    for e in out:
        e["archive"] = e["windowId"] in archiving
    return out


def plan(opts, lead: str, repo: str, roots: list[str]) -> dict:
    names = names_mod()
    opts.lead_id = lead
    opts.other_windows = other_leads_windows(lead)  # Refused (unreadable record) ends the run: ownership is unknown
    read_registry(lead)
    now = time.time()
    st = load_state(lead)
    opts.permits = pending_permissions()
    permits_ok = opts.permits is not None
    if not permits_ok:
        opts.permits = {}
    rows, wins = inventory(opts, lead, repo, roots)
    live_ids = {a["id"] for a in live_agents()}
    unplaced = [i for i in live_ids if not WKS_RE.fullmatch(str((state_file(i) or {}).get("workspaceId", "")))]
    occupancy = {w["workspaceId"]: occupants_of(w["workspaceId"], live_ids) for w in wins}
    mine = [r for r in rows if r["class"] not in SKIP_CLASSES]
    p = {"repo": repo, "lead": lead, "roots": roots, "agents": rows, "permits_ok": permits_ok, "notes": []}
    p["waiting_on_lead"] = [r for r in mine if r["verdict"] == "waiting-on-lead"]
    p["waiting_on_operator"] = [r for r in mine if r["verdict"] == "waiting-on-operator"]
    p["send"] = [{"agent": r["id"], "name": r["name"], "class": r["class"]} for r in reconnect_candidates(mine, st, now)]
    p["unreached"] = [r["id"] for r in mine if r["status"] == "closed" and r["class"] == "own-worker" and r["verdict"] != "done"] + \
        [r["id"] for r in mine if r["status"] == "idle" and r["id"] in st["sends"] and r["id"] not in st["acks"]
         and now - send_ts(st, r["id"], now) >= CONTACT_FRESH_SECONDS]
    win = plan_windows(rows, wins, occupancy, repo, roots, opts, names)
    notes = p["notes"]
    p.update({k: v for k, v in win.items() if k != "notes"})
    p["notes"] = notes + win["notes"]
    if not permits_ok:
        p["notes"].append("`paseo permit ls` failed: apply will send and archive nothing")
    # archive only a worker of this lead that is not running and whose DONE report is verified and handled (a `closed`
    # agent was often only interrupted by a daemon restart, so closed alone proves nothing)
    claims_unknown = ""
    try:
        held = claim_holders()  # an agent holding an active claim keeps its tab (and so its window)
    except Refused as e:
        if opts.apply:
            raise  # --apply fails closed: ownership of a worktree is unknown, nothing is archived
        held, claims_unknown = set(), str(e)  # a dry run lists the rest of the plan and says what it could not judge (am-02)
    p["claim_held"] = [{"agent": r["id"], "name": r["name"]} for r in mine if r["id"] in held and r["class"] == "own-worker"
                       and r["status"] in ("idle", "closed") and r["verdict"] == "done" and r["verified_done"]]
    p["archive_agents"] = [{"agent": r["id"], "name": r["name"], "why": "done"}
                           for r in mine if r["class"] == "own-worker" and r["status"] in ("idle", "closed") and r["id"] not in held
                           and r["verdict"] == "done" and r["verified_done"]
                           and (r["labels"].get("ade.placement") != "main" or r["id"] in set(filter(None, (opts.handled or "").split(","))))]
    p["list_only"] = [{"agent": r["id"], "name": r["name"], "class": r["class"], "status": r["status"],
                       "why": "operator agent: archive only on the operator's yes"}
                      for r in mine if r["class"] == "operator" and (r["status"] == "closed" or r["verdict"] == "done")]
    if claims_unknown:  # no archive is proposed without the claims; the refusal names the file, and --apply would stop on it
        p["archive_agents"], p["claim_held"] = [], []
        p["notes"].append(f"WARNING: claims unknown, so no agent or window archive is listed and --apply refuses the whole run: {clean(claims_unknown, 300)}")
    leaving = {a["agent"] for a in p["archive_agents"]}
    p["archive_windows"], p["empty_not_ours"] = [], []
    if unplaced:
        p["notes"].append(f"{len(unplaced)} live agent(s) have no workspaceId in a state file: no window is archived")
    own_entries = chain_registry_entries(lead)
    for w in win["windows"]:
        wks, nm = w["windowId"], w.get("name") or ""
        if is_lead_window(wks, nm, lead, own_entries, w["kind"]) or any(r["class"] == "self" for r in mine if r["windowId"] == wks):
            continue
        if [a for a in occupancy.get(wks, []) if a not in leaving]:
            continue  # someone stays in it
        if unplaced:
            continue
        if w.get("isolation") != "local":
            p["empty_not_ours"].append({"windowId": wks, "name": nm, "why": f"isolation {w.get('isolation')!r}: archiving would delete its worktree"})
        elif not _ours_or_unknown(wks, nm, lead):
            p["empty_not_ours"].append({"windowId": wks, "name": nm, "why": "owner not provably this lead: operator's call"})
        elif not claims_unknown:
            p["archive_windows"].append({"windowId": wks, "name": nm, "conditional": bool(occupancy.get(wks))})
    p["extra_windows"] = extra_windows(win["windows"], occupancy, opts, lead, names, {w["windowId"] for w in p["archive_windows"]})
    p["idle_hours"] = getattr(opts, "idle_hours", None)
    p["idle_hibernate"], p["idle_operator_candidates"], p["idle_skipped"] = [], [], []
    if p["idle_hours"] is not None:
        wpath = Path(opts.watcher_file) if getattr(opts, "watcher_file", None) else None
        watcher_id, watcher_err = load_load_watch_watcher(wpath)
        if watcher_err is not None:
            if opts.apply:
                raise Refused(f"standing watcher registry unreadable: {watcher_err}")
            p["notes"].append(f"WARNING: standing watcher registry unreadable, so no idle-hibernate archive is listed and --apply refuses the run: {clean(watcher_err, 200)}")
        else:
            idle_seconds = p["idle_hours"] * 3600.0
            handled_set = set(filter(None, (opts.handled or "").split(",")))
            recs = agent_state_files()
            unreadable_recs = any(d.get("_bad") for d in recs)
            with_children = {
                d["labels"][PARENT_LABEL]
                for d in recs
                if not d.get("_bad") and not d.get("archivedAt")
                and isinstance(d.get("labels"), dict) and isinstance(d["labels"].get(PARENT_LABEL), str)
            }
            already_archiving = {a["agent"] for a in p["archive_agents"]}
            rss_map = agent_rss_mb_map({r["id"] for r in mine if r["class"] != "self"})
            for r in mine:
                aid = r["id"]
                if r["class"] == "self" or aid in already_archiving:
                    continue
                st_rec = state_file(aid)
                w_why = standing_watcher_reason(r, st_rec, watcher_id)
                if w_why:
                    p["idle_skipped"].append({"agent": aid, "name": r["name"], "class": r["class"], "reason": "standing-watcher", "detail": w_why})
                    continue
                if r["status"] == "running":
                    p["idle_skipped"].append({"agent": aid, "name": r["name"], "class": r["class"], "reason": "running", "detail": "active turn"})
                    continue
                if r["status"] not in ("idle", "closed"):
                    p["idle_skipped"].append({"agent": aid, "name": r["name"], "class": r["class"], "reason": "not-idle", "detail": r["status"]})
                    continue
                if not permits_ok:
                    p["idle_skipped"].append({"agent": aid, "name": r["name"], "class": r["class"], "reason": "permits-unreadable", "detail": "paseo permit ls failed"})
                    continue
                if aid in (opts.permits or {}):
                    p["idle_skipped"].append({"agent": aid, "name": r["name"], "class": r["class"], "reason": "permission-pending", "detail": opts.permits[aid]})
                    continue
                if r["verdict"] in ("waiting-on-operator", "waiting-on-lead"):
                    p["idle_skipped"].append({"agent": aid, "name": r["name"], "class": r["class"], "reason": r["verdict"], "detail": r["reason"]})
                    continue
                act = iso_epoch((st_rec or {}).get("lastActivityAt"))
                um = last_user_message(aid)
                if act is None or not math.isfinite(um):
                    p["idle_skipped"].append({"agent": aid, "name": r["name"], "class": r["class"], "reason": "activity-unreadable", "detail": "missing or invalid lastActivityAt"})
                    continue
                idle_s = now - max(act, um)
                if idle_s < idle_seconds:
                    continue
                idle_h = round(idle_s / 3600.0, 2)
                rss_mb = rss_map.get(aid)
                revive_cmd = f"bin/ade-revive {aid}"
                if r["class"] != "own-worker":
                    p["idle_operator_candidates"].append({
                        "agent": aid, "name": r["name"], "class": r["class"], "status": r["status"],
                        "idle_hours": idle_h, "rss_mb": rss_mb, "revive_cmd": revive_cmd,
                        "why": f"{r['class']} session: operator's call (never archived by --apply)",
                    })
                    continue
                if claims_unknown:
                    p["idle_skipped"].append({"agent": aid, "name": r["name"], "class": r["class"], "reason": "claims-unknown", "detail": clean(claims_unknown, 120)})
                    continue
                if aid in held:
                    p["idle_skipped"].append({"agent": aid, "name": r["name"], "class": r["class"], "reason": "active-claim", "detail": "holds an active worktree claim"})
                    continue
                if unreadable_recs:
                    p["idle_skipped"].append({"agent": aid, "name": r["name"], "class": r["class"], "reason": "records-unreadable", "detail": "cannot rule out live children"})
                    continue
                if aid in with_children:
                    p["idle_skipped"].append({"agent": aid, "name": r["name"], "class": r["class"], "reason": "has-live-children", "detail": "archiving would cascade to an unarchived child"})
                    continue
                log = log_tail(aid)
                _, _, lstate = last_text(log)
                retask_log, receipt = scan_log(log)
                safe, pw_code, pw_detail = idle_paid_work_check(r, st_rec, opts.reports_dir or [], handled_set, log, lstate, retask_log, receipt)
                if not safe:
                    p["idle_skipped"].append({"agent": aid, "name": r["name"], "class": r["class"], "reason": pw_code, "detail": pw_detail})
                    continue
                p["idle_hibernate"].append({
                    "agent": aid, "name": r["name"], "class": r["class"], "status": r["status"],
                    "idle_hours": idle_h, "rss_mb": rss_mb, "revive_cmd": revive_cmd,
                    "why": f"idle-hibernate ({pw_code}: {pw_detail})",
                })
    return p


# ----------------------------------------------------------------------------------------------- report

def render(p: dict) -> str:
    out = []
    add = out.append
    add(f"ade-tidy: repo {p['repo']}  lead {p['lead']}  ({len(p['agents'])} agents in scope)")
    add("")
    add("A. Inventory")
    for i, r in enumerate(p["agents"], 1):
        add(f" A{i}. {r['id'][:8]} {r['class']:<12} {clean(r['status'], 12):<8} {r['verdict']:<20} "
            f"{clean(r['name'], 50)} | window {r['windowId']} {clean(r['windowName'], 50)}")
    add("")
    add("B. Waiting on the LEAD (answer each before anything else)")
    for i, r in enumerate(p["waiting_on_lead"], 1):
        add(f" B{i}. {r['id']} {r['name'][:40]}: {r['reason']}")
    if not p["waiting_on_lead"]:
        add(" B-. none")
    add("")
    add("C. Waiting on the OPERATOR (agent text, untrusted)")
    for i, r in enumerate(p["waiting_on_operator"], 1):
        add(f" C{i}. {r['id']} {r['class']} {r['name'][:40]}: {r['reason']}")
    if not p["waiting_on_operator"]:
        add(" C-. none")
    add("")
    add("D. Reconnect (one plain send each, never steer)")
    for i, s in enumerate(p["send"], 1):
        add(f" D{i}. send to {s['agent']} ({s['class']}) {s['name'][:40]}")
    for i, a in enumerate(p["unreached"], 1):
        add(f" D{i}u. {a}: closed, or no ack after a send: report to the operator, resume or re-route")
    if not p["send"] and not p["unreached"]:
        add(" D-. nothing to send")
    add("")
    add("E. Window names")
    for i, r in enumerate(p["renames"], 1):
        add(f" E{i}. {r['windowId']}: {clean(r['from'], 120)!r} -> {r['to']!r}")
    for n in p["notes"]:
        add(f" E-. {n}")
    if not p["renames"] and not p["notes"]:
        add(" E-. names already match")
    add("")
    add("F. Misplaced tabs (Paseo cannot move an agent between windows; none is relaunched)")
    for i, m in enumerate(p["misplaced"], 1):
        add(f" F{i}. {m['agent']} {m['class']} sits in {m['window']} ({m['windowKind']} by majority), wants {m['wantKind']}")
    if not p["misplaced"]:
        add(" F-. none")
    add("")
    add("G. Finished")
    for i, a in enumerate(p["archive_agents"], 1):
        add(f" G{i}. archive agent {a['agent']} ({a['why']}) {a['name'][:40]}")
    for i, a in enumerate(p["list_only"], 1):
        add(f" G{i}o. {a['agent']} {a['name'][:40]} ({a['status']}): {a['why']}")
    for i, w in enumerate(p["empty_not_ours"], 1):
        add(f" G{i}n. empty window {w['windowId']} {w['name']!r} left alone: {w['why']}")
    for i, w in enumerate(p["archive_windows"], 1):
        add(f" G{i}w. archive window {w['windowId']} {w['name']!r}" + (" once its agents are archived" if w["conditional"] else " (empty)"))
    for i, a in enumerate(p.get("claim_held", []), 1):
        add(f" G{i}c. {a['agent']} {a['name'][:40]} is done but holds an active claim: its tab stays")
    if not (p["archive_agents"] or p["list_only"] or p["archive_windows"] or p["empty_not_ours"] or p.get("claim_held")):
        add(" G-. nothing finished")
    add("")
    add("H. Windows beyond the three boxes (LEAD, WORKER, OTHER per lead chain and repo)")
    for i, e in enumerate(p.get("extra_windows", []), 1):
        add(f" H{i}. {e['windowId']} {clean(e['name'], 60)!r}: {e['why']}; {e['live']} live agent(s); "
            + ("--apply archives it" if e["archive"] else "stays (not empty or not provably finished)"))
    if not p.get("extra_windows"):
        add(" H-. none")
    if p.get("idle_hours") is not None:
        add("")
        add(f"I. Idle hibernation (--idle-hours {p['idle_hours']:g}; observe-only unless --apply)")
        for i, a in enumerate(p.get("idle_hibernate", []), 1):
            rss = f"{a['rss_mb']:.1f} MB" if a.get("rss_mb") is not None else "n/a"
            add(f" I{i}. archive (idle-hibernate) {a['agent']} ({a['status']}, idle {a['idle_hours']:.2f}h, rss {rss}) "
                f"{a['name'][:40]} — reversible via: {a['revive_cmd']}")
        for i, a in enumerate(p.get("idle_operator_candidates", []), 1):
            rss = f"{a['rss_mb']:.1f} MB" if a.get("rss_mb") is not None else "n/a"
            add(f" I{i}o. {a['agent']} ({a['class']}, {a['status']}, idle {a['idle_hours']:.2f}h, rss {rss}) "
                f"{a['name'][:40]}: {a['why']} — reversible via: {a['revive_cmd']}")
        for i, a in enumerate(p.get("idle_skipped", []), 1):
            add(f" I{i}s. skipped {a['agent']} ({a['reason']}): {clean(a.get('detail', ''), 100)}")
        if not (p.get("idle_hibernate") or p.get("idle_operator_candidates") or p.get("idle_skipped")):
            add(" I-. no idle-hibernation candidates")
    return "\n".join(out)


# ----------------------------------------------------------------------------------------------- apply

def ids_ok(*ids: str) -> None:
    for i in ids:
        if not isinstance(i, str) or not (UUID_RE.fullmatch(i) or WKS_RE.fullmatch(i)):
            raise Refused(f"refusing malformed id {i!r}")


def valid_id(i) -> bool:
    try:
        ids_ok(i)
        return True
    except Refused:
        return False


def apply(p: dict, lead: str, repo: str, opts=None) -> list[dict]:
    """Act on the plan. Every precondition is re-read right before its action; a failure is recorded, never fatal."""
    results: list[dict] = []

    def rec(op, target, ok, why=""):
        results.append({"op": op, "target": target, "ok": ok, "why": why})

    def attempt(op, target, fn):
        try:
            fn()
        except (Refused, OSError) as e:
            rec(op, target, False, clean(str(e), 160))

    if not p.get("permits_ok"):
        rec("apply", "", False, "permission list unreadable: no send and no archive")
        sends, archive_agents, idle_hibernate = [], [], []
    else:
        sends, archive_agents, idle_hibernate = p["send"], p["archive_agents"], p.get("idle_hibernate", [])
    try:
        nowrows = {a["id"]: a for a in live_agents()}
        fresh_permits = pending_permissions()
    except Refused as e:
        return [{"op": "apply", "target": "", "ok": False, "why": clean(str(e), 160)}]
    if fresh_permits is None:
        return [{"op": "apply", "target": "", "ok": False, "why": "permission list unreadable: nothing done"}]

    fresh_msg = {a["agent"]: last_user_message(a["agent"]) for a in [*archive_agents, *idle_hibernate]}  # message times at apply start

    def do_send(s):
        aid = s["agent"]
        if not valid_id(aid):
            return rec("send", clean(aid, 60), False, "malformed id: skipped")
        if not os.environ.get("PASEO_AGENT_ID"):
            return rec("send", aid, False, "sourceless session: a send would default to interrupt; run inside the lead's session")
        cur = nowrows.get(aid)
        if not cur or cur.get("status") != "idle" or aid in fresh_permits:
            return rec("send", aid, False, "not idle now (or a card is pending): nothing sent")
        now = time.time()
        with state_lock(lead):
            st = load_state(lead)
            if now - send_ts(st, aid, now) < RESEND_SECONDS:
                return rec("send", aid, False, "already sent within the hour")
            latest = next((x for x in live_agents() if x["id"] == aid), None)  # the view may be a minute old: re-read now
            permits_now = pending_permissions()
            if not latest or latest.get("status") != "idle" or permits_now is None or aid in permits_now:
                return rec("send", aid, False, "not idle now (or a card is pending, or permissions unreadable): nothing sent")
            rc, out, err = paseo(["send", "--json", "--no-wait", aid, "--prompt", send_text(lead, repo)])
            status = ""
            try:
                status = clean(str(json.loads(out).get("status", "")), 40)
            except (ValueError, AttributeError):
                pass
            st["sends"][aid] = {"ts": now, "rc": rc, "status": status}
            save_state(lead, st)
        rec("send", aid, rc == 0, f"status {status or '?'}; delivery unproven until `ack {lead}` arrives (ade-tidy ack {aid})"
            if rc == 0 else clean(err or out, 120))

    for s in sends:
        attempt("send", s["agent"], lambda s=s: do_send(s))

    def do_rename(r):
        if not valid_id(r["windowId"]):
            return rec("rename", clean(r["windowId"], 60), False, "malformed id: skipped")
        cur = next((w for w in workspaces() if w["workspaceId"] == r["windowId"]), None)
        if not cur or cur.get("name") != r["from"]:
            return rec("rename", r["windowId"], False, "window changed since the plan: skipped")
        legacy_mine = cur["name"].startswith(("workers ", "WORKERS ")) and any(cur["name"].endswith(f" {x}") for x in chain_of(lead))
        if r["windowId"] in other_leads_windows(lead):
            return rec("rename", r["windowId"], False, "registered to another lead: skipped")
        was_registered = r["windowId"] in read_registry(lead)
        if legacy_mine and not was_registered:  # ownership is recorded before the lead id leaves the name (ade-worker-run's order)
            names_m = names_mod()
            parsed_to = names_m.parse(r["to"]) if names_m is not None else None
            register_window(lead, r["windowId"],
                            box=(parsed_to.box if parsed_to else "WORKER"),
                            repo=(parsed_to.repo if parsed_to else repo),
                            cwd=cur.get("cwd"),
                            work=(parsed_to.work if parsed_to else None))
        rc, out, err = paseo(["workspace", "rename", r["windowId"], r["to"]])
        rec("rename", r["windowId"], rc == 0, r["to"] if rc == 0 else clean(err or out, 120))
        if rc != 0 and legacy_mine and not was_registered:
            unregister_window(lead, r["windowId"])  # the name still proves it; drop the entry again

    for r in p["renames"]:
        attempt("rename", r["windowId"], lambda r=r: do_rename(r))

    def do_archive_agent(a):
        aid = a["agent"]
        if not valid_id(aid):
            return rec("archive-agent", clean(aid, 60), False, "malformed id: skipped")
        cur = nowrows.get(aid)
        stt = state_file(aid) or {}
        if not cur or cur.get("status") not in ("idle", "closed") or aid in fresh_permits \
                or (stt.get("labels") or {}).get("ade.lead") not in chain_of(lead):
            return rec("archive-agent", aid, False, "not idle/closed now, card pending, gone, or not this lead's: skipped")
        if aid in claim_holders():
            return rec("archive-agent", aid, False, "holds an active claim: skipped")
        freshrow = next((x for x in live_agents() if x["id"] == aid), None)  # re-read right before: status, text, retask
        log = log_tail(aid)
        text, card, lstate = last_text(log)
        permits_now = pending_permissions()
        if not freshrow or freshrow.get("status") not in ("idle", "closed") or permits_now is None or aid in permits_now \
                or last_user_message(aid) > fresh_msg.get(aid, 0.0) + 2:
            return rec("archive-agent", aid, False, "changed since the plan (status, card, new message): skipped")
        # the whole verdict again: report (BLOCKED/DONE/.done/ack/.done.r*), question, inbound/empty log, re-task in the log
        fresh = {"id": aid, "class": "own-worker", "status": freshrow.get("status"), "slice": (stt.get("labels") or {}).get("slice")}
        verdict(fresh, text, card, None, (opts.reports_dir if opts else None) or [],
                set(filter(None, ((opts.handled if opts else "") or "").split(","))), lstate, *scan_log(log))
        if not (fresh["verdict"] == "done" and fresh["verified_done"]):
            return rec("archive-agent", aid, False, "no longer verified done: " + clean(fresh.get("reason", ""), 100))
        rc, out, err = paseo(["agent", "archive", aid])  # no --force: a running agent is never interrupted
        rec("archive-agent", aid, rc == 0, a["why"] if rc == 0 else clean(err or out, 120))

    for a in archive_agents:
        attempt("archive-agent", a["agent"], lambda a=a: do_archive_agent(a))

    def do_idle_hibernate(a):
        aid = a["agent"]
        if not valid_id(aid):
            return rec("idle-hibernate", clean(aid, 60), False, "malformed id: skipped")
        if aid == lead:
            return rec("idle-hibernate", aid, False, "lead self: skipped")
        wpath = Path(opts.watcher_file) if (opts and getattr(opts, "watcher_file", None)) else None
        watcher_id, watcher_err = load_load_watch_watcher(wpath)
        if watcher_err is not None:
            return rec("idle-hibernate", aid, False, f"standing watcher registry unreadable: {clean(watcher_err, 100)}")
        stt = state_file(aid) or {}
        if (stt.get("labels") or {}).get("ade.lead") not in chain_of(lead):
            return rec("idle-hibernate", aid, False, "not this lead's worker: skipped")
        if aid in claim_holders():
            return rec("idle-hibernate", aid, False, "holds an active claim: skipped")
        freshrow = next((x for x in live_agents() if x["id"] == aid), None)
        permits_now = pending_permissions()
        if not freshrow or freshrow.get("status") not in ("idle", "closed") or permits_now is None or aid in permits_now:
            return rec("idle-hibernate", aid, False, "not idle/closed now, card pending, gone, or permissions unreadable: skipped")
        fresh_meta = {"id": aid, "name": clean(freshrow.get("name") or "", 120), "status": freshrow.get("status"),
                      "class": "own-worker", "slice": (stt.get("labels") or {}).get("slice"), "labels": stt.get("labels") or {}}
        w_why = standing_watcher_reason(fresh_meta, stt, watcher_id)
        if w_why:
            return rec("idle-hibernate", aid, False, f"standing watcher ({w_why}): skipped")
        recs_now = agent_state_files(refresh=True)
        if any(d.get("_bad") for d in recs_now):
            return rec("idle-hibernate", aid, False, "agent records unreadable (cannot rule out live children): skipped")
        if any(not d.get("archivedAt") and isinstance(d.get("labels"), dict) and d["labels"].get(PARENT_LABEL) == aid for d in recs_now):
            return rec("idle-hibernate", aid, False, "has live child agent (archive would cascade): skipped")
        idle_hours = p.get("idle_hours")
        act = iso_epoch(stt.get("lastActivityAt"))
        um = last_user_message(aid)
        if idle_hours is None or act is None or not math.isfinite(um) or um > fresh_msg.get(aid, 0.0) + 2 or (time.time() - max(act, um)) < idle_hours * 3600.0:
            return rec("idle-hibernate", aid, False, "activity changed or below --idle-hours threshold: skipped")
        log = log_tail(aid)
        text, card, lstate = last_text(log)
        retask_log, receipt = scan_log(log)
        handled_set = set(filter(None, ((opts.handled if opts else "") or "").split(",")))
        verdict(fresh_meta, text, card, None, (opts.reports_dir if opts else None) or [], handled_set, lstate, retask_log, receipt)
        if fresh_meta["verdict"] in ("waiting-on-lead", "waiting-on-operator"):
            return rec("idle-hibernate", aid, False, f"now {fresh_meta['verdict']}: skipped")
        safe, pw_code, pw_detail = idle_paid_work_check(fresh_meta, stt, (opts.reports_dir if opts else None) or [], handled_set, log, lstate, retask_log, receipt)
        if not safe:
            return rec("idle-hibernate", aid, False, f"paid-work guard ({pw_code}): {clean(pw_detail, 90)}")
        rc, out, err = paseo(["agent", "archive", aid])  # no --force: a running agent is never interrupted
        rec("idle-hibernate", aid, rc == 0,
            f"archived (idle {a['idle_hours']}h; revive: bin/ade-revive {aid})" if rc == 0 else clean(err or out, 120))

    for a in idle_hibernate:
        attempt("idle-hibernate", a["agent"], lambda a=a: do_idle_hibernate(a))

    def do_archive_window(w):
        wks = w["windowId"]
        if not valid_id(wks):
            return rec("archive-window", clean(wks, 60), False, "malformed id: skipped")
        cur = next((x for x in workspaces() if x["workspaceId"] == wks), None)
        if not cur or is_lead_window(wks, cur.get("name") or "", lead, chain_registry_entries(lead)):
            return rec("archive-window", wks, False, "gone or LEAD: skipped")
        if cur.get("isolation") != "local":
            return rec("archive-window", wks, False, "not a local window: archiving would delete its worktree")
        if not window_is_ours(wks, cur.get("name") or "", lead):
            return rec("archive-window", wks, False, "not provably this lead's: skipped")
        if terminals_in_safe(wks):
            return rec("archive-window", wks, False, "has a terminal (or they could not be listed): skipped")
        live = {x["id"] for x in live_agents()}
        if any(not WKS_RE.fullmatch(str((state_file(i) or {}).get("workspaceId", ""))) for i in live):
            return rec("archive-window", wks, False, "a live agent has no known window: skipped")
        occupants = occupants_of(wks, live, refresh=True)  # last read before the archive: the daemon archives everything in the window
        if occupants:
            return rec("archive-window", wks, False, f"{len(occupants)} agent(s) still in it: skipped")
        rc, out, err = paseo(["workspace", "archive", wks])
        rec("archive-window", wks, rc == 0, "" if rc == 0 else clean(err or out, 120))
        if rc == 0:
            for x in chain_of(lead):  # the window may be recorded under a replaced lead, as ade-worker-run archive-window handles
                unregister_window(x, wks)

    for w in p["archive_windows"] if p.get("permits_ok") else []:
        attempt("archive-window", w["windowId"], lambda w=w: do_archive_window(w))
    return results


# ----------------------------------------------------------------------------------------------- helper prune

# Machine-wide prune of finished Baton "[Handoff writer]" helpers (2026-11-14). Baton (frdminc/paseo-baton, server/controller.ts
# spawnHandoffWriter) creates one writer agent per idle parent at its context threshold, titled `[Handoff writer]`, labelled
# `baton-writer=1` and `paseo.parent-agent-id=<parent>`, in the parent's workspace; it keeps the writer idle so its prompt can be
# read, and only Paseo's cascade (the parent's archive) or the next handoff of the same parent removes it. 83 of them filled swap.
HELPER_TITLE = "[Handoff writer]"
BATON_LABEL = "baton-writer"
PARENT_LABEL = "paseo.parent-agent-id"
PRUNE_MIN_IDLE = 300  # seconds an idle helper must have been quiet: Baton reads the writer's reply and usage after it goes idle
ARCHIVE_TIMEOUT = 30
ORPHAN_GRACE = 1800  # seconds an orphan's agent must have been archived AND quiet before its process is actionable
MAX_KILLS = 10       # provider processes signalled per run (their graft children ride along); the rest wait for the next run
# absolute: a `ps` earlier on PATH must not decide which pids are signalled. The test stand-in `ADE_HELPER_PRUNE_PS` is honoured only
# with `ADE_HELPER_PRUNE_TEST=1` also set, so a stray variable in a job's environment cannot choose the process table.
PS_BIN = (os.environ.get("ADE_HELPER_PRUNE_PS") if os.environ.get("ADE_HELPER_PRUNE_TEST") == "1" else None) or "/bin/ps"


def prune_log_path() -> Path:
    return Path(os.environ.get("ADE_HELPER_PRUNE_LOG") or Path.home() / ".local/state/ade/helper-prune.log")


def prune_lock_path() -> Path:
    return prune_log_path().with_name("helper-prune.lock")


def exclude_path() -> Path:
    return Path(os.environ.get("ADE_HELPER_PRUNE_EXCLUDE") or Path.home() / ".local/state/ade/helper-prune.exclude")


def load_excludes(cli: list[str] | tuple = ()) -> set[str]:
    """Agent ids prune never touches: `--exclude ID` plus the exclude file (one full uuid per line, `#` comments), read afresh on
    every call. A missing file is empty; an unreadable file or a line that is not a full agent id refuses the run (fail
    closed: a typo must not silently unprotect an agent)."""
    ids = {i.lower() for i in cli}
    p = exclude_path()
    try:
        text = p.read_text()
    except FileNotFoundError:
        return ids
    except (OSError, UnicodeDecodeError) as e:
        raise ExcludeRefused(f"cannot read {p}: {clean(str(e), 120)}")
    for n, line in enumerate(text.splitlines(), 1):
        line = line.split("#", 1)[0].strip().lower()
        if not line:
            continue
        if not UUID_RE.fullmatch(line):
            raise ExcludeRefused(f"{p}:{n}: not a full agent id")
        ids.add(line)
    return ids


def log_archive(entry: dict) -> None:
    """One JSON line per archive attempt, appended with one O_APPEND write (a line under PIPE_BUF is never interleaved)."""
    p = prune_log_path()
    p.parent.mkdir(parents=True, exist_ok=True)
    line = (json.dumps(entry, sort_keys=True) + "\n").encode()
    fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    try:
        os.write(fd, line)
    finally:
        os.close(fd)


def log_writable() -> str | None:
    """Create or touch the log before the first action: None when it can be appended to, else why not."""
    try:
        p = prune_log_path()
        p.parent.mkdir(parents=True, exist_ok=True)
        os.close(os.open(p, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600))
    except OSError as e:
        return clean(str(e), 120)
    return None


def log_action(summary: dict, entry: dict) -> None:
    """log_archive for an action already taken: a write failure is an `errors` entry (once), never a traceback that aborts the
    remaining actions."""
    try:
        log_archive(entry)
    except OSError as e:
        if not any(x.get("what", "").startswith("log write failed") for x in summary["errors"]):
            summary["errors"].append({"id": "", "what": f"log write failed, actions continue unlogged: {clean(str(e), 100)}"})


def iso_epoch(v) -> float | None:
    """Epoch seconds of a UTC ISO string (`...Z`), None when absent or unparsable."""
    if not isinstance(v, str) or not v:
        return None
    try:
        return datetime.fromisoformat(v.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def baton_entries() -> dict | None:
    """Baton's own state (`plugin-data/baton/baton-state.json`, keyed by the parent agent id); None when unreadable."""
    try:
        d = json.loads((paseo_home() / "plugin-data/baton/baton-state.json").read_text())
    except (OSError, ValueError):
        return None
    return d if isinstance(d, dict) else None


def handoff_unproven(parent: str, created: float | None, baton: dict | None) -> str | None:
    """None when the parent's handoff is provably written by THIS helper's round, else why not: a Baton entry for the
    parent with status done, an absolute `path` naming a non-empty regular file, and `savedAt` no earlier than the
    helper's creation (an older round's file proves nothing about this helper)."""
    e = baton.get(parent) if isinstance(baton, dict) else None
    if not isinstance(e, dict):
        return "no Baton entry for the parent" if baton is not None else "Baton state unreadable"
    if e.get("status") != "done":
        return f"Baton entry status {clean(e.get('status'), 20)}"
    path, saved = e.get("path"), e.get("savedAt")
    if not isinstance(path, str) or not os.path.isabs(path):
        return "Baton entry has no absolute handoff path"
    try:
        st = os.stat(path)
    except OSError:
        return "handoff file missing"
    if not stat.S_ISREG(st.st_mode) or st.st_size == 0:
        return "handoff file is empty or not a regular file"
    if created is None or not isinstance(saved, (int, float)) or isinstance(saved, bool) or not math.isfinite(saved) or saved / 1000 < created - 1:
        return "handoff predates this helper"
    return None


def prune_plan(min_idle: float, now: float, exclude_cli: list[str] | tuple = ()) -> dict:
    """Read the whole machine and decide, per helper, archive or skip with a reason code. Only Baton helpers are rows:
    an agent is one only when its title starts `[Handoff writer]` AND it carries the label `baton-writer=1` (a title alone
    or a label alone is skipped, reported, never archived)."""
    live = live_agents()
    permits = pending_permissions()
    recs = {d["id"]: d for d in agent_state_files(refresh=True) if isinstance(d.get("id"), str)}
    unreadable_records = any(d.get("_bad") for d in agent_state_files())
    live_by_id = {a["id"]: a for a in live}
    lead_ids = {d["labels"]["ade.lead"] for d in recs.values()
                if isinstance(d.get("labels"), dict) and isinstance(d["labels"].get("ade.lead"), str) and d["labels"]["ade.lead"]}
    baton = baton_entries()
    excludes = load_excludes(exclude_cli)
    me = os.environ.get("PASEO_AGENT_ID", "")
    # Paseo cascades an archive to the agents labelled with this one as their parent: never archive a helper that has a live child.
    with_children = {d["labels"][PARENT_LABEL] for d in recs.values() if not d.get("archivedAt") and isinstance(d.get("labels"), dict)
                     and isinstance(d["labels"].get(PARENT_LABEL), str)}
    selected: list[dict] = []
    skipped: list[dict] = []
    errors: list[dict] = []
    if permits is None:
        errors.append({"id": "", "what": "permission list unreadable: no helper is selected"})
    n_bad = sum(1 for d in agent_state_files() if d.get("_bad"))
    if n_bad:
        errors.append({"id": "", "what": f"{n_bad} agent record(s) unreadable: helpers are not archived and orphans are deferred until it is fixed"})
    helpers = 0
    for a in live:
        aid = a["id"]
        title = str(a.get("name") or "").startswith(HELPER_TITLE)
        rec = recs.get(aid)
        labels = rec.get("labels") if isinstance(rec, dict) and isinstance(rec.get("labels"), dict) else {}
        tagged = labels.get(BATON_LABEL) == "1"
        if not title and not tagged:
            continue  # not a helper: never touched, never listed
        helpers += 1
        parent = labels.get(PARENT_LABEL)
        row = {"id": aid, "parent": parent if isinstance(parent, str) else None, "status": clean(a.get("status"), 20),
               "workspace": (rec or {}).get("workspaceId")}

        def skip(code: str, detail: str = ""):
            skipped.append({**row, "reason": code, "detail": detail})

        if aid in excludes:
            skip("excluded", "listed in the exclude file or --exclude")
        elif not title:
            skip("title-mismatch", clean(a.get("name") or "", 60))
        elif not tagged:
            skip("no-baton-label", "no state record" if rec is None else "title only, no baton-writer=1 label")
        elif aid == me:
            skip("self", "never a lifecycle verb on the caller's own id")
        elif aid in lead_ids:
            skip("main-kind", "named as the lead of other agents (ade.lead)")
        elif not (isinstance(parent, str) and UUID_RE.fullmatch(parent)):
            skip("no-parent", "no valid paseo.parent-agent-id label")
        elif a.get("status") != "idle":
            skip("not-idle", clean(a.get("status"), 20))
        elif permits is None:
            skip("permits-unreadable")
        elif aid in permits:
            skip("permission-pending", permits[aid])
        elif (act := iso_epoch(rec.get("lastActivityAt"))) is None:
            skip("activity-unreadable")
        elif now - act < min_idle:
            skip("recently-active", f"{int(now - act)}s < {int(min_idle)}s")
        elif aid in with_children:
            skip("has-children", "an unarchived agent names this helper as its paseo.parent-agent-id: archiving would cascade to it")
        elif unreadable_records:
            skip("children-unproven", "an agent record could not be read, so a child cannot be ruled out")
        else:
            prec = recs.get(parent)
            lp = live_by_id.get(parent)
            if lp is not None and lp.get("status") == "closed":
                done = "parent-closed"
            elif prec is not None and prec.get("archivedAt"):
                done = "parent-archived"
            elif lp is None and prec is None and not unreadable_records and recs:
                done = "parent-gone"
            elif lp is None and prec is None:
                skip("parent-unproven", "parent absent from the list and the records could not be fully read")
                continue
            else:
                why = handoff_unproven(parent, iso_epoch(rec.get("createdAt")), baton)
                if why is not None:
                    skip("handoff-unproven", why)
                    continue
                done = "handoff-written"
            selected.append({**row, "reason": done, "idle_s": int(now - act)})
    return {"agents_seen": len(live), "helpers": helpers, "selected": selected, "skipped": skipped, "errors": errors, "records_unreadable": n_bad}


# Orphan provider processes (round 2, 2026-11-14): Paseo can leave a provider process (and its `graft mcp` child) running after the
# agent was archived and closed. Mapping is by session id only: the agent record's sessionId (runtimeInfo / persistence) against
# `--resume=<session>` / `--session-id <session>` in the process argv; the record carries no pid. Anything not provable is listed as
# `unmapped` and never acted on.
PS_COLS = "pid=,ppid=,lstart=,rss=,command="
PS_RE = re.compile(r"^\s*(\d+)\s+(\d+)\s+([A-Z][a-z]{2}\s+[A-Z][a-z]{2}\s+\d{1,2}\s+\d\d:\d\d:\d\d\s+\d{4})\s+(\d+)\s+(\S.*?)\s*$")
SESSION_RE = re.compile(r"(?:^|\s)--(?:resume|session-id)(?:=|\s+)([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})(?:\s|$)")


def _ps_bin() -> str:
    if os.environ.get("ADE_TIDY_TEST") == "1" and os.environ.get("ADE_TIDY_PS"):
        return os.environ["ADE_TIDY_PS"]
    if os.path.exists(PS_BIN):
        return PS_BIN
    return "/usr/bin/ps" if PS_BIN == "/bin/ps" and os.path.exists("/usr/bin/ps") else PS_BIN


def ps_rows(pid: int | None = None) -> list[dict]:
    """The process table (or one pid) as dicts: pid, ppid, lstart (as printed), rss_kb, command. Argv list, C locale; a line
    that does not parse is dropped, never guessed at. An empty answer for `-p PID` (rc 1 from ps) is a dead pid, not an error."""
    ps_exec = _ps_bin()
    argv = [ps_exec, "-ax", "-o", PS_COLS] if pid is None else [ps_exec, "-o", PS_COLS, "-p", str(pid)]
    try:
        r = subprocess.run(argv, capture_output=True, text=True, timeout=30, stdin=subprocess.DEVNULL,
                           env={**os.environ, "LC_ALL": "C", "LANG": "C"})
    except (OSError, subprocess.TimeoutExpired) as e:
        raise Refused(f"ps failed: {clean(str(e), 100)}")
    if r.returncode != 0 and pid is None:
        raise Refused(f"ps failed (rc {r.returncode})")
    rows = []
    for line in r.stdout.splitlines():
        m = PS_RE.match(line)
        if m:
            rows.append({"pid": int(m[1]), "ppid": int(m[2]), "lstart": " ".join(m[3].split()), "rss_kb": int(m[4]), "command": m[5]})
    return rows


CALLER_RE = re.compile(r"callerAgentId=([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})")


def argv_tokens(cmd: str) -> list[str] | None:
    """`ps` prints argv joined by spaces. Split it on whitespace, but keep a JSON object or array (a token that starts with `{`
    or `[`, or `--flag={`) whole, so text inside an argument's JSON value is never read as a flag. Unbalanced brackets: None."""
    toks, i, n = [], 0, len(cmd)
    while i < n:
        if cmd[i].isspace():
            i += 1
            continue
        j = i
        while j < n and not cmd[j].isspace():
            if cmd[j] in "{[" and (j == i or cmd[j - 1] == "="):
                depth, instr, esc = 0, False, False
                while j < n:
                    ch = cmd[j]
                    j += 1
                    if instr:
                        if esc:
                            esc = False
                        elif ch == "\\":
                            esc = True
                        elif ch == '"':
                            instr = False
                    elif ch == '"':
                        instr, esc = True, False
                    elif ch in "{[":
                        depth += 1
                    elif ch in "}]":
                        depth -= 1
                        if depth == 0:
                            break
                else:
                    return None
            else:
                j += 1
        toks.append(cmd[i:j])
        i = j
    return toks


def provider_session(row: dict) -> str | None:
    """The session id of a `claude` provider process, taken only from a real `--resume`/`--session-id` argument (never a substring
    inside another argument's value, such as a `--settings` JSON) and only when exactly one such flag is present anywhere."""
    words = row["command"].split()
    toks = argv_tokens(row["command"])
    if not words or os.path.basename(words[0]) != "claude" or not toks:
        return None
    found = []
    for i, t in enumerate(toks[1:], 1):
        m = re.fullmatch(r"--(?:resume|session-id)=(" + UUID_RE.pattern + ")", t)
        if m:
            found.append(m[1])
        elif t in ("--resume", "--session-id") and i + 1 < len(toks) and UUID_RE.fullmatch(toks[i + 1]):
            found.append(toks[i + 1])
    return found[0] if len(found) == 1 and len(SESSION_RE.findall(row["command"])) == 1 else None


def provider_callers(row: dict) -> list[str]:
    """The `callerAgentId=<uuid>` values in the provider's `--mcp-config` argument: only the uuid is kept (that argument carries a
    Bearer token, which is never stored, logged or printed). A `callerAgentId=` anywhere else in argv adds an empty entry, so the
    caller is then not exactly one id."""
    toks = argv_tokens(row["command"]) or []
    out: list[str] = []
    for i, t in enumerate(toks):
        if t == "--mcp-config" and i + 1 < len(toks):
            out += CALLER_RE.findall(toks[i + 1])
        elif t.startswith("--mcp-config="):
            out += CALLER_RE.findall(t)
    if row["command"].count("callerAgentId=") != len(out):
        out.append("")
    return out


def paseo_pid() -> int | None:
    """The Paseo supervisor's pid from `$PASEO_HOME/paseo.pid` (JSON with `pid`), or None."""
    try:
        v = json.loads((paseo_home() / "paseo.pid").read_text()).get("pid")
    except (OSError, ValueError, AttributeError):
        return None
    return v if isinstance(v, int) and v > 1 else None


def is_daemon_row(r: dict, sup: int | None) -> bool:
    """The Paseo daemon, found structurally: a process titled exactly `Paseo Daemon` that is the supervisor named in paseo.pid or
    is that supervisor's direct child. Any other process with that title (a dev daemon under another home) is not it."""
    return sup is not None and r["command"].split() == ["Paseo", "Daemon"] and sup in (r["pid"], r["ppid"])


def daemon_pids(rows: list[dict]) -> set[int]:
    sup = paseo_pid()
    return {r["pid"] for r in rows if is_daemon_row(r, sup)}


def is_daemon_pid(pid: int) -> bool:
    return any(r["pid"] == pid and is_daemon_row(r, paseo_pid()) for r in ps_rows(pid))


def is_graft_mcp(row: dict) -> bool:
    """argv is exactly `graft mcp`, with or without a leading `node` and a path on graft."""
    words = row["command"].split()
    if words and os.path.basename(words[0]) == "node":
        words = words[1:]
    return len(words) == 2 and os.path.basename(words[0]) == "graft" and words[1] == "mcp"


def record_sessions(rec: dict) -> set[str]:
    out = set()
    for blk, keys in (("runtimeInfo", ("sessionId",)), ("persistence", ("sessionId", "nativeHandle"))):
        d = rec.get(blk)
        if isinstance(d, dict):
            out |= {d[k] for k in keys if isinstance(d.get(k), str) and UUID_RE.fullmatch(d[k])}
    return out


def own_tree(rows: list[dict]) -> set[int]:
    """This process, its ancestors and the descendants of this process alone (never a sibling of an ancestor: the Paseo
    daemon is an ancestor and parents every other agent): never a kill target."""
    by = {r["pid"]: r for r in rows}
    tree, pid = {os.getpid()}, os.getpid()
    while pid in by and by[pid]["ppid"] > 1 and by[pid]["ppid"] not in tree:
        pid = by[pid]["ppid"]
        tree.add(pid)
    down = {os.getpid()}
    grew = True
    while grew:
        kids = {r["pid"] for r in rows if r["ppid"] in down and r["pid"] not in down}
        grew = bool(kids)
        down |= kids
    return tree | down


def helper_quiet(aid: str, min_idle: float, now: float) -> bool:
    """The helper's record, read again right before its archive: last activity at least `min_idle` ago. Unreadable, missing or in
    the future: not quiet (fail closed)."""
    rec = state_file(aid)
    act = iso_epoch(rec.get("lastActivityAt")) if isinstance(rec, dict) else None
    return act is not None and now - act >= min_idle   # a future time is a negative age: not quiet (min_idle is never negative)


def helper_still_idle(aid: str) -> bool:
    """`paseo agent inspect ID --json` right before an archive: not archived, status idle, no pending permission."""
    try:
        d = paseo_json(["agent", "inspect", aid, "--json"])
    except Refused:
        return False
    return isinstance(d, dict) and d.get("Archived") is False and d.get("Status") == "idle" and d.get("PendingPermissions") == []


def agent_archived_closed(aid: str) -> bool:
    """`paseo agent inspect ID --json` says Archived=true and Status=closed (the authority; the record is the first filter)."""
    try:
        d = paseo_json(["agent", "inspect", aid, "--json"])
    except Refused:
        return False
    return isinstance(d, dict) and d.get("Archived") is True and d.get("Status") == "closed"


def orphan_plan(excludes: set[str], now: float | None = None, grace: float = ORPHAN_GRACE, max_kills: int = MAX_KILLS) -> dict:
    """Provider processes whose agent record says archived AND closed (inspect agrees). Only a provable session mapping counts:
    a session with no record or with more than one is `unmapped`. A live agent's process is only counted."""
    rows = ps_rows()
    recs = [d for d in agent_state_files(refresh=True) if isinstance(d.get("id"), str)]   # never the records cached by an earlier plan
    by_id = {d["id"]: d for d in recs}
    sessions: dict[str, set[str]] = {}
    for d in recs:
        for sid in record_sessions(d):
            sessions.setdefault(sid, set()).add(d["id"])
    kids: dict[int, list[dict]] = {}
    for r in rows:
        kids.setdefault(r["ppid"], []).append(r)
    mine, me = own_tree(rows), os.environ.get("PASEO_AGENT_ID", "")
    daemons = daemon_pids(rows)
    unreadable = sum(1 for d in agent_state_files() if d.get("_bad"))   # same cached read as `recs` above
    out = {"orphans": [], "orphan_skipped": [], "unmapped": [], "provider_live": 0, "deferred": [], "kill_plan": {}}
    for r in rows:
        sid = provider_session(r)
        if sid is None:
            continue
        base = {"pid": r["pid"], "ppid": r["ppid"], "started": r["lstart"], "rss_kb": r["rss_kb"], "session": sid}
        owners = sessions.get(sid, set())
        if "--input-format stream-json" not in r["command"]:   # Paseo launches providers with stream-json: a terminal `claude --resume` is not ours
            out["unmapped"].append({**base, "reason": "not-paseo-launched"})
        elif len(owners) != 1:
            out["unmapped"].append({**base, "reason": "no-agent-record" if not owners else "ambiguous-session"})
        elif r["ppid"] not in daemons:   # an Agent-SDK host also runs `claude --input-format stream-json --resume`: only the Paseo daemon's children are ours
            out["unmapped"].append({**base, "reason": "not-paseo-parent"})
        else:
            aid, callers = next(iter(owners)), provider_callers(r)
            if not callers:
                out["unmapped"].append({**base, "reason": "no-caller"})
            elif callers != [aid]:
                out["unmapped"].append({**base, "reason": "caller-mismatch"})
            else:
                orphan_one(out, r, base, aid, by_id[aid], kids, mine, me, excludes)
    return kill_budget(out, by_id, time.time() if now is None else now, grace, max_kills, unreadable)


def kill_budget(out: dict, by_id: dict, now: float, grace: float, max_kills: int, unreadable: int = 0) -> dict:
    """Split the orphans into this run's kill plan and the deferred rest. An orphan is actionable only when its agent was
    archived at least `grace` seconds ago (last activity when `archivedAt` does not parse) AND the agent record shows no activity
    newer than `grace` (unparsable: fail closed); younger ones are `grace`. At most `max_kills` provider processes are
    actionable per run, lowest pid first; the rest are `kill-cap` and are picked up by a later run."""
    actionable, deferred = [], []
    for o in sorted(out["orphans"], key=lambda x: x["pid"]):
        rec = by_id[o["agent"]]
        if unreadable:   # an unreadable record could be the live owner of this session: defer every orphan
            deferred.append({**o, "reason": "records-unreadable", "detail": f"{unreadable} agent record(s) could not be read"})
            continue
        arch, act = iso_epoch(rec.get("archivedAt")), iso_epoch(rec.get("lastActivityAt"))
        ref = arch if arch is not None else act
        if ref is None or act is None:
            deferred.append({**o, "reason": "grace", "detail": "archive or activity time unreadable"})
        elif now - ref < grace or now - act < grace:
            deferred.append({**o, "reason": "grace", "detail": f"archived {int(now - ref)}s ago, last activity {int(now - act)}s ago, grace {int(grace)}s"})
        else:
            actionable.append(o)
    capped = actionable[max(0, max_kills):]
    deferred += [{**o, "reason": "kill-cap", "detail": f"over --max-kills {max_kills}"} for o in capped]
    out["kill_plan"] = {"found": len(out["orphans"]), "actionable": len(actionable) - len(capped), "deferred_grace": sum(d["reason"] == "grace" for d in deferred),
                        "deferred_unreadable": sum(d["reason"] == "records-unreadable" for d in deferred), "records_unreadable": unreadable,
                        "deferred_cap": len(capped), "max_kills": max_kills, "orphan_grace_s": int(grace)}
    out["orphans"] = actionable[:max(0, max_kills)]
    out["deferred"] = deferred
    return out


def orphan_one(out: dict, r: dict, base: dict, aid: str, rec: dict, kids: dict, mine: set, me: str, excludes: set) -> None:
    """Classify one provider process whose session maps to exactly one agent record."""
    if not rec.get("archivedAt"):
        out["provider_live"] += 1   # a live agent's process: counted, never listed, never touched
        return
    row = {**base, "agent": aid}
    if aid in excludes:
        out["orphan_skipped"].append({**row, "reason": "excluded"})
    elif aid == me:
        out["orphan_skipped"].append({**row, "reason": "self"})
    elif r["pid"] <= 1 or r["pid"] in mine:
        out["orphan_skipped"].append({**row, "reason": "own-tree"})
    elif rec.get("lastStatus") != "closed" or not agent_archived_closed(aid):
        out["orphan_skipped"].append({**row, "reason": "not-closed"})
    else:
        cs = sorted(kids.get(r["pid"], []), key=lambda c: c["pid"])
        row["children"] = [{"pid": c["pid"], "ppid": c["ppid"], "started": c["lstart"], "rss_kb": c["rss_kb"]}
                           for c in cs if is_graft_mcp(c) and c["pid"] not in mine]
        row["other_children"] = [{"pid": c["pid"], "command": clean(os.path.basename((c["command"].split() or [""])[0]), 60)} for c in cs if not is_graft_mcp(c)]   # basename only: argv can hold a token
        out["orphans"].append(row)


def kill_guarded(pid: int, ppid: int, started: str, session: str | None, agent: str, rss_kb: int, role: str, signal_it: bool = True) -> dict:
    """SIGTERM one pid after re-reading it: same pid, same start time, and (provider) same session id, Paseo-daemon parent and
    caller or (child) same parent and still `graft mcp`. Returns the log entry; a pid that no longer matches is not signalled
    (rc None, `skipped`). `signal_it=False` runs the checks only (rc stays None, no `skipped` when they pass)."""
    entry = {"kind": "process-kill", "ts": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"), "pid": pid, "ppid": ppid,
             "agent": agent, "session": session, "rss_kb": rss_kb, "role": role, "rc": None}
    now = [r for r in ps_rows(pid) if r["pid"] == pid]
    if pid <= 1 or not now:
        entry["skipped"] = "gone"
    elif now[0]["lstart"] != started:
        entry["skipped"] = "start-time-changed"
    elif role == "provider" and provider_session(now[0]) != session:
        entry["skipped"] = "session-changed"
    elif role == "provider" and (now[0]["ppid"] != ppid or not is_daemon_pid(ppid)):
        entry["skipped"] = "not-paseo-parent"
    elif role == "provider" and provider_callers(now[0]) != [agent]:
        entry["skipped"] = "caller-changed"
    elif role == "graft-child" and (now[0]["ppid"] != ppid or not is_graft_mcp(now[0])):
        entry["skipped"] = "not-the-same-child"
    elif signal_it:
        try:
            os.kill(pid, signal.SIGTERM)
            entry["rc"] = 0
        except OSError as e:
            entry["rc"] = e.errno or -1
            entry["error"] = clean(str(e), 100)
    return entry


def prune(apply_: bool, min_idle: float = PRUNE_MIN_IDLE, exclude_cli: list[str] | tuple = (), max_kills: int = MAX_KILLS,
          grace: float = ORPHAN_GRACE) -> dict:
    """Observe (default) or act. Apply takes a lock, plans, then re-reads the whole machine right before acting and acts
    only on what both plans selected. A helper archive is `paseo agent archive ID` (argv list, rc checked, timeout); an
    orphan process gets SIGTERM by pid (os.kill) after a pid/start-time/session re-read. One log line per action."""
    summary = {"mode": "apply" if apply_ else "observe", "at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
               "min_idle_s": int(min_idle), "archived": [], "locked": False, "orphans": [], "orphan_skipped": [], "unmapped": [],
               "killed": [], "provider_live": 0, "deferred": [], "kill_plan": {"max_kills": max_kills, "orphan_grace_s": int(grace)}}
    lock = None
    try:
        if apply_:
            try:
                lock = flock_timeout(prune_lock_path(), 5)
            except (Refused, OSError) as e:
                held = isinstance(e, Refused)   # another run holds it; an OSError is a lock file that cannot be opened (an error, exit 1)
                summary.update(locked=held, selected=[], skipped=[], agents_seen=0, helpers=0, records_unreadable=0,
                               errors=[] if held else [{"id": "", "what": f"lock not available, nothing done: {clean(str(e), 120)}"}])
                summary["counts"] = {k: 0 for k in COUNT_KEYS}
                summary["counts"]["errors"] = len(summary["errors"])
                return summary
        first = prune_plan(min_idle, time.time(), exclude_cli)
        summary.update({k: first[k] for k in ("agents_seen", "helpers", "selected", "skipped", "errors", "records_unreadable")})
        try:
            orph = orphan_plan(load_excludes(exclude_cli), time.time(), grace, max_kills)
            summary.update({k: orph[k] for k in ("orphans", "orphan_skipped", "unmapped", "provider_live", "deferred", "kill_plan")})
        except ExcludeRefused:
            raise
        except Refused as e:
            orph = None
            summary["errors"].append({"id": "", "what": f"orphan scan skipped: {clean(str(e), 120)}"})
        acting = apply_ and bool(first["selected"] or (orph is not None and orph["orphans"]))
        if acting and (why := log_writable()) is not None:   # the log is opened before the first action: no log, no action
            summary["errors"].append({"id": "", "what": f"log not writable, nothing done: {why}"})
            first["selected"] = []
            if orph is not None:
                orph["orphans"] = []
        if apply_ and first["selected"]:
            again = {r["id"] for r in prune_plan(min_idle, time.time(), exclude_cli)["selected"]}  # re-read right before acting
            for row in first["selected"]:
                if row["id"] not in again:
                    summary["skipped"].append({**row, "reason": "changed-before-archive", "detail": "no longer selected on the re-read"})
                    continue
                try:
                    protected = row["id"] in load_excludes(exclude_cli)   # the list is re-read once more, right before each archive
                except ExcludeRefused as e:
                    summary["errors"].append({"id": row["id"], "what": f"exclude list unreadable, no further archive: {clean(str(e), 120)}"})
                    break
                if protected:
                    summary["skipped"].append({**row, "reason": "excluded", "detail": "added to the exclude list before the archive"})
                    continue
                if not helper_quiet(row["id"], min_idle, time.time()):   # a helper that ran another turn during an earlier archive in this loop
                    summary["skipped"].append({**row, "reason": "recently-active", "detail": "activity newer than --min-idle on the re-read before the archive"})
                    continue
                if not helper_still_idle(row["id"]):   # status and permissions re-read right before this archive
                    summary["skipped"].append({**row, "reason": "changed-before-archive", "detail": "not idle, not archived or a permission is pending on the last read"})
                    continue
                entry = {"kind": "helper-archive", "ts": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
                         "helper": row["id"], "parent": row["parent"], "reason": row["reason"]}
                try:
                    rc, out, err = paseo(["agent", "archive", row["id"]], timeout=ARCHIVE_TIMEOUT)
                except Refused as e:
                    rc, err = -1, str(e)
                entry["rc"] = rc
                if rc != 0:
                    entry["error"] = clean(err, 160)
                    summary["errors"].append({"id": row["id"], "what": f"archive failed (rc {rc}): {clean(err, 120)}"})
                else:
                    summary["archived"].append(row)
                log_action(summary, entry)
        if apply_ and orph is not None and orph["orphans"]:
            kill_orphans(summary, orph["orphans"], exclude_cli, max_kills, grace)
    finally:
        if lock is not None:
            lock.close()
    summary["counts"] = {"agents_seen": summary["agents_seen"], "helpers": summary["helpers"], "selected": len(summary["selected"]),
                         "archived": len(summary["archived"]), "skipped": len(summary["skipped"]), "errors": len(summary["errors"]),
                         "orphans": len(summary["orphans"]), "orphan_skipped": len(summary["orphan_skipped"]),
                         "unmapped": len(summary["unmapped"]), "killed": len(summary["killed"]), "deferred": len(summary["deferred"]),
                         "records_unreadable": summary["records_unreadable"]}
    return summary


COUNT_KEYS = ("agents_seen", "helpers", "selected", "archived", "skipped", "errors", "orphans", "orphan_skipped", "unmapped", "killed", "deferred", "records_unreadable")


def kill_orphans(summary: dict, planned: list[dict], exclude_cli, max_kills: int = MAX_KILLS, grace: float = ORPHAN_GRACE) -> None:
    """Apply step for orphans: a fresh plan right before acting, then per orphan the exclusion list, inspect and a guarded
    SIGTERM, children (direct `graft mcp` only) before the provider so the parent check still holds."""
    try:
        fresh = {(o["pid"], o["started"], o["session"]) for o in orphan_plan(load_excludes(exclude_cli), time.time(), grace, max_kills)["orphans"]}
    except Refused as e:
        summary["errors"].append({"id": "", "what": f"orphan re-read failed, nothing killed: {clean(str(e), 120)}"})
        return
    for o in planned:
        try:
            protected = o["agent"] in load_excludes(exclude_cli)
        except ExcludeRefused as e:   # fail closed without a traceback: nothing further is killed
            summary["errors"].append({"id": o["agent"], "what": f"exclude list unreadable, no further kill: {clean(str(e), 120)}"})
            return
        if (o["pid"], o["started"], o["session"]) not in fresh or protected or not agent_archived_closed(o["agent"]):
            summary["orphan_skipped"].append({**o, "reason": "changed-before-kill"})
            continue
        try:   # the provider's own checks come first: if they fail, its graft children are left alone too
            pre = kill_guarded(o["pid"], o["ppid"], o["started"], o["session"], o["agent"], o["rss_kb"], "provider", signal_it=False)
        except Refused as e:
            summary["errors"].append({"id": o["agent"], "what": f"re-read of pid {o['pid']} failed: {clean(str(e), 100)}"})
            continue
        if pre.get("skipped"):
            log_action(summary, pre)
            summary["orphan_skipped"].append({**o, "reason": "changed-before-kill", "detail": f"provider re-check: {pre['skipped']}"})
            continue
        targets = [(c["pid"], c["ppid"], c["started"], None, c["rss_kb"], "graft-child") for c in o["children"]]
        targets.append((o["pid"], o["ppid"], o["started"], o["session"], o["rss_kb"], "provider"))
        for pid, ppid, started, sess, rss, role in targets:
            try:
                entry = kill_guarded(pid, ppid, started, sess, o["agent"], rss, role)
            except Refused as e:
                summary["errors"].append({"id": o["agent"], "what": f"re-read of pid {pid} failed: {clean(str(e), 100)}"})
                continue
            if entry["session"] is None:
                entry["session"] = o["session"]
            log_action(summary, entry)
            if entry["rc"] == 0:
                summary["killed"].append({k: entry[k] for k in ("pid", "ppid", "agent", "session", "rss_kb", "role")})
            elif entry["rc"] is not None:
                summary["errors"].append({"id": o["agent"], "what": f"kill {pid} failed: {entry.get('error', entry['rc'])}"})


def render_prune(s: dict) -> str:
    """Human output. Every value that came from an agent label, title or record goes through clean() (control characters, an
    escape sequence in a `paseo.parent-agent-id` label included, become spaces)."""
    c, short = s["counts"], (lambda v, n=8: clean(str(v)[:n], n))
    kp = s.get("kill_plan") or {}
    out = [f"helper-prune ({s['mode']}, {s['at']}): {c['helpers']} helpers of {c['agents_seen']} agents; selected {c['selected']}, "
           f"archived {c['archived']}, skipped {c['skipped']}, errors {c['errors']}; orphan processes found {kp.get('found', 0)}: "
           f"actionable {c['orphans']} (killed {c['killed']}), deferred {c['deferred']} (grace {kp.get('deferred_grace', 0)}, kill-cap "
           f"{kp.get('deferred_cap', 0)}; max {kp.get('max_kills')}, grace {kp.get('orphan_grace_s')}s), skipped {c['orphan_skipped']}, "
           f"unmapped {c['unmapped']}" + (" (another prune holds the lock)" if s["locked"] else "")]
    done = {r["id"] for r in s["archived"]}
    for r in s["selected"]:
        out.append(f" {'archived' if r['id'] in done else 'would archive'} {short(r['id'])} parent {short(r['parent'])} {clean(r['reason'], 40)}")
    for r in s["skipped"]:
        out.append(f" skip {short(r['id'])} parent {short(r['parent'])} {clean(r['reason'], 40)} {clean(r.get('detail', ''), 120)}".rstrip())
    killed = {k["pid"] for k in s["killed"]}
    for o in s["orphans"]:
        out.append(f" orphan pid {o['pid']} agent {short(o['agent'])} {o['rss_kb']} KB " + ("killed" if o["pid"] in killed else "would SIGTERM")
                   + (" with graft mcp child " + ",".join(str(ch['pid']) for ch in o["children"]) if o["children"] else ""))
    out.extend(f" orphan-deferred pid {o['pid']} agent {short(o['agent'])} {clean(o['reason'], 20)} {clean(o.get('detail', ''), 120)}" for o in s["deferred"])
    out.extend(f" orphan-skip pid {o['pid']} agent {short(o['agent'])} {clean(o['reason'], 40)}" for o in s["orphan_skipped"])
    out.extend(f" unmapped pid {u['pid']} session {short(u['session'])} {clean(u['reason'], 40)}" for u in s["unmapped"])
    out.extend(f" ERROR {short(e.get('id', ''))} {clean(e['what'], 160)}" for e in s["errors"])
    return "\n".join(out)


def json_line(s: dict) -> str:
    """One compact line for a scheduled job's log (the per-action detail is in helper-prune.log): counts, kill plan, a few errors."""
    return json.dumps({"mode": s["mode"], "at": s["at"], "locked": s["locked"], "counts": s["counts"], "kill_plan": s.get("kill_plan", {}),
                       "errors": [clean(e["what"], 100) for e in s["errors"][:3]]}, sort_keys=True, separators=(",", ":"))


def nonneg_int(v: str) -> int:
    try:
        n = int(v)
    except ValueError:
        n = -1
    if n < 0:
        raise argparse.ArgumentTypeError("a non-negative integer is required")
    return n


def nonneg_float(v: str) -> float:
    try:
        n = float(v)
    except ValueError:
        n = -1.0
    if not (math.isfinite(n) and n >= 0):
        raise argparse.ArgumentTypeError("a finite non-negative number is required")
    return n


def pos_float(v: str) -> float:
    try:
        n = float(v)
    except ValueError:
        n = -1.0
    if not (math.isfinite(n) and n > 0):
        raise argparse.ArgumentTypeError("a finite positive number is required")
    return n


def full_id(v: str) -> str:
    if not UUID_RE.fullmatch(v.lower()):
        raise argparse.ArgumentTypeError("a full agent id (uuid) is required")
    return v.lower()


def main_prune(argv: list[str]) -> int:
    p = argparse.ArgumentParser(prog="ade-tidy prune", description="archive finished Baton [Handoff writer] helpers and report or stop orphan provider processes of archived agents, machine-wide")
    p.add_argument("--apply", action="store_true", help="act (default: observe only)")
    p.add_argument("--json", action="store_true")
    p.add_argument("--min-idle", type=nonneg_float, default=PRUNE_MIN_IDLE, help="seconds a helper must have been idle (default 300)")
    p.add_argument("--exclude", action="append", default=[], type=full_id, metavar="ID", help="never touch this agent (repeatable; also the exclude file)")
    p.add_argument("--max-kills", type=nonneg_int, default=MAX_KILLS, help="provider processes signalled per run, graft children ride along (default 10); the rest are deferred: kill-cap")
    p.add_argument("--orphan-grace", type=nonneg_float, default=ORPHAN_GRACE, help="seconds an orphan's agent must have been archived and quiet (default 1800); younger: deferred: grace")
    p.add_argument("--json-line", action="store_true", help="one compact JSON line (counts, kill plan, first errors): for a scheduled job's log")
    o = p.parse_args(argv)
    try:
        s = prune(o.apply, o.min_idle, o.exclude, o.max_kills, o.orphan_grace)
    except Refused as e:
        sys.stderr.write(f"ade-tidy: {e}\n")
        return 1
    print(json_line(s) if o.json_line else json.dumps(s, indent=1, sort_keys=True) if o.json else render_prune(s))
    return 1 if s["errors"] else 0


# ----------------------------------------------------------------------------------------------- main

def resolve_lead(arg: str | None) -> str:
    lead = arg or os.environ.get("PASEO_AGENT_ID") or ""
    if not UUID_RE.fullmatch(lead):
        raise Refused("pass --lead with the lead's full agent id (or run inside the lead's session)")
    caller = os.environ.get("PASEO_AGENT_ID")
    if caller and caller != lead and not os.environ.get("ADE_TIDY_ON_BEHALF"):
        raise Refused(f"--lead {lead} is not this agent ({caller}); acting for another lead needs ADE_TIDY_ON_BEHALF=1")
    return lead


def main(argv: list[str]) -> int:
    if argv[:1] == ["prune"]:
        return main_prune(argv[1:])
    if argv[:1] == ["ack"]:
        p = argparse.ArgumentParser(prog="ade-tidy ack")
        p.add_argument("agent")
        p.add_argument("--lead")
        o = p.parse_args(argv[1:])
        try:
            lead = resolve_lead(o.lead)
            ids_ok(o.agent)
            with state_lock(lead):
                st = load_state(lead)
                st["acks"][o.agent] = time.time()
                save_state(lead, st)
        except Refused as e:
            sys.stderr.write(f"ade-tidy: {e}\n")
            return 1
        print(json.dumps({"acked": o.agent, "lead": lead}))
        return 0
    p = argparse.ArgumentParser(prog="ade-tidy", description=__doc__.split("\n\n")[0])
    p.add_argument("--repo")
    p.add_argument("--lead")
    p.add_argument("--apply", action="store_true", help="act on the plan (default: observe only)")
    p.add_argument("--json", action="store_true")
    p.add_argument("--reports-dir", action="append", help="folder with unit-<slice>.md reports (+ .done)")
    p.add_argument("--handled", help="comma-separated agent ids whose completion the lead has handled")
    p.add_argument("--work", action="append", help="KIND=TEXT current-work text for the renamed windows")
    p.add_argument("--idle-hours", type=pos_float, default=None, metavar="HOURS",
                   help="report (and with --apply, archive/hibernate) safe own-chain idle/closed workers older than HOURS (default: off)")
    p.add_argument("--watcher-file", default=None, metavar="PATH",
                   help="load-watch watcher.json path (default: $LW_STATE_DIR/watcher.json)")
    opts = p.parse_args(argv)
    try:
        lead = resolve_lead(opts.lead)
        if opts.apply:
            if not opts.lead:
                raise Refused("--apply needs an explicit --lead (the lead's full agent id)")
            mine = (state_file(os.environ.get("PASEO_AGENT_ID", "")) or {}).get("labels") or {}
            if mine.get("ade.lead") and os.environ.get("PASEO_AGENT_ID") == lead:
                raise Refused("this agent is a worker (label ade.lead): only its lead applies a tidy")
        repo, roots = repo_info(opts.repo)
        lock = lock_for(lead) if opts.apply else None
        try:
            pl = plan(opts, lead, repo, roots)
            print(json.dumps(pl, indent=1) if opts.json else render(pl))
            if not opts.apply:
                return 0
            res = apply(pl, lead, repo, opts)
        finally:
            if lock is not None:
                lock.close()
    except Refused as e:
        sys.stderr.write(f"ade-tidy: {e}\n")
        return 1
    print(json.dumps({"applied": res}, indent=1) if opts.json else "\nApplied:\n" + "\n".join(
        f" {'ok  ' if r['ok'] else 'SKIP'} {r['op']} {r.get('target', '')} {r['why']}" for r in res))
    return 1 if any(r["op"] == "apply" and not r["ok"] for r in res) else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

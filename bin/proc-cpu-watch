#!/usr/bin/env python3
"""proc-cpu-watch: find out what makes a named process tree spike the CPU (2026-10-31 as codexbar-cpu-watch, djbclark).

Targets (`--target`, required on every subcommand): `codexbar` (CodexBar.app and the CodexBarCLI it runs) and
`opencode` (`opencode serve`, added 2026-11-01: "opencode serve seems to be having a CPU issue").

    proc-cpu-watch sample --target T [-v]            one sample (launchd runs it every 300 s); no model, no pings
    proc-cpu-watch report --target T [-n N]          the last N samples (default 24), spikes marked
    proc-cpu-watch install --target T [--ade DIR] [--backend auto|launchd|systemd|cron] [--dry-run] [--allow-no-linger]
                                                     the job com.djbclark.<T>-cpu-watch, written from
                                                     launchd/com.djbclark.proc-cpu-watch.plist by bin/ade_sched.py
                                                     (launchd on the Mac, a systemd user timer every 300 s on Linux;
                                                     docs/scheduling.md)
    proc-cpu-watch uninstall --target T [--backend ...] [--dry-run]

install/uninstall exit codes: 0 done; 1 an activation command failed; 2 bad usage (linked worktree or cow pasture without
--ade, bin/proc-cpu-watch missing from --ade, an unbuildable job); 69 no usable scheduler (none installed or forced off,
systemd user manager unreachable, Linger=no without --allow-no-linger) or the target is macOS-only: `codexbar` (the
CodexBar app) installs on darwin only, `opencode` installs on Linux too. (Before 2026-11-04 a missing launchctl was 2.)

A sample takes two `ps` reads WINDOW_S apart over the target's process tree (every process whose argv[0], the
first whitespace-free token of its command line, matches the target: `.../CodexBar.app/Contents/{MacOS,Helpers}/
CodexBar*`, or an `opencode`/`opencode.exe` executable whose first argument is `serve`; plus all their
descendants, e.g. the probes CodexBar spawns or the commands an opencode session runs) and turns the CPU-time
delta into percent of one core. One JSON line per sample goes to ~/.local/state/<T>-cpu-watch/samples.jsonl:
total_pct, the top processes, and (on a spike, total at or above SPIKE_PCT) up to 15 of them.

Privacy (adversary rounds 1-2, PR 202): a command line can carry a token, so no command line is ever stored. A
process is logged as pid, percent, RSS, a short NAME and its FLAG NAMES. The NAME is the executable's basename;
for node/python/bash-style interpreters it adds the script's basename only when that token ends in a script
suffix (.js .mjs .cjs .ts .py .sh .rb .pl) or comes right after argv[0] and is a path (contains `/`), so an
option's separate value (`node --require sk-X app.js`) or a bare word (`env WORD`, `sh WORD`) is never taken for
the script: then the NAME is the interpreter alone. Every record carries `target`; `report` shows one target's. FLAG NAMES
are `--word` or a single letter with any `=value` cut (`--port`, never `--port 1234` or `--token=x`). Known
limit: a positional VALUE that itself looks like a flag (`--password --hunter2pw`) is logged as a flag name.
Root matching reads argv[0], which a process sets itself (`exec -a`, a copied binary): it attributes, it does
not authenticate; an app path containing a space is not matched (fails closed). The state dir is 0700 and
every file in it 0600.

Limits, all by design: it is a point sample every 5 minutes, so a spike shorter than the gap between samples
can be missed; a process that is born AND exits inside the 3 s window (a probe the target spawns and reaps) is
not seen, so total_pct is a floor; on Linux procps TIME has whole-second resolution, so a 3 s window moves in
33% steps. The log appends one line per sample (O_APPEND, no read of the old content) under an flock that also
covers the rotation to samples.jsonl.1 past CBW_MAX_MB. launchd.out/err are emptied past 1 MB, failed samples included.

Env: CBW_STATE_DIR (this target's state directory; default ~/.local/state/<T>-cpu-watch; `install` passes it to the
job; set it for one target at a time, though a shared one only interleaves records `report` tells apart), CBW_WINDOW_S (default 3), CBW_SPIKE_PCT (default 50), CBW_MAX_MB (default 5).
"""
import argparse
import fcntl
import json
import os
import plistlib
import re
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

HOME = Path.home()
ADE = Path(__file__).resolve().parent.parent
PLIST = ADE / "launchd" / "com.djbclark.proc-cpu-watch.plist"
WINDOW_S = float(os.environ.get("CBW_WINDOW_S", "3"))
SPIKE_PCT = float(os.environ.get("CBW_SPIKE_PCT", "50"))
MAX_BYTES = int(float(os.environ.get("CBW_MAX_MB", "5")) * 1024 * 1024)
LAUNCHD_MAX_BYTES = 1024 * 1024
# argv[0] only: no whitespace may precede the matched executable, so an argument naming it (`/usr/bin/vim
# /x/CodexBar.app/...`, `rg opencode serve`) never makes its process a root.
TARGETS = {
    "codexbar": re.compile(r"^/[^\s]*?CodexBar\.app/Contents/(?:MacOS|Helpers)/CodexBar\w*(?:\s|$)"),
    "opencode": re.compile(r"^(?:\S*/)?opencode(?:\.exe)?\s+serve(?:\s|$)"),
}
# Targets that watch a macOS-only app: install refuses them off darwin (exit 69).
DARWIN_ONLY = {"codexbar"}
PLATFORM = sys.platform
# Keyword overrides for ade_sched.install/uninstall (agents_dir=, unit_dir=, launchctl=, ...); tests set them.
SCHED_OVERRIDES = {}
ade_sched = None


def import_sched():
    global ade_sched
    if ade_sched is None:
        sys.path[:0] = [d for d in (os.path.dirname(os.path.realpath(__file__)),) if d not in sys.path]  # python3 -I
        import ade_sched as mod
        ade_sched = mod
    return ade_sched


# The target in use, set once by use_target() before anything samples, reports or installs.
TARGET = ""
ROOT_RE = None
STATE_DIR = HOME / ".local/state"
LOG = STATE_DIR / "samples.jsonl"
LABEL = ""


def use_target(name):
    global TARGET, ROOT_RE, STATE_DIR, LOG, LABEL
    TARGET, ROOT_RE = name, TARGETS[name]
    STATE_DIR = Path(os.environ.get("CBW_STATE_DIR", HOME / f".local/state/{name}-cpu-watch"))
    LOG = STATE_DIR / "samples.jsonl"
    LABEL = f"com.djbclark.{name}-cpu-watch"


INTERPRETERS = {"node", "bash", "sh", "zsh", "uv", "env", "ruby", "perl", "deno", "bun"}
SAFE_WORD = re.compile(r"[\w./~+-]+")
SCRIPT_SUFFIX = (".js", ".mjs", ".cjs", ".ts", ".py", ".sh", ".rb", ".pl")
FLAG_NAME = re.compile(r"--[A-Za-z][\w-]{0,40}|-[A-Za-z]")


def cputime_s(text):
    """ps TIME: [DD-]HH:MM:SS.cc or MM:SS.cc -> seconds."""
    days = 0
    if "-" in text:
        d, text = text.split("-", 1)
        days = int(d)
    secs = 0.0
    for p in (float(x) for x in text.split(":")):
        secs = secs * 60 + p
    return days * 86400 + secs


def label(cmd):
    """A short name for a command line: executable basename (+ script basename for an interpreter). Never an argument value.

    The script is the first non-option token, taken only when it looks like a script: it ends in a script suffix,
    or it comes right after argv[0] AND is a path (contains `/`). Otherwise it may be an option's separate value or
    an arbitrary word (`env WORD`, `sh WORD`, `bun x WORD`), and the name is the interpreter alone."""
    toks = cmd.split()
    if not toks:
        return "?"
    name = os.path.basename(toks[0])
    if name in INTERPRETERS or re.fullmatch(r"[Pp]ython[\d.]*", name):
        for i, t in enumerate(toks[1:], start=1):
            if t.startswith("-"):
                continue
            if SAFE_WORD.fullmatch(t) and (t.endswith(SCRIPT_SUFFIX) or (i == 1 and "/" in t)):
                name = f"{name} {os.path.basename(t)}"
            break
    return name[:40]


def flag_names(cmd):
    """Flag NAMES only: `--token=x` -> `--token`, `-pSECRET` -> dropped, values dropped."""
    out = []
    for t in cmd.split()[1:]:
        base = t.split("=", 1)[0]
        if t.startswith("-") and FLAG_NAME.fullmatch(base) and base not in out:
            out.append(base)
    return out[:8]


def read_ps():
    """pid -> {ppid, rss_mb, cpu_s, start, cmd}. `start` (ps lstart, 5 tokens) identifies a process across two reads:
    the same pid with the same start is the same process even after an exec changed its command line."""
    r = subprocess.run(["ps", "-axo", "pid=,ppid=,rss=,time=,lstart=,command="], capture_output=True, text=True,
                       errors="replace", timeout=30)
    if r.returncode != 0 or not r.stdout.strip():
        raise RuntimeError(f"ps failed (rc={r.returncode})")
    procs = {}
    for line in r.stdout.splitlines():
        f = line.split(None, 9)
        if len(f) < 10:
            continue
        try:
            procs[int(f[0])] = {"pid": int(f[0]), "ppid": int(f[1]), "rss_mb": int(f[2]) // 1024,
                                "cpu_s": cputime_s(f[3]), "start": " ".join(f[4:9]), "cmd": f[9]}
        except ValueError:
            continue
    return procs


def tree(procs, me=None):
    """The target's processes plus every descendant (never this process)."""
    me = os.getpid() if me is None else me
    keep = {p for p, v in procs.items() if p != me and ROOT_RE.match(v["cmd"])}
    grew = True
    while grew:
        grew = False
        for p, v in procs.items():
            if p not in keep and p != me and v["ppid"] in keep:
                keep.add(p)
                grew = True
    return keep


def view(r):
    return {"pid": r["pid"], "pct": r["pct"], "rss_mb": r["rss_mb"], "name": label(r["cmd"]), "flags": flag_names(r["cmd"])}


def sample():
    a = read_ps()
    t0 = time.monotonic()
    first = tree(a)
    time.sleep(WINDOW_S)
    b = read_ps()
    dt = time.monotonic() - t0
    # A process is identified by (pid, start time), not by pid: one counts when it is in the second read's tree, or
    # was in the first read's tree and is the SAME process now (same start). A pid of the first tree that a new,
    # unrelated process reused is neither, so its CPU is never attributed to the target.
    pids = tree(b) | {p for p in first if p in b and a[p].get("start") == b[p].get("start")}
    rows = []
    for p in pids:
        if p not in b:
            continue  # exited inside the window: not counted (module docstring)
        # Same pid and same start time = same process, even if it exec'd a new command; a reused pid (other start)
        # or one born inside the window has no first read: its whole CPU time came inside it.
        before = a[p]["cpu_s"] if p in a and a[p].get("start") == b[p].get("start") else 0.0
        pct = max(0.0, (b[p]["cpu_s"] - before) / dt * 100)
        rows.append({"pid": p, "ppid": b[p]["ppid"], "pct": round(pct, 1), "rss_mb": b[p]["rss_mb"], "cmd": b[p]["cmd"]})
    rows.sort(key=lambda r: -r["pct"])
    total = round(sum(r["pct"] for r in rows), 1)
    rec = {"ts": datetime.now().astimezone().isoformat(timespec="seconds"), "target": TARGET, "window_s": round(dt, 1),
           "procs": len(rows), "total_pct": total, "spike": total >= SPIKE_PCT,
           "top": [view(r) for r in rows[:5]]}
    if rec["spike"]:
        rec["tree"] = [dict(view(r), ppid=r["ppid"]) for r in rows[:15]]
    return rec


def ensure_private_dir():
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(STATE_DIR, 0o700)


def tidy_launchd_logs():
    for name in ("launchd.out", "launchd.err"):
        p = STATE_DIR / name
        try:
            os.chmod(p, 0o600)
            if p.stat().st_size > LAUNCHD_MAX_BYTES:
                os.truncate(p, 0)
        except FileNotFoundError:
            pass


def append(rec):
    """One O_APPEND write of one line; rotation and write under one flock, so two writers never lose history."""
    ensure_private_dir()
    lock = os.open(STATE_DIR / ".lock", os.O_WRONLY | os.O_CREAT, 0o600)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            if LOG.stat().st_size > MAX_BYTES:
                os.replace(LOG, LOG.with_name(LOG.name + ".1"))
        except FileNotFoundError:
            pass
        fd = os.open(LOG, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        try:
            os.fchmod(fd, 0o600)
            os.write(fd, (json.dumps(rec, separators=(",", ":")) + "\n").encode())
        finally:
            os.close(fd)
    finally:
        os.close(lock)
    tidy_launchd_logs()


def cmd_sample(a):
    try:
        rec = sample()
    except (RuntimeError, OSError, subprocess.TimeoutExpired) as e:
        # No record: a failed ps must not read as "the target is not running". launchd.err still gets its cap.
        print(f"proc-cpu-watch: sample failed: {e}", file=sys.stderr)
        if STATE_DIR.is_dir():
            tidy_launchd_logs()
        return 1
    append(rec)
    if a.verbose:
        print(json.dumps(rec, indent=1))
    else:
        print(f"{rec['ts']} total {rec['total_pct']}% over {rec['procs']} procs{' SPIKE' if rec['spike'] else ''}")
    return 0


def read_tail(max_bytes=1 << 20):
    """Parsed records from the last max_bytes of the log; unreadable lines are skipped."""
    size = LOG.stat().st_size
    with open(LOG, "rb") as f:
        f.seek(max(0, size - max_bytes))
        data = f.read()
    lines = data.decode("utf-8", "replace").splitlines()
    if size > max_bytes:
        lines = lines[1:]  # the first line is cut
    recs = []
    for x in lines:
        try:
            r = json.loads(x)
        except ValueError:
            continue
        if isinstance(r, dict):
            recs.append(r)
    return recs


def num(v, default=0.0):
    return v if isinstance(v, (int, float)) and not isinstance(v, bool) else default


def fmt_proc(t):
    """Only the fields this tool writes: a legacy `cmd` (round-1 records) is never printed."""
    flags = [f for f in (t.get("flags") or []) if isinstance(f, str)]
    return f"{num(t.get('pct'))}% pid {t.get('pid', '-')} {t.get('name') or '?'} {' '.join(flags)}".rstrip()


def procs_of(r, key):
    v = r.get(key)
    return [t for t in v if isinstance(t, dict)] if isinstance(v, list) else []


def cmd_report(a):
    if not LOG.exists():
        print("no samples yet")
        return 1
    # Only this target's records: a CBW_STATE_DIR shared by two targets cannot mix them. A record from before the
    # `target` field (2026-11-01) is shown under any target.
    recs = [r for r in read_tail() if r.get("target") in (None, TARGET)]
    spikes = sum(1 for r in recs if r.get("spike") is True)
    print(f"{len(recs)} samples scanned, {spikes} at or above {SPIKE_PCT:g}%  (log: {LOG})")
    for r in recs[-a.n:]:
        top = (procs_of(r, "top") or [{}])[0]
        spike = r.get("spike") is True
        mark = "SPIKE" if spike else "     "
        print(f"{r.get('ts', '?')} {mark} {num(r.get('total_pct')):6.1f}%  {int(num(r.get('procs'))):2d} procs  top: {fmt_proc(top)[:90]}")
        if spike:
            for t in procs_of(r, "tree")[:5]:
                print(f"      ppid {t.get('ppid', '-')}  {t.get('rss_mb', '?')} MB  {fmt_proc(t)[:110]}")
    return 0


def disposable_checkout(path):
    """True for a checkout that will be removed: a linked worktree (.git is a FILE) or a cow pasture (under ~/.cow,
    which has its own .git directory). The primary checkout is neither."""
    path = Path(path).resolve()
    cow = (HOME / ".cow").resolve()
    return (path / ".git").is_file() or path == cow or cow in path.parents


def build_job(ade, ade_sched):
    """The ade_sched Job for the active target: the tracked template with __ADE__/@STATE@/@TARGET@ filled in on the PARSED
    values (a path with `&`, `<` or a quote stays valid), plus CBW_STATE_DIR in the job's environment so scheduled samples
    go where `install` was told to put them (the template's comments are dropped)."""
    tpl = plistlib.loads(re.sub(rb"<!--.*?-->", b"", PLIST.read_bytes(), flags=re.DOTALL))
    tpl.setdefault("EnvironmentVariables", {})["CBW_STATE_DIR"] = str(STATE_DIR)
    subst = dict(ade_sched.default_subst(ade), **{"@STATE@": str(STATE_DIR), "@TARGET@": TARGET})
    return ade_sched.Job.from_dict(tpl, str(PLIST), subst, ade=ade, kill_mode=None)


def cmd_install(a):
    import_sched()
    backend = getattr(a, "backend", None)
    dry = bool(getattr(a, "dry_run", False))
    if a.cmd == "install" and TARGET in DARWIN_ONLY and PLATFORM != "darwin":
        print(f"proc-cpu-watch: the {TARGET} target watches a macOS app and is not installable on {PLATFORM}", file=sys.stderr)
        return 69
    try:
        if a.cmd == "uninstall":
            gone = ade_sched.uninstall(LABEL, backend, dry_run=dry, **SCHED_OVERRIDES)
            print(f"removed {LABEL}" if gone else f"{LABEL} was not installed")
            return 0
        ade = Path(a.ade).expanduser().resolve() if a.ade else ADE
        if not a.ade and disposable_checkout(ade):
            print(f"proc-cpu-watch: {ade} is a linked worktree or cow pasture that will be removed; run install from "
                  "the primary checkout, or pass --ade DIR", file=sys.stderr)
            return 2
        if not (ade / "bin" / "proc-cpu-watch").is_file():
            print(f"proc-cpu-watch: {ade}/bin/proc-cpu-watch not found", file=sys.stderr)
            return 2
        # Everything that can fail happens before the old job is replaced: build and validate the job, create the directory.
        try:
            job = build_job(ade, ade_sched)
            if not dry:
                ensure_private_dir()
        except (OSError, ValueError) as e:
            print(f"proc-cpu-watch: cannot build the job, nothing changed: {e}", file=sys.stderr)
            return 2
        ade_sched.install(job, backend, dry_run=dry, allow_no_linger=bool(getattr(a, "allow_no_linger", False)),
                          **SCHED_OVERRIDES)
    except ade_sched.SchedError as e:
        print(f"proc-cpu-watch {a.cmd}: {e}", file=sys.stderr)
        return e.code
    if not dry:
        print(f"installed {LABEL} (script {ade / 'bin/proc-cpu-watch'}, target {TARGET})")
    return 0


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    def add(name):
        p = sub.add_parser(name)
        p.add_argument("--target", required=True, choices=sorted(TARGETS))
        return p
    add("sample").add_argument("-v", "--verbose", action="store_true")
    add("report").add_argument("-n", type=int, default=24)
    ip = add("install")
    ip.add_argument("--ade", help="checkout holding bin/proc-cpu-watch (default: the one this script is in; "
                    "refused for a linked worktree or cow pasture)")
    up = add("uninstall")
    for q in (ip, up):
        q.add_argument("--backend", choices=["auto", "launchd", "systemd", "cron"], default="auto",
                       help="scheduler (default auto: launchd on macOS, a systemd user timer on Linux, else cron)")
        q.add_argument("--dry-run", action="store_true", help="print what would be written and run; change nothing")
    ip.add_argument("--allow-no-linger", action="store_true", help="systemd: install although loginctl Linger=no")
    a = ap.parse_args()
    use_target(a.target)
    return {"sample": cmd_sample, "report": cmd_report, "install": cmd_install, "uninstall": cmd_install}[a.cmd](a)


if __name__ == "__main__":
    sys.exit(main())

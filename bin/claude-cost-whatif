#!/usr/bin/env python3
"""What-if analysis on the last N days of Claude Code transcripts.

A. Cache TTL: observed (1h, writes 2.0x) vs 5-minute TTL (writes 1.25x, but a request after a
   5-60 min idle gap re-writes its whole cached prefix instead of reading it).
B. Compaction threshold T: when context crosses T, compact to floor F (measured 104k); the
   compaction costs a summarisation call (read C at the model's read rate, ~6k output at 5x) plus re-writing F at
   the write weight; later requests in that transcript shrink by (C - F) until the next one.
Units: input-token equivalents. Approximations, not billing.
"""
import glob, json, os, sys, time
from datetime import datetime

DAYS = float(sys.argv[1]) if len(sys.argv) > 1 else 7
cut = time.time() - DAYS * 86400
W1H, W5M, OUT = 2.0, 1.25, 5.0
PRICES = {"claude-opus-5-5": (4.0, 0.05), "claude-sonnet-5-5": (2.0, 0.05), "claude-fable-5-1": (10.0, 0.025)}
def price(model):
    return next((v for k, v in PRICES.items() if (model or "").startswith(k)), (1.0, 0.1))
F, SUMMARY_OUT = 104_000, 6_000


def ts(s):
    try:
        return datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()
    except Exception:
        return None


seqs = []  # per transcript: list of (t, input, cw, cr, out)
for f in glob.glob(os.path.expanduser("~/.claude/projects/**/*.jsonl"), recursive=True):
    if os.path.getmtime(f) < cut:
        continue
    seen, seq = set(), []
    for line in open(f, errors="replace"):
        try:
            d = json.loads(line)
        except ValueError:
            continue
        if d.get("type") != "assistant":
            continue
        m = d.get("message") or {}
        u, mid = m.get("usage") or {}, m.get("id")
        if not u or not mid or mid in seen:
            continue
        seen.add(mid)
        b, r = price(m.get("model"))
        seq.append((ts(d.get("timestamp", "")), b / 1e6, r, "/subagents/" in f, u.get("input_tokens", 0),
                    u.get("cache_creation_input_tokens", 0), u.get("cache_read_input_tokens", 0),
                    u.get("output_tokens", 0)))
    if seq:
        seqs.append(seq)

# A. TTL
obs = five = sub5 = 0.0
gap_reqs = gap_tokens = 0
for seq in seqs:
    prev = None
    for t, B, R, sub, i, cw, cr, o in seq:
        here = B * (i + cw * W1H + cr * R + o * OUT)
        obs += here
        gap = prev is not None and t is not None and 300 < t - prev <= 3600
        alt = B * (i + (cw + cr) * W5M + o * OUT) if gap else B * (i + cw * W5M + cr * R + o * OUT)
        five += alt
        sub5 += alt if sub else here
        if gap:
            gap_reqs += 1
            gap_tokens += cr
        prev = t if t is not None else prev
n_req = sum(len(s) for s in seqs)
print(f"A. TTL  transcripts {len(seqs)}, requests {n_req:,}")
print(f"   observed 1h TTL everywhere: ${obs:,.0f}   5-minute everywhere: ${five:,.0f} ({(five-obs)/obs:+.1%})"
      f"   main 1h + sub-agents 5m: ${sub5:,.0f} ({(sub5-obs)/obs:+.1%})")
print(f"   requests after a 5-60 min idle gap: {gap_reqs:,} ({gap_reqs/n_req:.1%}), "
      f"cached tokens they would re-write: {gap_tokens/1e6:,.1f}M")

# B. Compaction threshold
print("B. compaction threshold (simulated on top of observed history)")
for T in (None, 500_000, 400_000, 300_000, 250_000, 200_000, 150_000):
    total = 0.0
    n_comp = 0
    for seq in seqs:
        drop = 0
        prev_ctx = 0
        for t, B, R, sub, i, cw, cr, o in seq:
            ctx = i + cw + cr
            if prev_ctx and ctx < 0.6 * prev_ctx:
                drop = 0  # an observed compaction or /clear: the real history already shrank
            prev_ctx = ctx
            eff = max(ctx - drop, 0)
            if T and eff > T:
                n_comp += 1
                total += B * (eff * R + SUMMARY_OUT * OUT + F * W1H)
                drop += eff - F
                eff = F
            # keep the observed new-content write; shrink the cached read by the drop
            cr_eff = max(cr - drop, 0)
            total += B * (i + cw * W1H + cr_eff * R + o * OUT)
    label = "none (observed)" if T is None else f"{T//1000}k"
    print(f"   T={label:<16} total ${total:,.0f}  ({(total-obs)/obs:+.1%})  extra compactions {n_comp:,}")

#!/usr/bin/env bash
# Periodic Pi-stuck scan. Runs bin/ade-pi-stuck; when a live Pi agent is stuck on
# an exhausted account, sends ONE notice per stuck agent to the lead named in
# ADE_SUPERVISOR_LEAD, or failing that in $STATE_DIR/lead (one Paseo agent id). The
# plist and its config/ade.toml inventory row carry no lead at all, so `ade-sched
# diff`/`reconcile` render the job and a lead handoff cannot leave a stale id in a
# template; docs/scheduling.md says how to write the file. Deduped: an
# agent already told stays quiet while it stays stuck and is told again only after
# it clears and later sticks again (StartInterval is 300 s, so without this one
# stuck agent would be 288 notices a day). A broken scan, or a quota read that
# fails, alerts the lead once instead of going quietly blind; a lead the guard
# refuses, or a send that fails, is pinged to the operator once through hermes-ping,
# because the scan has no other way to report. Never a model prompt; always exits 0,
# so launchd stays quiet.
set -uo pipefail
STATE_DIR="${ADE_SUPERVISOR_STATE_DIR:-${HOME}/.local/state/djbclark-ade/supervisor}"
LEAD="${ADE_SUPERVISOR_LEAD:-}"
[ -n "$LEAD" ] || LEAD="$(head -1 "$STATE_DIR/lead" 2>/dev/null || true)"
mkdir -p "$STATE_DIR"
LOG="$STATE_DIR/supervisor.log"
now() { date -u +%Y-%m-%dT%H:%M:%SZ; }
if [ -z "$LEAD" ]; then
    printf '%s ade-supervisor-scan: no lead (neither ADE_SUPERVISOR_LEAD nor %s/lead); docs/scheduling.md, nothing to notify\n' \
        "$(now)" "$STATE_DIR" >>"$LOG"
    exit 0
fi
case "$LEAD" in
    -*) LEAD="" ;;                                       # a value starting with "-" would be read as an option
    *[!A-Za-z0-9._:-]*) LEAD="" ;;                       # Paseo ids are UUIDs: nothing else is a target
esac
if [ -z "$LEAD" ]; then
    printf '%s ade-supervisor-scan: the lead value in ADE_SUPERVISOR_LEAD/%s/lead is not an agent id; nothing to notify\n' \
        "$(now)" "$STATE_DIR" >>"$LOG"
    exit 0
fi
SCAN="$(cd "$(dirname "$0")" && pwd)/ade-pi-stuck"
[ -x "$SCAN" ] || SCAN="$HOME/src/djbclark-ade/bin/ade-pi-stuck"
# bin/ade-pi-stuck's stderr is kept out of the JSON it prints: a warning merged into stdout would make every run
# unparseable. It goes to the log instead.
err="$STATE_DIR/.scan-stderr.$$"
json="$("$SCAN" --json 2>"$err")"
scan_rc=$?
[ -s "$err" ] && cat "$err" >>"$LOG"
rm -f "$err"

# Dedupe state: `notified` holds the keys already told ("<agent id>|<account>", and the `scan|broken` /
# `scan|quota-unread` alert keys). The pending file is this run's key set; it replaces the state only once the notice is
# accepted (or there is nothing to send), so a failed send retries next run and a condition that clears frees its key.
NOTIFIED="$STATE_DIR/notified"
pending="$STATE_DIR/.notified.$$"
msg="$(printf '%s' "$json" | python3 -c '
import json, sys
notified_path, pending_path, scan_rc = sys.argv[1], sys.argv[2], int(sys.argv[3])
try:
    d = json.load(sys.stdin) if scan_rc == 0 else None
except Exception:
    d = None
if not isinstance(d, dict):          # a list or a bare value is no more usable than non-JSON
    d = None
try:
    told = set(json.load(open(notified_path)))
except Exception:
    told = set()
items = []                                  # (key, text): every condition true now; text None = no notice
if d is None:
    items.append(("scan|broken",
                  "ade-pi-stuck failed or printed no usable JSON (exit %d) — the Pi-stuck watch is blind" % scan_rc))
    # A degraded run cannot observe agents, so it must not forget the ones already told: keep their keys.
    items += [(key, None) for key in sorted(told)]
else:
    if d.get("quota_error"):
        items.append(("scan|quota-unread",
                      "aiuse quota unread (%s) — every account except the known-empty ones is unread" % d["quota_error"]))
    for acct in d.get("low") or []:
        rec = (d.get("accounts") or {}).get(acct) or {}
        items.append(("thin|%s" % acct,
                      "account %s is thin (%s%% headroom%s) — re-handoffs to it are already refused" %
                      (acct, rec.get("headroom"), ", stale reading" if rec.get("stale") else "")))
    for s in d.get("stuck", []):
        if s.get("status") in ("closed", "archived"):
            continue
        items.append(("%s|%s" % (s.get("id"), s.get("account")),
                      "id=%s account=%s model=%s -> %s" % (s.get("id"), s.get("account"), s.get("model"),
                                                           s.get("alternative") or "no healthy alternative")))
with open(pending_path, "w") as fh:
    json.dump([k for k, _ in items], fh)
new = [text for key, text in items if text and key not in told]
if new:
    print("supervisor scan: %d new finding(s) — %s" % (len(new), "; ".join(new)))
' "$NOTIFIED" "$pending" "$scan_rc" 2>>"$LOG")"

# The send target is decided by the repo's own guard (bin/ade_send_guard.py, ls-02): it refuses an archived lead (a
# delivery would un-archive it), reports a failed or unreadable inspect, and redirects to the recorded successor after a
# lead self-handoff instead of leaving the operator to edit the file by hand.
guard_json="$(python3 "$(cd "$(dirname "$0")" && pwd)/ade_send_guard.py" "$LEAD" 2>>"$LOG")"
guard_rc=$?
guard_target="$(printf '%s' "$guard_json" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
print(d.get("target") or "")' 2>>"$LOG")"
guard_reason="$(printf '%s' "$guard_json" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
print(d.get("reason") or "")' 2>>"$LOG")"

send_failed=0
case "$guard_rc" in
    0) send_to="$LEAD" ;;
    3)  # a completed self-handoff replaced the lead: the notice follows it, under the same id check
        case "$guard_target" in
            ''|-*|*[!A-Za-z0-9._:-]*)
                send_to=""
                send_failed=1
                printf '%s ade-supervisor-scan: lead %s was replaced but the successor id %r is unusable; not sending\n' \
                    "$(now)" "$LEAD" "$guard_target" >>"$LOG"
                ;;
            *)
                send_to="$guard_target"
                printf '%s ade-supervisor-scan: lead %s was replaced; sending to %s (%s); next run reads %s/lead\n' \
                    "$(now)" "$LEAD" "$send_to" "$guard_reason" "$STATE_DIR" >>"$LOG"
                printf '%s\n' "$send_to" >"$STATE_DIR/.lead.$$" && mv -f "$STATE_DIR/.lead.$$" "$STATE_DIR/lead"
                ;;
        esac
        ;;
    *)
        send_to=""
        send_failed=1
        printf '%s ade-supervisor-scan: not sending to %s: %s\n' "$(now)" "$LEAD" "${guard_reason:-guard refused}" >>"$LOG"
        ;;
esac
if [ -n "$msg" ] && [ -n "$send_to" ]; then
    printf '%s %s\n' "$(now)" "$msg" >>"$LOG"
    paseo send --json --no-wait -- "$send_to" "$msg" >>"$LOG" 2>&1
    rc=$?
    # 0 = delivered, 5 = accepted and queued by Paseo (the normal agent-to-agent case).
    if [ "$rc" -ne 0 ] && [ "$rc" -ne 5 ]; then
        send_failed=1
        printf '%s ade-supervisor-scan: send to %s failed (exit %s)\n' "$(now)" "$send_to" "$rc" >>"$LOG"
    fi
fi
unreachable="$STATE_DIR/.lead-unreachable"
if [ "$send_failed" -eq 1 ]; then
    # The scan cannot reach its own lead, so it has no in-band channel left: tell the operator once per outage.
    if [ ! -f "$unreachable" ]; then
        if hermes-ping "djbclark-ade: supervisor Pi-stuck scan cannot reach its lead $LEAD (${guard_reason:-send failure}); write the current lead id to $STATE_DIR/lead (docs/scheduling.md)" >>"$LOG" 2>&1; then
            : >"$unreachable"           # marked only once the operator was actually reached
        else
            printf '%s ade-supervisor-scan: hermes-ping failed; will retry the escalation next run\n' "$(now)" >>"$LOG"
        fi
    fi
    if [ -n "$msg" ]; then
        rm -f "$pending"                 # a notice is pending: keep the old state and retry next run
    else
        [ -f "$pending" ] && mv -f "$pending" "$NOTIFIED"   # quiet run: apply the shrink, nothing to retry
    fi
    exit 0
fi
# The guard answered (pass or redirect): the lead is reachable again, so the escalation marker may go, even on a quiet run.
rm -f "$unreachable"
[ -f "$pending" ] && mv -f "$pending" "$NOTIFIED"
exit 0

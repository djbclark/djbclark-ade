#!/usr/bin/env bash
# Periodic Pi-stuck scan. Runs bin/ade-pi-stuck; when a live Pi agent is stuck on
# an exhausted account, sends ONE notice per stuck agent to the ADE lead. Deduped:
# an agent already told stays quiet while it stays stuck, and is told again only
# after it clears and later sticks again (StartInterval is 300 s, so without this
# one stuck agent is 288 notices a day). Never a model prompt; always exits 0 so
# launchd stays quiet.
set -uo pipefail
STATE_DIR="${HOME}/.local/state/djbclark-ade/supervisor"
LEAD="${ADE_SUPERVISOR_LEAD:-b0b47ad8-8801-4780-a8e0-08824cd5ce27}"
mkdir -p "$STATE_DIR"
SCAN="$(cd "$(dirname "$0")" && pwd)/ade-pi-stuck"
[ -x "$SCAN" ] || SCAN="$HOME/src/djbclark-ade/bin/ade-pi-stuck"
json="$("$SCAN" --json 2>&1)" || { printf '%s\n' "$json" >>"$STATE_DIR/supervisor.log"; exit 0; }

# Dedupe state: `notified` holds the "<agent id>|<account>" keys already told. The
# pending file is this run's live key set; it replaces the state only after the
# notice is accepted (or when there is nothing to send), so a failed send retries.
NOTIFIED="$STATE_DIR/notified"
pending="$STATE_DIR/.notified.$$"
msg="$(printf '%s' "$json" | python3 -c '
import json, sys
notified_path, pending_path = sys.argv[1], sys.argv[2]
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
live = [s for s in d.get("stuck", []) if s.get("status") not in ("closed", "archived")]
keys = ["%s|%s" % (s.get("id"), s.get("account")) for s in live]
try:
    told = set(json.load(open(notified_path)))
except Exception:
    told = set()
new = [(s, k) for s, k in zip(live, keys) if k not in told]
with open(pending_path, "w") as fh:
    json.dump(keys, fh)
if new:
    body = "; ".join("id=%s account=%s model=%s -> %s" % (s.get("id"), s.get("account"), s.get("model"), s.get("alternative"))
                     for s, _ in new)
    print("supervisor scan: %d newly stuck Pi agent(s) — %s" % (len(new), body))
' "$NOTIFIED" "$pending" 2>>"$STATE_DIR/supervisor.log")"

if [ -n "$msg" ]; then
    printf '%s\n' "$msg" >>"$STATE_DIR/supervisor.log"
    paseo send "$LEAD" --no-wait --json "$msg" >>"$STATE_DIR/supervisor.log" 2>&1
    rc=$?
    # 0 = delivered, 5 = accepted and queued by Paseo (the normal agent-to-agent case).
    if [ "$rc" -ne 0 ] && [ "$rc" -ne 5 ]; then
        rm -f "$pending"   # not delivered: keep the old state and retry next run
        exit 0
    fi
fi
[ -f "$pending" ] && mv -f "$pending" "$NOTIFIED"
exit 0

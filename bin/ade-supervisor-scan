#!/usr/bin/env bash
# Periodic Pi-stuck scan. Runs bin/ade-pi-stuck; when a live Pi agent is stuck on
# an exhausted account, sends ONE notice per stuck agent to the ADE lead named in
# ADE_SUPERVISOR_LEAD (the plist and its config/ade.toml inventory row supply it;
# nothing is baked in here, as with ade-net-resume's LEAD_UUID). Deduped: an agent
# already told stays quiet while it stays stuck, and is told again only after it
# clears and later sticks again (StartInterval is 300 s, so without this one stuck
# agent would be 288 notices a day). A broken scan alerts the lead once instead of
# going quietly blind. Never a model prompt; always exits 0 so launchd stays quiet.
set -uo pipefail
STATE_DIR="${ADE_SUPERVISOR_STATE_DIR:-${HOME}/.local/state/djbclark-ade/supervisor}"
LEAD="${ADE_SUPERVISOR_LEAD:-}"
mkdir -p "$STATE_DIR"
LOG="$STATE_DIR/supervisor.log"
if [ -z "$LEAD" ]; then
    printf '%s ade-supervisor-scan: ADE_SUPERVISOR_LEAD is unset (the plist supplies it; see docs/scheduling.md), nothing to notify\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >>"$LOG"
    exit 0
fi
SCAN="$(cd "$(dirname "$0")" && pwd)/ade-pi-stuck"
[ -x "$SCAN" ] || SCAN="$HOME/src/djbclark-ade/bin/ade-pi-stuck"
# bin/ade-pi-stuck's stderr is kept out of the JSON it prints: a warning merged into stdout would make every run
# unparseable. It goes to the log instead.
err="$STATE_DIR/.scan-stderr.$$"
json="$("$SCAN" --json 2>"$err")"
scan_rc=$?
[ -s "$err" ] && cat "$err" >>"$LOG"
rm -f "$err"

# Dedupe state: `notified` holds the keys already told ("<agent id>|<account>", or an alert key). The pending file is
# this run's key set; it replaces the state only once the notice is accepted (or there is nothing to send), so a failed
# send retries on the next run and a condition that clears frees its key.
NOTIFIED="$STATE_DIR/notified"
pending="$STATE_DIR/.notified.$$"
if [ "$scan_rc" -ne 0 ] || [ -z "$json" ]; then
    # A broken scan is its own once-per-outage alert: without it the supervisor covers nothing and says nothing.
    msg="$(python3 -c '
import json, sys
notified_path, pending_path, text = sys.argv[1:4]
key = "scan|broken"
try:
    told = set(json.load(open(notified_path)))
except Exception:
    told = set()
with open(pending_path, "w") as fh:
    json.dump(sorted(told | {key}), fh)
if key not in told:
    print("supervisor scan: ade-pi-stuck failed or printed nothing (%s) — the Pi-stuck watch is blind until it works" % text)
' "$NOTIFIED" "$pending" "exit $scan_rc" 2>>"$LOG")"
else
    msg="$(printf '%s' "$json" | python3 -c '
import json, sys
notified_path, pending_path = sys.argv[1], sys.argv[2]
try:
    d = json.load(sys.stdin)
except Exception as exc:
    print("unparseable")
    sys.exit(0)
live = [s for s in d.get("stuck", []) if s.get("status") not in ("closed", "archived")]
keys = ["%s|%s" % (s.get("id"), s.get("account")) for s in live]
try:
    told = set(json.load(open(notified_path)))
except Exception:
    told = set()
new = [(s, k) for s, k in zip(live, keys) if k not in told]
with open(pending_path, "w") as fh:
    json.dump(keys, fh)
if new:
    body = "; ".join("id=%s account=%s model=%s -> %s" % (s.get("id"), s.get("account"), s.get("model"),
                                                          s.get("alternative") or "no healthy alternative")
                     for s, _ in new)
    print("supervisor scan: %d newly stuck Pi agent(s) — %s" % (len(new), body))
' "$NOTIFIED" "$pending" 2>>"$LOG")"
    if [ "$msg" = "unparseable" ]; then
        # Same once-per-outage alert, for output that is not JSON at all.
        msg="$(python3 -c '
import json, sys
notified_path, pending_path = sys.argv[1], sys.argv[2]
key = "scan|unparseable"
try:
    told = set(json.load(open(notified_path)))
except Exception:
    told = set()
with open(pending_path, "w") as fh:
    json.dump(sorted(told | {key}), fh)
if key not in told:
    print("supervisor scan: ade-pi-stuck printed non-JSON — the Pi-stuck watch is blind until it works")
' "$NOTIFIED" "$pending" 2>>"$LOG")"
    fi
fi

if [ -n "$msg" ]; then
    printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$msg" >>"$LOG"
    paseo send "$LEAD" --no-wait --json "$msg" >>"$LOG" 2>&1
    rc=$?
    # 0 = delivered, 5 = accepted and queued by Paseo (the normal agent-to-agent case).
    if [ "$rc" -ne 0 ] && [ "$rc" -ne 5 ]; then
        printf '%s ade-supervisor-scan: send to %s failed (exit %s); retrying next run\n' \
            "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$LEAD" "$rc" >>"$LOG"
        rm -f "$pending"   # not delivered: keep the old state and retry next run
        exit 0
    fi
fi
[ -f "$pending" ] && mv -f "$pending" "$NOTIFIED"
exit 0

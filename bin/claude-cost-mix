#!/usr/bin/env python3
"""claude-cost-mix: where Claude Code spend goes, from local transcripts.

    claude-cost-mix [--days N] [--project SUBSTR] [--read W] [--write W] [--output W] [--json]

Reads ~/.claude/projects/**/*.jsonl (sub-agent transcripts included) modified in the last N
days (default 7) and prints, in input-token equivalents:

1. the cost mix: input, cache writes, cache reads, output;
2. which tool outputs carry it: a tool result of s tokens costs s * WRITE when first cached
   plus s * READ on every later request in the same transcript (compaction ignored, so this
   is an upper bound on what any tool that shrinks that output could save);
3. cost by context size at the time of each request, main-session vs sub-agent split, the
   number of compactions, and the fixed preamble: each transcript's first-request context
   (system prompt, tool and skill listings, CLAUDE.md) re-read on every later request.

Use it before believing a "70x fewer tokens" claim: a tool can save at most the share its
tool output carries (2026-10-18: navigation output was <=15% of Claude cost).

Costs are API list-price dollars per request's own model (PRICES, from
platform.claude.com/docs/en/about-claude/pricing, 2026-10-18): base input per MTok and the
cache-read multiplier (0.05 on Opus/Sonnet 5.5, 0.025 on Fable 5.1, 0.1 otherwise; unknown
models priced at $1 base). On a subscription these are equivalents, not a bill. Cache writes
are 2.0x base (the 1-hour TTL, ENABLE_PROMPT_CACHING_1H; 5-minute writes are 1.25x: transcripts
do not record the TTL, so pass --write 1.25), output 5x. --read forces one read multiplier.
Tool output size is characters / 4. Exit: 0 ok, 2 bad usage, 3 no transcripts in range.
"""
import argparse
import glob
import json
import os
import re
import sys
import time
from collections import defaultdict
from statistics import median as _median


def median(xs):
    return _median(xs) if xs else 0

# model id prefix -> (base input $/MTok, cache-read multiplier)
PRICES = {
    "claude-opus-5-5": (4.0, 0.05),
    "claude-sonnet-5-5": (2.0, 0.05),
    "claude-fable-5-1": (10.0, 0.025),
}
DEFAULT_PRICE = (1.0, 0.1)


def price(model, w):
    base, read = next((v for k, v in PRICES.items() if (model or "").startswith(k)), DEFAULT_PRICE)
    return base / 1e6, (w["read"] if w["read"] is not None else read)


NAV_BASH = re.compile(
    r"^\s*(?:cd [^;&|]+(?:&&|;)\s*)?"
    r"(rg|grep|ggrep|fd|find|cat|head|tail|gsed -n|sed -n|ast-grep|sg|ls|tree|wc|graft)\b"
)
NAV_TOOLS = {"Read", "Grep", "Glob", "Bash:nav", "Bash:graft", "mcp:graft"}
BUCKETS = [(0, "<100k"), (100_000, "100-200k"), (200_000, "200-300k"),
           (300_000, "300-400k"), (400_000, "400k+")]


def tool_label(block):
    name = block.get("name", "?")
    if name == "Bash":
        cmd = (block.get("input") or {}).get("command", "")
        if re.match(r"^\s*(?:cd [^;&|]+(?:&&|;)\s*)?graft\b", cmd):
            return "Bash:graft"
        return "Bash:nav" if NAV_BASH.match(cmd) else "Bash:other"
    if name.startswith("mcp__"):
        return "mcp:" + name.split("__")[1]
    return name


def result_chars(block):
    content = block.get("content")
    if isinstance(content, list):
        return sum(len(x.get("text", "")) for x in content if isinstance(x, dict))
    return len(str(content or ""))


def bucket(ctx):
    label = BUCKETS[0][1]
    for floor, name in BUCKETS:
        if ctx >= floor:
            label = name
    return label


def scan(path, w, acc):
    seen = set()
    events = []  # ("api", $ per token, read multiplier) or ("res", label, tokens)
    labels = {}
    first = None  # context size of the transcript's first request: the fixed preamble
    kind = "sub-agent" if "/subagents/" in path else "main"
    try:
        fh = open(path, errors="replace")
    except OSError:
        return
    with fh:
        for line in fh:
            try:
                d = json.loads(line)
            except ValueError:
                continue
            if d.get("subtype") == "compact_boundary":
                acc["compactions"] += 1
                continue
            m = d.get("message") or {}
            if d.get("type") == "assistant":
                mid, u = m.get("id"), m.get("usage") or {}
                if mid and u and mid not in seen:
                    seen.add(mid)
                    base, rd = price(m.get("model"), w)
                    parts = {
                        "input": u.get("input_tokens", 0) * base,
                        "cache_write": u.get("cache_creation_input_tokens", 0) * w["write"] * base,
                        "cache_read": u.get("cache_read_input_tokens", 0) * rd * base,
                        "output": u.get("output_tokens", 0) * w["output"] * base,
                    }
                    cost = sum(parts.values())
                    for k, v in parts.items():
                        acc["mix"][k] += v
                    ctx = (u.get("input_tokens", 0) + u.get("cache_creation_input_tokens", 0)
                           + u.get("cache_read_input_tokens", 0))
                    acc["ctx"][bucket(ctx)] += cost
                    acc["ctx_requests"][bucket(ctx)] += 1
                    acc["kind"][kind] += cost
                    if first is None:
                        first = ctx
                        acc["first_ctx"][kind].append(ctx)
                    acc["preamble"] += min(ctx, first) * rd * base
                    acc["requests"] += 1
                    events.append(("api", base, rd))
                for b in m.get("content") or []:
                    if isinstance(b, dict) and b.get("type") == "tool_use":
                        labels[b.get("id")] = tool_label(b)
            elif d.get("type") == "user" and isinstance(m.get("content"), list):
                for b in m["content"]:
                    if isinstance(b, dict) and b.get("type") == "tool_result":
                        events.append(("res", labels.get(b.get("tool_use_id"), "?"),
                                       result_chars(b) / 4))
    later = 0.0  # $ per token of re-reading on every later request
    write = 0.0  # $ per token of writing it on the next request
    for e in reversed(events):
        if e[0] == "api":
            later += e[1] * e[2]
            write = e[1] * w["write"]
            continue
        _, label, tokens = e
        acc["tool_cost"][label] += tokens * (write + later)
        acc["tool_tokens"][label] += tokens
        acc["tool_calls"][label] += 1


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--days", type=float, default=7)
    ap.add_argument("--project", default="", help="only transcript paths containing this")
    ap.add_argument("--read", type=float, default=None, help="one read multiplier for all models")
    ap.add_argument("--write", type=float, default=2.0)
    ap.add_argument("--output", type=float, default=5.0)
    ap.add_argument("--root", default=os.path.expanduser("~/.claude/projects"))
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args(argv)
    w = {"read": a.read, "write": a.write, "output": a.output}
    cut = time.time() - a.days * 86400
    files = [f for f in glob.glob(os.path.join(a.root, "**", "*.jsonl"), recursive=True)
             if a.project in f and os.path.getmtime(f) >= cut]
    if not files:
        print(f"claude-cost-mix: no transcripts under {a.root} in the last {a.days:g} days",
              file=sys.stderr)
        return 3
    acc = {k: defaultdict(float) for k in
           ("mix", "ctx", "ctx_requests", "kind", "tool_cost", "tool_tokens", "tool_calls")}
    acc.update(compactions=0, requests=0, preamble=0.0, first_ctx={"main": [], "sub-agent": []})
    for f in files:
        scan(f, w, acc)
    total = sum(acc["mix"].values()) or 1.0
    nav = sum(v for k, v in acc["tool_cost"].items() if k in NAV_TOOLS)
    if a.json:
        out = {
            "days": a.days, "transcripts": len(files), "requests": acc["requests"],
            "compactions": acc["compactions"], "weights": w, "total_usd": total,
            "mix": {k: v / total for k, v in acc["mix"].items()},
            "by_context": {n: acc["ctx"][n] / total for _, n in BUCKETS},
            "by_kind": {k: v / total for k, v in acc["kind"].items()},
            "tools": {k: {"calls": int(acc["tool_calls"][k]), "tokens": acc["tool_tokens"][k],
                          "share": v / total}
                      for k, v in sorted(acc["tool_cost"].items(), key=lambda x: -x[1])},
            "navigation_share": nav / total,
            "preamble_share": acc["preamble"] / total,
            "median_first_context": {k: median(v) for k, v in acc["first_ctx"].items()},
        }
        print(json.dumps(out, indent=1))
        return 0
    mix = acc["mix"]
    read = "per model" if a.read is None else a.read
    print(f"transcripts {len(files)}, requests {acc['requests']:,}, compactions "
          f"{acc['compactions']}, last {a.days:g} days; weights read {read} write {a.write} "
          f"output {a.output}")
    print(f"total ${total:,.0f} at API list prices: "
          + ", ".join(f"{k.replace('_', ' ')} {mix[k] / total:.1%}"
                      for k in ("input", "cache_write", "cache_read", "output")))
    print("\ncost by context size at the request:")
    for _, n in BUCKETS:
        print(f"  {n:<10}{acc['ctx'][n] / total:>7.1%}   {int(acc['ctx_requests'][n]):>8,} requests")
    print("cost by transcript kind: " + ", ".join(
        f"{k} {v / total:.1%}" for k, v in sorted(acc["kind"].items(), key=lambda x: -x[1])))
    fc = acc["first_ctx"]
    print(f"fixed preamble (first request's context, re-read on every request): "
          f"{acc['preamble'] / total:.1%} of cost; median first context main "
          f"{median(fc['main']) / 1000:.0f}k, sub-agent {median(fc['sub-agent']) / 1000:.0f}k")
    print(f"\n{'tool output':<24}{'calls':>8}{'Mtok':>8}{'share':>8}")
    for k, v in sorted(acc["tool_cost"].items(), key=lambda x: -x[1])[:20]:
        print(f"{k:<24}{int(acc['tool_calls'][k]):>8,}{acc['tool_tokens'][k] / 1e6:>8.2f}"
              f"{v / total:>8.1%}")
    print(f"\nnavigation output (Read/Grep/Glob, rg/cat/ls/fd via Bash, graft): at most "
          f"{nav / total:.1%} of cost")
    return 0


if __name__ == "__main__":
    sys.exit(main())

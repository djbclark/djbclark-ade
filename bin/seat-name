#!/usr/bin/env python3
"""seat-name — one ever-increasing base-36 name for every Paseo seat, so no two are ever alike.

WHY THIS EXISTS (djbclark, 2026-10-25)
-------------------------------------
*"Maybe for all workspace and tab names we should always have an ever-incrementing number or other
incrementing counter that also uses letters on it to avoid confusion."* and then *"the letters would
probably be better as that way the string would take longer to get to more characters, so like
something like hex but with base 36 instead of 16 (0-9 and a-z)."*

He is right on both counts. The problem is real: names are derived from the first prompt, so **two
unrelated sessions that opened with the same words get the same name**. On 2026-10-25 there were two
live tabs named `◈ Dann` (an old seat and the current one) and two named `/baton` (Plektra and
cfengine-all) — and one of them was draining the other's mail, because a peer cannot tell them apart.

The fix is a **global sequence**, not a per-repo one: a counter that only ever goes up, in **base 36**
so a name stays short for a long time (one character covers 36 seats; two cover 1296). Two properties
matter, and both are why this is a file rather than a guess:

1. **Monotonic.** It never reuses a number, even after the seat it named is archived, so "seat 4z"
   means exactly one session for all time and a transcript can always be tied to a seat.
2. **Atomic.** Two agents creating seats at the same moment must not get the same number, so the
   allocation is a lock-held read-modify-write, not a read-then-write.

NAMING SCHEME — base 36, digits then letters
--------------------------------------------
`<role> <base36>` counting from 1, using `0-9` then `a-z`:

    seat 1   -> "Dann 1"
    seat 9   -> "Dann 9"
    seat 10  -> "Dann a"
    seat 35  -> "Dann z"
    seat 36  -> "Dann 10"
    seat 71  -> "Dann 1z"
    seat 1296-> "Dann 100"

Deliberately **not** `v1`/`v2`: a version implies a revision of the same thing, which is the confusion
djbclark is trying to remove. A bare base-36 counter reads as an identity, not a revision.

WORKSPACES DRAW FROM THE SAME SEQUENCE
--------------------------------------
A Paseo workspace is a *container* (several agents can share one) while a tab is an *identity*, but
both are named from the first prompt when auto-created, so both collide the same way — and four empty
`main` workspaces were made by accident on 2026-10-25 alone.

So `--kind workspace` emits `<slug>-<n>-pw`, drawing `n` from **the same counter** as seats. One
sequence, so a number never means two things: if `Dann 3` is a tab, no workspace is also `-3-pw`. The
`-pw` suffix is the house convention (`-t` herdr tab, `-p` herdr pane, `-pw` Paseo workspace), kept
because it says *what kind of thing* this is — which the counter alone cannot.

    seat-name.py next --kind workspace --slug dann-home     -> "dann-home-4-pw"
    seat-name.py next --kind workspace --slug cfengine      -> "cfengine-5-pw"

STATE
-----
`~/.local/state/ade/seat-sequence.json`: `{"next": N, "issued": {"<name>": {"at": ts, "n": N, "id": agent}}}`.
The `issued` map is the audit trail: which name went to which agent, and when.

USAGE
  seat-name.py next [--role dann] [--count N] [--agent ID]            allocate seat name(s)
  seat-name.py next --kind workspace --slug <slug> [--count N]        allocate workspace name(s)
  seat-name.py peek [--role dann] [--count N]                         the next name(s), no consume
  seat-name.py issued [--limit N] [--json]                            what has been handed out
  seat-name.py check                                                  self-test: base-36, atomic, monotonic

Exit: 0 ok; 1 error; 2 usage.
"""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import sys
import time
from pathlib import Path

STATE = Path(os.environ.get("SEAT_NAME_STATE",
                            Path(os.path.expanduser("~")) / ".local/state/ade/seat-sequence.json"))
LOCK = STATE.with_suffix(".lock")
DEFAULT_ROLE = os.environ.get("SEAT_NAME_ROLE", "Dann")
DIGITS = "0123456789abcdefghijklmnopqrstuvwxyz"


def to_base36(n: int) -> str:
    """`n` (1-based) in base 36 using 0-9 then a-z. 1 -> '1', 10 -> 'a', 36 -> '10'.

    Lower-case letters on purpose: a name is typed and spoken, and `Dann 1a` is unambiguous read
    aloud in a way `Dann 1A` is not (it sounds like a version or an initial).
    """
    if n < 1:
        raise ValueError("seat numbers start at 1")
    out = ""
    while n:
        n, rem = divmod(n, 36)
        out = DIGITS[rem] + out
    return out


def _load() -> dict:
    try:
        d = json.loads(STATE.read_text())
        if not isinstance(d, dict):
            raise ValueError("not an object")
        d.setdefault("next", 1)
        d.setdefault("issued", {})
        return d
    except (OSError, ValueError):
        return {"next": 1, "issued": {}}


def _save(d: dict) -> None:
    STATE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(d, indent=1, sort_keys=True))
    os.replace(tmp, STATE)


def allocate(kind: str, count: int, role: str | None = None, slug: str | None = None,
             agent: str | None = None) -> list[str]:
    """Take `count` names from the sequence. Atomic: the whole read-modify-write holds an flock, so
    two agents allocating at once cannot receive the same number (the failure this exists to
    prevent).

    `kind` is `seat` (a tab, an identity: `<role> <n>`) or `workspace` (a container:
    `<slug>-<n>-pw`). Both draw from the SAME counter, so a number never means two things.
    """
    STATE.parent.mkdir(parents=True, exist_ok=True)
    with open(LOCK, "w") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        try:
            d = _load()
            out = []
            for _ in range(count):
                n = int(d["next"])
                if kind == "workspace":
                    if not slug:
                        raise ValueError("workspace names need --slug")
                    name = f"{slug_slug(slug)}-{to_base36(n)}-pw"
                else:
                    name = f"{role or DEFAULT_ROLE} {to_base36(n)}"
                d["issued"][name] = {"at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                                     "n": n, "kind": kind, "id": agent or ""}
                d["next"] = n + 1
                out.append(name)
            _save(d)
            return out
        finally:
            fcntl.flock(lk, fcntl.LOCK_UN)


def slug_slug(title: str, max_len: int = 34) -> str:
    """A workspace slug from free text: lower case, hyphens, whole words, number-only words dropped.

    Deliberately the same transformation `skills/autorename/autorename.py` uses for a Paseo workspace
    name (`title_slug`), so a workspace this tool names is indistinguishable in style from one
    `autorename` names — two conventions for the same thing would be worse than either.
    """
    words = [w for w in re.sub(r"[^a-z0-9]+", " ", title.lower()).split()
             if not re.fullmatch(r"[0-9.-]+", w)]
    out = ""
    for w in words:
        cand = f"{out}-{w}" if out else w
        if len(cand) > max_len:
            break
        out = cand
    return out or "session"


def peek(count: int, role: str | None, kind: str = "seat", slug: str | None = None) -> list[str]:
    with open(LOCK, "w") as lk:
        fcntl.flock(lk, fcntl.LOCK_SH)
        try:
            d = _load()
            n0 = int(d["next"])
            if kind == "workspace":
                return [f"{slug_slug(slug or '')}-{to_base36(n0 + i)}-pw" for i in range(count)]
            return [f"{role or DEFAULT_ROLE} {to_base36(n0 + i)}" for i in range(count)]
        finally:
            fcntl.flock(lk, fcntl.LOCK_UN)


def cmd_next(a) -> int:
    for name in allocate(a.kind, a.count, role=a.role, slug=a.slug, agent=a.agent):
        print(name)
    return 0


def cmd_peek(a) -> int:
    for name in peek(a.count, a.role, kind=a.kind, slug=a.slug):
        print(name)
    return 0


def cmd_issued(a) -> int:
    d = _load()
    rows = sorted(d["issued"].items(), key=lambda kv: kv[1].get("n", 0), reverse=True)[:a.limit]
    if a.json:
        print(json.dumps([{"name": k, **v} for k, v in rows], indent=1))
        return 0
    for name, meta in rows:
        print(f"{name:20} {meta.get('at','?')}  {meta.get('id') or ''}")
    return 0


def _conc_worker(state: str, out: str) -> None:
    """Allocate 10 names in a separate PROCESS (module level so it is picklable)."""
    globals()["STATE"] = Path(state)
    globals()["LOCK"] = STATE.with_suffix(".lock")
    Path(out).write_text(json.dumps(allocate("Conc", 10)))


def cmd_check(a) -> int:
    """Prove the two properties that matter: monotonic (no reuse) and atomic under concurrency."""
    import multiprocessing as mp
    import tempfile

    problems: list[str] = []
    with tempfile.TemporaryDirectory() as tmp:
        state = str(Path(tmp) / "seq.json")
        globals()["STATE"] = Path(state)
        globals()["LOCK"] = STATE.with_suffix(".lock")

        # base 36, and the documented rollovers
        expect = {1: "1", 9: "9", 10: "a", 35: "z", 36: "10", 71: "1z", 1296: "100"}
        for n, want in expect.items():
            if to_base36(n) != want:
                problems.append(f"base36({n})={to_base36(n)} want {want}")

        # monotonic: no name ever repeats
        first = allocate("seat", 3, role="Test")
        second = allocate("seat", 3, role="Test")
        if len(set(first + second)) != 6:
            problems.append(f"names repeated: {first + second}")
        if first != ["Test 1", "Test 2", "Test 3"]:
            problems.append(f"unexpected first three: {first}")

        # a workspace draws from the SAME counter, so a number never means two things
        ws = allocate("workspace", 2, slug="Dann Home")
        if ws != ["dann-home-7-pw", "dann-home-8-pw"]:
            problems.append(f"unexpected workspace names: {ws}")

        # every number in this run must be distinct across BOTH kinds: a seat and a workspace must
        # never share one (that is the property the single counter buys).
        seen_numbers: list[str] = []
        for name in first + second + ws:
            m = re.search(r"(?:^| )([0-9a-z]+)(?:-pw)?$", name)
            if m:
                seen_numbers.append(m.group(1))
        if len(set(seen_numbers)) != len(seen_numbers):
            dupes = sorted({n for n in seen_numbers if seen_numbers.count(n) > 1})
            problems.append(f"a number was reused across seats and workspaces: {dupes}")

        # atomic: 6 processes x 10 names, every one distinct
        outs = [str(Path(tmp) / f"w{i}.json") for i in range(6)]
        procs = [mp.Process(target=_conc_worker, args=(state, o)) for o in outs]
        for p in procs:
            p.start()
        for p in procs:
            p.join(timeout=60)
            if p.exitcode != 0:
                problems.append(f"worker exit {p.exitcode}")
        names = [n for o in outs for n in json.loads(Path(o).read_text())]
        if len(names) != 60:
            problems.append(f"expected 60 names, got {len(names)}")
        if len(set(names)) != len(names):
            dupes = sorted({n for n in names if names.count(n) > 1})
            problems.append(f"CONCURRENT DUPLICATES (the bug this prevents): {dupes}")

    print("seat-name self-test")
    print(f"1. base-36 rendering: {'ok' if not problems else 'PROBLEM'}")
    print(f"2. monotonic, no reuse: {'ok' if not problems else 'PROBLEM'}")
    print(f"3. atomic under 6 concurrent allocators: {'ok' if not problems else 'PROBLEM'}")
    print("self-test: " + ("FAILED: " + "; ".join(problems) if problems else "PASS"))
    return 1 if problems else 0


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(prog="seat-name", description=__doc__.split("\n")[0])
    sub = p.add_subparsers(dest="command", required=True)
    n = sub.add_parser("next", help="allocate the next name(s)")
    n.add_argument("--role", default=DEFAULT_ROLE, help="for a seat: the role name")
    n.add_argument("--kind", choices=("seat", "workspace"), default="seat")
    n.add_argument("--slug", default=None, help="for a workspace: the slug before -<n>-pw")
    n.add_argument("--count", type=int, default=1)
    n.add_argument("--agent", default=None, help="the agent id this name is for (recorded)")
    n.set_defaults(func=cmd_next)
    k = sub.add_parser("peek", help="the next name(s), without consuming")
    k.add_argument("--role", default=DEFAULT_ROLE)
    k.add_argument("--kind", choices=("seat", "workspace"), default="seat")
    k.add_argument("--slug", default=None)
    k.add_argument("--count", type=int, default=1)
    k.set_defaults(func=cmd_peek)
    i = sub.add_parser("issued", help="what has been handed out")
    i.add_argument("--limit", type=int, default=20)
    i.add_argument("--json", action="store_true")
    i.set_defaults(func=cmd_issued)
    c = sub.add_parser("check", help="self-test: base-36 rendering, monotonic, atomic")
    c.set_defaults(func=cmd_check)
    a = p.parse_args(argv)
    return a.func(a)


if __name__ == "__main__":
    sys.exit(main())


def store_roots(store):
    """Directories a destination must not sit inside. Taken from the configuration, never from what exists:
    a missing directory store still keeps its own path as its root (a missing ~/hermes-memory must not turn
    $HOME into a root). A file root is guarded by its parent directory."""
    if store["kind"] == "sqlite":
        roots = []
        for f in store["files"]:
            roots.append(f.parent)
            if f.is_symlink():  # a link that may be followed: its target's directory is a source too
                target = Path(os.path.realpath(f))
                if Path(os.path.expanduser("~")).resolve() in target.parents:
                    roots.append(target.parent)
        return roots
    if store["kind"] == "sqlite-tree":
        roots = [store["root"]]
        if store["root"].is_symlink():  # a root link that may be followed: its target is a source too
            target = Path(os.path.realpath(store["root"]))
            if Path(os.path.expanduser("~")).resolve() in target.parents:
                roots.append(target)
        return roots
    home = Path(os.path.expanduser("~")).resolve()
    roots = []
    for label, p in store["roots"]:
        is_file = label in store.get("file_labels", [])
        roots.append(p.parent if is_file else p)
        if p.is_symlink():  # a root link that may be followed: its target (its directory, for a file) is a source too
            target = Path(os.path.realpath(p))
            if home in target.parents:  # a target outside HOME is never copied, so it is no source
                roots.append(target.parent if is_file else target)
    return roots


def utcnow():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def sha256_of(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


class SchemaGuardError(Exception):
    """A backed-up database holds a credential-looking table or column nobody has explained."""


def ro_connect(path):
    """A read-only connection (the URI keeps `?`, `#`, `%` and spaces in the path safe)."""
    return sqlite3.connect("file:" + quote(os.path.realpath(path), safe="/") + "?mode=ro", uri=True, timeout=30)


def schema_hits(con):
    """(table, column) pairs whose names look like credentials; column None = the table's own name."""
    hits = []
    for table, kind in con.execute("SELECT name, type FROM sqlite_master WHERE type IN ('table', 'view')").fetchall():
        if CRED_RE.search(table) and not COUNTER_RE.match(table):
            hits.append((table, None))
        for col in con.execute(f'PRAGMA table_info("{table}")'):
            if CRED_RE.search(col[1]) and not COUNTER_RE.match(col[1]):
                hits.append((table, col[1]))
    return sorted(hits, key=lambda h: (h[0], h[1] or ""))


def explained(store_name, table, column):
    """Why (table, column) may stay in a copy: it is scrubbed, or an ALLOW entry says why; else None."""
    spec = SCRUB.get(store_name, {})
    if table in spec.get("delete", []) or (table, column) in [tuple(x) for x in spec.get("null", [])]:
        return "scrubbed"
    for store_glob, table_glob, col_glob, reason in ALLOW:
        if fnmatch.fnmatchcase(store_name, store_glob) and fnmatch.fnmatchcase(table, table_glob) \
                and (col_glob is None or (column is not None and fnmatch.fnmatchcase(column, col_glob))):
            return reason
    return None


def scrub_copy(path, spec):
    """Delete the credential rows from the copy at path and VACUUM it; returns what was scrubbed."""
    con = sqlite3.connect(str(path), isolation_level=None)
    done = []
    try:
        con.execute("PRAGMA journal_mode=DELETE")
        con.execute("PRAGMA secure_delete=ON")
        tables = {r[0] for r in con.execute("SELECT name FROM sqlite_master WHERE type='table'")}
        for table in spec.get("delete", []):
            if table in tables:
                con.execute(f'DELETE FROM "{table}"')
                done.append(table)
        for table, col in spec.get("null", []):
            if table in tables and col in [c[1] for c in con.execute(f'PRAGMA table_info("{table}")')]:
                con.execute(f'UPDATE "{table}" SET "{col}" = NULL')
                done.append(f"{table}.{col}")
        con.execute("VACUUM")
    finally:
        con.close()
    return done


def guard_copy(store_name, path):
    """Raise SchemaGuardError when the copy at path has an unexplained credential-looking name."""
    con = sqlite3.connect(f"file:{quote(str(path), safe='/')}?mode=ro", uri=True)
    try:
        bad = [h for h in schema_hits(con) if not explained(store_name, *h)]
    finally:
        con.close()
    if bad:
        names = ", ".join(t if c is None else f"{t}.{c}" for t, c in bad)
        raise SchemaGuardError(f"credential-looking table/column name(s) not on the scrub list or allowlist: {names}")


def backup_sqlite(src, dst, store_name):
    """Online backup of one SQLite db: a consistent copy while the writer lives. The copy is scrubbed
    (SCRUB) and schema-checked before it replaces dst; returns the scrubbed tables."""
    tmp = dst.with_name(dst.name + ".part")
    dst.parent.mkdir(parents=True, exist_ok=True)
    source = ro_connect(src)
    scrubbed = []
    try:
        target = sqlite3.connect(str(tmp))
        try:
            source.backup(target)
        finally:
            target.close()
        if store_name in SCRUB:
            scrubbed = scrub_copy(tmp, SCRUB[store_name])
        guard_copy(store_name, tmp)
    except BaseException:
        for suffix in ("", "-wal", "-shm", "-journal"):
            Path(str(tmp) + suffix).unlink(missing_ok=True)
        raise
    finally:
        source.close()
    for suffix in ("-wal", "-shm", "-journal"):
        Path(str(tmp) + suffix).unlink(missing_ok=True)
    os.replace(tmp, dst)
    return scrubbed


class RootSymlinkError(OSError):
    """A configured store root that is a symlink and must not be followed (the reason leads the message)."""


class StoreRun:
    """One store's progress: skipped paths, errors, and (after finish) the files produced."""

    def __init__(self, store, out_dir):
        self.store = store
        self.out = out_dir
        self.started = utcnow()
        self.t0 = time.monotonic()
        self.errors = []
        self.skipped = []
        self.skipped_count = 0
        self.sources = []
        self.missing = []
        self.root_symlinks = []
        self.source_of = {}
        self.scrubbed_of = {}

    def error(self, source, exc):
        msg = f"{type(exc).__name__}: {exc}"
        self.errors.append({"store": self.store["name"], "source": str(source), "error": msg})

    def skip(self, path, why):
        self.skipped_count += 1
        if why.startswith("symlink"):  # a skip is deliberate and leaves the store ok; stderr keeps it visible
            print(f"ade-backup-stores: {self.store['name']}: skipped {path}: symlink", file=sys.stderr)
        if len(self.skipped) < SKIPPED_CAP:
            self.skipped.append({"path": str(path), "why": why})

    def absent(self, path):
        """A configured source that does not exist (a partially provisioned machine): not an error."""
        self.missing.append(str(path))


def make_ignore(run, excluder):
    def ignore(directory, names):
        out = []
        for n in names:
            p = os.path.join(directory, n)
            if is_excluded_name(n) or excluder.path(p):
                out.append(n)
                run.skip(p, "excluded credential path")
            elif os.path.islink(p):
                out.append(n)
                run.skip(p, "symlink")
            elif not (os.path.isfile(p) or os.path.isdir(p)):
                out.append(n)
                run.skip(p, "not a regular file")
            elif n == "worktrees" and os.path.basename(directory) == ".system_generated":
                out.append(n)
                run.skip(p, "git checkout inside an antigravity brain dir")
        return out
    return ignore


def root_link_target(src, excluder):
    """A configured store root that is a symlink: (resolved target, None) when it may be followed, else
    (None, reason). Followed only when every link resolves to an existing path under the run's real $HOME and
    neither the link nor the target is a credential path. Links *inside* the tree are never followed."""
    try:
        target = Path(src).resolve()
    except (OSError, RuntimeError):
        return None, "dangling symlink"
    if not os.path.lexists(target):
        return None, "dangling symlink"
    if target != excluder.real_home and excluder.real_home not in target.parents:
        return None, "symlink target outside HOME"
    if excluder.path(target):
        return None, "symlink target excluded"
    if not (target.is_dir() or target.is_file()):
        return None, "symlink target is not a regular file or directory"
    return target, None


def follow_link(src, label, run, excluder):
    """A configured path that is a symlink: its target when `root_link_target` allows it (recorded in
    run.root_symlinks), else None after an error that names the reason (the store is then partial)."""
    real, why = root_link_target(src, excluder)
    if why:
        run.error(src, RootSymlinkError(f"{why}: {src} -> {os.readlink(src)}"))
        return None
    run.root_symlinks.append({"root": label, "link": str(src), "target": str(real)})
    return real


def under_symlink(path, root):
    """True when `path` or any directory between `root` and it is a symlink. `root` itself is taken as
    configured and never tested; a path outside it counts as linked."""
    try:
        parts = Path(path).relative_to(root).parts
    except ValueError:
        return True
    cur = Path(root)
    for part in parts:
        cur = cur / part
        if cur.is_symlink():
            return True
    return False


def copy_file_store(store, run, excluder):
    for label, src in store["roots"]:
        dst = run.out / label
        run.sources.append(str(src))
        try:
            if excluder.path(src, follow=not src.is_symlink()):
                run.skip(src, "excluded credential path")
                continue
            if not os.path.lexists(src):
                run.absent(src)
                continue
            real = src
            if src.is_symlink():
                real = follow_link(src, label, run, excluder)
                if real is None:
                    continue
            if real.is_dir():
                try:
                    shutil.copytree(real, dst, symlinks=True, ignore=make_ignore(run, excluder),
                                    copy_function=shutil.copy2)
                except shutil.Error as exc:
                    for item in exc.args[0]:
                        run.error(item[0], OSError(item[2]))
            else:
                dst.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(real, dst, follow_symlinks=False)
        except OSError as exc:
            run.error(src, exc)


def copy_sqlite_store(store, run, excluder):
    for src in store["files"]:
        run.sources.append(str(src))
        dst = run.out / src.name
        try:
            if excluder.path(src, follow=not src.is_symlink()):
                run.skip(src, "excluded credential path")
                continue
            if not os.path.lexists(src):
                run.absent(src)
                continue
            real = src
            if src.is_symlink():
                real = follow_link(src, src.name, run, excluder)
                if real is None:
                    continue
            run.scrubbed_of[dst] = backup_sqlite(real, dst, store["name"])
            run.source_of[dst] = str(src)
        except (OSError, sqlite3.Error, SchemaGuardError) as exc:
            run.error(src, exc)


def tree_dbs(store, root=None):
    """The databases a sqlite-tree store matches below `root` (default: its configured root)."""
    root = root or store["root"]
    found = []
    for pat in store["dbs"]:
        found.extend(p for p in sorted(root.glob(pat)) if p.is_file())
    return found


def tree_root(store, run, excluder):
    """The directory a sqlite-tree store is searched from: its configured root, or that root's target when the
    root is a symlink and the root-link rule allows it (recorded in run.root_symlinks, labelled with the root as
    configured). None after `run.absent` or `run.error`: nothing is searched."""
    root = store["root"]
    if not os.path.lexists(root):
        run.absent(root)
        return None
    real = root
    if root.is_symlink():
        real = follow_link(root, str(root), run, excluder)
        if real is None:
            return None
    if not real.is_dir():
        run.error(root, NotADirectoryError("store root is not a directory"))
        return None
    return real


def wal_size(db):
    """Bytes of the database's -wal file when one exists (a regular file): the dry run's estimate of a
    SQLite snapshot is the main file plus its WAL, an upper bound on what the online backup produces,
    since committed pages may still live only in the WAL (Codex on PR 24)."""
    wal = db.with_name(db.name + "-wal")
    try:
        return wal.stat().st_size if wal.is_file() and not wal.is_symlink() else 0
    except OSError:
        return 0


def sidecar_gap(side, excluder):
    """Why the sidecar at `side` cannot be copied, or None when it can. Callers reach it only for a db that
    already passed `under_symlink`, and a sidecar sits in that db's directory, so no linked directory
    component can lie above it; the sidecar file itself may still be a link."""
    if side.is_symlink():
        return "is a symlink"
    if excluder.path(side):
        return "is an excluded path"
    if not side.is_file():
        return "is absent"
    return None


def required_sidecar_error(side, why):
    return FileNotFoundError(f"required sidecar {side.name} {why}: the session's db copy is not lossless")


def store_status(run):
    """missing: no configured source exists; partial: the store has errors; else ok."""
    if run.missing and len(run.missing) == len(run.sources):
        return "missing"
    return "partial" if run.errors else "ok"


def copy_tree_store(store, run, excluder):
    configured = store["root"]
    run.sources.append(str(configured))
    root = tree_root(store, run, excluder)
    if root is None:
        return
    try:
        dbs = tree_dbs(store, root)
    except OSError as exc:
        run.error(configured, exc)
        return
    for src in dbs:
        if under_symlink(src, root):  # tree_dbs globs through linked directories and Path.is_file() follows links
            run.skip(src, "symlink")
            continue
        if is_excluded_name(src.name) or excluder.path(src):
            run.skip(src, "excluded credential path")
            continue
        dst = run.out / src.relative_to(root)
        try:
            run.scrubbed_of[dst] = backup_sqlite(src, dst, store["name"])
            run.source_of[dst] = str(src)
        except (OSError, sqlite3.Error, SchemaGuardError) as exc:
            run.error(src, exc)
            continue
        for pat in store["sidecars"]:
            side = src.parent / pat.format(stem=src.stem, name=src.name)
            why = sidecar_gap(side, excluder)
            if not why:
                try:
                    shutil.copy2(side, dst.parent / side.name)
                    continue
                except FileNotFoundError:
                    why = "vanished during the copy"
                except OSError as exc:
                    run.error(side, exc)
                    continue
            if pat in store.get("required", []):
                run.error(src.parent.relative_to(root), required_sidecar_error(side, why))


def seal_and_hash(run):
    """Drop symlinks a race let into the copy, set 0700/0600 on everything produced and hash each file;
    returns (entries, bytes)."""
    entries = []
    total = 0
    if not run.out.exists():
        return entries, total
    for dirpath, dirnames, filenames in os.walk(run.out):
        for name in list(dirnames) + list(filenames):
            link = Path(dirpath) / name
            if link.is_symlink():
                link.unlink()
                run.skip(link, "symlink (appeared after the check)")
                if name in dirnames:
                    dirnames.remove(name)
                else:
                    filenames.remove(name)
        os.chmod(dirpath, 0o700)
        for fn in sorted(filenames):
            p = Path(dirpath) / fn
            try:
                os.chmod(p, 0o600)
                size = p.stat().st_size
                entry = {"path": str(p.relative_to(run.out.parent)), "bytes": size, "sha256": sha256_of(p)}
                if p in run.source_of:
                    entry["source"] = run.source_of[p]
                if run.scrubbed_of.get(p):
                    entry["scrubbed"] = run.scrubbed_of[p]
                entries.append(entry)
                total += size
            except OSError as exc:
                run.error(p, exc)
    return entries, total


def run_store(store, work, excluder, final):
    """Copy one store into work/<name>; the manifest entry names it under final/<name>."""
    run = StoreRun(store, work / store["name"])
    {"sqlite": copy_sqlite_store, "sqlite-tree": copy_tree_store, "files": copy_file_store}[store["kind"]](
        store, run, excluder)
    entries, total = seal_and_hash(run)
    scrubbed = sorted({t for v in run.scrubbed_of.values() for t in v})
    return run, {
        "store": store["name"], "kind": store["kind"], "status": store_status(run), "sources": run.sources,
        "missing": run.missing, "root_symlinks": run.root_symlinks, "destination": str(final / store["name"]),
        "bytes": total,
        "file_count": len(entries), "files": entries,
        "started": run.started, "ended": utcnow(), "seconds": round(time.monotonic() - run.t0, 1),
        "skipped_count": run.skipped_count, "skipped": run.skipped, "scrubbed": scrubbed, "errors": run.errors,
    }


def plan_store(store, excluder):
    """--dry-run: what the store would produce, without writing anything."""
    run = StoreRun(store, Path("/nonexistent"))
    count = size = 0
    if store["kind"] == "sqlite":
        for f in store["files"]:
            run.sources.append(str(f))
            if excluder.path(f, follow=not f.is_symlink()):
                continue
            real = f
            if f.is_symlink():
                real = follow_link(f, f.name, run, excluder)
                if real is None:
                    continue
            if real.is_file():
                count += 1
                size += real.stat().st_size + wal_size(real)
            elif not os.path.lexists(f):
                run.absent(f)
            else:
                run.error(f, OSError("not a regular file"))
    elif store["kind"] == "sqlite-tree":
        run.sources.append(str(store["root"]))
        root = tree_root(store, run, excluder)
        if root is not None:
            for db in tree_dbs(store, root):
                if under_symlink(db, root):
                    run.skip(db, "symlink")
                    continue
                count += 1
                size += db.stat().st_size + wal_size(db)
                for pat in store["sidecars"]:
                    side = db.parent / pat.format(stem=db.stem, name=db.name)
                    why = sidecar_gap(side, excluder)
                    if not why:
                        count += 1
                        size += side.stat().st_size
                    elif pat in store.get("required", []):
                        run.error(db.parent.relative_to(root), required_sidecar_error(side, why))
    else:
        for label, src in store["roots"]:
            run.sources.append(str(src))
            if excluder.path(src, follow=not src.is_symlink()):
                continue
            real = src
            if src.is_symlink():
                real = follow_link(src, label, run, excluder)
                if real is None:
                    continue
            if real.is_dir():
                for dirpath, dirnames, filenames in os.walk(real):
                    ig = set(make_ignore(run, excluder)(dirpath, dirnames + filenames))
                    dirnames[:] = [d for d in dirnames if d not in ig]
                    for fn in filenames:
                        if fn not in ig:
                            try:
                                size += os.stat(os.path.join(dirpath, fn)).st_size
                                count += 1
                            except OSError as exc:
                                run.error(os.path.join(dirpath, fn), exc)
            elif real.is_file():
                count += 1
                size += real.stat().st_size
            elif not os.path.lexists(src):
                run.absent(src)
            else:
                run.error(src, OSError("not a regular file"))
    return {"store": store["name"], "kind": store["kind"], "status": store_status(run), "sources": run.sources,
            "missing": run.missing, "root_symlinks": run.root_symlinks, "file_count": count, "bytes": size, "skipped_count": run.skipped_count, "errors": run.errors}


def resolve_dest(arg):
    if arg:
        return Path(os.path.abspath(os.path.expanduser(arg))).resolve()
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    return Path(os.path.expanduser("~/.local/state/ade/backups")).resolve() / stamp


def refuse_reason(dest, stores):
    """Why dest must not be written to, or None."""
    for store in stores:
        for root in store_roots(store):
            r = root.resolve()
            if dest == r or r in dest.parents:
                return f"destination {dest} is inside the {store['name']} source store {r}"
            if dest in r.parents:
                return f"destination {dest} holds the {store['name']} source store {r}"
    for p in [dest, *dest.parents]:
        if (p / ".git").exists():
            return f"destination {dest} is inside the git repository {p}"
    part = part_dir(dest)
    for p in (dest, part):
        if os.path.lexists(p):
            return f"{p} already exists (--dest must name a new directory; a leftover .part is an interrupted run)"
    return None


def part_dir(dest):
    """Where the generation is built until it is complete."""
    return dest.with_name(dest.name + ".part")


def hermes_limit(home):
    """sessions.max_export_messages from config.yaml; the Hermes default (20,000) when unset."""
    try:
        text = (home / ".hermes/config.yaml").read_text()
    except OSError:
        return 20000
    m = re.search(r"^\s*max_export_messages:\s*(\d+)", text, re.M)
    return int(m.group(1)) if m else 20000


def hermes_session_counts(db_path):
    con = ro_connect(db_path)
    try:
        ids = [r[0] for r in con.execute("SELECT id FROM sessions")]
        counts = dict(con.execute("SELECT session_id, COUNT(*) FROM messages GROUP BY session_id"))
    finally:
        con.close()
    return ids, counts


def hermes_run(hermes, args, cwd, env):
    proc = subprocess.run([hermes, "sessions", "export", *args], capture_output=True, text=True, errors="replace",
                          timeout=HERMES_TIMEOUT, cwd=cwd, env=env)
    return proc.returncode, (proc.stdout + proc.stderr).strip()


def exported_count(text):
    """N from "Exported N session(s) ...", or None."""
    m = re.match(r"Exported (\d+)", text)
    return int(m.group(1)) if m else None


def make_hermes_scratch(home, scratch, state_backup, limit):
    """A HERMES_HOME that holds only a copy of the hermes-state backup (taken here, scrubbed and guarded like
    any other copy, when the backup step did not produce one) and a config.yaml with the export limit."""
    scratch.mkdir(mode=0o700)
    if state_backup and state_backup.is_file():
        shutil.copyfile(state_backup, scratch / "state.db")
    else:
        backup_sqlite(home / ".hermes/state.db", scratch / "state.db", "hermes-state")
    (scratch / "config.yaml").write_text(f"sessions:\n  max_export_messages: {limit}\n")


def export_hermes(home, work, final, state_backup):
    """The documented `hermes sessions export` JSONL, into <dest>/hermes-export/, read from a scratch copy."""
    out = work / "hermes-export"
    run = StoreRun({"name": "hermes-export", "kind": "hermes-export"}, out)
    run.sources.append(str(home / ".hermes/state.db"))
    info = {"mode": None, "limit": hermes_limit(home), "truncated": False, "oversize": [], "failed": [],
            "sessions_total": None, "sessions_exported": 0, "snapshot": "scratch HERMES_HOME holding a copy of hermes-state"}
    hermes = os.environ.get("ADE_BACKUP_HERMES") or shutil.which("hermes")
    out.mkdir(parents=True, exist_ok=True)
    scratch = work / ".hermes-scratch"
    if not os.path.lexists(home / ".hermes/state.db"):
        run.absent(home / ".hermes/state.db")
    elif not hermes:
        run.error("hermes", FileNotFoundError("no hermes on PATH (set ADE_BACKUP_HERMES)"))
    else:
        try:
            make_hermes_scratch(home, scratch, state_backup, info["limit"])
            env = {**os.environ, "HERMES_HOME": str(scratch)}
            bulk = out / "hermes_sessions.jsonl"
            rc, text = hermes_run(hermes, [str(bulk)], str(out), env)
            n = exported_count(text)
            if rc == 0 and bulk.is_file() and n is not None:
                info["mode"] = "bulk"
                info["sessions_exported"] = info["sessions_total"] = n
            elif "more than" in text:
                info["mode"] = "per-session"
                per_session_export(hermes, scratch, out, info, run, env)
            else:
                run.error("hermes sessions export", RuntimeError(f"rc={rc}: {text[:300]}"))
        except (OSError, subprocess.SubprocessError, sqlite3.Error, SchemaGuardError) as exc:
            run.error("hermes sessions export", exc)
        finally:
            shutil.rmtree(scratch, ignore_errors=True)
    info["truncated"] = bool(info["oversize"])
    entries, total = seal_and_hash(run)
    return run, {
        "store": "hermes-export", "kind": "hermes-export", "status": store_status(run), "sources": run.sources,
        "missing": run.missing, "destination": str(final / "hermes-export"), "bytes": total,
        "file_count": len(entries), "files": entries,
        "started": run.started, "ended": utcnow(), "seconds": round(time.monotonic() - run.t0, 1),
        "skipped_count": run.skipped_count, "skipped": run.skipped, "errors": run.errors, "hermes_export": info,
    }


def per_session_export(hermes, scratch, out, info, run, env):
    ids, counts = hermes_session_counts(scratch / "state.db")
    info["sessions_total"] = len(ids)
    limit = info["limit"]
    todo = []
    for sid in ids:
        n = counts.get(sid, 0)
        if limit and n > limit:
            info["oversize"].append({"id": sid, "messages": n})
        elif re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.-]*", sid):
            todo.append(sid)
        else:
            info["failed"].append({"id": sid, "error": "unsafe session id"})
    target = out / "sessions"
    target.mkdir(parents=True, exist_ok=True)

    def one(sid):
        path = target / f"{sid}.jsonl"
        try:
            rc, text = hermes_run(hermes, [str(path), f"--session-id={sid}"], str(out), env)
        except (OSError, subprocess.SubprocessError) as exc:
            return sid, None, f"{type(exc).__name__}: {exc}"
        if rc == 0 and path.is_file() and exported_count(text) is not None:
            return sid, True, None
        return sid, False, text[:300]

    with concurrent.futures.ThreadPoolExecutor(max_workers=HERMES_WORKERS) as pool:
        for sid, ok, why in pool.map(one, todo):
            if ok:
                info["sessions_exported"] += 1
            elif why and "more than" in why:
                info["oversize"].append({"id": sid, "messages": counts.get(sid, 0)})
            else:
                info["failed"].append({"id": sid, "error": why})
    for item in info["failed"]:
        run.error(f"hermes session {item['id']}", RuntimeError(item["error"]))


def write_manifest(dest, manifest):
    path = dest / "MANIFEST.json"
    tmp = dest / "MANIFEST.json.part"
    with open(tmp, "w") as f:
        json.dump(manifest, f, indent=1)
        f.write("\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)
    return path


def summary_line(entry):
    errs = len(entry["errors"])
    return (f"{entry['store']}: {entry['file_count']} files, {entry['bytes']} bytes"
            + (f", {entry.get('seconds', 0)}s" if "seconds" in entry else "")
            + (", store missing" if entry.get("status") == "missing" else "")
            + (f", {errs} error(s)" if errs else ""))


def report_missing(entries):
    """One stderr line per store with a configured path that does not exist; returns how many stores."""
    n = 0
    for e in entries:
        if e["missing"]:
            n += 1
            print(f"ade-backup-stores: store {e['store']}: missing: {', '.join(e['missing'])}", file=sys.stderr)
    return n


def report_empty(entries):
    """One stderr line per store with a configured path that exists and no error but no file produced: a store
    whose roots all vanished from the copy must not look like success. Not an error (an empty store is real)."""
    for e in entries:
        sources = e.get("sources", [])
        if e["file_count"] == 0 and not e["errors"] and len(e["missing"]) < len(sources):
            print(f"ade-backup-stores: {e['store']}: 0 files copied although its roots exist", file=sys.stderr)


def check_schemas(stores, excluder):
    """--check-schemas: the schema guard on the live databases, read-only; prints names only. A database
    inside a per-session tree that is a symlink or sits under a symlinked directory is never opened; a
    configured SQLite path that is a symlink is opened through its target when the root-link rule allows
    it (`symlink -> target`, information) and refused otherwise (`symlink refused`). Both refusals count as
    symlink problems, apart from the credential-looking names."""
    problems = link_problems = 0
    for store in stores:
        if store["kind"] == "sqlite":
            dbs = list(store["files"])
        elif store["kind"] == "sqlite-tree":
            search = store["root"]
            if search.is_symlink():
                search, why = root_link_target(store["root"], excluder)
                if why:
                    print(f"{store['name']}: {store['root']}: symlink refused: {why}")
                    link_problems += 1
                    continue
                print(f"{store['name']}: {store['root']}: symlink -> {search}")
            dbs = tree_dbs(store, search) if search.is_dir() else []
        else:
            continue
        for db in dbs:
            target = db
            if store["kind"] == "sqlite-tree" and under_symlink(db, search):
                print(f"{store['name']}: {db}: symlink, not opened")
                link_problems += 1
                continue
            if store["kind"] == "sqlite" and db.is_symlink():
                target, why = root_link_target(db, excluder)
                if why:
                    print(f"{store['name']}: {db}: symlink refused: {why}")
                    link_problems += 1
                    continue
                print(f"{store['name']}: {db}: symlink -> {target}")
            if not target.is_file():
                print(f"{store['name']}: {db}: missing")
                continue
            try:
                con = ro_connect(target)
                try:
                    hits = schema_hits(con)
                finally:
                    con.close()
            except (OSError, sqlite3.Error) as exc:
                print(f"{store['name']}: {db}: ERROR {type(exc).__name__}: {exc}")
                problems += 1
                continue
            for table, col in hits:
                name = table if col is None else f"{table}.{col}"
                why = explained(store["name"], table, col)
                if not why:
                    problems += 1
                print(f"{store['name']}: {db.name}: {name}: {why or 'UNEXPLAINED'}")
    print(f"schema check: {problems} unexplained credential-looking name(s), {link_problems} symlink problem(s)")
    return 1 if problems or link_problems else 0


def main(argv=None):
    old_umask = os.umask(0o077)
    try:
        return run_main(argv)
    finally:
        os.umask(old_umask)


def run_main(argv):
    ap = argparse.ArgumentParser(prog="ade-backup-stores", description=__doc__.split("\n\n")[0], epilog=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--dest", help="new backup directory (default ~/.local/state/ade/backups/<UTC timestamp>/)")
    ap.add_argument("--dry-run", action="store_true", help="print what would be backed up; write nothing")
    ap.add_argument("--only", help="comma-separated store names (hermes-export is one)")
    ap.add_argument("--json", action="store_true", help="print a machine-readable summary on stdout")
    ap.add_argument("--check-schemas", action="store_true",
                    help="run the credential schema guard on the live databases (read-only, names only); write nothing")
    ap.add_argument("--strict-stores", action="store_true",
                    help="exit 1 when any configured store or store path is missing (default: recorded as "
                         "status \"missing\" in the manifest and on stderr, exit 0)")
    args = ap.parse_args(argv)

    home = Path(os.path.expanduser("~"))
    stores = build_stores(home)
    names = [s["name"] for s in stores] + ["hermes-export"]
    wanted = [n.strip() for n in args.only.split(",") if n.strip()] if args.only else names
    unknown = [n for n in wanted if n not in names]
    if unknown:
        print(f"ade-backup-stores: unknown store(s): {', '.join(unknown)}", file=sys.stderr)
        return 2
    selected = [s for s in stores if s["name"] in wanted]
    if args.check_schemas:
        return check_schemas(selected, Excluder(home))
    dest = resolve_dest(args.dest)
    reason = refuse_reason(dest, stores)
    if reason:
        print(f"ade-backup-stores: refusing: {reason}", file=sys.stderr)
        return 2
    excluder = Excluder(home)
    say = (lambda *a: None) if args.json else print

    if args.dry_run:
        plans = [plan_store(s, excluder) for s in selected]
        for p in plans:
            say(summary_line(p) + " (dry run)")
        hermes_db = home / ".hermes/state.db"
        hermes_missing = "hermes-export" in wanted and not os.path.lexists(hermes_db)
        if "hermes-export" in wanted:
            say(f"hermes-export: would skip, {hermes_db} is missing (dry run)" if hermes_missing else
                f"hermes-export: would run `hermes sessions export` into {dest / 'hermes-export'} (dry run)")
        report_empty(plans)
        n_missing = report_missing(plans + ([{"store": "hermes-export", "missing": [str(hermes_db)]}]
                                            if hermes_missing else []))
        total = sum(p["bytes"] for p in plans)
        errors = [e for p in plans for e in p["errors"]]
        say(f"total: {total} bytes would be copied to {dest} (dry run, nothing written)")
        if args.json:
            print(json.dumps({"dry_run": True, "dest": str(dest), "total_bytes": total, "stores": plans,
                              "errors": errors}, indent=1))
        return 1 if errors or (args.strict_stores and n_missing) else 0

    started = utcnow()
    t0 = time.monotonic()
    work = part_dir(dest)
    try:
        dest.parent.mkdir(parents=True, exist_ok=True)
        work.mkdir(mode=0o700)
    except FileExistsError:
        print(f"ade-backup-stores: refusing: {work} already exists", file=sys.stderr)
        return 2
    except OSError as exc:
        print(f"ade-backup-stores: cannot create {work}: {exc}", file=sys.stderr)
        return 2
    entries, errors = [], []
    for store in selected:
        run, entry = run_store(store, work, excluder, dest)
        entries.append(entry)
        errors.extend(entry["errors"])
        say(summary_line(entry))
    if "hermes-export" in wanted:
        state_backup = work / "hermes-state" / "state.db"
        run, entry = export_hermes(home, work, dest, state_backup)
        entries.append(entry)
        errors.extend(entry["errors"])
        info = entry["hermes_export"]
        say(summary_line(entry) + (f", {len(info['oversize'])} oversize session(s) not exported" if info["truncated"] else ""))
    report_empty(entries)
    n_missing = report_missing(entries)
    total = sum(e["bytes"] for e in entries)
    manifest = {
        "version": VERSION, "tool": "bin/ade-backup-stores", "host": socket.gethostname(), "dest": str(dest),
        "started": started, "ended": utcnow(), "seconds": round(time.monotonic() - t0, 1), "total_bytes": total,
        "exclusions": {"names": EXCLUDE_NAMES, "paths": [f"~/{p}" for p in EXCLUDE_PATHS], "other": OTHER_SKIPS,
                       "scrubbed_tables": {k: v["delete"] + [f"{t}.{c}" for t, c in v["null"]]
                                           for k, v in SCRUB.items()}},
        "errors": errors, "stores": entries,
    }
    write_manifest(work, manifest)
    try:
        os.rename(work, dest)
    except OSError as exc:
        print(f"ade-backup-stores: could not rename {work} to {dest}: {exc}; the generation stays in {work}",
              file=sys.stderr)
        return 1
    path = dest / "MANIFEST.json"
    say(f"total: {total} bytes in {sum(e['file_count'] for e in entries)} files, {len(errors)} error(s), manifest {path}")
    if args.json:
        print(json.dumps({"dest": str(dest), "manifest": str(path), "total_bytes": total, "errors": errors,
                          "stores": [{k: e[k] for k in ("store", "status", "missing", "file_count", "bytes", "seconds")}
                                     for e in entries]},
                         indent=1))
    return 1 if errors or (args.strict_stores and n_missing) else 0


if __name__ == "__main__":
    sys.exit(main())

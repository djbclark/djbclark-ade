#!/usr/bin/env python3
"""ade-backup-stores: one consistent copy of every agent session store, plus the Hermes JSONL export.

ADE-everywhere Phase 0 (docs/ade-everywhere-proposal.md section 8 item 1), implementing section 3 of
docs/ade-everywhere-inventory-2026-10-20-stores.md. Nothing in any source store is deleted or modified:
SQLite sources are opened `mode=ro` (which can still create zero-length `-wal`/`-shm` files beside a quiet
database; no data changes), and the live Hermes `state.db` is never handed to `hermes` (see item 4).

  ade-backup-stores [--dest DIR] [--dry-run] [--only NAME[,NAME]] [--json] [--check-schemas]

  1. single live SQLite files: the SQLite online backup API (`Connection.backup`), never a `cp` of a
     WAL database;
  2. per-session SQLite trees (Cursor, Antigravity): each db the same way, its sidecar (`meta.json`,
     `<uuid>.meta`) copied beside it;
  3. file stores: `shutil.copytree` with an ignore function that drops every credential file name and path
     (inventory section 5 item 5), the `credential-bak` vault, symlinks and non-regular files;
  4. `hermes sessions export` (JSONL) into <dest>/hermes-export/, run with HERMES_HOME pointing at a scratch
     copy of the hermes-state backup (removed afterwards), so `hermes` never opens the live state.db and the
     session ids, counts and exports all come from one snapshot. The export refuses a session above
     `sessions.max_export_messages` (20,000 by default) and the bulk form refuses everything when any
     session is over it: then each session under the limit is exported alone and the oversize ones are
     listed in the manifest (`hermes_export.truncated`); the hermes-state copy holds them whole.
     ADE_BACKUP_HERMES names the `hermes` binary to run (default: `hermes` on PATH).

What the tool guarantees about credentials: files and directories with a credential name or path (the
exclusions in MANIFEST.json) are not copied; credential tables are scrubbed from the SQLite copies
(manifest `scrubbed`: OpenCode's `credential`, `account`, `control_account`, `account_state` tables and
`session_share.secret`; rows deleted, then `VACUUM` with `secure_delete`); and a schema guard turns any
other table or column named like credential/account/auth/oauth/secret/token (counters such as
`input_tokens` aside) into an error and drops that copy, so a tool update that adds one fails the run.
`--check-schemas` runs the guard read-only on the live databases and prints table and column names only.
Transcripts and other session content are copied as they are and can hold secrets pasted into them:
treat a generation as secret-bearing.

<dest>/MANIFEST.json records, per store, the source, destination, bytes, sha256 of each file produced,
start and end time, the exclusions applied, the scrubbed tables and the errors. A missing, locked or
unreadable store is an error in the manifest, the run goes on, and the exit status is 1 at the end.

Default dest: ~/.local/state/ade/backups/<UTC timestamp>/ (0700, files 0600). The generation is built in
<dest>.part/ and renamed to <dest>/ at the end: a <dest>.part/ directory, or a generation without
MANIFEST.json, is an interrupted run and incomplete. Refuses (exit 2) a dest that exists, that sits
inside a source store or holds one, or that is inside a git repo. Exit: 0 clean, 1 at least one error,
2 refused or bad usage. Cursor `acp-sessions` and the handoffs `chains/` are pruned by something else,
so those stores come first.
"""
import argparse
import concurrent.futures
import datetime
import fnmatch
import hashlib
import json
import os
import re
import shutil
import socket
import sqlite3
import subprocess
import sys
import time
from pathlib import Path
from urllib.parse import quote

VERSION = 1
SKIPPED_CAP = 100
HERMES_WORKERS = 4
HERMES_TIMEOUT = 300

# Inventory section 5 item 5: basenames that never enter a backup, wherever they sit in a copied
# tree. Each pattern also matches its dated `.bak` copies (`mcp.json.bak-2026-10-12`).
EXCLUDE_NAMES = [
    "*.key", ".credentials.json", ".claude.json", "auth.json", "oauth_creds.json", "credentials.json",
    "acp_token.json", "daemon-keypair.json", "local-credential", "hyper.json", "providers.json",
    ".env", ".env.*", "jira-sites.json", "jira-tokens", "Cookies", "agent.db", "data.db",
    "mcp_config.json", "mcp.json", "opencode.json", "opencode.bak", "crushrc*",
    "credential-bak", "mcp-auth.json",
]
# The same list as home-relative paths (the files the inventory names, checked on the resolved path too).
EXCLUDE_PATHS = [
    ".claude/.credentials.json", ".claude.json", ".claude/sessions/*.key", ".codex/auth.json",
    ".gemini/oauth_creds.json", ".local/share/opencode/auth.json", ".grok/auth.json",
    ".zcode/v2/credentials.json", ".paseo/daemon-keypair.json", ".paseo/local-credential",
    ".gemini/antigravity-acp/acp_token.json", ".hermes/.env", ".cline/data/settings/providers.json",
    ".omp/agent/agent.db", ".local/share/crush/hyper.json", ".copilot/data.db", ".orca/jira-tokens",
    ".orca/jira-sites.json", ".config/opencode/opencode.json", ".cursor/mcp.json",
    ".gemini/config/mcp_config.json", ".config/crush/crushrc*", ".local/state/ade/credential-bak",
]
OTHER_SKIPS = ["symlinks", "sockets and other non-regular files", "antigravity brain/*/.system_generated/worktrees"]

# Credential tables scrubbed from the copy of a SQLite db (inventory section 5 item 5), per store name:
# "delete" tables lose every row, "null" (table, column) pairs are set to NULL; then VACUUM with
# secure_delete=ON so freed pages do not keep the bytes. A table or column that is absent is skipped.
SCRUB = {
    "opencode": {"delete": ["credential", "account", "control_account", "account_state"],
                 "null": [("session_share", "secret")]},
}
# Schema guard: a table or column name matching this is a possible credential store ...
CRED_RE = re.compile(r"credential|account|auth(?!or)|oauth|secret|token|password|passwd|api_?key|private_?key|bearer",
                     re.I)
# ... unless it is a token counter (`input_tokens`, `tokens_used`, `tokens`) ...
COUNTER_RE = re.compile(
    r"^(?:(?:input|output|cache|cached|creation|read|write|reasoning|total|prompt|completion|max|context|used|est|estimated)_?)*"
    r"tokens(?:_?(?:input|output|cache|cached|creation|read|write|reasoning|total|prompt|completion|max|used|count|limit|in|out))*$",
    re.I)
# ... or listed here: (store glob, table glob, column glob or None for the table and all its columns, reason).
# Each entry was reviewed on 2026-10-20 against the live schemas (`--check-schemas`, names only); none holds
# a credential. A tool update that adds another matching name fails the run until someone reads it.
ALLOW = [
    # token usage metrics and budgets, not credentials
    ("hermes-state", "messages", "token_count", "count of tokens in a message"),
    ("zcode-db", "dwf_run", "spent_tokens", "tokens spent by a workflow run"),
    ("zcode-db", "model_usage", "computed_total_tokens", "token usage counter"),
    ("zcode-db", "model_usage", "provider_total_tokens", "token usage counter"),
    ("zcode-db", "model_usage", "first_token_at", "timestamp of the first streamed token"),
    ("zcode-db", "model_usage", "time_to_first_token_ms", "latency metric"),
    ("zcode-db", "turn_usage", "computed_total_tokens", "token usage counter"),
    ("zcode-db", "turn_usage", "first_token_at", "timestamp of the first streamed token"),
    ("zcode-db", "turn_usage", "time_to_first_token_ms", "latency metric"),
    ("zcode-db", "session_target", "token_budget", "token budget of a session target"),
    ("codex-db", "thread_goals", "token_budget", "token budget of a thread goal"),
    ("copilot-db", "assistant_usage_events", "inter_token_latency_ms", "latency metric"),
    ("copilot-db", "assistant_usage_events", "time_to_first_token_ms", "latency metric"),
    ("copilot-db", "assistant_usage_events", "token_details_json", "per-event token usage breakdown (a usage-event row)"),
    # identifiers and job leases, not secrets
    ("codex-db", "remote_control_enrollments", "account_id", "account identifier; the table has no secret column"),
    ("codex-db", "threads", "creator_account_id", "account identifier of the thread creator"),
    ("codex-db", "jobs", "ownership_token", "work-queue lease marker for a memories job"),
    ("cline-db", "cron_runs", "claim_token", "work-queue lease marker for a cron run"),
    ("cline-db", "schedules", "claim_token", "work-queue lease marker for a schedule"),
    ("cline-db", "agenda_task_runs", "claim_token", "work-queue lease marker for a task run"),
]


def is_excluded_name(name):
    for pat in EXCLUDE_NAMES:
        if fnmatch.fnmatchcase(name, pat) or fnmatch.fnmatchcase(name, pat + ".bak*") \
                or fnmatch.fnmatchcase(name, pat + "-*.bak"):
            return True
    return False


class Excluder:
    def __init__(self, home):
        self.patterns = [str(home / rel) for rel in EXCLUDE_PATHS]

    def path(self, p):
        """True when p (or its resolved target) is a credential path or has an excluded name."""
        for cand in {str(p), os.path.realpath(p)}:
            if any(is_excluded_name(part) for part in Path(cand).parts[1:]):
                return True
            for pat in self.patterns:
                if fnmatch.fnmatchcase(cand, pat) or cand.startswith(pat + os.sep):
                    return True
        return False


def build_stores(home):
    """Inventory section 3, in backup order: the stores something else prunes come first."""
    h = home
    def sqlite(name, *files):
        return {"name": name, "kind": "sqlite", "files": [h / f for f in files]}
    def tree(name, root, dbs, sidecars):
        return {"name": name, "kind": "sqlite-tree", "root": h / root, "dbs": dbs, "sidecars": sidecars}
    def files(name, *roots):
        return {"name": name, "kind": "files", "roots": [(label, h / rel) for label, rel in roots]}
    agy = ".gemini/antigravity"
    return [
        files("handoffs", ("handoffs", ".local/state/handoffs")),
        tree("cursor-acp-sessions", ".cursor/acp-sessions", ["*/store.db"], ["meta.json"]),
        tree("cursor-chats", ".cursor/chats", ["*/*/store.db"], ["meta.json"]),
        files("cursor-projects", ("projects", ".cursor/projects")),
        sqlite("hermes-state", ".hermes/state.db"),
        sqlite("opencode", ".local/share/opencode/opencode.db"),
        sqlite("zcode-db", ".zcode/cli/db/db.sqlite", ".zcode/v2/tasks-index.sqlite"),
        files("zcode-files", ("rollout", ".zcode/cli/rollout"), ("artifacts", ".zcode/cli/artifacts"),
              ("memories", ".zcode/cli/memories"), ("acp-lazy-sessions.json", ".zcode/v2/acp-lazy-sessions.json")),
        sqlite("crush-acp", ".local/share/crush-acp/crush.db"),
        sqlite("crush-tui", ".config/crush/.crush/crush.db"),
        sqlite("crush-repo", "src/djbclark-ade/.crush/crush.db"),
        sqlite("codex-db", ".codex/state_5.sqlite", ".codex/logs_2.sqlite", ".codex/memories_1.sqlite",
               ".codex/goals_1.sqlite"),
        files("codex-files", ("sessions", ".codex/sessions"), ("session_index.jsonl", ".codex/session_index.jsonl")),
        sqlite("copilot-db", ".copilot/session-store.db"),
        files("copilot-files", ("session-state", ".copilot/session-state")),
        tree("antigravity-cli-db", f"{agy}-cli", ["conversations/*.db", "conversation_summaries.db"], ["{stem}.meta"]),
        tree("antigravity-ide-db", agy, ["conversations/*.db", "conversation_summaries.db"], ["{stem}.meta"]),
        tree("antigravity-acp-db", f"{agy}-acp", ["conversations/*.db", "conversation_summaries.db"], ["{stem}.meta"]),
        files("antigravity-cli-files", ("brain", f"{agy}-cli/brain"), ("history.jsonl", f"{agy}-cli/history.jsonl"),
              ("annotations", f"{agy}-cli/annotations"), ("implicit", f"{agy}-cli/implicit"),
              ("jetbox_summaries_proto.pb", f"{agy}-cli/jetbox_summaries_proto.pb")),
        files("antigravity-ide-files", ("brain", f"{agy}/brain"),
              ("agyhub_summaries_proto.pb", f"{agy}/agyhub_summaries_proto.pb"),
              ("antigravity_state.pbtxt", f"{agy}/antigravity_state.pbtxt")),
        files("antigravity-acp-files", ("brain", f"{agy}-acp/brain")),
        files("claude", ("projects", ".claude/projects"), ("file-history", ".claude/file-history"),
              ("session-env", ".claude/session-env"), ("tasks", ".claude/tasks"), ("teams", ".claude/teams"),
              ("sessions", ".claude/sessions"), ("history.jsonl", ".claude/history.jsonl")),
        files("qwen", ("projects", ".qwen/projects")),
        files("cline", ("sessions", ".cline/data/sessions")),
        tree("cline-db", ".cline/data/db", ["*.db"], []),
        files("grok", ("sessions", ".grok/sessions")),
        sqlite("grok-db", ".grok/worktrees.db"),
        files("gemini-cli", ("tmp", ".gemini/tmp")),

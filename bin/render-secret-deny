#!/usr/bin/env python3
"""Render config/secret-deny.toml into the files that enforce it (2026-11-04, issue #284 item 2; docs/secret-deny.md).

Writes:
  1. config/secret_deny_policy.json: deny and allow patterns for claude/hooks/secret_read_gate.py (a PreToolUse hook
     that runs under Python 3.9 and cannot read TOML).
  2. The Read(...) and Edit(...) entries of `permissions.deny` in the Claude settings template
     (agents/claude/settings.json.tmpl): one Read and one Edit per `[claude] static` pattern. Render owns every
     Read(/Edit( entry in that list and puts them after the other entries; any other entry keeps its place and order.
  3. `sandbox.filesystem.denyRead` in the same template: one path per `[claude] static` pattern, in sandbox form
     (absolute stays single-`/`; `~/…` stays; a bare name or `**/…` is home-anchored as `~/**/…`, the documented
     wildcard shape). Render owns that whole array; other `sandbox` / `filesystem` keys are kept. It does not set
     `sandbox.enabled` (enabling the sandbox is the operator's live apply / trial step, order 11).

  4. The managed `ade-secret-deny` Codex permissions profile in agents/codex/config.toml.tmpl (between
     `# BEGIN ade-secret-deny` / `# END ade-secret-deny` markers), from `[codex] static`. Render owns that whole
     block; it does not set `default_permissions = "ade-secret-deny"` and does not change `sandbox_mode`. Live
     ~/.codex apply is order 11. openai/codex#22179 tracked early deny-glob docs that did not enforce — do not claim
     it landed.

Each edit is a text splice (the template holds `{{ ... }}` tags, so it is never loaded and dumped as JSON) and is
checked afterwards: with each tag masked to `x` both versions must parse, and they must differ only in the owned
lists.

Each static pattern must lie inside the deny patterns and share no path with an allow pattern (no `!` negation is
written: it is unverified and cannot reach `~/` rules), so a deny with an exception stays hook-only.

Usage: render-secret-deny [--check] [--policy TOML] [--policy-json OUT]
                          [--claude-template TMPL] [--codex-template TMPL]
Exit: 0 written or already clean; 1 drift (--check; a unified diff is printed, nothing is written);
      2 usage, an unreadable or invalid policy, or a template whose permissions.deny list cannot be found.
"""
from __future__ import annotations

import argparse
import difflib
import importlib.util
import json
import os
import re
import sys
import tempfile
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
HOOK = ROOT / "claude" / "hooks" / "secret_read_gate.py"
DEFAULTS = {
    "policy": ROOT / "config" / "secret-deny.toml",
    "policy_json": ROOT / "config" / "secret_deny_policy.json",
    "claude_template": ROOT / "agents" / "claude" / "settings.json.tmpl",
    "codex_template": ROOT / "agents" / "codex" / "config.toml.tmpl",
}
TAG = re.compile(r"\{\{.*?\}\}")
BAD_CHARS = re.compile(r"[\[\]{}()\\!\s\"\x00-\x1f]")
FAKE_HOME = "/h0me/u"   # one fixed home for the static checks
CODEX_BEGIN = "# BEGIN ade-secret-deny (managed by bin/render-secret-deny; do not edit by hand)"
CODEX_END = "# END ade-secret-deny"
PROFILE = "ade-secret-deny"


class Refused(Exception):
    """Exit 2 with this message."""


def engine():
    spec = importlib.util.spec_from_file_location("secret_read_gate", HOOK)
    if spec is None or spec.loader is None:
        raise Refused(f"cannot load the pattern engine from {HOOK}")
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def check_pattern(p: object, where: str) -> str:
    if not isinstance(p, str) or not p:
        raise Refused(f"{where}: {p!r} is not a non-empty string")
    if BAD_CHARS.search(p):
        raise Refused(f"{where}: {p!r} holds a character render does not allow ([]{{}}()\\! quote, whitespace)")
    if p.endswith("/") or "//" in p or "~" in p[1:] or (p.startswith("~") and not p.startswith("~/")):
        raise Refused(f"{where}: {p!r}: no trailing or doubled `/`, and `~` only as a leading `~/`")
    if "/" in p and not (p.startswith(("~/", "/", "**/"))):
        raise Refused(f"{where}: {p!r}: a pattern with `/` starts with `~/`, `/` or `**/`")
    for seg in p.split("/"):
        if "**" in seg and seg != "**":
            raise Refused(f"{where}: {p!r}: `**` must be a whole path segment")
    return p


def _load_static(data: dict, path: Path, section: str) -> list[str]:
    if section not in data:
        raise Refused(f"{path}: `[{section}]` section is required")
    block = data[section]
    static = block.get("static", []) if isinstance(block, dict) else None
    if not isinstance(static, list):
        raise Refused(f"{path}: `[{section}] static` must be a list")
    return [check_pattern(p, f"{section}.static[{i}]") for i, p in enumerate(static)]


def load_policy(path: Path) -> dict:
    try:
        data = tomllib.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, tomllib.TOMLDecodeError) as e:
        raise Refused(f"{path}: {e}") from e
    if data.get("version") != 1:
        raise Refused(f"{path}: version must be 1")
    out = {}
    for key in ("deny", "allow"):
        lst = data.get(key)
        if not isinstance(lst, list):
            raise Refused(f"{path}: `{key}` must be a list")
        out[key] = [check_pattern(p, f"{key}[{i}]") for i, p in enumerate(lst)]
    if not out["deny"]:
        raise Refused(f"{path}: `deny` is empty")
    out["static"] = _load_static(data, path, "claude")
    out["codex_static"] = _load_static(data, path, "codex")
    for key in ("deny", "allow", "static", "codex_static"):
        dup = {p for p in out[key] if out[key].count(p) > 1}
        if dup:
            raise Refused(f"{path}: `{key}` repeats {sorted(dup)}")
    return out


def check_static(pol: dict, gate, patterns: list[str], label: str) -> None:
    """Each static pattern is covered by the deny patterns and disjoint from every allow pattern."""
    def forms(p):
        return [gate.atoms(g) for g in gate.absolute_forms(p, [FAKE_HOME])]
    deny = [a for p in pol["deny"] for a in forms(p)]
    for s in patterns:
        for sa in forms(s):
            if gate.nonempty([sa], deny):
                raise Refused(f"{label} {s!r} reaches paths no deny pattern covers")
            for a in pol["allow"]:
                if any(gate.nonempty([sa, aa], []) for aa in forms(a)):
                    raise Refused(f"{label} {s!r} shares paths with allow {a!r}: keep it hook-only")


def claude_form(p: str) -> str:
    if p.startswith("/"):
        return "/" + p          # Claude: `//abs` is absolute, `/x` is relative to the settings file
    if "/" not in p:
        return "**/" + p        # explicit any-depth (Claude reads a bare name the same way)
    return p


def sandbox_form(p: str) -> str:
    """Sandbox filesystem path for one static pattern (docs/secret-deny.md C3; 2026-11-09).

    Sandbox paths use `/abs` and `~/…` (not the Read-rule `//abs` / settings-relative `/x` forms). A bare name or
    `**/…` glob is home-anchored as `~/**/…` so Linux has a fixed folder before the wildcard (Claude warns on a
    root-anchored or folderless glob such as `**/.env`). Exact `~/…` credential paths stay as written.
    """
    if p.startswith("/"):
        return p
    if p.startswith("~/"):
        return p
    if p.startswith("**/"):
        return "~/" + p
    if "/" not in p:
        return "~/**/" + p
    return p


def claude_entries(pol: dict) -> list[str]:
    forms = [claude_form(p) for p in pol["static"]]
    return [f"Read({f})" for f in forms] + [f"Edit({f})" for f in forms]


def sandbox_deny_read(pol: dict) -> list[str]:
    return [sandbox_form(p) for p in pol["static"]]


def codex_workspace_glob(p: str) -> str | None:
    """`:workspace_roots` glob for a bare / **/ pattern; None for home or absolute paths."""
    if p.startswith(("~/", "/")):
        return None
    if "/" not in p:
        return "**/" + p
    if p.startswith("**/"):
        return p
    raise Refused(f"codex.static {p!r}: cannot map to a Codex workspace deny glob")


def codex_home_key(p: str) -> str | None:
    """Exact filesystem key for a ~/ or absolute pattern; None for workspace globs."""
    if p.startswith("~/"):
        return "{{ .home }}/" + p[2:]
    if p.startswith("/"):
        return p
    return None


def codex_deny_maps(pol: dict) -> tuple[list[tuple[str, str]], list[tuple[str, str]]]:
    """(exact filesystem denies, workspace_roots denies) as (key, \"deny\") pairs."""
    exact: list[tuple[str, str]] = []
    workspace: list[tuple[str, str]] = []
    seen_e: set[str] = set()
    seen_w: set[str] = set()
    for p in pol["codex_static"]:
        home = codex_home_key(p)
        glob = codex_workspace_glob(p)
        if home is not None:
            if home in seen_e:
                raise Refused(f"codex.static maps to duplicate filesystem key {home!r}")
            seen_e.add(home)
            exact.append((home, "deny"))
        if glob is not None:
            if glob in seen_w:
                raise Refused(f"codex.static maps to duplicate workspace glob {glob!r}")
            seen_w.add(glob)
            workspace.append((glob, "deny"))
        if home is None and glob is None:
            raise Refused(f"codex.static {p!r}: neither a home path nor a workspace glob")
    return exact, workspace


def _toml_basic_key(key: str) -> str:
    return json.dumps(key, ensure_ascii=False)


def codex_profile_block(pol: dict) -> str:
    exact, workspace = codex_deny_maps(pol)
    lines = [
        CODEX_BEGIN,
        "# Codex filesystem deny-read profile from config/secret-deny.toml [codex] static.",
        f'# Not activated: do not set default_permissions = "{PROFILE}" here; sandbox_mode stays',
        '# danger-full-access until the operator applies this into ~/.codex/config.toml (order 11).',
        "# openai/codex#22179 tracked early deny-glob documentation that did not enforce; re-probe",
        "# the installed Codex before treating this profile as an OS wall. Do not claim #22179 landed.",
        f"[permissions.{PROFILE}]",
        'extends = ":workspace"',
        "",
        f"[permissions.{PROFILE}.filesystem]",
    ]
    for key, val in exact:
        lines.append(f"{_toml_basic_key(key)} = {_toml_basic_key(val)}")
    lines.append("")
    lines.append(f'[permissions.{PROFILE}.filesystem.":workspace_roots"]')
    for key, val in workspace:
        lines.append(f"{_toml_basic_key(key)} = {_toml_basic_key(val)}")
    lines.append(CODEX_END)
    return "\n".join(lines) + "\n"


def policy_json(pol: dict, source: str) -> str:
    doc = {
        "_generated": f"by bin/render-secret-deny from {source}; edit that file, not this one",
        "version": 1,
        "deny": pol["deny"],
        "allow": pol["allow"],
        "claude_static": pol["static"],
        "codex_static": pol["codex_static"],
    }
    return json.dumps(doc, indent=2, ensure_ascii=False) + "\n"


def mask(text: str) -> str:
    return TAG.sub("x", text)


def managed(entry: str) -> bool:
    return entry.startswith(("Read(", "Edit("))


def _object_key_line(lines: list[str], key: str, start: int, end: int, ind: int) -> int | None:
    """Index of `"key": {` (or `"key": {…}`) at indent `ind` inside [start, end)."""
    pat = re.compile(rf'^\s*"{re.escape(key)}"\s*:\s*\{{')
    for i in range(start, end):
        ln = lines[i]
        if len(ln) - len(ln.lstrip()) == ind and pat.match(ln):
            return i
    return None


def _object_span(lines: list[str], open_i: int) -> tuple[int, int]:
    """Inclusive (open, close) line indices of the `{…}` that opens on open_i."""
    open_ln = lines[open_i]
    brace_at = open_ln.find("{")
    if brace_at < 0:
        raise Refused(f"template: expected `{{` on line {open_i + 1}")
    depth = 0
    for i in range(open_i, len(lines)):
        ln = lines[i]
        # count braces outside JSON strings roughly: templates only put braces as structure here
        for ch in ln[brace_at if i == open_i else 0:]:
            if ch == "{":
                depth += 1
            elif ch == "}":
                depth -= 1
                if depth == 0:
                    return open_i, i
        brace_at = 0
    raise Refused(f"template: unclosed object starting at line {open_i + 1}")


def _expand_inline_empty_object(lines: list[str], open_i: int) -> list[str]:
    """Rewrite a one-line `"key": {}` (optional trailing comma) to multi-line `{` / `}` so children can be inserted.

    No-op when the object is already multi-line or non-empty. Without this, inserting after the open line puts
    children *outside* the object (Codex P2 on fb2918d2 / PR #405).
    """
    ln = lines[open_i]
    body = ln.rstrip("\r\n")
    m = re.match(r'^(\s*"[^"]+"\s*:\s*)\{\s*\}(\s*,?\s*)$', body)
    if not m:
        return lines
    prefix, trail = m.group(1), m.group(2)
    nl = "\r\n" if ln.endswith("\r\n") else "\n"
    ind = len(ln) - len(ln.lstrip())
    comma = "," if "," in trail else ""
    return lines[:open_i] + [prefix + "{" + nl, " " * ind + "}" + comma + nl] + lines[open_i + 1:]


def _array_span_inside(lines: list[str], key: str, obj_open: int, obj_close: int) -> tuple[int, int, bool] | None:
    """(`"key": [` start, `]` end, inline_empty) inside an object, or None if absent."""
    oind = len(lines[obj_open]) - len(lines[obj_open].lstrip())
    kind = oind + 2
    for i in range(obj_open + 1, obj_close):
        ln = lines[i]
        ind = len(ln) - len(ln.lstrip())
        if ind != kind:
            continue
        if re.match(rf'^\s*"{re.escape(key)}"\s*:\s*\[\s*\]\s*,?\s*$', ln):
            return i, i, True
        if re.match(rf'^\s*"{re.escape(key)}"\s*:\s*\[\s*$', ln):
            for j in range(i + 1, obj_close + 1):
                lj = lines[j]
                if re.match(r"^\s*\]\s*,?\s*$", lj) and len(lj) - len(lj.lstrip()) == kind:
                    return i, j, False
            raise Refused(f'template: unclosed `"{key}": [` list')
    return None


def _replace_string_array(lines: list[str], start: int, end: int, inline: bool, values: list[str],
                          key: str) -> list[str]:
    dind = len(lines[start]) - len(lines[start].lstrip())
    nl = "\r\n" if lines[start].endswith("\r\n") else "\n"
    eind = None
    if not inline:
        for ln in lines[start + 1:end]:
            body = ln.strip()
            if not body:
                continue
            try:
                val = json.loads(body[:-1] if body.endswith(",") else body)
            except ValueError as e:
                raise Refused(f"template: {key} entry line is not one JSON string: {body!r}") from e
            if not isinstance(val, str):
                raise Refused(f"template: {key} entry is not a string: {body!r}")
            if eind is None:
                eind = len(ln) - len(ln.lstrip())
        trail = "," if lines[end].rstrip().endswith(",") else ""
    else:
        trail = "," if lines[start].rstrip().endswith(",") else ""
    eind = eind if eind is not None else dind + 2
    block = [" " * dind + f'"{key}": [' + nl]
    for k, e in enumerate(values):
        block.append(" " * eind + json.dumps(e, ensure_ascii=False) + ("," if k < len(values) - 1 else "") + nl)
    block.append(" " * dind + "]" + trail + nl)
    return lines[:start] + block + lines[end + 1:]


def splice_permissions_deny(text: str, entries: list[str]) -> str:
    lines = text.splitlines(keepends=True)
    perm = next((i for i, ln in enumerate(lines) if re.match(r'^(\s*)"permissions"\s*:\s*\{\s*$', ln)), None)
    if perm is None:
        raise Refused('template: no `"permissions": {` line')
    _po, pc = _object_span(lines, perm)
    span = _array_span_inside(lines, "deny", perm, pc)
    if span is None:
        raise Refused('template: no `"deny": [` list inside "permissions"')
    start, end, inline = span
    old: list[str] = []
    if not inline:
        for ln in lines[start + 1:end]:
            body = ln.strip()
            if not body:
                continue
            try:
                val = json.loads(body[:-1] if body.endswith(",") else body)
            except ValueError as e:
                raise Refused(f"template: deny entry line is not one JSON string: {body!r}") from e
            if not isinstance(val, str):
                raise Refused(f"template: deny entry is not a string: {body!r}")
            old.append(val)
    new = [e for e in old if not managed(e)] + entries
    out_lines = _replace_string_array(lines, start, end, inline, new, "deny")
    out = "".join(out_lines)
    verify_permissions(text, out, new)
    return out


def verify_permissions(old_text: str, new_text: str, new_list: list[str]) -> None:
    try:
        old, new = json.loads(mask(old_text)), json.loads(mask(new_text))
    except ValueError as e:
        raise Refused(f"template does not parse with its tags masked: {e}") from e
    got = new.get("permissions", {}).get("deny")
    if got != [mask(e) for e in new_list]:
        raise Refused("template: the spliced list is not permissions.deny")
    if isinstance(old.get("permissions"), dict):
        old["permissions"]["deny"] = got
    if old != new:
        raise Refused("template: the permissions splice changed something besides permissions.deny")


def _insert_sandbox_block(lines: list[str], paths: list[str]) -> list[str]:
    """Insert a minimal sandbox.filesystem.denyRead object immediately after the permissions object."""
    perm = next((i for i, ln in enumerate(lines) if re.match(r'^(\s*)"permissions"\s*:\s*\{\s*$', ln)), None)
    if perm is None:
        raise Refused('template: no `"permissions": {` line')
    _po, pc = _object_span(lines, perm)
    pind = len(lines[perm]) - len(lines[perm].lstrip())
    nl = "\r\n" if lines[pc].endswith("\r\n") else "\n"
    rest = lines[pc + 1:]
    next_nonempty = next((ln for ln in rest if ln.strip()), "")
    # trailing comma on sandbox only when another top-level key follows (not the root `}`)
    sandbox_comma = "," if next_nonempty.strip() not in ("}", "},") else ""
    # ensure the permissions closer keeps a trailing comma when we insert a sibling
    close = lines[pc].rstrip("\r\n")
    if not close.rstrip().endswith(","):
        close = close.rstrip() + ","
    close += nl
    block = [
        " " * pind + '"sandbox": {' + nl,
        " " * (pind + 2) + '"filesystem": {' + nl,
        " " * (pind + 4) + '"denyRead": [' + nl,
    ]
    for k, e in enumerate(paths):
        block.append(" " * (pind + 6) + json.dumps(e, ensure_ascii=False)
                     + ("," if k < len(paths) - 1 else "") + nl)
    block.append(" " * (pind + 4) + "]" + nl)
    block.append(" " * (pind + 2) + "}" + nl)
    block.append(" " * pind + "}" + sandbox_comma + nl)
    return lines[:pc] + [close] + block + rest


def splice_sandbox_deny_read(text: str, paths: list[str]) -> str:
    """Own `sandbox.filesystem.denyRead`; create the sandbox/filesystem wrappers when missing."""
    lines = text.splitlines(keepends=True)
    root_keys = [(i, ln) for i, ln in enumerate(lines)
                 if re.match(r'^(\s*)"[^"]+"\s*:\s*\{', ln) and (len(ln) - len(ln.lstrip())) == 2]
    # top-level indent in this template is 2 spaces; fall back to first object key after `{`
    if not root_keys:
        raise Refused("template: no top-level object keys found")
    sandbox_i = next((i for i, ln in root_keys if re.match(r'^\s*"sandbox"\s*:\s*\{', ln)), None)
    if sandbox_i is None:
        out_lines = _insert_sandbox_block(lines, paths)
        out = "".join(out_lines)
        verify_sandbox(text, out, paths)
        return out
    lines = _expand_inline_empty_object(lines, sandbox_i)
    _so, sc = _object_span(lines, sandbox_i)
    sind = len(lines[sandbox_i]) - len(lines[sandbox_i].lstrip())
    fs_i = _object_key_line(lines, "filesystem", sandbox_i + 1, sc, sind + 2)
    if fs_i is None:
        # insert filesystem.denyRead as the first key inside sandbox
        nl = "\r\n" if lines[sandbox_i].endswith("\r\n") else "\n"
        find = sind + 2
        block = [
            " " * find + '"filesystem": {' + nl,
            " " * (find + 2) + '"denyRead": [' + nl,
        ]
        for k, e in enumerate(paths):
            block.append(" " * (find + 4) + json.dumps(e, ensure_ascii=False)
                         + ("," if k < len(paths) - 1 else "") + nl)
        block.append(" " * (find + 2) + "]" + nl)
        # trailing comma when sandbox already has other keys
        trail = "," if sc > sandbox_i + 1 else ""
        block.append(" " * find + "}" + trail + nl)
        out_lines = lines[:sandbox_i + 1] + block + lines[sandbox_i + 1:]
        out = "".join(out_lines)
        verify_sandbox(text, out, paths)
        return out
    lines = _expand_inline_empty_object(lines, fs_i)
    _fo, fc = _object_span(lines, fs_i)
    span = _array_span_inside(lines, "denyRead", fs_i, fc)
    if span is None:
        nl = "\r\n" if lines[fs_i].endswith("\r\n") else "\n"
        find = len(lines[fs_i]) - len(lines[fs_i].lstrip()) + 2
        block = [" " * find + '"denyRead": [' + nl]
        for k, e in enumerate(paths):
            block.append(" " * (find + 2) + json.dumps(e, ensure_ascii=False)
                         + ("," if k < len(paths) - 1 else "") + nl)
        trail = "," if fc > fs_i + 1 else ""
        block.append(" " * find + "]" + trail + nl)
        out_lines = lines[:fs_i + 1] + block + lines[fs_i + 1:]
        out = "".join(out_lines)
        verify_sandbox(text, out, paths)
        return out
    start, end, inline = span
    out_lines = _replace_string_array(lines, start, end, inline, paths, "denyRead")
    out = "".join(out_lines)
    verify_sandbox(text, out, paths)
    return out


def verify_sandbox(old_text: str, new_text: str, paths: list[str]) -> None:
    try:
        old, new = json.loads(mask(old_text)), json.loads(mask(new_text))
    except ValueError as e:
        raise Refused(f"template does not parse with its tags masked: {e}") from e
    got = (((new.get("sandbox") or {}).get("filesystem") or {}).get("denyRead"))
    if got != [mask(p) for p in paths]:
        raise Refused("template: the spliced list is not sandbox.filesystem.denyRead")
    # allow only sandbox.filesystem.denyRead (and creating missing sandbox/filesystem wrappers) to differ
    old_sb = old.get("sandbox")
    if not isinstance(old_sb, dict):
        old["sandbox"] = new.get("sandbox")
    else:
        old_fs = old_sb.get("filesystem")
        if not isinstance(old_fs, dict):
            old_sb["filesystem"] = (new.get("sandbox") or {}).get("filesystem")
        else:
            old_fs["denyRead"] = got
            # if new filesystem has only denyRead and old had none of the other keys, still ok
    if old != new:
        raise Refused("template: the sandbox splice changed something besides sandbox.filesystem.denyRead")


def splice(text: str, pol: dict) -> str:
    """Permissions.deny Read/Edit entries, then sandbox.filesystem.denyRead paths."""
    mid = splice_permissions_deny(text, claude_entries(pol))
    return splice_sandbox_deny_read(mid, sandbox_deny_read(pol))


def _strip_codex_markers(text: str) -> str:
    """Remove a managed ade-secret-deny block (markers inclusive), leaving surrounding text."""
    begin = text.find(CODEX_BEGIN)
    if begin < 0:
        return text
    end = text.find(CODEX_END, begin)
    if end < 0:
        raise Refused("codex template: BEGIN ade-secret-deny without END")
    end_line = text.find("\n", end)
    if end_line < 0:
        cut_end = len(text)
    else:
        cut_end = end_line + 1
    # also drop one blank line before the block when present
    cut_begin = begin
    if cut_begin >= 2 and text[cut_begin - 2:cut_begin] == "\n\n":
        cut_begin -= 1
    elif cut_begin >= 1 and text[cut_begin - 1] == "\n":
        pass
    return text[:cut_begin] + text[cut_end:]


def _insert_codex_block(text: str, block: str) -> str:
    """Insert the managed block after [features], or after existing markers' former site."""
    lines = text.splitlines(keepends=True)
    features = next((i for i, ln in enumerate(lines) if re.match(r"^\[features\]\s*(#.*)?$", ln)), None)
    if features is None:
        raise Refused("codex template: no [features] table to anchor the ade-secret-deny block")
    # end of the features table: next [header] at column 0
    insert_at = len(lines)
    for i in range(features + 1, len(lines)):
        if re.match(r"^\[[^\]]+\]", lines[i]):
            insert_at = i
            break
    nl = "\r\n" if lines and lines[0].endswith("\r\n") else "\n"
    # ensure a blank line before the block
    prefix = []
    if insert_at > 0 and lines[insert_at - 1].strip():
        prefix.append(nl)
    if insert_at > 0 and lines[insert_at - 1].endswith("\n") and not lines[insert_at - 1].endswith(nl + nl if False else "\n"):
        pass
    block_text = block if block.endswith("\n") else block + "\n"
    if not block_text.endswith(nl + nl) and insert_at < len(lines):
        # keep one blank line after the block before the next table
        if not block_text.endswith("\n\n"):
            block_text = block_text.rstrip("\n") + "\n\n"
    return "".join(lines[:insert_at] + prefix + [block_text] + lines[insert_at:])


def splice_codex(text: str, pol: dict) -> str:
    block = codex_profile_block(pol)
    stripped = _strip_codex_markers(text)
    if CODEX_BEGIN in text:
        # replace in place: find original span and substitute
        begin = text.find(CODEX_BEGIN)
        end = text.find(CODEX_END, begin)
        if end < 0:
            raise Refused("codex template: BEGIN ade-secret-deny without END")
        end_line = text.find("\n", end)
        cut_end = len(text) if end_line < 0 else end_line + 1
        out = text[:begin] + block + text[cut_end:]
    else:
        out = _insert_codex_block(stripped, block)
    verify_codex(text if CODEX_BEGIN in text else stripped, out, pol)
    return out


def verify_codex(old_text: str, new_text: str, pol: dict) -> None:
    try:
        old = tomllib.loads(mask(old_text))
        new = tomllib.loads(mask(new_text))
    except tomllib.TOMLDecodeError as e:
        raise Refused(f"codex template does not parse with its tags masked: {e}") from e
    if new.get("default_permissions") == PROFILE:
        raise Refused(f'codex template: must not set default_permissions = "{PROFILE}" (live apply is order 11)')
    perms = new.get("permissions")
    if not isinstance(perms, dict) or PROFILE not in perms:
        raise Refused(f"codex template: missing [permissions.{PROFILE}]")
    profile = perms[PROFILE]
    if not isinstance(profile, dict) or profile.get("extends") != ":workspace":
        raise Refused(f"codex template: [permissions.{PROFILE}] must extend :workspace")
    fs = profile.get("filesystem")
    if not isinstance(fs, dict):
        raise Refused(f"codex template: missing [permissions.{PROFILE}.filesystem]")
    exact, workspace = codex_deny_maps(pol)
    # tomllib folds ":workspace_roots" as a nested key under filesystem
    roots = fs.get(":workspace_roots")
    if not isinstance(roots, dict):
        raise Refused("codex template: missing filesystem.\":workspace_roots\" deny map")
    want_exact = {mask(k): v for k, v in exact}
    want_roots = {mask(k): v for k, v in workspace}
    got_exact = {k: v for k, v in fs.items() if k != ":workspace_roots"}
    if got_exact != want_exact:
        raise Refused("codex template: filesystem exact denies do not match [codex] static")
    if roots != want_roots:
        raise Refused("codex template: workspace_roots denies do not match [codex] static")
    # everything outside permissions.<PROFILE> must match old (after stripping an old managed profile)
    old_cmp = dict(old)
    new_cmp = dict(new)
    old_perms = dict(old_cmp.get("permissions") or {})
    new_perms = dict(new_cmp.get("permissions") or {})
    old_perms.pop(PROFILE, None)
    new_perms.pop(PROFILE, None)
    if old_perms:
        old_cmp["permissions"] = old_perms
    else:
        old_cmp.pop("permissions", None)
    if new_perms:
        new_cmp["permissions"] = new_perms
    else:
        new_cmp.pop("permissions", None)
    if old_cmp != new_cmp:
        raise Refused("codex template: the splice changed something besides permissions.ade-secret-deny")


def write_atomic(path: Path, text: str) -> None:
    mode = path.stat().st_mode & 0o7777 if path.exists() else 0o644
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=f".{path.name}.", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="") as f:
            f.write(text)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        prog="render-secret-deny",
        description="Render config/secret-deny.toml into the hook policy JSON, the Claude template's "
                    "Read(...)/Edit(...) deny entries and sandbox.filesystem.denyRead paths, and the "
                    "Codex ade-secret-deny permissions profile. "
                    "Exit 0 written or clean, 1 drift (--check), 2 usage or bad input.")
    ap.add_argument("--check", action="store_true", help="write nothing; print a diff and exit 1 when any output is stale")
    ap.add_argument("--policy", type=Path, default=DEFAULTS["policy"], help="the TOML policy (default %(default)s)")
    ap.add_argument("--policy-json", type=Path, default=DEFAULTS["policy_json"],
                    help="the hook's policy JSON to write (default %(default)s)")
    ap.add_argument("--claude-template", type=Path, default=DEFAULTS["claude_template"],
                    help="the Claude settings template to splice (default %(default)s)")
    ap.add_argument("--codex-template", type=Path, default=DEFAULTS["codex_template"],
                    help="the Codex config template to splice (default %(default)s)")
    args = ap.parse_args(argv)
    try:
        gate = engine()
        pol = load_policy(args.policy)
        check_static(pol, gate, pol["static"], "claude.static")
        check_static(pol, gate, pol["codex_static"], "codex.static")
        try:
            source = args.policy.resolve().relative_to(ROOT).as_posix()
        except ValueError:
            source = args.policy.name
        want_json = policy_json(pol, source)
        try:
            tmpl = args.claude_template.read_text(encoding="utf-8")
        except OSError as e:
            raise Refused(f"{args.claude_template}: {e}") from e
        want_tmpl = splice(tmpl, pol)
        try:
            codex_tmpl = args.codex_template.read_text(encoding="utf-8")
        except OSError as e:
            raise Refused(f"{args.codex_template}: {e}") from e
        want_codex = splice_codex(codex_tmpl, pol)
        try:
            have_json = args.policy_json.read_text(encoding="utf-8")
        except FileNotFoundError:
            have_json = ""
        except OSError as e:
            raise Refused(f"{args.policy_json}: {e}") from e
    except Refused as e:
        print(f"render-secret-deny: {e}", file=sys.stderr)
        return 2
    pairs = [
        (args.policy_json, have_json, want_json),
        (args.claude_template, tmpl, want_tmpl),
        (args.codex_template, codex_tmpl, want_codex),
    ]
    stale = [(p, have, want) for p, have, want in pairs if have != want]
    if args.check:
        for p, have, want in stale:
            sys.stdout.writelines(difflib.unified_diff(
                have.splitlines(keepends=True), want.splitlines(keepends=True), f"{p} (committed)", f"{p} (rendered)"))
        if stale:
            print(f"render-secret-deny: {len(stale)} file(s) out of date; run bin/render-secret-deny", file=sys.stderr)
            return 1
        return 0
    for p, _, want in stale:
        write_atomic(p, want)
        print(f"render-secret-deny: wrote {p}")
    if not stale:
        print("render-secret-deny: already up to date")
    return 0


if __name__ == "__main__":
    sys.exit(main())

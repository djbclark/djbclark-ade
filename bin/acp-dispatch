#!/usr/bin/env python3
"""acp-dispatch — one consistent way to hand a slice to an agent and get its report back.

    acp-dispatch <agent> --model M --kind KIND --name NAME (-p PROMPT | -f BRIEF) [-C DIR]
                 (--model may be omitted for zcode only, which has just two models)
                 (--kind is required on a fresh dispatch: route_agent.KINDS; resume/reroute
                  inherit it from the record; a pre-change record with no kind still continues)
                 [--role advise|exec]   (frontier only; default advise; other kinds record exec)
                 [--effort LEVEL] [--context SIZE]
                 [--task TASK | --out DIR] [--perm all|read-only|deny] [--timeout S]
                 [--lead NAME] [--detach [--no-wait] [--wait-timeout S]] [--dry-run] [--json]
                 [--min-headroom PCT] [--est-pct PCT] [--checkpoint] [--no-preflight]
                 [--no-auto-resume]
    acp-dispatch footer --report PATH [--lead NAME]      the shared footer, filled in, for an
                                                         Agent-tool prompt (paste it verbatim)
    acp-dispatch check (PATH)...                         classify reports: PATH is a report file,
                                                         a jobs/<name>.json record, or an out dir
    acp-dispatch finalize RECORD --exit RC               (internal) what the detached runner calls
    acp-dispatch extend RECORD SECONDS                  add seconds, or 0 for no deadline
    acp-dispatch tell RECORD MESSAGE [--from NAME]      send a message into a running slice
                                                         (MESSAGE - reads stdin; RECORD may be a
                                                         bare report path when no .json exists)
    acp-dispatch resume RECORD [--timeout S] [-p TEXT | -f FILE] [--detach --no-wait]
                 [--no-auto-resume]
    acp-dispatch outcome RECORD [--ci pass|fail] [--review pass|fail] [--merged|--not-merged]
                                                         what became of a finished slice's work,
                                                         for route_agent.py calibrate (merges)
    acp-dispatch reroute RECORD (--agent A --model M | --escalate) [--detach --no-wait]
                 (--escalate climbs one rung of [escalation] in config/routing.toml,
                  never straight to the top; agent/model from route_agent's top route)
    acp-dispatch auto-resume RECORD --attempt N          (internal) what the scheduled resume
                                                         runner calls after a quota stop
    acp-dispatch wait RECORD [--once]                     block until the record is finalized
                                                         (reaped first if its process died);
                                                         --once runs a single pass and exits 0
                                                         finished, 75 still running, 124 timed out
    acp-dispatch reap [RECORD|DIR]... [--quiet] [--force] finalize every unfinished record whose
                                                         process is gone, and re-submit a
                                                         scheduled auto-resume a reboot removed
                                                         (idempotent, any time; a dir sweep runs
                                                         at most once per 60 s — the stamp in
                                                         ~/.local/state/acp-dispatch/reap.stamp,
                                                         ACP_DISPATCH_REAP_MIN_INTERVAL, 0 off;
                                                         --force or one .json record skips it)
    acp-dispatch reap --install | --uninstall            the launchd sweep (RunAtLoad + every 30 min)

What it replaces: the dispatch recipe that bigteam, model-routing and home-agents.md used to
spell out in prose and every dispatcher retyped — the report-file naming, "write the full
report there, then reply with only a pointer", the `.done` marker, the jobs record, the bounded
`until [ -s ]` waiter, `--model`/`--perm`/`--timeout`, and (since 2026-10-08) the 4,000-character
cap on a sub-agent's final message and the never-end-on-a-question rule. The rules live once, in
docs/dispatch-footer.md, and are appended to every brief.

Contract (the same for ACP agents run here and for Claude Code Agent-tool sub-agents, which
get the footer pasted into their prompt because the Agent tool cannot be driven from a script):
    report   $OUT/<name>-report.md     the deliverable; first line `STATUS: working` or
                                        `BLOCKED: <question>`; last line `DONE`
    done     <report>.done              touched last; waiters watch this, never the report
    record   $OUT/jobs/<name>.json      who launched it, every path, the exact waiter to re-arm
    $OUT     ~/.local/state/bigteam/<task>/ (default) or --out; never the session scratchpad,
             which is wiped when the session restarts (2026-10-05)

--model is checked before anything is written or detached (2026-10-10: a bad agy model used to
detach, fail inside the launchd job and surface only as `no-report` from the waiter). The
agent's model list comes from `acp-run <agent> --info` (its ACP session/new list, which is what
acp-run itself matches against), cached per agent for 6 h under ~/.cache/acp-dispatch and
re-read once on a miss; a miss exits 2 with the `have:` list. If the probe itself fails the
dispatch goes ahead with a warning. --no-model-check skips it.

--effort LEVEL and --context SIZE are acp-run's normalized flags (acp-run --help), passed to it
first-class after --model and recorded in the job record. They are checked together with the model,
before anything is written or detached, by `acp-run <agent> --info --model M --effort E --context C`
(it applies them to a fresh session without a prompt): an agent or model that cannot take the value
exits 2 here with acp-run's list of valid values. --acp-arg still passes anything else through.

When the agent stops without a DONE or BLOCKED report and acp-run failed (a quota or plan
refusal, a crash, a timeout), finalize appends a last line `NO-REPORT: <class> (<agent>,
<model>[, retry at <time>]) ...` to the report, so the report itself says it is not a
deliverable, and the slice classifies as no-report (exit 3). The `rearm` waiter runs
`acp-dispatch check <record>` once `.done` appears, so it exits non-zero (1 partial,
3 no-report, 4 BLOCKED) and prints the verdict instead of exiting 0 on any finish.

For an ACP agent the final message (acp-run's stdout) is saved to $OUT/<name>-final.txt. If
the agent did not write the report file but its final message carries the content, the report
is recovered from it and the record says so (`report_source: final-message`) — stdout from
acp-run is never truncated, so nothing is lost; the warning tells you the brief was not followed.
Not when acp-run itself failed that turn (`FAILED <class>` on its stderr or a non-zero exit; a reply
of tool calls printed as text is `FAILED fake-tool-calls`, class `fake-tool-calls`, 2026-10-19): the
final message is then kept above a `NO-REPORT:` line and never gets a DONE (`report_source:
final-message-failed`). A model refusal is such a failure: acp-run classifies a short reply that
starts "Sorry, I cannot ..." / "I must decline ..." as `FAILED refused` (2026-10-10: agy
gemini-pro-agent declined a security slice, the refusal was recovered, given DONE and checked
`done`), and the note reads `NO-REPORT: refused (<agent>, <model>): <first sentence> ...`.

Time budget (2026-10-10, wedge-grants/stlib): the brief copy ends with a "Time budget" section that
gives the agent its --timeout in minutes and tells it to write the report before a commit, a push or
any long command. acp-run gets --wrapup-grace (default 300 s, 0 turns it off) and a wrap-up prompt
naming the report: when the timeout cancels the turn, the agent gets one last turn to write the report
with first line `STATUS: timed out` and last line DONE. Such a report classifies `done` with
`acp-run exit=124 (timed out ...)`, and dispatch and check exit 1, never 0. The rearm waiter allows
timeout + wrap-up grace + 300 s.

A quota stop is resumed in place, automatically (operator 2026-10-18: "tokens spent thinking about
a problem are something"; three codex slices had been stopped by the 5-hour limit and the lead was
about to re-task them from fresh briefs). When finalize writes `NO-REPORT: quota (...)` and the
record has an ACP session id and the agent advertises session/load or session/resume, finalize
schedules a one-shot `acp-dispatch auto-resume RECORD` under launchd (the same mechanism as
--detach, so it outlives the lead's session) for the reset time plus a 5-minute margin: the reset
time comes from acp-run's stderr, else from the pool's `resets_at` in aiuse's snapshot, else a
30-minute back-off. Before resuming, the runner gates on the pool's live headroom
(`aiuse --available --json --live`, 20% left; re-checked up to 6 times, 10 min apart, then it gives
up with the manual command in the record). The resume reopens the same session with a prompt
saying the stop was the usage limit, not the agent: continue, redo nothing finished, complete the
report and the `.done`. Three automatic attempts per slice, then `given-up`. The record's
`auto_resume` field carries state, attempt, `not_before_iso`, label and runner; `resume_count`
links the runs. `--no-auto-resume` (dispatch and resume) turns it off for that slice;
ACP_DISPATCH_NO_AUTO_RESUME=1 for a whole session. A record that already has `closed` is never
scheduled. The `rearm` waiter does not end on such a stop: `wait` sees the pending auto-resume and
keeps waiting through it to the real end (bounded: reset + gate window + 15 min), so a lead's
background waiter needs no change. `check` on a record in that state prints `resume-scheduled` and
exits 1 (still running, like `running`/`pending`); exit 3 keeps meaning a real no-report. A quota
stop that cannot be resumed automatically (no session id, agent without load/resume, opted out,
attempts exhausted) stays exit 3 and the `check` line ends with the exact
`acp-dispatch resume <record>` command and the retry time.

Failure classes (NO-REPORT line): `quota`, `auth`, `refused`, `outage`, `timeout`, `transient`
(acp-run's FAILED transient: a truncated reply, an http/2 CANCEL), `killed`, `lost`, `exit N`.
2026-10-18: a transient failure on a pool whose headroom is below 10% (the --min-headroom default,
read with `pool_reading`, the reading a resume refusal uses) is a quota stop in disguise — a cursor
slice died on an http/2 CANCEL and minutes later `resume` was refused at 0.0% headroom. finalize
writes `NO-REPORT: quota (...)` with "transient error on a pool at N% headroom: treated as quota"
and the ordinary quota path follows (auto-resume at the reset, or the reroute for a far one).
Otherwise `transient` stays. For transient and outage `check` suggests `reroute RECORD --agent A
--model M` (route_agent's top route for the record's kind, this pool excluded) and never
`--escalate`: a transport error says nothing about the tier. Other failures keep the one-rung
`--escalate` hint.

Quota-stop refinements (2026-10-18): (1) a reset further out than `[dispatch].
auto_resume_max_wait_hours` (default 6) is not waited for — agy's weekly cap resets ~148 h out
and a 5-day codex weekly has no business in launchd either — finalize records
`auto_resume.state = "skipped"` (+`far_reset`) naming the reset, and `check` prints a
ready-to-run `reroute RECORD --agent A --model M` from route_agent's top route for the record's
kind, excluding the stopped pool (the manual resume hint stays when nothing is eligible).
(2) The Mac is woken 2 min before the resume fires via `sudo -n pmset schedule wake` (helper:
`schedule_wake`/`cancel_wake`, binary overridable with ACP_DISPATCH_PMSET); the result lands in
`auto_resume.wake` — "unavailable: ..." on a machine without config/sudoers.d/acp-dispatch-pmset
(installed here 2026-10-18, operator-approved) — and the
wake is cancelled best-effort when the resume runs or the schedule is cancelled (closed,
rerouted, superseded). (3) An agent that exits 0 after a quota refusal (agy did; the 429 lived
in the session log, not acp-run's stderr) is caught: finalize scans the log too when rc is 0
and the report is not DONE, notifies aiuse and writes the same `NO-REPORT: quota` line, so
check and auto-resume treat it as a quota stop. (4) A quota stop on a partial checkpoint report
auto-resumes as well — the report is its checkpoint; a DONE report never does. (5) A zone-less
`limit will reset at ...` from zcode is Beijing time (UTC+8), not the local clock.

Cheap-first escalation (operator decision 1.4, 2026-10-18): a slice that failed on its tier
(no-report or partial, not quota, not BLOCKED) climbs ONE rung of the `[escalation]` ladder in
config/routing.toml (`research` jumps to `judgment` via `[escalation.next]`), never straight to
the top. `check` appends `; escalate: acp-dispatch reroute RECORD --escalate (-> <next kind>)`,
and `reroute --escalate` takes route_agent's top route for the next kind excluding the failed
pool — every gate still runs, frontier lands as advisor without ACP_OPERATOR_APPROVED=
frontier-exec, and the top rung refuses with exit 2.

A refused resume leaves the record alone (2026-10-18): `resume` runs the same pool checks as a
fresh dispatch (headroom, window fit, estimate, in-flight reservation), and a refusal used to
overwrite the record with a bare `unavailable` one, losing `log`, `session_id`, `cmd`, `brief`,
`prompt`, `auto_resume`, `closed` and `resume_count`, so the next resume crashed. Now the record
keeps every key and gains a `refusals` list, one `{at, class, detail}` entry per refused resume;
exit 5 and the `unavailable` stdout line are unchanged. A fresh dispatch (no record to continue)
still writes the `unavailable` record. `resume` on a record that has no `log` or `cmd` (one
clobbered before this fix) stops with a message instead of a traceback; `session_info` returns the
stored session id and no capability for it.

--kind (2026-10-18): a fresh dispatch must name a route_agent kind; the agent×model is mapped to a
routing service the same way pool headroom is, and an ineligible pair exits 2 naming who *is*
eligible (ACP_OPERATOR_APPROVED=route-override skips eligibility only). Frontier models
(`[dispatch].frontier_models`, substring on --model) require `--kind frontier` and ignore
route-override. Frontier defaults to `--role advise` (read-only brief section + tree hash; a tree
change sets `advisor_edited` and check says ADVISOR EDITED THE TREE); `--role exec` needs
ACP_OPERATOR_APPROVED=frontier-exec. Estimate history is machine-wide when this task has fewer than
3 measured slices; `[dispatch.estimate_floor]` floors the brief-size default. Before fit checks,
other in-flight slices on the same *service* reserve their `estimated_usage_pct` /
`estimated_usage_windows` (conservative: the whole estimate, even if the snapshot already counts
part of it). A resume is never refused by that reservation. `class=inflight` is exit 5.

A detached slice that dies without running finalize (a reboot's SIGTERM, SIGKILL, OOM, power
loss, launchd unloading it) used to leave `exit: null, finished: null` forever, so every reader
showed it running (2026-10-17: trackpad-settings, pid 51407, killed by a reboot, listed as running
hours later; a rearm waiter on it sat until its timeout). Since 2026-10-18: (1) the detached
runner traps TERM/HUP/INT, forwards TERM to acp-run (which cancels the turn and stops the agent),
SIGKILLs it after 25 s, and finalizes with 128+signal (`NO-REPORT: killed: SIGTERM (...)`); it also
writes `<name>.exit` before finalize. (2) The record stores `pid_start` (`ps -o lstart=`) with the
pid, so one shared rule, `dead_reason()`, says whether an unfinished record's process is gone: pid
not alive, or alive but not the same process (a reused pid after a reboot); a record from before
`pid_start` counts as running only while the command line still looks like this slice. (3)
`acp-dispatch reap` finalizes such a record once, under its lock: exit from `<name>.exit`, else
launchd's last exit status for the record's label (`launchctl print gui/$UID/<label>`), else 255
(`lost`); `finished` is the last write to the log/report/stderr; the record carries `reaped:
{reason, exit_source, at}`. A record whose report ends in DONE with `.done` present is finished
normally (the runner died after the agent delivered). `check`, `wait` and `resume` apply the rule
first, so a dead slice is never "running" to a reader; `wait` returns at once on one. The sweep
`acp-dispatch reap ~/.local/state/bigteam` runs from launchd (`reap --install`;
launchd/com.djbclark.acp-dispatch-reap.plist) at login and every 30 min. The reaped slice's
stderr still decides the class: a quota refusal there follows the quota path (auto-resume).

A scheduled auto-resume survives a reboot (2026-10-18): `launchctl submit` jobs are removed by a
reboot or logout, leaving a record that says `scheduled` with nothing to run it. The same sweep
(`reap`, so at login and every 30 min) also finds each finished, unclosed record whose
`auto_resume.state` is pending (scheduled, waiting-headroom, resuming) and whose launchd label is
no longer loaded (`launchctl print` says so; an unavailable launchctl changes nothing) and submits
the same attempt again: same label and `not_before` (already past: the runner starts at once, still
gated on pool headroom). Under the record's lock, so concurrent sweeps submit once; a closed,
manually resumed, rerouted, given-up or newer-attempt record (its state is no longer pending, or the
label is a newer one) is never revived. `auto_resume.resubmitted` lists the epochs; a refused submit is kept in
`auto_resume.resubmit_failed` and retried by the next sweep. `reap` prints
`resubmitted<TAB>name<TAB>record<TAB>label attempt N (...)` per re-submission (or `resubmit-failed`).

A restart or logout kills a detached slice with SIGTERM (2026-10-19, ime-listener: the record said only
"killed: SIGTERM"). The same login sweep reads `sysctl -n kern.boottime` (ACP_DISPATCH_BOOTTIME
overrides it) and tags a finished record that TERM/HUP ended within 180 s before the boot with
`killed_by: "system restart/logout (boot HH:MM)"`, so the failure reads `killed: SIGTERM (system
restart)` (`reap` prints `restart-killed`). It then resumes that slice in place, detached
(`resume RECORD --detach --no-wait --after-restart`, a prompt saying the Mac restarted), once per boot:
`restart_resume.boot` is written under the record's lock before the resume starts, and the kill must
sit in this boot's window, so a second sweep, a refused resume (`restart-resume-failed`, with the
manual command) or a later boot never loops. Skipped (`restart-resume-skipped`, reason in the
record): a closed record, a DONE or BLOCKED report, `--no-auto-resume` / ACP_DISPATCH_NO_AUTO_RESUME=1,
a pending quota auto-resume, no session id, an agent that cannot reopen the session. `reap` prints
`restart-resumed<TAB>name<TAB>record<TAB>in place, session ID` on success. finalize also appends the
`resume RECORD` command to any `killed: SIG*` slice that has a session.

`wait` returns only once the record is finalized (or reaped), not when `.done` appears: the agent
itself touches `.done` as its last act, so acp-run and finalize may still be running (2026-10-18:
`wait && resume` hit "slice process is still running"). `resume` also waits up to 120 s
(ACP_DISPATCH_FINALIZE_WAIT) for finalize when `.done` exists. finalize records the model acp-run
actually applied (`model_applied`, from the log's `applied` row) and `resume` passes that, so a
family alias such as `fable` that a resumed session's model list resolves differently cannot kill
the resume (2026-10-18: "no model 'fable' (ambiguous: claude-fable-5-1, claude-fable-5)").

`tell` (2026-10-18) passes a message into a running slice: one `## MSG N` entry appended to
`<record>.inbox.md` next to the record (a bare report path works too and uses
`<report>.inbox.md`, for Agent-tool sub-agents), and for a `claude` slice also one JSON frame
written to the live session's messaging socket, found through `~/.claude/sessions/<pid>.json`.
That protocol is undocumented, so a missing registry entry or a failed connect is never an
error — the inbox entry is the source of truth. A finished record is refused (exit 2) with the
`resume` command to use instead. The footer has the slice read the inbox between steps and
answer each message with `REPLY N:` in `<record>.replies.md` (a separate file, so the slice's
writes never race the lead's appends); `check` appends `inbox: N sent, M answered`, and
`resume` carries every unanswered message into the next prompt.

The rearm waiter is cheap (2026-10-18): `rearm_cmd` prints one call to bin/acp-dispatch-wait,
which holds only bash, sleep and grep while the slice runs — a resident Python `wait` per waiting
lead was 13-32 MB of RSS each, and 26 of them (306 MB) were the biggest Python cost on the machine
during the load-60-90 memory stall. Every 10 s it checks the `.done` marker or `"finished":` set
in the record JSON; every 60 s, and the moment that check trips, it runs `wait --once RECORD`
(one pass: 0 finished, 75 EX_TEMPFAIL still running, 124 timed out), looping on 75 and ending in
`acp-dispatch check RECORD` with its exit code. route_agent is imported lazily (load_policy), so
wait, reap, check, footer, extend and finalize invocations pay nothing for the routing module.

Exit codes (dispatch and check):
    0    report delivered and ends in DONE (dispatch: and acp-run exited 0)
    1    report present but unfinished (no DONE), or delivered with a non-zero acp-run exit;
         also `running`, `pending` and `resume-scheduled` (a quota stop whose in-place resume is
         scheduled: still running, wait for the rearm waiter)
    2    usage (missing --kind/--model, ineligible kind, frontier model without --kind frontier,
         frontier --role exec without approval, --role advise with --perm deny (use read-only), bad name, report basename Claude Code would refuse, ...)
    3    delivery failure: the agent finished (or died) and there is no report, or its report
         ends in a NO-REPORT: line (acp-run failed before the agent wrote DONE) and no automatic
         resume is pending; for a quota stop the line carries the manual resume command
    4    BLOCKED: the report's first line is a question for the lead; answer it, then resume
    5    pool unavailable before launch (headroom, wont-fit, inflight reservation/cap, preflight);
         re-plan with --exclude (no slice attempt consumed)
    124  timed out waiting for the .done marker (--detach without --no-wait)
    (a reaped record's acp-run exit is 255 `lost` when neither an exit file nor launchd knows it;
     a signalled runner's is 128+signal, e.g. 143 for SIGTERM)
Exit 0 is still not success: verify the outcome (diff, tests, the report's content).
"""
from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import re
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import threading
import time
import uuid
from contextlib import contextmanager
from datetime import date, datetime, timedelta, timezone
from pathlib import Path
from typing import NoReturn
from zoneinfo import ZoneInfo

HERE = Path(__file__).resolve().parent
FOOTER_FILE = HERE.parent / "docs" / "dispatch-footer.md"
DENY_NOTE = """
**This run is read-only (`--perm deny`).** Every tool call that needs permission is refused,
including writing `{report}` and creating its `.done` marker, so do not try. Put the whole
report, in the shape the delivery contract describes, in your final message instead: an
`acp-run` final message is not cut at 4,000 characters, and acp-dispatch saves it to the report
path and marks it done for you. This overrides items 1, 2 and 7 of the delivery contract.
"""
READONLY_NOTE = """
**This run is read-only (`--perm read-only`).** You can read (Read, Grep, Glob, LS, web fetch and
search where the agent has them) and you cannot change anything: you have no tool that writes
`{report}` or creates its `.done` marker, so do not try, and a call to any other tool stops the
run. Put the whole report, in the shape the delivery contract describes, in your final message
instead: an `acp-run` final message is not cut at 4,000 characters, and acp-dispatch saves it to
the report path and marks it done for you. This overrides items 1, 2 and 7 of the delivery contract.
"""
ADVISOR_NOTE = """
## Advisor role

This is a read-only review or consultation. Do not edit, create or delete files in the working
tree, commit, push or change git config. The deliverable is the report: findings, recommendations,
and exact file:line references.
"""
STATE_ROOT = Path(os.environ.get("ACP_DISPATCH_STATE", str(Path.home() / ".local/state/bigteam")))
# SendMessage address of the parent. An Agent-tool sub-agent reaches its main session as "main";
# "team-lead" lands in ~/.claude/teams/session-<sid>/inboxes/team-lead.json, which a session that
# is not running an agent team never reads (2026-10-15: 9 report chunks sat unread; probe: "main"
# arrived at once, the session's own peer name is refused). Use --lead team-lead inside a team.
DEFAULT_LEAD = "main"
DEFAULT_TIMEOUT = 2400           # bigteam Step 4 item 5: a tight timeout costs the whole report
# acp-run --wrapup-grace: after the timeout cancel, one last prompt of this many seconds to write the
# report (2026-10-10: stlib had its work verified, then hung in a git commit whose pre-commit Gradle hook
# queued on the machine-wide Gradle slot; the cancel left the report at `STATUS: working`).
DEFAULT_WRAPUP_GRACE = 300
# Appended to an ACP slice's brief after the footer; Agent-tool prompts have no acp-run timeout.
BUDGET_TEXT = """
## Time budget (acp-dispatch)

acp-run stops this slice {minutes} minutes after it starts and cancels whatever command is running then.
Write the report as soon as the work is verified, before a commit, a push or any other long command, so
the report already says what is done if one of them hangs (a pre-commit hook or a build can queue for
minutes behind another build on this machine). Never start a command whose own timeout runs past the
deadline; check the clock with `date` before a long one. {wrapup}
"""
CHECKPOINT_TEXT = """
## Checkpoint mode (acp-dispatch)

Keep `{report}` current while you work. After each logical step, replace it atomically through a
temporary file. Its first line stays `STATUS: working`; include a checklist of steps done, in
progress and remaining, every file touched and its current state, and anything a successor needs.
The checkpoint plus `git diff` must let another agent continue without repeating completed work.
The checkpoint is checked for staleness; rewrite the report at least every 10 minutes of work even if a step is not finished.
"""
WRAPUP_BUDGET = ("If time runs out you get one last turn of {grace} seconds to write the report, and no "
                 "commands then.")
WRAPUP_TEXT = (
    "TIME IS UP: acp-run stopped your turn at its {timeout}-second limit and cancelled any running "
    "command. This is one last turn of {{grace}} seconds. Do not run tests, builds, commits or any other "
    "command. Write the report to `{report}` now: first line `STATUS: timed out`, then what is done, what "
    "was verified, what is unfinished (for example: staged but not committed) and the exact next step; "
    "last line `DONE`. Do not touch `{done}`: acp-dispatch does that once it has recorded the timeout. "
    "Your reply is only `written: {report}`."
)
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
# Agents that may be dispatched without --model. zcode-acp-server's model switch failed for every call until
# 2026-10-15 ("unsupported config option or switch failed: model"); acp-run now gives it ZCODE_BIN, which
# fixes it, so --model is accepted; it stays optional because the agent has only two models.
MODEL_OPTIONAL_AGENTS = {"zcode"}
# Never dispatched without the operator's specific, explicit approval for that run (operator 2026-10-15);
# the same gate is in acp-run.
# omp (operator 2026-10-15) and hermes (same day: "hermes should never be used" as a
# delegation target) need ACP_OPERATOR_APPROVED=<agent>; acp-run applies the same gate.
# cline (operator 2026-10-17): uninstalled, left in place for a deliberate re-enable; Hermes
# keeps its own ClinePass API pool.
# Values from config/routing.toml [dispatch] (via route_agent.POLICY), filled in place by
# load_policy() on first routing use (2026-10-18). They used to be derived at import, so every
# invocation paid for route_agent and its config parse even when it never routed — a trivial
# `reap` or `wait` included; one caller's 5 s reap poll built a load of 110 on its own.
OPERATOR_GATED: set[str] = set()
# Fable at xhigh/max should almost never run (operator 2026-10-18): the same approval gate, keyed
# ACP_OPERATOR_APPROVED=fable-xhigh. Fable at high is the frontier route_agent.py suggests.
FABLE_GATED_EFFORTS: set[str] = set()
# Optional hard cap per service (empty since the reservation replaced `codex = 1`,
# operator 2026-10-18). ACP_DISPATCH_INFLIGHT=name=N overrides (service or agent name).
# A resume is never refused by the reservation or this cap: it continues paid work.
INFLIGHT_CAP: dict[str, int] = {}
FRONTIER_MODELS: list[str] = []
ESTIMATE_FLOOR: dict[str, float] = {}
INFLIGHT_SPAWN_GRACE = 10 * 60           # a running record whose pid is not written yet counts this long
_routing_module = None


def load_policy():
    """Import route_agent once, on first routing use, and fill the [dispatch]-derived constants
    above in place (mutated, not rebound, so their consumers read them as plain globals). Module
    import stays free of it so the cheap subcommands — reap, wait, check, footer, extend,
    finalize — never pay for the routing module and its config parse (2026-10-18)."""
    global _routing_module
    if _routing_module is None:
        bindir = str(Path(__file__).resolve().parent)
        if bindir not in sys.path:
            sys.path.insert(0, bindir)
        import route_agent
        _routing_module = route_agent
    d = _routing_module.POLICY["dispatch"]
    OPERATOR_GATED.clear()
    OPERATOR_GATED.update(d["operator_gated"])
    FABLE_GATED_EFFORTS.clear()
    FABLE_GATED_EFFORTS.update(d["fable_gated_efforts"])
    INFLIGHT_CAP.clear()
    INFLIGHT_CAP.update({k: int(v) for k, v in (d.get("inflight_cap") or {}).items()})
    FRONTIER_MODELS[:] = [str(x).lower() for x in (d.get("frontier_models") or [])]
    ESTIMATE_FLOOR.clear()
    ESTIMATE_FLOOR.update({str(k): float(v) for k, v in (d.get("estimate_floor") or {}).items()})
    return _routing_module


class _RoutingPolicy:
    """route_agent behind first attribute use (a module's own globals do not get PEP 562
    __getattr__), so `_routing_policy.KINDS` in the parsers imports nothing until a
    dispatch-shaped invocation needs the choices."""

    def __getattr__(self, name: str):
        return getattr(load_policy(), name)


_routing_policy = _RoutingPolicy()


# A quota reset further out than this is not waited for (operator 2026-10-18, 6.5a): agy's
# weekly cap resets ~148 h out and resume_unsupported() already says that session may not even
# reopen, and a 5-day codex weekly stop has no business sitting in a launchd job either. finalize
# skips the schedule and `check` points at a reroute. [dispatch].auto_resume_max_wait_hours,
# read at call time so the cheap subcommands stay import-free; ACP_DISPATCH_MAX_WAIT_HOURS
# overrides (tests reuse fixtures whose resets are years out).
def auto_resume_max_wait_hours() -> float:
    return float(os.environ.get("ACP_DISPATCH_MAX_WAIT_HOURS")
                 or (load_policy().POLICY["dispatch"].get("auto_resume_max_wait_hours") or 6))



from datetime import date, datetime, timezone
from pathlib import Path
from typing import Any, NoReturn

HERE = Path(__file__).resolve().parent
FOOTER_FILE = HERE.parent / "docs" / "dispatch-footer.md"
REPORT_SCHEMA = HERE.parent / "config" / "acp-dispatch-report-schema.json"
STATE_ROOT = Path(os.environ.get("ACP_DISPATCH_STATE", str(Path.home() / ".local/state/bigteam")))
LOCK_DIR = Path(os.environ.get("ACP_DISPATCH_LOCK_DIR", str(Path.home() / ".local/state/acp-dispatch")))
DEFAULT_LEAD = "main"
DEFAULT_TIMEOUT = 2400
WAIT_GRACE = 300
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
MODEL_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:/@\[\]+-]{0,127}$")
CLAUDE_REFUSED_BASENAME = re.compile(r"^(REPORT|SUMMARY|FINDINGS|ANALYSIS).*\.md$", re.IGNORECASE)
PROVIDERS = {a: a for a in ("claude", "codex", "antigravity", "cursor", "opencode", "hermes", "omp", "grok")}
READ_ONLY_MODES = {"codex": "read-only"}            # candidates verified at launch; none known for the others
REVIEW_MODES = {"read-only": "read-only", "deny": "review"}   # bin/review-launch --mode, claude only
LIVE_STATUSES = ("running", "initializing")
VIA_LABEL = "ade.via=acp-dispatch"
RETIRED = {"resume": "re-dispatch under a new --name, or `paseo send ID` to continue the agent",
           "reroute": "dispatch the slice to the other agent yourself (route_agent.py plan --kinds KIND)",
           "auto-resume": "Paseo's usage-auto-resume plugin continues agents after a quota reset",
           "extend": "there is no slice deadline to extend: `acp-dispatch wait RECORD --timeout S`",
           "finalize": "`acp-dispatch wait RECORD` finalizes", "execute": "`acp-dispatch wait RECORD`",
           "reap": "`paseo ls -g` shows what runs; `acp-dispatch wait RECORD` finalizes",
           "cursor-cloud": "run bin/cursor-cloud directly"}
STATUS_EXIT = {"done": 0, "partial": 1, "running": 1, "pending": 1, "no-report": 3, "blocked": 4,
               "permission": 4, "unavailable": 5, "refused": 2, "tripwire": 77, "timeout": 124}
UNAVAILABLE_EXIT, LOAD_GATE_EXIT, TRIPWIRE_EXIT, TIMEOUT_EXIT = 5, 75, 77, 124
LOAD_WAIT_DEFAULT, LOAD_GATE_GRACE, LOAD_SCRUB_PREFIX = 1800, 180, "LW_"
LOAD_RETRY_TEXT = "machine too hot; retry later"
AGENT_CAP_DEFAULT, COUNTABLE_S, LOCK_GRACE_S, CAP_POLL_S, RENEW_S = 14, 10.0, 180.0, 15.0, 60.0
INFLIGHT_SPAWN_GRACE = 10 * 60
NO_REPORT_PREFIX = "NO-REPORT:"
PLACEHOLDER_MODELS = frozenset({"m1"})
FRONTIER_POOLS = {"claude": 1, "codex": 2}
ADVISOR_NOTE = """
## Advisor role

This is a read-only review or consultation. Do not edit, create or delete files in the working
tree, commit, push or change git config. The deliverable is the report: findings, recommendations,
and exact file:line references.
"""
REVIEW_NOTE = """
**This run is read-only (`--perm {perm}`, bin/review-launch `--mode {mode}`).** You can only read ({tools}),
inside the working directory, and any other call stops the run. You cannot write `{report}` or touch its `.done`
marker, so do not try: put the whole report, in the shape the delivery contract describes (first line `STATUS:`
or `BLOCKED:`, last line `DONE`), in the `report` field of your structured output; acp-dispatch writes the file and
the marker for you. This overrides items 1, 2, 3 and 7 of the delivery contract.
"""
MODE_NOTE = """
**This run is read-only (`--perm read-only`, the provider's `{mode}` mode).** You cannot change files. Write
nothing; put the whole report, in the shape the delivery contract describes, in your final message.
"""
BUDGET_TEXT = """
## Time budget (acp-dispatch)

The lead stops waiting for this slice {minutes} minutes after it starts. Write the report as soon as the work is
verified, before a commit, a push or any other long command, and never start a command whose own timeout runs past
the deadline (check the clock with `date` before a long one).
"""
OPERATOR_GATED: set[str] = set()
FABLE_GATED_EFFORTS: set[str] = set()
INFLIGHT_CAP: dict[str, int] = {}
FRONTIER_MODELS: list[str] = []
ESTIMATE_FLOOR: dict[str, float] = {}
REPO_FLOORS: dict[str, float] = {}
_ROUTER: list[Any] = []
_RESERVATION: dict[str, str] = {}


def die(msg: str, code: int = 2) -> NoReturn:
    print(f"acp-dispatch: {msg}", file=sys.stderr)
    sys.exit(code)


def write_atomic(path: Path, text: str) -> None:
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    tmp.write_text(text)
    os.replace(tmp, path)


def write_record(path: Path, rec: dict) -> None:
    write_atomic(path, json.dumps(rec, indent=1, sort_keys=True) + "\n")


@contextmanager
def record_lock(path: Path):
    with path.with_name(path.name + ".lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def read_record(path: Path) -> dict:
    rec = json.loads(path.read_text())
    if not isinstance(rec, dict):
        raise ValueError("record is not a JSON object")
    return rec


def update_record(path: Path, **fields) -> dict:
    with record_lock(path):
        rec = read_record(path)
        rec.update(fields)
        write_record(path, rec)
        return rec


# ---------------------------------------------------------------- paseo, review-launch, load-watch

def paseo_bin() -> str:
    found = os.environ.get("ACP_DISPATCH_PASEO") or shutil.which("paseo")
    if not found:
        die("paseo is not on PATH (this shim launches through Paseo)")
    return found


def paseo_json(args: list[str], timeout: float | None = 60) -> tuple[Any, str]:
    """(parsed --json stdout, "") or (None, why). `--json` goes before a `--` (the prompt after it stays a
    positional). Exit status is not trusted for success: the JSON is."""
    cut = args.index("--") if "--" in args else len(args)
    cmd = [paseo_bin(), *[x for x in args[:cut] if x != "--json"], "--json", *args[cut:]]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, check=False)
    except (OSError, subprocess.SubprocessError) as e:
        return None, f"paseo {args[0]} failed ({e})"
    try:
        data = json.loads(r.stdout) if r.stdout.strip() else None
    except ValueError:
        data = None
    if isinstance(data, dict) and isinstance(data.get("error"), dict):
        return None, f"paseo {args[0]}: {data['error'].get('message') or data['error'].get('code')}"
    if r.returncode != 0 or data is None:
        return None, f"paseo {args[0]} exited {r.returncode}: {(r.stderr or r.stdout).strip()[-300:]}"
    return data, ""


def provider_entry(provider: str) -> dict:
    """The provider's `paseo provider ls --json` row; it must be enabled and available (retried while loading)."""
    for attempt in range(6):
        data, why = paseo_json(["provider", "ls"])
        rows = data if isinstance(data, list) else []
        row = next((x for x in rows if isinstance(x, dict) and x.get("provider") == provider), None)
        if row is not None and row.get("status") == "loading" and attempt < 5:
            time.sleep(2)
            continue
        if row is None:
            die(f"Paseo has no provider {provider!r} ({why or 'not in paseo provider ls'})")
        if row.get("enabled") != "Enabled" or row.get("status") != "available":
            die(f"Paseo provider {provider} is {row.get('enabled')}/{row.get('status')}, not Enabled/available")
        return row
    die(f"Paseo provider {provider} is still loading")


def review_launch_bin() -> str:
    return os.environ.get("ACP_DISPATCH_REVIEW_LAUNCH") or str(HERE / "review-launch")


def count_agents() -> tuple[int | None, set[str] | None, set[str], str]:
    """(live count, live ids, every listed id, why) of this shim's Paseo agents; count and live None when unreadable."""
    data, why = paseo_json(["ls", "-g", "--background", "--label", VIA_LABEL], timeout=30)
    if not isinstance(data, list):
        return None, None, set(), why or "paseo ls printed no list"
    rows = [x for x in data if isinstance(x, dict) and x.get("id")]
    live = {str(x["id"]) for x in rows if x.get("status") in LIVE_STATUSES}
    return len(live), live, {str(x["id"]) for x in rows}, ""


def agent_cap() -> int:
    raw = os.environ.get("LW_MAX_AGENTS", "").strip()
    try:
        return max(0, int(raw)) if raw else AGENT_CAP_DEFAULT
    except ValueError:
        print(f"acp-dispatch: warning: ignoring LW_MAX_AGENTS={raw!r}", file=sys.stderr)
        return AGENT_CAP_DEFAULT


LOAD_KNOBS = (("LW_MAX_AGENTS", "--max-agents", True, 0), ("LW_MIN_FREE_MB", "--min-free-mb", False, 0),
              ("LW_MAX_COMPRESSOR_S", "--max-mem-churn", False, 1), ("LW_MAX_PAGEINS_S", "--max-pageins", False, 1))


def load_gate_knobs() -> tuple[list[str], dict[str, str]]:
    """admit flags from LW_* (validated; a bad one is warned about and dropped); `--max-agents` is always passed."""
    flags, cap_given = [], False
    for var, flag, integer, low in LOAD_KNOBS:
        raw = os.environ.get(var, "").strip()
        if not raw:
            continue
        try:
            val = int(raw) if integer else float(raw)
        except ValueError:
            val = -1
        if val < low or (not integer and not math.isfinite(val)):
            print(f"acp-dispatch: warning: ignoring {var}={raw!r} (need a number, {low} or more)", file=sys.stderr)
            continue
        flags.append(f"{flag}={val}")
        cap_given = cap_given or flag == "--max-agents"
    if not cap_given:
        flags.append("--max-agents")
    calm = os.environ.get("LW_BOOST_CALM_S", "").strip()
    return flags, ({"LW_BOOST_CALM_S": calm} if re.fullmatch(r"\d+(\.\d+)?", calm) else {})


def load_watch_bin() -> str:
    path = os.path.expanduser(os.environ.get("ACP_DISPATCH_LOAD_WATCH") or str(HERE / "load-watch"))
    return (shutil.which(path) or path) if os.sep not in path else str(Path(path).resolve())


def lw_call(verb: str, rid: str, path: str) -> None:
    try:
        subprocess.run([path, verb, rid], check=False, capture_output=True, timeout=20,
                       env={k: v for k, v in os.environ.items() if not k.startswith(LOAD_SCRUB_PREFIX)})
    except (OSError, subprocess.SubprocessError):
        pass


def release_reservation() -> None:
    rid, path = _RESERVATION.pop("id", None), _RESERVATION.pop("path", None)
    if rid and path:
        lw_call("release", rid, path)


def load_gate(wait: int) -> tuple[bool, dict, str]:
    """(admitted, info, why) from `load-watch admit`. Only 75 (and 2: admit refused its own arguments) refuse; a
    missing, crashed or unreadable load-watch warns and admits (a dispatcher that cannot read the load must not stop
    all work). The admission's agent reservation is held in _RESERVATION and released at exit at the latest."""
    path = load_watch_bin()

    def unknown(why: str) -> tuple[bool, dict, str]:
        print(f"acp-dispatch: warning: {why}; starting without the load gate", file=sys.stderr)
        return True, {"load1": None, "per_core": None, "waited_s": 0, "error": why}, why

    if not Path(path).exists():
        return unknown(f"{path} not found")
    flags, extra = load_gate_knobs()
    env = {k: v for k, v in os.environ.items() if not k.startswith(LOAD_SCRUB_PREFIX)}
    try:
        proc = subprocess.run([path, "admit", "--wait", str(wait), "--json", *flags], stdout=subprocess.PIPE,
                              text=True, timeout=wait + LOAD_GATE_GRACE, env={**env, **extra}, check=False)
    except (OSError, subprocess.SubprocessError) as e:
        return unknown(f"load-watch admit failed ({e})")
    try:
        data = json.loads(proc.stdout.strip().splitlines()[-1])
        info = {"load1": data["load1"], "per_core": data["per_core"], "waited_s": data.get("waited_s", 0)}
        if isinstance(data.get("refused"), list):
            info["refused"] = [str(x) for x in data["refused"]]
        if isinstance(data.get("reservation"), str) and data["reservation"]:
            info["reservation"] = data["reservation"]
    except (IndexError, KeyError, TypeError, ValueError):
        info = None
    if proc.returncode == 0:
        if info is None:
            return unknown(f"load-watch admit exited 0 with output the gate cannot read ({proc.stdout.strip()[:80]!r})")
        if info.get("reservation"):
            _RESERVATION.update(id=info["reservation"], path=path)
            atexit.register(release_reservation)
        return True, info, "ok"
    if proc.returncode in (LOAD_GATE_EXIT, 2):
        info = info or {"load1": None, "per_core": None, "waited_s": wait}
        if proc.returncode == 2:
            info["refused"] = ["admit_usage"]
        why = f" refused={','.join(info['refused'])}" if info.get("refused") else ""
        return False, info, (f"{LOAD_RETRY_TEXT}: load1={info['load1']} per_core={info['per_core']}{why} after "
                             f"waiting {info['waited_s']}s of the {wait}s --load-wait budget; not launched")
    return unknown(f"load-watch admit exited {proc.returncode}")


def renew_while(stop: threading.Event, rid: str | None, path: str | None) -> threading.Thread | None:
    """Keep a review-launch run's admit reservation alive until `stop` is set (the run is its only count)."""
    if not rid or not path:
        return None

    def loop() -> None:
        while not stop.wait(RENEW_S):
            lw_call("renew", rid, path)
    t = threading.Thread(target=loop, daemon=True)
    t.start()
    return t


@contextmanager
def launch_lock():
    """One launch at a time machine-wide, from the live count to the new agent being countable."""
    LOCK_DIR.mkdir(parents=True, exist_ok=True)
    with (LOCK_DIR / "launch.lock").open("a") as fh:
        end = time.monotonic() + LOCK_GRACE_S
        while True:
            try:
                fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() > end:
                    die(f"{LOAD_RETRY_TEXT}: another launch held the lock for {LOCK_GRACE_S:g}s", LOAD_GATE_EXIT)
                time.sleep(0.1)
        try:
            yield
        finally:
            fcntl.flock(fh, fcntl.LOCK_UN)


# ---------------------------------------------------------------- routing policy and the frontier guards

def route_module():
    if not _ROUTER:
        if str(HERE) not in sys.path:
            sys.path.insert(0, str(HERE))
        import route_agent
        d = route_agent.POLICY["dispatch"]
        OPERATOR_GATED.update(d["operator_gated"])
        FABLE_GATED_EFFORTS.update(d["fable_gated_efforts"])
        INFLIGHT_CAP.update({k: int(v) for k, v in (d.get("inflight_cap") or {}).items()})
        FRONTIER_MODELS[:] = [str(x).lower() for x in (d.get("frontier_models") or [])]
        ESTIMATE_FLOOR.update({str(k): float(v) for k, v in (d.get("estimate_floor") or {}).items()})
        _ROUTER.append(route_agent)
    return _ROUTER[0]


def guard_module():
    """bin/agent_guard.py: the per-agent identity policy (which agents' admitted model must be the billed one)."""
    if str(HERE) not in sys.path:
        sys.path.insert(0, str(HERE))
    import agent_guard
    return agent_guard


def approved_tokens() -> set[str]:
    return {x.strip() for x in os.environ.get("ACP_OPERATOR_APPROVED", "").split(",") if x.strip()}


def is_frontier_model(model: str | None) -> bool:
    low = (model or "").lower()
    return bool(low) and any(tok in low for tok in FRONTIER_MODELS)


def resolve_service(agent: str, model: str | None) -> str | None:
    mapping = route_module().map_agent_to_provider(agent, model)
    return route_module().pool_service(*mapping) if mapping else None


def pool_reading(agent: str, model: str | None, fresh: bool = False) -> tuple[float | None, dict]:
    service = resolve_service(agent, model)
    if service is None:
        return None, {}
    info = route_module().load_snapshot(bypass_memo=fresh)[0].get(service) or {}
    return info.get("remaining"), info


def binding_window_note(windows: dict) -> str:
    known = {k: float(v) for k, v in (windows or {}).items() if v is not None}
    if not known:
        return ""
    label = min(known, key=known.get)
    return f" (binding window: {label}, {known[label]:.1f}% left)"


def estimate_floor_and_cap(model: str | None, service: str | None, kind: str | None) -> tuple[float, float | None]:
    """[dispatch.estimate_floor], or the -C repo's override, which is then also the cap (operator 2026-11-01)."""
    router, frontier = route_module(), is_frontier_model(model)
    over = router.floor_lookup(REPO_FLOORS, service or "", kind, frontier)
    if over is not None:
        return over, over
    base = router.floor_lookup(ESTIMATE_FLOOR, service or "", kind, frontier)
    return (base if base is not None else 0.0), None


def measured_history(out: Path, agent: str, model: str | None, kind: str | None, effort: str | None,
                     strict: bool) -> tuple[list[dict], str]:
    """Measured rows: this task's (3 or more) else the newest 20 machine-wide else the task's few."""
    router = route_module()
    task = router.history_rows(list((out / "jobs").glob("*.json")), agent, model, skip_placeholders=False,
                               placeholder_models=PLACEHOLDER_MODELS, kind=kind, effort=effort, strict=strict)
    if len(task) >= 3:
        return [r for _, r in task], f"history ({len(task)} slices, task)"
    machine = router.history_rows(sorted(STATE_ROOT.glob("*/jobs/*.json")), agent, model, skip_placeholders=True,
                                  placeholder_models=PLACEHOLDER_MODELS, kind=kind, effort=effort, strict=strict)[:20]
    if machine:
        return [r for _, r in machine], f"history ({len(machine)} slices, machine)"
    return [r for _, r in task], (f"history ({len(task)} slices, task)" if task else "brief-size default")


def estimates(out: Path, agent: str, model: str | None, prompt: str, service: str | None, kind: str | None,
              effort: str | None, labels: list[str]) -> tuple[float, dict[str, float], str]:
    """(scalar estimate, per-window estimates, source), floored the way the planner's pool_fits floors them."""
    router = route_module()
    rows, source = measured_history(out, agent, model, kind, effort,
                                    router.kind_floor_applies(ESTIMATE_FLOOR, service or "", kind))
    floor, cap = estimate_floor_and_cap(model, service, kind)
    values = [float(r["measured_usage_pct"]) for r in rows if r.get("measured_usage_pct") is not None]
    default = 3.0 if len(prompt) <= 2000 else 7.0 if len(prompt) <= 8000 else 12.0
    scalar = router.estimate_from_history(values, floor, *(() if values else (default,)), cap=cap)
    return scalar, router.estimate_windows_from_rows(rows, floor, labels, cap), source


def inflight_cap(agent: str, service: str | None) -> int | None:
    caps = dict(INFLIGHT_CAP)
    for item in os.environ.get("ACP_DISPATCH_INFLIGHT", "").split(","):
        name, _, n = item.partition("=")
        if name.strip() and n.strip().isdigit():
            caps[name.strip()] = int(n)
    return caps.get(service) if service and service in caps else caps.get(agent)


def pid_alive(pid: Any) -> bool:
    try:
        os.kill(int(pid), 0)
        return True
    except (TypeError, ValueError, ProcessLookupError):
        return False
    except PermissionError:
        return True


def inflight_records(service: str | None, agent: str, skip: Path, out: Path, live: set[str] | None) -> list[Path]:
    """Running records on this service (else this agent): a Paseo slice counts while `paseo ls` shows it live (every
    running record counts when the list is unreadable), a review-launch run while its runner lives, any record for
    INFLIGHT_SPAWN_GRACE after it started."""
    busy, seen = [], {skip.resolve()}
    for path in sorted({*STATE_ROOT.glob("*/jobs/*.json"), *(out / "jobs").glob("*.json")}):
        if path.resolve() in seen:
            continue
        seen.add(path.resolve())
        try:
            row = read_record(path)
        except (OSError, ValueError):
            continue
        if row.get("status") != "running" or row.get("finished"):
            continue
        mine = (resolve_service(str(row.get("agent") or ""), row.get("model")) == service) if service \
            else row.get("agent") == agent
        if not mine:
            continue
        aid = row.get("paseo_agent_id")
        if ((aid and (live is None or aid in live)) or (row.get("boundary") == "review-launch" and pid_alive(row.get("pid")))
                or time.time() - float(row.get("started") or 0) < INFLIGHT_SPAWN_GRACE):
            busy.append(path)
    return busy


def reserved_usage(busy: list[Path], labels: list[str]) -> tuple[float, dict[str, float]]:
    """Sum of the in-flight slices' estimates (the whole estimate, conservatively), per window too."""
    total, windows = 0.0, {}
    for path in busy:
        try:
            row = read_record(path)
            scalar = float(row.get("estimated_usage_pct") or 0)
        except (OSError, ValueError, TypeError):
            continue
        total += scalar
        row_windows = row.get("estimated_usage_windows") or {}
        for label in (row_windows or (labels if scalar else [])):
            try:
                windows[label] = windows.get(label, 0.0) + float(row_windows.get(label, scalar))
            except (TypeError, ValueError):
                pass
    return total, windows


def frontier_inflight(busy: list[Path]) -> int:
    n = 0
    for path in busy:
        try:
            n += read_record(path).get("kind") == "frontier"
        except (OSError, ValueError):
            n += 1      # an unreadable in-flight record counts: the cap fails closed
    return n


def frontier_judged(reason: str | None, service: str | None, model: str | None, remaining: float | None,
                    busy: list[Path]) -> tuple[dict | None, str | None]:
    """(grant, note) of the frontier allowance (docs/gates.md): a reason, a frontier model on the claude or codex pool,
    the family's judged key on, its cap floor, and fewer than its per-wave frontier slices in flight. Never raises; no
    grant is the closed treatment (the dispatch proceeds without the allowance)."""
    if reason is None:
        return None, None
    if not is_frontier_model(model) or service not in FRONTIER_POOLS:
        return None, ("frontier-reason recorded; the model is not a frontier model on the claude or codex pool "
                      f"(the allowance covers those two pools only; this is service {service or '?'})")
    try:
        import ade_gates
        now = datetime.now(timezone.utc)
        t, info = ade_gates.load_frontier(now)
        fam = FRONTIER_POOLS[service]
        if t[f"frontier{fam}_judged"] < 1:
            return None, "frontier-reason recorded; no frontier allowance is in force (closed gate: gates.toml unreadable or closed)"
        block = ade_gates.judged_pool_block(fam, t, now, ade_gates.read_guard_state() if fam == 1 else None, remaining)
        if block:
            return None, f"frontier-reason recorded; frontier allowance not granted: {block}"
        cap, used = int(t[f"frontier{fam}_per_wave"]), frontier_inflight(busy)
        if used >= cap:
            return None, (f"frontier-reason recorded; frontier allowance not granted: {used} frontier slice(s) "
                          f"already in flight on {service} (cap {cap} per wave)")
        prof = info.get("profile") or {}
        return {"family": fam, "profile": prof.get("name"), "until": prof.get("until"), "per_wave": cap,
                "in_flight": used, "granted_at": ade_gates.iso(now)}, None
    except Exception as e:  # noqa: BLE001 - an unreadable gate is the closed treatment, never a crash or a grant
        return None, f"frontier-reason recorded; frontier allowance not granted: gate unreadable ({type(e).__name__})"


def identity_refusal(agent: str, argv: list[str], model: str) -> str | None:
    """agent_guard's identity policy on the launch argv: for a guarded agent the admitted model is the only one in
    it (exactly one `--provider P/M` or review-launch `--model M`, no other model, env or settings option)."""
    if guard_module().policy(agent).status != guard_module().GUARDED:
        return None
    opts = [x.split("=", 1)[0] for x in argv if x.startswith("--")]
    pinned = [argv[i + 1] for i, x in enumerate(argv[:-1]) if x in ("--provider", "--model")]
    want = model if "--model" in opts else f"{PROVIDERS[agent]}/{model}"
    if pinned != [want] or any(o in ("--env", "--settings", "--mcp-config", "--agent") for o in opts):
        return f"{agent}: the launch command does not pin exactly the admitted model {model!r} (agent_guard)"
    return None


# ---------------------------------------------------------------- footer, briefs, classification

def done_path(report: Path) -> Path:
    return report.with_name(report.name + ".done")


def footer_text(report: Path, lead: str, inbox: Path | None = None, replies: Path | None = None) -> str:
    try:
        text = FOOTER_FILE.read_text()
    except OSError as e:
        die(f"footer missing: {FOOTER_FILE} ({e})")
    return (text.replace("{report}", str(report)).replace("{done}", str(done_path(report)))
            .replace("{inbox}", str(inbox or report.with_name(report.name + ".inbox.md")))
            .replace("{replies}", str(replies or report.with_name(report.name + ".replies.md")))
            .replace("{lead}", lead))


def check_report_name(report: Path) -> None:
    if CLAUDE_REFUSED_BASENAME.match(report.name):
        die(f"report basename {report.name!r} starts with report/summary/findings/analysis and ends in .md: "
            "Claude Code refuses a sub-agent's Write there. Use <name>-report.md.")


def read_brief(path: str) -> str:
    """A `-f` file's task text. An earlier dispatch's own `<name>-brief.md` comes back as the prompt its record stored
    (one contract, the new name's); any other file is passed whole, and a footer heading in it is announced."""
    p = Path(path).expanduser()
    try:
        text = p.read_text()
    except OSError as e:
        die(f"cannot read the brief {p}: {e}")
    if p.name.endswith("-brief.md"):
        try:
            rec = read_record(p.resolve().parent / "jobs" / (p.name[:-len("-brief.md")] + ".json"))
            prompt = rec.get("prompt")
            if Path(rec.get("brief") or "").resolve() == p.resolve() and isinstance(prompt, str) and prompt.strip() \
                    and text.startswith(prompt.rstrip()):
                print(f"acp-dispatch: stripped {len(text[len(prompt.rstrip()):].encode())} bytes of an earlier "
                      f"dispatch's footer from {p}", file=sys.stderr)
                return prompt.rstrip() + "\n"
        except (OSError, ValueError):
            pass
    if "## Delivery contract (shared footer" in text:
        print(f"acp-dispatch: {p} has a delivery-contract heading that is not an earlier dispatch's own, so "
              "nothing was stripped from it", file=sys.stderr)
    return text


def report_finished(lines: list[str]) -> bool:
    nonblank = [ln.strip() for ln in lines if ln.strip()]
    return bool(nonblank) and (nonblank[-1] == "DONE" or (
        len(nonblank) > 1 and nonblank[-2] == "DONE" and nonblank[-1].startswith("AC_DONE:")))


def classify(report: Path, done: Path | None = None, finished: bool | None = None) -> tuple[str, str]:
    """(status, detail) of one report; `finished` is what the launcher knows (None: the .done marker decides)."""
    done = done or done_path(report)
    is_done = finished if finished is not None else done.exists()
    try:
        lines = [ln for ln in report.read_text().splitlines() if ln.strip()]
    except OSError:
        lines = []
    if not lines:
        return (("no-report", "finished with no report: delivery failure, re-task it") if is_done
                else ("pending", "no report yet (not finished, or stalled: check the agent)"))
    first, last = lines[0].strip(), lines[-1].strip()
    if first.upper().startswith("BLOCKED:"):
        return "blocked", first
    if last.startswith(NO_REPORT_PREFIX):
        return "no-report", last
    if report_finished(lines):
        return "done", first if first.upper().startswith("STATUS:") else f"{sum(map(len, lines))} chars"
    return "partial", f"no DONE line yet; first line: {first[:120]}"


def check_record(path: Path) -> tuple[str, str, str, str]:
    try:
        rec = read_record(path)
    except (OSError, ValueError) as e:
        return "no-report", path.stem, str(path), f"unreadable record: {e}"
    name, report = rec.get("name", path.stem), Path(rec.get("report") or path.with_suffix(".md"))
    if rec.get("status") == "unavailable":
        cls = rec.get("unavailable_class")
        return "unavailable", name, str(report), (f"{LOAD_RETRY_TEXT} ({rec.get('detail', '')})" if cls == "load"
                                                   else rec.get("detail", "pool unavailable; re-plan"))
    if rec.get("status") in ("tripwire", "refused", "permission", "timeout"):
        return rec["status"], name, str(report), str(rec.get("detail") or rec["status"])
    finished = bool(rec.get("finished"))
    st, det = classify(report, Path(rec.get("done") or done_path(report)), finished=finished or None)
    if not finished and st == "pending" and rec.get("status") == "running":
        st, det = "running", f"running (paseo agent {rec.get('paseo_agent_id') or rec.get('pid')})"
    return st, name, str(report), det


def check_items(items: list[str]) -> int:
    rows = []
    for item in items:
        p = Path(item).expanduser()
        if p.is_dir():
            recs = sorted((p / "jobs").glob("*.json"))
            rows += [check_record(r) for r in recs] or [
                (*classify(rep)[:1], rep.stem.removesuffix("-report"), str(rep), classify(rep)[1])
                for rep in sorted(p.glob("*-report.md"))]
        elif p.suffix == ".json":
            rows.append(check_record(p))
        else:
            st, det = classify(p)
            rows.append((st, p.stem.removesuffix("-report"), str(p), det))
    if not rows:
        print("check: nothing to check", file=sys.stderr)
        return 2
    worst = 0
    for st, name, path, det in rows:
        print(f"{st}\t{name}\t{path}\t{det}")
        worst = max(worst, LOAD_GATE_EXIT if st == "unavailable" and det.startswith(LOAD_RETRY_TEXT)
                    else STATUS_EXIT.get(st, 1))
    return worst


# ---------------------------------------------------------------- dispatch

def unavailable(out: Path, a: argparse.Namespace, reason: str, cls: str, code: int = UNAVAILABLE_EXIT,
                **extra) -> int:
    release_reservation()
    record = out / "jobs" / f"{a.name}.json"
    record.parent.mkdir(parents=True, exist_ok=True)
    write_record(record, {"name": a.name, "agent": a.agent, "model": a.model, "kind": a.kind, "task": a.task,
                          "out": str(out), "record": str(record), "report": str(out / f"{a.name}-report.md"),
                          "status": "unavailable", "unavailable_class": cls, "detail": reason, "perm": a.perm,
                          "started": time.time(), "finished": time.time(), "exit": code, **extra})
    print(f"unavailable\t{a.name}\tclass={cls} agent={a.agent} model={a.model} {reason}")
    return code


def gate_policy(a: argparse.Namespace, service: str | None, approved: set[str]) -> None:
    """The refusals that need no reading: operator gates, Go cost policy, frontier kind and role, eligibility."""
    if a.agent in OPERATOR_GATED and a.agent not in approved:
        die(f"{a.agent} needs specific, explicit operator approval for this run; ask first, then set "
            f"ACP_OPERATOR_APPROVED={a.agent}")
    if "fable" in a.model.lower() and (a.effort or "").lower() in FABLE_GATED_EFFORTS and "fable-xhigh" not in approved:
        die(f"fable at --effort {a.effort} needs explicit operator approval for this run; use --effort high, or ask "
            "first, then set ACP_OPERATOR_APPROVED=fable-xhigh")
    if a.agent == "opencode":
        import go_model_policy
        a.go_advisory = go_model_policy.classification(a.model) == "advisory" and a.role == "advise"
        why = go_model_policy.refusal(a.model, advisory=a.go_advisory, timeout=a.timeout, perm=a.perm)
        if why:
            die(why)
        if a.go_advisory and a.kind not in go_model_policy.policy()["advisory_kinds"]:
            die("Go advisory use requires --kind judgment, research or frontier")
    if is_frontier_model(a.model) and a.kind != "frontier":
        die(f"model {a.model!r} is a frontier model; use --kind frontier (route-override does not skip this)")
    if a.kind == "frontier" or getattr(a, "go_advisory", False):
        a.role = a.role or "advise"
        if a.role == "exec" and "frontier-exec" not in approved:
            die("--role exec with --kind frontier needs ACP_OPERATOR_APPROVED=frontier-exec (frontier is advisor "
                "by default; operator 2026-10-18)")
    else:
        a.role = "exec"
    router = route_module()
    svc = router.BY_NAME.get(service) if service else None
    svc = svc or router.BY_NAME.get(router.ALIASES.get(a.agent, a.agent))
    quota = router.load_snapshot()[0] if svc is not None and a.kind in svc.plenty_kinds else None
    ok = svc.eligible(a.kind, quota) if svc is not None else a.kind in router.DEFAULT_PROFILE
    if not ok and not getattr(a, "go_advisory", False) and "route-override" not in approved:
        die(f"{service or a.agent} is not eligible for --kind {a.kind}; override with "
            f"ACP_OPERATOR_APPROVED=route-override (or run route_agent.py plan --kinds {a.kind})")


def launch_argv(a: argparse.Namespace, boundary: str, mode: str, brief: Path, report: Path, prompt: str,
                schema: Path) -> list[str]:
    if boundary == "review-launch":
        return [review_launch_bin(), "--mode", mode, "-C", a.dir, "--schema", str(schema), "-f", str(brief),
                "--model", a.model, *(["--timeout", str(a.timeout)] if a.timeout else []), "--json"]
    labels = [VIA_LABEL, f"ade.kind={a.kind}", f"ade.name={a.name}", f"ade.lead={a.lead}"]
    return [paseo_bin(), "run", "--provider", f"{PROVIDERS[a.agent]}/{a.model}", "--mode", mode, "--no-wait", "--json",
            "--title", a.name, "--cwd", a.dir, *[x for lb in labels for x in ("--label", lb)],
            *(["--thinking", a.effort] if a.effort else []), "--", prompt]


def dispatch(a: argparse.Namespace) -> int:
    if a.agent in RETIRED:
        die(f"`acp-dispatch {a.agent}` was retired with the Paseo shim (slim-down E6): {RETIRED[a.agent]}")
    if a.agent not in PROVIDERS:
        die(f"unknown agent {a.agent!r}: acp-dispatch launches Paseo providers, one of {', '.join(PROVIDERS)}")
    if not a.model:
        die("--model is required (an agent's own default is the expensive one; `paseo provider models P` lists them)")
    if not MODEL_RE.match(a.model) or (a.effort and not MODEL_RE.match(a.effort)):
        die("--model and --effort are one word each (letters, digits, . _ : / @ [ ] + -)")
    if not NAME_RE.match(a.name):
        die("--name must be 1-64 chars of letters, digits, . _ - (it names every output file)")
    if bool(a.prompt) == bool(a.prompt_file):
        die("give exactly one of -p PROMPT or -f BRIEF")
    if a.timeout < 0 or (a.wait_timeout is not None and a.wait_timeout < 0):
        die("timeouts must be 0 or more")
    if a.no_wait and not a.detach:
        die("--no-wait needs --detach")
    a.dir = str(Path(a.dir).expanduser().resolve())
    if not Path(a.dir).is_dir():
        die(f"-C {a.dir} is not a directory")
    approved, router = approved_tokens(), route_module()
    service = resolve_service(a.agent, a.model)
    gate_policy(a, service, approved)
    frontier_reason = None
    if a.kind == "frontier":
        import ade_gates
        frontier_reason, problem = ade_gates.frontier_reason(a.frontier_reason)
        if problem:
            die(f"--frontier-reason: {problem}")
    elif a.frontier_reason not in (None, ""):
        die("--frontier-reason applies only to a --kind frontier dispatch")
    provider = PROVIDERS[a.agent]
    if a.perm == "all":
        boundary, mode = "paseo", str(provider_entry(provider).get("defaultMode") or "default")
    elif a.agent == "claude":
        boundary, mode = "review-launch", REVIEW_MODES[a.perm]
    elif a.perm == "read-only" and provider in READ_ONLY_MODES:
        provider_entry(provider)
        boundary, mode = "paseo-mode", READ_ONLY_MODES[provider]
    else:
        die(f"--perm {a.perm} is refused for {a.agent}: Paseo has no verified "
            f"{'no-tool' if a.perm == 'deny' else 'non-editing'} mode for it (only claude has the review-launch "
            "boundary; codex has the read-only provider mode)")
    REPO_FLOORS.update(router.repo_floors(router.repo_of(a.dir)))   # the -C repo's estimate-floor override
    out = Path(a.out).expanduser().resolve() if a.out else STATE_ROOT / (a.task or f"adhoc-{date.today().isoformat()}")
    report, record = out / f"{a.name}-report.md", out / "jobs" / f"{a.name}.json"
    check_report_name(report)
    done, brief, stderr = done_path(report), out / f"{a.name}-brief.md", out / f"{a.name}-stderr.txt"
    if done.exists() and not a.force:
        die(f"{done} exists: this slice already finished. Use a new --name or --force to redo it.")
    if record.exists() and not a.force:
        try:
            old = read_record(record)
            if old.get("status") == "running" and not old.get("finished"):
                die(f"{record} is a live slice (paseo agent {old.get('paseo_agent_id')}); use a new --name or --force")
        except (OSError, ValueError):
            pass
    prompt = read_brief(a.prompt_file) if a.prompt_file else a.prompt
    gate_info = None
    if not a.dry_run and gate_on(a):
        admitted, gate_info, why = load_gate(load_wait(a))
        if not admitted:
            return unavailable(out, a, why, "load", LOAD_GATE_EXIT, load_gate=gate_info)
    remaining, reading = pool_reading(a.agent, a.model, fresh=gate_info is not None)
    windows = (reading or {}).get("windows") or {}
    if a.est_pct is not None:
        if a.est_pct < 0:
            die("--est-pct must be 0 or more")
        estimate, per_window, source = a.est_pct, {}, "explicit"
    else:
        estimate, per_window, source = estimates(out, a.agent, a.model, prompt, service, a.kind, a.effort, list(windows))
        per_window = {k: v for k, v in per_window.items() if windows.get(k) is not None}
    live = count_agents()[1] if not a.dry_run else None
    busy = inflight_records(service, a.agent, record, out, live)
    judged, judged_note = frontier_judged(frontier_reason, service, a.model, remaining, busy)
    if judged_note or judged:
        print(f"acp-dispatch: {judged_note or 'frontier judged use: ' + str(frontier_reason)}", file=sys.stderr)
    reserved, reserved_win = reserved_usage(busy, list(windows))
    left = float(remaining) - reserved if remaining is not None else None
    fit_windows = {k: float(v) - reserved_win.get(k, 0.0) for k, v in windows.items() if v is not None}
    win_refusal, _ = router.window_fit(per_window, fit_windows)
    bare_refusal, _ = router.window_fit(per_window, windows)
    fails = bool(win_refusal) if per_window else (left is not None and estimate > left)
    fits_alone = not bare_refusal if per_window else (remaining is None or estimate <= float(remaining))
    cap = inflight_cap(a.agent, service)
    refusal = None
    if a.min_headroom > 0 and remaining is not None and remaining < a.min_headroom:
        refusal = ("headroom", f"headroom {remaining:.1f}% < minimum {a.min_headroom:.1f}%{binding_window_note(windows)}")
    elif fails:
        detail = win_refusal or f"estimated use {estimate:.1f}% > {left:.1f}% left after reserving {reserved:.1f}% for in-flight"
        refusal = (("inflight", f"{detail}; in-flight on {service or a.agent}: {', '.join(p.stem for p in busy[:5])}")
                   if busy and fits_alone else ("wont-fit", detail + binding_window_note(windows)))
    elif cap is not None and len(busy) >= cap:
        refusal = ("inflight", f"{len(busy)} {service or a.agent} slice(s) already in flight (cap {cap}): "
                               f"{', '.join(p.stem for p in busy[:3])}")
    if refusal and not a.dry_run:
        return unavailable(out, a, refusal[1], refusal[0])
    footer = footer_text(report, a.lead, record.with_suffix(".inbox.md"), record.with_suffix(".replies.md"))
    note = {"review-launch": REVIEW_NOTE.format(perm=a.perm, mode=mode, report=report, tools=(
                "Read, Grep, Glob, WebFetch, WebSearch" if mode == "read-only" else "Read, Grep, Glob")),
            "paseo-mode": MODE_NOTE.format(mode=mode)}.get(boundary, "")
    budget = BUDGET_TEXT.format(minutes=f"{a.timeout / 60:g}") if a.timeout else ""
    advisor = ("\n" + ADVISOR_NOTE.strip() + "\n") if a.role == "advise" else ""
    brief_text = prompt.rstrip() + "\n" + advisor + "\n" + footer.rstrip() + "\n" + note + budget
    pointer = (f"You are the acp-dispatch slice {a.name} (kind {a.kind}, lead {a.lead}). Your whole task is in the "
               f"brief file {brief}: read all of it before doing anything and follow it. Deliver by writing the report "
               f"to {report} and then touching {done}, as the delivery contract below (also at the end of the brief) "
               f"says; your final message is only `written: {report}`.\n\n{footer.rstrip()}\n{note}")
    argv = launch_argv(a, boundary, mode, brief, report, pointer, REPORT_SCHEMA)
    bad = identity_refusal(a.agent, argv, a.model)
    if bad:
        die(bad)
    wait_timeout = a.wait_timeout if a.wait_timeout is not None else (a.timeout + WAIT_GRACE if a.timeout else 0)
    rec = {"name": a.name, "agent": a.agent, "provider": provider, "model": a.model, "mode": mode, "boundary": boundary,
           "perm": a.perm, "kind": a.kind, "role": a.role, "service": service, "dir": a.dir, "task": a.task,
           "out": str(out), "brief": str(brief), "report": str(report), "done": str(done), "record": str(record),
           "stderr": str(stderr), "lead": a.lead, "effort": a.effort, "timeout": a.timeout, "wait_timeout": wait_timeout,
           "detached": bool(a.detach), "argv": argv, "cmd": shlex.join(argv), "prompt": prompt,
           "owner": owner_session_id(), "started": time.time(), "status": "running", "paseo_agent_id": None,
           "pid": None, "exit": None, "finished": None, "go_advisory": bool(getattr(a, "go_advisory", False)),
           "frontier_reason": frontier_reason, "frontier_judged": judged, "frontier_judged_note": judged_note,
           "estimated_usage_pct": estimate, "estimated_usage_windows": per_window, "estimate_source": source,
           "snapshot_remaining_before": remaining, "snapshot_reading": reading, "load_gate": gate_info,
           "min_headroom": a.min_headroom}
    if a.dry_run:
        rec.update(status="dry-run", reserved_usage_pct=reserved, inflight=[p.stem for p in busy],
                   **({"would_refuse_class": refusal[0]} if refusal else {}))
        print(json.dumps(rec, indent=1, sort_keys=True) if a.json else
              f"dry-run\t{a.name}\t{report}\nbrief: {brief}\ncmd: {rec['cmd']}"
              + (f"\nwould refuse: class={refusal[0]} {refusal[1]}" if refusal else ""))
        return 0
    (out / "jobs").mkdir(parents=True, exist_ok=True)
    write_atomic(brief, brief_text)
    for p in (done, report, stderr):
        p.unlink(missing_ok=True)
    write_record(record, rec)
    if boundary == "review-launch":
        if a.detach and a.no_wait:
            with stderr.open("a") as err:
                child = subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "_review-run", str(record)],
                                         stdin=subprocess.DEVNULL, stdout=err, stderr=err, start_new_session=True)
            update_record(record, pid=child.pid)
            _RESERVATION.clear()          # the child owns the reservation now (it reads it from the record)
            print(f"detached\t{a.name}\t{report}\nrecord: {record}\nwait: acp-dispatch wait {shlex.quote(str(record))}")
            return 0
        return finish_print(record, run_review(record), a.json)
    code = launch_paseo(record, a)
    if code is not None:
        return code
    rec = read_record(record)
    if a.detach and a.no_wait:
        print(f"detached\t{a.name}\t{report}\nrecord: {record}\nagent: {rec['paseo_agent_id']}\n"
              f"wait: acp-dispatch wait {shlex.quote(str(record))}")
        return 0
    return finish_print(record, wait_paseo(record, wait_timeout), a.json)


def owner_session_id() -> str:
    try:
        import claude_identity
        return claude_identity.owner_session_id()
    except ImportError:
        return os.environ.get("CLAUDE_CODE_SESSION_ID", "")


def refuse_launch(record: Path, detail: str, code: int, cls: str) -> int:
    release_reservation()
    update_record(record, status="unavailable" if code == LOAD_GATE_EXIT else "refused", unavailable_class=cls,
                  detail=detail, finished=time.time(), exit=code)
    print(f"{'unavailable' if code == LOAD_GATE_EXIT else 'refused'}\t{record.stem}\t{detail}")
    return code


def gate_on(a: argparse.Namespace) -> bool:
    return not a.no_load_gate and os.environ.get("ACP_DISPATCH_NO_LOAD_GATE") != "1"


def load_wait(a: argparse.Namespace) -> int:
    if a.load_wait is not None:
        return max(0, a.load_wait)
    try:
        return max(0, int(os.environ.get("ACP_DISPATCH_LOAD_WAIT") or LOAD_WAIT_DEFAULT))
    except ValueError:
        return LOAD_WAIT_DEFAULT


def launch_paseo(record: Path, a: argparse.Namespace) -> int | None:
    """The agent cap, then under the launch lock `paseo run`, (paseo-mode) the mode check, and the wait until the new
    agent is countable. The lock is not held while waiting for room. None = launched, else the exit code."""
    rec, cap = read_record(record), agent_cap()
    deadline = time.monotonic() + (load_wait(a) if gate_on(a) else 0)
    while True:
        with launch_lock():
            n, _, _, why = count_agents() if cap else (0, None, set(), "")
            if n is None:
                return refuse_launch(record, f"{LOAD_RETRY_TEXT}: the live agent count is unreadable ({why}) "
                                             "refused=agents_unreadable", LOAD_GATE_EXIT, "load")
            if not cap or n < cap:
                code = launch_locked(record, rec)
                release_reservation()
                return code
        if time.monotonic() >= deadline:
            return refuse_launch(record, f"{LOAD_RETRY_TEXT}: {n} acp-dispatch Paseo agents live (cap {cap}) "
                                         "refused=agents", LOAD_GATE_EXIT, "load")
        time.sleep(min(CAP_POLL_S, max(0.1, deadline - time.monotonic())))


def launch_locked(record: Path, rec: dict) -> int | None:
    argv = list(rec["argv"])
    real_prompt = argv[-1]
    if rec["boundary"] == "paseo-mode":
        argv[-1] = "Reply with exactly: ready. Do nothing else."      # no work before the mode is verified
    data, why = paseo_json(argv[1:], timeout=120)
    aid = data.get("agentId") if isinstance(data, dict) else None
    if not aid:
        return refuse_launch(record, f"paseo run did not create an agent: {why or data}", 2, "launch")
    update_record(record, paseo_agent_id=str(aid), run_status=data.get("status"))
    if rec["boundary"] == "paseo-mode":
        why = verify_mode(str(aid), rec["mode"])
        if not why:
            sent, swhy = paseo_json(["send", str(aid), "--no-wait", f"--prompt={real_prompt}"])
            why = None if isinstance(sent, dict) and sent.get("status") in ("sent", "queued", "completed") \
                else f"the brief was not sent ({swhy or sent})"
        if why:
            subprocess.run([paseo_bin(), "stop", str(aid)], capture_output=True, check=False, timeout=60)
            return refuse_launch(record, f"--perm read-only refused: {why}; agent {aid} stopped", 2, "mode")
    end = time.monotonic() + COUNTABLE_S
    while time.monotonic() < end and str(aid) not in count_agents()[2]:
        time.sleep(0.5)
    return None


def verify_mode(aid: str, mode: str) -> str | None:
    """Why `mode` is not the verified active mode of agent `aid` (listed by `paseo agent mode --list`, active per
    `paseo inspect`), else None. The no-op first prompt is waited out first so the brief is sent to an idle agent."""
    paseo_json(["wait", aid, "--timeout", "60"], timeout=120)
    listed, why = paseo_json(["agent", "mode", aid, "--list"])
    if not isinstance(listed, list):
        return f"the mode list is unreadable ({why})"
    ids = [str(m.get("id")) for m in listed if isinstance(m, dict)]
    if mode not in ids:
        return f"mode {mode!r} is not listed for this agent (listed: {', '.join(ids) or 'none'})"
    info, why = paseo_json(["inspect", aid])
    active = info.get("Mode") if isinstance(info, dict) else None
    return None if active == mode else f"the active mode is {active!r}, not {mode!r} ({why})" if why or active else \
        f"the active mode is unreadable, not {mode!r}"


def finalize(record: Path, st_hint: str | None = None, note: str | None = None, rc: int | None = None) -> tuple[str, str]:
    """Classify the finished slice, append a NO-REPORT line when it ended without one, measure, write, touch .done."""
    with record_lock(record):
        rec = read_record(record)
        report, done = Path(rec["report"]), Path(rec["done"])
        st, det = classify(report, done, finished=True)
        if (st == "no-report" or (st == "partial" and st_hint)) and note and not det.startswith(NO_REPORT_PREFIX):
            old = report.read_text() if report.exists() else ""
            write_atomic(report, old + ("" if not old or old.endswith("\n") else "\n") + note + "\n")
            st, det = classify(report, done, finished=True)
        if st_hint and st != "done":
            st, det = st_hint, note or det
        try:
            after, after_reading = pool_reading(rec.get("agent", ""), rec.get("model"))
            before = rec.get("snapshot_remaining_before")
            used = {k: round(float(v) - float(after_reading["windows"][k]), 2)
                    for k, v in ((rec.get("snapshot_reading") or {}).get("windows") or {}).items()
                    if v is not None and ((after_reading or {}).get("windows") or {}).get(k) is not None
                    and float(v) >= float(after_reading["windows"][k])}
            if used:
                rec["measured_usage_windows"] = used
                rec["measured_usage_pct"] = max(used.values())
            elif before is not None and after is not None and float(before) >= float(after):
                rec["measured_usage_pct"] = round(float(before) - float(after), 2)
        except (ValueError, TypeError, KeyError):
            pass
        rec.update(status=st, detail=det, finished=time.time(), exit=rc if rc is not None else STATUS_EXIT.get(st, 1),
                   report_source=rec.get("report_source") or ("agent" if st != "no-report" else None))
        write_record(record, rec)
        done.touch()
        return st, det


def wait_paseo(record: Path, timeout: int | None) -> tuple[str, str]:
    rec = read_record(record)
    aid = rec.get("paseo_agent_id")
    if not aid:
        return "no-report", "the record has no paseo agent id"
    data, why = paseo_json(["wait", str(aid), *(["--timeout", str(timeout)] if timeout else [])],
                           timeout=(timeout + 120) if timeout else None)
    status = data.get("status") if isinstance(data, dict) else None
    if status == "idle":
        extra = (f" (a read-only provider mode writes no file: read its reply with `paseo logs {aid}`)"
                 if rec.get("boundary") == "paseo-mode" else "")
        return finalize(record, note=f"{NO_REPORT_PREFIX} idle without a report ({rec['agent']}, {rec['model']}){extra}")
    if status == "timeout":
        det = f"timed out waiting after {timeout}s; paseo agent {aid} may still run (`paseo wait {aid}`, `paseo stop {aid}`)"
        update_record(record, last_wait={"status": "timeout", "at": time.time()})
        return "timeout", det
    if status == "permission":
        info, _ = paseo_json(["inspect", str(aid)])
        names = [str(p.get("tool")) for p in (info or {}).get("PendingPermissions") or [] if isinstance(p, dict)] \
            if isinstance(info, dict) else []
        det = f"BLOCKED: paseo agent {aid} waits for permission: {', '.join(names) or data.get('message')} (`paseo permit ls`)"
        update_record(record, status="permission", detail=det, pending_permissions=names)
        return "permission", det
    if status == "error":
        return finalize(record, "no-report", f"{NO_REPORT_PREFIX} error ({rec['agent']}, {rec['model']}): "
                                             f"{str(data.get('message'))[:300]}")
    return "running", f"the wait gave no status ({why or data}); the slice is unfinished: `acp-dispatch wait {record}`"


def run_review(record: Path) -> tuple[str, str]:
    """Run the record's review-launch argv to its end and finalize: 0 -> the structured `report` is the report."""
    rec = read_record(record)
    gate = rec.get("load_gate") if isinstance(rec.get("load_gate"), dict) else {}
    rid, lw_path = _RESERVATION.get("id") or gate.get("reservation"), _RESERVATION.get("path") or load_watch_bin()
    stop = threading.Event()
    renew_while(stop, rid, lw_path)
    try:
        r = subprocess.run(rec["argv"], capture_output=True, text=True, check=False, cwd=rec["dir"])
        rc, out, err = r.returncode, r.stdout, r.stderr
    except OSError as e:
        rc, out, err = 2, "", f"cannot run review-launch: {e}"
    finally:
        stop.set()
        if rid and lw_path:
            lw_call("release", rid, lw_path)
        _RESERVATION.clear()
    Path(rec["stderr"]).write_text(err)
    tail = (err.strip().splitlines() or [""])[-1][:300]
    if rc == 0:
        try:
            text = json.loads(out)["report"]
            if not isinstance(text, str):
                raise TypeError("report is not a string")
            write_atomic(Path(rec["report"]), text.rstrip() + "\n")
            update_record(record, report_source="review-launch")
            return finalize(record, rc=None)
        except (ValueError, KeyError, TypeError) as e:
            return finalize(record, "no-report", f"{NO_REPORT_PREFIX} review-launch output unreadable ({e})", 3)
    st = {TRIPWIRE_EXIT: "tripwire", 2: "refused", TIMEOUT_EXIT: "timeout"}.get(rc, "no-report")
    return finalize(record, st, f"{NO_REPORT_PREFIX} review-launch exit {rc} ({st}): {tail}", STATUS_EXIT.get(st, 3))


def finish_print(record: Path, result: tuple[str, str], as_json: bool) -> int:
    st, det = result
    rec = read_record(record)
    if as_json:
        print(json.dumps({**rec, "detail": det}, indent=1, sort_keys=True))
    else:
        print(f"{st}\t{rec.get('name')}\t{rec.get('report')}\t{det}")
    return STATUS_EXIT.get(st, 1)


def wait_record(path: Path, timeout: int | None) -> int:
    try:
        rec = read_record(path)
    except (OSError, ValueError) as e:
        die(f"unreadable record {path}: {e}")
    if rec.get("finished"):
        return check_items([str(path)])
    t = rec.get("wait_timeout") if timeout is None else timeout
    if rec.get("boundary") == "review-launch":
        end = time.monotonic() + t if t else None
        while not read_record(path).get("finished"):
            if not pid_alive(read_record(path).get("pid")):
                return finish_print(path, finalize(path, "no-report", f"{NO_REPORT_PREFIX} lost: the review-launch "
                                                                     "runner is gone"), False)
            if end and time.monotonic() > end:
                return finish_print(path, ("timeout", f"timed out waiting after {t}s"), False)
            time.sleep(2)
        return check_items([str(path)])
    return finish_print(path, wait_paseo(path, int(t) if t else None), False)


# ---------------------------------------------------------------- tell, outcome

def tell_record(a: argparse.Namespace) -> int:
    target = Path(a.record).expanduser().resolve()
    message = sys.stdin.read() if a.message == "-" else a.message
    if not message.strip():
        die("give a message (or - to read one from stdin)")
    if message.lstrip().startswith(("/", "／")):
        die("a message may not start with `/`: it would run a slash command in the target")
    rec = None
    if target.suffix == ".json":
        try:
            rec = read_record(target)
        except (OSError, ValueError) as e:
            die(f"unreadable record {target}: {e}")
        if rec.get("finished") or Path(rec.get("done") or "/nonexistent").exists():
            die(f"slice {rec.get('name', target.stem)} is finished; the message would never be read: re-dispatch")
        if rec.get("boundary") == "review-launch":
            die("a review-launch run has no live channel and cannot read files outside its worktree")
        inbox, replies = target.with_suffix(".inbox.md"), target.with_suffix(".replies.md")
    else:
        inbox, replies = target.with_name(target.name + ".inbox.md"), target.with_name(target.name + ".replies.md")
    with record_lock(inbox):
        prior = inbox.read_text() if inbox.exists() else ""
        n = len(re.findall(r"^## MSG \d+", prior, re.M)) + 1
        write_atomic(inbox, prior + f"## MSG {n} from {a.sender} at {datetime.now().isoformat(timespec='seconds')}\n\n"
                     f"{message.strip()}\n\n")
    aid = (rec or {}).get("paseo_agent_id")
    if not aid:
        print("delivered: inbox")
        return 0
    info, why = paseo_json(["inspect", str(aid)])
    if not isinstance(info, dict) or info.get("PendingPermissions") != []:
        print(f"inbox only: not sent to paseo agent {aid} "
              f"({why or 'it waits on a permission card a send would answer'})")
        return 2
    live = (f"MSG {n} from {a.sender} (also in {inbox}; answer it with `REPLY {n}: <one line>` appended to "
            f"{replies}):\n{message.strip()}")
    sent, why = paseo_json(["send", str(aid), "--no-wait", f"--prompt={live}"])
    status = sent.get("status") if isinstance(sent, dict) else None
    if status in ("sent", "completed"):
        print(f"delivered: inbox + paseo send ({status})")
        return 0
    if status == "queued":
        print("accepted: inbox + paseo send queued (not proof of delivery: ask for an ack)")
        return UNAVAILABLE_EXIT
    print(f"inbox only: paseo send gave {status or why}")
    return 2


def outcome_record(a: argparse.Namespace) -> int:
    """`outcome.ci`, `outcome.review`, `outcome.merged`: what `route_agent.py calibrate` reads; flags merge."""
    path = Path(a.record).expanduser().resolve()
    fields = {k: v for k, v in (("ci", a.ci), ("review", a.review), ("merged", a.merged)) if v is not None}
    if not fields:
        die("give at least one of --ci, --review, --merged/--not-merged")
    try:
        with record_lock(path):
            rec = read_record(path)
            if not rec.get("finished"):
                die(f"slice {rec.get('name', path.stem)} has not finished; record its outcome once the work it "
                    "delivered has been checked")
            out = rec["outcome"] = {**(rec.get("outcome") or {}), **fields, "at": time.time()}
            write_record(path, rec)
    except (OSError, ValueError) as e:
        die(f"unreadable record {path}: {e}")
    print(f"outcome\t{rec.get('name', path.stem)}\t" +
          ", ".join(f"{k}={str(out[k]).lower()}" for k in ("ci", "review", "merged") if k in out))
    return 0


# ---------------------------------------------------------------- main

def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    verb = argv[0] if argv else ""
    if verb in RETIRED:
        die(f"`acp-dispatch {verb}` was retired with the Paseo shim (slim-down E6): {RETIRED[verb]}")
    if verb in ("footer", "check", "wait", "tell", "outcome", "_review-run"):
        sub = argparse.ArgumentParser(prog=f"acp-dispatch {verb}")
        if verb == "footer":
            sub.add_argument("--report", required=True)
            sub.add_argument("--lead", default=DEFAULT_LEAD)
            s = sub.parse_args(argv[1:])
            report = Path(s.report).expanduser()
            if not report.is_absolute():
                die("--report must be an absolute path (the sub-agent has no idea what your cwd is)")
            check_report_name(report)
            sys.stdout.write(footer_text(report, s.lead))
            return 0
        if verb == "check":
            sub.add_argument("items", nargs="+", metavar="PATH")
            return check_items(sub.parse_args(argv[1:]).items)
        sub.add_argument("record")
        if verb == "wait":
            sub.add_argument("--timeout", type=int, help="seconds (default the record's wait_timeout; 0 none)")
        elif verb == "tell":
            sub.add_argument("message", help="the message (- reads stdin)")
            sub.add_argument("--from", dest="sender", default="lead", metavar="NAME")
        elif verb == "outcome":
            sub.add_argument("--ci", choices=("pass", "fail"))
            sub.add_argument("--review", choices=("pass", "fail"))
            merged = sub.add_mutually_exclusive_group()
            merged.add_argument("--merged", action="store_const", const=True, default=None)
            merged.add_argument("--not-merged", dest="merged", action="store_const", const=False)
        s = sub.parse_args(argv[1:])
        if verb == "wait":
            return wait_record(Path(s.record).expanduser(), s.timeout)
        if verb == "tell":
            return tell_record(s)
        if verb == "outcome":
            return outcome_record(s)
        return STATUS_EXIT.get(run_review(Path(s.record))[0], 1)       # _review-run: the detached review child
    ap = argparse.ArgumentParser(prog="acp-dispatch", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("agent", help=f"a Paseo provider: {', '.join(PROVIDERS)}")
    ap.add_argument("--model", help="required; becomes --provider P/M")
    ap.add_argument("--kind", required=True, help="a route_agent kind (route_agent.py plan --kinds KIND)")
    ap.add_argument("--role", choices=("advise", "exec"), help="frontier only; default advise")
    ap.add_argument("--frontier-reason", metavar="TEXT", help="--kind frontier: claims the frontier allowance")
    ap.add_argument("--name", required=True, help="slice name; names every output file")
    ap.add_argument("-p", "--prompt")
    ap.add_argument("-f", "--prompt-file", help="the brief (a file); a copy with the footer goes to the out dir")
    ap.add_argument("-C", "--dir", default=".", help="the directory the agent works in (default: cwd)")
    where = ap.add_mutually_exclusive_group()
    where.add_argument("--task", help="out dir is ~/.local/state/bigteam/<task>/ (default adhoc-<date>)")
    where.add_argument("--out", help="explicit out dir instead of --task")
    ap.add_argument("--effort", metavar="LEVEL", help="paseo run --thinking LEVEL (not passed to review-launch)")
    ap.add_argument("--perm", choices=("all", "read-only", "deny"), default="all")
    ap.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT, help="the slice's budget in seconds (0 none)")
    ap.add_argument("--lead", default=DEFAULT_LEAD, help="SendMessage address in the footer; label ade.lead")
    ap.add_argument("--detach", action="store_true", help="with --no-wait: return once the agent is launched")
    ap.add_argument("--no-wait", action="store_true")
    ap.add_argument("--wait-timeout", type=int, help="seconds the dispatch or wait waits (default --timeout + 300)")
    ap.add_argument("--force", action="store_true", help="redo a slice whose .done or live record exists")
    ap.add_argument("--dry-run", action="store_true", help="print the launch command and paths, write nothing")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--load-wait", type=int, metavar="SECONDS")
    ap.add_argument("--no-load-gate", action="store_true")
    ap.add_argument("--min-headroom", type=float, default=10.0)
    ap.add_argument("--est-pct", type=float, help="estimated percent of the binding quota window this slice uses")
    a = ap.parse_args(argv)
    kinds = route_module().KINDS
    if a.kind not in kinds:
        die(f"--kind must be one of: {', '.join(kinds)}")
    return dispatch(a)


if __name__ == "__main__":
    sys.exit(main())

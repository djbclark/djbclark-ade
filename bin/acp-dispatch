# skips the schedule and `check` points at a reroute. [dispatch].auto_resume_max_wait_hours,
# read at call time so the cheap subcommands stay import-free; ACP_DISPATCH_MAX_WAIT_HOURS
# overrides (tests reuse fixtures whose resets are years out).
def auto_resume_max_wait_hours() -> float:
    return float(os.environ.get("ACP_DISPATCH_MAX_WAIT_HOURS")
                 or (load_policy().POLICY["dispatch"].get("auto_resume_max_wait_hours") or 6))



# A resume is never refused by the reservation or this cap: it continues paid work.
INFLIGHT_CAP: dict[str, int] = {}
FRONTIER_MODELS: list[str] = []
ESTIMATE_FLOOR: dict[str, float] = {}
INFLIGHT_SPAWN_GRACE = 10 * 60           # a running record whose pid is not written yet counts this long
_routing_module = None


def load_policy():
    """Import route_agent once, on first routing use, and fill the [dispatch]-derived constants
    above in place (mutated, not rebound, so their consumers read them as plain globals). Module
    import stays free of it so the cheap subcommands — reap, wait, check, footer, extend,
    finalize — never pay for the routing module and its config parse (2026-10-18)."""
    global _routing_module
    if _routing_module is None:
        bindir = str(Path(__file__).resolve().parent)
        if bindir not in sys.path:
            sys.path.insert(0, bindir)
        import route_agent
        _routing_module = route_agent
    d = _routing_module.POLICY["dispatch"]
    OPERATOR_GATED.clear()
    OPERATOR_GATED.update(d["operator_gated"])
    FABLE_GATED_EFFORTS.clear()
    FABLE_GATED_EFFORTS.update(d["fable_gated_efforts"])
    INFLIGHT_CAP.clear()
    INFLIGHT_CAP.update({k: int(v) for k, v in (d.get("inflight_cap") or {}).items()})
    FRONTIER_MODELS[:] = [str(x).lower() for x in (d.get("frontier_models") or [])]
    ESTIMATE_FLOOR.clear()
    ESTIMATE_FLOOR.update({str(k): float(v) for k, v in (d.get("estimate_floor") or {}).items()})
    return _routing_module


class _RoutingPolicy:
    """route_agent behind first attribute use (a module's own globals do not get PEP 562
    __getattr__), so `_routing_policy.KINDS` in the parsers imports nothing until a
    dispatch-shaped invocation needs the choices."""

    def __getattr__(self, name: str):
        return getattr(load_policy(), name)


_routing_policy = _RoutingPolicy()


# A quota reset further out than this is not waited for (operator 2026-10-18, 6.5a): agy's
# weekly cap resets ~148 h out and resume_unsupported() already says that session may not even

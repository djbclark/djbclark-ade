#!/usr/bin/env bash
# Make a shared skill visible to every agent TUI on this machine by
# symlinking it into each TUI's user-level skills dir.
#     skill-everywhere --all                sync every public/private/site/chrome-use shared skill
#     skill-everywhere --check --all        verify every installed target; exit 1 for gaps; one warning per absent root
#     skill-everywhere <name>...            link (idempotent, collapses chains)
#     skill-everywhere --check <name>...    report per-TUI status, change nothing; ends with a "== end" line
#     skill-everywhere --remove <name>...   remove links this script would make
#     --dry-run (-n) with link or --remove: print the changes, make none
#     SKILL_EVERYWHERE_ONLY=grokbot,claude limits the run to those targets
#     After a new skill is linked, run `/reload-skills` in running Claude sessions (per-skill symlinks are the
#     documented mechanism; a directory-level symlink is not, so none is used).
#     SKILL_EVERYWHERE_NO_COPY=1 skips the copy target (grokbot): ade-update sets it for a non-canonical checkout, which
#     is a report-only run, so such a run neither lists nor renders the Grok Bot copy
#     The grokbot copy refuses a skill holding a symlink that is not a link to a regular file inside the skill (one that
#     leaves the skill, dangles, or names a directory or special file): --check reports "unsafe source symlink"; link
#     mode copies nothing, leaves any existing copy alone and exits 1
# Content lives in exactly one place (2026-10-14 chain collapse):
#   public skills: ~/src/djbclark-ade/skills/<name> when that checkout exists; otherwise skills/
#     of the repo this script's real path sits in (SKILL_EVERYWHERE_ADE overrides; #279 / revived #292)
#   ~/ops/site-private/skills/<name>            private skills (e.g. 1password)
#   ~/ops/site-public-djbclark/skills/<name>    site skills (site-djbclark repo; moved out of this repo 2026-11-06)
#   ~/src/chrome-use/skill-data/<name>          chrome-use skills (third-party git repo; SKILL_EVERYWHERE_CHROME overrides)
# and every TUI links DIRECTLY at that path — no hub layers, no chained
# symlinks (the old TUI -> site-private/skills -> site-djbclark/skills ->
# djbclark-ade chain is retired; ops-repo churn can no longer break skill
# loading). Editing the skill in its git repo updates it everywhere; never
# copy (copies drift, e.g. ~/.agents/skills/self-handoff).
# A name found in more than one root resolves in that order: public, private, site, chrome-use.
# In link mode, any existing link whose realpath equals the target but whose
# readlink differs (a leftover chain) is atomically replaced with the direct
# link.
# A foreign real dir at the name of a chrome-use (third-party root) skill is a note, not an error (exit code
# unchanged); at the name of a public/private/site skill it stays exit 1. Paseo's own skill (~/.agents/skills/paseo,
# synced by its daemon) is linked into the Hermes dir, and --check exits 1 when paseo is missing from a live target
# (see paseo_step below and docs/skill-everywhere.md, section 1).
# Hermes owns ~/.hermes/, so it is never edited here. Instead Hermes itself put
# ~/.local/share/skill-everywhere/skills in its skills.external_dirs (done
# 2026-10-03), and this script links into that dir.
# A TUI that is not installed (no binary via PATH/SKILL_EVERYWHERE_BIN_DIR; for
# gemini, also ~/.gemini dir) is skipped. Being linked is not the same
# as being loaded: re-verify with the per-TUI check in skill-everywhere.md
# (the README next to this script).
# This script makes no model calls.
export PATH="/opt/homebrew/bin:$PATH"
set -euo pipefail
# GNU tools carry a g prefix on the Mac (Homebrew). On GNU/Linux, e.g. the
# Grok Bot box (2026-10-23), the plain names are already GNU: alias them.
for t in sed readlink realpath grep head awk; do
  command -v "g$t" >/dev/null || eval "g$t() { $t \"\$@\"; }"
done
# Default public-skills dir: the repo this script lives in, found from its own real path
# (it is installed as a symlink; plain `readlink` loop + `cd -P` works on bash 3.2/BSD).
# Falls back to ~/src/djbclark-ade/skills when the script is not inside a checkout.
self_root() {
  local src=${BASH_SOURCE[0]} dir link
  while [[ -L $src ]]; do
    dir=$(cd -P "$(dirname "$src")" && pwd) || return 1
    link=$(readlink "$src") || return 1
    [[ $link == /* ]] && src=$link || src=$dir/$link
  done
  dir=$(cd -P "$(dirname "$src")/.." && pwd) || return 1
  # A linked worktree (order 9: every change is made in one) is removed after its merge, so links into it
  # would dangle: use the primary checkout that owns it, when that is a checkout of this repo too.
  local common
  common=$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || common=
  if [[ $common == */.git && ${common%/.git} != "$dir" && -f ${common%/.git}/bin/skill-everywhere ]]; then
    dir=${common%/.git}
  fi
  [[ -f $dir/bin/skill-everywhere && -d $dir/skills ]] && printf '%s' "$dir"
}
if [[ -z ${SKILL_EVERYWHERE_ADE:-} ]]; then
  # The canonical checkout wins when it exists (the Mac's behaviour is unchanged, and a run from a
  # second clone neither reports false gaps nor links into a copy that is later removed); the script's
  # own checkout is the default only on a host whose canonical checkout lives elsewhere (#279, revived
  # from closed PR 292).
  if [[ -f $HOME/src/djbclark-ade/bin/skill-everywhere && -d $HOME/src/djbclark-ade/skills ]]; then
    SKILL_EVERYWHERE_ADE=$HOME/src/djbclark-ade/skills
  elif repo_root=$(self_root 2>/dev/null); then SKILL_EVERYWHERE_ADE=$repo_root/skills
  else SKILL_EVERYWHERE_ADE=$HOME/src/djbclark-ade/skills; fi
fi
ade_root=$SKILL_EVERYWHERE_ADE
priv_root="${SKILL_EVERYWHERE_PRIVATE:-${OPS_ROOT:-$HOME/ops}/site-private/skills}"
site_root="${SKILL_EVERYWHERE_SITE:-${OPS_ROOT:-$HOME/ops}/site-public-djbclark/skills}"
chrome_root="${SKILL_EVERYWHERE_CHROME:-$HOME/src/chrome-use/skill-data}"

# binary|skills dir to link into, or "via <dir>" when the TUI already reads a
# dir we fill (a second link there would list the skill twice), or "x <why>",
# or "copy <dir>" for a target that needs a rendered copy (see copy_target).
# Verified 2026-10-03 by asking each TUI headlessly whether it saw 'steps'.
# Pi restored 2026-11-09 (sole 3rd-party TUI policy): it natively scans
# ~/.agents/skills (same shared dir as Codex). A second link under
# ~/.pi/agent/skills causes name collisions — do not add one.
# omp / opencode dropped 2026-11-09 (retired clients; Pi-only + retained
# vendor clients + Hermes). Operator may remove leftover ~/.omp and
# ~/.config/opencode skill links by hand.
# (goose, agy, copilot, qwen, devin, cline, muse and zcode rows removed 2026-11-06, slim-down E9.)
# gemini (~/.gemini/skills) added 2026-11-24: Antigravity under Paseo/macOS and Gemini CLI read
# ~/.gemini/skills even when no gemini/antigravity binary is on PATH (see target_installed below).
targets='
claude|~/.claude/skills
codex|~/.agents/skills
pi|~/.agents/skills
hermes|~/.local/share/skill-everywhere/skills
gemini|~/.gemini/skills
cursor-agent|via ~/.claude/skills
grokbot|copy ~/agent-data/workflows
'

mode=link dry=0 all=0
while [[ ${1:-} == -* ]]; do
  case $1 in
    --check) mode=check ;; --remove) mode=remove ;; --dry-run|-n) dry=1 ;; --all) all=1 ;;
    *) echo "error: unknown option $1" >&2; exit 2 ;;
  esac
  shift
done
if ((all)); then
  [[ $# == 0 && $mode != remove ]] || { echo 'error: --all accepts no names and cannot be used with --remove' >&2; exit 2; }
  names=()
  for root in "$ade_root" "$priv_root" "$site_root" "$chrome_root"; do
    if [[ ! -d $root ]]; then
      # An absent root is skipped, but a check says so: its skills would otherwise vanish from the report unseen.
      [[ $mode != check ]] || echo "warning: skill root $root does not exist; its skills are not checked" >&2
      continue
    fi
    for skill_file in "$root"/*/SKILL.md; do
      [[ -f $skill_file && -r $skill_file ]] || continue
      name=${skill_file%/SKILL.md}; name=${name##*/}
      [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || { echo "error: unsafe skill directory name: $name" >&2; exit 2; }
      # Public wins on a duplicate name, just as with explicit names. Collect
      # before any mutation; hidden directories and helper-only dirs aren't skills.
      [[ " ${names[*]:-} " == *" $name "* ]] || names+=("$name")
    done
  done
  ((${#names[@]})) || { echo "error: no readable shared SKILL.md files under $ade_root, $priv_root, $site_root or $chrome_root" >&2; exit 2; }
  set -- "${names[@]}"
fi
[[ $# -gt 0 ]] || { gsed -n '2,17p' "$0" >&2; exit 2; }
only="${SKILL_EVERYWHERE_ONLY:-}"
no_copy=0; [[ -z ${SKILL_EVERYWHERE_NO_COPY:-} ]] || no_copy=1
wanted() { [[ -z $only || ",$only," == *",$1,"* ]]; }
# Client binary lookup. Tests set SKILL_EVERYWHERE_BIN_DIR to an isolated dir of stub binaries
# instead of rewriting PATH (docs/code-review.md rule 2: never strip/reorder PATH in tests).
# When SKILL_EVERYWHERE_BIN_DIR is set (even empty), it is authoritative and never falls back to PATH.
resolve_cli() {
  if [[ -n ${SKILL_EVERYWHERE_BIN_DIR+x} ]]; then
    [[ -n $SKILL_EVERYWHERE_BIN_DIR && -f $SKILL_EVERYWHERE_BIN_DIR/$1 && -x $SKILL_EVERYWHERE_BIN_DIR/$1 ]] || return 1
    printf '%s\n' "$SKILL_EVERYWHERE_BIN_DIR/$1"
    return 0
  fi
  command -v "$1"
}
has_cli() { resolve_cli "$1" >/dev/null 2>&1; }
# Target availability for link/via targets. Most TUIs are detected by their CLI binary.
# gemini (Antigravity under Paseo/macOS and Gemini CLI) reads ~/.gemini/skills even when
# no gemini or antigravity binary is on PATH, so an existing $HOME/.gemini directory also
# marks it installed while SKILL_EVERYWHERE_BIN_DIR still governs binary probes.
target_installed() {
  case $1 in
    gemini) [[ -d $HOME/.gemini ]] || has_cli gemini || has_cli antigravity ;;
    *) has_cli "$1" ;;
  esac
}
# would <msg> | <cmd...>: print in dry-run mode, else run the command.
act() { local msg=$1; shift; if ((dry)); then printf '  %-13s would %s\n' "$bin" "$msg"; else "$@"; fi; }

# Grok Bot (target added 2026-10-23) reads <dir>/<slug>/SKILL.md as plain
# files on its own Linux box, where no link into a Mac checkout can resolve.
# It gets a rendered COPY: slug ade-<name> (keeps clear of Grok Bot's own
# skills), symlinks dereferenced, a banner after the front matter, and a
# .skill-everywhere marker. Only a dir holding that marker is ours to update
# or remove. Every grokbot copy carries a standing 2026-11-11 banner note that Grok Bot
# does all AI work itself unless Chief of Staff says usage is over pace.
# SKILL_EVERYWHERE_GROKBOT_NOTE adds one more banner paragraph after that standing note.
# unsafe_links <srcdir>: one line per symlink under <srcdir> that is not a link to a regular file inside the
# skill's own source dir (realpath of <srcdir>): a link out of it, a dangling one, one to a directory (a loop like
# `x -> .` or a multiplied tree), or one to a special file. `cp -rL` would follow each of them (2026-10-23, Codex
# review of PR 20: a PR branch's absolute links filled a temp dir with the operator's home during `ade-update
# --check`). A skill dir that is itself a link (the canonical skills/ keeps some, into sibling repos) is judged
# by where it resolves, so only links INSIDE that tree count.
unsafe_links() {
  local root l t
  root=$(grealpath -- "$1" 2>/dev/null) || { printf '%s\n' "$1"; return; }
  while IFS= read -r -d '' l; do
    t=$(grealpath -e -- "$l" 2>/dev/null) || { printf '%s\n' "$l"; continue; }
    [[ $t == "$root"/* && -f $t ]] || printf '%s\n' "$l"
  done < <(find "$root" -type l -print0)
}
render_copy() {  # render_copy <src> <out>; refuses (rc 1, nothing copied) a source with an unsafe_links entry
  local bad
  bad=$(unsafe_links "$1")
  if [[ -n $bad ]]; then
    printf 'error: unsafe source symlink, not copying %s (a link must point at a regular file inside the skill): %s\n' \
      "$1" "${bad//$'\n'/ }" >&2
    return 1
  fi
  cp -rL "$1" "$2"
  rm -rf "$2/.git"; find "$2" -name __pycache__ -prune -exec rm -rf {} +
  # Provenance follows the root the skill came from (a public djbclark-ade copy renders exactly as before).
  local repo from_md
  case $1 in
    "$site_root"/*) repo=site-djbclark
      from_md="site-djbclark [\`skills/$name\`](https://github.com/djbclark/site-djbclark/tree/master/skills/$name)" ;;
    "$priv_root"/*) repo=site-private
      from_md="site-private \`skills/$name\` (a private repository)" ;;
    "$chrome_root"/*) repo=chrome-use
      from_md="chrome-use [\`skill-data/$name\`](https://github.com/leeguooooo/chrome-use/tree/main/skill-data/$name)" ;;
    *) repo=djbclark-ade
      from_md="[\`skills/$name\`](https://github.com/djbclark/djbclark-ade/tree/master/skills/$name)" ;;
  esac
  printf 'source=%s/skills/%s\nmanaged-by=bin/skill-everywhere (grokbot target)\n' "$repo" "$name" >"$2/.skill-everywhere"
  local standing_note='**On Grok Bot (Daniel, 2026-11-11):** do all AI work, coding included, in Grok Bot itself; ignore any routing here to agy/Gemini, Claude, OpenAI/Codex or acp-run TUIs unless Chief of Staff says Grok Bot usage is over pace.'
  BANNER="> **Managed copy, do not edit here.** Rendered by djbclark-ade \`bin/skill-everywhere\` from
> ${from_md}; the next sync
> overwrites local edits. Written for the agent TUIs on djbclark's Mac: \`~/src/<repo>\` is
> \`/home/box/src/<repo>\` here when cloned, and Mac-only tools (launchd, herdr, Orca, Keychain,
> \`hermes-ping\`) are absent. Grok Bot's own rules win: sending, posting, pushing or merging still
> needs the operator's explicit approval.
>
> ${standing_note}${SKILL_EVERYWHERE_GROKBOT_NOTE:+
>
> ${SKILL_EVERYWHERE_GROKBOT_NOTE}}" \
  gawk 'n < 2 && /^---[[:space:]]*$/ { n++; print; if (n == 2) print "\n" ENVIRON["BANNER"]; next } { print }' \
    "$2/SKILL.md" >"$2/SKILL.md.new" && mv "$2/SKILL.md.new" "$2/SKILL.md"
}
copy_target() {  # copy_target <dir>; uses $bin $name $src $mode $dry
  local dir=${1/#\~/$HOME} dest state tmp bad
  if [[ ! -d $dir ]]; then printf '  %-13s not installed (no %s)\n' "$bin" "$dir"; return; fi
  dest="$dir/ade-$name"
  if [[ ! -e $dest ]]; then state=missing
  elif [[ ! -f $dest/.skill-everywhere ]]; then state="real dir/file (not ours)"
  elif [[ ! -f $src/SKILL.md ]]; then state="copy of a removed skill"
  else state=render
  fi
  # Only a state that would render the source is judged by it (--remove never renders).
  if [[ $mode != remove && ($state == missing || $state == render) && -f $src/SKILL.md ]] \
     && bad=$(unsafe_links "$src") && [[ -n $bad ]]; then
    state="unsafe source symlink"
    printf 'warning: %s: %s is not copied, a symlink in it leaves the skill or is not a regular file: %s\n' \
      "$name" "$src" "${bad//$'\n'/ }" >&2
  elif [[ $state == render && $mode == remove ]]; then state=copied
  elif [[ $state == render ]]; then
    # Always rm the mktemp dir, including when render_copy fails under set -e (PR 20 LOW e).
    tmp=$(mktemp -d)
    if render_copy "$src" "$tmp/x"; then
      if diff -r "$tmp/x" "$dest" >/dev/null 2>&1; then state=copied; else state="stale copy"; fi
    else
      state="stale copy"
      printf 'warning: %s: render for %s failed; treating as stale copy\n' "$name" "$dest" >&2
    fi
    rm -rf "$tmp"
  fi
  case $mode in
    check) printf '  %-13s %s (%s)\n' "$bin" "$state" "$dest"
      if ((all)) && [[ $state != copied ]]; then rc=1; fi ;;
    remove)
      if [[ $state == missing || $state == real* ]]; then printf '  %-13s %s (left alone)\n' "$bin" "$state"
      else act "remove $dest" rm -rf "$dest"; ((dry)) || printf '  %-13s removed %s\n' "$bin" "$dest"; fi ;;
    link)
      if [[ $state == copied ]]; then printf '  %-13s already copied\n' "$bin"
      elif [[ $state == missing || $state == "stale copy" ]]; then
        # Render beside the target under a dot name, then swap it in. A function (not eval+&&) so set -e
        # sees render_copy's failure and the partial `.ade-*.new` is removed (PR 20 LOW e).
        _copy_swap() {
          local d=$1 n=$2 s=$3 dest=$4
          rm -rf "$d/.ade-$n.new"
          if ! render_copy "$s" "$d/.ade-$n.new"; then
            rm -rf "$d/.ade-$n.new"
            return 1
          fi
          rm -rf "$dest"
          mv "$d/.ade-$n.new" "$dest"
        }
        if act "copy to $dest ($state)" _copy_swap "$dir" "$name" "$src" "$dest"; then
          ((dry)) || printf '  %-13s copied (was %s)\n' "$bin" "$state"
        else
          printf '  %-13s copy failed; left alone\n' "$bin"
          rc=1
        fi
      else printf '  %-13s %s; left alone\n' "$bin" "$state"; rc=1; fi ;;
  esac
}

rc=0
paseo_named=0  # `--remove paseo` names the paseo step explicitly
# Skill links can be healthy while Codex's shared instructions point at a
# retired home-agents.md location. Report that separately in read-only checks.
codex_instructions="${CODEX_HOME:-$HOME/.codex}/AGENTS.md"
if [[ $mode == check ]] && wanted codex && [[ -L $codex_instructions && ! -e $codex_instructions ]]; then
  printf 'warning: codex global instructions dangling: %s -> %s\n' \
    "$codex_instructions" "$(greadlink "$codex_instructions")" >&2
  rc=1
fi
for name in "$@"; do
  gone_srcs=()
  if [[ -f $ade_root/$name/SKILL.md ]]; then src="$ade_root/$name"
  elif [[ -f $priv_root/$name/SKILL.md ]]; then src="$priv_root/$name"
  elif [[ -f $site_root/$name/SKILL.md ]]; then src="$site_root/$name"
  elif [[ -f $chrome_root/$name/SKILL.md ]]; then src="$chrome_root/$name"
  elif [[ $name == paseo ]]; then
    paseo_named=1
    continue  # not a skill of ours: `skill-everywhere paseo` is only the paseo_step below (ade-update's fix command)
  else
    if [[ $mode != remove ]]; then
      echo "error: no SKILL.md under $ade_root/$name, $priv_root/$name, $site_root/$name or $chrome_root/$name" >&2; rc=1; continue
    fi
    # --remove still works once the skill dir is gone: it only unlinks links
    # whose target is exactly <root>/<name> for one of the three roots, so
    # retiring a skill can run in either order. Without a source there is
    # nothing to compare realpaths against: each link is matched against the
    # three root paths (gone_srcs) below, the public one by default.
    src="$ade_root/$name"; gone_srcs=("$ade_root/$name" "$priv_root/$name" "$site_root/$name" "$chrome_root/$name")
  fi
  echo "== $name"
  while IFS='|' read -r bin dir; do
    [[ -z $bin ]] && continue
    wanted "$bin" || continue
    if [[ $dir == copy\ * ]]; then
      ((no_copy)) || copy_target "${dir#copy }"  # SKILL_EVERYWHERE_NO_COPY=1: link targets only
      continue
    fi
    if ! target_installed "$bin"; then printf '  %-13s not installed\n' "$bin"; continue; fi
    if [[ $dir == via* || $dir == x* ]]; then printf '  %-13s %s\n' "$bin" "${dir#x }"; continue; fi
    dir="${dir/#\~/$HOME}"; link="$dir/$name"
    if [[ -n ${gone_srcs[*]:-} && -L $link ]]; then  # --remove of a gone skill: whichever root this link names
      src="$ade_root/$name"
      for c in "${gone_srcs[@]}"; do [[ "$(greadlink "$link")" != "$c" ]] || src=$c; done
    fi
    # A skill from the third-party root (chrome-use) yields to a foreign real dir of the same name: some other tool
    # installed that copy (2026-11-21: `canvas` under ~/.agents/skills), it is left alone and that is a note, not
    # an error. A collision with a public, private or site name stays an error.
    third_party=0; [[ $src != "$chrome_root"/* ]] || third_party=1
    if [[ -L $link && "$(greadlink "$link")" == "$src" ]]; then state=linked
    elif [[ -L $link && -e $src && "$(grealpath "$link" 2>/dev/null)" == "$(grealpath "$src")" ]]; then
      state="chained via $(greadlink "$link")"
    elif [[ -L $link && ! -e $link ]]; then state="dangling -> $(greadlink "$link")"
    elif [[ -L $link ]]; then state="other link -> $(greadlink "$link")"
    elif [[ -e $link ]]; then state="real dir/file (not ours)"
    else state=missing; fi
    case $mode in
      check)
        if ((third_party)) && [[ $state == "real dir/file (not ours)" ]]; then
          printf '  %-13s %s\n' "$bin" "real dir/file (not ours; third-party skill, left alone)"
        else
          printf '  %-13s %s\n' "$bin" "$state"
          if ((all)) && [[ $state != linked ]]; then rc=1; fi
        fi ;;
      remove)
        if [[ $state == linked ]]; then act "remove $link" rm "$link"; ((dry)) || printf '  %-13s removed\n' "$bin"
        else printf '  %-13s %s (left alone)\n' "$bin" "$state"; fi ;;
      link)
        if [[ $state == missing ]]; then
          act "link $link" eval 'mkdir -p "$dir" && ln -s "$src" "$link"'; ((dry)) || printf '  %-13s linked\n' "$bin"
        elif [[ $state == linked ]]; then printf '  %-13s already linked\n' "$bin"
        elif [[ $state == chained\ * ]]; then
          # ln -sfn (not ln+mv): macOS mv follows a symlink-to-dir
          # destination and moves the temp link INSIDE the target dir
          # instead of replacing the link.
          act "relink $link direct" ln -sfn "$src" "$link"
          ((dry)) || printf '  %-13s relinked direct (was %s)\n' "$bin" "$state"
        elif [[ $state == dangling\ * ]]; then
          # Nobody owns a link whose target is gone (2026-10-15: 36 links in
          # a TUI's skills dir still pointed at the pre-2026-10-09 site-private
          # path); replace it rather than preserve a dead pointer.
          act "relink $link" ln -sfn "$src" "$link"
          ((dry)) || printf '  %-13s relinked (was %s)\n' "$bin" "$state"
        elif ((third_party)) && [[ $state == "real dir/file (not ours)" ]]; then
          printf '  %-13s %s; left alone (third-party skill: a note, not an error)\n' "$bin" "$state"
        else printf '  %-13s %s; left alone\n' "$bin" "$state"; rc=1; fi ;;
    esac
  done <<<"$targets"
done

# Paseo's own skill. The Paseo daemon syncs ~/.agents/skills/paseo (and ~/.claude/skills/paseo, plus
# ~/.gemini/config/skills/paseo for Antigravity — not ~/.gemini/skills/paseo) and marks them with
# .paseo-managed-files.json, so we never write, copy over or delete anything there. Hermes reads none of those dirs, so
# ~/.local/share/skill-everywhere/skills/paseo is a symlink to the daemon-managed copy and follows its updates.
# Link mode creates that one link (idempotent; a foreign real dir at the target is left alone and is an error, like a
# collision with one of our own names; a missing source creates nothing). --check fails (exit 1, `error:` line on
# stderr) when `paseo` is absent from any live target: claude, codex/pi or hermes, a target being live only when its
# client is installed (`gemini` is skipped here because Paseo manages Antigravity's copy under ~/.gemini/config/skills/
# and linking into ~/.gemini/skills/paseo would duplicate it). `--remove paseo` removes the Hermes link when it is ours (a link to the Paseo copy), and other
# --remove runs leave it alone. The step prints a `== paseo (managed by Paseo)` section in link and remove modes and with --all.
paseo_src="$HOME/.agents/skills/paseo"
paseo_step() {
  [[ $mode != remove ]] || ((paseo_named)) || return 0  # --remove acts on the Hermes link only when `paseo` is named
  local bin dir link state have_src=0 show=0 hint
  [[ -f $paseo_src/SKILL.md ]] && have_src=1
  if [[ $mode != check ]] || ((all)); then show=1; fi
  ((!show)) || echo "== paseo (managed by Paseo)"
  while IFS='|' read -r bin dir; do
    [[ -z $bin ]] && continue
    wanted "$bin" || continue
    [[ $bin == gemini || $dir == copy\ * || $dir == via* || $dir == x* ]] && continue
    target_installed "$bin" || { ((!show)) || printf '  %-13s not installed\n' "$bin"; continue; }
    dir="${dir/#\~/$HOME}"; link="$dir/paseo"
    if [[ $bin == hermes ]]; then
      if [[ -L $link && "$(greadlink "$link")" == "$paseo_src" && -e $link ]]; then state=linked
      elif [[ -L $link && ! -e $link ]]; then state="dangling -> $(greadlink "$link")"
      elif [[ -L $link && -e $paseo_src && "$(grealpath "$link" 2>/dev/null)" == "$(grealpath "$paseo_src")" ]]; then
        state="chained via $(greadlink "$link")"
      elif [[ -L $link ]]; then state="other link -> $(greadlink "$link")"
      elif [[ -e $link ]]; then state="real dir/file (not ours)"
      else state=missing; fi
    else
      [[ -e $link ]] && state=present || state=missing  # Paseo's own sync owns these; never touched here
    fi
    case $mode in
      check)
        ((!show)) || printf '  %-13s %s\n' "$bin" "$state"
        if [[ $state != linked && $state != present ]]; then
          hint="run skill-everywhere (link mode) once"; [[ $bin == hermes ]] || hint="Paseo's daemon syncs it: check the daemon and agents.skills.selection in ~/.paseo/config.json"
          printf 'error: paseo skill is %s on %s (%s): %s\n' "$state" "$bin" "$link" "$hint" >&2
          rc=1
        fi ;;
      remove)
        if [[ $bin != hermes ]]; then printf '  %-13s %s (Paseo-managed; not touched)\n' "$bin" "$state"
        elif [[ $state == linked || ( -L $link && "$(greadlink "$link")" == "$paseo_src" ) ]]; then
          # ours even when it dangles (Paseo's copy gone, the case a retirement follows), like the gone-skill remove above
          act "remove $link" rm "$link"; ((dry)) || printf '  %-13s removed\n' "$bin"
        else printf '  %-13s %s (left alone)\n' "$bin" "$state"; fi ;;
      link)
        [[ $bin == hermes ]] || { printf '  %-13s %s (Paseo-managed; not touched)\n' "$bin" "$state"; continue; }
        if [[ $state == linked ]]; then printf '  %-13s already linked\n' "$bin"
        elif ((!have_src)); then
          printf '  %-13s paseo source missing (%s): no link made\n' "$bin" "$paseo_src"
          printf 'error: paseo skill source %s/SKILL.md is missing; not linking it into %s\n' "$paseo_src" "$dir" >&2
          rc=1
        elif [[ $state == missing ]]; then
          act "link $link" eval 'mkdir -p "$dir" && ln -s "$paseo_src" "$link"'; ((dry)) || printf '  %-13s linked\n' "$bin"
        elif [[ $state == chained\ * || $state == dangling\ * ]]; then
          act "relink $link" ln -sfn "$paseo_src" "$link"; ((dry)) || printf '  %-13s relinked (was %s)\n' "$bin" "$state"
        else printf '  %-13s %s; left alone\n' "$bin" "$state"; rc=1; fi ;;
    esac
  done <<<"$targets"
}
paseo_step

# Skills retired from this repository (2026-11-24: consolidated into skills/self-handoff).
# In link mode (except a paseo-only invocation), stale symlinks pointing at one of our four
# roots and Grok Bot managed copies are removed cleanly across every target dir (including
# gemini's ~/.gemini/skills via targets, when not excluded by SKILL_EVERYWHERE_ONLY). Foreign
# links and real directories are never touched, and a name that still exists in any root is skipped.
# In `--check --all` mode, any remaining retired link/copy warns on stderr and sets rc=1;
# named `--check` stays untouched so `bin/ade-update` row parsing is unaffected.
retired_skills=(
  old-handoff-use-paseo-handoff
  old-hand-use-paseo-handoff
)
paseo_only=0
((paseo_named)) && [[ $# == 1 ]] && paseo_only=1
retired_step() {
  ((paseo_only)) && return 0
  [[ $mode == link ]] || [[ $mode == check && $all == 1 ]] || return 0
  local rname bin dir dest seen_dirs printed=0
  _retired_header() {
    if ((!printed)); then
      echo "== retired skills"
      printed=1
    fi
  }
  _clean_retired_link() {
    local tbin=$1 tdir=$2 tname=$3
    local l="$tdir/$tname" tgt m=0 s
    [[ -L $l ]] || return 0
    tgt="$(greadlink -- "$l" 2>/dev/null)" || return 0
    for s in "$ade_root/$tname" "$priv_root/$tname" "$site_root/$tname" "$chrome_root/$tname"; do
      [[ $tgt == "$s" ]] && { m=1; break; }
    done
    ((m)) || return 0
    if [[ $mode == check ]]; then
      printf 'warning: retired skill link still present: %s -> %s (run skill-everywhere --all to remove)\n' "$l" "$tgt" >&2
      rc=1
    else
      _retired_header
      bin=$tbin
      act "remove retired $l" rm -- "$l"
      ((dry)) || printf '  %-13s removed retired %s\n' "$bin" "$l"
    fi
  }
  for rname in "${retired_skills[@]}"; do
    # Never treat a name as retired while any root still ships a live SKILL.md for it.
    if [[ -f $ade_root/$rname/SKILL.md || -f $priv_root/$rname/SKILL.md \
       || -f $site_root/$rname/SKILL.md || -f $chrome_root/$rname/SKILL.md ]]; then
      continue
    fi
    seen_dirs="|"
    while IFS='|' read -r bin dir; do
      [[ -z $bin ]] && continue
      wanted "$bin" || continue
      if [[ $dir == copy\ * ]]; then
        ((no_copy)) && continue
        dir="${dir#copy }"; dir="${dir/#\~/$HOME}"
        dest="$dir/ade-$rname"
        if [[ -d $dest && ! -L $dest && -f $dest/.skill-everywhere && ! -L $dest/.skill-everywhere ]]; then
          if [[ $mode == check ]]; then
            printf 'warning: retired skill copy still present: %s (run skill-everywhere --all to remove)\n' "$dest" >&2
            rc=1
          else
            _retired_header
            act "remove retired $dest" rm -rf -- "$dest"
            ((dry)) || printf '  %-13s removed retired %s\n' "$bin" "$dest"
          fi
        fi
        continue
      fi
      [[ $dir == via* || $dir == x* ]] && continue
      dir="${dir/#\~/$HOME}"
      [[ $seen_dirs == *"|$dir|"* ]] && continue
      seen_dirs="${seen_dirs}${dir}|"
      _clean_retired_link "$bin" "$dir" "$rname"
    done <<<"$targets"
  done
}
retired_step
# --check ends with a sentinel so a caller (bin/ade-update) can tell a complete report from one cut short by a crash
if [[ $mode == check ]]; then echo "== end"; fi

if wanted hermes && has_cli hermes \
   && ! ggrep -qF skill-everywhere/skills ~/.hermes/config.yaml 2>/dev/null; then
  echo "warning: hermes no longer lists ~/.local/share/skill-everywhere/skills in" \
       "skills.external_dirs; ask Hermes to re-add it" >&2
fi

# After linking, nudge the running Hermes gateway to force plugin re-discovery
# (#87770). A plugin slash command (e.g. /helm-all, registered by
# ~/.hermes/plugins/skill-slash) does not reach the live gateway until plugins
# reload. /steps, /helm, /baton, and /session-finder are native skill slash —
# do not register them in that plugin.
# The nudge makes a plugin command dispatch immediately instead of waiting
# for a manual gateway restart from Terminal. Idempotent and cheap. Does nothing
# when the gateway is not running or predates the verb.
if [[ $mode == link ]] && ((!dry)) && wanted hermes && has_cli hermes; then
  # The interpreter: the shebang when it is a python, else the python a wrapper execs. `hermes` became a
  # /bin/sh wrapper around a /bin/sh closure launcher (2026-10-20), and taking its shebang ran this
  # snippet under sh: `import os, sys` invoked ImageMagick's `import`. Never run it under a non-python.
  hpy="" hfile="$(resolve_cli hermes)"
  for _ in 1 2 3; do
    shebang="$(ghead -1 "$hfile")"; shebang="${shebang#\#!}"; shebang="${shebang%% *}"
    if [[ $(basename "$shebang") == python* && -x $shebang ]]; then hpy=$shebang; break; fi
    next="$(ggrep -oE "exec +/[^ \"']+" "$hfile" | ghead -1 | gsed -E 's/^exec +//' || true)"
    if [[ $(basename "$next") == python* && -x $next ]]; then hpy=$next; break; fi
    [[ -n $next && -f $next ]] || break
    hfile=$next
  done
  if [[ -z $hpy ]]; then hpy="$(command -v python3)"; fi
  # Pipeline through python must run from a cwd inside the agent project, else
  # the editable install's __editable___hermes_agent_finder still needs the
  # project root on sys.path. Inject it so the nudge works from any directory.
  HERMES_HOME="${HERMES_HOME:-$HOME/.hermes}" "$hpy" -c '
import os, sys
from pathlib import Path
bin_dir = Path(sys.executable).parent
root = bin_dir.parent.parent.resolve() if bin_dir.name == ".venv" else bin_dir.parent.parent
for r in (Path(os.environ["HERMES_HOME"]) / "hermes-agent", root):  # a pinned tools python is not in the tree
    if r.is_dir() and str(r) not in sys.path:
        sys.path.insert(0, str(r))
try:
    from gateway.control_socket import reload_gateway_plugins
except Exception:
    raise SystemExit
os.environ.setdefault("HERMES_HOME", os.path.expanduser("~/.hermes"))
try:
    r = reload_gateway_plugins(Path(os.environ["HERMES_HOME"]), timeout=20)
    print("hermes gateway: plugins %s" % ("reloaded" if r and r.get("reloaded") else "not reloaded (no answer)"))
except Exception as e:
    print("hermes gateway: plugin nudge skipped: %s" % e)
' 2>/dev/null || true
fi
exit $rc

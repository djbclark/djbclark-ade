#!/usr/bin/env bash
# Make a shared skill visible to every agent TUI on this machine by
# symlinking it into each TUI's user-level skills dir.
#     skill-everywhere <name>...            link (idempotent, collapses chains)
#     skill-everywhere --check <name>...    report per-TUI status, change nothing; ends with a "== end" line
#     skill-everywhere --remove <name>...   remove links this script would make
#     --dry-run (-n) with link or --remove: print the changes, make none
#     SKILL_EVERYWHERE_ONLY=grokbot,claude limits the run to those targets
#     SKILL_EVERYWHERE_NO_COPY=1 skips the copy target (grokbot): ade-update sets it for a non-canonical checkout, which
#     is a report-only run, so such a run neither lists nor renders the Grok Bot copy
#     The grokbot copy refuses a skill holding a symlink that is not a link to a regular file inside the skill (one that
#     leaves the skill, dangles, or names a directory or special file): --check reports "unsafe source symlink"; link
#     mode copies nothing, leaves any existing copy alone and exits 1
# Content lives in exactly one place (2026-10-14 chain collapse):
#   ~/src/djbclark-ade/skills/<name>            public skills (default)
#   ~/ops/site-private/skills/<name>            private skills (e.g. 1password)
# and every TUI links DIRECTLY at that path — no hub layers, no chained
# symlinks (the old TUI -> site-private/skills -> site-djbclark/skills ->
# djbclark-ade chain is retired; ops-repo churn can no longer break skill
# loading). Editing the skill in its git repo updates it everywhere; never
# copy (copies drift, e.g. ~/.agents/skills/handoff).
# In link mode, any existing link whose realpath equals the target but whose
# readlink differs (a leftover chain) is atomically replaced with the direct
# link.
# Hermes owns ~/.hermes/, so it is never edited here. Instead Hermes itself put
# ~/.local/share/skill-everywhere/skills in its skills.external_dirs (done
# 2026-10-03), and this script links into that dir.
# A TUI whose binary is not installed is skipped. Being linked is not the same
# as being loaded: re-verify with the per-TUI check in skill-everywhere.md
# (the README next to this script).
# This script makes no model calls. When re-verifying, probe agy at most ONCE (one
# batched prompt, --print-timeout): looped agy -p probes helped lock out its CLI on
# 2026-10-03 (see skills/model-routing, "agy has a burst limit").
export PATH="/opt/homebrew/bin:$PATH"
set -euo pipefail
# GNU tools carry a g prefix on the Mac (Homebrew). On GNU/Linux, e.g. the
# Grok Bot box (2026-10-23), the plain names are already GNU: alias them.
for t in sed readlink realpath grep head awk; do
  command -v "g$t" >/dev/null || eval "g$t() { $t \"\$@\"; }"
done
ade_root="${SKILL_EVERYWHERE_ADE:-$HOME/src/djbclark-ade/skills}"
priv_root="${SKILL_EVERYWHERE_PRIVATE:-${OPS_ROOT:-$HOME/ops}/site-private/skills}"

# binary|skills dir to link into, or "via <dir>" when the TUI already reads a
# dir we fill (a second link there would list the skill twice), or "x <why>",
# or "copy <dir>" for a target that needs a rendered copy (see copy_target).
# Verified 2026-10-03 by asking each TUI headlessly whether it saw 'steps'.
# omp (oh-my-pi) added 2026-10-13: it also reads ~/.agents/skills, but dedups
# by realpath, so its native dir lists each skill once and keeps working if
# its agents provider is turned off.
targets='
claude|~/.claude/skills
codex|~/.agents/skills
agy|~/.gemini/antigravity-cli/skills
copilot|~/.copilot/skills
opencode|~/.config/opencode/skills
qwen|~/.qwen/skills
devin|~/.config/devin/skills
cline|~/.cline/skills
hermes|~/.local/share/skill-everywhere/skills
cursor-agent|via ~/.claude/skills
grok|~/.grok/skills
muse|via ~/.claude/skills
zcode|via ~/.agents/skills
omp|~/.omp/agent/skills
grokbot|copy ~/agent-data/workflows
'

mode=link dry=0
while [[ ${1:-} == -* ]]; do
  case $1 in
    --check) mode=check ;; --remove) mode=remove ;; --dry-run|-n) dry=1 ;;
    *) echo "error: unknown option $1" >&2; exit 2 ;;
  esac
  shift
done
[[ $# -gt 0 ]] || { gsed -n '2,13p' "$0" >&2; exit 2; }
only="${SKILL_EVERYWHERE_ONLY:-}"
no_copy=0; [[ -z ${SKILL_EVERYWHERE_NO_COPY:-} ]] || no_copy=1
wanted() { [[ -z $only || ",$only," == *",$1,"* ]]; }
# would <msg> | <cmd...>: print in dry-run mode, else run the command.
act() { local msg=$1; shift; if ((dry)); then printf '  %-13s would %s\n' "$bin" "$msg"; else "$@"; fi; }

# Grok Bot (target added 2026-10-23) reads <dir>/<slug>/SKILL.md as plain
# files on its own Linux box, where no link into a Mac checkout can resolve.
# It gets a rendered COPY: slug ade-<name> (keeps clear of Grok Bot's own
# skills), symlinks dereferenced, a banner after the front matter, and a
# .skill-everywhere marker. Only a dir holding that marker is ours to update
# or remove. SKILL_EVERYWHERE_GROKBOT_NOTE adds one more banner paragraph.
# unsafe_links <srcdir>: one line per symlink under <srcdir> that is not a link to a regular file inside the
# skill's own source dir (realpath of <srcdir>): a link out of it, a dangling one, one to a directory (a loop like
# `x -> .` or a multiplied tree), or one to a special file. `cp -rL` would follow each of them (2026-10-23, Codex
# review of PR 20: a PR branch's absolute links filled a temp dir with the operator's home during `ade-update
# --check`). A skill dir that is itself a link (the canonical skills/ keeps some, into sibling repos) is judged
# by where it resolves, so only links INSIDE that tree count.
unsafe_links() {
  local root l t
  root=$(grealpath -- "$1" 2>/dev/null) || { printf '%s\n' "$1"; return; }
  while IFS= read -r -d '' l; do
    t=$(grealpath -e -- "$l" 2>/dev/null) || { printf '%s\n' "$l"; continue; }
    [[ $t == "$root"/* && -f $t ]] || printf '%s\n' "$l"
  done < <(find "$root" -type l -print0)
}
render_copy() {  # render_copy <src> <out>; refuses (rc 1, nothing copied) a source with an unsafe_links entry
  local bad
  bad=$(unsafe_links "$1")
  if [[ -n $bad ]]; then
    printf 'error: unsafe source symlink, not copying %s (a link must point at a regular file inside the skill): %s\n' \
      "$1" "${bad//$'\n'/ }" >&2
    return 1
  fi
  cp -rL "$1" "$2"
  rm -rf "$2/.git"; find "$2" -name __pycache__ -prune -exec rm -rf {} +
  printf 'source=djbclark-ade/skills/%s\nmanaged-by=bin/skill-everywhere (grokbot target)\n' "$name" >"$2/.skill-everywhere"
  BANNER="> **Managed copy, do not edit here.** Rendered by djbclark-ade \`bin/skill-everywhere\` from
> [\`skills/$name\`](https://github.com/djbclark/djbclark-ade/tree/master/skills/$name); the next sync
> overwrites local edits. Written for the agent TUIs on djbclark's Mac: \`~/src/<repo>\` is
> \`/home/box/src/<repo>\` here when cloned, and Mac-only tools (launchd, herdr, Orca, Keychain,
> \`hermes-ping\`) are absent. Grok Bot's own rules win: sending, posting, pushing or merging still
> needs the operator's explicit approval.${SKILL_EVERYWHERE_GROKBOT_NOTE:+
>
> ${SKILL_EVERYWHERE_GROKBOT_NOTE}}" \
  gawk 'n < 2 && /^---[[:space:]]*$/ { n++; print; if (n == 2) print "\n" ENVIRON["BANNER"]; next } { print }' \
    "$2/SKILL.md" >"$2/SKILL.md.new" && mv "$2/SKILL.md.new" "$2/SKILL.md"
}
copy_target() {  # copy_target <dir>; uses $bin $name $src $mode $dry
  local dir=${1/#\~/$HOME} dest state tmp bad
  if [[ ! -d $dir ]]; then printf '  %-13s not installed (no %s)\n' "$bin" "$dir"; return; fi
  dest="$dir/ade-$name"
  if [[ ! -e $dest ]]; then state=missing
  elif [[ ! -f $dest/.skill-everywhere ]]; then state="real dir/file (not ours)"
  elif [[ ! -f $src/SKILL.md ]]; then state="copy of a removed skill"
  else state=render
  fi
  # Only a state that would render the source is judged by it (--remove never renders).
  if [[ $mode != remove && ($state == missing || $state == render) && -f $src/SKILL.md ]] \
     && bad=$(unsafe_links "$src") && [[ -n $bad ]]; then
    state="unsafe source symlink"
    printf 'warning: %s: %s is not copied, a symlink in it leaves the skill or is not a regular file: %s\n' \
      "$name" "$src" "${bad//$'\n'/ }" >&2
  elif [[ $state == render && $mode == remove ]]; then state=copied
  elif [[ $state == render ]]; then
    tmp=$(mktemp -d); render_copy "$src" "$tmp/x"
    if diff -r "$tmp/x" "$dest" >/dev/null 2>&1; then state=copied; else state="stale copy"; fi
    rm -rf "$tmp"
  fi
  case $mode in
    check) printf '  %-13s %s (%s)\n' "$bin" "$state" "$dest" ;;
    remove)
      if [[ $state == missing || $state == real* ]]; then printf '  %-13s %s (left alone)\n' "$bin" "$state"
      else act "remove $dest" rm -rf "$dest"; ((dry)) || printf '  %-13s removed %s\n' "$bin" "$dest"; fi ;;
    link)
      if [[ $state == copied ]]; then printf '  %-13s already copied\n' "$bin"
      elif [[ $state == missing || $state == "stale copy" ]]; then
        # Render beside the target under a dot name, then swap it in.
        act "copy to $dest ($state)" eval 'rm -rf "$dir/.ade-$name.new" && render_copy "$src" "$dir/.ade-$name.new" && rm -rf "$dest" && mv "$dir/.ade-$name.new" "$dest"'
        ((dry)) || printf '  %-13s copied (was %s)\n' "$bin" "$state"
      else printf '  %-13s %s; left alone\n' "$bin" "$state"; rc=1; fi ;;
  esac
}

rc=0
# Skill links can be healthy while Codex's shared instructions point at a
# retired home-agents.md location. Report that separately in read-only checks.
codex_instructions="${CODEX_HOME:-$HOME/.codex}/AGENTS.md"
if [[ $mode == check ]] && wanted codex && [[ -L $codex_instructions && ! -e $codex_instructions ]]; then
  printf 'warning: codex global instructions dangling: %s -> %s\n' \
    "$codex_instructions" "$(greadlink "$codex_instructions")" >&2
  rc=1
fi
for name in "$@"; do
  if [[ -f $ade_root/$name/SKILL.md ]]; then src="$ade_root/$name"
  elif [[ -f $priv_root/$name/SKILL.md ]]; then src="$priv_root/$name"
  else
    if [[ $mode != remove ]]; then
      echo "error: no SKILL.md under $ade_root/$name or $priv_root/$name" >&2; rc=1; continue
    fi
    # --remove still works once the skill dir is gone: it only unlinks links
    # whose target is one of the two roots, so retiring a skill can run in
    # either order. Without a source there is nothing to compare realpaths
    # against, so fall back to the public root's path for target matching.
    src="$ade_root/$name"
  fi
  echo "== $name"
  while IFS='|' read -r bin dir; do
    [[ -z $bin ]] && continue
    wanted "$bin" || continue
    if [[ $dir == copy\ * ]]; then
      ((no_copy)) || copy_target "${dir#copy }"  # SKILL_EVERYWHERE_NO_COPY=1: link targets only
      continue
    fi
    if ! command -v "$bin" >/dev/null; then printf '  %-13s not installed\n' "$bin"; continue; fi
    if [[ $dir == via* || $dir == x* ]]; then printf '  %-13s %s\n' "$bin" "${dir#x }"; continue; fi
    dir="${dir/#\~/$HOME}"; link="$dir/$name"
    if [[ -L $link && "$(greadlink "$link")" == "$src" ]]; then state=linked
    elif [[ -L $link && -e $src && "$(grealpath "$link" 2>/dev/null)" == "$(grealpath "$src")" ]]; then
      state="chained via $(greadlink "$link")"
    elif [[ -L $link && ! -e $link ]]; then state="dangling -> $(greadlink "$link")"
    elif [[ -L $link ]]; then state="other link -> $(greadlink "$link")"
    elif [[ -e $link ]]; then state="real dir/file (not ours)"
    else state=missing; fi
    case $mode in
      check) printf '  %-13s %s\n' "$bin" "$state" ;;
      remove)
        if [[ $state == linked ]]; then act "remove $link" rm "$link"; ((dry)) || printf '  %-13s removed\n' "$bin"
        else printf '  %-13s %s (left alone)\n' "$bin" "$state"; fi ;;
      link)
        if [[ $state == missing ]]; then
          act "link $link" eval 'mkdir -p "$dir" && ln -s "$src" "$link"'; ((dry)) || printf '  %-13s linked\n' "$bin"
        elif [[ $state == linked ]]; then printf '  %-13s already linked\n' "$bin"
        elif [[ $state == chained\ * ]]; then
          # ln -sfn (not ln+mv): macOS mv follows a symlink-to-dir
          # destination and moves the temp link INSIDE the target dir
          # instead of replacing the link.
          act "relink $link direct" ln -sfn "$src" "$link"
          ((dry)) || printf '  %-13s relinked direct (was %s)\n' "$bin" "$state"
        elif [[ $state == dangling\ * ]]; then
          # Nobody owns a link whose target is gone (2026-10-15: 36 links in
          # ~/.cline/skills still pointed at the pre-2026-10-09 site-private
          # path); replace it rather than preserve a dead pointer.
          act "relink $link" ln -sfn "$src" "$link"
          ((dry)) || printf '  %-13s relinked (was %s)\n' "$bin" "$state"
        else printf '  %-13s %s; left alone\n' "$bin" "$state"; rc=1; fi ;;
    esac
  done <<<"$targets"
done
# --check ends with a sentinel so a caller (bin/ade-update) can tell a complete report from one cut short by a crash
if [[ $mode == check ]]; then echo "== end"; fi

if wanted hermes && command -v hermes >/dev/null \
   && ! ggrep -qF skill-everywhere/skills ~/.hermes/config.yaml 2>/dev/null; then
  echo "warning: hermes no longer lists ~/.local/share/skill-everywhere/skills in" \
       "skills.external_dirs; ask Hermes to re-add it" >&2
fi

# After linking, nudge the running Hermes gateway to force plugin re-discovery
# (#87770). A plugin slash command (e.g. /helm-all, registered by
# ~/.hermes/plugins/skill-slash) does not reach the live gateway until plugins
# reload. /steps, /helm, /baton, and /session-finder are native skill slash —
# do not register them in that plugin.
# The nudge makes a plugin command dispatch immediately instead of waiting
# for a manual gateway restart from Terminal. Idempotent and cheap. Does nothing
# when the gateway is not running or predates the verb.
if [[ $mode == link ]] && ((!dry)) && wanted hermes && command -v hermes >/dev/null; then
  # The interpreter: the shebang when it is a python, else the python a wrapper execs. `hermes` became a
  # /bin/sh wrapper around a /bin/sh closure launcher (2026-10-20), and taking its shebang ran this
  # snippet under sh: `import os, sys` invoked ImageMagick's `import`. Never run it under a non-python.
  hpy="" hfile="$(command -v hermes)"
  for _ in 1 2 3; do
    shebang="$(ghead -1 "$hfile")"; shebang="${shebang#\#!}"; shebang="${shebang%% *}"
    if [[ $(basename "$shebang") == python* && -x $shebang ]]; then hpy=$shebang; break; fi
    next="$(ggrep -oE "exec +/[^ \"']+" "$hfile" | ghead -1 | gsed -E 's/^exec +//' || true)"
    if [[ $(basename "$next") == python* && -x $next ]]; then hpy=$next; break; fi
    [[ -n $next && -f $next ]] || break
    hfile=$next
  done
  if [[ -z $hpy ]]; then hpy="$(command -v python3)"; fi
  # Pipeline through python must run from a cwd inside the agent project, else
  # the editable install's __editable___hermes_agent_finder still needs the
  # project root on sys.path. Inject it so the nudge works from any directory.
  HERMES_HOME="${HERMES_HOME:-$HOME/.hermes}" "$hpy" -c '
import os, sys
from pathlib import Path
bin_dir = Path(sys.executable).parent
root = bin_dir.parent.parent.resolve() if bin_dir.name == ".venv" else bin_dir.parent.parent
for r in (Path(os.environ["HERMES_HOME"]) / "hermes-agent", root):  # a pinned tools python is not in the tree
    if r.is_dir() and str(r) not in sys.path:
        sys.path.insert(0, str(r))
try:
    from gateway.control_socket import reload_gateway_plugins
except Exception:
    raise SystemExit
os.environ.setdefault("HERMES_HOME", os.path.expanduser("~/.hermes"))
try:
    r = reload_gateway_plugins(Path(os.environ["HERMES_HOME"]), timeout=20)
    print("hermes gateway: plugins %s" % ("reloaded" if r and r.get("reloaded") else "not reloaded (no answer)"))
except Exception as e:
    print("hermes gateway: plugin nudge skipped: %s" % e)
' 2>/dev/null || true
fi
exit $rc

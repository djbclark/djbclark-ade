#!/usr/bin/env bash
# Make shared skills (the site-private hub, backed by djbclark-ade) visible to every agent TUI on
# this machine by symlinking them into each TUI's user-level skills dir.
#     skill-everywhere <name>...            link (idempotent)
#     skill-everywhere --check <name>...    report per-TUI status, change nothing
#     skill-everywhere --remove <name>...   remove links this script would make
# Links point at the git checkout, so editing the skill in its git repo
# (site-djbclark/skills, or ~/src/djbclark-ade/skills for the orchestration
# skills; site-private only for private ones) updates it everywhere; never
# copy (copies drift, e.g. ~/.agents/skills/handoff).
# Hermes owns ~/.hermes/, so it is never edited here. Instead Hermes itself put
# ~/.local/share/skill-everywhere/skills in its skills.external_dirs (done
# 2026-10-03), and this script links into that dir.
# A TUI whose binary is not installed is skipped. Being linked is not the same
# as being loaded: re-verify with the per-TUI check in skill-everywhere.md
# (the README next to this script).
# This script makes no model calls. When re-verifying, probe agy at most ONCE (one
# batched prompt, --print-timeout): looped agy -p probes helped lock out its CLI on
# 2026-10-03 (see skills/model-routing, "agy has a burst limit").
set -euo pipefail
# site-private/skills remains the hub so existing TUI links stay stable. Public
# skills in it point into djbclark-ade; private skills remain private there.
src_root="${SKILL_EVERYWHERE_HUB:-${OPS_ROOT:-$HOME/ops}/site-private/skills}"

# binary|skills dir to link into, or "via <dir>" when the TUI already reads a
# dir we fill (a second link there would list the skill twice), or "x <why>".
# Verified 2026-10-03 by asking each TUI headlessly whether it saw 'steps'.
targets='
claude|~/.claude/skills
codex|~/.agents/skills
agy|~/.gemini/antigravity-cli/skills
copilot|~/.copilot/skills
opencode|~/.config/opencode/skills
qwen|~/.qwen/skills
devin|~/.config/devin/skills
cline|~/.cline/skills
hermes|~/.local/share/skill-everywhere/skills
cursor-agent|via ~/.claude/skills
grok|~/.grok/skills
muse|via ~/.claude/skills
zcode|via ~/.agents/skills
'

mode=link
case "${1:-}" in --check) mode=check; shift ;; --remove) mode=remove; shift ;; esac
[[ $# -gt 0 ]] || { sed -n '2,6p' "$0" >&2; exit 2; }

rc=0
for name in "$@"; do
  src="$src_root/$name"
  # --remove still works once the skill dir is gone: it only unlinks links
  # whose target is exactly $src, so retiring a skill can run in either order.
  if [[ ! -f $src/SKILL.md && $mode != remove ]]; then
    echo "error: no $src/SKILL.md" >&2; rc=1; continue
  fi
  echo "== $name"
  while IFS='|' read -r bin dir; do
    [[ -z $bin ]] && continue
    if ! command -v "$bin" >/dev/null; then printf '  %-13s not installed\n' "$bin"; continue; fi
    if [[ $dir == via* || $dir == x* ]]; then printf '  %-13s %s\n' "$bin" "${dir#x }"; continue; fi
    dir="${dir/#\~/$HOME}"; link="$dir/$name"
    if [[ -L $link && "$(readlink "$link")" == "$src" ]]; then state=linked
    elif [[ -L $link && -e $src && "$(realpath "$link" 2>/dev/null)" == "$(realpath "$src")" ]]; then
      # e.g. ~/.copilot/skills/x -> ~/.claude/skills/x -> $src: same skill,
      # one hop longer. Works; --remove leaves it, relink by hand if wanted.
      state="linked via $(readlink "$link")"
    elif [[ -L $link ]]; then state="other link -> $(readlink "$link")"
    elif [[ -e $link ]]; then state="real dir/file (not ours)"
    else state=missing; fi
    case $mode in
      check) printf '  %-13s %s\n' "$bin" "$state" ;;
      remove)
        if [[ $state == linked ]]; then rm "$link"; printf '  %-13s removed\n' "$bin"
        else printf '  %-13s %s (left alone)\n' "$bin" "$state"; fi ;;
      link)
        if [[ $state == missing ]]; then
          mkdir -p "$dir"; ln -s "$src" "$link"; printf '  %-13s linked\n' "$bin"
        elif [[ $state == linked || $state == "linked via "* ]]; then printf '  %-13s already %s\n' "$bin" "$state"
        else printf '  %-13s %s; left alone\n' "$bin" "$state"; rc=1; fi ;;
    esac
  done <<<"$targets"
done

if command -v hermes >/dev/null \
   && ! grep -qF skill-everywhere/skills ~/.hermes/config.yaml 2>/dev/null; then
  echo "warning: hermes no longer lists ~/.local/share/skill-everywhere/skills in" \
       "skills.external_dirs; ask Hermes to re-add it" >&2
fi

# After linking, nudge the running Hermes gateway to force plugin re-discovery
# (#87770). A skill that also adds a Telegram slash command (e.g. /helm, /steps,
# registered by ~/.hermes/plugins/skill-slash) does not reach the live gateway
# until plugins reload; this makes it dispatch immediately instead of waiting
# for a manual gateway restart from Terminal. Idempotent and cheap. Does nothing
# when the gateway is not running or predates the verb.
if [[ $mode == link ]] && command -v hermes >/dev/null; then
  hpy="$(head -1 "$(command -v hermes)")"     # shebang = the venv python
  hpy="${hpy#\#!}"
  if [[ ! -x $hpy ]]; then hpy="$(command -v python3)"; fi
  # Pipeline through python must run from a cwd inside the agent project, else
  # the editable install's __editable___hermes_agent_finder still needs the
  # project root on sys.path. Inject it so the nudge works from any directory.
  HERMES_HOME="${HERMES_HOME:-$HOME/.hermes}" "$hpy" -c '
import os, sys
from pathlib import Path
bin_dir = Path(sys.executable).parent
root = bin_dir.parent.parent.resolve() if bin_dir.name == ".venv" else bin_dir.parent.parent
if str(root) not in sys.path:
    sys.path.insert(0, str(root))
try:
    from gateway.control_socket import reload_gateway_plugins
except Exception:
    raise SystemExit
os.environ.setdefault("HERMES_HOME", os.path.expanduser("~/.hermes"))
try:
    r = reload_gateway_plugins(Path(os.environ["HERMES_HOME"]), timeout=20)
    print("hermes gateway: plugins %s" % ("reloaded" if r and r.get("reloaded") else "not reloaded (no answer)"))
except Exception as e:
    print("hermes gateway: plugin nudge skipped: %s" % e)
' 2>/dev/null || true
fi
exit $rc

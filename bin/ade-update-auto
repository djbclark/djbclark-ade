#!/usr/bin/env python3
"""S4 ``update --auto``: observe-only by default; optional this-checkout apply.

    ade-update-auto [--repo PATH] [--json] [--apply-checkout]
    ade-update --auto [--apply-checkout] …

Always runs observe-only steps (``ade-update --check`` + ``ade-install keys``).

Without ``--apply-checkout`` (and without ``ADE_UPDATE_AUTO_APPLY=1``): exits 5
naming that scheduled / multi-component auto-apply is not landed (PR 359 / #510
stub). Daily behind-check remains ``ade-update-check`` / ``just update-check-install``.

With ``--apply-checkout`` / env: when ``--check`` reports behind (rc 10), runs
bare ``ade-update`` for **this checkout only** (option 1 / recommended default).
When already current (rc 0), exits 0 with no apply. Does **not** install the
``update-auto`` schedule plist, mid-turn skip, or failure ping (options 2–3).
"""
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path
from typing import Any

EXIT_OK = 0
EXIT_USAGE = 2
EXIT_NOT_IMPLEMENTED = 5
EXIT_ERROR = 4
DEFAULT_REPO = os.path.expanduser("~/src/djbclark-ade")
NOT_IMPLEMENTED = (
    "ade-update-auto: not implemented — scheduled / multi-component auto-apply "
    "(mid-turn skip, failure ping, update-auto plist) is not landed; this run was "
    "observe-only (--check + keys). Pass --apply-checkout (or ADE_UPDATE_AUTO_APPLY=1) "
    "to ff-only update this checkout when behind; daily check remains "
    "just update-check-install (never auto-applies)."
)


def _here() -> Path:
    return Path(__file__).resolve().parent


def _env_apply() -> bool:
    v = (os.environ.get("ADE_UPDATE_AUTO_APPLY") or "").strip().lower()
    return v in ("1", "true", "yes", "on")


def _run(argv: list[str], *, timeout: int = 600) -> subprocess.CompletedProcess[str]:
    return subprocess.run(  # noqa: S603 — argv list only
        argv, capture_output=True, text=True, check=False, timeout=timeout,
    )


def run_auto(
    *,
    repo: Path,
    as_json: bool = False,
    apply_checkout: bool = False,
    run: Any = _run,
    update_bin: Path | None = None,
    install_bin: Path | None = None,
) -> int:
    report: dict[str, Any] = {
        "repo": str(repo),
        "status": "not_implemented",
        "apply_checkout": bool(apply_checkout),
        "ade_update_check_rc": None,
        "ade_update_apply_rc": None,
        "keys_rc": None,
        "notes": [],
    }
    update = update_bin or (_here() / "ade-update")
    install = install_bin or (_here() / "ade-install")
    if not update.is_file() or not install.is_file():
        report["status"] = "error"
        report["notes"].append("sibling ade-update or ade-install missing")
        return _emit(report, as_json, EXIT_ERROR)

    try:
        up = run([str(update), "--check", "--repo", str(repo)], timeout=900)
    except subprocess.TimeoutExpired:
        report["status"] = "error"
        report["notes"].append("ade-update --check timed out")
        return _emit(report, as_json, EXIT_ERROR)
    report["ade_update_check_rc"] = up.returncode
    if up.stdout:
        report["notes"].append(up.stdout.strip()[-500:])
    # --check uses 0 current / 10 behind; both are observe outcomes
    if up.returncode not in (0, 10):
        report["status"] = "error"
        report["notes"].append(f"ade-update --check failed (rc={up.returncode})")
        if up.stderr:
            report["notes"].append(up.stderr.strip()[-300:])
        return _emit(report, as_json, up.returncode if up.returncode else EXIT_ERROR)

    try:
        keys = run([str(install), "keys", "--root", str(repo)], timeout=300)
    except subprocess.TimeoutExpired:
        report["status"] = "error"
        report["notes"].append("ade-install keys timed out")
        return _emit(report, as_json, EXIT_ERROR)
    report["keys_rc"] = keys.returncode
    if keys.returncode != 0:
        report["status"] = "error"
        report["notes"].append(f"ade-install keys failed (rc={keys.returncode})")
        return _emit(report, as_json, keys.returncode if keys.returncode else EXIT_ERROR)

    if not apply_checkout:
        report["notes"].append(NOT_IMPLEMENTED)
        return _emit(report, as_json, EXIT_NOT_IMPLEMENTED)

    if up.returncode == 0:
        report["status"] = "current"
        report["notes"].append("ade-update --check: current; no apply")
        return _emit(report, as_json, EXIT_OK)

    # behind (rc 10): apply this checkout only
    try:
        apply = run([str(update), "--repo", str(repo)], timeout=900)
    except subprocess.TimeoutExpired:
        report["status"] = "error"
        report["notes"].append("ade-update apply timed out")
        return _emit(report, as_json, EXIT_ERROR)
    report["ade_update_apply_rc"] = apply.returncode
    if apply.stdout:
        report["notes"].append(apply.stdout.strip()[-500:])
    if apply.returncode not in (0, 10):
        report["status"] = "error"
        report["notes"].append(f"ade-update apply failed (rc={apply.returncode})")
        if apply.stderr:
            report["notes"].append(apply.stderr.strip()[-300:])
        return _emit(report, as_json, apply.returncode if apply.returncode else EXIT_ERROR)
    report["status"] = "applied" if apply.returncode == 0 else "applied_with_link_debt"
    report["notes"].append("checkout-only apply (option 1); no update-auto schedule")
    return _emit(report, as_json, EXIT_OK if apply.returncode == 0 else apply.returncode)


def _emit(report: dict[str, Any], as_json: bool, rc: int) -> int:
    if as_json:
        json.dump(report, sys.stdout, indent=2, sort_keys=True)
        sys.stdout.write("\n")
    else:
        print(f"ade-update-auto: {report.get('status')} repo={report.get('repo')}")
        for note in report.get("notes") or []:
            for line in str(note).splitlines() or [""]:
                print(f"  {line}")
        if report.get("ade_update_check_rc") is not None:
            print(f"  ade_update_check_rc={report['ade_update_check_rc']}")
        if report.get("ade_update_apply_rc") is not None:
            print(f"  ade_update_apply_rc={report['ade_update_apply_rc']}")
        if report.get("keys_rc") is not None:
            print(f"  keys_rc={report['keys_rc']}")
        if rc == EXIT_NOT_IMPLEMENTED:
            print(NOT_IMPLEMENTED, file=sys.stderr)
    return rc


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        prog="ade-update-auto",
        description="S4 update --auto: observe-only, or --apply-checkout for this repo only.",
    )
    ap.add_argument("--repo", default=DEFAULT_REPO, help=f"checkout (default {DEFAULT_REPO})")
    ap.add_argument("--json", action="store_true", help="print one JSON object")
    ap.add_argument(
        "--apply-checkout",
        action="store_true",
        help="when --check is behind, run bare ade-update for this checkout only "
             "(also ADE_UPDATE_AUTO_APPLY=1); does not install the update-auto schedule",
    )
    args = ap.parse_args(argv)
    repo = Path(args.repo).expanduser()
    if not repo.is_dir():
        print(f"ade-update-auto: not a directory: {repo}", file=sys.stderr)
        return EXIT_USAGE
    apply = bool(args.apply_checkout or _env_apply())
    return run_auto(repo=repo, as_json=args.json, apply_checkout=apply)


if __name__ == "__main__":
    raise SystemExit(main())

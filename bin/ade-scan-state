#!/usr/bin/env python3
"""ade-scan-state: scan of bigteam task dirs and git checkouts that changes no work.

Phase 0 item 4.3 of docs/ade-everywhere-proposal.md (djbclark, 2026-10-20): find unique reports,
dirty trees, untracked files and unpushed commits before anything is cleaned up. Nothing is moved,
deleted, committed, stashed or checked out; the only network calls are `git ls-remote` (--remote)
and `git fetch` of one branch (--fetch) when the origin tip cannot be compared: it downloads that
branch's objects, writes no refs and no FETCH_HEAD, and runs no auto-maintenance. GIT_NO_LAZY_FETCH=1
is set on every git call, so a partial clone never downloads objects as a side effect of a count
(the tip then stays uncompared: `origin tip not fetched`) unless --fetch asks for it.

A checkout's own git config can name commands (core.fsmonitor, core.sshCommand, remote.*.uploadpack,
filter.*, gpg.program with log.showSignature, credential.*, hooksPath, include.*, ...). The tool reads
that config without running anything first and accepts only an allowlist of keys (SAFE_CONFIG below);
a checkout with any other key is `skipped: unrecognised config <key>`, one with core.worktree or a
work tree that is not the scanned dir is `skipped: worktree redirected`, one whose `.git` entry is a
symlink is `skipped: .git is a symlink` (git would read a git directory elsewhere). The same allowlist is
applied to every submodule's git dir under `modules/` (`config` and `config.worktree`; `skipped: submodule
config unrecognised <key>`): a config that is unreadable is `(unreadable)`, a symlink anywhere under
`modules/` (a symlinked file in a module git dir included) or at a submodule's `.git` is `(symlink)`, a module git dir with a
`commondir` is `(commondir)`, one with a nonempty `objects/info/alternates` is `(alternates)` (the record then carries
`alternates`, the first 3 targets read from those files, and the report warns that the store they name is archived
nowhere; any other `skipped` or `scan incomplete` record of a checkout whose own `objects/info/alternates` is not empty carries
`alternates` too, read without running git, and gets the same warning; so does one whose own `objects`, `refs` or `packed-refs`
is a symlink to a store outside the checkout, or whose `.git` directory holds a `commondir`: the record then carries
`linked_stores`, each `<member> -> <target>`, since `whole.tar` and the git-dir archive keep the link, not the store, and an
error reading any of those files leaves `alternates` empty, which is the same warning without the targets),
a top-level checkout whose `.git` DIRECTORY holds a `commondir` file (a linked worktree's `.git` is a gitfile, so it is
not affected) is `skipped: git dir redirected (commondir)` before any git call: every later call, `--fetch` among
them, would act on the git directory the file names, outside the scanned tree,
a submodule whose `.git` is a directory or a gitfile naming a git dir the walk did not vet (outside
`modules/`, or in a pruned `objects/`) is `(gitdir outside modules)`, a gitfile that is not one line of
`gitdir: <path>` is `(gitdir unreadable)`, a `.gitmodules` path that is not an index gitlink but has a `.git`
is `(gitmodules path not a gitlink)`, one (or an index gitlink) that is absolute, empty or holds `..`, or whose `.gitmodules` entry
or submodule path holds a control character, a space, a zero-width, joiner, filler, variation-selector, tag or bidi
character, a non-UTF-8 byte or (a path) a quote, is `(gitmodules path unusual)`,
a submodule path with a symlink component is `(symlink)`, a submodule directory holding files but no `.git` is
`(submodule has files but no .git)`, a module whose `core.worktree` does not resolve to the submodule's own checkout is
`(core.worktree outside)`, a submodule that has a `.gitmodules`, a gitlink or an untracked repository of its own (one at a skip-worktree or assume-unchanged path included: `index_hidden_repositories`, the walk the top level runs) is `(nested submodule)` (an
edit or commit in the inner worktree is in no per-submodule artifact: the whole-directory archive is the way out), and an entry of a module git dir that differs from `HEAD`, `config`,
`config.worktree` or `commondir` only in letter case, or that the file system opens as one of those names, is
`(unrecognised entry)`: nothing is trusted that git would read elsewhere. The record carries `submodules_vetted`,
the sorted paths of the checked-out submodules that passed every check, and the plan runs git only at those paths,
each quoted in the command, never from a template or a listing of `.gitmodules`.
Every later git call also turns fsmonitor, hooks and signature display off, drops every GIT_*
variable from the environment, reads no global or system config, ignores submodules in `status`
(so a checkout with submodules carries the flag `submodules not inspected`, never a bare
`clean and pushed`), counts stashes from the reflog file, and `ls-remote` runs from a neutral
directory. Symlinks out of a --git-root are not followed: name each root you want scanned.

  ade-scan-state --bigteam ~/.local/state/bigteam \\
      --ref-root ~/src/djbclark-ade/docs --ref-root ~/ops/site-private/memory \\
      --ref-root ~/.local/state/handoffs \\
      --exclude 'extra-doc-*.md' \\
      --git-root ~/orca/workspaces --git-root ~/orca/projects --git-root ~/.cow/pastures \\
      --remote --json > scan.json
  ade-scan-state --bigteam DIR --markdown        # raw tables (bin/ade-scan-state-doc builds the doc)

`ade-everywhere-phase0-scan-*` is always excluded from the reference search (the scan doc names every
task it lists, so it would make every report look cited); --exclude adds globs, it never replaces it.

Bigteam verdicts (per task dir, ~/.local/state/bigteam/<task>/):
  scratch  no report file, or every report is already referenced under a --ref-root
  unique   an unreferenced report file and the dir is at most --unique-max-bytes (5 MiB): the
           reports are the dir
  mixed    an unreferenced report file inside a larger dir (logs, worktrees, caches)
A "report file" is *report*.md (not *.done) within three levels of the dir, not inside a git
checkout. "Referenced" is a whole-word match of the task name in any file under a --ref-root
(`rg -l -F -w`, or `grep -rlFw` without rg); a short common name can match by accident, so a
referenced verdict is a lead, not a proof. `size` is `du -sk`; `newest_mtime` looks two levels deep.
  scan incomplete: du rc=<n>  `du` exited nonzero (an unreadable subtree: it still prints a partial total,
           which must not decide `unique` against `mixed`): same rule, `traversal: "incomplete: du rc=<n>"`
           unless a `scandir` failure is also present (that one is named); `bytes` stays as `du` printed it.
  scan incomplete: reference search rc=<n>  the `rg`/`grep` search exited above 1 (an error) or timed
           out (rc=124): the task is never `unique`, `mixed` or `scratch`, its record has
           `reference_search: "incomplete: rc=<n>"` (null otherwise), and the summary counts it under
           `bigteam.incomplete`. The exit status stays 0, as for an incomplete checkout.
  scan incomplete: scandir <ERRNO> <relative path>  a subtree of the task could not be listed, or its
           `CLAIM` or `jobs` could not be read or listed (it may hold the only report): same rule, the
           record has `traversal: "incomplete: scandir ..."` (null otherwise; the first failure by
           path), counted under `bigteam.incomplete`.

A --git-root or --ref-root that is not a directory (a --ref-root must also be searchable), and a --bigteam
that is not a directory or cannot be listed, is a usage error (exit 2) before anything is scanned.

Git checkout verdicts (a checkout is a dir holding `.git`, found up to two levels under each
--git-root, a repository nested inside a checkout included, symlinks not followed, deduplicated):
  unpushed commits  the upstream exists and HEAD is ahead of it; or origin lists the branch and HEAD
                    is ahead; or any local branch (or a detached HEAD) holds a commit that is on no
                    origin ref, whatever the origin state
  orphan branch     the branch is on no origin ref and HEAD has commits origin lacks
  dirty             modified or untracked non-ignored paths
  clean and pushed  none of the above: no commit on any local branch, local tag or on HEAD lies outside the
                    origin refs (the local `refs/remotes/origin/*`; with --remote, only origin's own live heads and tags)
  skipped: <reason>  a config key outside the allowlist, a redirected work tree, an unreadable
                    config or an unreadable `.git/HEAD` (`skipped: HEAD unreadable`: git does not
                    recognise the repository); nothing else was run
  scan incomplete: <call> rc=<n>  a git call (`status`, `rev-parse --abbrev-ref HEAD`, `rev-list
                    --count ...`, `for-each-ref`, `remote get-url origin`: only exit 2 "No such remote" means no origin) failed or timed out (rc=124); the state is unknown,
                    so the checkout is never `clean and pushed`; counts are null. `git status` gets
                    600 s, every other git call 60 s. A repository counts as unborn (no commit yet) only
                    when `refs/heads` and `refs/tags` hold nothing; a HEAD that names no ref while
                    refs exist is `scan incomplete: rev-parse --abbrev-ref HEAD rc=<n>`.
  scan incomplete: scandir <ERRNO>  a directory inside a --git-root could not be listed, or its `.git`
                    could not be inspected (a directory that is listable but not searchable), so
                    checkouts below it may be missing: one record for that dir (path, found_via,
                    counts null), counted under `checkouts.incomplete`; the exit status stays 0.
Local-only commits: `local_only_commits` is `git rev-list --count HEAD --exclude=refs/remotes/*
--exclude=refs/stash --all --not --remotes=origin` (a commit reachable only from a local tag, a note
(`refs/notes/*`) or any other local ref counts: the branch it was on may be reset or deleted; a
remote-tracking ref is no local work and the stash has its own count; with no origin remote nothing is
excluded, a leftover `refs/remotes/origin/*` ref proves nothing); with --remote and an answering `ls-remote` it is `--not <every live origin head and tag tip>`
alone (a tag origin has is not local-only; an annotated tag contributes its tag object and its peeled
commit): a stale local tracking ref of a live branch proves nothing (origin may have force-pushed it) and
one of a deleted branch is stale (a live tip whose objects are missing here excludes nothing, so the
count can only overcount; --fetch downloads those tips first). `local_only_verified` is true only when
--remote got a live `ls-remote` answer and no live tip is missing; false when it did and tips are still
missing, i.e. the count is an upper bound, and also when --remote asked and origin did not answer (the
count then trusts the local `refs/remotes/origin/*`, the only exclusion left: a stale tracking ref of a
deleted or force-pushed branch hides commits, so the count is an undercount); null (JSON) when --remote
was not given (the same trust in the local refs, a documented caveat, nothing was asked) and for a skipped
checkout. When it is above 0, `local_only_branches` is a
list of {branch, count}, one `rev-list --count` per local branch (a detached HEAD appears as branch `HEAD`),
then `local_only_tags` a list of {tag, count}, one per local tag; at most 100 refs are counted in all
(branches first), the rest in `local_only_branches_uncounted`: one extra git call per
checkout when nothing is local-only and at most 104 otherwise. The summary counts these as `with_local_only_commits`.
Extra flag `local-only commits: <branch> <n>, tag <tag> <n>, ...`: the same lists, first five refs.
With --remote, a local tag origin does not list (or lists at another object) whose commit origin does have is
in `local_only_tags` with count 0 (at most 100; the rest add to `local_only_branches_uncounted`, and a tag past
the counting budget is never listed as count 0) and flagged `unpushed tags` (a primary flag, counted in
`with_unpushed_work`: the tag, its annotation and signature are unpushed work) with `unpushed tag names: <names>`.
Extra flags `index-hidden paths: <n>` (record key `index_hidden`: tracked paths marked assume-unchanged or
skip-worktree, whose edits `status` cannot see) and `reflog-only commits: <n>` (`reflog_only_commits`: commits a
reset, amend or rebase left reachable from a reflog alone, stash entries excluded); both are primary flags.
Extra flag `detached`: HEAD is detached and commits lie outside origin; `origin unknown`: the branch
is not detached but origin's branch list could not be read at all (the verdict is `unpushed commits`,
never `clean and pushed`).
Primary flag `origin unreachable: local-only count unverified` (--remote only): `ls-remote` failed, so the
local `refs/remotes/origin/*` stood in for it; the checkout is never `clean and pushed` (`local_only_verified`
false), whatever the local refs say, since a stale tracking ref would hide commits.
Primary flag `origin url holds a credential or names a remote helper: not queried` (--remote only): the first `remote.origin.url` names a remote helper
(`<transport>::<address>`, or `<scheme>://` for a scheme git does not implement itself: git runs `git-remote-<name>` from
`PATH`, and `ext::` runs the command it is given; Codex pass 44) or has a
password, or (any scheme but ssh) a username or a query string (`https://user:secret@host/x`,
`https://<token>@github.com/x`, `https://host/x?private_token=...`; `ssh://git@host` and scp-like
`git@host:x` are usernames git never hands to a helper, so they are none; a `<transport>::<address>` prefix is
stripped and the address judged), so `ls-remote` is not run and `--fetch` does not fetch; the checkout is treated exactly like `origin
unreachable` (never `clean and pushed`, `local_only_verified` false). The url is in no record, flag, message
or doc, and the query cache is keyed by its sha256 prefix. For any other url `ls-remote` is run as `git
ls-remote --heads --tags -- origin` with the url in GIT_CONFIG_COUNT=1, GIT_CONFIG_KEY_0=remote.origin.url,
GIT_CONFIG_VALUE_0=<url> (git 2.31+): never in argv, where any process could read it; an older git is not
asked (`origin unreachable`, one line on stderr). `--fetch` runs inside the checkout as `fetch origin`.
Extra flag `submodules not inspected`: the checkout has submodules; `status` ignores their state, so
the verdict says nothing about them (it is that flag, not `clean and pushed`, when nothing else applies)
and the capture plan always lists the checkout, with one quoted command set per path in the record's `submodules_vetted`.
Extra flag `origin tip not fetched`: the branch is on origin at a commit this checkout cannot
compare with HEAD (add --fetch); `ahead_of_origin` then still counts those commits.
Flag `origin tips not fetched: <n>` (--remote): n live origin tips whose objects are not here (the
checkout is behind origin, or origin was force-pushed, on those branches; add --fetch). It is a primary
flag: the verdict is never `clean and pushed` while any is missing. Presence and type come from `git cat-file
--batch-check`: a tag whose peeled object is a tree or a blob (git.git `junio-gpg-pub`, linux `v2.6.11-tree`)
reaches no commit, so it is neither counted missing nor fetched (a tip whose commit is really absent still
counts, and --fetch clears it).
--remote trusts origin's answer as given: a lying origin can hide any local commit by naming it as a branch,
tag or peeled tip.
Flag `origin advertised invalid ref names: <n>` (--remote, `invalid_origin_refs` in the record): n entries
of origin's answer dropped because their name is not one git creates (`:`, `..`, a control character,
...) or their object id is malformed or all zeros. They are never used in a fetch refspec, so a hostile
origin cannot make --fetch write a local ref. It is a primary flag: never `clean and pushed`.
A checkout with no `origin` remote at all has every commit "ahead of origin": it is an orphan
branch and carries the extra flag `no origin remote`. `stash`, `no origin remote`, `detached` and
`origin unknown` are flags, never a primary verdict.
The primary verdict is the first that applies in that order; `flags` lists every one. A skipped
checkout has no counts (null) and `config_keys` names the offending keys, never their values. `--markdown`
cells show every control character (newline, a bare CR, tab, ...) as backslash text, never the raw byte.
Limits of what is read (2026-10-23): `git ls-remote` output is read in chunks up to LS_REMOTE_MAX_BYTES (16 MiB); a
longer advertisement kills the process and reads as an origin that did not answer (`origin unreachable`), never as the
refs seen so far. A `rev-list --count HEAD --not --remotes=origin <tip>` that fails for any reason except git
naming the tip object missing is `scan incomplete: rev-list ... rc=<n>`, never `origin tip not fetched`.

Exit codes: 0 scan completed; 2 usage error. Pass --json for machine-readable output.
"""
from __future__ import annotations

import argparse
import errno
import json
import os
import re
import atexit
import hashlib
import shutil
import selectors
import signal
import stat
import unicodedata
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from urllib.parse import urlsplit

REPORT_DEPTH = 3
MTIME_DEPTH = 2
GIT_SCAN_DEPTH = 2
SKIP_DIRS = {".git", "node_modules", "__pycache__", ".venv", "target"}
# Always excluded from the "is this task name cited" search; --exclude adds to this list.
DEFAULT_EXCLUDES = ["ade-everywhere-phase0-scan-*"]
SKIP_UNREADABLE = "skipped: git config unreadable"
SKIP_WORKTREE = "skipped: worktree redirected"
SKIP_NO_WORKTREE = "skipped: no work tree"
SUBMODULES_FLAG = "submodules not inspected"
SKIP_HEAD_UNREADABLE = "skipped: HEAD unreadable"
SKIP_GIT_SYMLINK = "skipped: .git is a symlink"
SKIP_COMMONDIR = "skipped: git dir redirected (commondir)"
MAX_TIPS = 2000  # ls-remote tips passed as `--not` arguments (argv size); extra tips only overcount
LS_REMOTE_MAX_BYTES = 16 * 1024 * 1024  # what `ls-remote` may print before the answer is refused (a few hundred thousand refs)
MAX_BRANCH_COUNTS = 100  # `rev-list --count` calls for the per-branch report; the rest are only summed
# Flags that qualify a verdict but never are one.
INFO_FLAGS = ("stash", "no origin remote", "detached", "origin unknown")
ORIGIN_UNREACHABLE = "origin unreachable: local-only count unverified"  # primary: --remote got no answer
ORIGIN_CREDENTIAL = "origin url holds a credential or names a remote helper: not queried"  # primary: treated like ORIGIN_UNREACHABLE
MIN_GIT_ENV_CONFIG = (2, 31)  # GIT_CONFIG_COUNT / _KEY_n / _VALUE_n: how `ls-remote` gets the url
TIPS_NOT_FETCHED = "origin tips not fetched: "  # flag + count: live tips whose objects are not here
INVALID_REFS = "origin advertised invalid ref names: "  # flag + count: ls-remote entries git would refuse
INCOMPLETE_PREFIX = "scan incomplete: "
STATUS_TIMEOUT = 600  # `git status` on a large or cold tree under load; every other git call gets 60 s
NO_SUCH_REMOTE_RC = 2  # `git remote get-url origin` on a repository without origin: exit 2, "error: No such remote 'origin'"
MODULE_INTERNAL_DIRS = ("objects", "refs", "logs", "hooks", "lfs")  # pruned inside a module's git dir
# Prefix of every git call: no index lock, and the config-named programs that run on any command off
# (log.showSignature=false: `stash list` / `log` would run gpg.program on a signed commit otherwise).
GIT_SAFE = ["--no-optional-locks", "-c", "core.fsmonitor=false", "-c", "core.hooksPath=/dev/null",
            "-c", "protocol.ext.allow=never", "-c", "log.showSignature=false",
            "-c", "advice.graftFileDeprecated=false"]  # GIT_GRAFT_FILE below would print a `hint:` on every call
# Allowlist of the checkout's own config (local and worktree scope), 2026-10-20 (adversary round 2,
# R2-1: the deny list missed three paths in two rounds). Keys are lower-cased on section and variable,
# the subsection is kept verbatim. Anything else, `core.worktree` included, makes the checkout skipped.
# None of these runs a program: no gpg.*, filter.*, diff.*, credential.*, alias.*, url.*, include.*,
# core.sshCommand / hooksPath / pager / editor, fetch.recurseSubmodules, remote.*.uploadpack.
SAFE_CONFIG = frozenset({
    "core.repositoryformatversion", "core.filemode", "core.bare", "core.logallrefupdates",
    "core.ignorecase", "core.precomposeunicode", "core.symlinks", "core.autocrlf", "core.eol",
    "core.safecrlf", "core.quotepath", "core.excludesfile", "core.sparsecheckout",
    "core.sparsecheckoutcone", "core.untrackedcache", "core.fsmonitor",  # fsmonitor: true/false only
    "user.name", "user.email", "user.signingkey", "commit.gpgsign",  # a key id: executes nothing
    "extensions.worktreeconfig", "extensions.objectformat", "extensions.refstorage",
    "submodule.active", "pull.rebase", "pull.ff", "push.default", "push.autosetupremote",
    "merge.conflictstyle", "rerere.enabled", "status.showuntrackedfiles",  # status gets the flag too
    "lfs.repositoryformatversion"})
# section -> variables allowed under any subsection (remote.<name>.url, branch.<name>.merge, ...)
SAFE_SUBSECTION_CONFIG = {
    "remote": frozenset({"url", "pushurl", "fetch", "tagopt", "prune", "promisor",
                         "partialclonefilter", "gh-resolved"}),
    "branch": frozenset({"remote", "merge", "rebase", "pushremote", "gh-merge-base",
                         "vscode-merge-base"}),
    "submodule": frozenset({"url", "active", "ignore"}),
    "lfs": frozenset({"access"})}


def git_env(network: bool = False) -> dict:
    """The caller's environment minus every GIT_* key, plus this tool's own; no global/system config."""
    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
    # GIT_NO_LAZY_FETCH (git 2.45+): a partial clone must not download objects on a count/compare;
    # it stays set for the explicit --fetch too (that one is a real fetch and needs no lazy help).
    # GIT_NO_REPLACE_OBJECTS: a `refs/replace/*` entry can make origin's tip appear to contain a local commit, so
    # every count would read the fake graph (adversary round 31 on PR 27); GIT_GRAFT_FILE: a `.git/info/grafts`
    # line does the same with no ref at all, so `--all` sees nothing (round 32); the counts read the real objects
    env.update({"GIT_TERMINAL_PROMPT": "0", "GIT_OPTIONAL_LOCKS": "0", "GIT_CONFIG_NOSYSTEM": "1",
                "GIT_CONFIG_GLOBAL": os.devnull, "GIT_NO_LAZY_FETCH": "1", "GIT_NO_REPLACE_OBJECTS": "1",
                "GIT_GRAFT_FILE": os.devnull, "GIT_ADVICE": "0", "LC_ALL": "C"})
    if network:
        env.pop("SSH_ASKPASS", None)
        env.update({"GIT_SSH_COMMAND": "ssh -o BatchMode=yes",
                    "GIT_ALLOW_PROTOCOL": "file:git:http:https:ssh"})
    return env


RC_OUTPUT_CAP = 75  # `run(max_bytes=...)`: the child printed more than the cap, was killed, and nothing it printed is kept


def read_capped(p: subprocess.Popen, timeout: float, max_bytes: int) -> tuple[bytes | None, int | None]:
    """(stdout, None) when the child closed stdout within `timeout` seconds and `max_bytes`; else (None, rc) where rc is
    124 (time) or RC_OUTPUT_CAP (size). Reads in chunks and checks each before keeping it, so never more than `max_bytes`
    is held; the caller kills the child on a None."""
    deadline = time.monotonic() + timeout
    chunks: list[bytes] = []
    held = 0
    fd = p.stdout.fileno()
    with selectors.DefaultSelector() as sel:
        sel.register(fd, selectors.EVENT_READ)
        while True:
            left = deadline - time.monotonic()
            if left <= 0:
                return None, 124
            if not sel.select(left):
                continue
            chunk = os.read(fd, 65536)
            if not chunk:
                return b"".join(chunks), None
            if held + len(chunk) > max_bytes:
                return None, RC_OUTPUT_CAP
            chunks.append(chunk)
            held += len(chunk)


def run(argv, timeout=120, cwd=None, env=None, stdin_text=None, errors="replace", err=None, max_bytes=None):
    """argv list in, (rc, stdout); never raises on a missing tool or timeout. `errors` is the stdout decoding
    (`surrogateescape` when a path in it is tested against the filesystem: `replace` would test a different name).

    stdin is /dev/null (or `stdin_text`, written whole) and the child leads its own process group, so a
    timeout kills git together with the ssh / git-remote-https children it started.

    stderr is discarded unless `err` is a list: the text is then appended to it (empty after a timeout).

    `max_bytes` (not with `stdin_text` or `err`) bounds what is read from a child whose output size the caller does not
    control (an origin's ref advertisement): past it the process group is killed and the result is (RC_OUTPUT_CAP, "")."""
    capped = max_bytes is not None
    if capped and (stdin_text is not None or err is not None):
        raise ValueError("max_bytes is for a child with no stdin text and no stderr capture")
    try:
        p = subprocess.Popen(argv, stdin=subprocess.DEVNULL if stdin_text is None else subprocess.PIPE,
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL if err is None else subprocess.PIPE,
                             cwd=cwd, env=env, start_new_session=True)
    except OSError:
        return 124, ""
    if capped:
        out_b, bad_rc = read_capped(p, timeout, max_bytes)
        if out_b is None:
            try:
                os.killpg(p.pid, signal.SIGKILL)
            except OSError:
                pass
            p.stdout.close()
            p.wait()
            return bad_rc, ""
        p.stdout.close()
        try:
            p.wait(timeout=5)  # stdout is closed: the child is exiting
        except subprocess.TimeoutExpired:
            try:
                os.killpg(p.pid, signal.SIGKILL)
            except OSError:
                pass
            p.wait()
            return 124, ""
        return p.returncode, out_b.decode("utf-8", errors)
    try:
        # bytes both ways, decoded here: text mode turns a CR in a path into a newline (adversary round 57, LOW 2)
        out_b, err_b = p.communicate(input=None if stdin_text is None else stdin_text.encode("utf-8", "surrogateescape"),
                                     timeout=timeout)
        out = out_b.decode("utf-8", errors)
        if err is not None:
            err.append((err_b or b"").decode("utf-8", "replace"))
    except subprocess.TimeoutExpired:
        try:
            os.killpg(p.pid, signal.SIGKILL)
        except OSError:
            pass
        p.communicate()
        return 124, ""
    return p.returncode, out


def du_bytes(path: Path) -> tuple[int, int | None]:
    """(bytes as reported, None) or (bytes as reported, rc) when `du` failed: an unreadable subtree makes
    `du` exit nonzero yet print a partial total, so only rc 0 is a complete number (Codex pass 6)."""
    rc, out = run(["du", "-sk", str(path)], timeout=900)
    nbytes = 0
    if out.split():
        try:
            nbytes = int(out.split()[0]) * 1024
        except ValueError:
            if rc == 0:
                rc = 65  # exited 0 but printed no size: not an answer
    elif rc == 0:
        rc = 65
    return nbytes, (rc or None)


def git_entry_mode(path: Path) -> int | None:
    """lstat mode of `path/.git`, None when there is none. lstat is used instead of `Path.exists()`,
    which since Python 3.13 turns any OSError into False: only ENOENT/ENOTDIR mean "no .git here";
    any other error (EACCES on a directory that is listable but not searchable) is raised."""
    try:
        return os.lstat(path / ".git").st_mode
    except (FileNotFoundError, NotADirectoryError):
        return None


def is_checkout(path: Path) -> bool:
    """True when `path` holds a `.git` that is not a symlink (a symlinked one is a checkout the scan refuses:
    discovery lists it and `scan_checkout` records SKIP_GIT_SYMLINK, Codex pass 38)."""
    mode = git_entry_mode(path)
    return mode is not None and not stat.S_ISLNK(mode)


def errno_name(exc: OSError) -> str:
    return errno.errorcode.get(exc.errno, "EIO") if exc.errno else "EIO"


def walk(path: Path, depth: int, skip_checkouts: bool = True,
         failures: list[tuple[Path, str]] | None = None):
    """Yield file paths up to `depth` levels below path.

    A directory that cannot be listed is appended to `failures` as (path, errno name) when the caller
    passes a list; it is never silently dropped from what the caller concludes (adversary/Codex pass 5)."""
    try:
        entries = list(os.scandir(path))
    except OSError as exc:
        if failures is not None:
            failures.append((Path(path), errno_name(exc)))
        return
    for e in entries:
        try:
            if e.is_symlink():
                continue
            if e.is_dir(follow_symlinks=False):
                if e.name in SKIP_DIRS or depth <= 1:
                    continue
                if skip_checkouts and is_checkout(Path(e.path)):
                    continue
                yield from walk(Path(e.path), depth - 1, skip_checkouts, failures)
            elif e.is_file(follow_symlinks=False):
                yield Path(e.path)
        except OSError as exc:
            if failures is not None:
                failures.append((Path(e.path), errno_name(exc)))


def newest_mtime(path: Path) -> float:
    best = 0.0
    try:
        best = path.stat().st_mtime
    except OSError:
        return best
    for f in walk(path, MTIME_DEPTH + 1, skip_checkouts=False):
        try:
            best = max(best, f.lstat().st_mtime)
        except OSError:
            pass
    try:
        for e in os.scandir(path):
            try:
                best = max(best, e.stat(follow_symlinks=False).st_mtime)
            except OSError:
                pass
    except OSError:
        pass
    return best


def claim_state(task: Path, failures: list[tuple[Path, str]] | None = None) -> str:
    claim = task / "CLAIM"
    try:
        lines = [ln.strip() for ln in claim.read_text(errors="replace").splitlines() if ln.strip()]
    except (FileNotFoundError, NotADirectoryError):
        return "no CLAIM"
    except OSError as exc:
        if failures is not None:
            failures.append((claim, errno_name(exc)))
        return "no CLAIM"
    return "DONE" if lines and lines[-1].startswith("DONE") else "open"


def open_job_records(task: Path, failures: list[tuple[Path, str]] | None = None) -> list[str]:
    jobs = task / "jobs"
    try:
        names = sorted(e.name for e in os.scandir(jobs) if e.name.endswith(".json"))
    except (FileNotFoundError, NotADirectoryError):
        return []
    except OSError as exc:
        if failures is not None:
            failures.append((jobs, errno_name(exc)))
        return []
    out = []
    for name in names:
        try:
            data = json.loads((jobs / name).read_text(errors="replace"))
        except (OSError, ValueError):
            out.append(f"{name} (unreadable)")
            continue
        if isinstance(data, dict) and "closed" not in data:
            out.append(name)
    return out


def report_files(task: Path, failures: list[tuple[Path, str]] | None = None) -> list[dict]:
    found = []
    for f in walk(task, REPORT_DEPTH + 1, failures=failures):
        n = f.name
        if n.endswith(".md") and "report" in n.lower():
            try:
                size = f.stat().st_size
            except OSError as exc:
                if failures is not None:
                    failures.append((f, errno_name(exc)))
                continue
            found.append({"path": str(f.relative_to(task)), "bytes": size,
                          "done": Path(str(f) + ".done").exists()})
    return sorted(found, key=lambda r: r["path"])


def referenced(name: str, ref_roots: list[Path], exclude: list[str]) -> tuple[list[str], int | None]:
    """(files under a ref root that mention `name`, None) or ([], rc) when the search itself failed.

    rg and grep exit 1 for "no match" and above 1 for an error (an unreadable root, a bad pattern);
    `run` returns 124 for a timeout or a missing tool. Only 0 and 1 are answers."""
    # every --ref-root was checked to be a listable directory in main(); one that vanished since
    # makes rg/grep exit 2, which is `scan incomplete`, never a silent drop from the search
    roots = [str(r) for r in ref_roots]
    if not roots:
        return [], None
    globs = [*DEFAULT_EXCLUDES, *exclude]
    if shutil.which("rg"):
        argv = ["rg", "-l", "-F", "-w", "--no-messages"]
        for g in globs:
            argv += ["-g", f"!{g}"]
        argv += ["--", name, *roots]
    else:
        argv = ["grep", "-rlFw", *[f"--exclude={g}" for g in globs], "--", name, *roots]
    rc, out = run(argv, timeout=120)
    if rc == 0:
        return out.split("\n")[:-1], None
    return ([], None) if rc == 1 else ([], rc)


def top_children(task: Path, n: int = 4) -> list[dict]:
    kids = []
    try:
        entries = list(os.scandir(task))
    except OSError:
        return kids
    for e in entries:
        kids.append({"name": e.name + ("/" if e.is_dir(follow_symlinks=False) else ""),
                     "bytes": du_bytes(Path(e.path))[0]})
    return sorted(kids, key=lambda k: -k["bytes"])[:n]


def scan_bigteam(root: Path, ref_roots: list[Path], exclude: list[str], unique_max: int,
                 top: int) -> dict:
    tasks = []
    for e in sorted(os.scandir(root), key=lambda e: e.name):
        if not e.is_dir(follow_symlinks=False):
            continue
        task = Path(e.path)
        size, du_rc = du_bytes(task)
        traversal: list[tuple[Path, str]] = []
        reports = report_files(task, traversal)
        claim = claim_state(task, traversal)
        open_jobs = open_job_records(task, traversal)
        refs, search_rc = referenced(task.name, ref_roots, exclude) if reports else ([], None)
        traversal_note = None
        if traversal or du_rc is not None:
            # a subtree that could not be listed may hold the only report, and a `du` that failed
            # printed a partial total that could slip under --unique-max-bytes: never `scratch`/`unique`/`mixed`
            if traversal:
                bad, err = min(traversal)  # scandir order is arbitrary: the first by path
                where = " ".join(os.path.relpath(bad, task).split("\n"))
                reason = f"scandir {err} {where}"
            else:
                reason = f"du rc={du_rc}"
            traversal_note = f"incomplete: {reason}"
            verdict, unique_bytes = f"{INCOMPLETE_PREFIX}{reason}", 0
        elif search_rc is not None:
            # the search did not run to an answer: never read it as "unreferenced" (unique/mixed)
            # or as "nothing to keep" (scratch)
            verdict, unique_bytes = f"{INCOMPLETE_PREFIX}reference search rc={search_rc}", 0
        elif not reports or refs:
            verdict, unique_bytes = "scratch", 0
        else:
            unique_bytes = sum(r["bytes"] for r in reports)
            verdict = "unique" if size <= unique_max else "mixed"
        tasks.append({
            "task": task.name, "bytes": size, "newest_mtime": newest_mtime(task),
            "claim": claim, "reports": reports,
            "open_job_records": open_jobs, "referenced_in": refs[:5],
            "verdict": verdict, "unique_bytes": unique_bytes,
            "reference_search": None if search_rc is None else f"incomplete: rc={search_rc}",
            "traversal": traversal_note,
        })
    for t in sorted(tasks, key=lambda t: -t["bytes"])[:top]:
        t["fills"] = top_children(root / t["task"])
    loose = [e.name for e in os.scandir(root) if not e.is_dir(follow_symlinks=False)]
    # abspath, not resolve: the rows rendered from this must not depend on the cwd of the scan (adversary
    # round 20, LOW 4b); symlinks stay as typed
    return {"root": os.path.abspath(root), "tasks": tasks, "loose_files": loose}


def find_checkouts(root: Path, failures: list[tuple[Path, str]] | None = None) -> list[Path]:
    """Checkouts up to GIT_SCAN_DEPTH levels under `root`, repositories nested inside a checkout included
    (not its `.git` or dependency directories); a directory that cannot be listed goes to `failures` as
    (path, errno name) instead of reading as "no checkouts"."""
    found = []

    def fail(p: Path, exc: OSError):
        if failures is not None:
            failures.append((p, errno_name(exc)))

    def rec(p: Path, depth: int):
        try:
            # a symlinked `.git` counts too: git would read a git directory elsewhere, so the directory is a checkout
            # the scan refuses (`skipped: .git is a symlink`, with the whole-directory fallback), never an ordinary
            # directory that leaves no record (Codex pass 38 on PR 27)
            checkout = git_entry_mode(p) is not None
        except OSError as exc:  # .git cannot be inspected: a checkout in here may be missing
            fail(p, exc)
            return
        if checkout:
            found.append(p)
            # and keep going: an ordinary repository nested inside a checkout (not a submodule, which is a
            # `.git` file plus `core.worktree` and is skipped as such) holds its own work (Codex pass 22 on PR 27)
        if depth == 0:
            return
        try:
            kids = sorted(os.scandir(p), key=lambda e: e.name)
        except OSError as exc:
            fail(p, exc)
            return
        for e in kids:
            if checkout and e.name in SKIP_DIRS:
                continue  # `.git` itself and dependency trees inside a checkout
            try:
                if e.is_dir(follow_symlinks=False):  # a link may lead anywhere: name that root instead
                    rec(Path(e.path), depth - 1)
            except OSError as exc:
                fail(Path(e.path), exc)

    rec(root, GIT_SCAN_DEPTH)
    return found


def git(path: Path, *args, timeout=60, network=False, stdin_text=None, errors="replace", operator_config=False, err=None):
    kw = {} if stdin_text is None else {"stdin_text": stdin_text}
    if err is not None:
        kw["err"] = err
    if errors != "replace":  # the default stays implicit: tests substitute `run` with fakes that take no `errors`
        kw["errors"] = errors
    env = git_env(network)
    if operator_config:
        # the push the plan prints runs in the operator's shell, where their global and system config (a
        # `url.<base>.pushInsteadOf` among it) applies; only read-only config commands may ask for this (Codex pass 46)
        for k in ("GIT_CONFIG_GLOBAL", "GIT_CONFIG_NOSYSTEM"):
            env.pop(k, None)
        # and the operator's own config variables, as their shell would have them (adversary round 52 on PR 27, LOW)
        env.update({k: v for k, v in os.environ.items()
                    if k in ("GIT_CONFIG_GLOBAL", "GIT_CONFIG_SYSTEM", "GIT_CONFIG_NOSYSTEM", "GIT_CONFIG_PARAMETERS",
                             "GIT_CONFIG_COUNT") or k.startswith(("GIT_CONFIG_KEY_", "GIT_CONFIG_VALUE_"))})
    return run(["git", *GIT_SAFE, "-C", str(path), *args], timeout=timeout, env=env, **kw)


def key_is_safe(key: str, value: str, in_submodule: bool = False) -> bool:
    """True when this config entry is on the allowlist (see SAFE_CONFIG)."""
    parts = key.split(".")
    section, var = parts[0].lower(), parts[-1].lower()
    if len(parts) < 2:
        return False
    if section == "core" and var == "fsmonitor":
        return len(parts) == 2 and value in ("true", "false")
    if in_submodule and key.lower() == "core.worktree":  # git itself writes it into every module
        return True
    if len(parts) == 2:
        return f"{section}.{var}" in SAFE_CONFIG
    return var in SAFE_SUBSECTION_CONFIG.get(section, ())


def config_offenders(entries, in_submodule: bool = False) -> list[str]:
    """Names (never values) of the entries that are not on the allowlist, first seen first."""
    bad: list[str] = []
    for key, value in entries:
        if not key_is_safe(key, value, in_submodule):
            first, *middle, last = key.split(".") if "." in key else [key, key]
            mid = ".".join(middle)
            if re.search(r"[@?#]|%(?:3[Ff]|23|40)", mid):
                # a url's userinfo or query is part of the KEY (`url.https://u:token@host/.insteadOf`): the name is reported,
                # never the secret in it (Codex pass 54 on PR 27, P1)
                middle = ["<redacted>"]
            name = ".".join([first.lower(), *middle, last.lower()]) if "." in key else key
            if name not in bad:
                bad.append(name)
    return bad


def unsafe_config(path: Path) -> list[str] | None:
    """Names of the checkout's own config keys (local and worktree scope) that are not on the
    allowlist, never their values; None when the config cannot be read. Reading it executes nothing."""
    rc, out = git(path, "config", "--list", "--show-scope", "--includes", "-z")
    if rc != 0:
        return None
    tokens = out.split("\0")
    entries = []
    for scope, entry in zip(tokens[0::2], tokens[1::2]):
        if scope in ("local", "worktree"):
            key, _, value = entry.partition("\n")
            entries.append((key, value))
    return config_offenders(entries)


def git_common_dir(path: Path) -> Path | None:
    rc, out = git(path, "rev-parse", "--git-common-dir")
    return (path / out.strip()).resolve() if rc == 0 and out.strip() else None


# characters a terminal draws as nothing or as something else that the categories below do not name (adversary
# round 46: U+00AD, U+034F, the Hangul fillers, U+180E, the variation selectors, the tag characters)
INVISIBLE_RANGES = ((0x00A0, 0x00A0), (0x00AD, 0x00AD), (0x034F, 0x034F), (0x115F, 0x1160), (0x180E, 0x180E),
                    (0x2060, 0x206F), (0x3164, 0x3164), (0xFE00, 0xFE0F), (0xFFA0, 0xFFA0), (0xFFF9, 0xFFFB),
                    (0xE0000, 0xE007F), (0xE0100, 0xE01EF))
INVISIBLE_CATEGORIES = ("Cc", "Cf", "Cs", "Co", "Cn", "Zs", "Zl", "Zp")  # `Zs` holds the ASCII space too


def unusual_char(c: str) -> bool:
    """A character that a terminal draws as something else, or not at all: a C0, DEL or C1 control, a Unicode line or
    paragraph separator, a zero-width, joiner, bidi-control, filler, variation-selector or tag character, a BOM, any
    space (ASCII whitespace included), a private-use or unassigned code point, or a non-UTF-8 byte (a lone
    surrogate). Defence in depth: the plan runs git only at vetted, quoted paths and shows no listing of
    `.gitmodules`, so a spoofed display no longer reaches the human (round 47)."""
    o = ord(c)
    return (o < 32 or 127 <= o < 160 or 0x2028 <= o <= 0x2029 or 0x200B <= o <= 0x200F or 0x202A <= o <= 0x202E
            or 0x2066 <= o <= 0x2069 or o == 0xFEFF or 0xD800 <= o <= 0xDFFF
            or any(lo <= o <= hi for lo, hi in INVISIBLE_RANGES) or unicodedata.category(c) in INVISIBLE_CATEGORIES)


def unusual_path(p: str) -> bool:
    """A submodule path the plan will not name: an unusual character (a space and a non-UTF-8 byte included) or a
    quote, which a quoted shell command and a markdown cell could still render in a way no one expects."""
    return any(unusual_char(c) or c in "'\"" for c in p)


MAX_ALTERNATES_SHOWN = 3
ALTERNATES_KEY = "(alternates)"  # the `submodule config unrecognised` reason of a module with a nonempty objects/info/alternates


def alternates_lines(data: bytes) -> list[str]:
    """The entries of an `objects/info/alternates` file as git reads it: one per line, blank and `#` lines ignored."""
    return [ln.decode("utf-8", "surrogateescape") for ln in data.split(b"\n") if ln and not ln.startswith(b"#")]


def alternates_targets(common: Path | None) -> list[str]:
    """The first MAX_ALTERNATES_SHOWN entries (git's own reading: one per line, blank lines and `#` lines ignored) of
    the nonempty `objects/info/alternates` files under `<common>/modules`, in sorted git-dir order, as text (a byte that
    is not UTF-8 stays a lone surrogate, as in every path of the record). Nothing is followed: a symlink or a file that
    is not a small regular file is skipped, so the list may be shorter than the files hold; empty means unknown."""
    found: list[str] = []
    if common is None:
        return found
    for root, dirs, _ in os.walk(common / "modules", followlinks=False):
        dirs[:] = sorted(d for d in dirs if d not in MODULE_INTERNAL_DIRS)
        try:
            data = read_regular_file(Path(root) / "objects" / "info" / "alternates", 64 * 1024)
        except (OSError, ValueError):
            continue
        found += alternates_lines(data)
        if len(found) >= MAX_ALTERNATES_SHOWN:
            return found[:MAX_ALTERNATES_SHOWN]
    return found


LINKED_STORE_MEMBERS = ("objects", "refs", "packed-refs")  # a symlink at any of these keeps the history at the link's target


def git_dir_redirected(path: Path) -> bool:
    """True when `<path>/.git` is a directory holding a `commondir` entry (any kind, a FIFO or a dangling link included):
    git then reads the objects, refs and config of the git directory it names, wherever that is (Cursor security review
    on PR 27, MEDIUM). A linked worktree's `.git` is a gitfile, never a directory, so it is not affected."""
    try:
        if not stat.S_ISDIR(os.lstat(path / ".git").st_mode):
            return False
    except OSError:
        return False
    return os.path.lexists(path / ".git" / "commondir")


def top_stores(path: Path) -> tuple[list[str] | None, list[str]]:
    """(alternates, linked_stores) of the checkout's own common git dir. `alternates`: None when it has no nonempty
    `objects/info/alternates`, else the first MAX_ALTERNATES_SHOWN targets (empty: the file is nonempty but unreadable, too
    big or only comments, or ANY error reading what leads to it was raised after `.git` was found: the generic warning
    stands, never silence; adversary round 65, INFO 1). `linked_stores`: `<member> -> <resolved target>` for each of
    `objects`, `refs` and `packed-refs` of the common dir that is a symlink (git-new-workdir, objects moved to another
    disk: `whole.tar` and the git-dir archive keep the link only), plus `commondir -> <dir>` for a `.git` directory whose
    `commondir` names another git dir (adversary round 65, LOW 2). Runs no git: the common dir is found by reading `.git`
    (a directory, or a one-line gitfile whose git dir may hold a `commondir`), so it also works for a checkout the scan
    refused before it trusted any git call. A `.git` symlink is not followed (`skipped: .git is a symlink` has the
    whole-directory row for it). A store such a checkout borrows from is archived by neither `whole.tar` nor the git-dir
    archive (a `bundle create` reads through it, so a bundle row is not affected)."""
    dotgit = path / ".git"
    try:
        mode = os.lstat(dotgit).st_mode
    except OSError:
        return None, []  # no `.git` entry at all: nothing was found
    linked: list[str] = []
    try:
        if stat.S_ISREG(mode):
            raw = read_regular_file(dotgit, 64 * 1024)
            rel = raw[len(b"gitdir: "):].rstrip(b"\r\n")
            if not raw.startswith(b"gitdir: ") or not rel or b"\n" in rel or b"\0" in rel:
                return None, []  # git does not take this for a repository either
            gitdir = Path(os.fsdecode(os.path.realpath(os.path.join(os.fsencode(path), rel))))
        elif stat.S_ISDIR(mode):
            gitdir = dotgit
        else:
            return None, []
        try:
            link = read_regular_file(gitdir / "commondir", 64 * 1024).rstrip(b"\r\n")
            common = Path(os.fsdecode(os.path.realpath(os.path.join(os.fsencode(gitdir), link)))) if link else gitdir
            if stat.S_ISDIR(mode) and common != Path(os.path.realpath(gitdir)):
                linked.append(f"commondir -> {common}")
        except FileNotFoundError:
            common = gitdir
        for member in LINKED_STORE_MEMBERS:
            if os.path.islink(common / member):
                linked.append(f"{member} -> {os.path.realpath(common / member)}")
        alternates = common / "objects" / "info" / "alternates"
        try:
            if os.path.getsize(alternates) == 0:  # what the module check asks: a symlink is followed, as git does
                return None, linked
        except (FileNotFoundError, NotADirectoryError):
            return None, linked
        return alternates_lines(read_regular_file(alternates, 64 * 1024))[:MAX_ALTERNATES_SHOWN], linked
    except (OSError, ValueError):
        return [], linked


def submodule_config_check(path: Path, common: Path | None) -> tuple[bool, str | None, list[str]]:
    """(has submodules, first config key of any submodule's git dir outside the allowlist, or a parenthesised
    reason the git dir cannot be vetted, the sorted submodule paths the scan vetted).

    Reads `<git-common-dir>/modules/**/config` and `config.worktree` with `git config --file`, which executes
    nothing. The plan then tells the human to run git inside each vetted submodule, so anything that would make git read
    its config elsewhere ends the check with a reason instead (Codex passes 37 and 38, adversary round 42): a
    symlink anywhere under `modules/` (`os.walk` never descends into one, so its config would go unread) or at a
    submodule's `.git`, a `commondir` file (the module's config and objects are in another directory), and a
    submodule whose `.git` is a directory or a gitfile naming a git dir the walk did not vet (`(gitdir outside
    modules)`: outside `modules/`, or inside a pruned `objects/`). The submodule paths checked are the index
    gitlinks and the `.gitmodules` paths together (a listed path that is not a gitlink but has a `.git` is
    `(gitmodules path not a gitlink)`); the gitfile is parsed as git
    parses it (the whole file after `gitdir: `, trailing line breaks dropped), and one git would read differently
    from the plan's one-line parse (a second line, an embedded CR, a NUL) is `(gitdir unreadable)` (adversary round 43,
    44). A `.gitmodules` path that is absolute, empty or holds `..` is `(gitmodules path unusual)` (the kernel follows
    a symlink before `..`, a lexical normpath does not), a submodule path whose resolved location is not the
    superproject's resolved path plus the entry (a symlink component: `git -C` would run elsewhere) is `(symlink)`,
    and an entry of a module git dir that differs from `HEAD`, `config`, `config.worktree` or `commondir` only in
    letter case (a case-insensitive file system opens it as that name, the exact-name walk never read it) is
    `(unrecognised entry)` (round 44); so is any name the file system itself opens as one of those (`lexists` of the
    exact name when the listing lacks it: APFS folds the `ﬁ` ligature and the Kelvin sign, which `str.lower` does not,
    round 45). A `.gitmodules` entry whose key or value holds an unusual character (`unusual_char`: a control, any
    space, a zero-width, joiner, filler, variation-selector, tag or bidi character, a non-UTF-8 byte), and any
    submodule path (gitlink or listed) that holds one or a quote, is `(gitmodules path unusual)`: the plan names
    submodule paths itself, quoted, from the third result below, but a path no one can read or retype as it is
    stays out of it (rounds 45 and 46, defence in depth since round 47).
    The third result is the sorted list of vetted submodule paths (record key `submodules_vetted`): every path
    of the gitlink and `.gitmodules` union that passed every check and has a `.git` gitfile naming a vetted git dir,
    a real checked-out submodule, which is the only place the plan runs git. A de-initialised, empty directory
    is not in it (nothing to capture there beyond the `modules/` archive).
    A submodule with no `.git` at all (de-initialised, never initialised) is an empty directory the plan's guard
    refuses; one holding files but no `.git` is `(submodule has files but no .git)`, so the whole-directory
    archive keeps them."""
    modules = common / "modules" if common else None
    present = (path / ".gitmodules").exists() or bool(modules and modules.is_dir())
    if not present:
        return False, None, []
    env = git_env()
    env["GIT_CEILING_DIRECTORIES"] = str(Path(neutral_cwd()).parent)
    # `Path.is_dir()` and `os.walk`'s start directory follow a symlink at `modules` itself (or at a parent of it), so
    # configs under the target would be vetted and a gitfile naming `../.git/modules/sub` would match the outside
    # directory (Cursor security review on PR 27, 2026-10-23): the resolved path must be the resolved common dir
    # plus `modules`
    if modules and (modules.is_symlink() or (modules.exists() and os.path.realpath(modules)
                                              != os.path.join(os.path.realpath(common), "modules"))):
        return True, "(symlink)", []

    def internal_symlink(gitdir: str) -> bool:
        """A symlink anywhere in a module git dir's pruned object store, refs, logs, hooks or lfs: `modules.tar`
        (no dereference) would archive the link, not the commits at its target (Codex pass 41, P1)."""
        for name in MODULE_INTERNAL_DIRS:
            for r, ds, fs in os.walk(os.path.join(gitdir, name), followlinks=False):
                if any(os.path.islink(os.path.join(r, x)) for x in ds + fs):
                    return True
        return False

    worktrees: dict[str, list[str]] = {}  # module git dir (realpath) -> the last `core.worktree` of each of its config files

    def offender(cfg: Path) -> str | None:
        if cfg.is_symlink():
            # Codex pass 37: a symlinked config used to be skipped as safe, and the plan then told the human to run
            # git inside a submodule whose real config (the link's target) could set core.fsmonitor
            return "(symlink)"
        rc, out = run(["git", *GIT_SAFE, "config", "--file", str(cfg), "--list", "-z"], timeout=60,
                      cwd=neutral_cwd(), env=env)
        if rc != 0:
            return "(unreadable)"
        entries = [tuple(e.partition("\n")[::2]) for e in out.split("\0") if e]
        values = [value for key, value in entries if key.lower() == "core.worktree"]
        if values:  # accepted by the allowlist, judged below against the checkout: each file's last value (git's), whichever file git reads
            worktrees.setdefault(os.path.realpath(cfg.parent), []).append(values[-1])
        bad = config_offenders(entries, in_submodule=True)
        return bad[0] if bad else None

    GIT_DIR_NAMES = ("HEAD", "config", "config.worktree", "commondir")
    vetted: set[str] = set()  # realpath of every module git dir the walk vetted (its config read, or none to read)
    if modules and modules.is_dir():
        for root, dirs, files in os.walk(modules, followlinks=False):
            # a case-insensitive file system opens `CONFIG` as `config` and `Commondir` as `commondir`, names the
            # exact-name tests below never read (round 44): refuse any such entry
            if any(n.lower() == g.lower() and n != g for n in dirs + files for g in GIT_DIR_NAMES):
                return True, "(unrecognised entry)", []
            # and ask the file system itself: APFS folds more than `str.lower` does (`conﬁg` with the ligature, the
            # Kelvin sign), so a name absent from the listing that still opens is one git would read (round 45)
            if any(g not in files and g not in dirs and os.path.lexists(os.path.join(root, g)) for g in GIT_DIR_NAMES):
                return True, "(unrecognised entry)", []
            # before the pruning below: a symlinked `objects` or `refs` would otherwise leave `dirs` unseen (Codex pass 41)
            # and a symlinked file: `modules.tar` (no dereference) would keep the link, not the refs or objects at its
            # target (`packed-refs`, `reftable/tables.list`, `shallow`; round 47 LOW 4)
            if any((Path(root) / d).is_symlink() for d in dirs + files):
                return True, "(symlink)", []
            if "HEAD" in files or "config" in files:  # a module's git dir: skip its object store and logs
                if internal_symlink(root):
                    return True, "(symlink)", []
                # a nonempty `objects/info/alternates` keeps the module's objects in another directory that `modules.tar`
                # does not archive (`git submodule update --reference` writes one, round 47 LOW 4)
                try:
                    if os.path.getsize(os.path.join(root, "objects", "info", "alternates")) > 0:
                        return True, ALTERNATES_KEY, []
                except OSError:
                    pass
                dirs[:] = sorted(d for d in dirs if d not in MODULE_INTERNAL_DIRS)
                vetted.add(os.path.realpath(root))
            else:  # `modules/` itself or a dir that only groups nested modules: every name is a module
                dirs[:] = sorted(dirs)
            if "commondir" in files:
                return True, "(commondir)", []
            for name in ("config", "config.worktree"):
                if name in files:
                    bad = offender(Path(root) / name)
                    if bad:
                        return True, bad, []
    # every submodule path (index gitlinks and `.gitmodules` paths, which the plan's own listing reads) must have no
    # `.git` at all (an empty directory: the plan's guard refuses it) or a gitfile naming a git dir the walk vetted
    rc, out = git(path, "ls-files", "-z", "-s", errors="surrogateescape")
    if rc != 0:
        return True, "(unreadable)", []
    raw_gitlinks = [e.split("\t", 1)[1] for e in out.split("\0") if e.startswith("160000 ") and "\t" in e]
    # the raw entry: `normpath` would turn `x/../sub` into `sub` and `` into `.` before the check (round 48 INFO 6)
    if any(not p or os.path.isabs(p) or ".." in p.split("/") for p in raw_gitlinks):
        return True, "(gitmodules path unusual)", []
    gitlinks = {os.path.normpath(p) for p in raw_gitlinks}
    listed: set[str] = set()
    if (path / ".gitmodules").is_symlink():
        return True, "(symlink)", []
    if (path / ".gitmodules").is_file():
        rc, out = git(path, "config", "--file", ".gitmodules", "--get-regexp", "-z", r"^submodule\..*\.path$",
                      errors="surrogateescape")
        if rc == 0:
            entries = [e.partition("\n")[::2] for e in out.split("\0") if "\n" in e]
            # the plan's listing prints keys and values raw: a newline, a backspace or an escape sequence in one shows
            # the human a path the scan never vetted (round 45); a bidi override, a zero-width or line-separator
            # character or a non-UTF-8 byte (a lone surrogate here) can misdraw one the same way
            if any(unusual_char(c) for k, v in entries for c in k + v):
                return True, "(gitmodules path unusual)", []
            raw_listed = [v for _, v in entries]
            # `l/../nested` is `nested` to normpath and `a/b/../nested` to the kernel when `l` is a symlink (round 44):
            # a path that is absolute, empty or holds `..` is one the plan's listing would run git at unvetted
            if any(not p or os.path.isabs(p) or ".." in p.split("/") for p in raw_listed):
                return True, "(gitmodules path unusual)", []
            listed = {os.path.normpath(p) for p in raw_listed}
        elif rc != 1:  # 1: no such key
            return True, "(unreadable)", []
    if any(unusual_path(p) for p in gitlinks | listed):
        return True, "(gitmodules path unusual)", []
    subs: list[str] = []
    for sub in sorted(gitlinks | listed):
        # a symlink component (the gitlink's own entry, or a parent) sends `git -C <sup>/<sub>` to a repository the
        # walk never vetted (round 44): the resolved path must be the resolved superproject plus the entry
        if os.path.realpath(path / sub) != os.path.join(os.path.realpath(path), sub):
            return True, "(symlink)", []
        dotgit = path / sub / ".git"
        try:
            mode = os.lstat(dotgit).st_mode
        except (FileNotFoundError, NotADirectoryError):
            try:  # no `.git`: de-initialised or never initialised, an empty directory; files there would be in no capture
                if any(True for _ in os.scandir(path / sub)):
                    return True, "(submodule has files but no .git)", []
            except OSError:
                pass
            continue
        if stat.S_ISLNK(mode):
            return True, "(symlink)", []
        if sub not in gitlinks:
            return True, "(gitmodules path not a gitlink)", []
        if not stat.S_ISREG(mode):
            return True, "(gitdir outside modules)", []
        try:
            raw = dotgit.read_bytes()
        except OSError:
            return True, "(gitdir unreadable)", []
        # git's own gitfile reader: the whole file after `gitdir: `, trailing line breaks dropped. A path holding a
        # line break is one git would use and the plan's one-line parse would not (round 43): refused
        if not raw.startswith(b"gitdir: "):
            return True, "(gitdir unreadable)", []
        rel = raw[len(b"gitdir: "):].rstrip(b"\r\n")
        if not rel or b"\n" in rel or b"\r" in rel or b"\0" in rel:  # a NUL once raised out of realpath (round 44)
            return True, "(gitdir unreadable)", []
        try:
            target = os.path.realpath(os.path.join(os.fsencode(dotgit.parent), rel))
        except ValueError:
            return True, "(gitdir unreadable)", []
        if os.fsdecode(target) not in vetted:
            return True, "(gitdir outside modules)", []
        # git honours `core.worktree`: the plan's `git -C <checkout>/<sub>` would read whatever directory it names unless
        # it resolves to the submodule's own checkout (Cursor security review on PR 27, MEDIUM)
        checkout = os.path.realpath(path / sub)
        if any(os.path.realpath(os.path.join(os.fsdecode(target), v)) != checkout for v in worktrees.get(os.fsdecode(target), [])):
            return True, "(core.worktree outside)", []
        # a submodule that has a repository of its own: the plan's per-submodule commands run with `--no-recursion` and its
        # git dir `modules.tar` keeps the inner modules, but an edit in the inner worktree is in no artifact. Its own
        # `.gitmodules` (a file or a link: cheap, no git call), any gitlink in its index (an embedded repository added
        # with no `.gitmodules`, the case the top level handles the same way) or an untracked repository (cloned there,
        # never added: `embedded_repositories`, the walk the top level runs, which the per-submodule untracked archive
        # keeps as a bare directory entry) skips the whole checkout, so the whole-directory archive row applies (Codex
        # thread 9 on PR 27; adversary round 64, MEDIUM)
        if os.path.lexists(path / sub / ".gitmodules"):
            return True, "(nested submodule)", []
        rc, inner = git(path / sub, "ls-files", "-z", "-s", errors="surrogateescape")
        if rc != 0:
            return True, "(unreadable)", []
        if any(e.startswith("160000 ") for e in inner.split("\0")):
            return True, "(nested submodule)", []
        rc, nested, _ = embedded_repositories(path / sub)
        if rc != 0:
            return True, "(unreadable or timed out)", []  # a timeout of the walk is rc 124
        if nested:
            return True, "(nested submodule)", []
        # a repository at a skip-worktree or assume-unchanged path: `ls-files --others` lists nothing for a directory that
        # replaces one, so the walk above never saw it (the top level walks those directories itself; adversary round 65,
        # MEDIUM; Codex pass 65, P1)
        _, hidden_names, _, failure = index_hidden_repositories(path / sub)
        if failure:
            return True, "(unreadable or timed out)", []
        if hidden_names:
            return True, "(nested submodule)", []
        subs.append(sub)  # a real checked-out submodule: `.git` names a git dir the walk vetted
    return True, None, subs


MAX_STASH_LOG_BYTES = 64 * 1024 * 1024


def read_regular_file(path: Path, cap: int) -> bytes:
    """The bytes of a regular file of at most `cap` bytes. Never follows a symlink, never blocks on a FIFO and never
    reads a device: ValueError for any of those (OSError when it cannot be opened)."""
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_size > cap:
            raise ValueError("not a regular file within the cap")
        with os.fdopen(os.dup(fd), "rb") as f:
            data = f.read(cap + 1)
        if len(data) > cap:
            raise ValueError("not a regular file within the cap")
        return data
    finally:
        os.close(fd)


MAX_EMBEDDED = 1000  # past this the plan would be unreadable: the checkout is `scan incomplete`, not truncated


def embedded_repositories(path: Path, within: list[str] | None = None) -> tuple[int, list[str], list[str]]:
    """(rc, names, pointers): untracked repositories at any depth, the real names with their trailing `/`, and the
    subset whose `.git` is a file or symlink (a separate gitdir or a linked worktree: archiving the directory keeps no
    commits). `ls-files -z --others --exclude-standard` lists a nested repository as `dir/`, the same list the
    untracked archive reads, so a repository below an untracked directory is found too and no name needs unquoting
    (adversary round 56 on PR 27, MEDIUM and LOW 3; `status` shows only the top untracked directory). Tar recurses
    into none of them (`--no-recursion`). Any stderr line (an unreadable subdirectory is a warning with rc 0) makes
    the list partial: rc 65 (round 57, MEDIUM). `within` limits the walk to those paths (literal pathspecs): the
    directories that replace an index-hidden tracked path (Codex pass 55 on PR 27)."""
    ls_err: list[str] = []
    limit = ["--", *[":(literal)" + w for w in within]] if within else []
    rc, out = git(path, "ls-files", "-z", "--others", "--exclude-standard", *limit, errors="surrogateescape", err=ls_err,
                  timeout=STATUS_TIMEOUT)  # walks the whole untracked tree, as `status` does (round 58, INFO 6)
    if rc == 0 and any(ln.strip() for ln in "".join(ls_err).splitlines()):
        rc = 65
    if rc != 0:
        return rc, [], []
    names = [n for n in out.split("\0") if n.endswith("/") and os.path.lexists(os.path.join(path, n.rstrip("/"), ".git"))]
    pointers = [n for n in names if os.path.islink(os.path.join(path, n.rstrip("/"), ".git"))
                or not os.path.isdir(os.path.join(path, n.rstrip("/"), ".git"))]
    return 0, names, pointers


def index_hidden_repositories(path: Path) -> tuple[int, list[str], list[str], tuple[str, int] | None]:
    """(index-hidden paths counted, names, pointers, failure) of a checkout: the repositories at a tracked path that is
    marked assume-unchanged (`ls-files -v` tag in lowercase) or skip-worktree (`S`) and is replaced by a directory. Those
    are invisible to `status` and to `embedded_repositories(path)`: `ls-files --others` lists nothing for a directory that
    is a repository itself (its `.git` makes it opaque), so the repository is looked for under each hidden directory on
    its own, and the hidden directory itself counts when it has a `.git` (Codex pass 55 on PR 27, P2). A skip-worktree
    path with no file is a sparse checkout's ordinary state (adversary round 38) and is not counted. Names and pointers
    follow `embedded_repositories`. `failure` is None, or the (call, rc) that makes any answer unknown. One walk for the
    top level and for every submodule (adversary round 65, MEDIUM)."""
    # decoded with surrogateescape: a name that is not UTF-8 then round-trips to the same bytes in the `lexists`
    # test below, where `replace` would test a different path and drop an existing entry (Codex pass 38)
    rc, out = git(path, "ls-files", "-z", "-v", errors="surrogateescape")
    if rc != 0:
        return 0, [], [], ("ls-files -v", rc)
    hidden_paths = [e[2:] for e in out.split("\0") if len(e) > 2 and e[1] == " "
                    and (e[0].islower() or (e[0] == "S" and os.path.lexists(os.path.join(path, e[2:]))))]
    hidden_dirs = [h for h in hidden_paths
                   if os.path.isdir(os.path.join(path, h)) and not os.path.islink(os.path.join(path, h))]
    if not hidden_dirs:
        return len(hidden_paths), [], [], None
    if len(hidden_dirs) > MAX_EMBEDDED:
        return len(hidden_paths), [], [], (f"index-hidden directories ({len(hidden_dirs)} > {MAX_EMBEDDED})", 0)
    rc, names, pointers = embedded_repositories(path, hidden_dirs)
    if rc != 0:
        return len(hidden_paths), [], [], ("ls-files --others under index-hidden paths (a failed call, or git printed a warning)", rc)
    for h in hidden_dirs:
        dot_git = os.path.join(path, h, ".git")
        if os.path.lexists(dot_git):
            names.append(h + "/")
            if os.path.islink(dot_git) or not os.path.isdir(dot_git):
                pointers.append(h + "/")
    return len(hidden_paths), list(dict.fromkeys(names)), list(dict.fromkeys(pointers)), None


def stash_count(path: Path, common: Path | None) -> int | None:
    """Stashes = lines of the stash reflog file; no log machinery (no gpg, no pager) is involved. None when
    the count could not be taken (an unreadable reflog, a failed `stash list`): the caller records the scan as
    incomplete rather than inventing a count (Codex pass 22 on PR 27)."""
    if common:
        try:
            lines = len(read_regular_file(common / "logs" / "refs" / "stash", MAX_STASH_LOG_BYTES).splitlines())
            if lines:
                return lines
            # an empty reflog (`git reflog expire --expire=now --all` leaves the ref and a zero-byte log) beside a live
            # `refs/stash` is still a stash: ask the ref (adversary round 52 on PR 27)
        except FileNotFoundError:
            pass
        except (OSError, ValueError):  # a symlink, FIFO or device, or a file past the cap: not a count (Codex pass 46)
            return None
    rc, _ = git(path, "rev-parse", "--verify", "--quiet", "refs/stash")
    if rc == 1:  # `--verify --quiet`: 1 is "no such ref", git's documented answer; anything else is a failure
        return 0
    if rc != 0:  # a timeout (124) or a repository error (128) is not "no stash" (Codex pass 24)
        return None
    rc, n = git(path, "stash", "list", "--format=%H")  # reftable: no reflog file; log.showSignature is off
    return max(len(n.splitlines()), 1) if rc == 0 else None


_neutral_cwd: list[str] = []


def neutral_cwd() -> str:
    """An empty dir outside any repo: ls-remote started here loads no checkout's config."""
    if not _neutral_cwd:
        d = tempfile.mkdtemp(prefix="ade-scan-state-")
        atexit.register(lambda: shutil.rmtree(d, ignore_errors=True))
        _neutral_cwd.append(d)
    return _neutral_cwd[0]


def queried_origin_url(path: Path) -> str | None:
    """The url `ls-remote` is given: the FIRST `remote.origin.url` in config order, which is what `git fetch
    origin` and `git ls-remote origin` use (`config --get` would print the last: a second url in the same
    file, or a worktree-scoped one after the local one, is not fetched from). A url that is a path (no
    scheme, no `:`) is relative to the checkout, not to our neutral cwd. None when it is unset or shaped
    like an option."""
    # `-z`: the value whole, NUL-terminated. `splitlines()[0]` cut an embedded newline off, so a url such as
    # `ssh://git@host/repo<LF>?private_token=...` was judged on its first line and git handed the whole value
    # to ssh (Codex pass 28 on PR 27); `url_holds_credential` refuses any control character
    rc, out = git(path, "config", "-z", "--get-all", "remote.origin.url")
    url = out.split("\0")[0] if rc == 0 and out else ""
    if not url.strip() or url.lstrip().startswith("-"):  # `lstrip`: a leading space hides nothing (round 34)
        return None
    if not os.path.isabs(url) and (url.startswith(".") or ":" not in url):
        url = str((path / url).resolve())
    return url


def push_url_values(path: Path) -> list[str] | None:
    """Every url `git push origin` may use (Codex pass 41, P1): every `remote.origin.url` and `remote.origin.pushurl`
    value (a push goes to the pushurls when set, else to every url) and every url git resolves for a push after
    `url.<base>.insteadOf` / `pushInsteadOf` (`remote get-url --push --all`), the second time as the operator's own
    config rewrites it (Codex pass 46, P1: the scan's sandbox ignores the global and system config, the push does
    not). None when any read failed: unknown, which refuses the push (the safe direction)."""
    urls: list[str] = []
    for key in ("remote.origin.url", "remote.origin.pushurl"):
        rc, out = git(path, "config", "-z", "--get-all", key)
        if rc not in (0, 1):  # 1: key unset
            return None
        if rc == 0:
            urls += [u for u in out.split("\0") if u]
    for operator in (False, True):
        rc, out = git(path, "remote", "get-url", "--push", "--all", "origin", operator_config=operator)
        if rc != 0:
            return None
        urls += [u for u in out.split("\n") if u]
    return urls


def push_urls_hold_credential(path: Path) -> bool:
    """Whether any url `git push origin` may use holds a credential or names a remote helper, or could not be read.
    Never queried, never kept."""
    urls = push_url_values(path)
    return urls is None or any(url_withheld(u) for u in urls)


def push_urls_run_local_receive(path: Path) -> bool:
    """Whether a push would run `receive-pack` locally, in another repository on this machine (a path, a relative path
    or `file://`): that repository's receive hooks and config-named programs (`core.alternateRefsCommand`) run, and
    `-c core.hooksPath` does not reach them (adversary round 54 on PR 27, MEDIUM). The plan then offers the bundle only."""
    urls = push_url_values(path)
    return bool(urls) and any(url_is_local_path(u) for u in urls)


def url_is_local_path(url: str) -> bool:
    """git's own classification: `file://`, or no `<scheme>://`, no `<transport>::` and no `host:path` (a colon before
    any slash) is a path on this machine."""
    if url.startswith("file://"):
        return True
    if re.match(r"[A-Za-z0-9][A-Za-z0-9+.-]*://", url) or re.match(r"[A-Za-z0-9+.-]+::", url):
        return False
    colon, slash = url.find(":"), url.find("/")
    if colon > 0 and (slash == -1 or colon < slash):
        return False  # scp-like `host:path`
    return bool(url)


_BAD_REF_CHARS = re.compile(r"[\x00-\x20\x7f~^:?*\[\\]")
_OID = re.compile(r"[0-9a-f]{40}|[0-9a-f]{64}")


def valid_branch_name(name: str) -> bool:
    """Whether `refs/heads/<name>` passes `git check-ref-format` (plus: `@` alone is refused, as for a
    branch). origin is not trusted to advertise only names git itself would create: upload-pack lists
    `refs/heads/x:refs/heads/side` as it finds it on disk, and such a name pasted into a fetch refspec
    writes to its destination (adversary round 17, 1)."""
    if not name or name == "@" or name.endswith(("/", ".")):
        return False
    if _BAD_REF_CHARS.search(name) or ".." in name or "@{" in name:
        return False
    return all(part and not part.startswith(".") and not part.endswith(".lock")
               for part in name.split("/"))


def origin_url_env(env: dict, url: str) -> dict:
    """`env` plus the url as `remote.origin.url` through GIT_CONFIG_COUNT/KEY_0/VALUE_0 (git 2.31+): the
    url never sits in a command line, where any process could read it for as long as the call runs
    (Codex pass 16). The call then names the remote `origin`, not the url."""
    return {**env, "GIT_CONFIG_COUNT": "1", "GIT_CONFIG_KEY_0": "remote.origin.url", "GIT_CONFIG_VALUE_0": url}


_env_config_ok: list[bool] = []


def git_takes_env_config() -> bool:
    """Whether this git reads GIT_CONFIG_COUNT (2.31+). False when the version cannot be read or is older:
    the query is then refused (the checkout is `origin unreachable`), never made with the url in argv."""
    if not _env_config_ok:
        rc, out = run(["git", "--version"], timeout=60, env=git_env())
        m = re.search(r"(\d+)\.(\d+)", out) if rc == 0 else None
        if not m:
            return False
        _env_config_ok.append((int(m[1]), int(m[2])) >= MIN_GIT_ENV_CONFIG)
        if not _env_config_ok[0]:
            print(f"ade-scan-state: git {m[1]}.{m[2]} is older than {MIN_GIT_ENV_CONFIG[0]}.{MIN_GIT_ENV_CONFIG[1]}: "
                  "--remote does not query origin (the url would have to sit in argv)", file=sys.stderr)
    return _env_config_ok[0]


def url_holds_credential(url: str) -> bool:
    """Whether `url` may carry a credential git would hand to a transport helper's argv. A scp-like
    `host:path` (no `://`) is ssh and has none unless its path holds a `?`; `ssh://git@host` is a username, not a credential, but any
    password (`ssh://git:secret@host`) is one, and so is a query string: git puts the path and query into
    `git-upload-pack '/repo?token=...'` in the ssh process's argv (Codex pass 25). For every other scheme (http, https, ...) ANY userinfo counts
    (`https://<token>@github.com/x` is how a token is used as the username; adversary round 22) and so does
    a query string (`?private_token=...`) or a fragment (`#token=...`, Codex pass 27; on the scp-like and
    `<transport>::` forms, which are not parsed, a bare `?` or `#` counts too: the safe direction, round 33); a `<transport>::<address>` prefix names a helper that gets the whole
    address in argv, so any `@` or `?` in it counts, whatever its scheme. An unparsable authority is read by hand.
    A percent-encoded separator or control character (`%3F`, `%23`, `%40`, `%3A`, `%0A`, ...) counts on every form:
    git decodes it before the value reaches the helper or ssh (Cursor security review, 2026-10-20)."""
    # `<transport>::<address>` names a remote helper for an arbitrary address (`https::https://t@host`): git
    # splits at the FIRST `::` and hands everything after it to git-remote-<transport> as one argument, so a
    # second prefix or an ssh-looking inner scheme changes nothing (rounds 23 and 24): no parsing, any `@` or `?`
    if any(ord(ch) < 0x20 or ch == "\x7f" for ch in url):
        return True  # a newline or other control character: git passes the value on whole (Codex pass 28)
    if re.search(r"%(?:[01][0-9A-Fa-f]|7[Ff]|3[Ff]|23|40|3[Aa])", url):
        # a percent-encoded `?`, `#`, `@`, `:` or control character: git decodes the path on the transport side,
        # so `ssh://git@host/repo%3Ftoken=x` still becomes `git-upload-pack '/repo?token=x'` in ssh's argv and
        # an encoded https query reaches git-remote-https (Cursor security review on PR 27, 2026-10-20)
        return True
    head, sep, rest = url.partition("::")
    if sep and head and re.fullmatch(r"[A-Za-z0-9+.-]+", head):
        return "@" in rest or "?" in rest or "#" in rest
    if not re.match(r"[A-Za-z0-9+.-]+://", url) and "@" in url and ":" in url.partition("@")[0]:
        return True  # git's `is_url` wants a scheme of these characters: `user:pw@host:path://x` is scp-like (round 59, INFO 5)
    if "://" not in url:
        # scp-like `[user@]host:path`: ssh gets the path verbatim, so a `?token=` in it reaches its argv like the
        # `ssh://` case (adversary round 31); a local path has no `:` before its first `/`
        if "@" in url and ":" in url.partition("@")[0]:
            # `[user:secret@host]:repo`, `user:secret@[host]:repo`, `user:secret@host:repo`: ssh's argv carries the secret, as the
            # host or as the path (rounds 57 and 58; `host:path@x` is refused too, the safe direction)
            return True
        host, sep, path = url.partition(":")
        return bool(sep) and "/" not in host and ("?" in path or "#" in path)
    scheme = url.partition("://")[0].lower()
    try:
        parts = urlsplit(url)
        netloc, password, query, fragment = parts.netloc, parts.password, parts.query, parts.fragment
    except ValueError:
        rest = url.partition("://")[2]
        netloc, password = rest.split("/", 1)[0], None
        query, fragment = rest.partition("?")[2].partition("#")[0], rest.partition("#")[2]
    userinfo = "@" in netloc
    has_password = password is not None or (userinfo and ":" in netloc.rpartition("@")[0])
    # a fragment is handed to the helper or to ssh whole, like a query (`https://host/repo#token=...` reaches
    # `git-remote-https origin <url>` in argv; Codex pass 27 on PR 27)
    if scheme in ("ssh", "git+ssh", "ssh+git"):
        return has_password or bool(query) or bool(fragment)
    return userinfo or has_password or bool(query) or bool(fragment)


# the schemes git implements itself: any other `<scheme>://` runs `git-remote-<scheme>` from PATH
_TRUSTED_SCHEMES = frozenset({"http", "https", "ssh", "git+ssh", "ssh+git", "git", "ftp", "ftps", "file"})


def url_names_remote_helper(url: str) -> bool:
    """Whether git would run a remote helper program for `url` (Codex pass 44 on PR 27, P1): `<transport>::<address>`
    runs `git-remote-<transport>` from PATH with the address (`ext::` runs the command it is given), and so does a
    `<scheme>://` for any scheme git does not implement itself. `git push origin` or `ls-remote` on such a url runs
    that program, so the scan neither queries it nor prints a push for it: the bundle is the way out."""
    if re.match(r"[A-Za-z0-9+.-]+::", url):
        return True
    # git's own transports match case-sensitively (`starts_with(url, "ssh://")`) and a scheme may start with a digit
    # (`is_urlschemechar`): `SSH://`, `Git://`, `FILE:///` and `0day://` all reach `git-remote-<text before ':'>` (round 50)
    m = re.match(r"([A-Za-z0-9][A-Za-z0-9+.-]*)://", url)
    return bool(m) and m[1] not in _TRUSTED_SCHEMES


def url_withheld(url: str) -> bool:
    """A url the scan never queries and never prints a push for: it holds a credential or names a remote helper."""
    return url_holds_credential(url) or url_names_remote_helper(url)


def ls_remote_refs(url: str) -> tuple[dict[str, str], dict[str, tuple[str, str]], int] | None:
    """(branches {name: tip oid}, tags {name: (oid, effective oid)}, the number of advertised entries dropped
    as invalid), None when `ls-remote` failed. The effective oid of a tag is its peeled commit (`^{}` entry)
    when it is annotated, else the oid itself. An entry is dropped when its name fails `valid_branch_name`
    (the same rule for tags), its oid is not 40 or 64 lowercase hex digits or is all zeros, the line is not
    `<oid> TAB refs/heads/<name>` or `refs/tags/<name>`, or it is a peeled entry with no tag line. More than
    LS_REMOTE_MAX_BYTES of output is not an answer either: the process is killed and the result is None (`origin
    unreachable`), never the first part of an advertisement read as all of it."""
    env = git_env(network=True)
    # the temp dir's parent is a ceiling: git must not discover a repository above the neutral dir
    env["GIT_CEILING_DIRECTORIES"] = str(Path(neutral_cwd()).parent)
    rc, out = run(["git", *GIT_SAFE, "ls-remote", "--heads", "--tags", "--", "origin"], timeout=120,
                  cwd=neutral_cwd(), env=origin_url_env(env, url), max_bytes=LS_REMOTE_MAX_BYTES)
    if rc != 0:
        return None
    heads: dict[str, str] = {}
    plain: dict[str, str] = {}
    peeled: dict[str, str] = {}
    invalid = 0
    for ln in out.splitlines():
        if not ln.strip():
            continue
        oid, _, ref = ln.partition("\t")
        if not _OID.fullmatch(oid) or not oid.strip("0"):
            invalid += 1
            continue
        if ref.startswith("refs/heads/"):
            name = ref[len("refs/heads/"):]
            if valid_branch_name(name):
                heads[name] = oid
                continue
        elif ref.startswith("refs/tags/"):
            name = ref[len("refs/tags/"):]
            is_peeled = name.endswith("^{}")
            name = name[:-3] if is_peeled else name
            if valid_branch_name(name):
                (peeled if is_peeled else plain)[name] = oid
                continue
        invalid += 1
    invalid += sum(1 for name in peeled if name not in plain)
    tags = {name: (oid, peeled.get(name, oid)) for name, oid in plain.items()}
    return heads, tags, invalid


_remote_cache: dict[tuple[str, str], tuple] = {}


def local_origin_refs(path: Path) -> dict[str, str] | None:
    rc, out = git(path, "for-each-ref", "--format=%(refname:strip=3) %(objectname)", "refs/remotes/origin")
    if rc != 0:
        return None
    return dict(ln.split() for ln in out.splitlines() if len(ln.split()) == 2)


def local_tag_refs(path: Path) -> dict[str, str] | None:
    """{tag name: object id (the tag object for an annotated tag)} of the local tags."""
    rc, out = git(path, "for-each-ref", "--format=%(refname:strip=2) %(objectname)", "refs/tags")
    if rc != 0:
        return None
    return dict(ln.split() for ln in out.splitlines() if len(ln.split()) == 2)


def origin_branches(path: Path, remote: bool) -> tuple[dict[str, str] | None, bool, int,
                                                       dict[str, tuple[str, str]], bool]:
    """(branch name -> tip sha on origin, whether `ls-remote` answered, advertised entries dropped as
    invalid names or oids, tag name -> (oid, effective oid) on origin, whether origin's url holds a
    password: then nothing is asked of origin, with or without --remote, and the url is kept nowhere).

    With --remote the tips come from `ls-remote`; when origin does not answer they come from the local
    remote refs instead (adversary round 4: None read as "unknown" and hid unpushed work), the second
    value is False and the caller flags the checkout `origin unreachable`; without --remote the second
    value is False too. No tags then. None: no origin, or no readable local refs."""
    rc, _ = git(path, "remote", "get-url", "origin")
    if rc != 0:
        return (None, False, 0, {}, False)
    # Worktrees share a git dir but may carry worktree-scoped remote.origin.url values
    # (extensions.worktreeConfig): the cache key is (git dir, the url ls-remote is given), never the
    # git dir alone (Codex pass 9)
    url = queried_origin_url(path)
    rc, common = git(path, "rev-parse", "--git-common-dir")
    # the url itself is never a key: its sha256 prefix stands in (it may hold a password)
    key = (str((path / common.strip()).resolve()) if rc == 0 and common.strip() else str(path),
           hashlib.sha256((url or "").encode()).hexdigest()[:16])
    if key not in _remote_cache:
        credential = bool(url) and url_withheld(url)  # never queried, never kept
        answer = (ls_remote_refs(url) if remote and url and not credential and git_takes_env_config()
                  else None)
        _remote_cache[key] = ((answer[0], True, answer[2], answer[1], False) if answer is not None
                              else (local_origin_refs(path), False, 0, {}, credential))
    cached = _remote_cache[key]
    if not cached[4] and push_urls_hold_credential(path):  # worktree-scoped push urls: never part of the cache key
        return (*cached[:4], True)
    return cached


def skipped_record(path: Path, reason: str, keys: list[str] | None = None) -> dict:
    return {
        "path": str(path), "branch": "?", "modified": None, "untracked": None,
        "untracked_sample": [], "modified_sample": [], "upstream": None, "unpushed": None,
        "ahead_of_origin": None, "stashes": None, "has_origin": None, "on_origin": "unknown",
        "local_only_commits": None, "local_only_verified": None, "invalid_origin_refs": 0,
        "local_only_branches": [], "local_only_tags": [], "local_only_branches_uncounted": 0,
        "config_keys": keys or [], "flags": [reason], "verdict": reason,
    }


def incomplete_record(path: Path, call: str, rc: int) -> dict:
    """A git call failed (rc 124 = timed out): the checkout's state is unknown, never `clean and pushed`."""
    return skipped_record(path, f"{INCOMPLETE_PREFIX}{call} rc={rc}")


def local_only_count(path: Path, revs: list[str], tips: list[str],
                     live: bool = False, has_origin: bool = True) -> tuple[int | None, int]:
    """(commits reachable from `revs` and from no origin ref, rc); None when git failed.

    Without a live answer origin's refs are the local `refs/remotes/origin/*`. With one (`live`, --remote
    and `ls-remote` answered) they are `tips` alone: a local tracking ref proves nothing about a live
    branch (origin may have force-pushed it) and one of a deleted branch holds nothing there (Codex
    passes 9 and 11). Tips whose objects are not here are ignored (`--ignore-missing`): the count then
    only overcounts, and the caller flags it unverified. With no origin remote (`has_origin` false) a
    leftover `refs/remotes/origin/*` excludes nothing (Codex pass 18)."""
    argv = ["rev-list", "--count", *revs, "--not"]
    if not live and has_origin:
        argv.append("--remotes=origin")
    if tips:
        argv += ["--ignore-missing", *tips]
    rc, n = git(path, *argv)
    return (int(n) if rc == 0 and n.strip().isdigit() else None), rc


def scan_checkout(path: Path, remote: bool, fetch: bool = False) -> dict:
    """`scan_record` plus the store warnings: a checkout whose own `objects/info/alternates` is not empty keeps commits in
    a store that neither `whole.tar` nor the git-dir archive holds, so every `skipped` or `scan incomplete` row (the ones
    that offer only those two) carries `alternates` (adversary round 64, LOW 3); one whose `objects`, `refs` or
    `packed-refs` is a symlink out, or whose `.git` directory holds a `commondir`, carries `linked_stores` (round 65, LOW 2).
    A bundle row is not affected: `bundle create` reads through both. Ordinary records are left alone."""
    rec = scan_record(path, remote, fetch)
    if rec["verdict"].startswith(("skipped", INCOMPLETE_PREFIX)):
        shown, linked = top_stores(path)
        if shown is not None:
            rec["alternates"] = [*shown, *rec.get("alternates", [])][:MAX_ALTERNATES_SHOWN]
        if linked:
            rec["linked_stores"] = linked
    return rec


def scan_record(path: Path, remote: bool, fetch: bool = False) -> dict:
    if (path / ".git").is_symlink():  # before any git call: git would read the link's target, a git dir elsewhere
        return skipped_record(path, SKIP_GIT_SYMLINK)
    if git_dir_redirected(path):  # likewise: a `commondir` makes every call, `fetch` included, act on the git dir it names
        return skipped_record(path, SKIP_COMMONDIR)
    keys = unsafe_config(path)  # before any other git call: reading config runs nothing
    if keys is None:
        return skipped_record(path, SKIP_UNREADABLE)
    if "core.worktree" in keys:
        return skipped_record(path, SKIP_WORKTREE, keys)
    if keys:
        return skipped_record(path, f"skipped: unrecognised config {keys[0]}", keys)
    rc, top = git(path, "rev-parse", "--show-toplevel")
    if rc != 0 or not top.strip():
        rc_dir, _ = git(path, "rev-parse", "--git-dir")
        if rc_dir != 0 and (path / ".git" / "HEAD").is_file():
            return skipped_record(path, SKIP_HEAD_UNREADABLE)  # git does not recognise the repository
        return skipped_record(path, SKIP_NO_WORKTREE)
    if Path(top.strip()).resolve() != path.resolve():
        return skipped_record(path, SKIP_WORKTREE)
    common = git_common_dir(path)
    has_submodules, bad_key, submodules_vetted = submodule_config_check(path, common)
    if bad_key:
        rec = skipped_record(path, f"skipped: submodule config unrecognised {bad_key}", [bad_key])
        if bad_key == ALTERNATES_KEY:  # the doc says where the store that is in no archive is
            rec["alternates"] = alternates_targets(common)
        return rec
    # a ref name that is not UTF-8 cannot round-trip through this tool's text (two such names collide on U+FFFD, and
    # no generated command could name them): the checkout is unknown, and its whole-directory row captures it all
    # (adversary round 54 on PR 27, LOW 2; Codex pass 48, P1)
    rc, names = git(path, "for-each-ref", "--format=%(refname)", errors="surrogateescape")
    if rc != 0:
        return incomplete_record(path, "for-each-ref", rc)
    if any(0xDC80 <= ord(ch) <= 0xDCFF for ch in names):
        return incomplete_record(path, "for-each-ref (a ref name is not valid UTF-8)", rc)
    rc, branch = git(path, "rev-parse", "--abbrev-ref", "HEAD")
    unborn = False
    if rc != 0:
        rc_branch = rc
        # A repository with no commit yet fails here and is still a valid, scannable checkout; one that
        # has refs but whose HEAD names none of them is damaged, not unborn (adversary round 4, 2).
        rc_head, _ = git(path, "rev-parse", "--verify", "--quiet", "HEAD")
        if rc_head == 1:
            rc_refs, refs = git(path, "for-each-ref", "--count=1", "refs/heads", "refs/tags")
            if rc_refs == 0 and not refs.strip():
                rc, branch = git(path, "symbolic-ref", "--quiet", "--short", "HEAD")
                unborn = rc == 0
        if not unborn:
            return incomplete_record(path, "rev-parse --abbrev-ref HEAD", rc_branch)
    branch = branch.strip()
    detached = branch == "HEAD"
    # A git call that fails or times out must never read as "nothing found" (adversary round 3, 1).
    status_err: list[str] = []
    rc, status = git(path, "status", "--porcelain", "--ignore-submodules=all",
                     "--untracked-files=normal", timeout=STATUS_TIMEOUT, err=status_err)
    if rc != 0:
        return incomplete_record(path, "status", rc)
    # any line at all, the hint silenced at its source (`advice.graftFileDeprecated`, `GIT_ADVICE`): git reports an
    # unreadable tracked path with a bare `perror`, `<path>: Permission denied`, no prefix, and still exits 0 (round 55
    # MEDIUM), and a path named `hint:d` must not hide behind a prefix test (round 56 LOW 2)
    if any(ln.strip() for ln in "".join(status_err).splitlines()):
        # an unreadable untracked subtree ends `status` with rc 0, the files it could not list left out, and a
        # `warning: could not open directory ...` on stderr: the traversal was partial, so no count of it is a count
        # (Codex pass 49 on PR 27, P1)
        return incomplete_record(path, "status (git printed a warning: part of the worktree could not be read)", rc)
    if not has_submodules:
        # an embedded repository added as a gitlink with no `.gitmodules` leaves neither that file nor `modules/`: the
        # index is the only witness, and `status --ignore-submodules=all` never sees inside it (Codex pass 50, P1). Asked
        # after `status` succeeded, so an unreadable index is still reported as `scan incomplete: status`
        rc, out = git(path, "ls-files", "-z", "-s", errors="surrogateescape")
        if rc != 0:
            return incomplete_record(path, "ls-files -s", rc)
        if any(e.startswith("160000 ") for e in out.split("\0")):
            return skipped_record(path, "skipped: submodule config unrecognised (gitlink without .gitmodules)",
                                  ["(gitlink without .gitmodules)"])
    lines = status.splitlines()
    untracked = [ln[3:] for ln in lines if ln.startswith("??")]
    modified = [ln[3:] for ln in lines if not ln.startswith("??")]
    embedded: list[str] = []
    embedded_pointers: list[str] = []
    if untracked:
        rc, embedded, embedded_pointers = embedded_repositories(path)
        if rc != 0:
            return incomplete_record(path, "ls-files --others (a failed call, or git printed a warning: part of the worktree could not be read)", rc)
        if len(embedded) > MAX_EMBEDDED:
            return incomplete_record(path, f"embedded repositories ({len(embedded)} > {MAX_EMBEDDED})", 0)
    # Git LFS payloads of unpushed commits sit in `<gitdir>/lfs/objects`: a bundle holds the pointers only and a push
    # with hooks off (the generated one) never runs LFS's pre-push upload (Codex pass 52 on PR 27, P1)
    # The store is resolved, not assumed: `lfs` or `lfs/objects` may be a symlink (tar would keep the link only) and the
    # operator's own config may relocate it with `lfs.storage` (a relative value is against the git dir); adversary round
    # 58, LOW 3. The recorded path is the resolved `objects` directory itself, archived without `tar -h`, which would
    # follow every symlink inside the store too (adversary round 60, LOW 1)
    lfs_store = None
    if common is not None:
        rc_s, cfg_s = git(path, "config", "--get", "lfs.storage", operator_config=True)
        base = Path(cfg_s.strip()) if rc_s == 0 and cfg_s.strip() else Path("lfs")
        objects = Path(os.path.realpath((base if base.is_absolute() else common / base) / "objects"))
        try:
            if os.path.isdir(objects) and any(os.scandir(objects)):
                lfs_store = str(objects)
        except OSError:
            lfs_store = str(objects)  # unreadable: assume it holds payloads
    # a tracked path marked assume-unchanged (`ls-files -v` tag in lowercase) or skip-worktree (`S`) is invisible to
    # `status`, so its edits are in no count above: it is counted and captured on its own (Codex pass 32 on PR 27).
    # A skip-worktree path with no file is a sparse checkout's ordinary state (adversary round 38): nothing to
    # capture; an assume-unchanged path that is gone counts, since `status` hides that deletion too. A hidden path
    # replaced by a repository is looked for by `index_hidden_repositories`, the same walk each submodule gets
    index_hidden, more_names, more_pointers, failure = index_hidden_repositories(path)
    if failure:
        return incomplete_record(path, *failure)
    embedded = embedded + [n for n in more_names if n not in embedded]
    embedded_pointers = embedded_pointers + [n for n in more_pointers if n not in embedded_pointers]
    if len(embedded) > MAX_EMBEDDED:
        return incomplete_record(path, f"embedded repositories ({len(embedded)} > {MAX_EMBEDDED})", 0)
    rc, up = git(path, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}")
    upstream = up.strip() if rc == 0 else None
    unpushed = None
    if upstream and not unborn:
        rc, n = git(path, "rev-list", "--count", "@{u}..HEAD")
        if rc != 0 or not n.strip().isdigit():
            return incomplete_record(path, "rev-list --count @{u}..HEAD", rc)
        unpushed = int(n)
    # `git remote get-url` exits 2 with "error: No such remote 'origin'" (observed, git's own answer) when
    # origin is not configured; a timeout (124), a damaged config (128) or anything else is unknown, never
    # "no origin", which would turn the checkout into an orphan instead of `scan incomplete` (Codex pass 8)
    rc, _ = git(path, "remote", "get-url", "origin")
    if rc not in (0, NO_SUCH_REMOTE_RC):
        return incomplete_record(path, "remote get-url origin", rc)
    has_origin = rc == 0
    # Without an origin remote, leftover `refs/remotes/origin/*` (the config edited instead of `git remote
    # remove`) prove nothing: every commit is local-only (Codex pass 18 on PR 27)
    not_origin = ["--not", "--remotes=origin"] if has_origin else []
    ahead_of_origin = 0
    if not unborn:
        rc, n = git(path, "rev-list", "--count", "HEAD", *not_origin)
        if rc != 0 or not n.strip().isdigit():
            return incomplete_record(path, "rev-list --count HEAD --not --remotes=origin", rc)
        ahead_of_origin = int(n)
    stashes = stash_count(path, common)
    if stashes is None:
        return incomplete_record(path, "stash list", 1)
    branches, live, invalid_refs, tags, credential = (origin_branches(path, remote) if has_origin
                                                      else (None, False, 0, {}, False))
    origin_unreachable = bool(remote and has_origin and not live)
    on_origin = False if not has_origin else (None if branches is None or detached
                                              else branch in branches)
    # Local origin/* refs can be stale: a branch whose origin tip is HEAD, or contains HEAD,
    # has nothing unpushed whatever the local remote-tracking refs say.
    tip = branches.get(branch) if branches and on_origin else None
    tip_unverified = False
    if tip and ahead_of_origin:
        # count again against the real origin tip: HEAD may already be inside it
        def ahead_of_tip() -> tuple[int | None, int | None]:
            """(count, None); (None, None) when git says the tip object is not here (the one failure that means
            `origin tip not fetched`); (None, rc) for any other failure (a timeout is 124, a damaged repository 128)."""
            tip_err: list[str] = []
            rc, n = git(path, "rev-list", "--count", "HEAD", "--not", "--remotes=origin", tip, err=tip_err)
            if rc == 0 and n.strip().isdigit():
                return int(n), None
            # the tip is a vetted object id, `LC_ALL=C` is set: git's own whole-line messages for an object it lacks
            missing = {f"fatal: bad object {tip}", f"fatal: not a valid object name {tip}",
                       f"fatal: ambiguous argument '{tip}': unknown revision or path not in the working tree."}
            if rc == 128 and any(ln in missing for ln in "".join(tip_err).splitlines()):
                return None, None
            return None, rc or 65
        n, bad_rc = ahead_of_tip()
        if bad_rc is not None:
            return incomplete_record(path, "rev-list --count HEAD --not --remotes=origin <tip>", bad_rc)
        if n is None and fetch:  # the tip's objects are not here: download them, write no refs
            if not credential:  # `fetch` hands the configured url to its transport helper: not with a password
                git(path, "-c", "maintenance.auto=false", "-c", "gc.auto=0", "fetch", "--quiet",
                    "--no-auto-maintenance", "--no-write-fetch-head", "--no-tags", "--refmap=",
                    "--no-recurse-submodules", "--no-prune", "--",
                    "origin", f"refs/heads/{branch}", timeout=120, network=True)
            n, bad_rc = ahead_of_tip()
            if bad_rc is not None:
                return incomplete_record(path, "rev-list --count HEAD --not --remotes=origin <tip>", bad_rc)
        if n is None:
            tip_unverified = True  # origin has a tip we cannot compare with HEAD
        else:
            ahead_of_origin = n
    # Commits on no origin ref, over HEAD and every local branch (adversary round 4, 1): the verdict
    # `clean and pushed` needs this to be 0 whatever `on_origin` says. ls-remote tips (when origin
    # answered) are excluded. A live tip whose objects are not here excludes nothing, and neither does
    # the stale tracking ref of that branch: origin may have force-pushed it, and the ancestry check
    # needs the tip's objects (Codex pass 11). With --fetch those tips are downloaded first; whatever
    # is still missing makes the count an overcount (`local_only_verified` false) and the verdict not
    # clean.
    # Every live head and tag tip (an annotated tag: its object and its peeled commit) is excluded; the
    # tip count for `origin tips not fetched` takes one commit per head and per tag.
    tips = (sorted({*branches.values(), *(o for pair in tags.values() for o in pair)})[:MAX_TIPS]
            if branches is not None and live else [])
    check_tips = (sorted({*branches.values(), *(eff for _, eff in tags.values())})[:MAX_TIPS]
                  if branches is not None and live else [])
    tips_missing = 0

    def tip_state() -> tuple[int | None, set[str], int]:
        """(live tips whose object is missing here, present tips that are not commits, rc). A tag on a tree
        or blob reaches no commit: nothing to exclude, nothing to fetch, never "missing" for good
        (git.git `junio-gpg-pub`, linux `v2.6.11-tree`; adversary round 21, 2). None when git failed."""
        rc, out = git(path, "cat-file", "--batch-check", stdin_text="".join(f"{o}\n" for o in check_tips))
        rows = out.splitlines()
        if rc != 0 or len(rows) != len(check_tips):
            return None, set(), rc
        kinds = [r.split() for r in rows]
        return (sum(1 for k in kinds if k[-1] == "missing"),
                {o for o, k in zip(check_tips, kinds) if len(k) >= 2 and k[1] != "commit" and k[-1] != "missing"}, rc)

    if check_tips:
        tips_missing, noncommit, rc = tip_state()
        if tips_missing is None:
            return incomplete_record(path, "cat-file --batch-check", rc)
        if tips_missing and fetch and not credential:
            # only a ref whose local copy differs from its live tip can be missing
            local_refs = local_origin_refs(path) or {}
            local_tags = local_tag_refs(path) or {}
            stale = ([f"refs/heads/{b}" for b, sha in sorted(branches.items()) if local_refs.get(b) != sha]
                     + [f"refs/tags/{t}" for t, (oid, eff) in sorted(tags.items())
                        if local_tags.get(t) != oid and eff not in noncommit])
            if stale:
                # belt and braces: `ls_remote_refs` already dropped such names; a `:` or whitespace in
                # one would make it a `<src>:<dst>` refspec that writes a local ref
                refspecs = [r for r in stale if ":" not in r and not any(c.isspace() for c in r)]
                git(path, "-c", "maintenance.auto=false", "-c", "gc.auto=0", "fetch", "--quiet",
                    "--no-auto-maintenance", "--no-write-fetch-head", "--no-tags", "--refmap=",
                    "--no-recurse-submodules", "--no-prune", "--", "origin",
                    *refspecs[:MAX_BRANCH_COUNTS], timeout=120, network=True)
                tips_missing, _, rc = tip_state()
                if tips_missing is None:
                    return incomplete_record(path, "cat-file --batch-check", rc)
    # the stash itself is counted and captured on its own, but the commit an entry was made on (its first parent) is
    # reachable from nothing else once its branch is deleted: it counts like any ref, against origin (adversary round
    # 51 on PR 27, MEDIUM; the `--exclude=refs/stash` below leaves out the stash commits, not their ancestry)
    bases: list[str] = []
    stash_commits: set[str] = set()  # each entry's commit, its index commit and its untracked-files commit: captured by the stash row
    if stashes:
        rc, out = git(path, "log", "-g", "--format=%H %P", "refs/stash")
        if rc != 0:
            return incomplete_record(path, "log -g refs/stash", rc)
        for line in out.splitlines():
            f = line.split()
            if f:
                stash_commits.update([f[0], *f[2:4]])
        # the tip's own base, whatever its reflog says: an expired or absent reflog leaves `refs/stash` with no entries
        # (adversary round 52 on PR 27, MEDIUM; `rev-parse` exits 1 only for "no such revision"). An older entry's base is
        # not added here: the reflog count below carries it, with the pack that holds it, so it is counted once (round 53)
        rc, out = git(path, "rev-parse", "--verify", "--quiet", "refs/stash^1")
        if rc not in (0, 1):
            return incomplete_record(path, "rev-parse refs/stash^1", rc)
        bases.extend(out.split())
        bases = list(dict.fromkeys(bases))  # one rev once: a stash reflog near its cap would overflow argv (round 52 INFO 5)
    local_only: int | None = 0
    local_only_branches: list[dict] = []
    local_only_tags: list[dict] = []
    other_ref_commits = 0  # local-only commits reachable only from refs outside refs/heads and refs/tags
    branches_uncounted = 0
    uncounted_tags: set[str] = set()
    if unborn:
        # HEAD names no commit, but another namespace (`refs/custom/*`, `refs/notes/*`) may still hold work: count every
        # local ref the same way, minus the unborn `HEAD` (Codex pass 45 on PR 27). The per-branch breakdown is empty
        local_only, rc = local_only_count(path, ["--exclude=refs/remotes/*", "--exclude=refs/stash", "--all", *bases],
                                          tips, live, has_origin)
        if local_only is None:
            return incomplete_record(path, "rev-list --count --all --not --remotes=origin", rc)
    if not unborn:
        # every local ref, not only heads and tags: a commit reachable only from `refs/notes/*`, `refs/replace/*` or
        # any other namespace is local work too (Codex pass 25 on PR 27). Remote-tracking refs are no local work
        # and the stash is counted and captured on its own (`--exclude` binds to the `--all` that follows it)
        local_only, rc = local_only_count(path, ["HEAD", "--exclude=refs/remotes/*", "--exclude=refs/stash", "--all", *bases],
                                          tips, live, has_origin)
        if local_only is None:
            return incomplete_record(path, "rev-list --count HEAD --all --not --remotes=origin", rc)
        if local_only:
            # a push of branches and tags leaves behind a commit only a `refs/custom/*` ref holds (Codex pass 53, P1)
            n_bt, rc = local_only_count(path, ["HEAD", "--branches", "--tags"], tips, live, has_origin)
            if n_bt is None:
                return incomplete_record(path, "rev-list --count HEAD --branches --tags --not --remotes=origin", rc)
            other_ref_commits = max(local_only - n_bt, 0)
            if detached:
                n, rc = local_only_count(path, ["HEAD"], tips, live, has_origin)
                if n is None:
                    return incomplete_record(path, "rev-list --count HEAD --not --remotes=origin", rc)
                if n:
                    local_only_branches.append({"branch": "HEAD", "count": n})
            rc, out = git(path, "for-each-ref", "--format=%(refname:strip=2)", "refs/heads")
            if rc != 0:
                return incomplete_record(path, "for-each-ref refs/heads", rc)
            names = out.splitlines()
            for name in names[:MAX_BRANCH_COUNTS]:
                n, rc = local_only_count(path, [f"refs/heads/{name}"], tips, live, has_origin)
                if n is None:
                    return incomplete_record(path, f"rev-list --count refs/heads/{name} "
                                                   "--not --remotes=origin", rc)
                if n:
                    local_only_branches.append({"branch": name, "count": n})
            rc, out = git(path, "for-each-ref", "--format=%(refname:strip=2)", "refs/tags")
            if rc != 0:
                return incomplete_record(path, "for-each-ref refs/tags", rc)
            tag_names = out.splitlines()
            tag_budget = max(MAX_BRANCH_COUNTS - len(names[:MAX_BRANCH_COUNTS]), 0)  # one cap for both lists
            uncounted_tags = set(tag_names[tag_budget:])  # their commits are unknown: never "count 0" (round 37)
            for name in tag_names[:tag_budget]:
                n, rc = local_only_count(path, [f"refs/tags/{name}"], tips, live, has_origin)
                if n is None:
                    return incomplete_record(path, f"rev-list --count refs/tags/{name} "
                                                   "--not --remotes=origin", rc)
                if n:
                    local_only_tags.append({"tag": name, "count": n})
            branches_uncounted = (max(len(names) - MAX_BRANCH_COUNTS, 0)
                                  + max(len(tag_names) - tag_budget, 0))
        if live:
            # a local tag whose commit origin already has is still local work: its name, annotation and signature
            # exist nowhere else, and no commit count sees a tag object (Codex pass 31 on PR 27). Only a live
            # origin answer lists origin's tags, so without --remote nothing is claimed about them
            local_tags = local_tag_refs(path)
            if local_tags is None:
                return incomplete_record(path, "for-each-ref refs/tags", 1)
            counted = {t["tag"] for t in local_only_tags} | uncounted_tags
            zero = [{"tag": name, "count": 0} for name, oid in sorted(local_tags.items())
                    if name not in counted and tags.get(name, ("", ""))[0] != oid]
            # bounded like the counted refs: a fork that fetched an upstream's 3000 tags must not itemise them all
            # (adversary round 37); the rest is a count, as for branches
            local_only_tags += zero[:MAX_BRANCH_COUNTS]
            branches_uncounted += max(len(zero) - MAX_BRANCH_COUNTS, 0)
    if live and on_origin is False and ahead_of_origin and not unborn:
        # the branch is not on origin but its commits may be, under a live tag or a branch with no local tracking
        # ref: count HEAD against the live tips, like the local-only count, before calling it an orphan (Codex pass 19)
        n, rc = local_only_count(path, ["HEAD"], tips, live, has_origin)
        if n is None:
            return incomplete_record(path, "rev-list --count HEAD --not <live tips>", rc)
        ahead_of_origin = n
    # a commit a reset, amend or rebase left behind is reachable from a reflog alone: no ref holds it, so no count
    # above sees it, yet `git reflog` recovers it until expiry (Codex pass 32 on PR 27). Stash entries have their
    # own count and capture: every entry of the stash reflog is excluded with its ancestors. An unborn HEAD is
    # counted too: a branch deleted after `switch --orphan` leaves its commits in the HEAD reflog alone, and the
    # command is well defined in an empty repository (adversary round 38)
    argv = ["rev-list", "--reflog", "--not", "--all"]
    if not stash_commits:
        argv.insert(1, "--count")
    if live and tips:
        argv += ["--ignore-missing", *tips]
    rc, n = git(path, *argv)
    if stash_commits:
        # list, then drop the stash entries' own commits: the stash row captures those, but the commit an older entry
        # was made on lives in the reflog alone and `--all` in the local-only bundle does not reach it, so it counts
        # here and gets the reflog pack (adversary round 52 on PR 27, MEDIUM 1)
        if rc == 0:
            n = str(len([h for h in n.split() if h not in stash_commits]))
    if rc != 0 or not n.strip().isdigit():
        return incomplete_record(path, "rev-list --count --reflog --not --all", rc)
    reflog_only: int = int(n)
    flags = []
    if unpushed or (on_origin and (ahead_of_origin or 0) > 0):
        flags.append("unpushed commits")  # includes a branch on origin with no upstream set
    if on_origin is False and (ahead_of_origin or 0) > 0 and not unpushed:
        flags.append("orphan branch")
    if local_only:
        if not flags:
            flags.append("unpushed commits")  # only on another branch, or origin not known
        if detached:
            flags.append("detached")
        elif on_origin is None:
            flags.append("origin unknown")
        entries = ([f"{b['branch']} {b['count']}" for b in local_only_branches]
                   + [f"tag {t['tag']} {t['count']}" for t in local_only_tags if t["count"]])
        shown = ", ".join(entries[:5])
        more = len(entries) - 5
        flags.append("local-only commits: " + (shown or f"{local_only} in total")
                     + (f", +{more} more" if more > 0 else ""))
    zero_tags = [t["tag"] for t in local_only_tags if not t["count"]]
    if zero_tags:
        # the tag is unpushed although its commit is not: a primary flag, never `clean and pushed`; the names go
        # in a second flag so the verdict histogram keeps one bucket (adversary round 37)
        flags.append("unpushed tags")
        flags.append("unpushed tag names: " + ", ".join(zero_tags[:5])
                     + (f", +{len(zero_tags) - 5} more" if len(zero_tags) > 5 else ""))
    if index_hidden:
        flags.append(f"index-hidden paths: {index_hidden}")  # primary: `status` cannot see edits there
    if embedded:
        flags.append(f"embedded repositories: {len(embedded)}")  # primary: the untracked archive holds an empty entry for each
    if reflog_only:
        flags.append(f"reflog-only commits: {reflog_only}")  # primary: recoverable only until the reflog expires
    if credential and remote:
        flags.append(ORIGIN_CREDENTIAL)  # not queried: unreachable in every respect
    elif origin_unreachable:
        flags.append(ORIGIN_UNREACHABLE)
    if tip_unverified:
        flags.append("origin tip not fetched")
    if tips_missing:
        flags.append(f"{TIPS_NOT_FETCHED}{tips_missing}")
    if invalid_refs:
        flags.append(f"{INVALID_REFS}{invalid_refs}")
    if not has_origin:
        flags.append("no origin remote")
    if lines:
        flags.append("dirty")
    if has_submodules:
        flags.append(SUBMODULES_FLAG)
    if stashes:
        flags.append("stash")
    primary = next((f for f in flags if f not in INFO_FLAGS), "clean and pushed")
    return {
        "path": str(path), "branch": branch, "modified": len(modified), "untracked": len(untracked),
        "untracked_sample": untracked[:8], "modified_sample": modified[:8],
        "local_only_other_refs": other_ref_commits,
        "embedded_repos": embedded, "embedded_pointer_repos": embedded_pointers, "lfs_store": lfs_store,
        "upstream": upstream, "unpushed": unpushed if upstream else "no upstream",
        "ahead_of_origin": ahead_of_origin, "stashes": stashes,
        "index_hidden": index_hidden, "reflog_only_commits": reflog_only,
        # the paths the plan may run git at: checked-out submodules the scan vetted (`submodule_config_check`); the
        # doc renders one quoted command set per path, so nothing is ever typed or pasted into a template (round 47)
        "submodules_vetted": submodules_vetted,
        "local_only_commits": local_only,
        # only a live `--remote` answer verifies anything: true when no live tip is missing, false when
        # one is or when `--remote` asked and origin did not answer (a failed query is unverified, not "not
        # asked"), null when --remote was not given (the count then trusts the local refs)
        "local_only_verified": False if origin_unreachable else ((tips_missing == 0) if live else None),
        "invalid_origin_refs": invalid_refs,
        "local_only_branches": local_only_branches,
        "local_only_tags": local_only_tags,
        "local_only_branches_uncounted": branches_uncounted,
        "has_origin": has_origin,
        # whatever the mode: the capture plan must never print a push for such a url (adversary round 39: the
        # `not queried` flag is `--remote`-only, and a default scan still got push rows); the url itself is in no record
        "origin_credential": bool(credential),
        # a push to a path or `file://` origin runs that repository's receive hooks: bundle only (adversary round 54)
        "origin_local_path": bool(has_origin) and push_urls_run_local_receive(path),
        "on_origin": "unknown" if on_origin is None else on_origin,
        "flags": flags, "verdict": primary,
    }


def scan_git(roots: list[Path], remote: bool, fetch: bool = False) -> list[dict]:
    seen, out = set(), []
    for root in roots:
        unreadable: list[tuple[Path, str]] = []
        found = find_checkouts(root, unreadable)
        for bad, err in unreadable:
            real = bad.resolve()
            if real in seen:
                continue
            seen.add(real)
            rec = skipped_record(real, f"{INCOMPLETE_PREFIX}scandir {err}")
            rec["found_via"] = str(bad)
            out.append(rec)
        for co in found:
            real = co.resolve()
            if real in seen:
                continue
            seen.add(real)
            rec = scan_checkout(real, remote, fetch)
            rec["found_via"] = str(co)
            out.append(rec)
    return out


def human(n: int) -> str:
    v = float(n)
    for unit in ("B", "K", "M", "G", "T"):
        if v < 1024 or unit == "T":
            return f"{v:.0f}{unit}" if unit == "B" else f"{v:.1f}{unit}"
        v /= 1024
    return str(n)


def summarize(result: dict) -> dict:
    s = {}
    bt = result.get("bigteam")
    if bt:
        verdicts: dict[str, int] = {}
        for t in bt["tasks"]:
            verdicts[t["verdict"]] = verdicts.get(t["verdict"], 0) + 1
        total = sum(t["bytes"] for t in bt["tasks"])
        uniq = sum(t["unique_bytes"] for t in bt["tasks"])
        s["bigteam"] = {"tasks": len(bt["tasks"]), "verdicts": verdicts, "total_bytes": total,
                        "unique_bytes": uniq, "scratch_bytes": total - uniq,
                        "incomplete": sum(1 for t in bt["tasks"]
                                          if t["verdict"].startswith(INCOMPLETE_PREFIX))}
    if "checkouts" in result:
        v: dict[str, int] = {}
        for c in result["checkouts"]:
            v[c["verdict"]] = v.get(c["verdict"], 0) + 1
        s["checkouts"] = {
            "count": len(result["checkouts"]), "verdicts": v,
            "with_unpushed_work": sum(1 for c in result["checkouts"]
                                      if "unpushed commits" in c["flags"]
                                      or "orphan branch" in c["flags"]
                                      or "unpushed tags" in c["flags"]),
            "with_local_only_commits": sum(1 for c in result["checkouts"]
                                           if (c.get("local_only_commits") or 0) > 0),
            "with_untracked": sum(1 for c in result["checkouts"] if c["untracked"]),
            "with_stash": sum(1 for c in result["checkouts"] if c["stashes"]),
            "skipped": sum(1 for c in result["checkouts"] if c["verdict"].startswith("skipped")),
            "incomplete": sum(1 for c in result["checkouts"]
                              if c["verdict"].startswith(INCOMPLETE_PREFIX))}
    return s


_CTRL = re.compile(r"[\x00-\x1f\x7f]")


def esc(value) -> str:
    """One markdown table cell: `|` and backticks escaped, `<`, `>`, `&` HTML-escaped, every control character
    (newline, a bare CR that CommonMark ends a line at, tab, ...) shown as backslash-n, -r, -t or -xNN text."""
    if value is None:
        return "-"
    text = str(value).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
    text = text.replace("|", "\\|").replace("`", "\\`")
    named = {"\n": "\\n", "\r": "\\r", "\t": "\\t"}
    return _CTRL.sub(lambda m: named.get(m.group()) or f"\\x{ord(m.group()):02x}", text)


def markdown(result: dict) -> str:
    out = []
    bt = result.get("bigteam")
    if bt:
        out += ["| task | size | newest | CLAIM | reports (.done) | open jobs | verdict |",
                "|---|---|---|---|---|---|---|"]
        for t in sorted(bt["tasks"], key=lambda t: -t["bytes"]):
            reps = ", ".join(f"{esc(Path(r['path']).name)}{'' if r['done'] else ' (no .done)'}"
                             for r in t["reports"][:3]) + (" +%d" % (len(t["reports"]) - 3)
                                                            if len(t["reports"]) > 3 else "")
            when = time.strftime("%Y-%m-%d", time.localtime(t["newest_mtime"]))
            out.append(f"| {esc(t['task'])} | {human(t['bytes'])} | {when} | {esc(t['claim'])} | "
                       f"{reps or '-'} | {len(t['open_job_records'])} | {esc(t['verdict'])} |")
        out.append("")
    if "checkouts" in result:
        out += ["| path | branch | modified | untracked | unpushed | stash | on origin | verdict |",
                "|---|---|---|---|---|---|---|---|"]
        for c in result["checkouts"]:
            also = ", ".join(c["flags"][1:])
            out.append(f"| {esc(c['path'])} | {esc(c['branch'])} | {esc(c['modified'])} | "
                       f"{esc(c['untracked'])} | {esc(c['unpushed'])} | {esc(c['stashes'])} | "
                       f"{esc(c['on_origin'])} | {esc(c['verdict'])}{esc(' + ' + also) if also else ''}"
                       f" |")
    return "\n".join(out)


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="ade-scan-state", description=__doc__.split("\n\n")[0])
    ap.add_argument("--bigteam", type=Path, help="bigteam root, one dir per task")
    ap.add_argument("--ref-root", type=Path, action="append", default=[],
                    help="where a task name counts as referenced (repeatable)")
    ap.add_argument("--exclude", action="append", default=[],
                    help="rg glob (no leading !) to ignore under --ref-root, added to the built-in "
                         "%s (the scan docs)" % ", ".join(DEFAULT_EXCLUDES))
    ap.add_argument("--git-root", type=Path, action="append", default=[],
                    help="a dir whose checkouts (up to 2 levels down, repositories nested in a checkout "
                         "included) are scanned; symlinks under it are not followed (repeatable)")
    ap.add_argument("--remote", action="store_true",
                    help="ask origin with `git ls-remote --heads --tags origin` (network call, run outside the "
                         "checkout; the first `remote.origin.url`, a path resolved against the checkout, "
                         "reaches git through GIT_CONFIG_COUNT/KEY_0/VALUE_0 (git 2.31+), never argv; an "
                         "older git is not asked and the checkout is `origin unreachable`); an origin url "
                         "with a password, or a username or query string on a non-ssh scheme (a `<transport>::` prefix stripped first), or one that names a remote helper (`<transport>::<address>`, a `<scheme>://` git does not implement), is never queried (`origin url holds a credential or names a remote helper: not queried`, "
                         "treated like `origin unreachable`); "
                         "its live tips, not the local refs/remotes/origin/* (stale after a "
                         "branch is deleted there), then decide what is pushed; an origin that does not "
                         "answer, or answers with more than 16 MiB of refs (killed at that size, no part of it "
                         "used), makes the checkout `origin unreachable`, never clean and pushed; origin's "
                         "answer is trusted as given: a lying origin can hide any local commit by naming "
                         "it as a branch, tag or peeled tip")
    ap.add_argument("--fetch", action="store_true",
                    help="with --remote: `git fetch origin refs/heads/<branch>` (120 s limit) when the "
                         "origin tip's objects are missing locally, to compare it with HEAD; downloads "
                         "the branch's objects, writes no refs and no FETCH_HEAD. Nothing bounds how much "
                         "origin sends (the 120 s limit bounds the time): use it on origins you trust (a fetch killed at the limit can leave an `objects/pack/tmp_pack_*` file)")
    ap.add_argument("--unique-max-bytes", type=int, default=5 * 1024 * 1024)
    ap.add_argument("--top", type=int, default=10, help="largest bigteam dirs to break down")
    fmt = ap.add_mutually_exclusive_group()
    fmt.add_argument("--json", action="store_true")
    fmt.add_argument("--markdown", action="store_true")
    args = ap.parse_args(argv)
    if not args.bigteam and not args.git_root:
        ap.error("give --bigteam and/or --git-root")
    for root in args.git_root:
        if not root.is_dir():
            ap.error(f"--git-root {root} is not a directory")
    for root in args.ref_root:
        # a root that is missing, unlistable or not searchable (r-- is listable) would silently narrow the
        # reference search, so a task cited only there would read `unique` (Codex pass 6)
        if not root.is_dir():
            ap.error(f"--ref-root {root} is not a directory")
        if not os.access(root, os.R_OK | os.X_OK):
            ap.error(f"--ref-root {root} cannot be searched")
    result: dict = {"scanned_at": time.strftime("%Y-%m-%dT%H:%M:%S%z")}
    if args.bigteam:
        if not args.bigteam.is_dir():
            ap.error(f"--bigteam {args.bigteam} is not a directory")
        try:
            with os.scandir(args.bigteam):
                pass
        except OSError as exc:
            ap.error(f"--bigteam {args.bigteam} cannot be listed ({errno_name(exc)})")
        result["bigteam"] = scan_bigteam(args.bigteam, args.ref_root, args.exclude,
                                         args.unique_max_bytes, args.top)
    if args.git_root:
        result["checkouts"] = scan_git(args.git_root, args.remote, args.fetch)
    result["summary"] = summarize(result)
    if args.json:
        json.dump(result, sys.stdout, indent=1)
        print()
    elif args.markdown:
        print(markdown(result))
    else:
        print(json.dumps(result["summary"], indent=1))
    return 0


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env bash
# fleet-watch — zero-token status of agent work and the phones, notifying only on change.
#
#   fleet-watch            one check: print the status line, notify if it changed
#   fleet-watch status     print the last status line and when it was taken
#   fleet-watch test-notify  send a test notice to Hermes (Telegram Inbox)
#   fleet-watch install    write the launchd agent (every 5 min) and load it
#   fleet-watch uninstall  unload and remove the launchd agent
#
# Replaces a model-driven "status report every N minutes", which re-sent the whole
# conversation each time. This runs no model: it reads processes and each phone's
# last repair STATUS line over ssh, keeps the result in ~/.local/state/fleet-watch,
# and, only when something changed, sends a notice to the operator's Hermes
# Telegram Inbox topic (no macOS notification).
#
# helm: agent sessions blocked on the operator, from the helm skill's no-model collector
# (`helm.py brief`). A notice goes out only when a session starts waiting or asks a new
# question, never when one is answered. Added 2026-10-06.
#
# Phones: FLEET_WATCH_HOSTS (default "s24 p7a t2e hd8"; ssh aliases). hd8 was left
# out until 2026-10-05, when the operator asked for it back in.
#
# GitHub repos: FLEET_WATCH_REPOS (default "pkb-rocks/plektra", added 2026-10-06: notify
# when Plektra, Pastiera's successor, first publishes code so the private port can move).
# Each repo is "<head sha>/<release count>", fetched with gh at most every
# FLEET_WATCH_REPO_INTERVAL seconds (default 3600) and cached in between; a failed fetch
# keeps the cached value, so a network blip is not reported as a change.
#
# Wedged sshd (2026-10-10): a phone's Termux sshd can wedge - listening on 8022 but
# never accepting, the accept queue fills (Recv-Q over the backlog in ss -ltn), and
# every ssh from the Mac then hangs (that is what stalled bootstrap_ssh.py for 56 min
# on 2026-10-08). Each check also TCP-connects to every phone's ssh address and waits
# for the SSH-2.0 banner, a hard timeout per phase (FLEET_WATCH_SSHD_TIMEOUT, default
# 5s): "connected but no banner", or "connect timed out while adb still lists the
# phone", is wedged; a notice goes out only on the wedged<->ok transitions, with the
# Recv-Q line from a read-only `adb shell ss -ltn` as evidence. Every network probe
# in a run is bounded (the phone ssh included: ConnectTimeout does not cover the
# banner wait), so one wedged phone cannot stall the checks of the rest.

set -uo pipefail

LABEL=com.djbclark.fleet-watch
STATE_DIR="$HOME/.local/state/fleet-watch"
LAST="$STATE_DIR/last"
LOG="$STATE_DIR/fleet-watch.log"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
HOSTS="${FLEET_WATCH_HOSTS:-s24 p7a t2e hd8}"
INTERVAL="${FLEET_WATCH_INTERVAL:-300}"
REPOS="${FLEET_WATCH_REPOS-pkb-rocks/plektra}"
REPO_INTERVAL="${FLEET_WATCH_REPO_INTERVAL:-3600}"
# Per-probe hard caps (2026-10-10): phone ssh, the wedged-sshd banner probe, and
# the adb evidence calls. Seconds; TERM then KILL(2s later) via runb below.
PHONE_TIMEOUT="${FLEET_WATCH_PHONE_TIMEOUT:-12}"
SSHD_PROBE_TIMEOUT="${FLEET_WATCH_SSHD_TIMEOUT:-5}"
ADB_TIMEOUT="${FLEET_WATCH_ADB_TIMEOUT:-5}"
HELM_TIMEOUT="${FLEET_WATCH_HELM_TIMEOUT:-15}"
GH_TIMEOUT="${FLEET_WATCH_GH_TIMEOUT:-30}"
SSHD_EV_PREFIX="$STATE_DIR/sshd-ev"
# Socket probes run under system python3, never bash's /dev/tcp: macOS SIGKILLs
# homebrew bash the moment its socket connects, in the launchd context (kernel
# "[bash: killed]", observed 2026-10-10); system binaries are exempt there.
PY3=/usr/bin/python3
[[ -x "$PY3" ]] || PY3=python3

mkdir -p "$STATE_DIR"

# Where change notices go: the operator's Hermes Telegram Inbox topic (see
# memory/feedback_ping_telegram_and_chat.md); nothing else.
HERMES="${FLEET_WATCH_HERMES:-$HOME/.local/bin/hermes}"
HERMES_TO="${FLEET_WATCH_TO:-telegram:838808636:22158}"

notify() {
  # Hermes only: the operator does not want macOS notifications (2026-10-05).
  # hermes send fails loudly (non-zero) on a dead transport; record that rather
  # than pretend the operator was told.
  # hermes-ping adds where the notice comes from (launchd com.djbclark.fleet-watch).
  if ! HERMES_BIN="$HERMES" HERMES_PING_TARGET="$HERMES_TO" \
       "$HOME/.local/bin/hermes-ping" "$1: $2" >>"$STATE_DIR/hermes.log" 2>&1; then
    printf '%s hermes send FAILED for: %s\n' "$(date '+%F %T')" "$2" >>"$LOG"
  fi
}

count() { pgrep -f "$1" 2>/dev/null | wc -l | tr -d ' '; }

runb() {
  # Bounded run (2026-10-10): coreutils timeout (TERM, then KILL 2s later) when on
  # PATH, else bare - the old unbounded behaviour, for a PATH without it.
  local t=$1
  shift
  if command -v timeout >/dev/null 2>&1; then timeout -k 2 "$t" "$@"; else "$@"; fi
}

HELM="${FLEET_WATCH_HELM:-$HOME/ops/site-private/skills/helm/helm.py}"

waiting() {
  # "N:project@id/mark,..." for sessions blocked on the operator; "unknown" if helm is missing.
  local t
  t=$(runb "$HELM_TIMEOUT" python3 -I "$HELM" brief 2>/dev/null) && [[ "$t" == *:* ]] && echo "$t" || echo "unknown"
}

phone() {
  # One word per phone: down (no ssh), stale (no repair pass for 40 min), or
  # the repair line's shizuku state, with "+unanswered" when the key is not accepted.
  # runb-bounded (2026-10-10): a wedged sshd accepts the TCP connect but never sends
  # a banner, which ConnectTimeout does not cover; unbounded it hung the whole check.
  # Bounded it just reports down, and the sshd watchdog below says why.
  local h=$1 line
  line=$(runb "$PHONE_TIMEOUT" ssh -o ConnectTimeout=6 -o BatchMode=yes "$h" \
    'f=~/.stayturgid/logs/repair.log; tail -1 "$f" 2>/dev/null; echo; date +%s; stat -c %Y "$f" 2>/dev/null' 2>/dev/null) || {
    echo "down"
    return
  }
  local status now mtime shz auth
  status=$(printf '%s\n' "$line" | sed -n 1p)
  now=$(printf '%s\n' "$line" | sed -n 3p)
  mtime=$(printf '%s\n' "$line" | sed -n 4p)
  if [[ -n "$now" && -n "$mtime" ]] && ((now - mtime > 2400)); then
    echo "stale"
    return
  fi
  shz=$(grep -o 'shizuku=[a-z]*' <<<"$status" | head -1 | cut -d= -f2)
  auth=$(grep -o 'shizuku_auth=[a-z]*' <<<"$status" | head -1 | cut -d= -f2)
  echo "${shz:-unknown}${auth:+$([[ $auth == unanswered ]] && echo +unanswered)}"
}

adb_up() {
  # True when adb lists the phone (serial <ip>:5555) in state "device": reachable
  # on adb even though its sshd may not be answering. Read-only.
  runb "$ADB_TIMEOUT" adb devices 2>/dev/null |
    grep "^$1:5555[[:space:]][[:space:]]*device$" >/dev/null
}

ss_ev() {
  # Read-only evidence from the phone: the :<port> listen lines from ss -ltn.
  # A wedged sshd shows Recv-Q pinned at/over the backlog (129 on 128 seen on
  # t2e), a healthy one 0. adb or ss unavailable -> say so, not silence.
  local l
  l=$(runb "$ADB_TIMEOUT" adb -s "$1:5555" shell ss -ltn 2>/dev/null |
    grep ":$2[[:space:]]" | tr -s '[:space:]' ' ')
  printf '%s' "${l:-"no :$2 line from ss -ltn (adb or ss unavailable)"}"
}

sshd_ev() {
  sed -n 1p "$SSHD_EV_PREFIX-$1" 2>/dev/null
}

sshd_probe() {
  # Wedged-sshd check for one phone (2026-10-10). Resolves the ssh alias to
  # host:port locally (ssh -G, no network; "host:port" is taken literally),
  # then TCP-connects and waits for the SSH-2.0 banner under hard timeouts
  # (per phase, plus a runb cap over the whole probe), so a wedged phone cannot
  # stall the checks of the rest.
  # Sets SSHD_STATE to ok | wedged | unknown and leaves one line of evidence in
  # "$SSHD_EV_PREFIX-<alias>" for the change notice:
  #   ok      banner received (the sshd answers and accepts)
  #   wedged  connected but no SSH-2.0 banner, or connect timeout while adb_up;
  #           evidence adds the ss -ltn line when adb answers
  #   unknown refused, connect timeout with the phone gone from adb, or a probe
  #           error - abstains (no notice; phone=down already covers offline)
  local h=$1 ip port banner rc ev
  if [[ "$h" == *:* && "$h" != *@* ]]; then
    ip=${h%%:*}; port=${h##*:}
  else
    read -r ip port <<<"$(runb "$ADB_TIMEOUT" ssh -G "$h" 2>/dev/null |
      awk '/^hostname /{printf "%s ", $2} /^port /{printf "%s ", $2}')"
    ip=${ip:-}; port=${port:-}
  fi
  if [[ -z "$ip" || -z "$port" ]]; then
    SSHD_STATE=unknown
    printf '%s\n' "ssh alias $h did not resolve" >"$SSHD_EV_PREFIX-$h"
    return
  fi
  banner=$(runb "$((SSHD_PROBE_TIMEOUT * 2 + 2))" "$PY3" - "$ip" "$port" "$SSHD_PROBE_TIMEOUT" 2>/dev/null <<'PYEOF'
import socket
import sys

ip, port, tmo = sys.argv[1], int(sys.argv[2]), float(sys.argv[3])
try:
    s = socket.create_connection((ip, port), timeout=tmo)
except ConnectionRefusedError:
    sys.exit(10)  # nothing listening
except OSError:
    sys.exit(11)  # no route to the address, or the connect timed out
data = b""
try:
    s.settimeout(tmo)
    while b"\n" not in data and len(data) < 256:
        chunk = s.recv(64)
        if not chunk:
            break
        data += chunk
except OSError:
    if not data:
        sys.exit(12)  # connected, the banner never came
finally:
    try:
        s.close()
    except OSError:
        pass
if not data:
    sys.exit(13)  # connected, closed before sending anything
sys.stdout.write(data.split(b"\n", 1)[0].decode("utf-8", "replace").strip())
sys.exit(0)
PYEOF
)
  rc=$?
  banner=${banner%$'\r'}
  case $rc in
    0)
      if [[ "$banner" == SSH-2.0-* || "$banner" == SSH-1.99-* ]]; then
        SSHD_STATE=ok
        ev="banner ${banner:0:60}"
      else
        SSHD_STATE=wedged
        ev="connected to $ip:$port but no SSH-2.0 banner in ${SSHD_PROBE_TIMEOUT}s"
        [[ -n "$banner" ]] && ev="connected to $ip:$port but the banner is not SSH-2.0: ${banner:0:60}"
      fi
      ;;
    12 | 13)
      SSHD_STATE=wedged
      ev="TCP connect to $ip:$port ok but no SSH-2.0 banner in ${SSHD_PROBE_TIMEOUT}s"
      ;;
    11)
      if adb_up "$ip"; then
        SSHD_STATE=wedged
        ev="connect to $ip:$port timed out after ${SSHD_PROBE_TIMEOUT}s while adb lists the phone up"
      else
        SSHD_STATE=unknown
        ev="connect to $ip:$port timed out after ${SSHD_PROBE_TIMEOUT}s and adb does not list it (offline?)"
      fi
      ;;
    10)
      SSHD_STATE=unknown
      ev="connection refused on $ip:$port (sshd not listening?)"
      ;;
    *)
      SSHD_STATE=unknown
      ev="probe error rc=$rc"
      ;;
  esac
  if [[ "$SSHD_STATE" == wedged ]] && adb_up "$ip"; then
    ev="$ev; ss -ltn: $(ss_ev "$ip" "$port")"
  fi
  printf '%s\n' "$ev" >"$SSHD_EV_PREFIX-$h"
}

repo() {
  # "<head sha>/<releases>" for a GitHub repo, from a cache refreshed at most every REPO_INTERVAL.
  local r=$1 cache="$STATE_DIR/repo-${1//\//_}" now sha rels
  now=$(date +%s)
  if [[ -f "$cache" ]] && ((now - $(stat -f %m "$cache") < REPO_INTERVAL)); then
    cat "$cache"
    return
  fi
  sha=$(runb "$GH_TIMEOUT" gh api "repos/$r/commits?per_page=1" --jq '.[0].sha[0:7]' 2>/dev/null)
  rels=$(runb "$GH_TIMEOUT" gh api "repos/$r/releases?per_page=100" --jq 'length' 2>/dev/null)
  if [[ -n "$sha" && -n "$rels" ]]; then
    echo "$sha/$rels" | tee "$cache"
  elif [[ -f "$cache" ]]; then
    cat "$cache"
  else
    echo "unknown"
  fi
}

check() {
  local agents builds deploys parts=() h sshdk=""
  # The agent itself (uv's python running acp-run), not the shell or uv wrapper around it.
  agents=$(count 'bin/python[0-9.]* [^ ]*/site-private/bin/acp-run ')
  # A running build, not an idle Gradle daemon left over from an earlier one.
  builds=$(count 'GradleWrapperMain')
  deploys=$(count 'deploy_fleet.py')
  parts+=("agents=$agents" "builds=$builds" "deploy=$deploys" "helm=$(waiting)")
  for h in $HOSTS; do parts+=("$h=$(phone "$h")"); done
  # Wedged sshd (2026-10-10): one state word per phone; the notice text comes
  # from sshd_probe's evidence file, and only the wedged<->ok transitions speak.
  for h in $HOSTS; do
    sshd_probe "$h"
    parts+=("${h}sshd=$SSHD_STATE")
    sshdk+="${h}sshd "
  done
  local r
  for r in $REPOS; do parts+=("$r=$(repo "$r")"); done
  local now_line="${parts[*]}"
  local prev_line=""
  [[ -f "$LAST" ]] && prev_line=$(sed -n 2p "$LAST")
  printf '%s\n%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$now_line" >"$LAST"
  echo "$now_line"

  [[ -z "$prev_line" || "$prev_line" == "$now_line" ]] && return 0
  printf '%s %s -> %s\n' "$(date '+%F %T')" "$prev_line" "$now_line" >>"$LOG"

  # Say what changed in words, one notification per run.
  local msgs=() key old new
  for key in agents builds deploy helm $HOSTS $sshdk $REPOS; do
    old=$(tr ' ' '\n' <<<"$prev_line" | grep "^$key=" | cut -d= -f2)
    new=$(tr ' ' '\n' <<<"$now_line" | grep "^$key=" | cut -d= -f2)
    [[ "$old" == "$new" ]] && continue
    case $key in
      agents | builds | deploy)
        if [[ "$new" == 0 ]]; then msgs+=("$key finished"); elif [[ "$old" == 0 ]]; then msgs+=("$key started"); fi
        ;;
      helm)
        # Only what is newly waiting: a token absent from the previous check.
        [[ "$new" == *:* ]] || continue  # helm could not be read: say nothing
        local gained=() tok
        for tok in $(tr ',' ' ' <<<"${new#*:}"); do
          [[ ",${old#*:}," == *",$tok,"* ]] || gained+=("${tok%%@*}")
        done
        ((${#gained[@]})) && msgs+=("helm: ${new%%:*} waiting on you, new: ${gained[*]} (send /helm)")
        ;;
      *sshd)
        # The wedged-sshd watchdog: speak only on the wedged<->ok transitions;
        # unknown (refused / offline / probe error) never notifies on its own.
        [[ "$new" == wedged || "$old" == wedged ]] || continue
        if [[ "$new" == wedged ]]; then
          msgs+=("$key: WEDGED ($(sshd_ev "${key%sshd}"))")
        else
          msgs+=("$key: no longer wedged, now $new ($(sshd_ev "${key%sshd}"))")
        fi
        ;;
      *) msgs+=("$key: ${old:-?} -> $new") ;;
    esac
  done
  ((${#msgs[@]})) && notify "fleet-watch" "$(
    IFS=';'
    echo "${msgs[*]}"
  )"
  return 0
}

case "${1:-check}" in
  check) check ;;
  status)
    if [[ -f "$LAST" ]]; then cat "$LAST"; else echo "no check has run yet"; fi
    ;;
  test-notify) notify "fleet-watch" "test notice: change notices from fleet-watch now arrive here" && tail -2 "$STATE_DIR/hermes.log" ;;
  install)
    cat >"$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$HOME/ops/site-private/bin/fleet-watch</string>
    <string>check</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>$INTERVAL</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>$STATE_DIR/launchd.out</string>
  <key>StandardErrorPath</key><string>$STATE_DIR/launchd.err</string>
</dict>
</plist>
EOF
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$PLIST" && echo "installed: every ${INTERVAL}s, state in $STATE_DIR"
    ;;
  uninstall)
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
    rm -f "$PLIST" && echo "removed $LABEL"
    ;;
  *)
    sed -n '2,8p' "$0"
    exit 1
    ;;
esac

#!/usr/bin/env python3
"""Keep required `env` keys in ~/.claude/settings.json (2026-10-16).

graft's `Stop` hook runs `graft build`, which appends a `/graft/` block to the
repo's tracked `.gitignore` (`ensureGitignored`), even when `.git/info/exclude`
already ignores it. The only off switch is the env var `GRAFT_NO_GITIGNORE=1`,
and the build runs inside hook and MCP child processes that no wrapper on PATH
sees. Claude Code applies the `env` block of settings.json to every child
(hooks, stdio MCP servers, Bash tool), so that block is the one place that
covers them all. settings.json is not tracked here, so this script sets it.
Since 2026-10-23 it also sets CLAUDE_CODE_SUBAGENT_MODEL=sonnet (see REQUIRED):

    claude-settings-env            # add any missing key, print what changed
    claude-settings-env --check    # exit 1 if a key is missing or different

Existing keys not listed in REQUIRED are never touched. The file is replaced
atomically on its realpath, keeping its mode and key order.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import tempfile
from pathlib import Path

REQUIRED = {
    # graft: never write graft/ into the repo's tracked .gitignore
    # (trailhq/Graft#582; honoured by `graft build`, workspace-cli, `--no-gitignore`).
    "GRAFT_NO_GITIGNORE": "1",
    # Agent-tool sub-agents and teammates with no `model` default to Sonnet instead of
    # inheriting an Opus or Fable lead's model (djbclark, 2026-10-23; docs/queue.md
    # "Follow-ups from PRs 29 and 30" item 2). A definition's `model:` or a model passed in
    # the call still wins (Claude Code 2.1.251+); Explore and Plan ignore it.
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
}


def missing(settings: dict, required: dict[str, str]) -> dict[str, str]:
    env = settings.get("env") or {}
    return {k: v for k, v in required.items() if env.get(k) != v}


def apply(path: Path, required: dict[str, str], check: bool) -> int:
    real = path.resolve()
    settings = json.loads(real.read_text())
    todo = missing(settings, required)
    if not todo:
        print(f"ok: {', '.join(required)} already set in {path}")
        return 0
    if check:
        print(f"missing in {path}: {', '.join(f'{k}={v}' for k, v in todo.items())}")
        return 1
    settings.setdefault("env", {}).update(todo)
    fd, tmp = tempfile.mkstemp(dir=real.parent, prefix=real.name + ".")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(json.dumps(settings, indent=2, ensure_ascii=False) + "\n")
        os.chmod(tmp, real.stat().st_mode & 0o7777)
        os.replace(tmp, real)
    except BaseException:
        os.unlink(tmp)
        raise
    print(f"set in {path}: {', '.join(f'{k}={v}' for k, v in todo.items())}")
    return 0


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--check", action="store_true", help="report only; exit 1 if a key is missing")
    ap.add_argument("--settings", type=Path, default=Path.home() / ".claude" / "settings.json")
    args = ap.parse_args(argv)
    return apply(args.settings, REQUIRED, args.check)


if __name__ == "__main__":
    sys.exit(main())

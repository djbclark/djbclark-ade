#!/usr/bin/env -S python3 -I
"""ade-merge-ready: classify open ADE PRs against the merge gate (2026-11-09).

  ade-merge-ready [--repo OWNER/NAME] [--min N] [--json]
  ade-merge-ready stacks [--group NAME] [--bottoms-only] [--repo …] [--min N] [--json]
  ade-merge-ready --help

Read-only. Uses `gh` to list open PRs (number >= --min, default 327), their
pytest-linux / adversary-marker checks. A live APPROVE is taken only from the
`adversary-marker` check (the Action runs `bin/adversary_marker.py`'s
attribution-aware `decide`: owner body editor / owner comment history). Raw
markers in the body or comments are never enough on their own — that would
count an outside author's or bot's same-head APPROVE. Never posts, never
merges, never invents an APPROVE. Prints a table (or JSON) plus paste-ready
templates so an operator can post a real marker.

`stacks` walks open PR base→same-repo head refs and prints bottom-up APPROVE
order for named groups (install, claims, s1, wave6) with full tip SHAs for
marker paste. Parent edges are qualified by head repository (not branch name
alone); ambiguous same-name heads yield no parent (fail-safe). In the default
all-groups view, wave6 prints stack bottoms only (docs on master); pass
`--group wave6` for the full wave6 bottom-up chains.

Classes:
  merge_now       pytest-linux pass + adversary-marker success (attributed APPROVE)
  needs_approve   pytest-linux pass, no attributed APPROVE (typical Wave 6 tip)
  tests_pending   pytest-linux pending / missing
  tests_fail      pytest-linux fail
  conflicting     GitHub mergeable == CONFLICTING
  other           anything else

Exit: 0 always when listing succeeds; 2 usage / gh failure.
Stdlib only.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from collections import defaultdict
from typing import Any, Callable

MARKER_RE = re.compile(
    r"<!--\s*adversary-verdict:v1\s*(\{.*?\})\s*-->",
    re.DOTALL,
)
SHA40 = re.compile(r"^[0-9a-f]{40}$")

# Named operator stacks (2026-11-09). Matching is by live open branch/title;
# order is always derived from each PR's baseRefName → same-repo headRefName
# edge (see link_parents), never from a hardcoded PR number sequence (numbers
# drift as tips land).
STACK_GROUPS: dict[str, Callable[[dict[str, Any]], bool]] = {
    "install": lambda r: bool(
        re.search(r"ade-install|ade-update-check", r.get("branch") or "")
        or re.search(r"\bade-install\b|\binstall:", (r.get("title") or ""), re.I)
    ),
    # claims W2–W4: plugin → W3 → W4 → W2-release (+ queue note PR).
    "claims": lambda r: bool(
        re.search(r"ade-claim|queue-claims-w2w4", r.get("branch") or "")
        or re.search(r"\bade-claim\b", (r.get("title") or ""), re.I)
    ),
    # S1 load_effective chain (gates → route → more → context → secret/pr).
    "s1": lambda r: bool(
        (r.get("branch") or "").startswith("cursor/s1-")
        or re.search(r"\bS1\b|load_effective", (r.get("title") or ""))
    ),
    "wave6": lambda r: bool(
        re.search(r"wave6", r.get("branch") or "", re.I)
        or re.search(r"\bwave\s*6\b|\bwave6\b", (r.get("title") or ""), re.I)
    ),
}
STACK_GROUP_NAMES = tuple(STACK_GROUPS.keys())


def die(msg: str, code: int = 2) -> int:
    print(f"ade-merge-ready: {msg}", file=sys.stderr)
    return code


def run_gh(gh: str, args: list[str], timeout: float = 120) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        [gh, *args],
        capture_output=True,
        text=True,
        errors="replace",
        timeout=timeout,
    )


def parse_approves(text: str) -> list[str]:
    """Full 40-hex APPROVE heads found as live markers (caller blanks fences if needed)."""
    out: list[str] = []
    for m in MARKER_RE.finditer(text or ""):
        try:
            obj = json.loads(m.group(1))
        except json.JSONDecodeError:
            continue
        if obj.get("verdict") != "APPROVE":
            continue
        head = obj.get("head")
        if isinstance(head, str) and SHA40.fullmatch(head):
            out.append(head)
    return out


def check_status(lines: str, name: str) -> str:
    """Best-effort status from `gh pr checks` TSV (name\\tstatus\\t...)."""
    for line in (lines or "").splitlines():
        parts = line.split("\t")
        if len(parts) < 2:
            continue
        if parts[0] == name:
            return parts[1].lower()
    return "missing"


def classify(
    *,
    mergeable: str | None,
    tests: str,
    adv: str,
    live_approve: bool,
) -> str:
    if (mergeable or "").upper() == "CONFLICTING":
        return "conflicting"
    if tests in ("fail", "failure", "cancelled", "canceled"):
        return "tests_fail"
    if tests not in ("pass", "success"):
        return "tests_pending"
    if live_approve and adv in ("pass", "success"):
        return "merge_now"
    if live_approve:
        return "needs_approve"  # rare: APPROVE present but marker Action not green
    return "needs_approve"


def head_repository_nwo(pr: dict[str, Any], listing_repo: str) -> str:
    """OWNER/NAME of the PR head, from gh JSON; empty when cross-repo and unknown.

    Prefers headRepository.nameWithOwner, then headRepositoryOwner.login +
    headRepository.name. Same-repo heads with no identity fields default to
    listing_repo. A cross-repo head without identity returns "" so it can never
    be chosen as a stack parent (fail closed on incomplete fork metadata).
    """
    hr = pr.get("headRepository")
    if isinstance(hr, dict):
        nwo = hr.get("nameWithOwner")
        if isinstance(nwo, str) and "/" in nwo:
            return nwo
        name = hr.get("name")
        owner_obj = pr.get("headRepositoryOwner")
        login = owner_obj.get("login") if isinstance(owner_obj, dict) else None
        if isinstance(login, str) and login and isinstance(name, str) and name:
            return f"{login}/{name}"
    if pr.get("isCrossRepository") is True:
        return ""
    return listing_repo


def collect(gh: str, repo: str, min_n: int) -> list[dict[str, Any]]:
    listing = run_gh(
        gh,
        [
            "pr",
            "list",
            "--repo",
            repo,
            "--state",
            "open",
            "--limit",
            "100",
            "--json",
            "number,title,headRefOid,baseRefName,mergeable,headRefName,"
            "headRepository,headRepositoryOwner,isCrossRepository",
        ],
    )
    if listing.returncode != 0:
        raise RuntimeError(listing.stderr.strip()[:300] or "gh pr list failed")
    try:
        prs = json.loads(listing.stdout or "[]")
    except json.JSONDecodeError as e:
        raise RuntimeError(f"gh pr list JSON: {e}") from e

    rows: list[dict[str, Any]] = []
    for p in prs:
        n = int(p["number"])
        if n < min_n:
            continue
        head = p.get("headRefOid") or ""
        checks = run_gh(gh, ["pr", "checks", str(n), "--repo", repo])
        # gh pr checks exits 1 when any check failed; stdout still usable
        check_text = checks.stdout or ""
        tests = check_status(check_text, "pytest-linux")
        adv = check_status(check_text, "adversary-marker")

        # Attribution lives in adversary-marker (bin/adversary_marker.py decide),
        # not in an unfiltered body/comment scan. A raw same-head APPROVE from an
        # outside author or bot must not flip live_approve / merge_now.
        live = adv in ("pass", "success")

        klass = classify(
            mergeable=p.get("mergeable"),
            tests=tests,
            adv=adv,
            live_approve=live,
        )
        rows.append(
            {
                "number": n,
                "title": p.get("title") or "",
                "head": head,
                "base": p.get("baseRefName") or "",
                "branch": p.get("headRefName") or "",
                "head_repo": head_repository_nwo(p, repo),
                "listing_repo": repo,
                "mergeable": p.get("mergeable"),
                "pytest_linux": tests,
                "adversary_marker": adv,
                "live_approve": live,
                "class": klass,
                "marker_template": (
                    f'<!-- adversary-verdict:v1 {{"verdict":"APPROVE","head":"{head}"}} -->'
                    if head and SHA40.fullmatch(head)
                    else ""
                ),
            }
        )
    rows.sort(key=lambda r: r["number"])
    return rows


def link_parents(
    rows: list[dict[str, Any]], listing_repo: str | None = None
) -> list[dict[str, Any]]:
    """Attach parent_number from open-PR baseRefName → same-repo headRefName.

    Parent lookup is qualified by head repository (prefer
    ``headRepository.nameWithOwner`` / owner+name from gh JSON), not by branch
    name alone. A fork PR whose head branch is ``master`` must not become the
    parent of every PR targeting the listing repo's ``master``.

    Only heads whose ``head_repo`` equals the listing repo are candidates. If
    two open same-repo PRs share a ``headRefName``, ``parent_number`` stays
    ``None`` (fail-safe: never guess which one is the stack parent).
    """
    repo = listing_repo or ""
    if not repo:
        for r in rows:
            lr = r.get("listing_repo")
            if isinstance(lr, str) and lr:
                repo = lr
                break
    by_branch: dict[str, list[dict[str, Any]]] = defaultdict(list)
    for r in rows:
        branch = r.get("branch") or ""
        if not branch:
            continue
        head_repo = r.get("head_repo") or ""
        if not repo:
            # No listing identity: still require a unique headRefName among all
            # rows, never last-wins overwrite.
            by_branch[branch].append(r)
            continue
        if head_repo != repo:
            continue
        by_branch[branch].append(r)

    out: list[dict[str, Any]] = []
    for r in rows:
        base = r.get("base") or ""
        candidates = by_branch.get(base, [])
        linked = dict(r)
        # Fail-safe: unique exact headRefName match only; 0 or 2+ → no parent.
        linked["parent_number"] = (
            candidates[0]["number"] if len(candidates) == 1 else None
        )
        out.append(linked)
    return out


def expand_with_ancestors(
    selected: list[dict[str, Any]], all_rows: list[dict[str, Any]]
) -> list[dict[str, Any]]:
    """Keep stack integrity: if a tip matches a group, include its open ancestors."""
    by_num = {r["number"]: r for r in all_rows}
    keep: set[int] = {r["number"] for r in selected}
    for r in selected:
        cur = r
        while cur.get("parent_number") is not None:
            parent = by_num.get(cur["parent_number"])
            if parent is None or parent["number"] in keep:
                break
            keep.add(parent["number"])
            cur = parent
    return [by_num[n] for n in sorted(keep)]


def bottom_up_order(rows: list[dict[str, Any]]) -> list[dict[str, Any]]:
    """Topological order: stack bottoms (no open parent in set) first, then children.

    Sibling branches at the same depth stay in PR-number order. Cycles (should not
    happen for GitHub base refs) fall back to number order for the remainder.
    """
    by_num = {r["number"]: r for r in rows}
    nums = set(by_num)
    children: dict[int | None, list[int]] = defaultdict(list)
    indeg: dict[int, int] = {n: 0 for n in nums}
    for r in rows:
        p = r.get("parent_number")
        if p in nums:
            children[p].append(r["number"])
            indeg[r["number"]] += 1

    for k in children:
        children[k].sort()

    ordered: list[dict[str, Any]] = []
    queue = sorted(n for n, d in indeg.items() if d == 0)
    seen: set[int] = set()
    while queue:
        n = queue.pop(0)
        if n in seen:
            continue
        seen.add(n)
        ordered.append(by_num[n])
        for c in children.get(n, []):
            indeg[c] -= 1
            if indeg[c] == 0:
                queue.append(c)
                queue.sort()
    if len(ordered) < len(rows):
        for n in sorted(nums - seen):
            ordered.append(by_num[n])
    return ordered


def stack_bottoms(rows: list[dict[str, Any]]) -> list[dict[str, Any]]:
    """PRs whose open parent is outside this set (typically base=master)."""
    nums = {r["number"] for r in rows}
    bottoms = [
        r for r in rows if r.get("parent_number") is None or r["parent_number"] not in nums
    ]
    return sorted(bottoms, key=lambda r: r["number"])


def build_named_stacks(
    rows: list[dict[str, Any]],
    *,
    groups: list[str] | None = None,
    bottoms_only: bool = False,
    listing_repo: str | None = None,
) -> list[dict[str, Any]]:
    linked = link_parents(rows, listing_repo=listing_repo)
    explicit = groups is not None
    names = list(groups) if explicit else list(STACK_GROUP_NAMES)
    stacks: list[dict[str, Any]] = []
    for name in names:
        matcher = STACK_GROUPS[name]
        matched = [r for r in linked if matcher(r)]
        if not matched:
            stacks.append({"group": name, "bottoms_only": False, "order": []})
            continue
        # Default all-groups view: wave6 shows docs bottoms only. Explicit
        # `--group wave6` prints the full bottom-up chains unless --bottoms-only.
        # Bottoms use the matched set only so a non-group open base (e.g. S1
        # #332 under wave6-gates-doc) is not itself listed as a wave6 bottom.
        want_bottoms = bottoms_only or (not explicit and name == "wave6")
        if want_bottoms:
            order = stack_bottoms(matched)
        else:
            order = bottom_up_order(expand_with_ancestors(matched, linked))
        stacks.append(
            {
                "group": name,
                "bottoms_only": want_bottoms,
                "order": order,
            }
        )
    return stacks


def print_table(rows: list[dict[str, Any]]) -> None:
    print(
        f"{'N':<5} {'class':<14} {'tests':<10} {'adv':<10} {'approve':<7} {'head':<10} title"
    )
    for r in rows:
        print(
            f"{r['number']:<5} {r['class']:<14} {r['pytest_linux']:<10} "
            f"{r['adversary_marker']:<10} {str(r['live_approve']):<7} "
            f"{(r['head'] or '')[:7]:<10} {(r['title'] or '')[:48]}"
        )
    needs = [
        r
        for r in rows
        if r["class"] == "needs_approve" and r["pytest_linux"] in ("pass", "success")
    ]
    if needs:
        print()
        print("# Paste-ready APPROVE templates (operator only; after a real review of that head):")
        for r in needs[:12]:
            print(f"# PR {r['number']} ({r['head'][:7]})")
            print(r["marker_template"])


def print_stacks(stacks: list[dict[str, Any]]) -> None:
    print(
        "# Bottom-up APPROVE order from open PR base→head refs "
        "(operator only; after a real review of each head)."
    )
    print("# Never posts or invents a verdict; templates are for paste after review.")
    print()
    for stack in stacks:
        name = stack["group"]
        order: list[dict[str, Any]] = stack["order"]
        label = f"{name} bottoms" if stack.get("bottoms_only") else name
        print(f"## {label}")
        if not order:
            print("  (no open PRs matched)")
            print()
            continue
        for i, r in enumerate(order, 1):
            parent = r.get("parent_number")
            parent_s = f"←#{parent}" if parent else f"←{r.get('base') or '?'}"
            print(
                f"  {i}. #{r['number']} {r.get('branch') or ''} {parent_s}  "
                f"class={r.get('class')}  head={r.get('head') or ''}"
            )
            print(f"     {(r.get('title') or '')[:72]}")
            if r.get("marker_template"):
                print(f"     {r['marker_template']}")
        print()


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        prog="ade-merge-ready",
        description=(
            "Classify open ADE PRs against pytest-linux + adversary-marker + live "
            "APPROVE, or print bottom-up stack APPROVE order (read-only)."
        ),
    )
    ap.add_argument(
        "cmd",
        nargs="?",
        default="classify",
        choices=("classify", "stacks"),
        help="classify (default) or stacks (bottom-up APPROVE order)",
    )
    ap.add_argument(
        "--repo",
        default=os.environ.get("ADE_MERGE_READY_REPO", "djbclark/djbclark-ade"),
        help="OWNER/NAME (default djbclark/djbclark-ade)",
    )
    ap.add_argument(
        "--min",
        type=int,
        default=327,
        metavar="N",
        help="only PRs with number >= N (default 327)",
    )
    ap.add_argument("--json", action="store_true", help="print JSON")
    ap.add_argument(
        "--gh",
        default=os.environ.get("ADE_GH", "gh"),
        help="gh binary (or ADE_GH); tests inject a fake",
    )
    ap.add_argument(
        "--group",
        action="append",
        choices=list(STACK_GROUP_NAMES),
        metavar="NAME",
        help=(
            "stacks only: limit to named stack(s): install, claims, s1, wave6 "
            "(repeatable; default: all four)"
        ),
    )
    ap.add_argument(
        "--bottoms-only",
        action="store_true",
        help="stacks only: print only stack bottoms within each selected group",
    )
    a = ap.parse_args(argv)
    try:
        rows = collect(a.gh, a.repo, a.min)
    except (RuntimeError, subprocess.TimeoutExpired, OSError) as e:
        return die(str(e))

    if a.cmd == "stacks":
        stacks = build_named_stacks(
            rows,
            groups=a.group,
            bottoms_only=a.bottoms_only,
            listing_repo=a.repo,
        )
        if a.json:
            json.dump(stacks, sys.stdout, indent=2, sort_keys=True)
            sys.stdout.write("\n")
        else:
            print_stacks(stacks)
        return 0

    if a.json:
        json.dump(rows, sys.stdout, indent=2, sort_keys=True)
        sys.stdout.write("\n")
    else:
        print_table(rows)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

#!/usr/bin/env python3
"""Drive cross-agent re-handoffs for planned stuck Pi agents from a supervisor scan plan.

Reads a JSON plan written by ``bin/ade-supervisor-scan``, verifies a Paseo agent caller
identity is present (``PASEO_AGENT_ID`` must be set; launchd scans run without one and
fail closed here), validates each target id as a strict UUID, writes a bounded nonsecret
per-agent checkpoint (mode 0600, cleaned up in ``finally``), and invokes:

    bin/ade-self-session handoff --checkpoint FILE --predecessor=UUID --route-kind code --quiesced

Only entries with ``family == "pi"`` and ``action == "would-rehandoff"`` are acted on;
missing/non-Pi families and entries with no healthy alternative are skipped. No agent is
archived directly here: retirement waits for successor acknowledgement, first-real-turn
verification, and ``finish``.

    ade-supervisor-rehandoff PLAN.json
"""
from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import tempfile
import uuid
from pathlib import Path

CTRL_RE = re.compile(r"[\x00-\x1f\x7f]+")


def _scrub(text: str, limit: int = 160) -> str:
    return CTRL_RE.sub(" ", text).strip()[:limit]


def _valid_uuid(value: object) -> str | None:
    if not isinstance(value, str):
        return None
    raw = value.strip()
    if not raw or raw != value or raw.startswith("-"):
        return None
    try:
        parsed = uuid.UUID(raw)
    except ValueError:
        return None
    return str(parsed) if str(parsed) == raw.lower() else None


def rehandoff(plan_path: Path, runner=None, env: dict[str, str] | None = None) -> int:
    try:
        plan = json.loads(plan_path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        print(f"ade-supervisor-rehandoff: unreadable plan {plan_path}: {exc}", file=sys.stderr)
        return 1
    entries = plan.get("plan") if isinstance(plan, dict) else None
    if not isinstance(entries, list):
        print("ade-supervisor-rehandoff: plan has no entry list; nothing moved")
        return 0

    proc_env = os.environ if env is None else env
    caller_id = (proc_env.get("PASEO_AGENT_ID") or "").strip()
    if not caller_id:
        print(
            "ade-supervisor-rehandoff: PASEO_AGENT_ID is unset; cross-agent re-handoff requires "
            "a live Paseo agent/lead caller (launchd scans stay notify-only)",
            file=sys.stderr,
        )
        return 1

    run = runner or subprocess.run
    session = str(Path(__file__).with_name("ade-self-session"))
    moved = 0
    failed = 0
    for entry in entries:
        if not isinstance(entry, dict):
            continue
        raw_agent = entry.get("id")
        family = entry.get("family")
        if family != "pi":
            print(f"ade-supervisor-rehandoff: skipping non-pi {raw_agent!r} (family={family!r})")
            continue
        if entry.get("action") != "would-rehandoff":
            print(f"ade-supervisor-rehandoff: leaving {raw_agent!r} (no healthy alternative)")
            continue
        agent = _valid_uuid(raw_agent)
        if agent is None:
            failed += 1
            print(f"ade-supervisor-rehandoff: refusing invalid target agent id {raw_agent!r}", file=sys.stderr)
            continue
        note = (
            f"Re-handoff {agent} off exhausted account {entry.get('account')} "
            f"toward {entry.get('alternative')}.\n"
        )
        checkpoint: str | None = None
        try:
            with tempfile.NamedTemporaryFile("w", encoding="utf-8", suffix=".md", delete=False) as fh:
                checkpoint = fh.name
                os.chmod(checkpoint, 0o600)
                fh.write(note)
            result = run(
                [
                    session,
                    "handoff",
                    "--checkpoint",
                    checkpoint,
                    f"--predecessor={agent}",
                    "--route-kind",
                    "code",
                    "--quiesced",
                ],
                capture_output=True,
                text=True,
            )
        finally:
            if checkpoint:
                try:
                    os.unlink(checkpoint)
                except OSError:
                    pass
        if result.returncode == 0:
            moved += 1
            print(f"ade-supervisor-rehandoff: re-handed {agent} ({entry.get('account')})")
        else:
            failed += 1
            detail = _scrub(result.stderr or result.stdout or "")
            suffix = f": {detail}" if detail else ""
            print(f"ade-supervisor-rehandoff: {agent} not moved (rc={result.returncode}){suffix}")
    print(f"ade-supervisor-rehandoff: {moved} re-handed, {failed} failed, {len(entries) - moved - failed} left")
    return 1 if failed else 0


def main(plan_path: Path) -> int:
    return rehandoff(plan_path)


if __name__ == "__main__":
    if len(sys.argv) != 2:
        print("usage: ade-supervisor-rehandoff PLAN.json", file=sys.stderr)
        sys.exit(2)
    sys.exit(main(Path(sys.argv[1])))

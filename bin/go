#!/bin/sh
# Plain-English BarnOwl, run by goose.  `go list my subs` runs one goose turn
# on the barnowl skill.  (`gr` is the same for Grok; the old `g` name is gone.)
set -eu
if [ "$#" -eq 0 ]; then
  echo "usage: go <plain English BarnOwl request>" >&2
  echo "example: go list my subs" >&2
  exit 2
fi
# One headless goose turn. The barnowl skill is discovered at ~/.agents/skills,
# where bin/skill-everywhere links it. Provider and model come from goose's own
# config (~/.config/goose/config.yaml), the weakest model this account runs.
# `-q` alone still prints tool calls and the loaded skill body, so ask for JSON
# and print only the last assistant text (the answer the skill is told to give).
goose run --no-session -q --output-format json --max-turns 12 \
  -t "Use the barnowl skill for this BarnOwl request: $*" \
  | python3 -c '
import json, sys
data = json.load(sys.stdin)
for msg in reversed([m for m in data.get("messages", []) if m.get("role") == "assistant"]):
    text = "\n".join(c["text"] for c in msg.get("content", [])
                     if c.get("type") == "text" and c.get("text", "").strip())
    if text.strip():
        print(text)
        break
'

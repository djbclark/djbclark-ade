#!/bin/bash
# acp-dispatch-wait — the cheap rearm waiter for one acp-dispatch record (2026-10-18).
#
#   acp-dispatch-wait RECORD DONE
#
# Printed by acp-dispatch's `rearm` field; a lead pastes it into a run_in_background Bash call.
# While the slice runs this holds only bash, sleep and grep: a resident Python
# `acp-dispatch wait` per waiting lead was 13-32 MB of RSS each, and 26 of them (306 MB) were
# the biggest Python cost on the machine during the 2026-10-18 load-60-90 memory stall on this
# 16 GB Mac. The cheap check runs every 10 s (the DONE marker exists, or `"finished":` holds a
# number in the record JSON — null means still running); `acp-dispatch wait --once` runs every
# 60 s and the moment the cheap check trips, so a dead slice is still reaped and the
# stale-checkpoint and auto-resume notices still appear (once per distinct state). "Trips" means
# turns true: a quota-stopped record keeps `finished` set for the hours its in-place resume waits,
# and re-running Python on every 10 s tick then would undo the saving (review 2026-10-18).
# ACP_DISPATCH_WAIT_TICK / ACP_DISPATCH_WAIT_PASS (seconds) and ACP_DISPATCH_BIN are test seams.
#
# Exit: `wait --once`'s verdict — loops on 75 (EX_TEMPFAIL, still running); on 0 execs
# `acp-dispatch check RECORD` and exits with its code (0 done, 1 partial, 3 no-report,
# 4 BLOCKED, 5 pool unavailable, 75 machine too hot: nothing ran, re-dispatch later: that final 75 is
# `check`'s, not "still running"); 124 (the record's wait_timeout) and any unexpected exit pass
# straight through.
set -u
here=$(cd "$(dirname "$0")" && pwd)
dispatch=${ACP_DISPATCH_BIN:-$here/acp-dispatch}
record=${1:?usage: acp-dispatch-wait RECORD DONE}
marker=${2:?usage: acp-dispatch-wait RECORD DONE}
tick=${ACP_DISPATCH_WAIT_TICK:-10}
pass=${ACP_DISPATCH_WAIT_PASS:-60}
since=$pass
was=0
while :; do
  if [ -e "$marker" ] || ggrep -Eq '"finished"[[:space:]]*:[[:space:]]*[-0-9]' "$record" 2>/dev/null; then
    [ "$was" -eq 0 ] && since=$pass
    was=1
  else
    was=0
  fi
  if [ "$since" -ge "$pass" ]; then
    "$dispatch" wait --once "$record"
    rc=$?
    if [ "$rc" -eq 75 ]; then
      since=0
    elif [ "$rc" -eq 0 ]; then
      exec "$dispatch" check "$record"
    else
      exit "$rc"
    fi
  fi
  sleep "$tick"
  since=$((since + tick))
done
